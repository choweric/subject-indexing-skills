9i"}}, {"@id": "_:n56303512dded4ec3bdabf7eb006c1b61b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Vietnam, p. 751, under Theatre (hat tu\u00f4ng or hat b\u00f4i, a court theatre, considered the \"classical\" theatre of Vietnam) under South-east Asia, p. 777, under Vietnam (hat b\u00f4i or hat tu\u00f4ng, Vietnamese classical opera performed in North and South Vietnam)"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}, {"@id": "_:n56303512dded4ec3bdabf7eb006c1b61b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (th\u00e9\u00e2tre traditionnel du Viet-Nam)"}, "madsrdf:citationSource": "Work cat.: Hu\u1ef3nh, K.D. H\u00e1t b\u1ed9i, 1984:", "madsrdf:citationStatus": "found"}, {"@id": "_:n56303512dded4ec3bdabf7eb006c1b61b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n56303512dded4ec3bdabf7eb006c1b61b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hat tu\u00f4ng"}}, {"@id": "_:n56303512dded4ec3bdabf7eb006c1b61b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hat tu\u00f4ng"}}], "@id": "/authorities/genreForms/gf2014026852"}
