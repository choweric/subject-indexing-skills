"}, "ri:recordStatus": "new"}, {"@id": "_:n5d9ba2cce62b44c7a94af5a36c035526b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scorecards"}}, {"@id": "_:n5d9ba2cce62b44c7a94af5a36c035526b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(score card: A printed card with a blank form on which spectators may enter the score in a game of cricket or baseball; also in extended uses, esp. a card issued to a competitor before a contest, on which his or her score (or that of his or her opponent) is to be recorded, or one held by a referee or judge for the same purpose.)"}, "madsrdf:citationSource": "Oxford English Dictionary online, viewed July 30, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d9ba2cce62b44c7a94af5a36c035526b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (souvenir score card, annual baseball game, Plimpton playing fields, Exeter, Saturday, June 3, 1911) (OCoLC)1450371001"}, "madsrdf:citationSource": "Work cat: Exeter versus Andover, 1911:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d9ba2cce62b44c7a94af5a36c035526b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(scorecard: a card for recording the score of a game)"}, "madsrdf:citationSource": "Merriam Webster Dictionary online, viewed July 30, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d9ba2cce62b44c7a94af5a36c035526b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5d9ba2cce62b44c7a94af5a36c035526b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Score cards"}}, {"@id": "_:n5d9ba2cce62b44c7a94af5a36c035526b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Score cards"}}], "@id": "/authorities/genreForms/gf2024026068"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026069", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTypewriter art", "identifiers:lccn": "gf2024026069", "madsrdf:adminMetadata": [{"@id": "_:n02527ba8f89041618778fb5078da2573b1"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Typewriter art"}, "madsrdf:elementList": {"@list": [{"@id": "_:n02527ba8f89041618778fb5078da2573b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027218"}, "madsrdf:hasSource": [{"@id": "_:n02527ba8f89041618778fb5078da2573b5"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b6"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b7"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b8"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b9"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b10"}], "madsrdf:historyNote": "[Established January 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n02527ba8f89041618778fb5078da2573b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-01-27T10:29:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-08-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/nnmm"}, "ri:recordStatus": "new"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Typewriter art"}}, {"@id": "_:n02527ba8f89041618778fb5078da2573b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "dust jacket (\"The earliest surviving examples of typewriter art was made in 1898...when an Englishwoman, Flora Stacey, typed a drawing of a butterfly...At that stage most typewriter art works were created by amateurs, but in the 1920s the typewriter was taken up by serious artists...Further experiments followed in the 1940s, and with the growth of the international concrete poetry movement in the late 1950s and early 1960s a new stimulus was given to typewriter art and a new element added to it: verbal meaning...Apart from concrete poetry, other recent art movements have been reproduced on the type-writer, including constructivist and systems art and op and gestural abstraction\")"}, "madsrdf:citationSource": "Typewriter art, 1975:", "madsrdf:citationStatus": "found"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Typewriter art; UF Art, Typewriter; BT Art, Modern -- 20th century; Typewriting; Visual literature)"}, "madsrdf:citationSource": "LCSH, August 22, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Typewriter art; instance of: art genre; description: art piece made with typewriters)"}, "madsrdf:citationSource": "Wikidata, August 22, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Typewriter art: images, shaped text, or visual prose produced with a typewriter)"}, "madsrdf:citationSource": "Opening Artists' Books website, August 22, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 17 (typewriter art; \"the typewriter is a tool to draw with; a means of making art\") (OCoLC)872715896"}, "madsrdf:citationSource": "Work cat: Tullett, Barrie. Typewriter art : a modern anthology, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n02527ba8f89041618778fb5078da2573b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 15-16 (\"We added examples [to our collection] of typewriter art and poetry, experimental calligraphy, correspondence art, stamp art, sound poetry, performance poetry, micrography, artist magazines, assembling periodicals, \"zines,\" and graphic design books, as well as examples of conventional poetry and prose written by concrete poets and artists whose works we collected\")"}, "madsrdf:citationSource": "Sackner, Marvin A. The art of typewriting, 2015:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2024026069"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026070", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPolicy briefs", "identifiers:lccn": "gf2024026070", "madsrdf:adminMetadata": [{"@id": "_:nb896c89f38424e2db516154870ce70f0b1"}, {"@id": "_:nb896c89f38424e2db516154870ce70f0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Policy briefs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb896c89f38424e2db516154870ce70f0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:nb896c89f38424e2db516154870ce70f0b5"}, {"@id": "_:nb896c89f38424e2db516154870ce70f0b6"}, {"@id": "_:nb896c89f38424e2db516154870ce70f0b7"}], "madsrdf:hasVariant": {"@id": "_:nb896c89f38424e2db516154870ce70f0b8"}, "madsrdf:historyNote": "[Established November 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb896c89f38424e2db516154870ce70f0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-11-25T12:41:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb896c89f38424e2db516154870ce70f0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-08-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/sfmeis"}, "ri:recordStatus": "new"}, {"@id": "_:nb896c89f38424e2db516154870ce70f0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Policy briefs"}}, {"@id": "_:nb896c89f38424e2db516154870ce70f0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 12 (this policy brief aims at promoting increased legislative action on corruption, thereby improving public sector accountability.) (OCoLC)1341677309"}, "madsrdf:citationSource": "Work cat: Analysis of Media Reports on Corruption Cases in Nigeria ..., February/July 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb896c89f38424e2db516154870ce70f0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Policy briefs are a key tool to present research and recommendations to a non-specialized audience. They serve as a vehicle for providing evidence-based policy advice to help readers make informed decisions)"}, "madsrdf:citationSource": [{"@id": "https://idrc-crdi.ca/en/funding/resources-idrc-grantees/how-write-policy-brief"}, "International Development Research Centre (IDRC)-Canada, online, August 26, 2024"], "madsrdf:citationStatus": "found"}, {"@id": "_:nb896c89f38424e2db516154870ce70f0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A policy brief presents a concise summary of information that can help readers understand, and likely make decisions about, government policies. Policy briefs may give objective summaries of relevant research, suggest possible policy options, or go even further and argue for particular courses of action)"}, "madsrdf:citationSource": [{"@id": "https://writingcenter.unc.edu/tips-and-tools/policy-briefs"}, "The Writing Center, UNC Chapel Hill, online. August 26, 2024"], "madsrdf:citationStatus": "found"}, {"@id": "_:nb896c89f38424e2db516154870ce70f0b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb896c89f38424e2db516154870ce70f0b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Briefs, Policy"}}, {"@id": "_:nb896c89f38424e2db516154870ce70f0b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Briefs, Policy"}}], "@id": "/authorities/genreForms/gf2024026070"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026071", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAfrofuturist poetry", "identifiers:lccn": "gf2024026071", "madsrdf:adminMetadata": [{"@id": "_:n131f4269af174ceab85613ddc07b4c4eb1"}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Afrofuturist poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n131f4269af174ceab85613ddc07b4c4eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026532"}, "madsrdf:hasSource": [{"@id": "_:n131f4269af174ceab85613ddc07b4c4eb5"}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb6"}], "madsrdf:hasVariant": [{"@id": "_:n131f4269af174ceab85613ddc07b4c4eb7"}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb10"}], "madsrdf:historyNote": "[Established January 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Science fiction poetry that features Black characters and concerns, and depicts technology as a resource for Black empowerment."}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-01-27T10:29:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-08-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Afrofuturist poetry"}}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(poets Tracie Morris and Tracy K. Smith incorporate elements of science fiction, technology, and African American histories and experiences; poetry utilizing an Afrofuturist framework; \"Afrofuturism developed as a theoretical perspective for identifying and analyzing the relationships between Black identities, technologies from before and beyond, and imaginings of the future and its possibilities\"; Affofuturist poetry addresses concepts of dystopic futures, technologies, and Black identity; \"Black science fiction authors such as Octavia Butler, Samuel R. Delany, and Nalo Hopkinson tackle the intersections of identities, including race, gender, class, and technology in their novels and short stories. Morris and Smith do similar work in poetic form.\")"}, "madsrdf:citationSource": "The Afrofuturist poetry of Tracie Morris and Tracy K. Smith, in Journal of ethnic American literature, issue 4 (2014), viewed online through ProQuest, Aug. 27, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 4 of cover (\"thirty works of speculative poetry ... this Afrofuturist collection\") (DLC)2021932548"}, "madsrdf:citationSource": "Work cat: The ghettobirds, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n131f4269af174ceab85613ddc07b4c4eb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Afrofuturistic poetry"}}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Afrofuturistic poetry"}}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n131f4269af174ceab85613ddc07b4c4eb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Afrofuturism poetry"}}, {"@id": "_:n131f4269af174ceab85613ddc07b4c4eb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Afrofuturism poetry"}}], "@id": "/authorities/genreForms/gf2024026071"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026075", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHyperpop (Music)", "identifiers:lccn": "gf2024026075", "madsrdf:adminMetadata": [{"@id": "_:n0769beada8e748c09f4b5a3738622ee9b1"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hyperpop (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0769beada8e748c09f4b5a3738622ee9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n0769beada8e748c09f4b5a3738622ee9b5"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b6"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b7"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b8"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b9"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b10"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b11"}], "madsrdf:historyNote": "[Established February 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-02-04T11:18:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-09-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hyperpop (Music)"}}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pg. 15 (One of hyperpop's most prominent features is its heavy reliance on technology to produce its distinct sound. Over-produced vocals, synthesized effects, samples, and glitch noises are the primary make-up of the texture in many hyperpop soundtracks)"}, "madsrdf:citationSource": "Jones, Phoebe. M. M. Identity through excess: Trans identities expressed through hyperpop, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hyperpop is a self-referential, humorous and excessive brand of pop music that is apparently everywhere at the moment and proliferating lightning-fast in the era of TikTok. It's a sound enthralled with taut, squeally synth melodies and Auto-Tuned earworm hooks, but also surrealism, nostalgia for the apparently bygone internet age of the Noughties, and distortion, lots of it. Songs tend to be short and snappy-- many of them styled in lowercase-- but manage to pack in a bewildering array of stylistic elements; it's impossible to fully understand hyperpop without considering its Extremely Online context and its significance among LGBTQ+ youth)"}, "madsrdf:citationSource": "Pritchard, Will. Hyperpop or overhyped? The rise of 2020's most maximal sound, via Independent website, Dec. 17, 2020, viewed Aug. 2, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hyperpop, however, stands out, due to its super-online nature, (to be fair, the subgenre's peak coincided with lockdown in 2020). And because of how many trans musicians helped form the genre: Sophie, Arca, Laura Les of the band 100 gecs--these are all mainstays or major influences on the genre)"}, "madsrdf:citationSource": "Munzenrieder, Kyle. Why are mainstream pop stars suddenly getting hyperpop makeovers?, via W Magazine WWW site, June 26, 2024, viewed Aug. 2, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Hyperpop music (Hyperpop is a microgenre, characterized by a maximalist or exaggerated take on pop music which may also draw on an eclectic range of influences across dance, hip hop, and electronic music. It first emerged in the mid-2010s and received notoriety once Spotify launched a \"Hyperpop\" playlist in August 2019 featuring artists such as 100 Gecs, Charli XCX, and Dorian Electra)"}, "madsrdf:citationSource": "Last.fm WWW site, Aug. 2, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 100 gecs. 1000 gecs, 2023.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pg. 80 (hyperpop [...] which loosely originates from the overtly synthetic, tongue-in-cheek deconstructions of pop music by UK art collective PC Music, whose founder, A.G. Cook, has been credited as heralding the first wave of the hyperpop sound in the early and mid-2010s with associated acts such as Charli XCX and SOPHIE.) pg. 81 (The voice in hyperpop tracks, rather than simply acting as a method to communicate lyrical messages, functions more like a melodic or sonic texture, as autotune, harmonizers, and other effects get cranked)."}, "madsrdf:citationSource": "Journal of popular music studies, v. 36, no. 2 (2024):", "madsrdf:citationStatus": "found"}, {"@id": "_:n0769beada8e748c09f4b5a3738622ee9b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (Hyperpop is in many ways about satirizing and parodying tropes in popular music and culture, as well as being categorized by a willingness to breach the socially constructed boundaries in our society; The sonic and visual aesthetic can often border on the fantastical and camp)"}, "madsrdf:citationSource": "Holte, Lisa Karolyn. The trans girl and her computer: vocal processing and the creation/expression of gender in hyperpop (diss), 2023:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2024026075"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026076", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTogatae", "identifiers:lccn": "gf2024026076", "madsrdf:adminMetadata": [{"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b1"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Togatae"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, "madsrdf:hasSource": [{"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b5"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b6"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b7"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b8"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b9"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b10"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b11"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b12"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b13"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b14"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b15"}], "madsrdf:hasVariant": [{"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b16"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b19"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b22"}], "madsrdf:historyNote": "[Established January 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-09-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-01-27T10:29:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Togatae"}}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under fabula palliata: fabula palliata, any of the Roman comedies that were translations or adaptations of Greek New Comedy. ... All surviving Roman comedies written by Plautus and Terence belong to this genre. The comedies retained the Greek stock characters and conventionalized plots of romantic intrigue as a framework to the satire of everyday contemporary life. ... By the mid-2nd century BC, the fabula palliata had been replaced by the fabula togata (from the Roman toga, \"play in Roman dress\"), but no complete work survives of this naturalized Roman comedy)"}, "madsrdf:citationSource": "Britannica online, Sept. 4, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under fabula: The palliata was a work of Greek New Comedy translated into Latin. Evolving from this genre in the 2nd century BC, the togata or tabernaria featured bawdy satire of the everyday life of the lower classes)"}, "madsrdf:citationSource": "The Methuen Drama dictionary of the theatre, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Fabula togata (A fabula togata is a Latin comedy in a Roman setting, in existence since at least the second century BC. Lucius Afranius and Titus Quinctius Atta are known to have written fabulae togatae; By mid-second century BC the fabula togata had become one of the two types of drama that constituted a bifurcated Roman comedy along with fabula palliata. The fabula togata was distinguished from the palliata primarily by its use of Roman or Italian characters, transferring the comic situations of the bourgeois palliata to the lower-class citizens of the country towns of Italy)"}, "madsrdf:citationSource": "Wikipedia, Sept. 4, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 167 (Modern writers usually regard tabernaria as a lower-class form of togata, and even suggest that it was Titinius who wrote tabernariae, plays about people who lived in \"booths\" (e.g. his play about the Fullers), whereas the more polite Atta and Afranius wrote togatae)"}, "madsrdf:citationSource": "Beare, W. Crepidata, palliata, tabernaria, togata, in The classical review, Nov.-Dec. 1939, online via JSTOR, viewed Sept. 4, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fabula togata. A Roman comedy, popular from about 150 to 50 B.C., having nationalistic themes and a realistic presentation. The scenes were laid in small towns and the characters taken from the middle or lower classes. Some seventy titles are known, including Divorce, Letter, and The Stepson by the chief writer of the form, Afranius)"}, "madsrdf:citationSource": "Mobley, J.P. NTC's dictionary of theatre and drama terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fabula togata, plural fabulae togatae: ancient Roman comedy based on a Greek model but treating native Roman subjects)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Sept. 4, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "togata (Togata (sc. fabula, \"drama in a toga\"--though not all the characters are likely to have worn a toga), a type of comedy written at Rome in the 2nd cent. BCE, also apparently known as tabernaria (\"private-house drama\"). Three principal authors are known, all surviving in fragments only: Titinius (perhaps earlier than Terence), L. Afranius, and T. Quinctius Atta (died 77 BCE). The plays (in verse--and played in masks?) showed Italian characters of all classes in Italian or Roman settings; Roman names occur in the fragments, and some interesting differences from the palliata are reported ... We know of occasional revivals in the following two centuries, and Juvenal 1. 3 speaks of togatae written for recitation in his day)"}, "madsrdf:citationSource": "Oxford classical dictionary online, Sept. 4, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 90-264 (Fragments of Titinius (pp. 90-140) -- Fragments of Afranius (pp. 141-252) -- Fragments of Atta (pp. 253-261) -- Fragments of unknown authors (pp. 262-264)) (OCoLC)8951931"}, "madsrdf:citationSource": "Work cat.: Comoedia togata : fragments, 1981:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(togata (or tabernaria): A form of Roman fabula, that evolved from the palliata in the 2nd century BC. More satirical than its predecessor, the togata consisted of bawdy lampoons of the lower classes. Writers of this form included Afranius, Atta, and Titinius; none of their plays survive intact)"}, "madsrdf:citationSource": "The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "leaf 48 (fabulae togatae, a comic genre that featured plots taking place in Italy or Rome itself) (OCoLC)41455268"}, "madsrdf:citationSource": "Gildenhard, Ingo. Litterae togatae, 1999, online via ProQuest, viewed Sept. 4, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. 90 (Togatas. The national comedy of Titinius, Quintius Atta and L. Afranius (all B.C. 169--79), in which the actors appear in the toga, and the manners of the lower classes of Rome (whence the name tabernariae) are represented)"}, "madsrdf:citationSource": "Juvenal. Thirteen satires of Juvenal, 1893, online via Google books, viewed Sept. 4, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fabulae togatae"}}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fabulae togatae"}}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Togatas"}}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Togatas"}}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tabernariae"}}, {"@id": "_:nd06f9f942a55498e8e45b28fbf2b4eb1b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tabernariae"}}], "@id": "/authorities/genreForms/gf2024026076"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026077", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVerse satire", "identifiers:lccn": "gf2024026077", "madsrdf:adminMetadata": [{"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b1"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Verse satire"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026525"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026438"}, "madsrdf:hasSource": [{"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b5"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b6"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b7"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b8"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b9"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b10"}], "madsrdf:hasVariant": [{"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b11"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b14"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b17"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b20"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b23"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b26"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b29"}], "madsrdf:historyNote": "[Established January 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-09-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-01-27T10:29:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verse satire"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 389 (Renaissance verse satire; Once one of the most popular verse forms in late sixteenth and early seventeenth century England, verse satires now find little or no representation in modern anthologies of English Renaissance literature, with only a few exceptions; George Puttenham identifies roughness and didacticism as the distinctive features of satire: the first satirists \"intended to tax the common abuses and vice of the people in rough and bitter speeches\") p. 390 (Although verse satire is not a fixed genre, because of its diversity, it does have a distinct \"modal repertoire\") p. 393 (The conventional distinction is that satire castigates the general vice, whereas libel attacks the particular individual)"}, "madsrdf:citationSource": "A companion to Renaissance poetry, 2018, viewed online Sept. 4, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Satiric poetry has existed in some form since the Ancient Greek period, but the Romans were the first to categorize it as a genre in its own right; verse satires; satiric verse; satirical poetry; satirical verse; poetic satire)"}, "madsrdf:citationSource": "Bucknell, Clare. Verse satire from the Renaissance to the Romantic period, 2017, via Oxford bibliographies website, viewed Sept. 4, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(there exists a structural principle common to the satires of the Roman poets and their French and English followers. These poems have a bipartite structure: a thesis part, in which some vice or folly is examined critically from many different angles and points of view, and an antithesis part, in which an opposing virtue is recommended; Most verse satires are enclosed by a \"frame.\" Just as a novel by the early 20th-century writer Joseph Conrad may be framed by a situation in which his narrator sits on a veranda in the tropics, telling his tale, stimulated into elaboration by the queries of his listeners, so the satire will be framed by a conflict of sorts between the satirist (or, more reasonably, the satirist's persona, a fictive counterpart, the \"I\" of the poem) and an adversary; At the satirist's disposal is an immense variety of literary and rhetorical devices: the satirist may use beast fables, dramatic incidents, fictional experiences, imaginary voyages, character sketches, anecdotes, proverbs, homilies, and may employ invective, sarcasm, burlesque, irony, mockery, raillery, parody, exaggeration, understatement--wit in any of its forms--anything to make the object of attack abhorrent or ridiculous)"}, "madsrdf:citationSource": "Elliott, Robert C. Structure of verse satire, via Britannica online, Sept. 4, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Verse satire. UF Poetic satire; Satiric poetry; Satirical poetry; Satirical verse; Verse satires. BT Poetry; Satire)"}, "madsrdf:citationSource": "LCSH, Sept. 4, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Juvenal (born 55--60? CE, Aquinum, Italy--died probably in or after 127) was the most powerful of all Roman satiric poets; The Satires: Juvenal's 16 satiric poems deal mainly with life in Rome under the much-dreaded emperor Domitian and his more humane successors Nerva (96-98), Trajan (98-117), and Hadrian (117-138) ... The Satires attack two main themes: the corruption of society in the city of Rome and the follies and brutalities of mankind)"}, "madsrdf:citationSource": "Britannica online, Sept. 4, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(thirteen verse satires) (OCoLC)12823994"}, "madsrdf:citationSource": "Work cat.: Juvenal. Thirteen satires of Juvenal, 1893", "madsrdf:citationStatus": "found"}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric poetry"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric poetry"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Verse satires"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verse satires"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satires (Poetry)"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satires (Poetry)"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poetic satire"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poetic satire"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satirical poetry"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical poetry"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric verse"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric verse"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satirical verse"}}, {"@id": "_:nf629c6cb395d411183a5cbab04e3f6f7b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical verse"}}], "@id": "/authorities/genreForms/gf2024026077"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026082", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aS\u00e9ances", "identifiers:lccn": "gf2024026082", "madsrdf:adminMetadata": [{"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb1"}, {"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "S\u00e9ances"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}, "madsrdf:hasSource": [{"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb5"}, {"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb6"}, {"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb7"}, {"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb8"}], "madsrdf:historyNote": "[Established February 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-02-04T11:18:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "S\u00e9ances"}}, {"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under S\u00e9ance (\"(French: 'sitting'), in occultism, meeting centred on a medium (q.v.), who seeks to communicate with spirits of the dead. Because strong light is said to hinder communication, a s\u00e9ance usually takes place in darkness or subdued light. It generally involves six or eight persons, who normally form a circle and hold hands.\")"}, "madsrdf:citationSource": "Britannica Online, searched Oct. 16, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sound recordings of various occult phenomena, including seances and occultist rituals)"}, "madsrdf:citationSource": "Work cat:Spectra ex machina : sound anthology of occult phenomena, 1920-2017. Vol. 2, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under S\u00e9ance (definition 2: \"meeting for the investigation or exhibition of spiritualistic phenomena\")"}, "madsrdf:citationSource": "Oxford English Dictionary, searched Oct. 16, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n9bccb4d0b9594e3db907e9a3865a5b1fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under S\u00e9ance (\"A s\u00e9ance or seance is an attempt to communicate with spirits. The word s\u00e9ance comes from the French word for 'session', from the Old French seoir, 'to sit'. In French, the word's meaning is quite general and mundane: one may, for example, speak of 'une s\u00e9ance de cin\u00e9ma' (lit. 'a movie session'). In English, however, the word came to be used specifically for a meeting of people who are gathered to receive messages from ghosts or to listen to a spirit medium discourse with or relay messages from spirits. In modern English usage, participants need not be seated while engaged in a s\u00e9ance\")"}, "madsrdf:citationSource": "Wikipedia, searched Oct. 16, 2024", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2024026082"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026083", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aManhwa", "identifiers:lccn": "gf2024026083", "madsrdf:adminMetadata": [{"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab1"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Manhwa"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab5"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab6"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab7"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab8"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab9"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab10"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab11"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab12"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab13"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab14"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab15"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab16"}], "madsrdf:historyNote": "[Established February 2026.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2026-02-03T13:57:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/miul"}, "ri:recordStatus": "new"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Manhwa"}}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Manhwa (Manhwa is typically seen as more realistic than manga, with less over-the-top cartoon-like features. Webtoons can be counted as a subcategory of manhwa. However, they may also be considered as an entirely separate entity. One big way in which they are different is that manhwa, as a term, always refers to comics in South Korea, whereas a webtoon can originate from any country.)"}, "madsrdf:citationSource": "90 day Korean, viewed May 1, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 198 (\"term manhwa is used to denote Korean comics, print cartoons, and sometimes animated cartoons. In the United States, the term refers to comics and graphic novels originally published in South Korea\") p. 199 (\"The readability and left-to-right orientation of manhwa contributed to its growing popularity, as did the realism of the characters and the combination of Eastern and Western styles and mythologies. Popular manhwa in the U.S. and European markets include Ragnarok, Priest, Island, and Tarot Caf\u00e9\")"}, "madsrdf:citationSource": "Martinez, M. Manhwa : South Korean comics in Critical survey of graphic novels : history, theme, and technique, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Manhwa (A Korean genre of cartoons and comic books, often influenced by Japanese manga.)"}, "madsrdf:citationSource": "Oxford English dictionary, viewed May 9, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Books > Genres > Manhwa (Titles include \"Shaman Warrior,\" \"Bride of the Water God,\" and \"Banya: the explosive delivery man\")"}, "madsrdf:citationSource": "Dark Horse comics, viewed July 31, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "description of Dangerous convenience store 1 (This hit Boys' Love webtoon/manhwa (comic) is coming to print in English for the first time: a full-color and Mature-rated romantic comedy about a convenience store part-timer and a handsome gangster!)"}, "madsrdf:citationSource": "Barnes and Noble, viewed May 9, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 78-79 (With manhwa shifting from a physical to digital format, the traditional dynamic of panels laid out between two pages shifted to a downward scrolling format. A large portion of webtoons (digital manhwa) do away with panels completely. Digital manhwa also heavily increased the usage of color, something that was often too laborious or expensive for print manhwa. With many manhwa being born digital, they have even made occasional use of animation.)"}, "madsrdf:citationSource": "Bae, K. Y. From underground to the palm of your hand. In East Asian journal of popular culture, v.3, iss. 1 (Apr. 2017).", "madsrdf:citationStatus": "found"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Series > By Genre > Manhwa (Titles include \"Checkmate\", \"My Boyfriend is a Vampire\", \"The Dangerous Convenience Store\")"}, "madsrdf:citationSource": "Seven Seas Entertainment, viewed July 31, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "summary (Based on the manhwa / WEBTOON by Yongje Park, The God of High School focuses on Mori Jin, a 17 year old high school student and martial artist who seeks to challenge himself by facing tough opponents.)"}, "madsrdf:citationSource": "Work cat: Park, Yongje. God of high school. 2, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Manga, Manhwa, Manhua differences (Manhwa has its own history of development although there are still some ties to Japanese manga; It has had periods of popularity in the past, such as during the 1950's, but the latest wave of popularity has come through the launching of platforms for digital manhwa, known as webtoons. Manhwa often has storylines related to Korean beauty culture. Manhwa is read left to right and from top to bottom.)"}, "madsrdf:citationSource": "CBR, viewed July 31, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Manhwa (The bodies of characters in manhwa often have realistic proportions, but the faces remain unrealistic. Manhwa in webtoon format often have simplified dialogue compared to print. The readability, realism of characters, and combination of Eastern and Western styles have contributed towards its growing popularity in the US.)"}, "madsrdf:citationSource": "Wikipedia, viewed July 31, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Manhwa vs Manga (Manhwa reads left to right, top to bottom. Manhwa has not been shy about embracing digital platforms. Most modern manhwa exist now as webtoons. While most manhwa are webtoons, not all webtoons are manhwa. In manhwa, the protagonist may have allies to help them accomplish their goal, but the journey there is very much individual.)"}, "madsrdf:citationSource": "Bookriot, viewed May 1, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nd85a7fcf6c81439189a2c951c25b2c8ab16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Riding the wave (Manhwa has been a part of Western culture since the 1970's when a manhwa artist brought his distinct style to Marvel Comics. Tokyopop, a major American manga distributor, started including manhwa among its titles in the late 90's when the Korean Wave, or hallyu, started picking up steam in the West. While many are serialized, manhwa also includes unserialized graphic novels and memoirs.)"}, "madsrdf:citationSource": "Los Angeles Review of Books, viewed August 2, 2024:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2024026083"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026086", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aComics scripts", "identifiers:lccn": "gf2024026086", "madsrdf:adminMetadata": [{"@id": "_:n7a054b6423014653a61c617e96b59a57b1"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Comics scripts"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7a054b6423014653a61c617e96b59a57b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasSource": [{"@id": "_:n7a054b6423014653a61c617e96b59a57b5"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b6"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b7"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b8"}], "madsrdf:hasVariant": [{"@id": "_:n7a054b6423014653a61c617e96b59a57b9"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b12"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b15"}], "madsrdf:historyNote": "[Established February 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-02-04T11:18:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comics scripts"}}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Scripts by Neil Gaiman, Marv Wolfman, Dwayne McDuffie, Jeff Smith, Trina Robbins, Kurt Busiek, Greg Rucka, Nat Gertler, and Kevin Smith, each introduced by the respective author\") (OCoLC)50074867"}, "madsrdf:citationSource": "Work cat.: Panel one : comic book scripts by top writers, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 20 (\"How exactly does a comics script work? Your script first addresses a single person--the artist. The writer tells the artist the story that the world will see: 'Here's the story, and here's what you need to draw'\" ; \"The most common form of comic book scripting is called full scripting. In full scripting, the writer breaks the story down into pages, and breaks each page into a specific number of panels\") (OCoLC)904047244"}, "madsrdf:citationSource": "Kneece, M. The art of comic book writing : the definitive guide to outlining, scripting, and pitching your sequential art stories, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"A script is a document describing the narrative and dialogue of a comic book in detail. It is the comic book equivalent of a television program teleplay or a film screenplay. In comics, a script may be preceded by a plot outline, and is almost always followed by page sketches drawn by a comics artist and inked, succeeded by the coloring and lettering stages. There are no prescribed forms of comic scripts, but there are two dominant styles in the mainstream comics industry, the full script (commonly known as 'DC style') and the plot script (or 'Marvel house style')\")"}, "madsrdf:citationSource": "Wikipedia, viewed Oct. 17, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"I frequently get e-mail from people (usually would-be comics writers and artists) asking me what a comic book script looks like. The truth is, they all look different\" ; \"Different writers use different script formats\")"}, "madsrdf:citationSource": "Gertler, N. A comic book script, via Nat Gerlter's website, viewed Oct. 17, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a054b6423014653a61c617e96b59a57b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scripts, Comics"}}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scripts, Comics"}}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a054b6423014653a61c617e96b59a57b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scripts, Comic books"}}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scripts, Comic books"}}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a054b6423014653a61c617e96b59a57b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comic book scripts"}}, {"@id": "_:n7a054b6423014653a61c617e96b59a57b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comic book scripts"}}], "@id": "/authorities/genreForms/gf2024026086"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026087", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCity mysteries", "identifiers:lccn": "gf2024026087", "madsrdf:adminMetadata": [{"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb1"}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "City mysteries"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026280"}, "madsrdf:hasSource": [{"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb5"}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb6"}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb7"}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb8"}], "madsrdf:hasVariant": {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb9"}, "madsrdf:historyNote": "[Established February 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Nineteenth century fictional narratives of the underside of city life, exposing crime, corruption, immorality, and the hidden lives of all levels of urban society."}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-02-04T11:18:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-11-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "City mysteries"}}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the innovative genre of urban mysteries, which has been largely unexplored as a global cultural phenomenon. Starting with one of the first literary mass-successes, Eug\u00e8ne Sue's serialized novel Les Myst\u00e8res de Paris (1842-43), the launch and reception of the urban mystery was one of the first occurrences of cultural globalization)"}, "madsrdf:citationSource": "American Mysteries: Urban Crime Fiction from Eug\u00e8ne Sue's Mysteries of Paris to the American Noir & Steampunk website, via University of California, Santa Barbara Comparative Literature website, viewed Nov. 6, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a city mystery) (OCoLC)155243863"}, "madsrdf:citationSource": "Work cat.: Sue, Eug\u00e8ne. Myst\u00e8res de Paris. Ladino. Los misterios de Paris, 1922", "madsrdf:citationStatus": "found"}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. x (a genre of popular fiction from antebellum America known as the \"city-mysteries\" novel; enjoyed great popularity from the early 1840s to 1860; appeared in the wake of several European examples, most notably Eugene Sue's The Mysteries of Paris (1840-41) and G. W. M. Reynolds' The Mysteries of London; these novels shared a concern with \"removing the veil\" from the hidden operations of urban life)"}, "madsrdf:citationSource": "Erickson, Paul Joseph. Welcome to Sodom : the cultural work of city-mysteries fiction in antebellum America, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 548 (the \"city mystery\" genre encompasses a wide range of texts, but most often the term refers to novels set in large cities and driven by complex, overlapping plots highlighting vice and crime, particularly prostitution and extramarital sex, as well as various types of theft, gambling, and drunkenness. They are not \"mysteries\" in the whodunit sense but rather in their insistence on exposing activities and locations usually \"hidden\" from the view of casual visitors and genteel readers)"}, "madsrdf:citationSource": "Peeples, Scott. \"The city mystery novel\" in The American novel to 1870, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "City mystery novels"}}, {"@id": "_:n3e4ee3a2d60d4a38a9d424c34fee3e5eb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "City mystery novels"}}], "@id": "/authorities/genreForms/gf2024026087"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026089", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSeinen manga", "identifiers:lccn": "gf2024026089", "madsrdf:adminMetadata": [{"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb1"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Seinen manga"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026036"}, "madsrdf:hasSource": [{"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb5"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb6"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb7"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb8"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb9"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb10"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb11"}], "madsrdf:historyNote": "[Established February 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-02-12T12:08:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-11-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Seinen manga"}}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"The seinen demographic differs significantly from the sh\u014dnen genre, which is usually filled with similar tropes and never-ending questionable plot points. Conversely, the seinen genre is perfect for anime/manga fans who seek stories with a tinge of more realistic, adult-based themes & bloody battles\")"}, "madsrdf:citationSource": "Destiny, E. The big three of seinen manga, June 2022 via GameRant, viewed Jan. 10, 2025", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 201 (\"For instance, Daigo in Swallowing the Earth, Kirihito in Ode to Kirihito, and Jir\u014d in Ayako are signaled as seinen not only by their narrative settings but also by their physical proportions: smaller face, less rounded facial contours, often with longer sideburns or stubble. Young women are depicted with voluptuous proportions and often in a sexually explicit fashion... Tezuka's seinen characters ... are rendered with greater detail, hence their reception as more realistic\") p. 202 (\"ultimately argue that sh\u014dnen manga tend to put greater emphasis on a moral dichotomy between good and evil, while seinen manga ... tend to question social relations and social norms\")"}, "madsrdf:citationSource": "Hideaki, F. Implicating readers : Tezuka's early seinen manga, in Mechademia : second arc v. 8 (2013):", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 89 (\"seinen manga often has a grittier and more realistic feel to it. Seinen manga tends to have more violence and is a little more explicit than sh\u014dnen manga\" or other manga; includes material fitting into many genres, but \"science fiction and action are the most common genres\") (OCoLC)1312655704"}, "madsrdf:citationSource": "Kalen, E.F.S. Mostly manga : a genre guide to popular manga, manhwa, manhua, and anime, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"common themes: Action, Violence, Sex, Adult themes\"; \"Just like sh\u014dnen manga, seinen manga features action and violence, but with a more serious or darker tone, as well as adult content such as sexual situations, graphic violence, or foul language\"; \"Whereas sh\u014dnen series often feature characters with an idealized, naive, or innocent view of the world, seinen series usually follow protagonists who must face a reality where the hero does not always save the day. Seinen covers are often dark and gritty, and feature male protagonists\"; examples include Akira and Berserk)."}, "madsrdf:citationSource": "Pagan, A. A beginner's guide to manga, Dec. 27, 2018, via New York Public Library blog, viewed Jan. 9, 2025", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (\"Common themes in seinen series include war, existentialism, crime, and honor and in tandem with that, they tend to explore issues that adults are more likely to face such as workplace difficulties, financial struggles, and grief\")"}, "madsrdf:citationSource": "Leahy, A. Maturing manga : an analysis of adult themes in sh\u014dnen manga, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 33 (\"If a manga contains three or more of the following, then it's likely a seinen manga: Action/combat sequences; adult characters dealing with adult concerns; hero traits include heavy eyebrows, a stoic attitude, and a murky past; themes of honor, heroism, sacrifice, and obligation; female characters with hourglass figures and a lot of jiggle, more likely to be nude at some point; sensual or sexual content; explicit violence\"; \"Seinen manga is more mature both in visual content and in addressing topics of interest to adult men, including tales of married life, work life, sex comedies, and morally ambiguous war and crime stories\"; \"focus on stories of action, honor, outsiders, and violence\"; \"stories often revolve around icons of masculinity\" like samurai and yakuza) (OCoLC)85898238"}, "madsrdf:citationSource": "Brenner, R.E. Understanding manga and anime, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cd8e83bdfd843059d323e4dbcfe439bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a seinen manga; summary: \"Ken Kaneki is an ordinary college student until a violent encounter turns him into the first half-human half-ghoul hybrid. Trapped between two worlds, he must survive ghoul turf wars, learn more about ghoul society, and master his new powers\") (OCoLC)911043595"}, "madsrdf:citationSource": "Work cat: Ishida, Sui. Tokyo Ghoul, 2015:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2024026089"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026090", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBio-bibliographies", "identifiers:lccn": "gf2024026090", "madsrdf:adminMetadata": [{"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b1"}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bio-bibliographies"}, "madsrdf:elementList": {"@list": [{"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026048"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026049"}], "madsrdf:hasSource": [{"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b5"}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b6"}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b7"}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b8"}], "madsrdf:hasVariant": {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b9"}, "madsrdf:historyNote": "[Established February 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-11-25T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-02-12T12:08:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bio-bibliographies"}}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP summary (Biographical and bibliographical dictionary of the dramaturgical production of the Theater in Honduras) (DLC)2024050188"}, "madsrdf:citationSource": "Work cat: D\u00edez M\u00e9nguez, Isabel. Diccionario bio-bibliogr\u00e1fico del teatro hondure\u00f1o, 2025:", "madsrdf:citationStatus": "found"}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "bio-bibliography (noun. A bibliography containing biographical information about the author or authors)"}, "madsrdf:citationSource": "OED via WWW, Nov. 25, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "biobibliography (noun. a bibliography with biographical notes about the author or authors listed; also: a usually short biography especially concerned with the bibliography of the biographee)"}, "madsrdf:citationSource": "Merriam-Webster Dictionary via WWW, Nov. 25, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "PCN summary (An annotated bio-bibliography of the works of seminal law librarian Frederick C. Hicks) (DLC)2019954013"}, "madsrdf:citationSource": "Lind, Douglas W. The leaven of sympathy : a bio-bibliography of Frederick C. Hicks, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biobibliographies"}}, {"@id": "_:nad37e8b1074a4f5cb669c26e8ab9a8c4b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biobibliographies"}}], "@id": "/authorities/genreForms/gf2024026090"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026092", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSones jarochos (Music)", "identifiers:lccn": "gf2024026092", "madsrdf:adminMetadata": [{"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b1"}, {"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sones jarochos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027100"}], "madsrdf:hasSource": [{"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b5"}, {"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b6"}, {"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b7"}, {"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b8"}], "madsrdf:historyNote": "[Established February 2026.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-12-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2026-02-03T13:57:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sones jarochos (Music)"}}, {"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ECIP galley page 22 (son jarocho is a music and dance tradition from the coastal plains and inland mountain regions of the State of Veracruz which has as its base a Spanish melodic and harmonic foundation overlaid with African rhythmic and compositional influences. Etymologically, the term son comes from the Latin sonus referring to sound and, over the years, has come to mean \u2018a popular and danceable composition\u2019) ECIP page 13 (The origins of the son jarocho tradition are difficult to trace with precision, though they almost assuredly begin with the introduction of Spanish musical elements and dance movements to the Caribbean and the Americas from the early sixteenth through to the seventeenth centuries)"}, "madsrdf:citationSource": "Kohl, R. Reflections on the Veracruz son jarocho, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "s.v. Son jarocho (The generic Spanish term son is used widely throughout the Spanish-speaking Americas to refer to a song or song and dance style. The term jarocho refers to people and all things from Veracruz, Mexico, including their fast-paced song and dance style, which combines musical elements of the Spanish colonists, indigenous groups, and Africans. Son jarocho is associated with jaranas or fandangos, events where the music is played and danced on tarimas, raised wooden platforms that act as resonators for the zapateado, improvised footwork that adds to the music\u2019s characteristic percussive and rhythmic elements. The main instrument of the best-known son jarocho style in Mexico is the arpa jarocha, a 32- to 36-stringed diatonic harp that plays highly ornamented melodies; other instruments include the jarana (small guitar with eight strings in five courses; accompanies with percussive strumming) and the requinto (four strings played with a long, thin plectrum; provides percussive melodic counterpoint))"}, "madsrdf:citationSource": "Grove music online, Oct. 14, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert, page 10 (Son jarocho: musical genre genuinely metis and autochthonous, originating from the center and the south of the State of Veracruz, covering the towns of Tlacotalpan, Alvarado, Tierra Blanca and Los Tuxtlas. It is the basic element of real Fiestas Jarochas) page 11 (Sones huastecos y jarochos; son jarocho) (DLC)93702093"}, "madsrdf:citationSource": "Work cat: Paysages mexicains. Vol. 2, Chants jarochos et huastecos:", "madsrdf:citationStatus": "found"}, {"@id": "_:n35c0a86af0334b088cdd4ba4359b5760b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "print page 752 (Immigrant musicians play the rapid-rhythm son jarocho from Veracruz on arpa (thirty-four-stringed diatonic harp), regional jarana (eight-stringed, narrow-bodied rhythm guitar), and requinto jarocho (four-stringed melody guitar plucked with a long plastic or bone pick))"}, "madsrdf:citationSource": "Garland Encyclopedia of Music, v. 3", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2024026092"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2025026014", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCommentaries", "identifiers:lccn": "gf2025026014", "madsrdf:adminMetadata": [{"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb1"}, {"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Commentaries"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}, "madsrdf:hasSource": [{"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb5"}, {"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb6"}, {"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb7"}], "madsrdf:historyNote": "[Established February 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-02-04T11:18:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-01-31T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Commentaries"}}, {"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "entry for commentaries, 3.b (Anything that serves for exposition or illustration; a comment, remark)"}, "madsrdf:citationSource": "Oxford English Dictionary, online, viewed January 31, 2025", "madsrdf:citationStatus": "found"}, {"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "entry for Dante commentaries (Commentary on Dante begins with Dante himself. Both the Vita nova and Convivio include substantial amounts of self-authored commentary on the early lyrics, whilst the De vulgari eloquentia confirms that Dante was deeply concerned with the theory and interpretation of his own creative output)"}, "madsrdf:citationSource": "Oxford Companion to Italian Literature, online, viewed January 31 2025", "madsrdf:citationStatus": "found"}, {"@id": "_:nd71eb56ac7a641999a20537d44ebd3fdb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "entry for Talmud commentaries (Ever since the Talmud was considered a 'closed text' scholars strove to explain difficult passages, but the first commentaries on larger parts of the Talmud date to the late 9th century. Early commentators in Babylonia include Saadia Gaon, Sherira Gaon, Hai Gaon, and Samuel ben Hofni)"}, "madsrdf:citationSource": "Oxford Dictionary of the Middle Ages, online, viewed January 31, 2025", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2025026014"}
