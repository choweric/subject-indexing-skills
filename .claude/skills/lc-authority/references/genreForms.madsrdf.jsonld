ordStatus": "new"}, {"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghost plays"}}, {"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "O'Donnell, T. The wishing tree : a ghost drama in one act, \u00a91928.", "madsrdf:citationStatus": "found"}, {"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "20 non-royalty one-act ghost plays, 1946.", "madsrdf:citationStatus": "found"}, {"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ghost plays. BT Drama)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Winsor, N. The disruptive other : phantom hauntings in the ghost plays of W.B. Yeats, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Plays)"}, "madsrdf:citationSource": "Kehde, D. Hector's warehouse, and other ghost stories, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under ghost story (The Tudor and Jacobean dramatists perceived the rich possibilities of using ghosts as 'characters' in their plays; ghosts are particularly prominent in the chronicle and history play, and in tragedy and revenge tragedy)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ghost stories (Drama)"}}, {"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghost stories (Drama)"}}, {"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ghost drama"}}, {"@id": "_:n12495c489d25448ca963a0a9ab44a8e1b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghost drama"}}], "@id": "/authorities/genreForms/gf2014026356"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026357", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGhost stories", "identifiers:lccn": "gf2014026357", "madsrdf:adminMetadata": [{"@id": "_:n25933043a9544fad8e838ac89521dcb6b1"}, {"@id": "_:n25933043a9544fad8e838ac89521dcb6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ghost stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n25933043a9544fad8e838ac89521dcb6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026469"}, "madsrdf:hasSource": [{"@id": "_:n25933043a9544fad8e838ac89521dcb6b5"}, {"@id": "_:n25933043a9544fad8e838ac89521dcb6b6"}, {"@id": "_:n25933043a9544fad8e838ac89521dcb6b7"}], "madsrdf:hasVariant": {"@id": "_:n25933043a9544fad8e838ac89521dcb6b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n25933043a9544fad8e838ac89521dcb6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n25933043a9544fad8e838ac89521dcb6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-13T18:11:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n25933043a9544fad8e838ac89521dcb6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghost stories"}}, {"@id": "_:n25933043a9544fad8e838ac89521dcb6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ghost stories. Use for fiction which features ghosts, spirits and other supernatural phenomena, written to prey upon the fears of the reader)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n25933043a9544fad8e838ac89521dcb6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ghost story: a fictional narrative ... in which the spirit of a person (or the spirits of persons), no longer bound by natural laws, manifests itself, or seems to do so (either embodied in some form or disembodied), and 'haunts' a place, person or thing as a kind of 'presence'. As a genre the ghost story proper does not include demonic pacts, doppelgangers, vampires, werewolves, succubi, poltergeists et al. Nor as a rule does it involve witchcraft and the prolepses of magic, or occult practices associated with such activities as Cumberlandism, exorcism, spiritualism, telekinesis, hylomancy and so forth.)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, c1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n25933043a9544fad8e838ac89521dcb6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ghost story: a modern form of short story designed to provoke dread and unease in its readers by bringing about a crisis in which fictional characters are confronted terrifyingly by spirits of the returning dead. The ghost story may be distinguished from its apparent near neighbor the Gothic tale (derived from the longer Gothic novel) in one of two ways: it often employs settings that distinctly non-Gothic in their apparently rational modernity' and it must exhibit a ghost, which need not actually appear in a Gothic tale.)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n25933043a9544fad8e838ac89521dcb6b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25933043a9544fad8e838ac89521dcb6b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ghost fiction"}}, {"@id": "_:n25933043a9544fad8e838ac89521dcb6b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghost fiction"}}], "@id": "/authorities/genreForms/gf2014026357"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026358", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGlosas", "identifiers:lccn": "gf2014026358", "madsrdf:adminMetadata": [{"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b1"}, {"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Glosas"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b5"}, {"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b6"}], "madsrdf:hasVariant": {"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems whose early lines, which are generally taken from a well-known poem, recur at the end of the poem or each stanza."}, {"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:23:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Glosas"}}, {"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glosa: A kind of poetic composition in which a line or lines occurring early on, usually taken from some well-known poem, recur at the end of the poem or at the end of each stanza.)"}, "madsrdf:citationSource": "Oxford companion to Spanish literature, 1978", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glosa, Glose: A Spanish verse form, introduced by court poets around the turn of the fifteenth century, beginning with a short stanza or text that states the theme of the poem; succeeding stanzas explain or gloss each of those lines, repeating them freely as refrains.)"}, "madsrdf:citationSource": "Drury, J. The poetry dictionary, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gloses"}}, {"@id": "_:ndb131cda3ee14ae89f8e01ab51ae0bd4b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gloses"}}], "@id": "/authorities/genreForms/gf2014026358"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026359", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGnomic poetry", "identifiers:lccn": "gf2014026359", "madsrdf:adminMetadata": [{"@id": "_:nd6350817accd4435921e697ea558a338b1"}, {"@id": "_:nd6350817accd4435921e697ea558a338b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gnomic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd6350817accd4435921e697ea558a338b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026170"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}], "madsrdf:hasSource": [{"@id": "_:nd6350817accd4435921e697ea558a338b5"}, {"@id": "_:nd6350817accd4435921e697ea558a338b6"}, {"@id": "_:nd6350817accd4435921e697ea558a338b7"}], "madsrdf:hasVariant": {"@id": "_:nd6350817accd4435921e697ea558a338b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short poems expressing general truths."}, {"@id": "_:nd6350817accd4435921e697ea558a338b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:24:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd6350817accd4435921e697ea558a338b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd6350817accd4435921e697ea558a338b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gnomic poetry"}}, {"@id": "_:nd6350817accd4435921e697ea558a338b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gnomic poetry. BT Poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6350817accd4435921e697ea558a338b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gnome or Gnomic verse: Short verse stating a proverbial truth. An aphorism or pithy statement.)"}, "madsrdf:citationSource": "Poetry magnum opus online, Jan. 9, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6350817accd4435921e697ea558a338b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gnomic verse: a gnome has come to mean a short pithy statement of a general truth; thus a maxim or aphorism.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6350817accd4435921e697ea558a338b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6350817accd4435921e697ea558a338b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gnomes (Poetry)"}}, {"@id": "_:nd6350817accd4435921e697ea558a338b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gnomes (Poetry)"}}], "@id": "/authorities/genreForms/gf2014026359"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026360", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGothic fiction", "identifiers:lccn": "gf2014026360", "madsrdf:adminMetadata": [{"@id": "_:n51173c7cc2ea4847acbc452a99354600b1"}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gothic fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n51173c7cc2ea4847acbc452a99354600b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n51173c7cc2ea4847acbc452a99354600b5"}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b6"}], "madsrdf:hasVariant": [{"@id": "_:n51173c7cc2ea4847acbc452a99354600b7"}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b10"}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that depicts gloomy and antiquated settings, characters that are haunted by secrets and unresolved conflicts, psychological and physical terror, and elements of the supernatural."}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:24:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gothic fiction"}}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gothic novel/fiction: A type of romance; most Gothic novels are tales of mystery and horror, intended to chill the spine and curdle the blood. They contain a strong element of the supernatural and have all or most of the now familiar topography, sites, props, presences and happenings: wild and desolate landscapes, dark forests, ruined abbeys, feudal halls and medieval castles with dungeons, secret passages, winding stairways, oubliettes, sliding panels and torture chambers; monstrous apparitions and curses)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gothic fiction (Literary genre). UF Gothic horror tales (Literary genre); Romances, Gothic (Literary genre))"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n51173c7cc2ea4847acbc452a99354600b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gothic horror fiction"}}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gothic horror fiction"}}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n51173c7cc2ea4847acbc452a99354600b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gothic romances"}}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gothic romances"}}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n51173c7cc2ea4847acbc452a99354600b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romances, Gothic"}}, {"@id": "_:n51173c7cc2ea4847acbc452a99354600b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romances, Gothic"}}], "@id": "/authorities/genreForms/gf2014026360"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026361", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGothic poetry", "identifiers:lccn": "gf2014026361", "madsrdf:adminMetadata": [{"@id": "_:n650a6c81811c400f8e26a005b93178e5b1"}, {"@id": "_:n650a6c81811c400f8e26a005b93178e5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gothic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n650a6c81811c400f8e26a005b93178e5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n650a6c81811c400f8e26a005b93178e5b5"}, {"@id": "_:n650a6c81811c400f8e26a005b93178e5b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that depict gloomy and antiquated settings, characters that are haunted by secrets and unresolved conflicts, psychological and physical terror, and elements of the supernatural."}, {"@id": "_:n650a6c81811c400f8e26a005b93178e5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n650a6c81811c400f8e26a005b93178e5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:25:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n650a6c81811c400f8e26a005b93178e5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gothic poetry"}}, {"@id": "_:n650a6c81811c400f8e26a005b93178e5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gothic poetry (Literary genre))"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n650a6c81811c400f8e26a005b93178e5b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Longman anthology of gothic verse, 2011.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026361"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026362", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGraphic novels", "identifiers:lccn": "gf2014026362", "madsrdf:adminMetadata": [{"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b1"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Graphic novels"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026130"}, "madsrdf:hasSource": [{"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b5"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b6"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b7"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b8"}], "madsrdf:hasVariant": [{"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b9"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b12"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b15"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b18"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b21"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b24"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b27"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b30"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b33"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b36"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-09-10T10:14:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic novels"}}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 (A graphic novel is a book-length narrative, of any genre, for any audience, which uses sequential art, either by itself or in combination with text elements, in order to tell a story.)"}, "madsrdf:citationSource": "Fletcher-Spear, K. Library collections for teens : manga and graphic novels, c2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 17 (GN: An abbreviation for graphic novel. A typical abbreviation in the industry for graphic novel, usually used as part of a title to indicate to a reader or browser that the title in question is not a periodical.)"}, "madsrdf:citationSource": "Lyga, A.A.W. Graphic novels in your media center, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (The graphic novel, as a narrative publication, can be found on the continuum of sequential art that also comprises comic strips, comic books, and Latin American fotonovelas.)"}, "madsrdf:citationSource": "Goldsmith, F. The readers' advisory guide to graphic novels, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Graphic novels. UF Comic book novels; Graphic albums; Graphic novellas)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novels, Graphic"}}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novels, Graphic"}}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graphic short stories"}}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic short stories"}}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novels, Comic book"}}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novels, Comic book"}}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graphic novellas"}}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic novellas"}}, {"@