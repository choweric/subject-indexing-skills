{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026630", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlternative country music", "identifiers:lccn": "gf2014026630", "madsrdf:adminMetadata": [{"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b1"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Alternative country music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026739"}, "madsrdf:hasSource": [{"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b5"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b6"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b7"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b8"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b9"}], "madsrdf:hasVariant": [{"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b10"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b13"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b16"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b19"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative country music"}}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2008022956: Old roots and new routes : the cultural politics of alt. country music, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Like its cousin alternative rock, alternative country exists outside of the mainstream, in this case, Nashville. Alternative country strips country to its basics and then subverts it, both musically and lyrically.)"}, "madsrdf:citationSource": "All Music Guide WWW site, June 4, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternative country is a term used to describe a number of country music subgenres that tend to differ from mainstream or pop country music. The term is sometimes known as Alt. country and has included country music bands that have incorporated influences ranging from American folk tunes, bluegrass, rock and-roll, rockabilly, honky-tonk and punk rock. In the 1990s, \"alternative country\" came to refer to a diverse group of musicians and singers operating outside the traditions and industry of mainstream country music. In general, these musicians eschewed the high production values and pop outlook of the Nashville-dominated industry, to produce music with a lo-fi sound, frequently infused with a strong punk and rock & roll aesthetic, bending the traditional rules of country music. Lyrics are often bleak, gothic or socially aware. Alternative country is popularly referred to, especially in print, as \"alt-country\" or sometimes \"alt. country\")"}, "madsrdf:citationSource": "Wikipedia, June 4, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(alternative country refers to country music of the late 20th century that existed outside of mainstream country (as represented by Nashville and contemporary country radio) and incorporated country music with aspects of punk, rock and roll, and roots influences; has been referred to by a variety of nicknames, including alt.country, no depression, insurgent country, y'alternative, and Americana)"}, "madsrdf:citationSource": "Grove music online, viewed March 12, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Americana. An amalgam of roots musics formed by the confluence of the shared and varied traditions that make up the American musical ethos; specifically those sounds that are merged from folk, country, rhythm & blues, rock & roll and other external influential styles. Americana is popularly referred to, especially in print, as alternative country, alt-country or sometimes alt.country.)"}, "madsrdf:citationSource": "Wikipedia, Oct. 12, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Americana (Alternative country music)"}}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Americana (Alternative country music)"}}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alt-country music"}}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alt-country music"}}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Insurgent country music"}}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Insurgent country music"}}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "No depression (Alternative country music)"}}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "No depression (Alternative country music)"}}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Y'alternative"}}, {"@id": "_:n61a3ae6e65d34aa793cd8569c20a8b00b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Y'alternative"}}], "@id": "/authorities/genreForms/gf2014026630"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026631", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlternative metal (Music)", "identifiers:lccn": "gf2014026631", "madsrdf:adminMetadata": [{"@id": "_:ne3584566e57449ce8db6943406719d6eb1"}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Alternative metal (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne3584566e57449ce8db6943406719d6eb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026632"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026854"}], "madsrdf:hasSource": [{"@id": "_:ne3584566e57449ce8db6943406719d6eb5"}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb6"}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb7"}], "madsrdf:hasVariant": [{"@id": "_:ne3584566e57449ce8db6943406719d6eb8"}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb11"}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb14"}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative metal (Music)"}}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternative metal; also known as alt-metal or hard alternative; a style of heavy metal; usually takes elements of heavy metal with influences from genres like alternative rock; term has been in usage since the 1980s, although it came into prominence in the 1990s)"}, "madsrdf:citationSource": "Wikipedia WWW site, viewed March 13, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternative metal; alternative metal emerged around 1993-94, centered around the rap-metal fusions of Rage Against the Machine and Korn ...; this new movement was sometimes dubbed aggro-metal, nu-metal, or (incorrectly) hardcore; by the end of the decade countless new bands were performing that style)"}, "madsrdf:citationSource": "All Music Guide WWW site, Mar. 22, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP t.p. (nu-metal) galley (heavy metal)"}, "madsrdf:citationSource": "Work cat.: 2002024371: Guitar world presents nu-metal, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3584566e57449ce8db6943406719d6eb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nu-metal (Music)"}}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nu-metal (Music)"}}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3584566e57449ce8db6943406719d6eb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hard alternative (Music)"}}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hard alternative (Music)"}}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3584566e57449ce8db6943406719d6eb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alt-metal (Music)"}}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alt-metal (Music)"}}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3584566e57449ce8db6943406719d6eb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Aggro-metal (Music)"}}, {"@id": "_:ne3584566e57449ce8db6943406719d6eb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aggro-metal (Music)"}}], "@id": "/authorities/genreForms/gf2014026631"}
