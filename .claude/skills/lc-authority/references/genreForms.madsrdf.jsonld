ote": "Illustrated handbooks used to identify natural objects, animals, plants, etc., in their natural environment."}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-08-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-03T13:39:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Field guides"}}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (Plant species descriptions in this book include characteristics for their identification, a labeled illustration of a typical plant (with enlarged plant parts), and a general distribution map for North America)"}, "madsrdf:citationSource": "Stubbendieck, J.L. North American wildland plants : a field guide, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(field guide : an illustrated manual for identifying natural objects, flora, or fauna in nature)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Aug. 28, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Okulewicz, S.C. The new field guide to Staten Island's rocks & minerals, \u00a91990.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(field guide: A book for the identification of animals, birds, flowers, or other things in their natural environment)"}, "madsrdf:citationSource": "Oxford dictionaries website, Aug. 28, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Corkran, C.C. Amphibians of Oregon, Washington and British Columbia : a field identification guide, \u00a91996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Stars of the southern skies : an astronomy fieldguide, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Thompson, I. The Audubon Society field guide to North American fossils, 1982.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(field guide: a book for the identification of animals, birds, flowers, or other things in their natural environment; (also in extended use) a book (often with many illustrations) used for the identification of non-natural objects; an explanatory or practical text on a particular topic)"}, "madsrdf:citationSource": "OED online, Aug. 28, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lynch, P.J. A field guide to Long Island Sound : coastal habitats, plant life, fish, seabirds, marine mammals, & other wildlife, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cfe367143ed4f0489a32830999dfc5fb14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bonfil, R. Field identific