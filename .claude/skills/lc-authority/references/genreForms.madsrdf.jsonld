"new"}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:01:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thematic maps"}}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "University of Kansas. Institute for Social and Environmental Studies. Choropleth map of 1969 Kansas population by county, 1969.", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Choropleth map. A choropleth map is a thematic map in which areas are shaded or patterned in proportion to the measurement of the statistical variable being displayed on the map, such as population density or per-capita income. The choropleth map provides an easy way to visualize how a measurement varies across a geographic area or it shows the level of variability within a region. A special type of choropleth map is a prism map, a three-dimensional map in which a given region's height on the map is proportional to the statistical variable's value for that region.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 11, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Thematic maps)"}, "madsrdf:citationSource": "LCSH, Dec. 7, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mersey, J.E. Colour and thematic map design : the role of colour scheme and map complexity in choropleth map communication, c1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(choropleth map. A thematic map on which color, shading, hatching, or some other graphic technique is used to show the density or frequency of a quantifiable variable (e.g., population, mortality, precipitation, etc.) in each of several administrative or enumerative areas, based on average number of occurrences per unit of area, usually divided into classes.)"}, "madsrdf:citationSource": "ODLIS: online dictionary for library and information science, Dec. 11, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "map, thematic (a map whose principal purpose is depicting information other than that about the Earth's physical surface. Also called a topical map. Among the kinds of information shown on thematic maps are density of population, kind or amount of crops grown, types of soil, amount of rainfall and administrative subdivisions)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Single-topic maps"}}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Single-topic maps"}}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Choropleth maps"}}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Choropleth maps"}}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Special-purpose maps"}}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Special-purpose maps"}}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Topical maps"}}, {"@id": "_:n96e48ed38758486886e1b9a72a2ad3cbb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topical maps"}}], "@id": "/authorities/genreForms/gf2011026690"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026691", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n294e0c718194424c9ebb665600ae222fb1"}, {"@id": "_:n294e0c718194424c9ebb665600ae222fb2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is covered by the genre/form term Slapstick comedy films {(gf2011026582).}"}, "madsrdf:elementList": {"@list": [{"@id": "_:n294e0c718194424c9ebb665600ae222fb3"}]}, "madsrdf:useInstead": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026582"}, "madsrdf:variantLabel": {"@language": "en", "@value": "Three Stooges films"}}, {"@id": "_:n294e0c718194424c9ebb665600ae222fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-03-12T12:34:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n294e0c718194424c9ebb665600ae222fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n294e0c718194424c9ebb665600ae222fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Three Stooges films"}}], "@id": "/authorities/genreForms/gf2011026691"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026692", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aThrillers (Motion pictures)", "identifiers:lccn": "gf2011026692", "madsrdf:adminMetadata": [{"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb1"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Thrillers (Motion pictures)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026003"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb5"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027197"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026177"}, "madsrdf:hasSource": [{"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb8"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb9"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb10"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb11"}], "madsrdf:hasVariant": [{"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb12"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb15"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb18"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb21"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb24"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb27"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb30"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb33"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb36"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films in which the audience is kept on tenterhooks by plots that feature a build-up of suspense, tension, uncertainty, menace, and anxiety.", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026310"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2008025531"}]}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-04-15T12:19:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thrillers (Motion pictures)"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hellraiser films"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hellraiser films"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 348 (Thriller; Supense film; Suspenser; Suspense thriller: the type of film ... is one in which the build-up of suspense progresses to a high point, keeping the viewers on tenterhooks as they wonder what is going to happen)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Thriller: fictional work frequently related to the crime genre in that the subject is usually some aspect of criminal activity, but with the emphasis away from a detective, gangster, caper, or even the crime itself. Instead, the narrative concentrates on suspense as an individual or group is placed in a dangerous situation whose outcome hinges on sudden reversals of fate. Frequent themes are political conspiracy, terrorism, innocents on the run, romantic triangles leading to murder, and individuals suffering from psychosis. UF: Psychological thriller. RT: Caper, Crime, Film noir, Gangster, Mystery, and Police)"}, "madsrdf:citationSource": "Moving image genre-form guide online, Feb. 11, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Thriller: any film that creates excitement and suspense, especially a mystery or crime film, though the term is also employed on occasion for spy or adventure works. See suspense; under suspense: so called \"suspense thrillers\" are adept at bringing the audience to a paralytic state of near hysteria)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dict., 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Side Effects (2013 film) (psychological thriller film)"}, "madsrdf:citationSource": "Wikipedia, Jan. 27, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Film thrillers"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film thrillers"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suspense thrillers (Motion pictures)"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suspense thrillers (Motion pictures)"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Thriller films"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thriller films"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psycho thrillers (Motion pictures)"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psycho thrillers (Motion pictures)"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psychological thriller films"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psychological thriller films"}}, {"@id": "_:n61ec69b1db6d4d2e887c08268e149edeb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementLi