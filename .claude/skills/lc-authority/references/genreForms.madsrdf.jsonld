ry/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-04T15:31:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf2f5fd886531408ab3adc3d059a59f3bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television program excerpts"}}, {"@id": "_:nf2f5fd886531408ab3adc3d059a59f3bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(excerpts: Parts, normally complete scenes or sequences, taken from a complete moving image work. Although the work from which the excerpt was taken may have been distributed, the excerpt itself has not usually been distributed in this form. An excerpt is distinguished from a clip by the fact that an excerpt is usually longer and gives a more detailed sense of the complete work than a clip does.)"}, "madsrdf:citationSource": "Archival moving image materials online, June 13, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nf2f5fd886531408ab3adc3d059a59f3bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(excerpt: Portion, usually of a few minutes duration or less, of a longer, fully edited complete work. The material is too brief to be considered an incomplete copy of the work. Typical excerpt material is a title sequence, musical number, or special effects highlight; UF Clip)"}, "madsrdf:citationSource": "Moving image genre-form guide online, June 13, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nf2f5fd886531408ab3adc3d059a59f3bb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2f5fd886531408ab3adc3d059a59f3bb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television excerpts"}}, {"@id": "_:nf2f5fd886531408ab3adc3d059a59f3bb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television excerpts"}}], "@id": "/authorities/genreForms/gf2011026672"}
