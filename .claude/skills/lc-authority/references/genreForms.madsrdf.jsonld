{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027134", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTembang Sunda", "identifiers:lccn": "gf2014027134", "madsrdf:adminMetadata": [{"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b1"}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tembang Sunda"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": [{"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b5"}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b6"}], "madsrdf:hasVariant": [{"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b7"}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tembang Sunda"}}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 714 (Tembang Sunda, known in Cianjur as Cianjuran; a type of sung poetry developed in the regency of Cianjur in the late 1800s. One or more singers are accompanied by an ensemble consisting of two zithers (kacapi and rincik) and bamboo flute (suling); the flute is replaced by a rebab in some situations)"}, "madsrdf:citationSource": "Garland, v. 4, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 00368140: Sumiarto, A. Tembang Sunda Cianjuran, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tembang Sunda Cianjuran"}}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tembang Sunda Cianjuran"}}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cianjuran"}}, {"@id": "_:nbad1718246054c33b2d4b0e4b3ef1833b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cianjuran"}}], "@id": "/authorities/genreForms/gf2014027134"}
