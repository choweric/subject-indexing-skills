{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026111", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLegal comics", "identifiers:lccn": "gf2018026111", "madsrdf:adminMetadata": [{"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b1"}, {"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Legal comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b5"}, {"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b6"}, {"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that feature the practice of law."}, {"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-04T14:38:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legal comics"}}, {"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Features Akiko, a curvaceous, muscular filmmaker planning to shoot a documentary about a day in the life of New York City. She brandishes a laser gun as she fends off a cyclopean \"rights monster\"--all the while learning copyright law basics; subj. hdgs.: Fair use (Copyright)--United States--Comic books, strips, etc.; Public domain (Copyright law)--United States--Comic books, strips, etc.; Copyright--United States--Comic books, strips, etc.)"}, "madsrdf:citationSource": "Aoki, K. Bound by law?, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel; subj. hdgs.: Lawyers--United States--Comic books, strips, etc.; Law firms--Corrupt practices--Comic books, strips, etc.)"}, "madsrdf:citationSource": "Work cat.: Yi, Hy\u014fn-se. Hunjang, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n45cec3acfd7b4f7dac6a83ddcbd41987b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(educational comics on criminal law, criminal procedure, and constitutional law)"}, "madsrdf:citationSource": "Burney, N. The illustrated guide to law, via WWW, viewed Aug. 10, 2018", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026111"}
