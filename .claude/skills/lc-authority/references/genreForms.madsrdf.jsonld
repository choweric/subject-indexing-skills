{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026850", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHardcore (Music)", "identifiers:lccn": "gf2014026850", "madsrdf:adminMetadata": [{"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b1"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hardcore (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027025"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026784"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026097"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026136"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026159"}], "madsrdf:hasSource": [{"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b5"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b6"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b7"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b8"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b9"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b10"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b11"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b12"}], "madsrdf:hasVariant": [{"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b13"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hardcore (Music)"}}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hardcore)"}, "madsrdf:citationSource": "Work cat.: 96070567: Lahickey, B. All ages, c1997", "madsrdf:citationStatus": "found"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hardcore punk: The most rigid and extreme variation of punk rock; emerged in the early '80s; impossibly fast, the vocals were shouted, the riffs were simple, and the records looked (and sounded) like they were made in someone's basement; primarily American)"}, "madsrdf:citationSource": "All music guide WWW site, Jan. 22, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hardcore: Alternative U.S. name for the punk rock movement of the late 1970s. In the 1980s the term was specially reserved for the most radical forms of post-punk rock)"}, "madsrdf:citationSource": "Pickering, D. Cassell companion to 20th-century music", "madsrdf:citationStatus": "found"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hard core, n. 2: type of fast rock music: a type of dance music notable for its repetitive rhythmic synthesized sounds and fast tempo)"}, "madsrdf:citationSource": "Encarta world Eng. dict. WWW site, Jan. 22, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hardcore: Part of the U.S. underground in the late 1970s; developed out of punk and was linked with grunge and alternative rock; originally harder and faster than its direct ancestor, punk rock, monochrome guitars, bass, and drums, half-shouted lyrics venting the most inflammatory sentiments; British hardcore and post-punk bands were noted for their melodically minimal, percussive structures)"}, "madsrdf:citationSource": "Shuker, R. Key concepts in popular music", "madsrdf:citationStatus": "found"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(in text of articles on styles and groups: hardcore, hardcore punk)"}, "madsrdf:citationSource": "Grovemusic.com WWW site, Jan. 22, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hardcore)"}, "madsrdf:citationSource": "Wicke, P. Handbuch der popul\u00e4ren Musik", "madsrdf:citationStatus": "found"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under United States: Hard core: Loud minimalist punk rock music)"}, "madsrdf:citationSource": "White, D. Dict. pop. mus. styles world", "madsrdf:citationStatus": "found"}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hardcore punk (Music)"}}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hardcore punk (Music)"}}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hard core (Music)"}}, {"@id": "_:nbeb9171f19e24eb28cc17a2d454f5110b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hard core (Music)"}}], "@id": "/authorities/genreForms/gf2014026850"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026851", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aH\u00e1t \u1ea3 \u0111\u00e0o", "identifiers:lccn": "gf2014026851", "madsrdf:adminMetadata": [{"@id": "_:n73063b31a7ef442488f2ccc01814eb57b1"}, {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "H\u00e1t \u1ea3 \u0111\u00e0o"}, "madsrdf:elementList": {"@list": [{"@id": "_:n73063b31a7ef442488f2ccc01814eb57b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:n73063b31a7ef442488f2ccc01814eb57b5"}, {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b6"}, {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b7"}], "madsrdf:hasVariant": {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "H\u00e1t \u1ea3 \u0111\u00e0o"}}, {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 94, under Vietnam (hat a dao, a women's art song of the north; a poetic singing, often acc. by lute)"}, "madsrdf:citationSource": "White, D. Dict. of pop. music styles of the world, c1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(also called ca tr\u00f9)"}, "madsrdf:citationSource": "Work cat.: 97-218992: Studien zu traditionellen vietnamesischen Instrumentalpraktiken des h\u00e1t \u1ea3 \u0111\u00e0o und des ca v\u1ecdng c\u1ecf\u0302, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Vietnam (In north Vietnam, main kind of entertainment music (i.e. art music perf. by small no. of instrumentalists for a limited audience, somewhat like chamber music in the West) was the hat a dao, perf. by prof. or semi-prof. singers acc. by only one musician playing on the dan day, or by an inst. ensemble when singers danced at the same time; very likely that it was created in 15th cent., reached peak of development in 19th cent., and began to decline in 20th)"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}, {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n73063b31a7ef442488f2ccc01814eb57b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ca tr\u00f9"}}, {"@id": "_:n73063b31a7ef442488f2ccc01814eb57b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ca tr\u00f9"}}], "@id": "/authorities/genreForms/gf2014026851"}
