{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026913", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLullabies (Songs)", "identifiers:lccn": "gf2014026913", "madsrdf:adminMetadata": [{"@id": "_:nf5e66db89476409784316ed0c4ca63e7b1"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lullabies (Songs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf5e66db89476409784316ed0c4ca63e7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b5"}, "madsrdf:hasSource": [{"@id": "_:nf5e66db89476409784316ed0c4ca63e7b8"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b9"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b10"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b11"}], "madsrdf:hasVariant": [{"@id": "_:nf5e66db89476409784316ed0c4ca63e7b12"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b15"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b18"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T08:47:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lullabies (Songs)"}}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5e66db89476409784316ed0c4ca63e7b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lullabies"}}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lullabies"}}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(berceuse, plural berceuses 1: a musical composition usually in 6/8 time that resembles a lullaby. 2: lullaby)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Mar. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Lullaby (Originally, a vocal piece designed to lull a child to sleep with repeated formulae; less commonly, it can be used to soothe a fractious or sick child. Like the lament, with which it has much in common, the lullaby is usually (though not exclusively) sung solo by women and displays musical characteristics that are often archaic, such as a descending melodic line, portamento effects, stylized representations of sighing or weeping, and non-stanzaic text lines; The lullaby as a vocal (with or without accompaniment) or instrumental piece appears in art music of all periods; examples are found in medieval carols with 'lullay' burdens, in 18th-century choral music, 19th-century lieder, and 19th- and early 20th-century piano pieces. See Berceuse and Wiegenlied) Berceuse (Fr.: 'cradle', 'lullaby'; A gentle song intended for lulling young children to sleep. In instrumental music the term usually refers to a character-piece for piano; One of the most beautiful and sophisticated vocal berceuses is Brahms's Geistliches Wiegenlied op.91 no.2; a famous operatic berceuse is in Benjamin Godard's opera Jocelyn (1888)) Wiegenlied (Ger.: 'cradle song'; A song actually or supposedly designed to lull children to sleep; the German equivalent of the English Lullaby and the French Berceuse. Numerous examples of the Wiegenlied exist in German folk music, and its influence can be discerned in many of the settings with piano accompaniment that belong to the 19th-century lied tradition)"}, "madsrdf:citationSource": "Grove music online, Mar. 26, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grechaninov, A.T. Slumber song = Berceuse : for three-part chorus of women's voices with piano accompaniment, \u00a91931.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (A lullaby to specially-written words by Sylvia Rice)"}, "madsrdf:citationSource": "Dixon, J.W. Berceuse for a grandchild : for voice and piano, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5e66db89476409784316ed0c4ca63e7b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Slumber songs"}}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Slumber songs"}}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5e66db89476409784316ed0c4ca63e7b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cradle songs"}}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cradle songs"}}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5e66db89476409784316ed0c4ca63e7b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Berceuses (Songs)"}}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Berceuses (Songs)"}}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5e66db89476409784316ed0c4ca63e7b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lullabies"}}, {"@id": "_:nf5e66db89476409784316ed0c4ca63e7b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lullabies"}}], "@id": "/authorities/genreForms/gf2014026913"}
