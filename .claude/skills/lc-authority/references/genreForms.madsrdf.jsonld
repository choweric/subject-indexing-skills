"@id": "_:naa564cff99ee46198cbba68daa64ef44b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-05-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:naa564cff99ee46198cbba68daa64ef44b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnographic maps"}}, {"@id": "_:naa564cff99ee46198cbba68daa64ef44b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, added t.p. (Polish ethnographic atlas)"}, "madsrdf:citationSource": "Polski atlas etnograficzny, 1964-:", "madsrdf:citationStatus": "found"}, {"@id": "_:naa564cff99ee46198cbba68daa64ef44b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Singh, K.S. People of India, an anthropological atlas, 1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:naa564cff99ee46198cbba68daa64ef44b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Bourcelot, H. Atlas linguistique et ethnographique de la Champagne et de la Brie, 1966-", "madsrdf:citationStatus": "found"}, {"@id": "_:naa564cff99ee46198cbba68daa64ef44b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ethnologischer Atlas Europas und seiner Nachbarl\u00e4nder (EA) = Ethnological atlas of Europe and its bordering countries (EA) = Atlas ethnologique de l'Europe et des pays voisins (EA), 1979-.", "madsrdf:citationStatus": "found"}, {"@id": "_:naa564cff99ee46198cbba68daa64ef44b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "India. Superintendent of Census Operations, Rajasthan. Ethnographic atlas of Rajasthan, 1969.", "madsrdf:citationStatus": "found"}, {"@id": "_:naa564cff99ee46198cbba68daa64ef44b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Price, D.H. Atlas of world cultures, c1989.", "madsrdf:citationStatus": "found"}, {"@id": "_