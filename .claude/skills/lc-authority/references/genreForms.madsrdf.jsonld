23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9bc63f4741d04b84893381b439fb18e2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9bc63f4741d04b84893381b439fb18e2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Periodicals"}}, {"@id": "_:n9bc63f4741d04b84893381b439fb18e2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 62 (periodical: magazine published at regular intervals, newspaper)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9bc63f4741d04b84893381b439fb18e2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(periodicals. Publications issued at regular intervals, but not daily, containing articles on various subjects by different authors for the general reader.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9bc63f4741d04b84893381b439fb18e2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(periodical: A serial publication with its own distinctive title, containing a mix of articles, editorials, reviews, columns, short stories, poems, or other short works written by more than one contributor, issued in softcover more than once, generally at regular stated intervals of less than a year, without prior decision as to when the final issue will appear. Although each issue is complete in itself, its relationship to preceding issues is indicated by enumeration, usually issue number and volume number printed on the front cover. The category includes magazines, sold on subscription and at newsstands; journals, sold on subscription and/or distributed to members of scholarly societies and professional associations; and newsletters, but not proceedings or the other regular publications of corporate bodies as they relate primarily to meetings. Nor are newspapers formally classified as periodicals)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9bc63f4741d04b84893381b439fb18e2b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9bc63f4741d04b84893381b439fb18e2b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Periodical publications"}}, {"@id": "_:n9bc63f4741d04b84893381b439fb18e2b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Periodical publications"}}, {"@id": "_:n9bc63f4741d04b84893381b439fb18e2b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9bc63f4741d04b84893381b439fb18e2b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Journals (Publications)"}}, {"@id": "_:n9bc63f4741d04b84893381b439fb18e2b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Journals (Publications)"}}, {"@id": "_:n9bc63f4741d04b84893381b439fb18e2b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9bc63f4741d04b84893381b439fb18e2b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magazines"}}, {"@id": "_:n9bc63f4741d04b84893381b439fb18e2b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magazines"}}], "@id": "/authorities/genreForms/gf2014026139"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026140", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPerpetual calendars", "identifiers:lccn": "gf2014026140", "madsrdf:adminMetadata": [{"@id": "_:n1dc42ae0f6c34383a30b9d5a965fc632b1"}, {"@id": "_:n1dc42ae0f6c34383a30b9d5a965fc632b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Perpetual calendars"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1dc42ae0f6c34383a30b9d5a965fc632b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026055"}, "madsrdf:hasSource": [{"@id": "_:n1dc42ae0f6c34383a30b9d5a965fc632b5"}, {"@id": "_:n1dc42ae0f6c34383a30b9d5a965fc632b6"}, {"@id": "_:n1dc42ae0f6c34383a30b9d5a965fc632b7"}], "madsrdf:hasVariant": [{"@id": "_:n1dc42ae0f6c34383a30b9d5a965fc632b8"}, {"@id": "_:n1dc42ae0f6c34383a30b9d5a965fc632b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that employ algorithms, tables, or mechanical devices to compute or display the day and month of any year."}, {"@id": "_:n1dc42ae0f6c34383a30b9d5a965fc632b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1dc42ae0f6c34383a30b9d5a965fc632b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:28:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatu