4446d9ee60526379b1148b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gossip: Nonfictional programs that relay rumors, anecdotes, likes and dislikes, and personal histories of celebrities. UF Gossip columns. Examples: Jimmy Fidler program; Sidney Skolsky; Jergen's journal; The Hedda Hopper show)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Nov. 7, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:na7dec2ebd5a4446d9ee60526379b1148b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7dec2ebd5a4446d9ee60526379b1148b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio gossip columns"}}, {"@id": "_:na7dec2ebd5a4446d9ee60526379b1148b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio gossip columns"}}], "@id": "/authorities/genreForms/gf2011026305"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026306", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n0f818213e4a34e6b9fc3f18dc7c05c66b1"}, {"@id": "_:n0f818213e4a34e6b9fc3f18dc7c05c66b2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is covered by the genre/form term {Fantasy films} (gf2011026242)."}, "madsrdf:elementList": {"@list": [{"@id": "_:n0f818213e4a34e6b9fc3f18dc7c05c66b3"}]}, "madsrdf:useInstead": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026242"}, "madsrdf:variantLabel": {"@language": "en", "@value": "Harry Potter films"}}, {"@id": "_:n0f818213e4a34e6b9fc3f18dc7c05c66b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n0f818213e4a34e6b9fc3f18dc7c05c66b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-03-19T13:53:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n0f818213e4a34e6b9fc3f18dc7c05c66b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Harry Potter films"}}], "@id": "/authorities/genreForms/gf2011026306"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026307", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHaunted house films", "identifiers:lccn": "gf2011026307", "madsrdf:adminMetadata": [{"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b1"}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Haunted house films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026250"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026056"}], "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b5"}, "madsrdf:hasReciprocalAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026298"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026321"}], "madsrdf:hasSource": [{"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b8"}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b9"}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b10"}], "madsrdf:hasVariant": [{"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b11"}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b14"}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional films set in houses that appear to be inhabited by spirits.", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026044"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025330"}]}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Haunted house films"}}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Amityville films"}}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Amityville films"}}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Paranormal films. Films about the paranormal, purported phenomena described in popular culture, folk, and other non-scientific bodies of knowledge, whose existence within these contexts is described as beyond normal experience or scientific explanation; paranormal phenomena include extrasensory perception (ESP), telekinesis, ghosts, poltergeists, life after death, reincarnation, faith healing, human auras, and so forth)"}, "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haunted house film (Old dark house mystery, Old-house thriller). Films with haunted houses or old dark mansions are basically mystery films--a mystery has to be solved. A vistor, or a party of people arrive to collect an inheritance, carry out a bet, or just as a dare spend the night in the place, and the inexplicable occurrences or hauntings begin immediately. Often they are meant only to drive away the unwelcome visitors, but equally prevalent is the situation in which a murder or murders occur)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 52-53 (Haunted house films and programs; use for fictional genre films and programs that revolve around a house that is inhabited or appears to be inhabited by evil spirits. Include the murder mysteries of the 20's, 30's and 40's that were set in old houses with hidden panels and apparitions, and often had investigator protagonists. UF: Ghost stories, Murder mysteries, Old house horror mysteries, Thunderstorm mysteries)"}, "madsrdf:citationSource": "Cataloging Service bulletin: no. 49:", "madsrdf:citationStatus": "found"}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Old dark house mysteries (Motion pictures)"}}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Old dark house mysteries (Motion pictures)"}}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Old house thrillers (Motion pictures)"}}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Old house thrillers (Motion pictures)"}}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Amityville films"}}, {"@id": "_:n43eb3aba3e6040858b65f381ca7b12d0b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Amityville films"}}], "@id": "/authorities/genreForms/gf2011026307"}
