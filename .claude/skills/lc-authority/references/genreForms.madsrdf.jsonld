3"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n71094f3988284c2fac420e0e3ddf179cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n71094f3988284c2fac420e0e3ddf179cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentary films"}}, {"@id": "_:n71094f3988284c2fac420e0e3ddf179cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 77 (Documentary (Docu, Documentary Film, Factual Film, Non-Fiction Film, Realist Film); the term documentary is applied to and includes a vast array of different types of nonfiction or semifictional films; it stretches from the objective presentation of factual material to the subjective use of film for propaganda purposes)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n71094f3988284c2fac420e0e3ddf179cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Documentaries and factual works. Use for films and programs which depict actual persons and/or events. Exclude frank historical re-creations, but do not attempt to judge the \"truth\" of the depiction in a film purporting to be factual or documentary in character)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n71094f3988284c2fac420e0e3ddf179cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(documentary: Grounded in some aspect of real life, documentaries may vary from a very deliberate account of facts to an extremely interpretive rendering of a subject, advocating a particular viewpoint on a political, social, or historical issue)"}, "madsrdf:citationSource": "Moving image genre-form guide online, April 27, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n71094f3988284c2fac420e0e3ddf179cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n71094f3988284c2fac420e0e3ddf179cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motion picture documentaries"}}, {"@id": "_:n71094f3988284c2fac420e0e3ddf179cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion picture documentaries"}}, {"@id": "_:n71094f3988284c2fac420e0e3ddf179cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n71094f3988284c2fac420e0e3ddf179cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Documentaries, Motion picture"}}, {"@id": "_:n71094f3988284c2fac420e0e3ddf179cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentaries, Motion picture"}}, {"@id": "_:n71094f3988284c2fac420e0e3ddf179cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n71094f3988284c2fac420e0e3ddf179cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Factual films"}}, {"@id": "_:n71094f3988284c2fac420e0e3ddf179cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Factual films"}}], "@id": "/authorities/genreForms/gf2011026205"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026206", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDocumentary radio programs", "identifiers:lccn": "gf2011026206", "madsrdf:adminMetadata": [{"@id": "_:n551e33da77ae49c4a5efe70868391789b1"}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Documentary radio programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n551e33da77ae49c4a5efe70868391789b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026424"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026705"}, "madsrdf:hasSource": [{"@id": "_:n551e33da77ae49c4a5efe70868391789b5"}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b6"}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b7"}], "madsrdf:hasVariant": [{"@id": "_:n551e33da77ae49c4a5efe70868391789b8"}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025627"}}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T10:29:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentary radio programs"}}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 72 (Documentary; a program which integrates narration, comments, or statements with music or sound effects, as appropriate, into program form for the purpose of exploring an issue, synthesizing a body of material, or structuring material about an event or issue)"}, "madsrdf:citationSource": "Johnson, J. Modern radio station practices, c1972:", "madsrdf:citationStatus": "found"}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg: Radio documentaries)"}, "madsrdf:citationSource": "LCSH, Dec. 5, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Documentaries: Nonfictional programs that present political, social or historical subject matter in a factual and informative manner; often consist of actual news reports, actualities, and/or interviews; often contain narration. Examples: The war that did not come, Army hour, The challenge of our prisons, Yalta papers story)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Dec. 5, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n551e33da77ae49c4a5efe70868391789b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio documentaries"}}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio documentaries"}}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n551e33da77ae49c4a5efe70868391789b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Documentaries, Radio"}}, {"@id": "_:n551e33da77ae49c4a5efe70868391789b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentaries, Radio"}}], "@id": "/authorities/genreForms/gf2011026206"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026207", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDocumentary television programs", "identifiers:lccn": "gf2011026207", "madsrdf:adminMetadata": [{"@id": "_:nb35becb48f224a6486d7f854832f6ed5b1"}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Documentary television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb35becb48f224a6486d7f854832f6ed5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026425"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026221"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026233"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026314"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026706"}], "madsrdf:hasSource": [{"@id": "_:nb35becb48f224a6486d7f854832f6ed5b5"}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b6"}], "madsrdf:hasVariant": [{"@id": "_:nb35becb48f224a6486d7f854832f6ed5b7"}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b10"}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b13"}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b16"}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025010"}}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-23T16:17:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentary television programs"}}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Documentary: Nonfiction work defined by documentary pioneer John Grierson as the creative treatment of actuality. Grounded in some aspect of real life, documentaries may vary from a very deliberate account of facts to an extremely interpretive rendering of a subject, advocating a particular viewpoint on a political, social, or historical issue.)"}, "madsrdf:citationSource": "Moving image genre-form guide online, June 11, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 77 (Documentary (Docu, Documentary Film, Factual Film, Non-Fiction Film, Realist Film); The word 'telementary' has been used to describe a documentary made for television. Documentaries may seek to document and inform, teach or educate on some subject or other, or simply record for posterity the doings of people and nature.)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb35becb48f224a6486d7f854832f6ed5b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Telementaries"}}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telementaries"}}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb35becb48f224a6486d7f854832f6ed5b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television documentaries"}}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television documentaries"}}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb35becb48f224a6486d7f854832f6ed5b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Documentary programs, Television"}}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentary programs, Television"}}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb35becb48f224a6486d7f854832f6ed5b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television documentary programs"}}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television documentary programs"}}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb35becb48f224a6486d7f854832f6ed5b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Documentaries, Television"}}, {"@id": "_:nb35becb48f224a6486d7f854832f6ed5b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentaries, Television"}}], "@id": "/authorities/genreForms/gf2011026207"}
