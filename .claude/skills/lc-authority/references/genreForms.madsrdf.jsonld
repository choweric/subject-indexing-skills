00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wildlife maps"}}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Species distribution maps for the state of Oregon: Trees, butterflies, bivalves, 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b6", "@type": "madsrdf:Source", "madsrdf:citationSource": [{"@id": "http://naturemappingfoundation.org/natmap/maps/wa/"}, "Washington wildlife distribution maps, via NatureMapping Program website, June 18, 2024."], "madsrdf:citationStatus": "found"}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Communities and conservation groups can prioritize areas for habitat protection using the NH Wildlife Action Plan maps. For each community in the state, two wildlife maps are available. The Wildlife Habitats Land Cover Map shows the critical wildlife habitat types identified in the NH Wildlife Action Plan. The Highest Ranked Wildlife Habitats By Ecological Condition\u202fshows the highest ranked habitats in the state (pink), in the region (green) and the supporting landscapes (orange) that occur in a town or region)"}, "madsrdf:citationSource": "Use wildlife maps to prioritize habitats for protection, via University of New Hampshire Taking Action for Wildlife website, June 18, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: Alaska plant and wildlife map; Animal wildlife map of Britain; Bartholomew animal wildlife map of Britain; California wildlife map; Corridor wildlife map series; Vegetation & wildlife map; Wildlife and plant distribution map of Mie Prefecture)"}, "madsrdf:citationSource": "OCLC, June 18, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. vi (patterns of winter range use by barren-ground caribou from the Bluenose-East, Bathurst, and Beverly herds. Utilization distribution maps were derived ... The maps provide smoothed probability surfaces of spatial usage by caribou (and wolves by association). Figure 1 shows monthly utilization distribution maps for caribou) pp. 103-242 (Appendix 9: Bathurst, Bluenose-East and Beverly caribou winter range analysis; consists of maps of winter and monthly ranges, annual intensity of use, annual relative distributions, monthly intensity of use, monthly relative distributions, annual expected relative abundance, monthly expected relative abundance) (OCoLC)1440105808"}, "madsrdf:citationSource": "Work cat.: Nishi, John S. Wolf (d\u00ecga) management pilot program technical report 2020, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a8d4a847a094211986be55791c6aad9b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wildlife and plant distribution maps"}}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wildlife and plant distribution maps"}}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a8d4a847a094211986be55791c6aad9b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vegetation and wildlife maps"}}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vegetation and wildlife maps"}}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a8d4a847a094211986be55791c6aad9b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Species distribution maps"}}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Species distribution maps"}}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a8d4a847a094211986be55791c6aad9b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wildlife distribution maps"}}, {"@id": "_:n0a8d4a847a094211986be55791c6aad9b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wildlife distribution maps"}}], "@id": "/authorities/genreForms/gf2024026056"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026057", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPlough Monday plays", "identifiers:lccn": "gf2024026057", "madsrdf:adminMetadata": [{"@id": "_:n0900665a7de844feb455da8d1fa5e051b1"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Plough Monday plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0900665a7de844feb455da8d1fa5e051b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026444"}, "madsrdf:hasSource": [{"@id": "_:n0900665a7de844feb455da8d1fa5e051b5"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b6"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b7"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b8"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b9"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b10"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b11"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b12"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b13"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b14"}], "madsrdf:hasVariant": [{"@id": "_:n0900665a7de844feb455da8d1fa5e051b15"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b18"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b21"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b24"}], "madsrdf:historyNote": "[Established October 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-06-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-18T07:01:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plough Monday plays"}}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Plough Monday: The action of the Plough Monday play usually involves the accidental death of one of the farm workers, who is then revived. In this respect the drama seems to be related to the Christmas mummers' plays, in which the hero is killed in a fight only to be resurrected)"}, "madsrdf:citationSource": "The Methuen Drama dictionary of the theatre, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Pancester Plough Monday mummer's play; a traditional Plough Monday play)"}, "madsrdf:citationSource": "The Pancester Plough Monday mummers play, via Ian Marchant website, June 20, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Plough, Plow Monday. The Monday after Epiphany, or Twelfth Night (January 6). In sixteenth-century England, plays performed on Plough Monday rivaled the mummers' plays of Christmas in popularity. In the plough plays the characters were not heroes like St. George or Robin Hood, but farmhands, and the chief incident was a death by accident, not in battle. Like the mummers' play, the plough play was probably a survivor of primitive folk festivals)"}, "madsrdf:citationSource": "Mobley, Jonnie Patricia. NTC's dictionary of theatre and drama terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Mummers' play: In some parts of Britain and Ireland the plays are traditionally performed on or near Plough Monday. These are therefore known as Plough plays and the performers as Plough-jags, Plough-jacks, Plough-bullocks, Plough-stots or Plough witches. The Plough plays of the East Midlands of England (principally Lincolnshire and Nottinghamshire) feature several different stock characters (including a Recruiting Sergeant, Tom Fool, Dame Jane and the \"Lady bright and gay\"). Tradition has it that ploughboys would take their plays from house to house and perform in exchange for money or gifts, some teams pulling a plough and threatened to plough up people's front gardens or path if they did not pay up. Examples of the play have been found in Denmark since the late 1940s)"}, "madsrdf:citationSource": "Wikipedia, June 20, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(English folk drama - Plough or Wooing Plays. The Plough Play is so named because it usually took place around Plough Monday and the teams often took a plough round with them, but it can also be called the Wooing Play or Recruiting Sergeant Play, reflecting the action and the characters. Of the three types of Mumming Play, the Plough Play is in many ways the most complex, and the most like a conventional theatrical \"play\", although the custom as performed around the villages still bore little resemblance to a stage play. The basic plot is: A young man courts a Lady but is rejected and he is persuaded to join the army by a Recruiting Sergeant. The Lady then accepts the hand of a Clown or Fool. An older female appears and accuses the Clown of being the father of her illegitimate baby, which he denies. The next sequence is the same as the basic Hero-Combat play in which two characters fight, one is killed and he is revived by a doctor. The wooing section of the play is often sung, and the female parts were all played by men)"}, "madsrdf:citationSource": "Beginners' guides: English folk drama, via English Folk Dance & Song Society, June 20, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Plough Monday Play, a folk\u2010drama of the East Midlands. Like the St George Play, the Plough Monday Play probably symbolizes in its central incident the death and resurrection of the year)"}, "madsrdf:citationSource": "The concise Oxford companion to English literature, 3rd ed., 2007, viewed online June 20, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Plough Monday plays; Recruiting sergeant play; Generally a character called Tom Fool is the first in and introduces the play sometimes as in the case of the Calverton play to the sound of a fiddle or a drum. Then the scene moves to a discussion between the recruiting sergeant, a farmer's man and a \"female\" character (dressed in drag and called Lady bright and gay). In this scene the farmer leaves his sweet heart to join the army and so spurned the \"female\" character marries the fool and often a dance ensues. In the next scene in comes another \"female\" character (again in drag and this time called Dame Jane) who then argues with the Fool that he has a baby with her out of wedlock. They too and fro until Beelzebub turns up and has an altercation with Dame Jane to which she falls down to the ground dead. A doctor is called (usually the fool who is happy to see the character dead...less alimony, offers more money for the doctor to go away) who through various quackery brings the character back to life. A song basically wishing everyone good health and wealth is sung as a plea to then extract money from the audience)"}, "madsrdf:citationSource": "Customs revived: Nottinghamshire plough Monday plays, via In search of traditional customs and ceremonies blog, posted on January 31, 2012, viewed on June 20, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Plough Monday play. Early festive play performed on the Monday after Epiphany. The fragments which remain show that the dramatic characters were farmworkers and that the main action involved the accidental deal of one of them. There is a likely connection with the mumming play)"}, "madsrdf:citationSource": "Hodgson, Terry. The drama dictionary, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Plough Monday Play. In style, the performance of a Plough Play was similar to that of the Christmas Mummers' Play. It was originally performed by young men and included some of the same story elements, such as the death and resurrection of one of the characters. However, that is where the similarity ends. Although existing texts vary considerably and border on the surreal at times, this play is basically about a strange courtship (which is why it is often called a Wooing Play) and the interference of a Recruiting Sergeant; The play would often include a song (in fact, in some cases much of the play would be sung) and in a few places the 'actors' would join the dancers, who followed them around during the day, and alternate their performances, maybe even incorporating the dance into the play. There was also, of course, a plough in attendance and should a household not be forthcoming with alms, it could well find some unwelcome furrows across its front garden)"}, "madsrdf:citationSource": "Beginners' guides: British folk customs: from Plough Monday to Hocktide, via English Folk Dance & Song Society, June 20, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (The English Plough Monday play is an important variation of the traditional mummers' play. There exist numerous scripts of these plays) Appendix II (texts of all extant Plough Monday plays) (OCoLC)869291702"}, "madsrdf:citationSource": "Work cat.: Metzler, Rosemary. The Plough Monday plays, 1971:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0900665a7de844feb455da8d1fa5e051b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wooing plays"}}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wooing plays"}}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0900665a7de844feb455da8d1fa5e051b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Recruiting sergeant plays"}}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Recruiting sergeant plays"}}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0900665a7de844feb455da8d1fa5e051b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plough plays"}}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plough plays"}}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0900665a7de844feb455da8d1fa5e051b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plough Monday mummers' plays"}}, {"@id": "_:n0900665a7de844feb455da8d1fa5e051b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plough Monday mummers' plays"}}], "@id": "/authorities/genreForms/gf2024026057"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026058", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aImage albums", "identifiers:lccn": "gf2024026058", "madsrdf:adminMetadata": [{"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b1"}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Image albums"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026038"}], "madsrdf:hasSource": [{"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b5"}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b6"}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b7"}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b8"}], "madsrdf:hasVariant": {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b9"}, "madsrdf:historyNote": "[Established October 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-07-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-18T07:01:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Image albums"}}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 4 (\"This image album has two purposes: it allows me [i.e., Joe Hisaishi] to realize what the music will be like later, but it also allows Miyazaki, who continues to draw, to work while listening to the music.\")"}, "madsrdf:citationSource": [{"@id": "https://www.sibetrans.com/trans/public/docs/trans_16_01.pdf"}, "Bellano, Marco, \"From album to images : Studio Ghibil's Image Albums and their impact on audiovisual strategies\" in Trans : Revista Transcultural De Musica (2012), viewed online, October 17, 2024"], "madsrdf:citationStatus": "found"}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 36 (The image album is part of a cross-media fertilization process: a combination marketingtactic and pre-production tool) page 39 (The relationship between the image album, the film, and the final soundtrack is areciprocal one: Hisaishi wrote music based on Miyazaki's text and descriptions, and Miyazaki then drew the film listening to Hisaishi's image album, parts of which wound up arranged into the film's soundtrack: a kind of audible concept art.)"}, "madsrdf:citationSource": "Roedder, Alexandra Christina, \"Japanamerica or \"Amerijapan,\" 2013, thesis viewed online, October 17, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Joe Hisashi Spirited Away Image Album LP (The Image Album includes 10 tracks created by Joe Hisashi with various artists, based on a poetic note of inspirations written by Director Hayao Miyazaki during the process of film production)"}, "madsrdf:citationSource": [{"@id": "https://elusivedisc.com/joe-hisaishi-spirited-away-image-album-lp/"}, "Elusive Disc WWW site, July 1, 2024:"], "madsrdf:citationStatus": "found"}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (\u5343\u3068\u5343\u5c0b\u306e\u795e\u96a0\u3057: \u30a4\u30e1\u30fc\u30b8\u30a2\u30eb\u30d0\u30e0 = Sen to Chihiro no kamikakushi : im\u0113ji arubamu. English translation of the title: Spirited away: image album)"}, "madsrdf:citationSource": "Work cat: Hisaishi, J\u014d, 1950-. \u5343\u3068\u5343\u5c0b\u306e\u795e\u96a0\u3057:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Character albums"}}, {"@id": "_:ndda20d9f3f1644e6b52dab150bb53729b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Character albums"}}], "@id": "/authorities/genreForms/gf2024026058"}
