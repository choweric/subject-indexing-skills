-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na130fcaec23a449d891421a22f06c241b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Political plays"}}, {"@id": "_:na130fcaec23a449d891421a22f06c241b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Haas, B. Modern German political drama, 1980-2000, \u00a92003.", "madsrdf:citationStatus": "found"}, {"@id": "_:na130fcaec23a449d891421a22f06c241b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wesker, A. Arnold Wesker's political plays, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:na130fcaec23a449d891421a22f06c241b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Smarandache, F. A trilogy in paradoxism : avant-garde political dramas, \u00a92004.", "madsrdf:citationStatus": "found"}, {"@id": "_:na130fcaec23a449d891421a22f06c241b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Front lines : political plays by American women, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:na130fcaec23a449d891421a22f06c241b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Ryan, O. Eight men speak : a political play in six acts, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:na130fcaec23a449d891421a22f06c241b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Political plays. UF Political drama. BT Drama)"}, "madsrdf:citationSource": "LCSH, Sept. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na130fcaec23a449d891421a22f06c241b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Rabey, D.I. British and Irish political drama in the twentieth century, 1986.", "madsrdf:citationStatus": "found"}, {"@id": "_:na130fcaec23a449d891421a22f06c241b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "American political plays after 9/11, \u00a92010.", "madsrdf:citationStatus": "found"}, {"@id": "_:na130fcaec23a449d891421a22f06c241b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na130fcaec23a449d891421a22f06c241b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Political drama"}}, {"@id": "_:na130fcaec23a449d891421a22f06c241b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Political drama"}}], "@id": "/authorities/genreForms/gf2016026084"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026085", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPolitical poetry", "identifiers:lccn": "gf2016026085", "madsrdf:adminMetadata": [{"@id": "_:neca5a7bec0014e249224a6801f8f8906b1"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Political poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:neca5a7bec0014e249224a6801f8f8906b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:neca5a7bec0014e249224a6801f8f8906b5"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b6"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b7"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b8"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b9"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b10"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b11"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry that features the political milieu."}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Political poetry"}}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(chiefly history and criticism of Hebrew and Israeli political poetry, but also includes substantial examples of the poetry)"}, "madsrdf:citationSource": "\u1e32ol \u1e33ore be-\u02bboz : poli\u1e6di\u1e33ah \u1e7fe-shirah be-Yi\u015bra\u02bcel = A voice calls with vigor : politics and poetry in Israel, \u00a92012", "madsrdf:citationStatus": "found"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Will work for peace : new political poems, \u00a91999.", "madsrdf:citationStatus": "found"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Politics and Poetry (the quintessentially lyrical Anna Akhmatova, attacked by Soviet critics for her suspiciously individualist love lyrics, directed her greatest political poem, Requiem (written 1935-40, pub. 1963), against Stalin's terror; the hist. of poetry, as Paulin demonstrates, abounds in successful political poems: med. peasant's songs, the Divine Comedy, Andrew Marvell's Horatian ode, Milton's political sonnets, Egan O'Rahilly's Gaelic laments, John Dryden's Absalom and Achitophel, William Blake's \"London,\" Andr\u00e9 Ch\u00e9nier's \"Iambes VIII,\" William Wordsworth's Prelude, W. B. Yeats's \"Easter, 1916,\" Marina Tsvetaeva's \"Andr\u00e9 Ch\u00e9nier,\" Akhmatova's \"Voronezh,\" Pablo Neruda's \"The United Fruit Co.,\" Zbigniew Herbert's \"Elegy of Fortinbras,\" Seamus Heaney's \"Punishment\"; political poems concern situations that might be otherwise; the boundaries dividing overtly political from \"apolitical,\" and even \"antipolitical,\" poetry are fluid; McKeon argues that ideological comprehensiveness is the apt criterion for political poetry: political poets succeed by comprehending a wide range of the demands and conflicts of their time, not by rising above their historical moment)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012:", "madsrdf:citationStatus": "found"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(compilation of political poetry in Indonesian)"}, "madsrdf:citationSource": "Work cat.: Dahana, R. Manusia istana : sekumpulan puisi politik, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "State of the union : 50 political poems, \u00a92008.", "madsrdf:citationStatus": "found"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Faber book of political verse, 1986.", "madsrdf:citationStatus": "found"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Trillin, C. Dogfight : the 2012 presidential campaign in verse, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:neca5a7bec0014e249224a6801f8f8906b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Political poetry. BT Poetry)"}, "madsrdf:citationSource": "LCSH, Sept. 12, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026085"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026087", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWildlife recovery plans", "identifiers:lccn": "gf2016026087", "madsrdf:adminMetadata": [{"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb1"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Wildlife recovery plans"}, "madsrdf:elementList": {"@list": [{"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb5"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb6"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb7"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb8"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb9"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb10"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb11"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb12"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb13"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb14"}], "madsrdf:hasVariant": [{"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb15"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb18"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb21"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb24"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:34:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wildlife recovery plans"}}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Recovery planning (The purpose of the Endangered Species Act (ESA) is to conserve the ecosystems on which the listed species depend. To do this, ESA requires recovery plans. Recovery plans identify actions needed to restore threatened and endangered species to the point that they are again self-sustaining members of their ecosystems and no longer need the protections of the ESA. Although recovery plans are guidance, not regulatory documents, the ESA clearly envisions recovery plans as guiding the recovery process)"}, "madsrdf:citationSource": "Columbia River Basin Federal Caucus website, Sept. 13, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Threatened species recovery plan) foreword (The former Waikato Conservator of the Department of Conservation (DOC) formally approved this threatened species recovery plan in 2013; Threatened species recovery plans are statements of the Department's intentions for the conservation of a particular species of plant or animal, or group of species for a defined period. Recovery plans: Are proactive and operational in nature, focusing on specific key issues, providing direction, and identifying recovery actions for managers and technical workers; Set objectives to secure from extinction and recover the species, and outline measurable actions needed to achieve those objectives; Are primarily used by DOC staff to guide their annual work programmes; however, they also provide a forum for planned initiatives with tangata whenua, community interest groups, landowners, researchers and members of the public; Stimulate the development of best practice techniques and documents, which can be transferable across similar species recovery programmes)"}, "madsrdf:citationSource": "Bishop, P.J. Native frog (Leiopelma spp.) recovery plan, 2013-2018, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (species at risk recovery plan) p. iv (Recovery plans establish a basis for cooperation among government, industry, conservation groups, landowners and other stakeholders to ensure these species and populations are restored or maintained for future generations; species at risk recovery plans; these recovery plans are prepared by recovery teams composed of a variety of stakeholders including conservation organizations, industry, landowners, resource users, universities, government agencies and others; Recovery plans include three main sections: background information that highlights the species' biology, population trends, and threats; a recovery section that outlines goals, objectives, and strategies to address the threats; and an action plan that profiles priority actions required to maintain or restore the Threatened or Endangered species. These plans are \"living\" documents and are revised as conditions change or circumstances warrant. Each approved recovery plan undergoes an annual review, and progress of implementation is evaluated)"}, "madsrdf:citationSource": "Alberta grizzly bear recovery plan 2008-2013, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Species > Recovery plans (Recovery plans)"}, "madsrdf:citationSource": "U.S. Fish & Wildlife Service Endangered Species website, Sept. 13, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. iii (recovery plan for the threatened and endangered species of South Florida)"}, "madsrdf:citationSource": "South Florida multi-species recovery plan, 1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. vi (The recovery plan outlines strategies that, when implemented, will likely restore self-sustaining fisher populations to Washington) p. 35 (The goal of the recovery plan is to re-establish self-sustaining fisher populations in a geographic distribution that allows for their persistence in Washington into the foreseeable future (>100 years). The recovery plan outlines strategies that will restore fisher populations and enhance habitat to the point that the fisher can be down-listed from state endangered or threatened status in Washington)"}, "madsrdf:citationSource": "Hayes, G.E. Washington State recovery plan for the fisher, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. iii (The Endangered Species Act of 1973 (ESA), as amended (16 U.S.C. 1531 et seq.), requires the development of recovery plans for listed species, unless such a plan would not promote the conservation of a particular species. In accordance with section 4(f)(1) of the Act and to the maximum extent practicable, recovery plans delineate actions which the best available science indicates are required to recover and protect listed species. Plans are published by the U.S. Fish and Wildlife Service (USFWS), and may be prepared with the assistance of recovery teams, contractors, state agencies, and others; Recovery plans do not necessarily represent the views or the official positions or approval of any individuals or agencies involved in the plan formulation, other than the USFWS. They represent the official position of USFWS only after they have been signed by the Regional Director. Approved recovery plans are subject to modification as dictated by new information, changes in species status, and the completion of recovery actions)"}, "madsrdf:citationSource": "Work cat.: Recovery plan for the ocelot (Leopardus pardalis), 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Endangered species recovery plan (An endangered species recovery plan is a document describing the current status, threats and intended methods for increasing rare and endangered species population sizes. The U.S. Endangered Species Act of 1973 requires that all species considered endangered must have a plan implemented for their recovery, but the format is also useful when considering the conservation of any endangered species. Recovery plans act as a foundation from which you can build a conservation effort and they can help to make conservation more effective; Section 4(f) of the United States Endangered Species Act from 1973 directs the Secretary of the Interior and the Secretary of Commerce to develop and implement recovery plans to promote the conservation of endangered and threatened species; The recovery plan is a document which specifies what research and management actions are necessary to support recovery, but does not itself commit manpower or funds. Recovery plans are used in setting funding priorities and provide direction to local, regional, and state planning efforts)"}, "madsrdf:citationSource": "Wikipedia, Sept. 13, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (This recovery plan is intended to provide the basis for remedying the deficiencies in our understanding of these threatened plants. It aims to ensure that viable, self-sustaining populations of all five taxa are established or restored in the wild throughout their known natural range) p. 28 (recovery plans)"}, "madsrdf:citationSource": "Jones, C. Recovery plan for threatened grassy plants of dry fertile sites, 2003-13, \u00a92004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. i (Recovery plans delineate reasonable actions that are believed to be required to recover and protect listed species. We, the U.S. Fish and Wildlife Service, publish recovery plans, sometimes with the assistance of recovery teams, contractors, State agencies, Tribal agencies, and other affected and interested parties) p. 2 (Between 2002 and 2004, we completed three separate draft bull trout recovery plans)"}, "madsrdf:citationSource": "Recovery plan for the coterminous United States population of bull trout (Salvelinus confluentus), 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Endangered species recovery plans"}}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Endangered species recovery plans"}}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Threatened species recovery plans"}}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Threatened species recovery plans"}}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Species at risk recovery plans"}}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Species at risk recovery plans"}}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Species recovery plans"}}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Species recovery plans"}}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Recovery plans, Wildlife"}}, {"@id": "_:n062532b4b3134a0088aee0e1e95bb4adb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Recovery plans, Wildlife"}}], "@id": "/authorities/genreForms/gf2016026087"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026090", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMathematical fiction", "identifiers:lccn": "gf2016026090", "madsrdf:adminMetadata": [{"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb1"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mathematical fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb5"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb6"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb7"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb8"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb9"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb10"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb11"}], "madsrdf:hasVariant": [{"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb12"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb15"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features mathematics and mathematicians."}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mathematical fiction"}}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "summary (While taking a class on infinity at Stanford in the late 1980s, Ravi Kapoor discovers that he is confronting the same mathematical and philosophical dilemmas that his mathematician grandfather had faced many decades earlier--and that had landed him in jail. Charged under an obscure blasphemy law in a small New Jersey town in 1919, Vijay Sahni is challenged by a skeptical judge to defend his belief that the certainty of mathematics can be extended to all human knowledge--including religion. Together, the two men discover the power--and the fallibility--of what has long been considered the pinnacle of human certainty, Euclidean geometry. As grandfather and grandson struggle with the question of whether there can ever be absolute certainty in mathematics or life, they are forced to reconsider their fundamental beliefs and choices. Their stories hinge on their explorations of parallel developments in the study of geometry and infinity--and the mathematics throughout is as rigorous and fascinating as the narrative and characters are compelling and complex.)"}, "madsrdf:citationSource": "Work cat.: Suri, G. A certain ambiguity : a mathematical novel, \u00a92007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sixteen short stories involving mathematics, including tales in which a nineteenth-century woman mathematician is murdered, a nursing home resident explains how he disproved Goldbach's conjecture in college, and Scottish physicist James Clerk Maxwell discovers electromagnetic waves)"}, "madsrdf:citationSource": "Kasman, A. Reality conditions : short mathematical fiction, \u00a92005", "madsrdf:citationStatus": "found"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres (Math Fiction; Mathematics Fiction)"}, "madsrdf:citationSource": "Goodreads website, Sept. 14, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 36 (Mathematical fiction has probably existed since ideas have been written down and certainly as early as 414 BC. Mathematical fiction is a recently rediscovered and growing literature, as sales of the novels: The Curious Incident of the Dog in the Night-time (2003) and The Da Vinci Code (2004) attest ... This article describes a novel and two plays with mathematical themes ... Traditionally, primary teachers have used children's literature to encourage mathematical thinking by providing an engaging and often humorous context for the introduction of mathematical-scientific ideas. It is generally acknowledged, for example, in a National Council of Teachers of Mathematics (NCTM) curriculum yearbook, that (children's) literature can help students meaningfully connect their world to the world of mathematical ideas) p. 37 (mathematical fiction successfully \"marries\" literature and mathematics creating the ideal forum to nurture critical thinking and introduce sophisticated mathematical ideas; ninth graders as young as 13 or 14 years of age can engage with Flatland (Abbott, 1884, 1932) and the first five chapters of its modern update Flatterland (Stewart, 2001) to: develop problem-solving and critical-thinking skills; better understand different geometries, such as fractal geometry and different dimensions; develop the skill to make unbiased valid inferences; and, understand and discuss the philosophy of mathematics)"}, "madsrdf:citationSource": "Padula, J. Mathematical fiction for senior students and undergraduates, in Australian senior mathematics journal, v. 20, no. 2, viewed online Sept. 14, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mathematical fiction is a genre of creative fictional work in which mathematics and mathematicians play important roles. ... One of the earliest and much studied work of this genre is Flatland: A Romance of Many Dimensions, an 1884 satirical novella by the English schoolmaster Edwin Abbott Abbott. Though, probably, mathematical fiction might have existed since ancient times, it was rediscovered as a genre of literature recently, and since its rediscovery there has been a growing body of literature in this genre and the genre has attracted a growing body of readers. For example, Abbot's Flatland spawned a sequel in the twenty-first century in the form a novel titled Flatterland authored by Ian Stewart and published in 2001; Alex Kasman, a Professor of Mathematics at College of Charleston, who maintains a database of works that could possibly be included in this genre, has a broader definition for the genre: Any work containing mathematics or mathematicians has been treated as mathematical fiction)"}, "madsrdf:citationSource": "Wikipedia, Sept. 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Mathematics > Maths Fiction (Maths Fiction. These books may contain elements of, or things that depend on, mathematics - number systems, codes or time travel, for example. They may use the narrative to explore simple or complex mathematical concepts.)"}, "madsrdf:citationSource": "The Arthur Holt Library LibGuides website, Sept. 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "jkt. (First there was Edwin A. Abbott's remarkable Flatland, published in 1884, and one of the all-time classics of popular mathematics. Now, from mathematician and accomplished science writer Ian Stewart, comes a dazzling, modern sequel; provides an engaging, completely accessible guide to some of the trickiest concepts in contemporary mathematics. Through larger-than-life characters and an inspired story line, Flatterland explores our present understanding of the shape and origins of the universe, the nature of space, time, and matter, as well as modern geometries and their applications; Flatterland is the story of Vikki's fantastic voyage through the Mathiverse. From the Charming Construction Entity to Moobius, the one-sided cow)"}, "madsrdf:citationSource": "Stewart, I. Flatterland : like Flatland only more so, \u00a92001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Maths fiction"}}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maths fiction"}}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mathematics fiction"}}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mathematics fiction"}}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Math fiction"}}, {"@id": "_:n66ae4591bbf1414798221a60fc6e6b8cb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Math fiction"}}], "@id": "/authorities/genreForms/gf2016026090"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026092", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJump rope rhymes", "identifiers:lccn": "gf2016026092", "madsrdf:adminMetadata": [{"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b1"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jump rope rhymes"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026459"}, "madsrdf:hasSource": [{"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b5"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b6"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b7"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b8"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b9"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b10"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b11"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b12"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b13"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b14"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b15"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b16"}], "madsrdf:hasVariant": [{"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b17"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b20"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b23"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b26"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b29"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b32"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b35"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b38"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b41"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b44"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b47"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b50"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jump rope rhymes"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "table of contents (Rope-jumping rhymes)"}, "madsrdf:citationSource": "The best of Texas folk and folklore, 1916-1954, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jump rope rhymes. UF Rope skipping rhymes; Skipping rhymes. BT Nursery rhymes)"}, "madsrdf:citationSource": "LCSH, Sept. 20, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cosbey, R.C. All in together, girls : skipping songs from Regina, Saskatchewan, 1980.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Jump the rope jingles, 1961.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Annie jump-rope jingles, c1983.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Coupland, L.H. Jumping rope rhyme, c1947.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Anna Banana : 101 jump-rope rhymes, c1989.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Dotlich, R.K. Over in the pink house : new jump rope rhymes, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Skipping-rope rhyme (A skipping rhyme (occasionally skipping-rope rhyme or jump-rope rhyme), is a rhyme chanted by children while skipping. Such rhymes have been recorded in all cultures where skipping is played. Examples of English-language rhymes have been found going back to at least the 17th century. Like most folklore, skipping rhymes tend to be found in many different variations)"}, "madsrdf:citationSource": "Wikipedia, Sept. 20, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Jump-rope rhymes, 1969.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Jump rope rhymes, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(jump songs, rhymes and chants that help keep the cadence while skipping rope; rope songs)"}, "madsrdf:citationSource": "The great list of jump rope rhymes & skipping songs, via WWW, viewed Sept. 20, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rope songs (Jump rope rhymes)"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rope songs (Jump rope rhymes)"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jump rope jingles"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jump rope jingles"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Skipping rope rhymes"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skipping rope rhymes"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Skipping songs (Jump rope rhymes)"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skipping songs (Jump rope rhymes)"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "