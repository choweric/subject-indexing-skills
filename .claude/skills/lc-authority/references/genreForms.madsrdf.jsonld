", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legislative speeches"}}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b8b94378160416da05613ef6d8f8dbab9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed speeches"}}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed speeches"}}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b8b94378160416da05613ef6d8f8dbab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised speeches"}}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised speeches"}}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b8b94378160416da05613ef6d8f8dbab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio speeches"}}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio speeches"}}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (an edited transcript from a speech given at Family Forum III in Dallas, Texas, August 17, 1984) (OCoLC)13560933"}, "madsrdf:citationSource": "Marshner, C.C. Why the family matters, \u00a91985:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(speech: A talk or formal address given to a public audience, extemporaneously or from a prepared text. In the 18th and 19th centuries, speeches were often separately published in print. Today, major public speeches are published in the New York Times and in the biweekly periodical Vital Speeches of the Day. Landmark speeches are usually anthologized.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Commencement speech (A commencement speech or commencement address is a speech given to graduating students, generally at a university, generally in the US, although the term is also used for secondary education institutions) Baccalaureate service: (Baccalaureate addresses can range in length from under half an hour to as long as four hours) Inauguration (The \"inaugural address\" is a speech given during this ceremony which informs the people of his/her intentions as a leader) State of the Union (The State of the Union is the address presented by the President of the United States to a joint session of the United States Congress, typically delivered annually; State of the Union address) State of the State address (The State of the State Address is a speech customarily given once each year by the governors of each of the states of the United States (although the terminology for this speech differs for some states: in Iowa, the speech is called the Condition of the State Address; in Kentucky, Massachusetts, Pennsylvania, and Virginia it is called the State of the Commonwealth Address.) State of the City address (The State of the City Address - or State of the City Speech - is a speech customarily given once each year by the mayors of many cities in the United State, Canada, and the Philippines. Other international cities have also adopted the tradition)"}, "madsrdf:citationSource": "Wikipedia, July 31, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 77 (speech: talk, conversation, discourse; statement, remark; formal address, oration; printed copy of this; speechlet: short speech)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab21", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Legislative speeches)"}, "madsrdf:citationSource": "Genre/form terms for law materials [report prepared by the Technical Services Special Interest Section of AALL], 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab22", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(talk: the act of talking formally about something before a group of people : a speech or lecture)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Sept. 7, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab23", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(speeches (documents). UF addresses (documents). Documents containing the text of any public address or talk. NT lectures; monologues; orations; sermons)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab24", "@type": "madsrdf:Source", "madsrdf:citationSource": "The 10 best graduation speeches of all time, via CNBC website, viewed July 31, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab25", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Speeches Use Addresses; Addresses. UF Orations; Speeches. BT Discoursive works. NT Academic addresses; Convicts' addresses; Lectures; Legislative addresses; Occasional addresses; Sermons)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab26", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (transcripts from three major speeches on the development and future of independent broadcasting) (OCoLC)14068126"}, "madsrdf:citationSource": "Independent broadcasting, 1985:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab27", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(talk 1.2. An informal address or lecture)"}, "madsrdf:citationSource": "Oxford dictionaries website, Sept. 7, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b8b94378160416da05613ef6d8f8dbab29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Legislative speeches"}}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legislative speeches"}}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b8b94378160416da05613ef6d8f8dbab32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Academic addresses"}}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Academic addresses"}}, {"@id": "_:n6b8b94378160416da05613ef6d8f8dbab34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b8b94378160416da05613ef6d8f8dbab35"}]}, "madsrdf:variantLabel": {"@language"