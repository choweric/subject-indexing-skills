{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026508", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRadio public service announcements", "identifiers:lccn": "gf2011026508", "madsrdf:adminMetadata": [{"@id": "_:n124885265a954e5184fc39015fcb88acb1"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Radio public service announcements"}, "madsrdf:elementList": {"@list": [{"@id": "_:n124885265a954e5184fc39015fcb88acb3"}]}, "madsrdf:exampleNote": "Note under [Public service radio programs]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026486"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026038"}], "madsrdf:hasSource": [{"@id": "_:n124885265a954e5184fc39015fcb88acb5"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb6"}], "madsrdf:hasVariant": [{"@id": "_:n124885265a954e5184fc39015fcb88acb7"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb10"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb13"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb16"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb19"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb22"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb25"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb28"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb31"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb34"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Radio announcements aired by or on behalf of nonprofit or governmental organizations to persuade the audience to take some specific action or adopt a favorable view toward a service, institution, or cause. For radio programs aired by or on behalf of nonprofit or governmental organizations to promote the common well-being or general welfare of society see [Public service radio programs.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025550"}}, {"@id": "_:n124885265a954e5184fc39015fcb88acb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:36:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio public service announcements"}}, {"@id": "_:n124885265a954e5184fc39015fcb88acb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Public service announcements: Usually unpaid announcements of any length presented by or on behalf of nonprofit or governmental organizations used to persuade the audience to take some specific action or adopt a favorable view towards some service, institution, or cause. RT Announcements. Example: Saint Charles Community Center appeal spots)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Nov. 7, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A public service announcement (PSA) or community service announcement (CSA) is a non-commercial advertisement typically on radio or television, ostensibly broadcast for the public good. The main concept is to modify public attitudes by raising awareness about specific issues)"}, "madsrdf:citationSource": "Wikipedia, Nov. 7, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n124885265a954e5184fc39015fcb88acb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n124885265a954e5184fc39015fcb88acb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio public service advertisements"}}, {"@id": "_:n124885265a954e5184fc39015fcb88acb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio public service advertisements"}}, {"@id": "_:n124885265a954e5184fc39015fcb88acb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n124885265a954e5184fc39015fcb88acb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Community service announcements, Radio"}}, {"@id": "_:n124885265a954e5184fc39015fcb88acb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Community service announcements, Radio"}}, {"@id": "_:n124885265a954e5184fc39015fcb88acb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n124885265a954e5184fc39015fcb88acb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio PSAs"}}, {"@id": "_:n124885265a954e5184fc39015fcb88acb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio PSAs"}}, {"@id": "_:n124885265a954e5184fc39015fcb88acb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n124885265a954e5184fc39015fcb88acb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio community service announcements"}}, {"@id": "_:n124885265a954e5184fc39015fcb88acb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio community service announcements"}}, {"@id": "_: