}, {"@id": "_:n69e07a2d3613470b8394e3d2b80f73dbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Country-dances (Music)"}}, {"@id": "_:n69e07a2d3613470b8394e3d2b80f73dbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Country dance; an English dance widely popular in the 17th century; spread to the Continent, particularly France, where it became known as the contredanse)"}, "madsrdf:citationSource": "Grove music online, viewed August 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n69e07a2d3613470b8394e3d2b80f73dbb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n69e07a2d3613470b8394e3d2b80f73dbb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Contra dances (Music)"}}, {"@id": "_:n69e07a2d3613470b8394e3d2b80f73dbb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Contra dances (Music)"}}, {"@id": "_:n69e07a2d3613470b8394e3d2b80f73dbb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n69e07a2d3613470b8394e3d2b80f73dbb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Contradanses (Music)"}}, {"@id": "_:n69e07a2d3613470b8394e3d2b80f73dbb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Contradanses (Music)"}}, {"@id": "_:n69e07a2d3613470b8394e3d2b80f73dbb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n69e07a2d3613470b8394e3d2b80f73dbb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Contrandances (Music)"}}, {"@id": "_:n69e07a2d3613470b8394e3d2b80f73dbb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Contrandances (Music)"}}], "@id": "/authorities/genreForms/gf2014026737"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026738", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCountry gospel music", "identifiers:lccn": "gf2014026738", "madsrdf:adminMetadata": [{"@id": "_:n2dabea03a55a45d49def8a6553745602b1"}, {"@id": "_:n2dabea03a55a45d49def8a6553745602b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Country gospel music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2dabea03a55a45d49def8a6553745602b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026739"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026839"}], "madsrdf:hasSource": [{"@id": "_:n2dabea03a55a45d49def8a6553745602b5"}, {"@id": "_:n2dabea03a55a45d49def8a6553745602b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2dabea03a55a45d49def8a6553745602b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2dabea03a55a45d49def8a6553745602b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2dabea03a55a45d49def8a6553745602b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Country gospel music"}}, {"@id": "_:n2dabea03a55a45d49def8a6553745602b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The sound of country gospel is similar to traditional country - the only difference is, the subject matter is religious, not secular. Like traditional country, the sound of country gospel became smoother and more pop-oriented as the decades progressed, and by the early '70s, it became nearly indistinguishable from the lush sounds of mainstream pop. That trend continued throughout the rest of the '70s and '80s, and by the '90s, contemporary country gospel sounded identical to the adult contemporary inclinations of CCM. Nevertheless, that music was never widely recognized as country gospel, which will always be identified with its simple arrangements, small vocal choirs, and twangy instrumentation)"}, "madsrdf:citationSource": "All Music Guide WWW site, Nov. 23, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n2dabea03a55a45d49def8a6553745602b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "program notes (The majority of Hank's records ended up on jukeboxes in bars, so the religious recordings were sharply curtailed ... Perhaps if he'd lived a little longer, he would have recorded religious albums, much like this one)"}, "madsrdf:citationSource": "Work cat.: Williams, H. I saw the light [SR]:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026738"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026739", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCountry music", "identifiers:lccn": "gf2014026739", "madsrdf:adminMetadata": [{"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b1"}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Country music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b3"}]}, "madsrdf:exampleNote": "Note under [Old-time music]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026630"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026664"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026738"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026740"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026745"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026863"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027002"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027055"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027169"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027172"}], "madsrdf:hasSource": {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b5"}, "madsrdf:hasVariant": [{"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b6"}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b9"}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": ["Country music of the 1940s and later periods. For country music of the 1930s and earlier periods played and sung in the old-time styles, as well as music of later periods played in those styles, see [Old-time music.]", "For country lyrics that appear without a musical setting see Country lyrics."]}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-12T12:03:06"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Country music"}}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Country music; origins are the folk music of mostly white, working-class Americans; primary themes include an imagined rural idealism, a celebration of working-class identity, an iconography drawn from the traditions of the American cowboy, and a predominantly Southern, white, Christian, socially conservative and patriotic philosophy)"}, "madsrdf:citationSource": "Grove music online, viewed August 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Western and country music"}}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Western and country music"}}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Country and western music"}}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Country and western music"}}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hillbilly music"}}, {"@id": "_:n77560a9ef50e4d93bbb42d27c2a409f9b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hillbilly music"}}], "@id": "/authorities/genreForms/gf2014026739"}
