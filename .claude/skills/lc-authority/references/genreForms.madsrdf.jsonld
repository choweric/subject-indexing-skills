{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026091", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBiographical television programs", "identifiers:lccn": "gf2011026091", "madsrdf:adminMetadata": [{"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b1"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Biographical television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b3"}]}, "madsrdf:exampleNote": "Note under [Drames \u00e0 clef (Television programs).]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasSource": [{"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b5"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b6"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b7"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b8"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b9"}], "madsrdf:hasVariant": [{"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b10"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b13"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b16"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b19"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b22"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b25"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b28"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b31"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction or nonfiction television programs that depict the lives of real people. For fictional television programs in which real persons, places, or events are depicted under invented names see [Drames \u00e0 clef (Television programs).]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007004503"}}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:21:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biographical television programs"}}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Biographical (Nonfiction): nonfiction work documenting the life and career (or portion thereof) of an individual or small group of related persons such as a family; Biographical: fictional work dramatizing the life (or portion thereof) of an actual historical figure (often including their family and/or associates), and told with varying degrees of accuracy)"}, "madsrdf:citationSource": "Moving image genre-form guide online, June 21, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nc306bb18f12a42c4890c2da88c5f8e89b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(television biopic; made for-television biopic; made-for-British television biopic; television bio-pic; made-for-television bio-pic; cable television bio-pic; television bio-pic mini-series; television bio pic; the genre of the television bio-pic)"}, "madsrdf:citationSource": "Google search, Mar. 16, 2012", "madsrdf:citationStatus": "found"}, {"@