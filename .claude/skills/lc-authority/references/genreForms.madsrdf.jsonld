dsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Patterns (Instructional works)"}}, {"@id": "_:n08f0fab1f494496c96cd11255e5325ddb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pattern sheets; UF Patterns; BT Design drawings; RT Transfer sheets; Sheets drawn or printed with designs used as outlines or guides to make something. Examples include dress making, embroidery, and carpentry patterns.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, May 24, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n08f0fab1f494496c96cd11255e5325ddb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Patterns for crafts; reference record: use subdivision Patterns under individual crafts, e.g. Dressmaking--Patterns; Embroidery--Patterns; Glass craft--Patterns; Grilles--Patterns; Hand weaving--Patterns; Lace and lace making--Patterns; Tailoring--Patterns.)"}, "madsrdf:citationSource": "LCSH, May 24, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n08f0fab1f494496c96cd11255e5325ddb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(patterns (guides); note: Forms or models, made from a variety of materials, cut to the size or profile of the finished article and used as a guide during its construction.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, May 24, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n08f0fab1f494496c96cd11255e5325ddb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n08f0fab1f494496c96cd11255e5325ddb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pattern sheets"}}, {"@id": "_:n08f0fab1f494496c96cd11255e5325ddb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pattern sheets"}}], "@id": "/authorities/genreForms/gf2019026027"}
