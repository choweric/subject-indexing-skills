t", "madsrdf:elementValue": {"@language": "en", "@value": "Meditations"}}, {"@id": "_:n5475045effdc46a7be5c6f06c81a779cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Meditations (This heading is used for collections of thoughts on spiritual truths for use in meditation.; BT Devotional literature)"}, "madsrdf:citationSource": "Religion genre/form terms: information gathered on behalf of the Library of Congress... American Theological Library Association, et. al, c2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5475045effdc46a7be5c6f06c81a779cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "meditation (def. 1 :a spoken or written discourse treated in a contemplative manner and intended to express its author's reflections or especially when religious to guide others in contemplation)"}, "madsrdf:citationSource": "Merriam Webster online, June 2, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5475045effdc46a7be5c6f06c81a779cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "meditation (def. 2a: A discourse, written or spoken, in which a subject (usually religious) is treated in a meditative manner, or which is designed to guide the reader or hearer in meditation. Freq. in pl.)"}, "madsrdf:citationSource": "OED online, June 2, 2015:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026056"}
