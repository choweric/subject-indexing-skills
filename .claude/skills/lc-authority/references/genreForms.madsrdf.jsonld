GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rachenitsas (Music)"}}, {"@id": "_:nd4c2cc0b9cc84b0eab2e0c9ecbc968edb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Harvard dict. of music, 1986;Web. 3", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nd4c2cc0b9cc84b0eab2e0c9ecbc968edb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 97-708061: Vladigerov, P. Kont\ufe20s\ufe21ert za t\ufe20s\ufe21igulka i orkest\u016dr no. 1, op. 11 [SR] 197-.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4c2cc0b9cc84b0eab2e0c9ecbc968edb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Bulgaria: Characteristics of pre-socialist musical culture, 1800--1944 (The most popular heterometric dance is the rachenitsa, an energetic khoro in 7/16 (2 + 2 + 3) with various local names (ex.11). It is performed individually, by couples or in groups, indoors or outside, especially during weddings and other celebrations.)"}, "madsrdf:citationSource": "Grove music online, Feb. 4, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4c2cc0b9cc84b0eab2e0c9ecbc968edb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 3, p. 436."}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4c2cc0b9cc84b0eab2e0c9ecbc968edb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd4c2cc0b9cc84b0eab2e0c9ecbc968edb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ratchenitzas (Music)"}}, {"@id": "_:nd4c2cc0b9cc84b0eab2e0c9ecbc968edb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ratchenitzas (Music)"}}, {"@id": "_:nd4c2cc0b9cc84b0eab2e0c9ecbc968edb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd4c2cc0b9cc84b0eab2e0c9ecbc968edb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@va