"ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Messages (Official communications)"}}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bealey, F. The Blackwell dictionary of political science, 1999;The encyclopedia of political science, c2011;Encyclopedia of government and politics, 2004;Encyclopedia of political theory, c2010;Encyclopedia of politics, c2005;Encyclopedia of governance, c2007;Robertson, D. A dictionary of modern politics, c2002.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "74176112: Texas. Governor. Legislative messages of the chief executives of Texas, 1972-", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(message: an official or formal communication, esp. a speech delivered by a head of state to a legislative assembly or the public: \"the president's message to Congress\")"}, "madsrdf:citationSource": "The new Oxford American dictionary, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Governors--Messages. UF Governors' messages; Gubernatorial messages; Messages, Gubernatorial; Presidents--Messages. UF Messages, Presidential; Presidential messages)"}, "madsrdf:citationSource": "LCSH, Oct. 17, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Oregon. Governor (1959-1967 : Hatfield). Farewell address and legislative message to the fifty-fourth biennial Legislature, 1967.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(message 1c. An official communication from the Sovereign to Parliament; also, a communication from Parliament to members of the royal family, or between the two houses of Parliament themselves; U.S. a communication from a chief executive officer to a legislative body conveying instructions or information on matters of policy; esp. the Presidential address transmitted to Congress at the opening of the Session)"}, "madsrdf:citationSource": "OED", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, pp. 634-635 (State of the Union. The \"Annual Message,\" the only communication constitutionally required of the president, moved from a speech to a written report delivered to and read to Congress when Jefferson thought it too regal. The tradition of the president delivering the message in person was revived by Woodrom Wilson) p. 637 (veto messages)"}, "madsrdf:citationSource": "Encyclopedia of political communication, c2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Roosevelt, Theodore. Addresses and presidential messages of Theodore Roosevelt, 1902-1904, 1971.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Louisiana. Governor (1864-1865 : Allen). Annual message of Governor Henry Watkins Allen, to the Legislature of the state of Louisiana, 1865.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(State of the Union: The name of the information and recommendations--presented in the form of a written message or a speech--that the president of the U.S. is constitutionally required to deliver)"}, "madsrdf:citationSource": "Safire, W. Safire's political dictionary, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "United States. President (1909-1913 : Taft). Presidential messages to Congress, \u00a92002.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 226 (State of the Union Message. An annual message to Congress in which the President proposes his legislative program. \"State of the state\" and \"state of the city\" messages are typically delivered by governors and mayors to their state legislatures and city councils.)"}, "madsrdf:citationSource": "Plano, J.C. The American political dictionary, c2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(message 2. an official communication, as from a chief executive to a legislative body: \"the President's message to Congress\")"}, "madsrdf:citationSource": "Random House unabridged dictionary, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf545b53cbbad4307ba26245d07948728b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Legislative messages"}}, {"@id": "_:nf545b53cbbad4307ba26245d07948728b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legislative messages"}}], "@id": "/authorities/genreForms/gf2016026100"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026101", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMartial arts fiction", "identifiers:lccn": "gf2016026101", "madsrdf:adminMetadata": [{"@id": "_:n42c86b22715c483aafe1da32bf6653e5b1"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Martial arts fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n42c86b22715c483aafe1da32bf6653e5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n42c86b22715c483aafe1da32bf6653e5b5"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b6"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b7"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b8"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b9"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b10"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b11"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b12"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b13"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b14"}], "madsrdf:hasVariant": {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b15"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-10-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Martial arts fiction"}}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ninja in popular culture (Ninja-themed novels include: American Chillers and Magic Tree House series: New York Ninjas and Night of the Ninjas; Brett Wallace: Ninja Master: Eight-book series by Wade Barker (Richard Meyers); Demon King Daimao: Light novels by Shotaro Mizuki with girls representing the rival Koga and Iga ninja clans, they were adapted into anime and manga series; The Diamond Chariot: Erast Fandorin learns ninjutsu in Japan; Fukur\u014d no Shiro by Ryotaro Shiba, who also wrote a collection of short stories (Saigo no Igamono); Kage Kara Mamoru!: Series of light novels adapted into manga and anime series; The Kouga Ninja Scrolls (K\u014dga Ninp\u014dch\u014d): Novel by Futaro Yamada about two rival ninja clans, the Iga and Kouga, adapted into manga and anime series and a live-action film; Tulku, a Tale of Modern Ninja: Novel by American ninjutsu practitioner Stephen K. Hayes; Kamui: A series of five novels by Tetsu Yano, later adapted in manga, anime and live-action formats; Ninja's Revenge and The Bamboo Bloodbath by Piers Anthony; Mirror Friend, Mirror Foe: Novel by Robert Asprin and George Takei, featuring a future ninja clan member; The Ninja: Thriller by Eric Van Lustbader featuring a half-Japanese, half-white character who received ninjutsu training in his youth; followed by The Miko, White Ninja, The Kaisho, Floating City and Second Skin; The Ninja Murders: Historical novel by Andrew B. Suhrer; Ninja Slayer: Series of Japanese cyberpunk novels by \"Bradley Bond\". They were later adapted into a manga and anime series; Not for Glory: Space opera novel by Joel Rosenberg about a mercenary Jewish-Japanese tribe which practices ninjutsu; Sanada Ten Braves (Sanada J\u016by\u016bshi): Meiji legend, first published in novel form in 1912 during the Taish\u014d period; Shinobi no Mono: Series of novels by Tomoyoshi Murayama about the life of Ishikawa Goemon. During the 1960s it was adapted into a series of films about Goemon and other historical ninja; Tales of the Otori: The Tribe consists of five ninja families with powers; Tsuma-wa, Kunoichi: A historical novel)"}, "madsrdf:citationSource": "Wikipedia, Oct. 27, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Martial arts, by the book (As a graduate student studying Asian literature, Chris Hamm envisioned a career studying Buddhist texts. Instead he has spent the past 15 years studying popular martial arts fiction from China ... Hamm describes martial arts novels as a combination of adventure and romance set in a mythical China of the past. The novels, he says, bear little resemblance to martial arts films. \"Instead, think of a blend of Lord of the Rings fantasy--epic in scope, with strange beings--and the classic Western, with its mythification of national history. The novels take a fantasy of a certain period of the collective historical imagination and make it into a world of its own.\" In Chinese literature, there are tales of heroic swordsmen dating as far back as 200 B.C.E. In the Tang Dynasty (618-907 C.E.), a genre of short fiction often included tales of swordsmen. Modern martial arts novels, intended to evoke these earlier traditions, are in fact markedly different. \"The language, the narrative structure, and the themes are all different than what came before,\" says Hamm. \"This is mass entertainment literature, and it uses mass entertainment approaches such as cliffhangers and emotional crises that modern readers find sympathetic.\")"}, "madsrdf:citationSource": "University of Washington. College of Arts and Sciences. Perspectives newsletter, autumn 2006, viewed online Oct. 26, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a picture book for children; 1st subj. hdg.: Child ninja--Juvenile fiction; 2nd subj. hdg.: Martial arts--Juvenile fiction)"}, "madsrdf:citationSource": "Work cat.: Ishida, Sanae. Little Kunoichi, the ninja girl, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Chen, P. The history of Chinese martial arts fiction, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kehl, M. Tournament of fear and other martial arts stories, \u00a91999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Martial arts fiction. BT Fiction; Martial arts fiction, Chinese. BT Chinese fiction; Martial arts fiction, Korean. BT Korean fiction)"}, "madsrdf:citationSource": "LCSH, Oct. 26, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Keulemans, P. Sound rising from the paper : nineteenth-century martial arts fiction and the Chinese acoustic imagination, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ninja as entertainment \uff1e Ninjas as fiction in Japan (Kodan is kind of a storytelling. A story teller sits on the stage and he talks about war mostly chronicles and political stories in an amusing and interesting way to the audience. Right there, kodan storytellers spoke of activities and actions of ninjas such as \"Sarutobi and Sasuke (\u733f\u98db \u4f50\u52a9)\" with much passion. The appearance of ninja novels: In 1911, \"Tatsukawa Bunko (\u7acb\u5ddd\u6587\u5eab)\" began being published. Until then, the mainstream way of enjoying Kodan was to listen to the story which a kodanshi told. A way of appreciating military histories by reading books had been discovered. Tatsukawa Bunko had been supported mainly by teenage boys especially his works on \"Sarutobi, Sasuke\" and \"Kirigakure, Saizou (\u9727\u96a0\u624d\u8535)\" got great popularity. Both, Sasuke and Saizo were ninjas whose public biographies are not well known. Authors of these books took advantage of that fact and they dramatized the ninja stories on a large scale as fiction. For instance, in the novels, Sasuke could control any kind of Ninjutsu like witchcraft only by making symbolic signs with his fingers.)"}, "madsrdf:citationSource": "Ninja encyclopedia, via WWW, Oct. 27, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Whitman, J. Ghostwarrior and other martial arts stories, \u00a92000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wan, M.B. Green peony and the rise of the Chinese martial arts novel, \u00a92009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n42c86b22715c483aafe1da32bf6653e5b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ninja fiction"}}, {"@id": "_:n42c86b22715c483aafe1da32bf6653e5b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ninja fiction"}}], "@id": "/authorities/genreForms/gf2016026101"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026102", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSelf-help publications", "identifiers:lccn": "gf2016026102", "madsrdf:adminMetadata": [{"@id": "_:n396a17ded71a4fc2bd4782529851000eb1"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Self-help publications"}, "madsrdf:elementList": {"@list": [{"@id": "_:n396a17ded71a4fc2bd4782529851000eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, "madsrdf:hasSource": [{"@id": "_:n396a17ded71a4fc2bd4782529851000eb5"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb6"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb7"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb8"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb9"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb10"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb11"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb12"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb13"}], "madsrdf:hasVariant": [{"@id": "_:n396a17ded71a4fc2bd4782529851000eb14"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb17"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Self-help publications"}}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Copeland, M.E. Making and keeping friends : a self-help guide, 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 14 (\"If you're new to the self-help world, I'm hoping this book will ease you into some of the basic concepts that totally changed my life so you can have a breakthrough, too\") p. 15 (self-help books) p. 4 of cover (You Are a Badass is the self-help book for people who desperately want to improve their lives but don't want to get busted doing it.)"}, "madsrdf:citationSource": "Work cat.: Sincero, Jen. You are a bad ass : how to stop doubting your greatness and start living an awesome life, \u00a92013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Self-help; self-help genre; Books in the self-help nonfiction genre are based on one's own effort and resources to achieve things and goals without relying on the help of others. The books in this genre can be about self-guided improvement in one's economic standing, their intellectual state of being, and in their emotionally and self-worth state of being. They can also be about support groups, how to find them, and what they're about. The support groups provide encouragement and techniques to assist people with similar goals and needs achieve them successfully.)"}, "madsrdf:citationSource": "The book genre dictionary website, Oct. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "2005002017: Dolby, S.K. Self-help books : why Americans keep reading them, \u00a92005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "2007037770: Laddon, J. Sally : the older woman's illustrated guide to self-improvement, \u00a92008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Self-help book (A self-help book is one that is written with the intention to instruct its readers on solving personal problems. The books take their name from Self-Help, an 1859 best-seller by Samuel Smiles, but are also known and classified under \"self-improvement\", a term that is a modernized version of self-help. Self-help books moved from a niche position to being a postmodern cultural phenomenon in the late twentieth century.)"}, "madsrdf:citationSource": "Wikipedia, Oct. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Self-improvement books now account for at least a 2.5 billion dollar a year industry in the U.S. alone, increasing since 1972 to at least 2.5% of the total number of books in print; a good self-help book follows the principles of good therapy; a successful self-help book author establishes a relationship with you by writing a book that's relatively easy to use, makes you feel that there's hope for you, shows you that the author understands your problems, gets you to commit to working with the book, and gives you at least some advice right away)"}, "madsrdf:citationSource": "Whitbourne, S.K. Five things you need to know about self-help books, via Psychology today website, posted May 22, 2012, viewed on Oct. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(self-help publication: A book, audiotape, or videotape intended to assist the reader, listener, or viewer in solving a personal problem, for example, finding the best treatment for a physical illness/condition or the answer to a legal question without having to pay for professional services. Some publishers specialize in self-help publications (example: Nolo Press, providing legal books for laypersons). Compare with how-to publication.)"}, "madsrdf:citationSource": "ODLIS: online dictionary for library and information science, Oct. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Koay, D.L. Self-improvement books : a genre analysis, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n396a17ded71a4fc2bd4782529851000eb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Self-help guides"}}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Self-help guides"}}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n396a17ded71a4fc2bd4782529851000eb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Self-improvement books"}}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Self-improvement books"}}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n396a17ded71a4fc2bd4782529851000eb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Self-help books"}}, {"@id": "_:n396a17ded71a4fc2bd4782529851000eb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Self-help books"}}], "@id": "/authorities/genreForms/gf2016026102"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026103", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aForensic fiction", "identifiers:lccn": "gf2016026103", "madsrdf:adminMetadata": [{"@id": "_:n5df348ff428046ce9d702094b6b1a378b1"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Forensic fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5df348ff428046ce9d702094b6b1a378b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026280"}, "madsrdf:hasSource": [{"@id": "_:n5df348ff428046ce9d702094b6b1a378b5"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b6"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b7"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b8"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b9"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b10"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b11"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b12"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b13"}], "madsrdf:hasVariant": [{"@id": "_:n5df348ff428046ce9d702094b6b1a378b14"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Forensic fiction"}}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Crime fiction: The forensic crime fiction; similar to the police procedural. The detective the reader follows is usually a medical examiner or pathologist--they must use the forensic evidence left on the body and at the crime scene to catch the killer. This subgenre was first introduced by Patricia Cornwell.)"}, "madsrdf:citationSource": "Wikipedia, Oct. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 123 (forensic fiction)"}, "madsrdf:citationSource": "Smith, L.L. Criminal justice and forensic science, 2015, via Google books, viewed Oct. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 54-55 (While the body has always played a central role in the narratives of crime fiction, in recent years we have witnessed an explosion in the popularity of the medical mystery or forensic detective novel, forms of the genre that more explicitly focus upon the ability of the forensic detective or pathologist to read and interpret the material traces of the body. The novels of writers such as Patricia Cornwell, Jeffrey Deaver, and Kathy Reichs are among those of a new generation characterized by this foregrounding not only of the anatomical or medicalized body, but also the technologies of forensic detection; the new sub-genre, forensic detective fiction, has become virtually synonymous with the name Patricia Cornwell, who is lauded by reviewers for creating the archetype of a genre that merges the mystery plot with graphic and highly detailed scientific prose. Whereas the genre of the detective novel, and its sub-genre, the police procedural, have been largely dominated by male authors and protagonists, the entrance of Cornwell into the field signals the significantly growing popularity of the figure of the female pathologist and medical expert)"}, "madsrdf:citationSource": "Palmer, J. Tracing bodies: gender, genre, and forensic detective fiction, in South Central review, autumn-winter 2001, viewed via JSTOR, Oct. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The anthropological forensic crime fiction is a detective genre which is primarily concerned with investigating human bodies; genre of anthropological forensic crime fiction; the (anthropological) forensic crime novel is a relatively young form of crime fiction; the forensic crime novel)"}, "madsrdf:citationSource": "Povidi\u0161a, I. Bones to read : an interpretation of forensic crime fiction, in Reconstruction, v. 8, no. 3 (2008), viewed online Oct. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Tempe Brennan series by Kathy Reichs; Patricia Cornwell's Kay Scarpetta series; Simon Beckett's Dr David Hunter series; Tess Gerritsen's Rizzoli & Isles series; The Body Farm series by Jefferson Bass)"}, "madsrdf:citationSource": "Forensic mysteries: five of the best, via Crime fiction lover website, Feb. 2, 2013, viewed Oct. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(3,380 results for \"forensic fiction\"; 2,300 results for \"forensic crime fiction\"; 7 results for \"forensic mystery fiction\"; 21,100 results for \"forensic mysteries\"; 49,500 results for \"forensic mystery novels\"; 1,150 results for \"forensic crime novels\"; 5,140 results for \"forensic novels\"; 5,210 results for \"forensic detective fiction\")"}, "madsrdf:citationSource": "Google search, Oct. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Forensic Fiction: Crime fiction particularly focused on science, technology and modern crime solving methods)"}, "madsrdf:citationSource": "Goodreads website, Oct. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Is there a more popular genre in the crime fiction field (on the printed page or TV screen) than the forensic pathologist? An army of world-weary, alcoholic detectives perhaps had readers feeling in need of a change--and that change exploded in the shape of clue-sifting medical examiner protagonists usually to be found up to their elbows in bones and blood. Crimes were now to be solved in the lab as much as at a crime scene, with a minute examination of such gruesome artefacts as human skin now the key to tracking down a murderer. The poster girl for the field is, of course, the phenomenally successful American Patricia Cornwell (who now travels with her own bodyguard after threats from 'unstable' readers), but she didn't inaugurate the forensic crime genre. ... There is absolutely no question as to who now rules the roost in forensic crime fiction. After her first novel Postmortem (1990), Patricia Cornwell bagged almost every important crime award and consolidated her success with a sequence of books featuring the tenacious (if vulnerable) Dr Kay Scarpetta, now the definitive fictional forensic pathologist.)"}, "madsrdf:citationSource": "Forshaw, B. Forensic fiction, via The bookseller website, viewed Oct. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: A serial killer is loose in Richmond, specializing in attractive young couples whose bodies are inevitably found in the woods months later--minus their socks and shoes. After months of exposure to the elements, all that remains of this killer's victims has, in every case, left Chief Medical Examiner Dr. Kay Scarpetta unable even to determine an exact cause of death. Frustrated that her high-tech forensic skills have apparently proved useless, Kay enlists the help of a ace crime reporter and a psychic.)"}, "madsrdf:citationSource": "Work cat.: Cornwell, Patricia Daniels. All that remains, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5df348ff428046ce9d702094b6b1a378b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Forensic detective fiction"}}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Forensic detective fiction"}}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5df348ff428046ce9d702094b6b1a378b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Forensic crime fiction"}}, {"@id": "_:n5df348ff428046ce9d702094b6b1a378b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Forensic crime fiction"}}], "@id": "/authorities/genreForms/gf2016026103"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026104", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScar literature", "identifiers:lccn": "gf2016026104", "madsrdf:adminMetadata": [{"@id": "_:n705153de198b4852a01be7f35b493f21b1"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Scar literature"}, "madsrdf:elementList": {"@list": [{"@id": "_:n705153de198b4852a01be7f35b493f21b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n705153de198b4852a01be7f35b493f21b5"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b6"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b7"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b8"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b9"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b10"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b11"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b12"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b13"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b14"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b15"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b16"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b17"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b18"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b19"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b20"}], "madsrdf:hasVariant": [{"@id": "_:n705153de198b4852a01be7f35b493f21b21"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b24"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b27"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b30"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b33"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b36"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b39"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b42"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Chinese fiction of the late 1970s and early 1980s that focuses on the physical and mental suffering that occurred during the Cultural Revolution."}, {"@id": "_:n705153de198b4852a01be7f35b493f21b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-11-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-08-14T11:53:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scar literature"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Chinese literature - Modern Chinese literature - After the Cultural Revolution: The accusatory \"scar literature,\" a sort of national catharsis that immediately followed the 10-year \"holocaust,\" gave way to more professional and more daring writing)"}, "madsrdf:citationSource": "Britannica online, Nov. 11, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(11,200 results for \"scar literature\"; 875 results for \"scar fiction\"; 3,050 results for \"wound literature\")"}, "madsrdf:citationSource": "Google search, Dec. 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Wound Literature Sh\u0101ngh\u00e9n W\u00e9nxu\u00e9 \u4f24\u75d5\u6587\u5b66 = shang hen wen xue. Wound literature, a genre appearing after the end of the Cultural Revolution, focuses on psychological and emotional damage to individuals, especially youth, from the depredations of that era. Criticized as subversive or embraced as cathartic when it first appeared, later analysis of the genre tends to focus on its literary weaknesses, including simplistic narrative and representation of character.)"}, "madsrdf:citationSource": "Berkshire encyclopedia of China, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Scar literature. The first new genre of fiction to emerge after the Cultural Revolution, \"Scar literature\" or \"wound literature\" (shanghen wenxue) lasted from the end of 1977 to 1979; stories dwell on the mental or physical scars left by the previous decade of radical politics; hundreds of hastily written \"Scar\" stories, poems and plays were published, \"exposing\" the \"dark side\" of socialist society. By the early 1980s, however, this highly emotional genre gave way to a more reflective, problem-oriented \"reform literature\" (gaige wenxue))"}, "madsrdf:citationSource": "Encyclopedia of contemporary Chinese culture, via WWW, Nov. 11, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 77 (In 1978, two years after the end of the Cultural Revolution, a new era of Chinese literature began. It was marked with the short story \"The Scar,\" written by Lu Xinhua; was the first to condemn the Cultural Revolution; it impressed the readers, aroused the strong sympathy of the whole society for the people who had been persecuted during the Cultural Revolution, and thus brought about a large number of similar short stories; with a political moral, these extraordinary and intriguing stories reveal the cruelty and ignorance of the Cultural Revolution, condemn class discrimination and social inequality, and end with bright, hopeful prospects. The critics often call these stories \"Scar Literature\") p. 78 (Most of the conflicts in the novels and short stories of Scar Literature are full of theatricality, owing to some chance events. To the writers, the Cultural Revolution is oppressive but generous, offering writers many romantic stories: evil prevails for a time and the good suffer but triumph in the end. These stories of Scar Literature appeal to humanitarianism; therefore, during that period of time, they evoked a lot of traumatic memories and intense arguments among the people) p. 81 (Scar Literature unmasks the dark ages to a certain degree, whereas Introspection Literature has a stronger political concern and is deeply in love with life in the early 1950s, which for the writers was full of \"bright prospects\")"}, "madsrdf:citationSource": "Jing, K. Contemporary Chinese fiction : politics and romance, 2007, via WWW, Nov. 11, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xxiv (Shanghen wenxue, or \"scar literature,\" has often been regarded as the first sign of a thaw in PRC literature after the Cultural Revolution and the death of Mao; writing about the atrocities of the ten-year mainland turmoil; by invoking the physical scar as a testament of the Cultural Revolution, writers of scar literature describe a body politic through which the past can be remembered and suppressed memory restored; scar literature and its immediate successor, fansi wenxue, or \"reflection literature,\" examine Chinese people's ideological fanaticism and call for the rejuvenation of humanistic consciousness) p. xxv (excruciating pain and sorrow underlying scar writings)"}, "madsrdf:citationSource": "Chinese literature in the second half of a modern century, \u00a92000, via Google books, viewed on Nov. 11, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Scar literature or literature of the wounded (Chinese: \u4f24\u75d5\u6587\u5b66 = shang hen wen xue; shanghen wenxue) is a genre of Chinese literature which emerged in the late 1970s, soon after the death of Mao Zedong, portraying the sufferings of cadres and intellectuals during the tragic experiences of the Cultural Revolution and the rule of the Gang of Four; Though scar literature focuses on trauma and oppression, and has been described as largely negative, love and faith remained its major themes)"}, "madsrdf:citationSource": "Wikipedia, Nov. 11, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(shanghen wenxue (scar literature); 1976 downfall of the Gang of Four gave birth to a new genre referred to as \"shanghen wenxue\" (\"scar literature\", also translated as \"literature of the wounded\" or \"wound literature\"); the works exposed and denounced the crimes of Lin Biao, the Gang, and their accomplices)"}, "madsrdf:citationSource": "He, H.Y. Dictionary of the political thought of the People's Republic of China, 2015, via Google books, viewed on Nov. 11, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Post-Mao China (1976-present) (After the death of Chairman Mao Zedong in 1976 and the removal of the Gang of Four from power, a new genre of writing known as scar literature appeared; Scar literature portrayed the personal suffering, wasted youth and talents, despair, fear, and paranoia everyone endured during the political persecution and \"class struggle\" of the Cultural Revolution; Scar literature as its own genre subsided after 1979, and in its place rose self-reflection literature, with more humanist themes and a broader historical scope)"}, "madsrdf:citationSource": "History and politics reflected in modern Chinese literature, via WWW, Nov. 11, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 225 ('scar fiction', which targets the tragedies in individual lives in contemporary China, is an important part of post-CR literature; in scar fiction, many of the protagonists are the 'rightists' of 1957 or the 'counter-revolutionaries' of the Cultural Revolution)"}, "madsrdf:citationSource": "Yang, L. Chinese fiction of the Cultural Revolution, 1998, via Google books, viewed Dec. 9, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 20 (The scope of scar literature gradually widened to include themes not only of broken families but of oppressive officials, dirty prisons, mindless dogmatism, corruption, abuse of privilege, extremes of poverty, and anything else that could be charged against the Gang of Four and their rule) p. 206 (Lu Xinhua's pathbreaking story \"Scar\" (August 1978) led to the designation \"Scar literature\" for hundreds of similar stories that followed)"}, "madsrdf:citationSource": "Roses and thorns : the second blooming of the Hundred Flowers in Chinese fiction, 1979-80, \u00a91984, via Google books, viewed on Nov. 11, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 293 (The literature of the late 1970s and early 1980s was referred to as \"scar literature\", \"introspective literature\", and \"reform literature\", among other terms, in literary circles of the time. These concepts were widely accepted and used. ... The literary work terms such as \"scar literature\" referred to was chiefly fiction, especially novellas and short stories, and therefore, in many circumstances, these terms were equivalent with terms such as scar fiction, introspective fiction, and reform fiction. ... The formulation of the term \"scar literature\" was directly related to the appearance of a great quantity of literature exposing the disaster that was the \"Cultural Revolution\", and described the tragic fate of educated youths, intellectuals, and persecuted officials during that time.)"}, "madsrdf:citationSource": "Hong, Z. A history of contemporary Chinese literature, 2007, via Google books, viewed Dec. 9, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 73 (Shanghen literature was soon followed by the so-called xungen wenxue (root-searching literature))"}, "madsrdf:citationSource": "China information, Dec. 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 41 (shanghen literature)"}, "madsrdf:citationSource": "English-Lueck, J.A. Chinese intellectuals on the world frontier, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (Da lu shang hen wen xue xuan ji [Selected works of mainland scar literature])"}, "madsrdf:citationSource": "Work cat.: Ku lian, 1982:", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 28 (Most critics agree that shanghen wenxue, fansi wenxue, zhiqing wenxue and gaige wenxue are \"artistically weak, politically tendentious, but historically significant\") pp. 39-40 (On a literary level, social and cultural alienation have been reflected in shanghen wenxue, fansi wenxue, gaige wenxue, zhiqing wenxue, and xungen wenxue; shanghen literature)"}, "madsrdf:citationSource": "Linder, B. Alienation and the motif of the unlived life in contemporary Chinese fiction, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n705153de198b4852a01be7f35b493f21b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705153de198b4852a01be7f35b493f21b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Literature of the wounded"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Literature of the wounded"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705153de198b4852a01be7f35b493f21b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shang hen literature"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shang hen literature"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705153de198b4852a01be7f35b493f21b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wound literature"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wound literature"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705153de198b4852a01be7f35b493f21b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shang hen wen xue"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shang hen wen xue"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705153de198b4852a01be7f35b493f21b34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wounded, Literature of the"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wounded, Literature of the"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705153de198b4852a01be7f35b493f21b37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scar fiction"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scar fiction"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705153de198b4852a01be7f35b493f21b40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shanghen literature"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shanghen literature"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b42", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705153de198b4852a01be7f35b493f21b43"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shanghen wenxue"}}, {"@id": "_:n705153de198b4852a01be7f35b493f21b43", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shanghen wenxue"}}], "@id": "/authorities/genreForms/gf2016026104"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026107", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHearings", "identifiers:lccn": "gf2016026107", "madsrdf:adminMetadata": [{"@id": "_:n9c957377dc154080937ee0035326e6c9b1"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hearings"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9c957377dc154080937ee0035326e6c9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2013025047"}, "madsrdf:hasSource": [{"@id": "_:n9c957377dc154080937ee0035326e6c9b5"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b6"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b7"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b8"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b9"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b10"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b11"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b12"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b13"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b14"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b15"}], "madsrdf:hasVariant": {"@id": "_:n9c957377dc154080937ee0035326e6c9b16"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-11-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-31T12:29:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hearings"}}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Gideon undone : the crisis in indigent defense spending : transcript of a hearing on the crisis in indigent defense funding held during the Annual Conference of the National Legal Aid and Defender Association, November 1982, \u00a91983.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hearing 2 Law An act of listening to evidence in a court of law or before an official, especially a trial before a judge without a jury. 3 an opportunity to give your opinions and ideas)"}, "madsrdf:citationSource": "Macmillan dictionary online, Nov. 16, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Transcripts of proceedings of the public hearings of the United States Sentencing Commission, 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hearings: Publications of the U.S. federal government containing the transcripts of testimony given before congressional committees and subcommittees, usually available in the government documents section of a library. Congressional hearings are also available online via FDsys. Not all hearings are published by the U.S. Government Printing Office. In a more general sense, the printed transcript of testimony given before any government committee or executive body authorized to hold investigative or fact-finding proceedings)"}, "madsrdf:citationSource": "ODLIS: online dictionary for library and information science, Nov. 16, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Transcript of the public hearings held by the Joint Federal-Provincial Panel on Uranium Mining Developments in Northern Saskatchewan for the McArthur River and Cigar Lake projects held at Community Hall, Pinehouse, Saskatchewan, October 7, 1996, 1996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hearing 2 An opportunity to state one's case. 2.1 Law An act of listening to evidence in a court of law or before an official, especially a trial before a judge without a jury)"}, "madsrdf:citationSource": "Oxford dictionaries website, Nov. 16, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Chicago (Ill.). Mayor's Advisory Commission on Latino Affairs. Transcript of the Commission on Latino Affairs hearing on the proposed 1992 World's Fair, 1984 or 1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "19.2.1.1.1 (works that record hearings conducted by legislative, judicial, governmental, and other corporate bodies)"}, "madsrdf:citationSource": "RDA, via RDA toolkit, viewed Nov. 16, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "leaf 3 (today's public comment hearing; public comment hearing for the U.S. Department of Energy's K-Basin spent nuclear fuel draft EIS; this hearing is being held on the 12th day of December, 1995) leaf 4 (the public comment portion of the hearing) leaf 5 (All comments that are given today will be transcribed by the court reporter who's seated over to my right, and will thereby create a complete and accurate record of your comments) leaf 6 (A verbatim transcript of all the oral comments received today)"}, "madsrdf:citationSource": "Work cat.: United States. Department of Energy. Richland Operations Office. United States Department of Energy K-Basins spent nuclear fuel management, Hanford Site, Richland, Washington, EIS scoping meeting, 1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hearing. A legal proceeding where an issue of law or fact is tried and evidence is presented to help determine the issue. Hearings resemble trials in that they ordinarily are held publicly and involve opposing parties. They differ from trials in that they feature more relaxed standards of evidence and procedure, and take place in a variety of settings before a broader range of authorities (judges, examiners, and lawmakers). Hearings fall into three broad categories: judicial, administrative, and legislative. Judicial hearings are tailored to suit the issue at hand and the appropriate stage at which a legal proceeding stands. Administrative hearings cover matters of rule making and the adjudication of individual cases. Legislative hearings occur at both the federal and state levels and are generally conducted to find facts and survey public opinion. They encompass a wide range of issues relevant to law, government, society, and public policy)"}, "madsrdf:citationSource": "West's encyclopedia of American law, c2008, via thefreedictionary.com website, Nov. 16, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hearing 2 a : opportunity to be heard, to present one's side of a case, or to be generally known or appreciated; b (1) : a listening to arguments (2) : a preliminary examination in criminal procedure; c : a session (as of a legislative committee) in which testimony is taken from witnesses)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Nov. 16, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9c957377dc154080937ee0035326e6c9b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Public hearings"}}, {"@id": "_:n9c957377dc154080937ee0035326e6c9b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Public hearings"}}], "@id": "/authorities/genreForms/gf2016026107"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026111", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNature poetry", "identifiers:lccn": "gf2016026111", "madsrdf:adminMetadata": [{"@id": "_:n39f3496a27714bbd9a983d36a860f078b1"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nature poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n39f3496a27714bbd9a983d36a860f078b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026049"}, "madsrdf:hasSource": [{"@id": "_:n39f3496a27714bbd9a983d36a860f078b5"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b6"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b7"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b8"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b9"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b10"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b11"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry that romanticizes the natural world and emphasizes nature for its own sake."}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:24:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nature poetry"}}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Quetchenbach, B.W. Back from the far field : American nature poetry in the late twentieth century, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2015013167: National Geographic book of nature poetry, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xvii (nature writing as a category has expanded to include environmental poetry, variously labeled nature poetry or ecopoetry)"}, "madsrdf:citationSource": "Twentieth-century American nature writers : prose, c2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xvii (American nature poetry; contemporary poets who desire to write about the natural world are confronted with a task that in many ways is markedly different from the one their predecessors faced. For one thing, realities that pervade much of recent nature poetry--especially those relating to environmental and ecological crises--are phenomena that writers such as Anne Bradstreet (1612-1672) or William Cullen Bryant (1794-1798 [i.e. 1878]) were never forced to consider; the genre is one heavily endowed with mystical, metaphorical, and spiritual images and values; \"Nature,\" as rendered in poems, fiction, and essays, often appears in quotation marks, identifying it as a socially constructed phenomenon) p. xviii (certain characteristics run through much of the work produced by the writers more readily described as poets of nature: a purposeful and explicit focus on the nonhuman world; an emphasis on nature for its own sake rather than merely as a metaphor for human values and concerns; an exploration of the relationship that exists between that world and the human; and, a fundamental reverence regarding the poet's subject matter. These characteristics are not criteria but simply traits most nature poets share) p. xix (By the late 1990s, scholarly attention to contemporary nature poetry (or what was coming to be called \"environmental poetry\" or \"ecopoetry\") began to proliferate) p. xx (poets who have explored the relationship between humanity and nonhuman nature)"}, "madsrdf:citationSource": "Twentieth-century American nature poets, c2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xvii (Pure nature poetry, as opposed to incidental references to the natural world, does not survive in Old English and is rare in Mediaeval Welsh before the fourteenth century, but it is well exemplified in Old Irish)"}, "madsrdf:citationSource": "Early Welsh gnomic and nature poetry, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Keegan, B. British labouring-class nature poetry, 1730-1837, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Nature (nature/wilderness not only was often seen as a manifestation of deity but became a fetish object for a broad range of writers and artists across Europe and America, incl. J.W. Goethe, William Wordsworth, H.D. Thoreau, Walt Whitman, and Thomas Hardy. This strain of broadly romantic reverence for nature continued into the 20th and 21st cs. with writers such as Dylan Thomas, Robert Frost, Seamus Heaney, and Wendell Berry. However, as untouched wilderness was quickly being domesticated throughout the Northern Hemisphere, benign areas imagined as wilderness, which had in fact already been extensively modified by human beings, such as the Lake District of 19th-c. England and Thoreau's Walden Pond, soon began to stand for wilderness in much nature writing) Tamil poetry and poetics (Kanaka Subburatnam (1891-1964) called himself Bharatidasan (Bharati's slave) and continued to write patriotic and nature poetry following but also modifying Bharati's style)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n39f3496a27714bbd9a983d36a860f078b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "2009018528: Black nature : four centuries of African American nature poetry, \u00a92009.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026111"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026112", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNoir poetry", "identifiers:lccn": "gf2016026112", "madsrdf:adminMetadata": [{"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb1"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Noir poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb5"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb6"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb7"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb8"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb9"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb10"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb11"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb12"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb13"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb14"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb15"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb16"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb17"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb18"}], "madsrdf:hasVariant": [{"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb19"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb22"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb25"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb28"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noir poetry"}}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(This year I'm teaching a new class called Literature and Film. ... In our film noir unit, we read some terrific noir poems from Kevin Young's Black Maria and some excerpts from Robert Polito's fine new collection, Hollywood and God. Check out the podcast on Poetry Noir from Poetry off the Shelf. Then, while we were examining mise-en-scene (for our purposes, the physical setting of the film) in movies such as Double Indemnity and Chinatown, I asked students to write noir poems of their own)"}, "madsrdf:citationSource": "O'Connor, John S. Poetry noir, via Poetry Foundation website, Dec. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mid-century--the 20th--poet Weldon Kees drew upon the visual and tonal qualities of another medium, film noir, with its interest in fate, human fallibility and mortality, and its sense of social order undercut by a substratum of delirious disorder. To that mix he added a murder, or, at any rate, a body, and his own icy black irony--and that became the first modern poem noir, \"Crime Club.\" Ironic Lynda Hull is not, but among poets of our own time none has employed noir's signature motifs and captured in language its pervasive atmosphere more strikingly and persistently)"}, "madsrdf:citationSource": "Lummis, Suzanne. (Never) Out of the past: film noir and the poetry of Lynda Hull, via Los Angeles review of books website, Nov. 17, 2015, viewed Dec. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(I first started to notice shades of film noir appearing within contemporary poetry in 2011 in the work of poets such as Sean O'Brien (in poems such as 'Acheron, Phlegethon, Styx', 'Cities' and O'Brien's Dantesque masterwork, 'On The Toon'), David Harsent (in poems such as 'Ghosts', 'The Duffel Bag' and 'Elsewhere' from Night), Deryn Rees-Jones (in her murder mystery sequence, Quiver), and Robin Robertson (in poems such as 'Night Driving' and 'The Wood of Lost Things'); a noirish poem needn't rely on the clich\u00e9 furniture of detectives and femme fatales, but instead on an insistence on excavating a situation or location, or even the self, for memories or truths, and on holding whatever buried treasure that is found up to the light, regardless of what it revealed; Taking cue from the films themselves, alongside examples of the poem noir, we'll look at several approaches to writing a poem noir, from borrowing film noir's flashbacks, high contrast lighting, and narratives of labyrinthine descents, to examining the fundamental conditions essential to create the unsettling and mysterious world that both film noir and the poem noir inhabits)"}, "madsrdf:citationSource": "Challis, John. The poem noir, via The Poetry School website, Dec. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(noir poems)"}, "madsrdf:citationSource": "Allpoetry website, Dec. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(noir poetry set in Los Angeles; Suzanne Lummis, one-third of a poetry ensemble called Nearly Fatal Woman, and she organizes the L.A. Poetry Festival. Her passion is the noir poem, which she says must link to a crime and she's had them)"}, "madsrdf:citationSource": "Writing noir poetry, with LA as a backdrop, via NPR website, posted Sept. 15, 2013, viewed on Dec. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(noir poems; noir poetry)"}, "madsrdf:citationSource": "PoetrySoup website, Dec. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(My PhD is concerned with identifying the poem noir; a poem that contains the stylistic attributes, as well as a underlying moods of pessimism, anxiety and obsession, that are commonly found in the films noir of the 1940s and 1950s and later neo-noir films produced from the 1970s onwards; poems that I consider poem noirs; we'll have a go at writing our own poem noirs)"}, "madsrdf:citationSource": "Meet the doctors: John Challis, via The Poetry School website, Dec. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Noir Poetry is (1) Poetry that makes reference to the subject matter, dialog or style of film noir or the hardboiled detective genre, or, (2) Poetry that invokes stark urban landscapes and atmosphere, and which either alludes to crime and perilous attachments or else seems to bear dark knowledge of this territory, or (3) Poetry that tells the story of tortured souls - lovers, psychopaths, obsessives - driven down deadly paths, following desperate plans that are doomed to failure)"}, "madsrdf:citationSource": "NoirCon Poetry Contest, via Pulp serenade blog, posted Sept. 24, 2011, viewed Dec. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 6 (the poem noir) p. 7 (seven poems noir) p. 15 (poetry noir) p. 226 (A poem noir, then, is not, as some have supposed, just any poem that can pass for \"dark\". It is not gothic, not Grand Guignol, not melodramatic. It is not elegiac. It is not a poem of social-consciousness that turns us face to face with the world's grief. Noir cannot languish in depression ... Instead, noir bears some kinship with mid-century existentialism in its tearless, grim--or wry--acknowledgment that the individual must fend for himself in a universe devoid of moral order) p. 227 (The poet noir, then, has arrived at some way to make the film noir sensibility--those moods, those narrative elements--take shape in contemporary poetry; will throw light, and defining darkness, on some area of the human condition; noir is not only a style but to some degree stylized; the poem will speak of a voice stripped of all sentimentality, a voice of cool detachment. If it does not, it is not noir; always the poem noir will convey to us, or skirt the edge of, this bit of news: a crime has been committed, or will be, or might. It might be underway even now) spring 2013, p. 7 (poetry noir) p. 192 (noir poems; the nature of the \"characters\" that are mentioned, the narrative nature of this poetry, and any correlation with the aesthetics of film noir are certainly present. However, there is no one definition about what noir poetry is as a type of poem for the most part. Between the noir films and poems, we can see some correlations and influences from the former to the latter: social class issues; more narrative elements; a different level of characterizations; perhaps more dialogue that might be common in poetry; references back to previous films from the noir era; maybe some filmic techniques, or references to them; there are different kinds of noir poetry just as there are different types of noir films)"}, "madsrdf:citationSource": "The Malpa\u00eds review, winter 2012-13:", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The author has indicated that the poems are Noir poems - Noir because the voice comes from a darker side of poetry - bluntly erotic and lurid, where laws of state might not be broken but where a heart can be arrested, convicted and imprisoned for crimes committed by desire. In Nights of Naked Mannequins the speaker of the poems becomes his own erotic private detective, investigating the truth about his sensual past. Always surprised at what he finds)"}, "madsrdf:citationSource": "Book Depository web page for Nights of naked mannequins by Michael Lee Phillips, viewed Dec. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the crime noir style poetry of Dennis Gulling; he has published his first full-length book of poetry, The Blood Dark Sea. ... The Blood Dark Sea is 100 pages of pure schadenfreude. Mishaps, hijinx, revenge, petty criminals, and reads like a crime noir screenplay from the 1950's)"}, "madsrdf:citationSource": "Three crime noir poems by outlaw poet Dennis Gulling, via Rockford poetry website, Dec. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 765 (Kenneth Fearing writes noir poetry, which is no surprise, considering that he also wrote several noir novels)"}, "madsrdf:citationSource": "Public library core collection. Nonfiction, 2008, via Google books, viewed Dec. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A collection of erasure poems based on the writings of a range of noir authors, including James M. Cain, Raymond Chandler, Dashiell Hammett, Patricia Highsmith, Walter Mosley, Robert B. Parker, and Cornell Woolrich) p. 5 (noir erasure poetry) p. 7 (noir and erasure poetry) p. 9 (noir poets)"}, "madsrdf:citationSource": "Work cat.: Noir : erasure poetry anthology, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poem noirs"}}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poem noirs"}}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poems noir"}}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poems noir"}}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poetry noir"}}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poetry noir"}}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crime noir poetry"}}, {"@id": "_:n956109a159ac420b8e32c4dc56a6c5ddb29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crime noir poetry"}}], "@id": "/authorities/genreForms/gf2016026112"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026001", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBiker poetry", "identifiers:lccn": "gf2017026001", "madsrdf:adminMetadata": [{"@id": "_:n8ef2921bc65f4067915084b9fae29421b1"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Biker poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8ef2921bc65f4067915084b9fae29421b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n8ef2921bc65f4067915084b9fae29421b5"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b6"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b7"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b8"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b9"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b10"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b11"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b12"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b13"}], "madsrdf:hasVariant": [{"@id": "_:n8ef2921bc65f4067915084b9fae29421b14"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that describe motorcycling and the motorcycling lifestyle that are generally written by people with firsthand experience of that life."}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-06T09:55:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biker poetry"}}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jose \"Jo Go\" Gouveia, like more than a few Somerville residents is a first generation Portuguese-American. He resides on Cape Cod and has been published in six countries and four continents. He is a member of the Highway Poets Motorcycle Club and founder of the Biker Poets & Writers Association. He recently edited a biker's poetry anthology: \"Rubber Side Down.\"; The thing that biker poets share in common isn't so much our writing, or how we write, but it is our passion for the open road and motorcycles. As long as the poem is in some way about motorcycles you are in. There is really no requirement about how you have to write)"}, "madsrdf:citationSource": "Biker poet Jose Gouveia, via Boston Area Small Press and Poetry Scene blog, posted Jan. 28, 2009, viewed Jan. 1, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "2008024614: Rubber side down : the biker poet anthology, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection of biker poems)"}, "madsrdf:citationSource": "Work cat.: 74156164: Wakoski, Diane. The motorcycle betrayal poems, 1971", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Largest collection of biker poetry by individual bikers on the internet\"; motorcycle poems)"}, "madsrdf:citationSource": "Biker poetry, & words website, Jan. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Biker poetry; poetry that grew out of the predominantly American lifestyle of the Biker and Motorcycle clubs following World War II; Poets such as Hunter S. Thompson are credited with writing biker poetry; Biker poetry often embraces form. Fixed verse, free verse, folk song, Concrete poetry, Poetry slam and even \"Baiku\" a form of Haiku. Notable biker poets include Diane Wakoski, who authored a collection known as The motorcycle betrayal poems. Writers such as Colorado T. Sky and K Peddlar Bridges work with experimental poetry, however the biker genre tends to work with form, especially rhyming verse. Groups such as The Highway Poets Motorcycle Club have an international membership. The genre is a regular feature in many motorcycle magazines and motorcycle rallies)"}, "madsrdf:citationSource": "Wikipedia, Jan. 1, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Biker poets; Cowboy poets may have been the first to pair chaps with literary ambition, writing rhymed verse about lonely horizons and broken-down Western towns. But now they are being joined by men and women who ride Harleys instead of horses, and who pen tributes to the open road rather than the open range; biker poet Jose Gouveia ... just finished editing a collection of biker poetry called \"Rubber Side Down\")"}, "madsrdf:citationSource": "Brown, E. The rhythms of the road, via Boston globe website, posted Oct. 21, 2008, viewed on Jan. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(biker poems; biker poetry; motorcycle poems; motorcycle poetry)"}, "madsrdf:citationSource": "PoetrySoup website, Jan. 2. 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "about (\"Welcome to amateur motorcycle poetry. Though poetry is not for everyone, if you like motorcycles you might find some of my musings entertaining. This is part of what I do when not out on my steel ride. I like all brands of motorcycles from Harleys to Hondas. Ride safe and keep your head and eyes up while riding and reading my poems\")"}, "madsrdf:citationSource": "Motorcycle poems blog, viewed Jan. 2, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(motorcycle poetry; moto poetry; biker poetry)"}, "madsrdf:citationSource": "The best motorcycle poetry sites, via Motorcycle and scooter talk blog, posted Aug. 30, 2007, viewed Jan. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8ef2921bc65f4067915084b9fae29421b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motorcycle poetry"}}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motorcycle poetry"}}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8ef2921bc65f4067915084b9fae29421b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Moto poetry"}}, {"@id": "_:n8ef2921bc65f4067915084b9fae29421b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Moto poetry"}}], "@id": "/authorities/genreForms/gf2017026001"}
