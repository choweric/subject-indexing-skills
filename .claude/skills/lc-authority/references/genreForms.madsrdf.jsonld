lue": "2018-02-20T15:44:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Audio guides"}}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCSH, August 13, 2016;Thesaurus for graphic materials, August 13, 2016;RBMS Controlled vocabularies: Genre terms, August 13, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(audio guide, n., a handheld device that provides recorded information for visitors touring a museum, gallery, or other place of interest.)"}, "madsrdf:citationSource": "New Oxford American dictionary, August 16, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(audio tour; an audio tour or audio guide provides a recorded spoken commentary, normally through a handheld device, to a visitor attraction such as a museum.)"}, "madsrdf:citationSource": "Wikipedia, August 13, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(audio guide, n., a device providing a recorded commentary relating to a museum, gallery, or other place of interest; (now esp.) a portable device, typically rented or borrowed for the duration of a visit or tour, and often used with earphones; (also) a recording of such a commentary.)"}, "madsrdf:citationSource": "Oxford English dictionary, August 13, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(audioguides; UF audioguide; audio-guides; audioguide systems; audio interpretation systems; audiotours; audio wand systems; cassette tours; guides, sound; interpretation systems, audio; sound guides; systems, audioguide; systems, audio interpretation; systems, audio wand; tape tours; tours, cassette; tours, tape; wand systems, audio; audiogidsen; gua\u0315s auditivas; gua\u0315 auditiva; note: Any of a number of systems employing prerecorded audio messages to inform visitors to museums or other exhibitions.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, August 13, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6dea921e623f4d2899e09053aca0e107b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Audio interpretation systems (Audio guides)"}}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Audio interpretation systems (Audio guides)"}}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6dea921e623f4d2899e09053aca0e107b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Guides, Audio"}}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Guides, Audio"}}, {"@id": "_:n6dea921e623f4d2899e09053aca0e107b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"],