_:n5afbbf864ac048fda2000b9e5e5daca1b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic albums"}}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Short story comics"}}, {"@id": "_:n5afbbf864ac048fda2000b9e5e5daca1b37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Short story comics"}}], "@id": "/authorities/genreForms/gf2014026362"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026363", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGrassroots comics", "identifiers:lccn": "gf2014026363", "madsrdf:adminMetadata": [{"@id": "_:na870079299b14752b85cf8c853cb7b8bb1"}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Grassroots comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:na870079299b14752b85cf8c853cb7b8bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:na870079299b14752b85cf8c853cb7b8bb5"}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb6"}], "madsrdf:hasVariant": [{"@id": "_:na870079299b14752b85cf8c853cb7b8bb7"}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb10"}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics created by community activists or others that are intended to communicate a message and/or to encourage debate on an issue."}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:25:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Grassroots comics"}}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 9 (Grassroots comics, i.e. comics that are made by socially active people themselves, rather than by campaign and art professionals, are genuine voices which encourage local debate in the society. Furthermore, they are inexpensive and the technology is not complicated--pens, papers and access to a copying machine are usually enough)"}, "madsrdf:citationSource": "Packalen, L. Grassroots comics, a development communication tool, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Grassroots comic books, strips, etc. Here are entered works on comics made by local community activists and other non-professional artists that are intended to communicate a message and/or to encourage debate on an issue. UF Grass root comic books, strips, etc; Grass roots comic books, strips, etc; Grassroot comic books, strips, etc)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na870079299b14752b85cf8c853cb7b8bb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Grass root comics"}}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Grass root comics"}}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na870079299b14752b85cf8c853cb7b8bb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Grass roots comics"}}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Grass roots comics"}}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na870079299b14752b85cf8c853cb7b8bb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Grassroot comics"}}, {"@id": "_:na870079299b14752b85cf8c853cb7b8bb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Grassroot comics"}}], "@id": "/authorities/genreForms/gf2014026363"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026364", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGraveyard poetry", "identifiers:lccn": "gf2014026364", "madsrdf:adminMetadata": [{"@id": "_:n8faf1a08f41240b88a00dfbc532d6b7bb1"}, {"@id": "_:n8faf1a08f41240b88a00dfbc532d6b7bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Graveyard poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8faf1a08f41240b88a00dfbc532d6b7bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n8faf1a08f41240b88a00dfbc532d6b7bb5"}, {"@id": "_:n8faf1a08f41240b88a00dfbc532d6b7bb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Melancholic poetry that meditates on mortality and immortality and is often set in graveyards."}, {"@id": "_:n8faf1a08f41240b88a00dfbc532d6b7bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8faf1a08f41240b88a00dfbc532d6b7bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:26:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8faf1a08f41240b88a00dfbc532d6b7bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graveyard poetry"}}, {"@id": "_:n8faf1a08f41240b88a00dfbc532d6b7bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graveyard poetry; The term applied to a minor but influential 18th-century tradition of meditative poems on mortality and immortality, often set in graveyards.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n8faf1a08f41240b88a00dfbc532d6b7bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Graveyard poetry. A type of meditative poetry; graveyard poetry takes as its major themes a melancholy sense of mutability, the inevitability of death, and the hope of a future life.)"}, "madsrdf:citationSource": "The Princeton encyc. of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026364"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026365", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHadith stories", "identifiers:lccn": "gf2014026365", "madsrdf:adminMetadata": [{"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b1"}, {"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hadith stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasSource": [{"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b5"}, {"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b6"}], "madsrdf:hasVariant": {"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Paraphrases of Hadith texts in story form."}, {"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:27:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hadith stories"}}, {"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hadith noun, plural hadith, hadiths. 1. Islam. a traditional account of things said or done by Muhammad or his companions. 2. (used with a plural verb) the entire body of such accounts.)"}, "madsrdf:citationSource": "Dictionary.com, July 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hadith stories)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories, Hadith"}}, {"@id": "_:nc9ef8547d9414b45959f8f9a88d5e473b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories, Hadith"}}], "@id": "/authorities/genreForms/gf2014026365"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026366", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHaiku", "identifiers:lccn": "gf2014026366", "madsrdf:adminMetadata": [{"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb1"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Haiku"}, "madsrdf:elementList": {"@list": [{"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb3"}]}, "madsrdf:exampleNote": "Note under [Senryu]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb5"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb6"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb7"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb8"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb9"}], "madsrdf:hasVariant": [{"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb10"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Three-line unrhymed poems consisting of 17 syllables that express a single idea, image, or feeling that is generally related to nature. For three-line unrhymed humorous poems consisting of 17 syllables that generally satirize human nature or emotions see [Senryu.]"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:19:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Haiku"}}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haiku: A Japanese verse form consisting of seventeen syllables in three lines of five, seven and five syllables. Such a poem expresses a single idea, image or feeling.)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "haiku and senryu (definition of senryu: a Japanese poem similar in structure to haiku, but more concerned with human nature, and is often humorous or satiric--usually in three lines of seventeen kana; the primary difference between haiku and senryu is the tone. Senryu is much more concerned with human nature, political issues and satiric humor)"}, "madsrdf:citationSource": "Shadow poetry, via WWW, July 25, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haiku: an unrhymed Japanese poem, usually consisting of seventeen join (Japanese symbol-sounds), which records the essence of a moment keenly perceived, usually linking nature to human nature. Though there is not fixed form for Japanese haiku, foreign adaptations, particularly those developed by Americans poets, have usually consisted of three lines of five, seven, and five syllables.)"}, "madsrdf:citationSource": "Beckson, K. Literary terms, 1989", "madsrdf:citationStatus": "found"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haiku. UF Haikus; Hokku)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(senry\u016b: a three-line unrhymed Japanese poem structurally similar to a haiku but treating human nature usually in an ironic or satiric vein. It is also unlike haiku in that it usually does not have any references to the seasons. Senry\u016b developed from haiku and became especially popular among the common people about the 18th century)"}, "madsrdf:citationSource": "Britannica online, July 24, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hokku"}}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hokku"}}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Haikus"}}, {"@id": "_:nee7ae550fa6e49aaad01584864db1f5eb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Haikus"}}], "@id": "/authorities/genreForms/gf2014026366"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026367", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHeroic drama", "identifiers:lccn": "gf2014026367", "madsrdf:adminMetadata": [{"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b1"}, {"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Heroic drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026576"}, "madsrdf:hasSource": [{"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b5"}, {"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b6"}, {"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays depicting a noble hero typically caught in a conflict between love and honor, and distinguished by bombast, exotic settings, and lavish scenery."}, {"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:27:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heroic drama"}}, {"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(heroic drama, a style of playwriting imported into England during the Restoration in imitation of French classical tragedy. Written in rhymed couplets, and observing strictly the unities of time, place, and action, it deals mainly with the Spanish theme of 'love and honour')"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(heroic drama. A kind of tragedy or tragicomedy that came into vogue with the Restoration of the English monarchy in 1660. Influenced by French classical tragedy and its dramatic unities, it aimed at epic (thus 'heroic') grandeur, usually by means of bombast, exotic settings, and lavish scenery. The noble hero would typically be caught in a conflict between love and patriotic duty, leading to emotional scenes presented in a manner close to opera.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n257e46d5e579475d8fb55471bd7d4a46b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Heroic drama)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026367"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026368", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHistorical comics", "identifiers:lccn": "gf2014026368", "madsrdf:adminMetadata": [{"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb1"}, {"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Historical comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb5"}, {"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb6"}], "madsrdf:hasVariant": {"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics set during a recognizable time period prior to the time in which they were written."}, {"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:27:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical comics"}}, {"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 63 (Historical Fiction)"}, "madsrdf:citationSource": "Goldsmith, F. The readers' advisory guide to graphic novels, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 21 (History. Historical information and dramatizations are also conveyed through comic art.)"}, "madsrdf:citationSource": "Miller, S. Developing and promoting graphic novel collections, c2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Historical fiction comics"}}, {"@id": "_:n0367c459d6ff4710b4313e69bbe9343cb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical fiction comics"}}], "@id": "/authorities/genreForms/gf2014026368"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026369", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHistorical drama", "identifiers:lccn": "gf2014026369", "madsrdf:adminMetadata": [{"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb1"}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Historical drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026464"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026512"}], "madsrdf:hasSource": [{"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb5"}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb6"}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb7"}], "madsrdf:hasVariant": [{"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb8"}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb11"}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays set during a recognizable time period prior to the time in which they were written."}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:25:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical drama"}}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Also known as documentary drama, reality theater, and theatrical journalism, today the term documentary theater seems to indicate that most of the dialogue for a piece is verbatim transcription of what people actually said. Beyond that, documentary theater may take many of the same dramatic licenses allowed fiction pieces.)"}, "madsrdf:citationSource": "Arader, M. Reality show : the diverging paths of documentary theater, c2001, viewed online Apr. 17, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Historical drama. UF Chronicle histories (Drama); Chronicle plays; Docudrama; Documentary plays; Historical plays; Verbatim plays)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (History play: In the broadest sense, a play set in a historical milieu which deals with historical events and personages)"}, "madsrdf:citationSource": "Wilson, E. The theater experience, c2004, via McGraw-Hill Higher Education online learning center, Nov. 14, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Documentary drama (Literature)"}}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentary drama (Literature)"}}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Docudramas (Literature)"}}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Docudramas (Literature)"}}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chronicle histories (Drama)"}}, {"@id": "_:n44c23c6d8e2d49aeab3a1e03f4f504ffb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chronicle histories (Drama)"}}], "@id": "/authorities/genreForms/gf2014026369"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026370", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHistorical fiction", "identifiers:lccn": "gf2014026370", "madsrdf:adminMetadata": [{"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb1"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Historical fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb5"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb6"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb7"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb8"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb9"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb10"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb11"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb12"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb13"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb14"}], "madsrdf:hasVariant": [{"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb15"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb18"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction set during a recognizable time prior to the time in which they were written."}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T10:40:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical fiction"}}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Georgette Heyer, 1902-1974; she is best known for her Regency novels; she \"writes ... historical novels, set in Regency England, in which people never lose their lives, their virtue, or even their tempers\"; Regency romances)"}, "madsrdf:citationSource": "Women writers of Great Britain and Europe, 2013, via Google books, viewed Mar. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under romantic fiction: Romances with a historical setting, such as the Regency novels of Georgette Heyer; under Heyer, Georgette: British writer of historical novels and detective stories; she was an expert on the Regency period; The most popular of her Regency romances include Devil's Cub (1934), Regency Buck (1935), Faro's Daughter (1941), Venetia (1958), and Lady of Quality (1972))"}, "madsrdf:citationSource": "The Oxford companion to twentieth-century literature in English, 1996", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Georgette Heyer's novels (Cotillion, 1953, [genre] Regency)"}, "madsrdf:citationSource": "Kloester, Jennifer. Georgette Heyer, 2013, via Google books, viewed Mar. 26, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Regency romance novel; Regencies; Regency novels; Regency romances; the Regency genre; Regencies, which are typically set in the early 1800s in England, are known for their humor, for their heroines who battle against \"stiff judgments\" of an upper-crust society, and for characters and plot that operate within a strict societal structure; Regencies emphasize themes such as love and values and family--not stressing over things we can't control--which translates to money and titles and property in the Regency world)"}, "madsrdf:citationSource": "Moore, H. Several LDS authors pen Regency romance novels, in Deseret news, July 2, 2012, viewed online Mar. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a regency novel)"}, "madsrdf:citationSource": "Work cat.: Heyer, G. Cotillion, 1953", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Historical > Regency (Regency literature is generally set during the period of the English Regency or early 19th century. Rather than simply being versions of contemporary stories transported to a historical setting, Regency novels are a distinct genre with their own plot and stylistic conventions that derive from the works of Jane Austen and Georgette Heyer, and from the fiction genre known as the novel of manners. In particular, most Regencies feature a great deal of intelligent, fast-paced dialog between the protagonists and (traditionally) very little explicit sex or discussion of sex. Other common elements of Regency romances include mystery or farce elements in the plot; references to the Ton (le bon ton); a secondary romance between another couple in addition to the more serious story involving the main protagonists; mistaken identity (deliberate or otherwise); false engagements; marriages of convenience; depictions of activities common during the social season such as balls, routs, carriage riding, theatre events, fittings, suppers, assemblies, etc.; references to, or descriptions of, leisure activities engaged in by fashionable young men of the period, including riding, driving, boxing, gambling, fencing, shooting, etc.)"}, "madsrdf:citationSource": "Goodreads website, Mar. 26, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Historical fiction: fiction that takes place during a definite, recognizable period in the real past; generally involves important political or social events of the day, as well as the daily lives of ordinary people; also includes fiction that uses actual historical figures as characters.)"}, "madsrdf:citationSource": "Henry, L. The fiction dictionary, c1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Regency fiction. UF Regency novels. BT Historical fiction. SN Use for historical works set during the late 18th and early 19th century up to the reign of Queen Victoria)"}, "madsrdf:citationSource": "Guidelines on subject access to individual works of fiction, drama, etc., 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Historical fiction: Use for novels set during a time prior to the time in which they were written, and based around real events, people, or situations. UF Historical novels, Historical romances.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(traditional regency, books written in the tone of Jane Austen and Georgette Heyer. Emphasis was on the setting, manners, and foibles of upper class British society between 1811-20; the sensual regency romance, lead by writers such as Amanda Quick, Lisa Kleypas, Eloisa James, and Christina Dodd. The time period was the same, but these regencies featured seething emotions, turbulent affairs, and explicit sex. The new regencies paid scant attention to the exacting historical detail prized in the earlier version of the genre)"}, "madsrdf:citationSource": "Camden, E. Where did the traditional regency go?, via Elizabeth Camden website, posted Apr. 25, 2013, viewed Mar. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romances, Historical"}}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romances, Historical"}}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Historical romances"}}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical romances"}}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Regency fiction"}}, {"@id": "_:n3d5251bc3762457ea02e59f9ce06443eb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Regency fiction"}}], "@id": "/authorities/genreForms/gf2014026370"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026371", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHistorical poetry", "identifiers:lccn": "gf2014026371", "madsrdf:adminMetadata": [{"@id": "_:nd0d48a2dc7da4de781c3620011d6a10eb1"}, {"@id": "_:nd0d48a2dc7da4de781c3620011d6a10eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Historical poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd0d48a2dc7da4de781c3620011d6a10eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nd0d48a2dc7da4de781c3620011d6a10eb5"}, {"@id": "_:nd0d48a2dc7da4de781c3620011d6a10eb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems set during a recognizable time period prior to the time in which they were written."}, {"@id": "_:nd0d48a2dc7da4de781c3620011d6a10eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd0d48a2dc7da4de781c3620011d6a10eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:28:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd0d48a2dc7da4de781c3620011d6a10eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical poetry"}}, {"@id": "_:nd0d48a2dc7da4de781c3620011d6a10eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Historical poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0d48a2dc7da4de781c3620011d6a10eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. xi-xii (The range of poems considered historical is wide: folk ballads, contemporary broadsides, complaints, narrative poems, epics, biographies and saints' lives, elegies; All of these poems were occasioned ... by a specific historical event; Specifically, the rhetorical relationship which bind the historical poet, his historical subject matter, and his audience characterize the historical poem's very identification as a genre.)"}, "madsrdf:citationSource": "Gutierrez, N.A. English historical poetry, 1476-1603, 1983:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026371"}
