"ri:recordStatus": "new"}, {"@id": "_:n321b7c37d9504f149a672f5a8a2c2e40b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Advertising posters"}}, {"@id": "_:n321b7c37d9504f149a672f5a8a2c2e40b5", "@type": "madsrdf:Source", "madsrdf:citationSource": [{"@id": "https://philaprintshop.com/collections/advertising-posters"}, "Advertising posters, via The Philadelphia Print Shop website, Apr. 16, 2024."], "madsrdf:citationStatus": "found"}, {"@id": "_:n321b7c37d9504f149a672f5a8a2c2e40b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1100603313"}, "madsrdf:citationSource": "Rymer, David. The world in prints : the history of advertising posters from the late 19th century to the 1940s, 2019.", "madsrdf:citationStatus": "found"}, {"@id": "_:n321b7c37d9504f149a672f5a8a2c2e40b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Vintage advertising posters from the 1920s, 30s, 40s and 50s; used to sell a variety of products from personal hygiene to food and clothing)"}, "madsrdf:citationSource": "Vintage advertising posters, via Vintagraph website, Apr. 16, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n321b7c37d9504f149a672f5a8a2c2e40b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(caption: The Rainier brand became known for irreverent and humorous advertisements, such as this poster spoofing the phrase \"a breed apart\" with a photo of a \"Wild Rainier\" beer bottle on legs captioned \"A Brew Apart.\")"}, "madsrdf:citationSource": [{"@id": "https://digitalcollections.lib.washington.edu/digital/collection/imlsmohai/id/14097/rec/23"}, "Work cat.: Rainier Brewing Company. A Brew Apart poster, Seattle, circa 1985, via University of Washington Libraries Digital Collections website, viewed Apr. 16, 2024"], "madsrdf:citationStatus": "found"}, {"@id": "_:n321b7c37d9504f149a672f5a8a2c2e40b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Advertising Posters. The world of commerce owes a great deal to these persuasive beauties. Advertising posters have been the lifeblood of consumer culture, tempting us with tantalizing images of the latest gadgets, fashion trends, and culinary delights. From vintage ads with their nostalgic charm to sleek modern designs, these posters have one mission--to make us want what they're selling.)"}, "madsrdf:citationSource": "Rogers, Mark. 10 types of posters and where to find them, via Frame Destination website, Apr. 16, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n321b7c37d9504f149a672f5a8a2c2e40b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)3003890"}, "madsrdf:citationSource": "American advertising posters of the nineteenth century, 1976.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2024026033"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026037", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStoryboards", "identifiers:lccn": "gf2024026037", "madsrdf:adminMetadata": [{"@id": "_:n6f48cee5a3c54772a903bf1023e35785b1"}, {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Storyboards"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6f48cee5a3c54772a903bf1023e35785b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027231"}, "madsrdf:hasSource": [{"@id": "_:n6f48cee5a3c54772a903bf1023e35785b5"}, {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b6"}, {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b7"}], "madsrdf:hasVariant": {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b8"}, "madsrdf:historyNote": "[Established August 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-04-25T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-08-22T14:19:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Storyboards"}}, {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(storyboard; A sequence of drawings, typically with some directions, representing the shots planned for a film production. Using a frame outline with the same aspect ratio as the intended film, rough or extensively detailed drawings are used to sketch out the shots and editing pattern of a sequence)"}, "madsrdf:citationSource": "Oxford dictionary of film studies, 2nd. ed., viewed July 31, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "summary (An official collection featuring striking storyboard art...an integral part of assembling each episode of the award-winning series. This volume features a unique behind-the-scenes look into pivotal moments and early conceptual art from Game of Thrones) (OCoLC)1105548728"}, "madsrdf:citationSource": "Work cat: Simpson, Will. Game of thrones: the storyboards. 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(storyboards. Series of sketches or pictures and any accompanying text which visualize each topic or item in a work to be produced in an audio-visual format.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, April 25, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f48cee5a3c54772a903bf1023e35785b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Storyboard art"}}, {"@id": "_:n6f48cee5a3c54772a903bf1023e35785b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Storyboard art"}}], "@id": "/authorities/genreForms/gf2024026037"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026038", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPe\u015frevs", "identifiers:lccn": "gf2024026038", "madsrdf:adminMetadata": [{"@id": "_:nc938cc6e6a1d443f9d7040344889b637b1"}, {"@id": "_:nc938cc6e6a1d443f9d7040344889b637b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pe\u015frevs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc938cc6e6a1d443f9d7040344889b637b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:nc938cc6e6a1d443f9d7040344889b637b5"}, {"@id": "_:nc938cc6e6a1d443f9d7040344889b637b6"}], "madsrdf:hasVariant": {"@id": "_:nc938cc6e6a1d443f9d7040344889b637b7"}, "madsrdf:historyNote": "[Established August 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc938cc6e6a1d443f9d7040344889b637b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-04-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc938cc6e6a1d443f9d7040344889b637b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-01-27T10:29:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nc938cc6e6a1d443f9d7040344889b637b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pe\u015frevs"}}, {"@id": "_:nc938cc6e6a1d443f9d7040344889b637b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (this recording contains the complete instrumental works (saz semais and pe\u015frevs) of Tatyos Efendi, one of the greatest composers from the last decades of the Ottoman Empire) insert, page 6 (the pe\u015frev, in 8/8 meter, an instrumental piece, belongs to the concert cycle known as fas\u0131l; historically, the pe\u015frev served as the prelude of the fas\u0131l cycle, which ended with a closing piece (the saz semai), with several songs appearing in between; by the early 19th century, however, the pe\u015frev and the saz semai were more often recognized and performed as separate pieces, their forms divided into four distinct sections: a theme or ritornello (teslim) and three development sections (hane)) (DLC)99594509"}, "madsrdf:citationSource": "Work cat: The works of Tatyos Efendi, 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc938cc6e6a1d443f9d7040344889b637b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Turkey IV. Art music. 4. Formal structure (Dominant among the instrumental forms are the pe\u015frev and saz semaisi; since the early 19th century they have had four sections (hane: 'house'). A teslim (also called m\u00fclazime) is added to each section in the manner of a ritornello. In the contemporary form, the second hane of the pe\u015frev often modulates to a related makam. The final hane is often in a contrasting ternary rhythm (usul))"}, "madsrdf:citationSource": "Grove music online, April 26, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc938cc6e6a1d443f9d7040344889b637b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc938cc6e6a1d443f9d7040344889b637b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Peshrevs"}}, {"@id": "_:nc938cc6e6a1d443f9d7040344889b637b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Peshrevs"}}], "@id": "/authorities/genreForms/gf2024026038"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026039", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSaz semaisi (Instrumental music)", "identifiers:lccn": "gf2024026039", "madsrdf:adminMetadata": [{"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b1"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Saz semaisi (Instrumental music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b5"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b6"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b7"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b8"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b9"}], "madsrdf:hasVariant": [{"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b10"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b13"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b16"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b19"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b22"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b25"}], "madsrdf:historyNote": "[Established August 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-08-22T14:19:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-04-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Saz semaisi (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The saz semai (also spelled in Turkish as saz sema'i, saz sema-i, saz sema i, saz sema\u012b, saz sem\u00e2'\u00ee, sazsemai, saz semaisi, or sazsemaisi and in the Arab world as sam\u00e2i) is an instrumental form in Ottoman classical music. It was typically the closing movement of a fas\u0131l (i.e. suite). The saz semai is metered and typically uses the usul (rhythmic structure) called aksak semai.)"}, "madsrdf:citationSource": "Wikipedia, August 7, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(saz semaisi; T\u00fcrk\u00e7e: saz semaisi (accusative form saz semaisini, plural form semaileri)"}, "madsrdf:citationSource": "Wiktionary, viewed August 7, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 482 (The semai is unique among Turkish classical compositional forms in its lack of definition as either vocal or instrumental) page 490 (vocal and instrumental genres known as \"semai\")"}, "madsrdf:citationSource": "Feldman, Walter, Music of the Ottoman court, 2024, PDF file downloaded May 21, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (this recording contains the complete instrumental works (saz semais and pe\u015frevs)) insert, page 6 (the saz semai, in 10/8 meter, an instrumental piece, belongs to the concert cycle known as fas\u0131l; historically, the saz semai served as the closing piece of the fas\u0131l cycle, which began with a prelude (the pe\u015frev), followed by several songs; by the early 19th century, however, the pe\u015frev and the saz semai were more often recognized and performed as separate pieces, their forms divided into four distinct sections: a theme or ritornello (teslim) and three development sections (hane)) (DLC)99594509"}, "madsrdf:citationSource": "Work cat: The works of Tatyos Efendi, 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Turkey IV. Art music. 4. Formal structure (Dominant among the instrumental forms are the pe\u015frev and saz semaisi; since the early 19th century they have had four sections (hane: 'house'). A teslim (also called m\u00fclazime) is added to each section in the manner of a ritornello)"}, "madsrdf:citationSource": "Grove music online, April 26, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Saz semaileri (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Saz semaileri (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sazsemai (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sazsemai (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Saz semai (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Saz semai (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Semai (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Semai (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Saz sema-i (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Saz sema-i (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Saz semais (Instrumental music)"}}, {"@id": "_:nfd0b9a6c38f44d60a6759949eb582f15b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Saz semais (Instrumental music)"}}], "@id": "/authorities/genreForms/gf2024026039"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026040", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $a\u015eark\u0131s", "identifiers:lccn": "gf2024026040", "madsrdf:adminMetadata": [{"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b1"}, {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "\u015eark\u0131s"}, "madsrdf:elementList": {"@list": [{"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": [{"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b5"}, {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b6"}, {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b7"}], "madsrdf:hasVariant": {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b8"}, "madsrdf:historyNote": "[Established August 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-08-22T14:19:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-04-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "\u015eark\u0131s"}}, {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Turkey IV. Art music 4. Formal structure (\u015fark\u0131; song form consisting of two contrasted melodic lines, corresponding to two textual lines, referred to as zemin and zaman, followed by a contrasting meyan section, in which there is a modulation and often an upwards shift in tessitura; the meyan is followed by a repeat of the first or second line, or a freshly composed line that functions as a refrain; the whole is punctuated by instrumental sections known as arana\u011fme)"}, "madsrdf:citationSource": "Grove music online, April 26, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 490 (From the early seventeenth century the servants of the court, the women of the seraglio and the members of aristocratic families were frequently amateur performers of an informal vocal repertoire accompanied by folk-derived lutes. Due to this circumstance the popular music of the capital was incorporated into the music of the court; by the middle of the century one of these genres, the \u015fark\u0131, with its simplified Turkish lyrics had become particularly popular among these members of the elite. This genre became one of the principal forms of \"light\" music in the court.)"}, "madsrdf:citationSource": "Feldman, Walter, Music of the Ottoman court, 2024, PDF file downloaded May 21, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert, page 10 (\u015fark\u0131; popular art song; typically constructed of four lines (misra) of verse; the first line (zemin) introduces the makam [mode], while the next (zaman, sometimes referred to as nakarat)) continues the melodic development; the third line (meyan) may introduced modulation to another makam, but even if it does not, the meyan is always identifiable by the shift of tessitura to the higher octave; the nakarat is recapitulated in the fourth line (karar), returning to the original makam; as a vocal form, the \u015fark\u0131 is unique in its use of poetic meters grounded in Osmali Turkish; the texts are both mystical and emotional in nature, addressing the themes of unrequited love, hopelessness and isolation; utilizing complex symbolism, analogy and metaphor, the meaning of the language is often paradoxical and confusing)"}, "madsrdf:citationSource": "Work cat: The works of Tatyos Efendi. Vocal masterpieces,1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "\u015earki"}}, {"@id": "_:n20d3f1a1c1ec48178581f5accacd8df2b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "\u015earki"}}], "@id": "/authorities/genreForms/gf2024026040"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026041", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBoys love (Fiction)", "identifiers:lccn": "gf2024026041", "madsrdf:adminMetadata": [{"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b1"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Boys love (Fiction)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b5"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b6"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b7"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b8"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b9"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b10"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b11"}], "madsrdf:hasVariant": [{"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b12"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b15"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b18"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b21"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b24"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b27"}], "madsrdf:historyNote": "[Established October 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-04-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-11T14:07:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Boys love (Fiction)"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"a popular female-oriented romantic fiction genre\")"}, "madsrdf:citationSource": "Zhang, C. 'My double love of boys': Chinese women's fascination with 'Boys' Love' fiction, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Boys love (YAOI) novel, equivalent to a HARLEQUIN love story\")"}, "madsrdf:citationSource": "Roppongi night clinic, via GoodReads, viewed Oct. 16, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. vii (\"boys love fiction\") p. 3 (BL stories appear both as manga and as \"'light novels' (raito noberu)--a local label for lowbrow, highly disposable prose fiction\") p. 5 (a prior term for BL, \"sh\u014dnen'ai\", has \"largely fallen out of favor\"; another past term is \"yaoi\"; \"'boys love' caught on as a generic label over the course of the 1990s, and the term was eventually rendered into katakana as 'b\u014dizurabu' and shortened to 'BL'\"; another past term is \"JUNE\") p. 11 (BL plots rely on romance fiction tropes, like the expectation of a happy ending) p. 15 (BL plots don't realistically depict gay men, as protagonists often display \"an exclusive attraction to each other (that is, they are not attracted to men in general)\"; protagonists are presented as androgynous or \"feminized\") (OCoLC)878837806"}, "madsrdf:citationSource": "Boys love manga and beyond, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"The wildly popular danmei/Boys' Love novel series from China set in the universe of The Husky and His White Cat Shizun!\") (OCoLC)1375674766"}, "madsrdf:citationSource": "Roubaobuchirou, Remnants of filth. 1, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 50 (prior term for BL is \"tanbi\": \"a euphemistic application of the literary term originally coined to refer to authors with signature aesthetic styles\")"}, "madsrdf:citationSource": "Mizoguchi, A. Male-male romance by and for women in Japan : a history and the subgenres of yaoi fictions, in U.S.-Japan women's journal, v. 25 (2003):", "madsrdf:citationStatus": "found"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"characteristically, the romances depicted in the genre would be idealized and often conclude happily\"; examples include Indrytimes' \"boys-love novel 'Love Sick: Chulamun Num Kangkeng Namngoen' (Love Sick: The Chaotic Lives of Blue Shorts Guys)\")"}, "madsrdf:citationSource": "Uaychinda, Y. Thai boys-love (BL) literature : fanfics, novels, and beyond (The \"Y\" chronicle part I), via the Thai Foundation website, viewed Oct. 16, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (\"JUNE yaoi novel\") back cover (\"follows the stories of Kanae and Yuichi, both social outsiders looking for someone... As their relationship grows, will they remember to open up and understand one another? Or will words go unspoken in favor of the pursuit of bodily pleasure?\") (OCoLC)174130577"}, "madsrdf:citationSource": "Work cat: Morimoto, A. Body language, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shounen-ai fiction"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shounen-ai fiction"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sh\u014dnen-ai fiction"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sh\u014dnen-ai fiction"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "JUNE fiction"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "JUNE fiction"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tanbi fiction"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tanbi fiction"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yaoi fiction"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yaoi fiction"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "BL fiction"}}, {"@id": "_:n7c7afada896147e8a5d8d156c8d9b108b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "BL fiction"}}], "@id": "/authorities/genreForms/gf2024026041"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026042", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChang\u00fc\u00ed", "identifiers:lccn": "gf2024026042", "madsrdf:adminMetadata": [{"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb1"}, {"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Chang\u00fc\u00ed"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026067"}, "madsrdf:hasSource": [{"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb5"}, {"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb6"}, {"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb7"}], "madsrdf:historyNote": "[Established October 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-11T14:07:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-05-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chang\u00fc\u00ed"}}, {"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(in sect. on Cuban pop. mus.: Chang\u00fc\u00ed; sub-classification of the Cuban son)"}, "madsrdf:citationSource": "Grove music online, June 19, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (Chang\u00fc\u00ed) insert, page 4 (chang\u00fc\u00ed; \"rustic country cousin\" of the Cuban son; the \"typical\" dance music of Cuba's Guant\u00e1namo province; a variant of son that uses similar instruments, but of different sizes and tuning; unlike some of the other forms of Cuban popular music, chang\u00fc\u00ed's African base is not the Yoruba-Ibo culture of Nigeria, but the Bantu culture of Congo and the Ivory Coast; while the language involved is no longer widely spoken in Cuba, the rhythm of that language remains in the music) (DLC)00724530"}, "madsrdf:citationSource": "Work cat: Chang\u00fc\u00ed, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cb8d186af554beab7e2b1c09c1507afb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 9, p. 1145 (Chang\u00fc\u00ed; one sub-type of son; from the easternmost zone of Cuba; used at parties & other social occasions among people living far apart)"}, "madsrdf:citationSource": "Dicc. de la m\u00fasica espa\u00f1ola e hispanoamericana, 1999:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2024026042"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026045", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIndustrial musicals", "identifiers:lccn": "gf2024026045", "madsrdf:adminMetadata": [{"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb1"}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Industrial musicals"}, "madsrdf:elementList": {"@list": [{"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026957"}, "madsrdf:hasSource": [{"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb5"}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb6"}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb7"}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb8"}], "madsrdf:hasVariant": [{"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb9"}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb12"}], "madsrdf:historyNote": "[Established October 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-05-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-11T14:07:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Industrial musicals"}}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "What are industrial musicals? (Once upon a time, when American industry ruled the earth, business and Broadway had a baby. This mutant offspring, glimpsed only at conventions and sales meetings, was the industrial musical. Think Broadway show, except the audience is managers and salesmen, and the songs are about how great it is to be working at the company)"}, "madsrdf:citationSource": [{"@id": "https://www.industrialmusicals.com/about/"}, "Industrial musicals website, viewed September 16, 2024"], "madsrdf:citationStatus": "found"}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Industrial musicals (UF: Corporate musicals, Industrial shows (Musicals); BT: Musicals; Work cat: Young, S. Everything's coming up profits, 2013)"}, "madsrdf:citationSource": "LCSH, April 11, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (Music from Ford Tractor, 1959, 1960, 1964) (OCoLC)1429144251"}, "madsrdf:citationSource": "Work cat: Hey Mister! Thinking tractor?, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Industrial musicals; a musical performed internally for the employees or shareholders of a business to create a feeling of being part of a team, to entertain, and/or to educate and motivate the management and salespeople to improve sales and profits. It can be used to increase staff awareness of public relations, advertising, marketing or corporate image; Other terms for industrial musicals include the corporate musical or industrial show; Industrial musicals are not restricted to corporations or to businesses involved in industry)"}, "madsrdf:citationSource": "Wikipedia, April 11, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Corporate musicals"}}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Corporate musicals"}}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Industrial shows (Musicals)"}}, {"@id": "_:nef8b7de89c7140419f9a5ec9b9407bebb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Industrial shows (Musicals)"}}], "@id": "/authorities/genreForms/gf2024026045"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026046", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBaby books", "identifiers:lccn": "gf2024026046", "madsrdf:adminMetadata": [{"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b1"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Baby books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026173"}, "madsrdf:hasSource": [{"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b5"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b6"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b7"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b8"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b9"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b10"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b11"}], "madsrdf:hasVariant": {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b12"}, "madsrdf:historyNote": "[Established October 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Albums intended to hold photographs, mementoes, and written records of a child's development from infancy."}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-11T14:07:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-05-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Baby books"}}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(baby books. SN Books in which to keep records of a child's birth and development through infancy, usually in the form of an album to hold pictures and other memorabilia as well as text. BT albums (books))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, May 13, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "item in the History & Special Collections for Sciences, UCLA Special Collection (The parents of Elizabeth Caroline Foote, born 1963 in Pacific Palisades (Los Angeles), California, kept a scrapbook in a 3-ring binder, covered in pink satin, to document their daughter's first years. The album includes birth announcement (\"Footenote\"), congratulatory cards and messages, photographs, baby slippers, birthday cards, school class photographs, cartoons, one eyelash, and more. Medical content includes the itemized hospital bill for the mother's maternity stay, advertisement-bearing notepad sheets on which doctors described growth progress and wrote diet recommendations, and descriptive inserts about vaccinations. Inserted throughout are typewritten narratives, written with great warmth and wit, about the baby's behaviors, activities, and milestones)"}, "madsrdf:citationSource": "Baby book of Elizabeth Caroline Foote, 1963-1974", "madsrdf:citationStatus": "found"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(archival collection includes baby books) (OCoLC)876277160"}, "madsrdf:citationSource": "Work cat.: Child Welfare League of Renton. Child Welfare League of Renton records, 1938-1955", "madsrdf:citationStatus": "found"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(baby book: an album for mounting pictures and other memorabilia of a baby and for keeping a record of its growth from infancy)"}, "madsrdf:citationSource": "Collins English dictionary website, May 13, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Baby books. BT Blank-books; Infants' supplies)"}, "madsrdf:citationSource": "LCSH, May 13, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(baby book (plural baby books): A book containing photographs and written records of a child's development)"}, "madsrdf:citationSource": "Wiktionary, May 13, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Baby book (Baby books are scrapbooks used by parents to track their children's development. Baby books can track a child's development or mark developmental milestones)"}, "madsrdf:citationSource": "Wikipedia, May 13, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Baby"}}, {"@id": "_:n79a31dde363d4a1ebe5a7dedd613a347b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Baby"}}], "@id": "/authorities/genreForms/gf2024026046"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026047", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMedia guides (Sports)", "identifiers:lccn": "gf2024026047", "madsrdf:adminMetadata": [{"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b1"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Media guides (Sports)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026038"}, "madsrdf:hasSource": [{"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b5"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b6"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b7"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b8"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b9"}], "madsrdf:hasVariant": [{"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b10"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b13"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b16"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b19"}], "madsrdf:historyNote": "[Established October 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-18T07:01:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-05-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Media guides (Sports)"}}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Starting in the 1970s teams realized that the public had an insatiable thirst for information--historical, statistical, and personal--about ballplayers. Today, most teams also include photographs and brief biographies of non-roster spring training invitees and \"behind the scenes\" staff, such as team physicians and the non-uniformed staff (ticket manager, stadium manager, organist, public address announcer, etc.)"}, "madsrdf:citationSource": [{"@id": "https://sabr.org/journal/article/media-guides/"}, "Media guides, via Society for American Baseball Research website, May 15, 2024"], "madsrdf:citationStatus": "found"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: This collection consists of media guides for the original incarnation of the United States Football League during its three seasons of play in 1983, 1984, and 1985. The media guides typically contain pictures, articles, bios, and statistics about the players on the teams, as well as pictures, information, and bios about coaches and other team personnel, including owners, administrators, trainers, and cheerleaders. The guides usually also contain historical and contemporary information about the team and the league and advertisements.) (OCoLC)1360417521"}, "madsrdf:citationSource": "United States Football League media guides, 1983-1985", "madsrdf:citationStatus": "found"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(media guide; media guides are also known as dope books)"}, "madsrdf:citationSource": "Wikipedia, viewed October 17, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)33318738"}, "madsrdf:citationSource": "Work cat.: Merhoff, Mo. Rowing media guide : the Goodwill Games, 20 July-August, 1990, rowing competition 21-22 July, Lake Washington, Mt. Baker Rowing Course, Seattle, Washington, 1990?", "madsrdf:citationStatus": "found"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)47648064"}, "madsrdf:citationSource": "Media guide : Sydney 2000 Olympic Games, September 2000, \u00a92000.", "madsrdf:citationStatus": "found"}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sports press guides"}}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sports press guides"}}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dope books"}}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dope books"}}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sports media guides"}}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sports media guides"}}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Press guides (Sports)"}}, {"@id": "_:nee0babdf0ab24af1972be3ba7f8b37e7b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Press guides (Sports)"}}], "@id": "/authorities/genreForms/gf2024026047"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026049", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPrefatory works", "identifiers:lccn": "gf2024026049", "madsrdf:adminMetadata": {"@id": "_:n6e09dbfb26ef43a0be49859541344141b1"}, "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Prefatory works"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6e09dbfb26ef43a0be49859541344141b2"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n6e09dbfb26ef43a0be49859541344141b4"}, "madsrdf:hasSource": [{"@id": "_:n6e09dbfb26ef43a0be49859541344141b7"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b8"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b9"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b10"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b11"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b12"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b13"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b14"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b15"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b16"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b17"}], "madsrdf:hasVariant": [{"@id": "_:n6e09dbfb26ef43a0be49859541344141b18"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b21"}], "madsrdf:historyNote": "[Established August 2023. Heading changed from Prefaces to Prefatory works in May 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-05-24T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b2", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prefatory works"}}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b4", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6e09dbfb26ef43a0be49859541344141b5"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prefaces"}}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b5", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prefaces"}}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(contains critical editions of the prefatory texts De Bruyne encountered in the biblical manuscripts consulted to support the work of the Commission for the Revision of the Vulgate; the prefaces themselves are by various authors, most prominently Saint Jerome; texts of the prefaces in Latin, with commentary in English) (OCoLC)914164081"}, "madsrdf:citationSource": "Bruyne, Donatien de. Pr\u00e9faces de la Bible latine. Prefaces to the Latin Bible, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a sound recording preserved at the Library of Congress) (OCoLC)33864877"}, "madsrdf:citationSource": "MacLeish, Archibald. Conquistador. Preface. Spanish. Francisco Aguilera reading a Spanish translation of the preface to Archibald MacLeish's Conquistador, 1943:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(preface: A preliminary statement at the beginning of a book, usually written by the author, stating the origin, scope, purpose, plan, and intended audience of the work and including any afterthoughts and acknowledgments of assistance, usually in the final paragraphs. When written by a person other than the author, the preliminary statement is a foreword. The preface or foreword is distinct from the introduction, which addresses the subject of the work and prepares the reader for the treatment to follow. When a new edition is published, the preface may be rewritten to alert the reader to the extent of additions or changes in the text, but the introduction usually remains unchanged. The preface or foreword normally follows the dedication and precedes the introduction in the front matter of a book. The term is sometimes used in the title of a book-length treatment of a subject to indicate that the author's comments are introductory or preliminary (example: A Preface to Eighteenth Century Poetry [1963] by James Sutherland).)"}, "madsrdf:citationSource": "Reitz, J.M. Online dictionary for library and information science, Apr. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)10554616"}, "madsrdf:citationSource": "Flamsteed, John. Historia coelestis Britannica. Preface. English. The preface to John Flamsteed's Historia coelestis Britannica, or, British catalogue of the heavens (1725), 1982.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(preface: 1. a preliminary statement in a book by the book's author or editor, setting forth its purpose and scope, expressing acknowledgment of assistance from others, etc. 2. an introductory part, as of a speech. 3. something preliminary or introductory: The meeting was the preface to an alliance. 4. Ecclesiastical. a prayer of thanksgiving, the introduction to the canon of the Mass, ending with the Sanctus)"}, "madsrdf:citationSource": "Dictionary.com, Apr. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)13954967"}, "madsrdf:citationSource": "Kamehameha IV, King of the Hawaiian Islands. Preface to the Book of common prayer, 1955.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(preface: A note preceding the text of a book, which states the origin, purpose, and scope of the work(s) contained in the book and sometimes includes acknowlegments of assistance. When written by someone other than the author, is more properly a foreword. To be distinguished from the introduction, which deals with the subject of the work(s))"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)35150827"}, "madsrdf:citationSource": "Whitman, Walt. Leaves of grass. Preface. Leaves of grass : preface to the original edition, 1855, 1881.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Preface: The author's reasons for writing, and his afterthoughts. It indicates the scope, history, and purpose of the book and the class of readers for whom it is intended, and expresses thanks to helpers. It is usually written by the author, follows the Dedication, and precedes the Introduction. It is usual to write a new preface to a new edition, outlining the extent of changes and additions. Sometimes called 'Foreword')"}, "madsrdf:citationSource": "Harrod, L.M. The librarians' glossary of terms used in librarianship and the book crafts and reference book, 1971:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)33159605"}, "madsrdf:citationSource": "Sazykin, A. G. Katalog mongol\u02b9skikh rukopise\u012d i ksilografov Instituta vostokovedenii\ufe20a\ufe21 Akademii nauk SSR. Preface. English. Preface to the Catalogue of Mongolian manuscripts and xylographs in the Institute of Oriental Studies of the Academy of Sciences of the USSR, volume one (Moscow, 1988) : English translation and edition of the Russian preface (pages 6-27), 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivision --Prefaces. Use as a form subdivision under uniform titles of sacred works.)"}, "madsrdf:citationSource": "LCSH, Apr. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6e09dbfb26ef43a0be49859541344141b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prefaces"}}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prefaces"}}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6e09dbfb26ef43a0be49859541344141b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Introductions"}}, {"@id": "_:n6e09dbfb26ef43a0be49859541344141b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Introductions"}}], "@id": "/authorities/genreForms/gf2024026049"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2024026050", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrail maps", "identifiers:lccn": "gf2024026050", "madsrdf:adminMetadata": [{"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b1"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trail maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026690"}, "madsrdf:hasSource": [{"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b5"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b6"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b7"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b8"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b9"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b10"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b11"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b12"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b13"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b14"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b15"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b16"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b17"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b18"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b19"}], "madsrdf:hasVariant": [{"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b20"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b23"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b26"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b29"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b32"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b35"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b38"}], "madsrdf:historyNote": "[Established October 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-18T07:01:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-05-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trail maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)174070400"}, "madsrdf:citationSource": "New Zealand Automobile Association. YHA New Zealand backpacker map, 2007?", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trail map: A type of map that's used by hikers to aid in navigation. The primary information on a trail map will typically show the trails in a particular area. Some also include information on local features, places of interest, and interesting facts)"}, "madsrdf:citationSource": "Campnab's pretty darned useful glossary of camping terms, via Campnab website, May 29, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)4532455"}, "madsrdf:citationSource": "Texas. Parks and Wildlife Department. Pedernales Falls State Park hikers map.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)918918931"}, "madsrdf:citationSource": "United States. Forest Service. Henderson Flat OHV trail system map, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1027964210"}, "madsrdf:citationSource": "Green Mountain Club. Mt. Mansfield and the Worcester Range hiking trail map, \u00a92007.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 12 (trail maps; are indispensable for people with disabilities to better plan for, and anticipate the hike; Trail maps can be used to convey information in a variety of ways. They can be used to pinpoint features, obstacles and amenities along the trail; Providing access to trail maps/information along the trail as well as at the trailhead gives users basic information as they are experiencing the trail. Knowing potential challenges in advance enables users to determine whether the trail meets their needs and desired experience. Maps provide a way to convey to users the distance between points, such as the trailhead and an obstacle)"}, "madsrdf:citationSource": [{"@id": "https://www.accessrecreation.org/Trail_Guidelines/Trail_maps.html"}, "Guidelines for providing trail information to people with disabilities, 2013, via Access Recreation website, May 29, 2024:"], "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)951500308"}, "madsrdf:citationSource": "Thomson Media Group. Northern Territory backpackers map. Volume 1, between 1990 and 1993?", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trail map; map used to aid in navigation; some trail maps have been extensively edited for content giving detail about nearby features, places of interest, or interesting facts, while some maps may only give minimal information of the trail)"}, "madsrdf:citationSource": "Wikipedia, May 29, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(series: Trail tracks (Estes Park, Colo.))"}, "madsrdf:citationSource": "Niehues, James E. Wasatch Front panoramic hiking map, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)435644"}, "madsrdf:citationSource": "Tabor, R. W. Hiker's map of the North Cascades, 1968.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The most commonly used trail maps are topographic maps ... Studying these maps, allows hikers and backpackers to spatially orientate themselves to the surrounding environments, making it possible for them to navigate their way through different types of terrain)"}, "madsrdf:citationSource": "Hiking maps and why you need them, via Washington Trails Association website, May 29, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1250640370"}, "madsrdf:citationSource": "Work cat.: U.S. Fish and Wildlife Service. Balcones Canyonlands National Wildlife Refuge trail map, 2021.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1056430650"}, "madsrdf:citationSource": "Friends of Killarney Park. Killarney Provincial Park : backpacking, hiking and canoe route map, 2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hiking map: A hiking map is an essential tool for outdoor enthusiasts, providing detailed information about trails, landmarks, and topography. It helps hikers navigate through unfamiliar terrain, ensuring a safe and enjoyable hiking experience. With a hiking map, you can plan your route, estimate distances, and identify potential hazards or points of interest along the way)"}, "madsrdf:citationSource": "Survival dictionary, via Survival Kompass website, May 29, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A good trail map is one of the most valuable items you can carry on a hike. It tells you what lies ahead and helps you make wise decisions; Most trail maps feature a compass or north arrow that reveals how the map is oriented)"}, "madsrdf:citationSource": "Sarnacki, A. How to read a trail map, via Bangor daily news website, Jul 1, 2020, viewed May 29, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Backpacker maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Backpacker maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Backpackers maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Backpackers maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trail system maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trail system maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hikers maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hikers maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hiking maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hiking maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hiking trail maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hiking trail maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b38", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b39"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Backpacking maps"}}, {"@id": "_:nb073de3aa6cc4cb8b7f8dad7c09ce3a4b39", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Backpacking maps"}}], "@id": "/authorities/genreForms/gf2024026050"}
