recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T09:47:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cadastral maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plat maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plat maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cadastral map (a map showing the boundaries of subdivisions of land, usually with the bearings and lengths thereof and the areas of individual tracts, for purposes of describing and recording ownership; also called property map; see also plat)"}, "madsrdf:citationSource": "Glossary of mapping, charting, and geodetic terms, 1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "map, cadastral (a map showing the boundaries of subdivisions of land, usually with the bearings and lengths thereof and the areas of individual tracts, for purposes of describing and recording ownership. A cadastral map may also show culture, drainage, and other features affecting the value and use of the land; also known as property map) plat (1. a diagram (map), drawn to scale, showing all essential data pertaining to the boundaries and subdivisions of a tract of land, as determined by survey or protraction. Also called plan, plot, and protraction. A plat should show all data required for a complete and accurate description of the land which it delineates, including the bearings (or azimuths) and lengths of the boundaries of each subdivision. This is, in fact, the distinguishing characteristic of a plat as compared to other types of maps. A plat may constitute a legal description of the land and be used in lieu of a written description)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (plat: A diagram drawn to scale showing land boundaries and subdivisions, together with all data essential to the description and identification of the several units shown thereon, and including one or more certificates indicating due approval. A plat differs from a map in that it does not necessarily show additional cultural, drainage, and relief features)"}, "madsrdf:citationSource": "Cartographic materials, 2002, 2005 update via Cataloger's desktop, March 23, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plat maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plat maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plot diagrams"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plot diagrams"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plat diagrams"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plat diagrams"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plat books"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plat books"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plot maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plot maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plan diagrams"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plan diagrams"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Protraction maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Protraction maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Property maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Property maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plan maps"}}, {"@id": "_:n2ebf062df95e4c6b88421bbe4f932709b36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plan maps"}}], "@id": "/authorities/genreForms/gf2011026106"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026107", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCameraless animation films", "identifiers:lccn": "gf2011026107", "madsrdf:adminMetadata": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b1"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cameraless animation films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026049"}, "madsrdf:hasSource": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b5"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b6"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b7"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b8"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b9"}], "madsrdf:hasVariant": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b10"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b13"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b16"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b19"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b22"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b25"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b28"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b31"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films created by drawing, painting, or scratching the images directly on film stock.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025516"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T11:27:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cameraless animation films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 53 (Graphic animation: use for animation achieved by drawing or painting directly on the film surface wtihout the use of a camera)"}, "madsrdf:citationSource": "Yee, Martha M. Moving image materials : genre terms, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cameraless animation, made famous by moviemakers like Norman McLaren, Len Lye and Stan Brakhage, is painted and drawn directly onto pieces of film, and then run through a projector)"}, "madsrdf:citationSource": "Wikipedia website, January 22, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Direct-on-film animation does not use a camera; instead the artist draws or etches directly on filmstock)"}, "madsrdf:citationSource": "National Film Board of Canada website, March 21, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 13-14 (Cameraless animated films; Direct animation films; Drawn on films; Graphic animation; Hand-drawn films; Noncamera films; Out-of-camera films: Direct drawing, painting, or scratching on celluloid is a technique which does not require a camera...It is done by working on individual frames, or by working on the strip of film, ignoring the frames; during projection, the movement of the film will create the desired effect)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cameraless animation: type of animation in which the images are drawn directly on the film stock, rather than photographed)"}, "madsrdf:citationSource": "Moving image genre-form guide online, January 22, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Out-of-camera films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Out-of-camera films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Direct animation films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Direct animation films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hand-drawn films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hand-drawn films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Noncamera films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noncamera films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graphic animation films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic animation films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cameraless animated films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cameraless animated films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Direct-on film animation films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Direct-on film animation films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe338554f4e9483894c663ecc238c324b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Drawn-on films"}}, {"@id": "_:nfe338554f4e9483894c663ecc238c324b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drawn-on films"}}], "@id": "/authorities/genreForms/gf2011026107"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026108", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCaper films", "identifiers:lccn": "gf2011026108", "madsrdf:adminMetadata": [{"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b1"}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Caper films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026177"}, "madsrdf:hasSource": [{"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b5"}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b6"}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b7"}], "madsrdf:hasVariant": [{"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b8"}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature the execution of a particularly difficult undertaking, often questionable or illegal, the success of which depends on skill and careful planning.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025028"}}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T11:28:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Caper films"}}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Caper; RT: Thriller; Crime)"}, "madsrdf:citationSource": "Moving image genre-form guide online, February 11, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Caper film (Big-caper film; heist film))"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(caper film; a motion picture in which the plot revolves around a major theft or other illegal enterprise, usually a highly imaginative and complicated maneuver; dev. from the point of view of the lawbreakers)"}, "madsrdf:citationSource": "Oakey, V. Dict. of film and television terms, c1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Heist films"}}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heist films"}}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Big-caper films"}}, {"@id": "_:n55473e1244c447f4bc86365c9ebc61e5b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Big-caper films"}}], "@id": "/authorities/genreForms/gf2011026108"}
