{"@language": "en", "@value": "(debates. Formal contests in which the affirmative and negative sides of a proposition are advocated by opposing speakers.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(debate: a contention by words or arguments: as a) the formal discussion of a motion before a deliberative body according to the rules of parliamentary procedure; b) a regulated discussion of a proposition between two matched sides)"}, "madsrdf:citationSource": "Merriam-Webster online, Aug. 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 38 (debate: contention in argument)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed debates"}}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed debates"}}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Debate transcripts"}}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Debate transcripts"}}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Transcripts, Debate"}}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transcripts, Debate"}}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television debates"}}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television debates"}}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio debates"}}, {"@id": "_:na2ba8da21e604930bcb5417aab62e3c7b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio debates"}}], "@id": "/authorities/genreForms/gf2014026083"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026084", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDerivative works", "identifiers:lccn": "gf2014026084", "madsrdf:adminMetadata": [{"@id": "_:n6f1c14eac7754055a2593d4847242321b1"}, {"@id": "_:n6f1c14eac7754055a2593d4847242321b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Derivative works"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6f1c14eac7754055a2593d4847242321b3"}]}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026258"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026349"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026534"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026678"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026037"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026038"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026041"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026097"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026099"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026136"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026149"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027203"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026135"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026137"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026018"}], "madsrdf:hasSource": {"@id": "_:n6f1c14eac7754055a2593d4847242321b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that are based on one or more other works."}, {"@id": "_:n6f1c14eac7754055a2593d4847242321b1", "@type": "ri:Rec