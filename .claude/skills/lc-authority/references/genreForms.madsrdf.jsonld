ontentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb1c39428f4f640e79ec6dd1759e2c275b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Time-lapse films"}}, {"@id": "_:nb1c39428f4f640e79ec6dd1759e2c275b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A visual-music journey through time via photographic images and time-lapse photography set to music)"}, "madsrdf:citationSource": "Work cat.: Chronos [VR] c1991", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1c39428f4f640e79ec6dd1759e2c275b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Time-lapse cinematography: Godfrey Reggio's Koyaanisqatsi (1988) is a feature-length time-lapse film that explores American vistas)"}, "madsrdf:citationSource": "Beaver, F.E. Dictionary of film terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1c39428f4f640e79ec6dd1759e2c275b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"time-lapse films\": 7,670 hits; \"time-lapse movies\": 50,400 hits; \"timelapse films\": 7,950 hits; \"timelapse movies\": 137,000 hits)"}, "madsrdf:citationSource": "Google search, Jan. 9, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1c39428f4f640e79ec6dd1759e2c275b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(time-lapse films; time-lapse movie)"}, "madsrdf:citationSource": "Time-lapse films from Cambridge web cams, via WWW, Jan. 9, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1c39428f4f640e79ec6dd1759e2c275b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(time-lapse: Method of exposing frames at a single time or at preset intervals ... Koyaanisqatsi (1983) is an example of such time-lapse photography)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dictionary, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1c39428f4f640e79ec6dd1759e2c275b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nb1c39428f4f640e79ec6dd1759e2c275b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Time-lapse movies are made up of noncontiguous exposures taken over an extended period of time. When you play the movie at normal speed, the action is accelerated because those individual exposures, which can span hours or even days, fit into the space of seconds.)"}, "madsrdf:citationSource": "Carlson, J. Create a time-lapse movie, via Macworld Web site, Jan. 9, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1c39428f4f640e79ec6dd1759e2c275b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1c39428f4f640e79ec6dd1759e2c275b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Timelapse films"}}, {"@id": "_:nb1c39428f4f640e79ec6dd1759e2c275b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Timelapse films"}}], "@id": "/authorities/genreForms/gf2011026695"}
