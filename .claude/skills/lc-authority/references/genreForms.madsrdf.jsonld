ce", "madsrdf:citationSource": "Work cat.: Locke, D. Kpegisu, 1992.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d154c862652465ca75b7f06863f587ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3;New Grove;New Harvard dict.", "madsrdf:citationStatus": "notfound"}], "@id": "/authorities/genreForms/gf2014026898"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026899", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKrakowiaks (Music)", "identifiers:lccn": "gf2014026899", "madsrdf:adminMetadata": [{"@id": "_:n8ff3204e50df4986b66746e3bb89b3dfb1"}, {"@id": "_:n8ff3204e50df4986b66746e3bb89b3dfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Krakowiaks (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8ff3204e50df4986b66746e3bb89b3dfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:n8ff3204e50df4986b66746e3bb89b3dfb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8ff3204e50df4986b66746e3bb89b3dfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8ff3204e50df4986b66746e3bb89b3dfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8ff3204e50df4986b66746e3bb89b3dfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Krakowiaks (Music)"}}, {"@id": "_:n8ff3204e50df4986b66746e3bb89b3dfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Krakowiak. Polish folk dance, from the Krak\u00f3w region, characterized by syncopated rhythms in fast duple time. It is associated with aspects of national dress: ribbons for the women and plumed caps, brass belt buckles and boots with steel strikers for the men.)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026899"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026900", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKuyis", "identifiers:lccn": "gf2014026900", "madsrdf:adminMetadata": [{"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb1"}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kuyis"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, "madsrdf:hasSource": [{"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb5"}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb6"}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb7"}], "madsrdf:hasVariant": [{"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb8"}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kuyis"}}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Glossary (Kyui: \"frame of mind,\" \"mood;\" in Central Asia, an independent instrumental piece, played on lutes, such as the dombra and dut\u0101r, that seeks to narrate a story; also kui. Kyuiler: term for Kazakh instrumental music)"}, "madsrdf:citationSource": "Garland ency. of world mus., v. 6, WWW site, Mar. 4, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"The Kazakh kuy [plural, kuyis] is an instrumental piece that lasts from one to five minutes. Each kuy explores a single musical image.\")"}, "madsrdf:citationSource": "Work cat.: Dombra du Kazakhstan, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Central Asia, Musicians (\"The distinction between composer (sal) and performer (sere) of a lyric song is firmly embedded in Kazakh musical culture, which stands out for the large number of musicians whose names remain attached to their compositions. These include composers of the instrumental genre k\u00fcy ...\")"}, "madsrdf:citationSource": "Grove Online:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kyuiler"}}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kyuiler"}}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kyui"}}, {"@id": "_:nf1fca45c0fb848d4bde4152c43fa96edb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kyui"}}], "@id": "/authorities/genreForms/gf2014026900"}
