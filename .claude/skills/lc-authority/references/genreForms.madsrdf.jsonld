{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026953", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aM\u00fasica sertaneja", "identifiers:lccn": "gf2014026953", "madsrdf:adminMetadata": [{"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b1"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "M\u00fasica sertaneja"}, "madsrdf:elementList": {"@list": [{"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b5"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b6"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b7"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b8"}], "madsrdf:hasVariant": [{"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b9"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b12"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "M\u00fasica sertaneja"}}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 319 (m\u00fasica sertaneja: most popular genre among migrant populations of greater S\u00e3o Paulo; industry catering to this audience is booming; traditional southeastern genres of dupla, particularly moda-de-viola, became m\u00fasica sertaneja when they started to be recorded commercially in late 1920s; term became current only in late 1950s, replacing the more pejorative term m\u00fasica caipira; \"caipira\" might best be glossed \"hillbilly,\" though it officially refers to inhabitants of the interior of the state of S\u00e3o Paulo)"}, "madsrdf:citationSource": "Garland encyc. of world music:", "madsrdf:citationStatus": "found"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under World popular music: Brazilian m\u00fasica sertaneja, cited as example of distinctive and original contribution of migrant underclasses to urban musical culture; under Brazil, Traditional music, Luso-Brazilian folk music traditions: caipira (from the interior of S\u00e3o Paulo state) singing; under Samba: caipira (i.e. rural S\u00e3o Paulo) folk samba)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Jan. 24, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 99885269: Nepomuceno, R. M\u00fasica caipira, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(m\u00fasica caipira: folk music of the outback region of Brazil; sertanejo: rural or country music)"}, "madsrdf:citationSource": "White, D. Dict. of popular music styles of the world", "madsrdf:citationStatus": "found"}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sertanejo (Music)"}}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sertanejo (Music)"}}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Caipira (Music)"}}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Caipira (Music)"}}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "M\u00fasica caipira"}}, {"@id": "_:n500243dc5a374c1399a0cbe452fa3ca2b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "M\u00fasica caipira"}}], "@id": "/authorities/genreForms/gf2014026953"}
