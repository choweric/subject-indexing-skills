{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026049", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPastiches (Literature)", "identifiers:lccn": "gf2018026049", "madsrdf:adminMetadata": [{"@id": "_:n694736b04933458684590a94d48a6cb6b1"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pastiches (Literature)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n694736b04933458684590a94d48a6cb6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026257"}, "madsrdf:hasSource": [{"@id": "_:n694736b04933458684590a94d48a6cb6b5"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b6"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b7"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b8"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b9"}], "madsrdf:hasVariant": [{"@id": "_:n694736b04933458684590a94d48a6cb6b10"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n694736b04933458684590a94d48a6cb6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-04T14:38:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastiches (Literature)"}}, {"@id": "_:n694736b04933458684590a94d48a6cb6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. v (pastiche; literary genre; imitation, voluntary or otherwise, whose character is in turn critical, parodic or caricatural)"}, "madsrdf:citationSource": "Work cat.: Anthologie du pastiche, 1926:", "madsrdf:citationStatus": "found"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 245 (pastiche; from the Italian pasticchio, a medley or patchwork stitched together from previous texts)"}, "madsrdf:citationSource": "Joshi, S.T. The assaults of chaos, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pastiche. A literary work composed from elements borrowed either from various other writers or from a particular earlier author; differs from parody in using imitation as a form of flattery rather than mockery, and from plagiarism in its lack of deceptive intent; pastiches)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pastiche. A patchwork of words, sentences or complete passages from various authors or one author; a kind of imitation and, when intentional, may be a form of parody; an elaborate form of pastiche is a sustained work (say, a novel) written mostly or entirely in the style and manner of another writer. See Cento; Collage)"}, "madsrdf:citationSource": "Cuddon, J.A. Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pasticcio (plural pasticci or pasticcios : pastiche) pastiche (1. a literary, artistic, musical, or architectural work that imitates the style of previous work. 2a. a musical, literary, or artistic composition made up of selections from different works : potpourri. 2b. hodgepodge)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Apr. 25, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n694736b04933458684590a94d48a6cb6b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n694736b04933458684590a94d48a6cb6b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pasticcios (Literature)"}}, {"@id": "_:n694736b04933458684590a94d48a6cb6b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pasticcios (Literature)"}}, {"@id": "_:n694736b04933458684590a94d48a6cb6b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n694736b04933458684590a94d48a6cb6b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pasticci (Literature)"}}, {"@id": "_:n694736b04933458684590a94d48a6cb6b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pasticci (Literature)"}}], "@id": "/authorities/genreForms/gf2018026049"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026052", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMythological films", "identifiers:lccn": "gf2018026052", "madsrdf:adminMetadata": [{"@id": "_:n668f1613c5974e31b4f73562ae9d3031b1"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mythological films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n668f1613c5974e31b4f73562ae9d3031b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n668f1613c5974e31b4f73562ae9d3031b5"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b6"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b7"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b8"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b9"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-05-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-03T13:39:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mythological films"}}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Summary: When the arrogant warrior Thor is banished to Earth from his homeworld of Asgard, he must fight to reclaim his lost powers. Pursued by an invasion force sent to destroy him, the fallen God of Thunder must rise to the battle and learn what it takes to become a true hero)"}, "madsrdf:citationSource": "Work cat.: Thor (Motion picture). Thor, \u00a92011", "madsrdf:citationStatus": "found"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Summary: Based on Homer's Odyssey. Ulysses' return from the Trojan Wars sets him upon a legendary adventure. He and his crew sail under the curse of Cassandra, and encounter Circe, the sirens and the cyclops)"}, "madsrdf:citationSource": "Ulysses (Motion picture : 1954). Ulysses, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 12 (mythic films)"}, "madsrdf:citationSource": "Marvel Comics into film, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 88 (under Epic: Mythological Epics. Mythology is a rich source for epic material, and surprisingly, it has not been plundered more often by the makers of epics (except the \"peplums\" made in Italy. This is in contrast with the horror and fantasy genres that have used mythological themes frequently in their films.) p. 108 (under Fantasy Film: Mythological-Fantasy Films. Mythological fantasy pictures borrow from the vast pool provided by mythology. See Epic and Peplum) p. 223 (Peplums are minor epics featuring mythological, biblical and Italian-created strongmen elevated to the category of popular heroes: Hercules, Maciste, Ursus, Samson, Goliath, Taur)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 13 (mythological films)"}, "madsrdf:citationSource": "Ancient magic and the supernatural in the modern visual and performing arts, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n668f1613c5974e31b4f73562ae9d3031b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Summary: Zeus is betrayed by Hades, captured and brought to the Underworld, and Perseus must abandon his attempts to retire to a quiet life as a fisherman, find Zeus, and end the Titans' struggle to rule the Earth)"}, "madsrdf:citationSource": "Wrath of the Titans, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026052"}
