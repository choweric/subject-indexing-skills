cordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T06:44:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical television programs"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indiana Jones television programs"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indiana Jones television programs"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Showtime's Masters of Sex isn't the only historical drama coming to TV.\")"}, "madsrdf:citationSource": "Hibberd, J. 6 new historical TV dramas (and how to tell them apart), via Entertainment weekly website, Oct. 3, 2013, viewed on Mar. 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 55 (Historical films and video (Nonfiction): Use for nonfiction film or video which presents, explains, or analyzes past events as past events. For dramatized treatments of historical events, use Docudrama)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Historical: Fictionalized work set in a certain specified time in the past; UF docudrama)"}, "madsrdf:citationSource": "Moving image genre-form guide online, July 30, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Historical television series (and one-of specials/short series) of history documentary-style programmes; Period piece TV series: television series that take place in historical time periods previous to when the shows were produced)"}, "madsrdf:citationSource": "Wikipedia website, July 30, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 54-55 (In 2005, Australia's public broadcasters each produced 'reality history' programs; British and American 'reality history' programs like Frontier House and 1940s House; reality history programs like 1940s House and 1900 House had been popular on Australian television; ABC began production on two history programs in 2004 (Outback House and Rewind) as part of a special initiative to produce Australian history for television; British and American history television programs)"}, "madsrdf:citationSource": "Film & history, May 2007, viewed online via EBSCOhost, Aug. 11, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "History television programs"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "History television programs"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Drama television programs, Historical"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drama television programs, Historical"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indiana Jones television programs"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indiana Jones television programs"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Historical dramas (Television programs)"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical dramas (Television programs)"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Docudramas (Television programs)"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Docudramas (Television programs)"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Historical drama television programs"}}, {"@id": "_:n96c29fe2605a421ca344c6dcc1b16191b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical drama television programs"}}], "@id": "/authorities/genreForms/gf2011026315"}
