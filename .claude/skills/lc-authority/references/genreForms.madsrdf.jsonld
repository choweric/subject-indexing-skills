{"@id": "_:n506661f9d7124087a0ae9d8307ef92c6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n506661f9d7124087a0ae9d8307ef92c6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Religious poetry"}}, {"@id": "_:n506661f9d7124087a0ae9d8307ef92c6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Religious poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n506661f9d7124087a0ae9d8307ef92c6b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008;Kennedy, X.J. The Longman dictionary of literary terms, c2006;Cuddon, J. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n506661f9d7124087a0ae9d8307ef92c6b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Scottish religious poetry : from the sixth century to the present : an anthology, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n506661f9d7124087a0ae9d8307ef92c6b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "American religious poems : an anthology, c2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:n506661f9d7124087a0ae9d8307ef92c6b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mitchell, S. The enlightened heart : an anthology of sacred poetry, 1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:n506661f9d7124087a0ae9d8307ef92c6b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n506661f9d7124087a0ae9d8307ef92c6b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sacred poetry"}}, {"@id": "_:n506661f9d7124087a0ae9d8307ef92c6b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sacred poetry"}}], "@id": "/authorities/genreForms/gf2014026503"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026504", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRenga", "identifiers:lccn": "gf2014026504", "madsrdf:adminMetadata": [{"@id": "_:n9c806f106232446aba3f6690914a4096b1"}, {"@id": "_:n9c806f106232446aba3f6690914a4096b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Renga"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9c806f106232446aba3f6690914a4096b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026413"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026476"}], "madsrdf:hasSource": [{"@id": "_:n9c806f106232446aba3f6690914a4096b5"}, {"@id": "_:n9c806f106232446aba3f6690914a4096b6"}, {"@id": "_:n9c806f106232446aba3f6690914a4096b7"}, {"@id": "_:n9c806f106232446aba3f6690914a4096b8"}], "madsrdf:hasVariant": [{"@id": "_:n9c806f106232446aba3f6690914a4096b9"}, {"@id": "_:n9c806f106232446aba3f6690914a4096b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Japanese linked verse that is written in alternating two- and three-line stanzas that depict pastoral themes."}, {"@id": "_:n9c806f106232446aba3f6690914a4096b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:39:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9c806f106232446aba3f6690914a4096b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9c806f106232446aba3f6690914a4096b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Renga"}}, {"@id": "_:n9c806f106232446aba3f6690914a4096b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Renga; a long, image-filled poem written in alternating stanzas of three lines and two lines, usually by a group of poets who take turns; a good renga combines the images and sensitivity to the natural seasons of haiku with the humor of senryu)"}, "madsrdf:citationSource": "The Teachers & Writers handbook of poetic forms, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c806f106232446aba3f6690914a4096b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Renga (Renga is a once popular but now seldom practiced genre of Japanese poetry in which verses (ku) alternately of 17 and 14 morae are joined into long sequences according to rules (shikimoku) that govern how constituent images are to be employed. By the latter half of the med. era (1185-1600), orthodox linked verse (ushin renga) had become the most widely practiced form of Japanese poetry in the vernacular; vast numbers of hundred-verse sequences (hyakuin) survive, and some linked-verse practitioners rank among Japan's greatest poets)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c806f106232446aba3f6690914a4096b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 294 (The Japanese renga is linked verses; historically two different forms, both involving more than one author: earlier form, called tanrenga, or short renga; a renga chain or long renga is a poem made of a sequence of rengas and composed by two or more authors)"}, "madsrdf:citationSource": "Turco, L. The book of forms, c2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c806f106232446aba3f6690914a4096b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetic Form: Renga--Renga, meaning \"linked poem,\" began over seven hundred years ago in Japan to encourage the collaborative composition of poems. Poets worked in pairs or small groups, taking turns composing the alternating three-line and two-line stanzas. Linked together, renga were often hundreds of lines long, though the favored length was a 36-line form called a kasen; the first stanza is three lines long with a total of seventeen syllables; the next poet adds the second stanza, a couplet with seven syllables per line. The third stanza repeats the structure of the first and the fourth repeats the second, alternating in this pattern until the poem's end; Thematic elements of renga are perhaps most crucial to the poem's success. The language is often pastoral, incorporating words and images associated with seasons, nature, and love.)"}, "madsrdf:citationSource": "Poetry.org, viewed Dec. 26, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c806f106232446aba3f6690914a4096b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9c806f106232446aba3f6690914a4096b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rengas"}}, {"@id": "_:n9c806f106232446aba3f6690914a4096b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rengas"}}, {"@id": "_:n9c806f106232446aba3f6690914a4096b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9c806f106232446aba3f6690914a4096b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ushin renga"}}, {"@id": "_:n9c806f106232446aba3f6690914a4096b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ushin renga"}}], "@id": "/authorities/genreForms/gf2014026504"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026505", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRengay", "identifiers:lccn": "gf2014026505", "madsrdf:adminMetadata": [{"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb1"}, {"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rengay"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026413"}, "madsrdf:hasSource": [{"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb5"}, {"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb6"}], "madsrdf:hasVariant": {"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Linked verse consisting of six two- and three-lined stanzas that share a unifying theme."}, {"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:39:33"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rengay"}}, {"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Rengay is a North American variation on the Japanese linked verse form. The original form of rengay, a 6-link collaborative poem by 2 poets, was invented in August 1992 by Garry Gay; attributes: 1. A 6-verse linked poem that follows a theme. The linkage means that the rengay is more than simply six depictions by different poets of a theme. Each verse responds in some way (often by contrast or by association) to the verse that precedes it. 2. The form acknowledges the renku tradition of mingling the stanzas of different authors, with each stanza composed in the form of a 3-line (haiku) verse or a 2-line verse. 3. The 2-person form of rengay. The initial form of rengay was created for 2 collaborating poets with each poet writing two haiku and a total of three verses. 4. The 3-person form of rengay. For 3 collaborators, which is closer to the renku form in structure. Its content, however, remains in the rengay spirit. Each collaborator writes one 3-line verse and one 2-line verse. 5. The rengay can be written as a solo rengay, when one poet explores the topic in two independent voices. Length: The rengay is brief (6 verses). The renku is longer, with 36 links being popular. Historic renga of 1000 verses and more are recorded.)"}, "madsrdf:citationSource": "Zimmerman, J. The rengay verse form, via WWW, July 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rengay is a six-verse poem usually by two or three writers using a set pattern of three-line and two-line haiku. Unlike renga or renku, all six poems focus on at least one unifying theme. Having a theme is the most important characteristic of rengay. Garry Gay invented the rengay form in 1992)"}, "madsrdf:citationSource": "Rengay, via Graceguts website, July 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rengay poetry"}}, {"@id": "_:ne56f094093e64a4aaf99c5df7968dbaeb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rengay poetry"}}], "@id": "/authorities/genreForms/gf2014026505"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026506", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRenku", "identifiers:lccn": "gf2014026506", "madsrdf:adminMetadata": [{"@id": "_:nc87fe0332fa1445e82d35e301d616e73b1"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Renku"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc87fe0332fa1445e82d35e301d616e73b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026413"}], "madsrdf:hasSource": [{"@id": "_:nc87fe0332fa1445e82d35e301d616e73b5"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b6"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b7"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b8"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b9"}], "madsrdf:hasVariant": [{"@id": "_:nc87fe0332fa1445e82d35e301d616e73b10"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Humorous Japanese linked verse written in two- and three-line stanzas."}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:39:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Renku"}}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haikai no renga, usually now called renku by the Japanese, is a style of linked poem that reached its height in the work of Bash\u00f4 (surname Matsuo, 1644-1694) and his disciples. The tradition began almost a thousand years ago (some would say longer ago than that), and is very much alive today in Japanese, English, and other languages.)"}, "madsrdf:citationSource": "Renku home website, July 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Renku began in the rising middle class in Japan, about 300-400 years ago. It is also called haikai no renga, and was the main type of poetry practiced by the famous poet Bash\u00f4 (today known outside of Japan mainly as a \"haiku poet\"). Renku is a popular version of the aristocratic renga; in renku linking is based mainly on an intuitive sense of what connects. In English, \"renku\" stanzas usually alternate three and two lines. Each length (36, 20, or 12 stanzas, for example) has special rules governing when certain topics should appear and so on)"}, "madsrdf:citationSource": "Higginson, W.J. What is \"linked poetry?\", via WWW, July 21 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haikai: \"Haikai\" is short for haikai no renga, the popular style of Japanese linked verse originating in the sixteenth century, as opposed to the earlier aristocratic renga; Renku: A renku is a linked-verse poem in the popular haikai style, particularly as practiced by Bash\u00f4 and later poets writing in his style. In Japanese, \"renku\" is a modern equivalent for haikai no renga. Usually written by two or more people, a renku's most important features are linking and shifting.)"}, "madsrdf:citationSource": "Official definitions of haiku and related terms, via The Haiku Society of America website, Aug. 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Renku (\"linked verses\"), or haikai no renga (\"comic linked verse\"), is a Japanese form of popular collaborative linked verse poetry. It is a development of the older Japanese poetic tradition of ushin renga, or orthodox collaborative linked verse. At renku gatherings participating poets take turns providing alternating verses of 17 and 14 morae. Initially haikai no renga distinguished itself through vulgarity and coarseness of wit, before growing into a legitimate artistic tradition, and eventually giving birth to the haiku form of Japanese poetry. The term renku gained currency after 1904, when Kyoshi Takahama started to use it.)"}, "madsrdf:citationSource": "Wikipedia, July 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haikai: (literally, \"comic\"), more properly called haikai no renga (comic linked verse), refers to a number of poetic forms that emerged in the early mod. period in Japan (1615-1868). The term is used in Kokin waka sh\u00fb to refer to unconventional or humorous waka. With the devel. of renga (linked verse) in the med. period (1185-1600), the term haikai no renga denoted a variety of humorous linked verse that was written between sessions of orthodox renga composition. As a courtly form, orthodox renga forbade the use of nonelegant words (such as Buddhist terms and Chinese compounds); haikai no renga, however, permitted it)"}, "madsrdf:citationSource": "Princeton encyclopedia of poetry and poetics, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc87fe0332fa1445e82d35e301d616e73b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Haikai no renga"}}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Haikai no renga"}}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc87fe0332fa1445e82d35e301d616e73b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comic linked verse (Renku)"}}, {"@id": "_:nc87fe0332fa1445e82d35e301d616e73b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comic linked verse (Renku)"}}], "@id": "/authorities/genreForms/gf2014026506"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026507", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRenshi", "identifiers:lccn": "gf2014026507", "madsrdf:adminMetadata": [{"@id": "_:n3786372477ef457e8a9f144eb44b94ebb1"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Renshi"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3786372477ef457e8a9f144eb44b94ebb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026348"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026413"}], "madsrdf:hasSource": [{"@id": "_:n3786372477ef457e8a9f144eb44b94ebb5"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb6"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb7"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb8"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb9"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Linked free verse in which the authors contribute entire poems instead of stanzas of a larger poem."}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:40:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Renshi"}}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Renshi (linked poetry) is a form of collaborative poetry pioneered in the 1980s. It is a development of traditional Japanese renga and renku, but unlike these it does not adhere to traditional strictures on length, rhythm, and diction. Renshi are typically composed by a group of Japanese and foreign poets collaborating in the writing process in sessions lasting several days.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 15, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Renshi (Poetry))"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Renshi was invented by a prominent Japanese poet, Makoto \u00d4oka, in the 1970s and '80s. In 1981, he and the American poet Thomas Fitzsimmons (now living in Santa Fe) collaborated on the first international renshi. The method of renshi differs from the older linked poetry mainly in that the poets write whole short poems in modern free verse as part of a poem sequence, rather than shorter stanzas of a single long poem. Most of the rules of the older linked poetry have been abandoned in renshi, and linking is accomplished simply by taking a word or phrase from the last line of the previous poem as the title for the next.)"}, "madsrdf:citationSource": "Higginson, W.J. What is \"linked poetry?\", via WWW, July 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (renshi, a linked poem by several poets, is a new free verse form of collaborative poetry adapted from the renga and renku forms favored by many classical poets in Japan since the thirteenth century)"}, "madsrdf:citationSource": "What the kite thinks, c1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 141 (the modern version [of renga and renku], renshi, refers to linked free verse)"}, "madsrdf:citationSource": "No choice but to follow, c2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3786372477ef457e8a9f144eb44b94ebb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(One of the most exciting, dynamic forms of contemporary collaborative poetic production today is renshi or \"linked poetry\"--the modern offshoot of a far older verse form known as renga (linked songs), which was popular in medieval and early modern Japan; renshi differs from renga in that it is written in shi, which are relatively flexible in terms of content and poetic rules. Participants in a renshi session typically agree beforehand on the total number of verses and the number of lines each person will contribute per round. Each contribution should play off, but not adhere too closely to, the one that came before it)"}, "madsrdf:citationSource": "Renshi : writing without a centre, via Poetry International Rotterdam website, July 21, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026507"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026508", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRevenge tragedies", "identifiers:lccn": "gf2014026508", "madsrdf:adminMetadata": [{"@id": "_:n2a1a0e07da254302983572d3b0eaa764b1"}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Revenge tragedies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2a1a0e07da254302983572d3b0eaa764b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026576"}, "madsrdf:hasSource": [{"@id": "_:n2a1a0e07da254302983572d3b0eaa764b5"}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b6"}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b7"}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b8"}], "madsrdf:hasVariant": [{"@id": "_:n2a1a0e07da254302983572d3b0eaa764b9"}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Elizabethan tragedies that focus on a leading character's attempt to avenge the murder of a loved one, sometimes at the prompting of the victim's ghost."}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:40:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Revenge tragedies"}}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Revenge Tragedy (A form of tragedy made popular on the Elizabethan stage by Thomas Kyd, whose Spanish Tragedy is an early example of the type. The theme is the revenge of a father for a son or vice versa, the revenge being directed by the ghost of the murdered man, as in Hamlet. Other traits often found in revenge tragedies include the hesitation of the hero, the use of real or pretended insanity, suicide, intrigue, an able scheming villain, philosophic soliloquies, and the sensational use of horrors (murders on the stage, exhibition of dead bodies, and so forth).) Tragedy of Blood (An intensified form of the Revenge Tragedy popular on the Elizabethan stage. It works out the theme of revenge and retribution (borrowed from Seneca) through murder, assassination, mutilation, and carnage.)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(revenge tragedy. A kind of tragedy popular in England from the 1590s to the 1630s, following the success of Thomas Kyd's sensational play The Spanish Tragedy (c. 1589). Its action is typically centred upon a leading character's attempt to avenge the murder of a loved one, sometimes at the prompting of the victim's ghost; it involves complex intrigues and disguises, and usually some exploration of the morality of revenge. Drawing partly on precedents in Senecan tragedy, the English revenge tragedy is far more bloodthirsty in its explicit presentation of premeditated violence, and so the more gruesome examples such as Shakespeare's Titus Andronicus are sometimes called 'tragedies of blood'.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(revenge tragedy. A form of tragic drama in which someone (usually a hero or a villain) rights a wrong. It was Thomas Kyd who established the genre of revenge tragedy in England with The Spanish Tragedy (c. 1586). This play contains many of the basic features of the genre. It begins with the introduction of a ghost and with the character of Revenge. In the course of the play they function as Chorus to an elaborate intrigue in which Hieronomo seeks revenge for his murdered son. Hieronomo pretends to be mad and presents a play in dumb show at court)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Revenge Tragedy. Form of drama in which the main theme is murder and revenge. Especially identified with the sixteenth and seventeenth centuries, the revenge tragedy had its origins in classical drama, particularly in the plays of Seneca. His plays Thyestes, Medea, and Agamemnon all employ the theme of bloody deeds paid for in blood; typically retribution is exacted by a member of the murdered man's family)"}, "madsrdf:citationSource": "McGraw-Hill encyclopedia of world drama, c1972", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2a1a0e07da254302983572d3b0eaa764b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Blood, Tragedies of"}}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blood, Tragedies of"}}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2a1a0e07da254302983572d3b0eaa764b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tragedies of blood"}}, {"@id": "_:n2a1a0e07da254302983572d3b0eaa764b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tragedies of blood"}}], "@id": "/authorities/genreForms/gf2014026508"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026509", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRevolutionary poetry", "identifiers:lccn": "gf2014026509", "madsrdf:adminMetadata": [{"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b1"}, {"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Revolutionary poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b5"}, {"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b6"}, {"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b7"}, {"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that depict national or international liberation struggles."}, {"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:40:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Revolutionary poetry"}}, {"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(protest literature: Spanish American poetry today is full of protest, and one need only look at the shanty towns on the outskirts of any major city to comprehend the reasons for its popularity. Protest can take many forms, however, some of which involve an attempt to alter the situation by violent or undemocratic means. A poet's work, in this instance, may therefore be categorized as revolucionaria, insurreccionista, guerrillera or subversiva (revolutionary, insurrectionist, guerrilla, or subversive). The role of poetry in the liberation struggle itself has been a crucial one, both as a force for mobilizing a collective response to occupation and domination and as a repository for popular memory and consciousness. Often this poetry written in the context of national liberation organizations and resistance movements remains singularly unavailable to the literary institutions for two reasons: its limited production and dissemination in print, and the fact that it does not conform to conventional and canonical criteria adhered to by poets in the North)"}, "madsrdf:citationSource": "Concise encyclopedia of Latin American literature, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Introduction (these poems are written against the background of contemporary Latin American history and the global movement for change. Their context is imperialism; The poets fully recognize the existence of a larger confraternity of suffering, and their work reflects their solidarity with liberation struggles throughout the Third World and in the United States itself)"}, "madsrdf:citationSource": "Latin American revolutionary poetry, 1974:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Revolutionary poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9f8063c1b3f04831ab2a50f2d36019c4b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Georgakas, D. Z : an anthology of revolutionary poetry, 1968.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026509"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026510", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRhopalic verse", "identifiers:lccn": "gf2014026510", "madsrdf:adminMetadata": [{"@id": "_:n7dbbb63356614aef8de969db83f852ffb1"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rhopalic verse"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7dbbb63356614aef8de969db83f852ffb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n7dbbb63356614aef8de969db83f852ffb5"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb6"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb7"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb8"}], "madsrdf:hasVariant": [{"@id": "_:n7dbbb63356614aef8de969db83f852ffb9"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb12"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb15"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems in which each successive word has one more syllable than the word before."}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:40:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rhopalic verse"}}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rhopalic: having each succeeding unit in a prosodic series larger or longer than the preceding one: a : having each successive word in a line or verse longer by one syllable than its predecessor b : having successive lines of a stanza increasing in length by the addition of one element (as a syllable or metrical foot. Variants: ropalic; wedge verse: rhopalic verse)"}, "madsrdf:citationSource": "Merriam-Webster online dictionary, Nov. 2, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rhopalic describes text in which each word contains one more letter or syllable than the one preceding it. It derives from the Greek rhopalos, for a club or cudgel which, like most of its kind, is thicker towards one end than the other. It is commonly applied to poetry whose words advance each time by one syllable, or sometimes one metric foot, but it can also apply to prose. In poetry, such wordplay has also been described as snowball verse and wedge verse.)"}, "madsrdf:citationSource": "World wide words website, Nov. 2, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "English dictionary (rhopalic (poetry) describes verse in which each successive word has one more syllable than the word before)"}, "madsrdf:citationSource": "Collins dictionaries website, Nov. 2, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rhopalic verse: Verse thicker at one end than the other, by dint of each word being a syllable longer than its predecessor, or each line a foot longer. So, for example, Crashaw's Wishes to His Supposed Mistress begins: Whoe'er she be//That not impossible She//That shall command my heart and me; The first line is a dimeter, the second a trimeter, the third a tetrameter--and so the poem continues for forty-two stanzas in all.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7dbbb63356614aef8de969db83f852ffb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wedge verse"}}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wedge verse"}}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7dbbb63356614aef8de969db83f852ffb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rhopalic poetry"}}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rhopalic poetry"}}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7dbbb63356614aef8de969db83f852ffb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ropalic verse"}}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ropalic verse"}}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7dbbb63356614aef8de969db83f852ffb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Snowball verse"}}, {"@id": "_:n7dbbb63356614aef8de969db83f852ffb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Snowball verse"}}], "@id": "/authorities/genreForms/gf2014026510"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026511", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aR\u00edmur", "identifiers:lccn": "gf2014026511", "madsrdf:adminMetadata": [{"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b1"}, {"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "R\u00edmur"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026448"}, "madsrdf:hasSource": [{"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b5"}, {"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b6"}, {"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Icelandic narrative poems from the 14-19th centuries that were generally written in alliterative four-line stanzas."}, {"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:07:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "R\u00edmur"}}, {"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(r\u00edmur: A form of Icelandic metrical romance which originated in the 14th century. They were narrative poems based on heroic tales and composed, for the most part, in alliterative four-line stanzas. They were complex in meter and the kenning occurs frequently.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, c1998", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rimur: singular rima.Versified sagas, or episodes from sagas, a form of adaptation that was popular in Iceland from the 15th century, One of three early genres of popular early Icelandic poetry (the other two being dances and ballads), rimur were produced from the 14th to the 19th century. Originally used for dancing, they combine an end-rhymed metrical form derived from Latin hymns with the techniques of syllable counting, alliteration, and internal rhyme used by the earlier Norse court poets, the skalds. Most rimur are long narratives based on native tradition or foreign romances. Often a long prose cycle was converted into a rimur cycle.)"}, "madsrdf:citationSource": "Merriam-Webster's encyclopedia of literature, c1995", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd275e126a1143e6bb109052ab9a94e5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(R\u00edmur (pl.; singular: r\u00edma). A form of stanzaic narrative poetry, cognate ME rime, surviving from the mid-14th century. R\u00edmur are Icelandic poems in multiple fits, a r\u00edma having only one. The four-line Latin hymn stanza was adapted to include alliteration and the complicated poetic vocabulary of kenning and heiti borrowed from skaldic poetry)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026511"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026512", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRitterdrama", "identifiers:lccn": "gf2014026512", "madsrdf:adminMetadata": [{"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b1"}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ritterdrama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026369"}, "madsrdf:hasSource": [{"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b5"}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b6"}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b7"}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b8"}], "madsrdf:hasVariant": [{"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b9"}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "German historical plays from the 18th-19th centuries that depict the valor of medieval knights in scenes of battle, jousting, and pageantry."}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:07:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ritterdrama"}}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ritterdrama, offshoot of the Sturm und Drang drama, in which the valour of medieval knights was displayed in scenes of battle, jousting, and pageantry, often with a marked vein of Bavarian local patriotism. Written in prose and irregular in form, this 'feudal drama', had as its theme strong passions and contempt for the conventions and fostered the taste for romantic and medieval settings kindled by Goethe's G\u00f6tz von Berlichingen (1773) and Klinger's Otto (1774))"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ritterdrama. Drama of the late 18th century, about the age of chivalry, based on Goethe's G\u00f6tz von Berlichingen (1773) and in prose. Examples of Ritterdrama: Klinger's Otto (1774), T\u00f6rring's Agnes Bernauerin (1780) and Kaspar der Thorringer (1785), and Babo's Otto von Wittelsbach (1782). See Historisches Drama (Historical drama))"}, "madsrdf:citationSource": "Kosch, W. Deutsches Theater-Lexikon, 1953-2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ritterdrama (German: knight drama) In late 18th-century German theater, a genre of historical drama that depicted the heroic days of medieval knights. It derived from the Sturm und Drang movement, taking its romantic and patriotic themes from the historical plays of Goethe and Klinger. With its staging of battles, jousting, and other pageantry, the genre established new standards for historical realism in settings and costumes)"}, "madsrdf:citationSource": "Dictionary central website, May 14, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ritterdrama. Synonym: Ritterspiel. Drama in which the protagonist is a knight, for example, B.P. Corneille's \"Le Cid\" (1637). In a more narrow sense, used for dramas from late 18th/early 19th century, whose authors were influenced by the new reception of the Middle Ages in the Sturm und Drang movement and by Romanticism, and whose plot and characters derive from knighthood)"}, "madsrdf:citationSource": "Universal-Lexicon website, May 14, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ritterspiele"}}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ritterspiele"}}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ritterspiels"}}, {"@id": "_:n53d4e19d9a384f50991cd5c725d101a2b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ritterspiels"}}], "@id": "/authorities/genreForms/gf2014026512"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026513", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRoad fiction", "identifiers:lccn": "gf2014026513", "madsrdf:adminMetadata": [{"@id": "_:n4fe206e20ab14bcc8b32950367a4953ab1"}, {"@id": "_:n4fe206e20ab14bcc8b32950367a4953ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Road fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4fe206e20ab14bcc8b32950367a4953ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n4fe206e20ab14bcc8b32950367a4953ab5"}, {"@id": "_:n4fe206e20ab14bcc8b32950367a4953ab6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction in which a life-changing journey is a central part of the action."}, {"@id": "_:n4fe206e20ab14bcc8b32950367a4953ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4fe206e20ab14bcc8b32950367a4953ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:41:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4fe206e20ab14bcc8b32950367a4953ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Road fiction"}}, {"@id": "_:n4fe206e20ab14bcc8b32950367a4953ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Road fiction. Use for works in which a journey, as a life-changing experience, is a central part of the action.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fe206e20ab14bcc8b32950367a4953ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: Fast cars and bad girls : nomadic subjects and women's road stories; The road novels of Jack Kerouac; Journeys of the center : a migration through three contemporary American women's road novels)"}, "madsrdf:citationSource": "OCLC, Jan. 3, 2013", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026513"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026514", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRobinsonades", "identifiers:lccn": "gf2014026514", "madsrdf:adminMetadata": [{"@id": "_:n4203108175a5433d96dfda5a721aa415b1"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Robinsonades"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4203108175a5433d96dfda5a721aa415b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026013"}, "madsrdf:hasSource": [{"@id": "_:n4203108175a5433d96dfda5a721aa415b5"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b6"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b7"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b8"}], "madsrdf:hasVariant": [{"@id": "_:n4203108175a5433d96dfda5a721aa415b9"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b12"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction about survival without the aid of civilization, frequently on a deserted island after a shipwreck or marooning."}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-02-22T14:17:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Robinsonades"}}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the term \"Robinsonades\" is used to describe literary works about survival without the aid of civilization, frequently on a deserted island; typically the protagonist is suddenly isolated from the comforts of civilization, usually shipwrecked or marooned on a secluded and uninhabited island)"}, "madsrdf:citationSource": "Daniel Defoe's Robinson Crusoe & the robinsonades, via WWW, Nov. 7, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Robinsonades. Use for works describing an individual's or a small group's survival without the aid of civilization, as on a deserted island. BT Adventure fiction; Voyages, Imaginary)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(desert island fiction: a form of fiction in which a remote and \"uncivilized\" island is used as the venue of the story and action; the publication of Defoe's Robinson Crusoe in 1719 marked the inception of a literary genre which has attained universal popularity. In France desert island stories came to be known as Robinsonnades; in Germany as Robinsonaden; Robinsonade: The German term for stories which derived from Defoe's ever popular The Life and Strange and Surprising Adventures of Robinson Crusoe (1719). The first German translation appeared the following year and there were numerous imitations. See desert island fiction)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(robinsonade: term applied to novels of shipwreck and survival deriving from Defoe's The life and strange adventures of Robinson Crusoe)"}, "madsrdf:citationSource": "Oxford companion to German literature, via Oxford reference online, Nov. 7, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4203108175a5433d96dfda5a721aa415b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Robinsonnades"}}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Robinsonnades"}}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4203108175a5433d96dfda5a721aa415b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Desert island fiction"}}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Desert island fiction"}}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4203108175a5433d96dfda5a721aa415b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Robinsonaden"}}, {"@id": "_:n4203108175a5433d96dfda5a721aa415b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Robinsonaden"}}], "@id": "/authorities/genreForms/gf2014026514"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026515", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRomance comics", "identifiers:lccn": "gf2014026515", "madsrdf:adminMetadata": [{"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b1"}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Romance comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b5"}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b6"}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b7"}], "madsrdf:hasVariant": [{"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b8"}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that primarily depict romantic love."}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:42:07"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romance comics"}}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Romance comics (sometimes love comics) is a comics genre depicting romantic love and its attendant complications such as jealousy, marriage, divorce, betrayal, and heartache.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 418 (Romance. Stories dealing with the love, confusion, heartache, hilarity, and ups-and-downs of teenage and young adult romance. Romance comic books have a long-standing history in the U.S., from their inception in the 1940s through their decline in the 1970s. Like most teen romance fiction as well as adult romance, the focus in a graphic novel romance title is the blossoming relationship between two individuals. Romance knows no boundaries, so titles may include off-beat couples, same-sex couples, faraway settings, and even a heavy helping of comedy; several subgenres of romance, including romantic comedy and romantic fantasy)"}, "madsrdf:citationSource": "Pawuk, M. Graphic novels : a genre guide to comic books, manga, and more, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 172 (Romance Graphic Novels)"}, "madsrdf:citationSource": "Fletcher-Spear, K. Library collections for teens : manga and graphic novels, c2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romantic comics"}}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romantic comics"}}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Love comics"}}, {"@id": "_:n7dbcedc14887434c8cc935b7d6fd6f59b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Love comics"}}], "@id": "/authorities/genreForms/gf2014026515"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026516", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRomance fiction", "identifiers:lccn": "gf2014026516", "madsrdf:adminMetadata": [{"@id": "_:n0ab2067996c7466bb256193b462c5cbbb1"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Romance fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0ab2067996c7466bb256193b462c5cbbb3"}]}, "madsrdf:exampleNote": "Note under [Romances]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026063"}, "madsrdf:hasSource": [{"@id": "_:n0ab2067996c7466bb256193b462c5cbbb5"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb6"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb7"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb8"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb9"}], "madsrdf:hasVariant": [{"@id": "_:n0ab2067996c7466bb256193b462c5cbbb10"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb13"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that primarily depicts romantic love. For medieval chivalric tales written in prose or poetry that depict an idealized code of civilized behavior that combines loyalty, honor, and courtly love see [Romances.]"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:23:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romance fiction"}}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Love stories. Use for works dealing primarily with romantic love. UF Romance fiction, Romances (Love stories). RT Erotic fiction, Gothic fiction, Romantic suspense fiction)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 (the term \"romance,\" as it is used today, has a much more specific meaning and refers to a particular kind of fiction--the love story; Certain criteria must be met before a love story can qualify as a proper romance, at least by today's standards. To begin with, there is the matter of focus. In a romance the central (and occasionally the only) focus of the plot is the love relationship between the two main characters; Another criterion for romance fiction is the Satisfactory Ending. Usually, but not always, this is the traditional happy one, with the two protagonists forming some kind of committed relationship (usually marriage) by the book's conclusion) p. 5 (for the purposes of this guide, a romance is defined as a love story in which the central focus is on the development and satisfactory resolution of the love relationship between the two main characters, written in such a way as to provide the reader with some degree of vicarious emotional participation in the courtship process)"}, "madsrdf:citationSource": "Ramsdell, K. Romance fiction : a guide to the genre, 1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Love stories. UF Romances (Love stories), Romantic fiction (Love stories). Here are entered works of fiction dealing with romantic love. Works of fiction belonging to the Romance languages group are entered under Romance fiction.)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(number of books tagged with term: Romance, 100000 [max.]; Romance-novels, 7093; Romance-fiction, 3085; Romantic-fiction, 3675; Love, 27541; Love-stories, 10982; Love-fiction, 44; Love-novels, 26)"}, "madsrdf:citationSource": "Goodreads website, Apr. 16, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 253 (Romance novels celebrate the emotional development of a love relationship. While mystery is moved by plot and horror by conflict, the action of the romance novel is internal. A man and a woman must come to admit that they love each other and form a pair bond. Beyond that focus, there may be any number of obstacles that interfere with the admission of love, and these may comprise a significant plot, but the theme of the romance novel is one of emotion.)"}, "madsrdf:citationSource": "Herald. D. Genreflecting, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ab2067996c7466bb256193b462c5cbbb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romantic fiction"}}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romantic fiction"}}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ab2067996c7466bb256193b462c5cbbb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Love stories"}}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Love stories"}}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ab2067996c7466bb256193b462c5cbbb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romances (Love stories)"}}, {"@id": "_:n0ab2067996c7466bb256193b462c5cbbb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romances (Love stories)"}}], "@id": "/authorities/genreForms/gf2014026516"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026517", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRomances", "identifiers:lccn": "gf2014026517", "madsrdf:adminMetadata": [{"@id": "_:n91c03946a3984836bc111ade59366e7bb1"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Romances"}, "madsrdf:elementList": {"@list": [{"@id": "_:n91c03946a3984836bc111ade59366e7bb3"}]}, "madsrdf:exampleNote": "Note under [Romance fiction]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026227"}, "madsrdf:hasSource": [{"@id": "_:n91c03946a3984836bc111ade59366e7bb5"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb6"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb7"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb8"}], "madsrdf:hasVariant": [{"@id": "_:n91c03946a3984836bc111ade59366e7bb9"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb12"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb15"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Medieval chivalric tales written in prose or poetry that depict an idealized code of civilized behavior that combines loyalty, honor, and courtly love. For fiction that primarily depicts romantic love see [Romance fiction.]"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:23:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romances"}}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "romance (A fictional story in verse or prose that relates improbable adventures of idealized characters in some remote or enchanted setting; or, more generally, a tendency in fiction opposite to that of realism. The term now embraces many forms of fiction from the Gothic novel and the popular escapist love story (also known popularly as romances) to the 'scientific romances' of H.G. Wells, but it usually refers to the tales of King Arthur's knights written in the late Middle Ages by Chr\u00e9tien de Troyes (in verse), Sir Thomas Malory (in prose), and many others (see Arthurian literature, chivalric romance). Medieval romance is distinguished from epic by its concentration on courtly love rather than warlike heroism.) chivalric romance (The principal kind of romance found in medieval Europe from the 12 century onwards, describing (usually in verse) the adventures of legendary knights, and celebrating an idealized code of civilized behaviour that combines loyalty, honour, and courtly love. The emphasis on heterosexual love and courtly manners distinguishes it from the chanson de geste and other kinds of epic, in which masculine military heroism predominates.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(romance: Term used in English-language criticism of French literature for the roman courtois, or courtly romance, a narrative genre that flourished in the 12th and 13th c., first in verse and then in prose, and continued in various transformations throughout the Middle Ages; as contrasted with the epic, or chanson de geste, romance focused on the inner dilemma or quest of an individual knight, highlighted sentimental and chivalric education and the conflict of knightly duty with private desire)"}, "madsrdf:citationSource": "The new Oxford companion to literature in French, via Oxford reference online, Nov. 8, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Romances. Use for medieval tales, which embody the life and adventures of a hero of chivalry. For contemporary novels, use Love stories or Romantic suspense fiction. NT Arthurian romances. RT Epic poetry; Fables; Legends)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Romance. In broad terms, romance is a narrative that employs exotic adventure and lofty emotion rather than realistic depiction of character and action. In the romance people, ideas, and events are depicted in fanciful, idealized ways--heroes are very brave, villains are very villainous, beliefs and feelings are all-powerful--and plots incorporate mysterious figures and extraordinary forces. Romance originated in medieval tales in both prose and verse such as those based on Arthurian legends, stories that presented chivalric tales of kings, knights, ladies, and the passions that overcome them. Love (both licit and illicit) is the central motivation, and how characters respond to it is the central conflict; medieval romances)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n91c03946a3984836bc111ade59366e7bb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romans courtois"}}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romans courtois"}}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n91c03946a3984836bc111ade59366e7bb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Courtly romances"}}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Courtly romances"}}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n91c03946a3984836bc111ade59366e7bb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chivalric romances"}}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chivalric romances"}}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n91c03946a3984836bc111ade59366e7bb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Medieval romances"}}, {"@id": "_:n91c03946a3984836bc111ade59366e7bb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Medieval romances"}}], "@id": "/authorities/genreForms/gf2014026517"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026518", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRomans \u00e0 clef", "identifiers:lccn": "gf2014026518", "madsrdf:adminMetadata": [{"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb1"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Romans \u00e0 clef"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb3"}]}, "madsrdf:exampleNote": "Note under [Biographical fiction]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb5"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb6"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb7"}], "madsrdf:hasVariant": [{"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb8"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb11"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb14"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction in which real persons, places, or events are depicted under invented names. For fiction that depicts the lives of real people see [Biographical fiction.]"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-03T08:31:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romans \u00e0 clef"}}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(roman \u00e0 clef, novel that has the extraliterary interest of portraying well-known real people more or less thinly disguised as fictional characters)"}, "madsrdf:citationSource": "Britannica online academic edition, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(livre \u00e0 clef (F 'book with a key') Also known as a roman \u00e0 clef, in English as a key novel and in German as a Schl\u00fcsselroman. Usually a work of fiction in which actual persons are presented under fictitious names. The genre developed in 17th c. France; Somerset Maugham wrote several livres \u00e0 clef)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(roman \u00e0 clef: French, \"novel with a key,\" also called livre \u00e0 clef, \"book with a key\"; a narrative that represents actual historical characters and events in the form of fiction; readers in the know would recognize the real figures but typically the explanatory \"keys\" would be published later; also known in English as a key-novel)"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, Nov. 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Key novels"}}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Key novels"}}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Schl\u00fcsselromans"}}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Schl\u00fcsselromans"}}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Livres \u00e0 clef"}}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Livres \u00e0 clef"}}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Schl\u00fcsselromane"}}, {"@id": "_:nd9b4f21c33954886ad6c3d95cb1563afb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Schl\u00fcsselromane"}}], "@id": "/authorities/genreForms/gf2014026518"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026519", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRomantic plays", "identifiers:lccn": "gf2014026519", "madsrdf:adminMetadata": [{"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db1"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Romantic plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db5"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db6"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db7"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db8"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db9"}], "madsrdf:hasVariant": [{"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db10"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db13"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db16"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that primarily depict romantic love."}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:43:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romantic plays"}}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (The conflicts in dramas of the romantic type ... arise principally from the troubled course of profound and passionate love.) p. 227 (love plays) p. 335 (Cyrano de Bergerac is easily the outstanding romantic play of our age)"}, "madsrdf:citationSource": "Types of romantic drama, 1928:", "madsrdf:citationStatus": "found"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lewis, J.W. Saint Agnes' eve : a romantic play in one act, 1937.", "madsrdf:citationStatus": "found"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db7", "@type": "madsrdf:Source", "madsrdf:citationSource": "St. Clair, R. The final triumph : a romantic drama in three acts, c1938.", "madsrdf:citationStatus": "found"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wesker, A. Arnold Wesker's love plays, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yao, C.S. Cai-zi jia-ren : love drama during the Yuan, Ming, and Qing periods, 1982.", "madsrdf:citationStatus": "found"}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Love drama"}}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Love drama"}}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romantic drama"}}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romantic drama"}}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romance drama"}}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romance drama"}}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romances (Drama)"}}, {"@id": "_:naeb7d370607c41f3aa983ddf66a09e9db20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romances (Drama)"}}], "@id": "/authorities/genreForms/gf2014026519"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026520", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRondeaux", "identifiers:lccn": "gf2014026520", "madsrdf:adminMetadata": [{"@id": "_:nb4deeed157494946835b1e12b03cd5b9b1"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rondeaux"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb4deeed157494946835b1e12b03cd5b9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nb4deeed157494946835b1e12b03cd5b9b5"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b6"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b7"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b8"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b9"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b10"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b11"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b12"}], "madsrdf:hasVariant": [{"@id": "_:nb4deeed157494946835b1e12b03cd5b9b13"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that generally consist of 15 lines arranged in two or three stanzas that employ two rhymes and a refrain consisting of the opening words of the first line in the first stanza."}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-31T10:15:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rondeaux"}}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rondeau: a special form of the rondel written in syllabic meter consisting of 15 lines (sometimes fewer) set down in a quintain (aabba), a quatrain (aabR) and a sestet (aabbaR). The entire poem rests on one refrain which appears twice and echoes, in part or whole, the first line, and two rhymes)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rondeau, pl. rondeaux)"}, "madsrdf:citationSource": "The American heritage dictionary of the English language, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetic Form: Rondeau; rondeaus)"}, "madsrdf:citationSource": "Poets.org, viewed Dec. 26, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rondeau: The form by which we know the rondeau today emerged in the 15th c. and by the beginning of the 16th c. had displaced all competitors. The poem is constructed on two rhymes only with lines of eight or ten syllables, and the first word or phrase of the first line is used as a refrain; this curtailed, repeating line, called the rentrement, usually does not rhyme. Traditional lengths for the rondeau are 12 or 15 lines (if the two brief rentrements are not considered lines, 10 or 13) printed in two or three stanza)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rondeau; one of the French fixed forms, related to the earlier rondel and the triolet; all three are variations of the same genre, and the rondel and rondeau have, at times, been synonymous; Around 1500, the rondeau form became fixed as a thirteen-line poem, with lines of eight or ten syllables each, divided into stanzas of five, three, and five lines. The whole poem is constructed around two rhymes, and the first words (or sometimes the whole first line) are used as a refrain that repeats, independent of the rhyme scheme, at the end of the second and third stanzas (adding two lines to the basic thirteen).)"}, "madsrdf:citationSource": "The Teachers & Writers handbook of poetic forms, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(roundel: 4. a. Archaic a rondeau b. an English variation of the rondeau, with eleven lines (three stanzas), the fourth and eleventh being the refrain)"}, "madsrdf:citationSource": "Collins English dictionary, via WWW, May 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rondeau, plural rondeaux. 1 a : a fixed form of verse based on two rhyme sounds and consisting usually of 13 lines in three stanzas with the opening words of the first line of the first stanza used as an independent refrain after the second and third stanzas; b : a poem in this form.)"}, "madsrdf:citationSource": "Merriam-Webster online, July 23, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Roundel. In the Middle Ages, this term was simply a synonym for the rondeau or the rondel--e.g., Chaucer, \"Knight's Tale\" (1529). But in its mod. sense, the term usually refers to the variant form introduced by A. C. Swinburne in his A Century of Roundels (1883). The Swinburne roundel is a three-stanza, two-rhyme poem of 11 lines on the pattern abaR bab abaR where R stands for the rentrement . The rentrement, as in the rondeau, is a shortened line--a word or phrase--that repeats in the manner of a refrain; in the Swinburne roundel, the rentrement normally rhymes with the b lines of the poem)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4deeed157494946835b1e12b03cd5b9b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rondeaus"}}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rondeaus"}}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4deeed157494946835b1e12b03cd5b9b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Roundels (Rondeaux)"}}, {"@id": "_:nb4deeed157494946835b1e12b03cd5b9b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Roundels (Rondeaux)"}}], "@id": "/authorities/genreForms/gf2014026520"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026521", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRondels", "identifiers:lccn": "gf2014026521", "madsrdf:adminMetadata": [{"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b1"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rondels"}, "madsrdf:elementList": {"@list": [{"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b5"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b6"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b7"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b8"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b9"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b10"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b11"}], "madsrdf:hasVariant": {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that consist of 13 or 14 lines arranged in two or three stanzas that employ two rhymes and a two-line refrain."}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-31T10:15:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rondels"}}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rondel: consists of 13 lines (a rondel prime has 14 lines) in two quatrains and a final quintet. The meter and rhyme are not fixed, but the poem turns on two rhymes and two refrain lines: the first and second lines reappear as seven and eight, and the last line mirrors the first line (ABba, abAB, and abbaA))"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(roundel 2a : rondel sense 2a; b : an English modified rondeau)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, May 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rondel 2 a : a fixed form of verse based on two rhyme sounds and consisting usually of 14 lines in three stanzas in which the first two lines of the first stanza are repeated as the refrain of the second and third stanzas; b : a poem in this form; c : rondeau 1)"}, "madsrdf:citationSource": "Merriam-Webster online, July 23, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 178 (Rondel: Originally two stanzas of four and five lines, but later changed to three stanzas making thirteen or fourteen lines in all. The first two lines recur after the sixth line. This form was popular as early as the fourteenth century, but later gave way to the rondeau)"}, "madsrdf:citationSource": "Yelland, H.L. Handbook of literary terms, 1980:", "madsrdf:citationStatus": "found"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rondel. A French fixed form of considerable antiquity and known from the 13th c. In its earliest form it appears to have been an eight-line poem rhyming AB aA ab AB (A and B represent repeated lines). The most usual rondel form consisted of three stanzas working on two rhymes, thus: ABba abAB abba (B); a thirteen line poem in which the refrain came twice in the first eight lines and the opening line was repeated as the last line. If it was fourteen lines, the refrain was repeated three times)"}, "madsrdf:citationSource": "Cuddon, J. Dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rondel; form with two rhymes, three stanzas, and a two-line refrain that repeats either two and a half or three times: ABba abAB abbaA(B))"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Roundel. In the Middle Ages, this term was simply a synonym for the rondeau or the rondel--e.g., Chaucer, \"Knight's Tale\" (1529). But in its mod. sense, the term usually refers to the variant form introduced by A. C. Swinburne in his A Century of Roundels (1883). The Swinburne roundel is a three-stanza, two-rhyme poem of 11 lines on the pattern abaR bab abaR where R stands for the rentrement . The rentrement, as in the rondeau, is a shortened line--a word or phrase--that repeats in the manner of a refrain; in the Swinburne roundel, the rentrement normally rhymes with the b lines of the poem)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012", "madsrdf:citationStatus": "found"}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Roundels (Rondels)"}}, {"@id": "_:n176c32a913a040d3a0aafa14cb701ca1b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Roundels (Rondels)"}}], "@id": "/authorities/genreForms/gf2014026521"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026522", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSagas", "identifiers:lccn": "gf2014026522", "madsrdf:adminMetadata": [{"@id": "_:n4b6a4c83ce624285a5cfd0f2a7e06250b1"}, {"@id": "_:n4b6a4c83ce624285a5cfd0f2a7e06250b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sagas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4b6a4c83ce624285a5cfd0f2a7e06250b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasSource": [{"@id": "_:n4b6a4c83ce624285a5cfd0f2a7e06250b5"}, {"@id": "_:n4b6a4c83ce624285a5cfd0f2a7e06250b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Icelandic and Scandanavian prose narratives of the 12th-14th centuries."}, {"@id": "_:n4b6a4c83ce624285a5cfd0f2a7e06250b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4b6a4c83ce624285a5cfd0f2a7e06250b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:06:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4b6a4c83ce624285a5cfd0f2a7e06250b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sagas"}}, {"@id": "_:n4b6a4c83ce624285a5cfd0f2a7e06250b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sagas: prose narratives composed in Iceland from the 12th to the 14th centuries on classical and hagiographical Latin models and written in a style characterized by rapidity, applied realism, the art of litotes, rigour of composition and a dynamism obtained by great economy of means; categories include: historical kings' sagas (konungas\u00f6gur); the so-called Icelandic sagas (\u00cdslendingas\u00f6gur); contemporary sagas chronicling events contemporary with their authors (samt\u00eddars\u00f6gur); and legendary sagas (fornaldars\u00f6gur))"}, "madsrdf:citationSource": "Encyclopedia of the Middle Ages, via Oxford reference online, Nov. 6, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b6a4c83ce624285a5cfd0f2a7e06250b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Saga: The word comes from the Old Norse term for a \"saw\" or a \"saying.\" Sagas are Scandinavian and Icelandic prose narratives about famous historical heroes, notable families, or the exploits of kings and warriors. Until the 12th century, most sagas were folklore, and they passed from person to person by oral transmission. Thereafter, scribes wrote them down; in common usage, the term saga has been erroneously applied to any exciting, long narrative. See cycle and epic)"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, Jan. 3, 2013", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026522"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026523", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSapphics", "identifiers:lccn": "gf2014026523", "madsrdf:adminMetadata": [{"@id": "_:n998aa3860c254d54a669bfcad401fca6b1"}, {"@id": "_:n998aa3860c254d54a669bfcad401fca6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sapphics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n998aa3860c254d54a669bfcad401fca6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026497"}, "madsrdf:hasSource": [{"@id": "_:n998aa3860c254d54a669bfcad401fca6b5"}, {"@id": "_:n998aa3860c254d54a669bfcad401fca6b6"}], "madsrdf:hasVariant": {"@id": "_:n998aa3860c254d54a669bfcad401fca6b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry written in the style of the poet Sappho."}, {"@id": "_:n998aa3860c254d54a669bfcad401fca6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:44:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n998aa3860c254d54a669bfcad401fca6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n998aa3860c254d54a669bfcad401fca6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sapphics"}}, {"@id": "_:n998aa3860c254d54a669bfcad401fca6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sapphic: the meter and stanzaic forms of the greek poetess of Lesbos, Sappho. The S. stanza consists of three lesser Sapphics, 11-syllable lines with a dactyl in the third foot, followed by an adonic)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n998aa3860c254d54a669bfcad401fca6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetic Form: Sapphic--The sapphic dates back to ancient Greece and is named for the poet Sappho, who left behind many poem fragments written in an unmistakable meter. Sapphics are made up of any number of four-line stanzas, and many Greek and Roman poets, including Catullus, used the form. The main building blocks of the sapphic are trochees and dactyls. The trochee is a metrical foot with one stressed syllable followed by an unstressed one, while the dactyl contains a stressed syllable followed by two unstressed ones. The first three lines of the sapphic contain two trochees, a dactyl, and then two more trochees. The shorter fourth, and final, line of the stanza is called an \"Adonic\" and is composed of one dactyl followed by a trochee)"}, "madsrdf:citationSource": "Poets.org, viewed Dec. 26, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n998aa3860c254d54a669bfcad401fca6b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n998aa3860c254d54a669bfcad401fca6b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sapphic poetry"}}, {"@id": "_:n998aa3860c254d54a669bfcad401fca6b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sapphic poetry"}}], "@id": "/authorities/genreForms/gf2014026523"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026524", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSas\u014fl sijo", "identifiers:lccn": "gf2014026524", "madsrdf:adminMetadata": [{"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b1"}, {"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sas\u014fl sijo"}, "madsrdf:elementList": {"@list": [{"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026544"}], "madsrdf:hasSource": [{"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b5"}, {"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b6"}], "madsrdf:hasVariant": {"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Humorous Korean poetry that employs colloquial speech and onamatopoea, and expands the traditional sijo into a three-stanza poem."}, {"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:10:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sas\u014fl sijo"}}, {"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 221-227 (Sasol sijo is a form in which more than two metric segments in each line, except for the first in the third line, are added. In effect, a three-line song has become a three-stanza song. The form is also called chang sijo (long sijo); the term sasol meant \"close-stitched\" or \"closely set.\" A typical sasol sijo draws from colloquial speech, including taboo words and puns. A favorite rhetorical tactic is to begin the song with a series of similes and mention the real subject of comparison only at the end.)"}, "madsrdf:citationSource": "Lee, Peter H. A history of Korean literature, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 672 (The sijo, the most popular, elastic, and mnemonic of poetic forms, is a 3-line poem. The sijo meter is formed by ordered sequence of metric segments comprising syllables within a set range. Each line consists of four syllable groups, with minor pause occurring at the end of the second group and a major at the end of the fourth. Any subject is permissible, but favored ones include praise of virtue, complain of desertion, fear of death, the beauty of friendship, and the simplicity of rural life. A long form called sasol sijo, evolved in the later part of the dynasty. Written mainly by commoners, it marked especially by onomatopoeia, a tendency to catalogue, striking imagery, and a bold twist at the end. It is frank and humorous, often satirical and running to burlesque, and explores the resources of the vernacular)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chang sijo"}}, {"@id": "_:n686deb4591a040488cfb8a0742e1d9f6b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chang sijo"}}], "@id": "/authorities/genreForms/gf2014026524"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026525", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSatirical literature", "identifiers:lccn": "gf2014026525", "madsrdf:adminMetadata": [{"@id": "_:n81446685efd84b369169654d5703d06ab1"}, {"@id": "_:n81446685efd84b369169654d5703d06ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Satirical literature"}, "madsrdf:elementList": {"@list": [{"@id": "_:n81446685efd84b369169654d5703d06ab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026437"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026036"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026038"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026071"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026105"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026106"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026077"}], "madsrdf:hasSource": [{"@id": "_:n81446685efd84b369169654d5703d06ab5"}, {"@id": "_:n81446685efd84b369169654d5703d06ab6"}], "madsrdf:hasVariant": [{"@id": "_:n81446685efd84b369169654d5703d06ab7"}, {"@id": "_:n81446685efd84b369169654d5703d06ab10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026115"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026133"}]}, {"@id": "_:n81446685efd84b369169654d5703d06ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n81446685efd84b369169654d5703d06ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-02-22T14:17:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n81446685efd84b369169654d5703d06ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical literature"}}, {"@id": "_:n81446685efd84b369169654d5703d06ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(satire. A mode of writing that exposes the failings of individuals, institutions, or societies to ridicule and scorn. Satire is often an incidental element in literary works that may not be wholly satirical, especially in comedy. Its tone may vary from tolerant amusement, as in the verse satires of Horace, to bitter indignation, as in the verse of Juvenal and the prose of Jonathan Swift. Various forms of literature may be satirical, from the plays of Ben Jonson or of Moli\u00e8re and the poetry of Chaucer or Byron to the prose writings of Rabelais and Voltaire.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n81446685efd84b369169654d5703d06ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(satire. A type of literature that aims to ridicule folly or vice in a society, an institution, or an individual. Satire uses laughter as a weapon against any target that the satirist considers silly, stupid, or vicious. As such it is an attack, but an attack ameliorated by the element of play. The aim is to be entertaining as well as censorious, to create fun by poking fun. Satiric passages enhance and enliven many plays, poems, and novels that are not themselves satires, but there are also outstanding examples of works that are pure satires.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n81446685efd84b369169654d5703d06ab7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n81446685efd84b369169654d5703d06ab8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric literature"}}, {"@id": "_:n81446685efd84b369169654d5703d06ab8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric literature"}}, {"@id": "_:n81446685efd84b369169654d5703d06ab10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n81446685efd84b369169654d5703d06ab11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satires (Literature)"}}, {"@id": "_:n81446685efd84b369169654d5703d06ab11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satires (Literature)"}}], "@id": "/authorities/genreForms/gf2014026525"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026526", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSatyr plays", "identifiers:lccn": "gf2014026526", "madsrdf:adminMetadata": [{"@id": "_:n308970b3198545aeb13f2df0368a0dcdb1"}, {"@id": "_:n308970b3198545aeb13f2df0368a0dcdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Satyr plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n308970b3198545aeb13f2df0368a0dcdb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026237"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026254"}], "madsrdf:hasSource": [{"@id": "_:n308970b3198545aeb13f2df0368a0dcdb5"}, {"@id": "_:n308970b3198545aeb13f2df0368a0dcdb6"}], "madsrdf:hasVariant": {"@id": "_:n308970b3198545aeb13f2df0368a0dcdb7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Ancient Greek plays featuring a chorus of satyrs and mythical subject matter that provided comic relief after a trio of tragedies."}, {"@id": "_:n308970b3198545aeb13f2df0368a0dcdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T10:19:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n308970b3198545aeb13f2df0368a0dcdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n308970b3198545aeb13f2df0368a0dcdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satyr plays"}}, {"@id": "_:n308970b3198545aeb13f2df0368a0dcdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Satyr Play. The fourth and final play in the bill of tragedies in Greek drama: so called because the chorus was made up of horse-tailed goat-men called satyrs. The satyr play was intended to bring comic relief after the three tragedies that preceded it. It had the structure of a tragedy and subject matter from serious mythology but was grotesquely comic in manner. Thornton Wilder wrote a modern satyr play, The Drunken Sisters.)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n308970b3198545aeb13f2df0368a0dcdb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(satyr play (satyric drama) A humorous performance presented in Athenian dramatic contests, following a trilogy of tragedies. The satyr play had a chorus of satyrs (men with horses' tails and ears), and its action was a burlesque of some mythical story appropriate to the foregoing tragedies, involving obscene language and gestures. Although fragments of satyr plays by Aeschylus and Sophocles have been found, the only complete example to have survived is the Cyclops (c.412 BCE) of Euripides. Tony Harrison's The Trackers of Oxyrhynchus (1988) is a modern satyr play adapted from the fragmentary Ichneutae of Sophocles.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n308970b3198545aeb13f2df0368a0dcdb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n308970b3198545aeb13f2df0368a0dcdb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satyric drama"}}, {"@id": "_:n308970b3198545aeb13f2df0368a0dcdb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satyric drama"}}], "@id": "/authorities/genreForms/gf2014026526"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026527", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSkaldic poetry", "identifiers:lccn": "gf2014026527", "madsrdf:adminMetadata": [{"@id": "_:n104aa0ea15ba48e689332b1f27112f94b1"}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Skaldic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n104aa0ea15ba48e689332b1f27112f94b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n104aa0ea15ba48e689332b1f27112f94b5"}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b6"}], "madsrdf:hasVariant": [{"@id": "_:n104aa0ea15ba48e689332b1f27112f94b7"}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Medieval Scandinavian and Icelandic court poetry."}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:49:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skaldic poetry"}}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(skaldic poetry, skaldic also spelled Scaldic, oral court poetry originating in Norway but developed chiefly by Icelandic poets (skalds) from the 9th to the 13th century. Skaldic poetry was contemporary with Eddaic poetry but differed from it in metre, diction, and style. Eddaic poetry is anonymous, simple, and terse, often taking the form of an objective dramatic dialogue. Skalds were identified by name; their poems were descriptive and subjective; their metres were strictly syllabic instead of free and variable; and their language was ornamented with heiti and kennings. Heiti (\"names\") are uncompounded poetic nouns, fanciful art words rather than everyday terms; e.g., \"brand\" for \"sword,\" or \"steed\" for \"horse.\" Kennings are metaphorical circumlocutions such as \"sword liquid\" for \"blood\" or \"wave-horse\" for \"ship.\")"}, "madsrdf:citationSource": "Encyclop\u00e6dia Britannica online, Jan. 8, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Skaldic verse: Skalds were the minstrels or court poets of Scandinavia who flourished from the late ninth to the eleventh centuries. Skaldic verse is a very artistic type of Old Norse poetry. Poetry of this genre is usually marked by intricate meter, alliteration, and diction. Works of this nature are usually constructed in a format called the \"dr\u00f3ttkvaett.\" Each strophe contains eight six-syllable lines; the lines are alliterated on stressed syllables in the even lines and the odd lines contain two alternating syllables in stressed positions. Additionally, the odd lines contain half-rhymes. The diction of these works is full of kennings and far reaching metaphors.)"}, "madsrdf:citationSource": "New Princeton encyclopedia of poetry and poetics, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n104aa0ea15ba48e689332b1f27112f94b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Skaldic verse"}}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skaldic verse"}}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n104aa0ea15ba48e689332b1f27112f94b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scaldic poetry"}}, {"@id": "_:n104aa0ea15ba48e689332b1f27112f94b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scaldic poetry"}}], "@id": "/authorities/genreForms/gf2014026527"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026528", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSchnaderh\u00fcpfel", "identifiers:lccn": "gf2014026528", "madsrdf:adminMetadata": [{"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b1"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Schnaderh\u00fcpfel"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379"}, "madsrdf:hasSource": [{"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b5"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b6"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b7"}], "madsrdf:hasVariant": [{"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b8"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b11"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b14"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b17"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b20"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b23"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Humorous German poems composed of four rhymed lines."}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:45:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Schnaderh\u00fcpfel"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: Schnaderh\u00fcpfeln aus den Alpen; Tiroler Schnadah\u00fcpfeln; Allgemeines Liederbuch f\u00fcr fr\u00f6hliche Gesellschaften, mit einem Anhange Schnaderh\u00fcpfeln aus dem bayrischen Hochlande und unterhaltender Spiele; Nix f\u00fcr unguet! : Schnaderh\u00fcpfeln; Tausend Schnadah\u00fcpfln; Schnadah\u00fcpfln und Gschichtla; Schnadah\u00fcpfln und Spr\u00fcchln; Anhang zur abhandlung \u00fcber den Schnaderh\u00fcpfl-rhythmus; Der Schnaderh\u00fcpfl-Rhythmus; Auf der Alm : 365 waschechte Schnaderh\u00fcpfln; Da is a Leben! : 580 neue, waschechte, bairische Schnaderh\u00fcpfln; F\u00fcnfhundert Schnadah\u00fcpfl'n)"}, "madsrdf:citationSource": "OCLC, July 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 3, p. 257 (Quite common still today are the so-called Gstanzl, four-line rhyming verses more popularly known as Schnaderh\u00fcpfel and found throughout Alpine regions. These songs have a number of well-known verses but may be subject to spontaneous and amusing additions.)"}, "madsrdf:citationSource": "The Greenwood encyclopedia of world folklore and folklife, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 7 (Schnaderh\u00fcpfel, usually consisting of four lines; text improvises concisely on a specific theme, ranging from love to political songs. The tightness of the form itself makes it possible for the genre to convey its message in pointed fashion, and it offers the singer the chance to improvise and compose new songs from pre-existing themes and patterns. Schnaderh\u00fcpfel are often in the dialect of a region, or even of a relatively small area within a much larger speech area.)"}, "madsrdf:citationSource": "Bohlman, P.V. Central European folk music, 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Schnadah\u00fcpfel"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Schnadah\u00fcpfel"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Schnaderh\u00fcpfln"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Schnaderh\u00fcpfln"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Schnadah\u00fcpfeln"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Schnadah\u00fcpfeln"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Schnaderh\u00fcpfl"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Schnaderh\u00fcpfl"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Schnaderh\u00fcpfeln"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Schnaderh\u00fcpfeln"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gstanzl"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gstanzl"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Schnadah\u00fcpfln"}}, {"@id": "_:n7efec581bdd44aa08f1cbab6c319b9e6b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Schnadah\u00fcpfln"}}], "@id": "/authorities/genreForms/gf2014026528"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026529", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScience fiction", "identifiers:lccn": "gf2014026529", "madsrdf:adminMetadata": [{"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b1"}, {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Science fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026226"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026275"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026302"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026551"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026558"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026573"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026147"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026073"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026016"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026123"}], "madsrdf:hasSource": [{"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b5"}, {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b6"}, {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b7"}], "madsrdf:hasVariant": {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that depicts imagined scientific or technological advances (e.g., time travel, artificial intelligence) and their impact on society."}, {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-23T11:19:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Science fiction"}}, {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(science fiction: abbreviation SF or sci-fi, a form of fiction that deals principally with the impact of actual or imagined science upon society or individuals; the attempt at scientific and technological plausibility is the feature that distinguishes science fiction from earlier speculative writings and other contemporary speculative genres such as fantasy and horror; themes include space travel, robots, alien beings, time travel, alternative societies, alternate histories and parallel universes)"}, "madsrdf:citationSource": "Britannica online academic edition, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(science fiction: Literature in which speculative technology, time travel, alien races, intelligent robots, gene-engineering, space travel, experimental medicine, psionic abilities, dimensional portals, or altered scientific principles contribute to the plot or background. Many purists make a distinction between \"hard\" science fiction (in which the story attempts to follow accepted scientific realism and extrapolates the outcomes or consequences of scientific discovery in a hard-headed manner) and \"soft\" science fiction (which often involves looser adherence to scientific knowledge and more fantasy-elements))"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(science fiction: used for works of fantasy that deal with possible though not necessarily probable events and are based approximately on scientific principles, e.g. space travel, time travel, etc. Used also for works in which mankind confronts alien cultures or environments)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sci-fi"}}, {"@id": "_:nf41ff1252f9c48d8abdfe47e496e7f86b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sci-fi"}}], "@id": "/authorities/genreForms/gf2014026529"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026530", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScience fiction comics", "identifiers:lccn": "gf2014026530", "madsrdf:adminMetadata": [{"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db1"}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Science fiction comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026224"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026301"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026557"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026008"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026017"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026019"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026011"}], "madsrdf:hasSource": [{"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db5"}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db6"}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db7"}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db8"}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that depict imagined scientific or technological advances (e.g., time travel, artificial intelligence) and their impact on society."}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:26:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Science fiction comics"}}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Science fiction comic books, strips, etc.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 174 (Science Fiction Graphic Novels)"}, "madsrdf:citationSource": "Fletcher-Spear, K. Library collections for teens : manga and graphic novels, c2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(science fiction: abbreviation SF or sci-fi, a form of fiction that deals principally with the impact of actual or imagined science upon society or individuals; the attempt at scientific and technological plausibility is the feature that distinguishes science fiction from earlier speculative writings and other contemporary speculative genres such as fantasy and horror; themes include space travel, robots, alien beings, time travel, alternative societies, alternate histories and parallel universes)"}, "madsrdf:citationSource": "Britannica online academic edition, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 199 (Science Fiction. Readers have long been interested in speculative fiction tales. With the release of the comic strip adventures of Buck Rogers in 1929, the comic book format soon proved to be an excellent vehicle for this genre. For the first time a science fiction story could be told visually, and the only limit was the writer's and the illustrator's imagination.)"}, "madsrdf:citationSource": "Pawuk, M. Graphic novels: a genre guide to comic books, manga, and more, c2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d1382e6c8c46f98d1d8a3d8ebd729db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Science fiction (abbreviated SF or sci-fi with varying punctuation and capitalization); sci fi comics; sci fi comics books)"}, "madsrdf:citationSource": "Goodreads website, Jan. 28, 2013", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026530"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026531", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScience fiction plays", "identifiers:lccn": "gf2014026531", "madsrdf:adminMetadata": [{"@id": "_:nedd8d543dbe449109ab82849f3de7625b1"}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Science fiction plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nedd8d543dbe449109ab82849f3de7625b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026225"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026303"}], "madsrdf:hasSource": [{"@id": "_:nedd8d543dbe449109ab82849f3de7625b5"}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b6"}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b7"}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b8"}], "madsrdf:hasVariant": {"@id": "_:nedd8d543dbe449109ab82849f3de7625b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that depict imagined scientific or technological advances (e.g., time travel, artificial intelligence) and their impact on society."}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:27:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Science fiction plays"}}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cooper, C.E. Up your asteroid! : a science fiction farce, 1977.", "madsrdf:citationStatus": "found"}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(science fiction. Branch of prose fiction that explores the probable consequences of some improbable or impossible transformation of the basic conditions of human (or intelligent non-human) existence; usually abbreviated to SF or sci-fi)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(science fiction. A type of fiction based on future possibilities, derived from scientific discoveries. Chief among these have been interstellar travel, closely followed by stories dealing with the aftermaths of nuclear war and environmental disasters, altered states of consciousness, extraterrestrial visitors to earth, and artificial intelligence; commonly known as sci fi or sf)"}, "madsrdf:citationSource": "Quinn, E. A dict. of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Space and science fiction plays for young people, c1981.", "madsrdf:citationStatus": "found"}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nedd8d543dbe449109ab82849f3de7625b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Science fiction drama"}}, {"@id": "_:nedd8d543dbe449109ab82849f3de7625b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Science fiction drama"}}], "@id": "/authorities/genreForms/gf2014026531"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026532", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScience fiction poetry", "identifiers:lccn": "gf2014026532", "madsrdf:adminMetadata": [{"@id": "_:nbe2b51f838574d50af83ffeb3644680bb1"}, {"@id": "_:nbe2b51f838574d50af83ffeb3644680bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Science fiction poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbe2b51f838574d50af83ffeb3644680bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026071"}, "madsrdf:hasSource": [{"@id": "_:nbe2b51f838574d50af83ffeb3644680bb5"}, {"@id": "_:nbe2b51f838574d50af83ffeb3644680bb6"}, {"@id": "_:nbe2b51f838574d50af83ffeb3644680bb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry that depicts imagined scientific or technological advances (e.g., time travel, artificial intelligence) and their impact on society."}, {"@id": "_:nbe2b51f838574d50af83ffeb3644680bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nbe2b51f838574d50af83ffeb3644680bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:27:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbe2b51f838574d50af83ffeb3644680bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Science fiction poetry"}}, {"@id": "_:nbe2b51f838574d50af83ffeb3644680bb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Umbral anthology of science fiction poetry, 1982.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe2b51f838574d50af83ffeb3644680bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Speculative poetry is a genre of poetry that focuses on fantastic, science fictional, and mythological themes. It is also known as science fiction poetry or fantastic poetry. It is distinguished from other poetic genres by being categorized by its subject matter, rather than by the poetry's form. Speculative poetry, also known as fantastic poetry, (of which weird or macabre poetry is a major sub-classification), is a poetic genre which deals thematically with subjects which are 'beyond reality', whether via extrapolation as in science fiction or via weird and horrific themes as in horror fiction.)"}, "madsrdf:citationSource": "Wikipedia, Oct. 29, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe2b51f838574d50af83ffeb3644680bb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Voyagers : a New Zealand science fiction poetry anthology, 2009.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026532"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026533", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScreenplays", "identifiers:lccn": "gf2014026533", "madsrdf:adminMetadata": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb1"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Screenplays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb5"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb6"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb7"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb8"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb9"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb10"}], "madsrdf:hasVariant": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb11"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb14"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb17"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb20"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb23"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb26"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb29"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb32"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb35"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb38"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb41"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb44"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Screenplays"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Twenty best film plays, 1943.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Simon, N. The odd couple I and II : the original screen plays, c2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Film scripts. UF Motion picture plays; Screenplays; Scripts, Film. BT Plays)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Nov. 7, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Internet movie script database (IMSDb), viewed online Oct. 27, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "filmscript (a script for a motion picture) screenplay (the script and often shooting directions of a story prepared for motion-picture production. Synonyms: scenario; script. Related words: shooting script; story, text) shooting script (1. the final completely detailed version of a motion-picture script in which scenes are grouped in the order most convenient for shooting. 2. the final version of a television script used in the production of a program) scenario (1 a : an outline or synopsis of a play; especially : a plot outline used by actors of the commedia dell'arte. b : the libretto of an opera. 2 a : screenplay. b : shooting script)"}, "madsrdf:citationSource": "Merriam-Webster online, Oct. 27, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "screenplay (Completed manuscript upon which a film is based. It contains dialogue; it is divided into scenes; it often includes some camera directions; it is written in the generally accepted screenplay format. Related terms: teleplay, script, scenario) script (Written text in a special format serving as a guide for the course of action, dialogue and setting. Related term: screenplay) scenario (Old term for screenplay; most commonly used today to refer to plot or storyline) continuity script (Script containing precise visual and audio information for each shot; everything in it matches what is seen and heard in the film) photoplay (1. Script intended to be photographed as a motion picture (theatrical film); it is an anachronistic name for a screenplay. 2. The motion picture itself; a photographed play.)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dictionary, c2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scenarios (Screenplays)"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scenarios (Screenplays)"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Film scripts"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film scripts"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Film plays"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film plays"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Continuity scripts"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Continuity scripts"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scripts (Screenplays)"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scripts (Screenplays)"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Screen plays"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Screen plays"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shooting scripts (Motion pictures)"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shooting scripts (Motion pictures)"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motion picture scripts"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion picture scripts"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motion picture screenplays"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion picture screenplays"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb38", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb39"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Movie scripts"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb39", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Movie scripts"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb41", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb42"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motion picture plays"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb42", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion picture plays"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb44", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb45"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmscripts"}}, {"@id": "_:n8dd0e624504d4c56bcabd7f99c53382cb45", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmscripts"}}], "@id": "/authorities/genreForms/gf2014026533"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026534", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSenryu", "identifiers:lccn": "gf2014026534", "madsrdf:adminMetadata": [{"@id": "_:ne766a69e3d9444de978419c3350551a7b1"}, {"@id": "_:ne766a69e3d9444de978419c3350551a7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Senryu"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne766a69e3d9444de978419c3350551a7b3"}]}, "madsrdf:exampleNote": "Note under [Haiku]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379"}, "madsrdf:hasSource": [{"@id": "_:ne766a69e3d9444de978419c3350551a7b5"}, {"@id": "_:ne766a69e3d9444de978419c3350551a7b6"}], "madsrdf:hasVariant": {"@id": "_:ne766a69e3d9444de978419c3350551a7b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Three-line unrhymed humorous poems consisting of 17 syllables that generally satirize human nature or emotions. For three-line unrhymed poems consisting of 17 syllables that express a single idea, image, or feeling that is generally related to nature see [Haiku.]"}, {"@id": "_:ne766a69e3d9444de978419c3350551a7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:24:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne766a69e3d9444de978419c3350551a7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne766a69e3d9444de978419c3350551a7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Senryu"}}, {"@id": "_:ne766a69e3d9444de978419c3350551a7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "senryu (senryu (also called human haiku) is an unrhymed Japanese verse consisting of three unrhymed lines of five, seven, and five syllables or 17 in all. Senryu are usually written in the present tense and only [make] references to some aspect of human nature or emotions. They possess no references to the natural world and thus stand out from nature/seasonal haiku) haiku; senryu is similar in structure to haiku, but is more concerned with human nature and political issues, and is often humorous or satiric; the primary difference between haiku and senryu is the tone.)"}, "madsrdf:citationSource": "Shadow poetry, via WWW, July 25, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne766a69e3d9444de978419c3350551a7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(senry\u016b: a three-line unrhymed Japanese poem structurally similar to a haiku but treating human nature usually in an ironic or satiric vein. It is also unlike haiku in that it usually does not have any references to the seasons. Senry\u016b developed from haiku and became especially popular among the common people about the 18th century. It was named for Karai Hachiemon (pen name Senry\u016b), one of the most popular practitioners of the form.)"}, "madsrdf:citationSource": "Britannica online, July 24, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:ne766a69e3d9444de978419c3350551a7b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne766a69e3d9444de978419c3350551a7b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Human haiku"}}, {"@id": "_:ne766a69e3d9444de978419c3350551a7b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Human haiku"}}], "@id": "/authorities/genreForms/gf2014026534"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026535", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSentimental comedies", "identifiers:lccn": "gf2014026535", "madsrdf:adminMetadata": [{"@id": "_:n9c1a0b31615b4022bf368761bc602a63b1"}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sentimental comedies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9c1a0b31615b4022bf368761bc602a63b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, "madsrdf:hasSource": [{"@id": "_:n9c1a0b31615b4022bf368761bc602a63b5"}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b6"}], "madsrdf:hasVariant": [{"@id": "_:n9c1a0b31615b4022bf368761bc602a63b7"}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b10"}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "English comedic plays from the 18th century that emphasize the virtues rather than the foibles of the major characters and celebrate the triumph of good over evil."}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:16:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sentimental comedies"}}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sentimental comedy. A type of 18th-century English comedy emphasizing the virtues, rather than the foibles, of its major characters and celebrating the triumph of good over evil. Conceived in reaction to the cynical and amoral tone of Restoration comedy, the comedy of sensibility, as sentimental comedy was known, was notably short on laughs, but rich in \"warmth.\" In this respect it was a precursor of 19th-century melodrama and of the television sitcom of the 1950s.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Marshall, M.F. Sentimental drama in England, France, and Germany, 1973.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9c1a0b31615b4022bf368761bc602a63b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sentimental drama"}}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sentimental drama"}}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9c1a0b31615b4022bf368761bc602a63b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sensibility, Comedies of"}}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sensibility, Comedies of"}}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9c1a0b31615b4022bf368761bc602a63b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comedies of sensibility"}}, {"@id": "_:n9c1a0b31615b4022bf368761bc602a63b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedies of sensibility"}}], "@id": "/authorities/genreForms/gf2014026535"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026536", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSentimental novels", "identifiers:lccn": "gf2014026536", "madsrdf:adminMetadata": [{"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb1"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sentimental novels"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026020"}, "madsrdf:hasSource": [{"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb5"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb6"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb7"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb8"}], "madsrdf:hasVariant": [{"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb9"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb12"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb15"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb18"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Novels from the 18th-19th centuries that emphasize distress of the virtuous and reward moral behavior and honor."}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:16:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sentimental novels"}}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ch. 22 (\"Sentimental fiction: ethics, social critique and philanthropy\" by Thomas Keymer; the 1770s can be seen to mark the peak for sentimental fiction; but the style remained business as usual for other practitioners of the mode well into the nineteenth century)"}, "madsrdf:citationSource": "Cambridge history of English literature, 1660-1780, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sentimental novel (also called novel of sentiment or novel of sensibility). An emotionally extravagant novel of a kind that became popular in Europe in the late 18th century; the sentimental novels of the 1760s and 1770s exhibit the close connections between virtue and sensibility, in repeatedly tearful scenes; a character's feeling for the beauties of nature and for the griefs of others is taken as a sign of a pure heart)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sentimental novel. A form of fiction popular in 18th c. England. It concentrated on the distresses of the virtuous and attempted to show that a sense of honour and moral behaviour were justly rewarded. It also attempted to show that effusive emotion was evidence of kindness and goodness. In this period scores of sentimental novels were published and read avidly.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sentimental novel. A type of novel popular in late 18th-century Europe. The aim of the sentimental novel, as described by the critic Janet Todd, was \"the arousal of pathos through conventional situations, stock familiar characters, and rhetorical devices.\" In the hands of more accomplished writers, this excessive emotionalism was tempered with irony and humor; the \"novel of sensibility,\" as it was known, had a powerful impact on European literature)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novels of sensibility"}}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novels of sensibility"}}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sensibility, Novels of"}}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sensibility, Novels of"}}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novels of sentiment"}}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novels of sentiment"}}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sentimental fiction"}}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sentimental fiction"}}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sentiment, Novels of"}}, {"@id": "_:n0a18a4ec9a7343d9826f51807158a2ffb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sentiment, Novels of"}}], "@id": "/authorities/genreForms/gf2014026536"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026537", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSerialized fiction", "identifiers:lccn": "gf2014026537", "madsrdf:adminMetadata": [{"@id": "_:ne5705579fd474b2199c5bade7e7981b2b1"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Serialized fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne5705579fd474b2199c5bade7e7981b2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026010"}, "madsrdf:hasSource": [{"@id": "_:ne5705579fd474b2199c5bade7e7981b2b5"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b6"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b7"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b8"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b9"}], "madsrdf:hasVariant": [{"@id": "_:ne5705579fd474b2199c5bade7e7981b2b10"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b13"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b16"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction published as successive installments in a newspaper, magazine or other periodical."}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-07-13T14:04:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serialized fiction"}}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(serialization: the publication of a literary work as successive installments in a newspaper, magazine, or some other periodical format, rather than as a book; common in England in later seventeenth and eighteenth centuries and peaking in nineteenth century for narrative fiction; most Victorian novels we now read in single-volume paperback editions--from authors like Dickens, Thackeray, Stevenson, and Hardy--first appeared in newspapers, in magazines, and in monthly parts)"}, "madsrdf:citationSource": "Oxford encyclopedia of British literature, via Oxford reference online, Nov. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(serialize (also serialise): 1. Publish or broadcast (a story or play) in regular instalments)"}, "madsrdf:citationSource": "Oxford English dictionaries website, Apr. 24, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Feuilleton: A French term for the literary section of a daily newspaper: originally the lower part of the front page, devoted to drama criticism, but later a separate page or pages. The roman-feuilleton is a novel serialized in a newspaper: this form flourished in France in the 1840s)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(serialise: British spelling of serialize; serialize: to arrange or publish in serial form; serialize a novel)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Apr. 24, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Feuilleton: a part of a European newspaper or magazine devoted to material designed to entertain the general reader; something (as an installment of a novel) printed in a feuilleton; a novel printed in installments; a work of fiction catering to popular taste; a short literary composition often having a familiar tone and reminiscent content)"}, "madsrdf:citationSource": "Merriam-Webster.com, Oct. 31, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5705579fd474b2199c5bade7e7981b2b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romans-feuilleton"}}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romans-feuilleton"}}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5705579fd474b2199c5bade7e7981b2b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Serialised fiction"}}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serialised fiction"}}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5705579fd474b2199c5bade7e7981b2b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Roman-feuilletons"}}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Roman-feuilletons"}}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5705579fd474b2199c5bade7e7981b2b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Feuilletons (Serialized fiction)"}}, {"@id": "_:ne5705579fd474b2199c5bade7e7981b2b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Feuilletons (Serialized fiction)"}}], "@id": "/authorities/genreForms/gf2014026537"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026538", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSestets", "identifiers:lccn": "gf2014026538", "madsrdf:adminMetadata": [{"@id": "_:n8f3c77ef77a746c6894b5d290e5c4fc0b1"}, {"@id": "_:n8f3c77ef77a746c6894b5d290e5c4fc0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sestets"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8f3c77ef77a746c6894b5d290e5c4fc0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n8f3c77ef77a746c6894b5d290e5c4fc0b5"}, {"@id": "_:n8f3c77ef77a746c6894b5d290e5c4fc0b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems consisting of one or more stanzas of six lines."}, {"@id": "_:n8f3c77ef77a746c6894b5d290e5c4fc0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8f3c77ef77a746c6894b5d290e5c4fc0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:46:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8f3c77ef77a746c6894b5d290e5c4fc0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sestets"}}, {"@id": "_:n8f3c77ef77a746c6894b5d290e5c4fc0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sestet: A group of six lines forming the second part of a sonnet (in its Italian or Petrarchan form), following the opening octave. More rarely, the term may refer to a stanza of six lines (also called a sexain, sextain, or sextet), such as the Burns stanza or the stanza used in a sestina.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n8f3c77ef77a746c6894b5d290e5c4fc0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sestet. A poem, stanza, or unit of six lines of verse. The term usually applies to Italian sonnets to indicate the final six-line section of the poem, as distinct from the octave (the first eight lines). Other than the sonnet, British and American writers have infrequently opted for a six-line stanza structure.)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dict. of literary terms, c2006", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026538"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026539", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSestinas", "identifiers:lccn": "gf2014026539", "madsrdf:adminMetadata": [{"@id": "_:nad31ec64da4242ac933057984244271db1"}, {"@id": "_:nad31ec64da4242ac933057984244271db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sestinas"}, "madsrdf:elementList": {"@list": [{"@id": "_:nad31ec64da4242ac933057984244271db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nad31ec64da4242ac933057984244271db5"}, {"@id": "_:nad31ec64da4242ac933057984244271db6"}, {"@id": "_:nad31ec64da4242ac933057984244271db7"}], "madsrdf:hasVariant": [{"@id": "_:nad31ec64da4242ac933057984244271db8"}, {"@id": "_:nad31ec64da4242ac933057984244271db11"}, {"@id": "_:nad31ec64da4242ac933057984244271db14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that consist of 39 lines in six six-line stanzas followed by a three-line envoi, in which the same six end words occur in each stanza but in a shifting order."}, {"@id": "_:nad31ec64da4242ac933057984244271db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:46:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nad31ec64da4242ac933057984244271db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nad31ec64da4242ac933057984244271db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sestinas"}}, {"@id": "_:nad31ec64da4242ac933057984244271db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sestina. A 39-line poem consisting of six stanzas of six lines each and a final three-line envoy, an addition to a poem addressed to a person or an abstraction. Adding to the complexity of the form is the requirement that each stanza use the same end words, but always in a different order.)"}, "madsrdf:citationSource": "Quinn, E. A dict. of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nad31ec64da4242ac933057984244271db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sestina. A poem of six 6-line stanzas and a 3-line envoi, linked by an intricate pattern of repeated line-endings. The most elaborate of the medieval French fixed forms, it uses only six end-words (normally unrhymed), repeating them in a different order in each stanza so that the ending of the last line in each stanza recurs as the ending of the first line in the next. The envoi uses all six words, three of them as line-endings)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nad31ec64da4242ac933057984244271db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sestina (also known as sestine, sextine or sextain))"}, "madsrdf:citationSource": "Wikipedia, Jan. 11, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nad31ec64da4242ac933057984244271db8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nad31ec64da4242ac933057984244271db9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sestines"}}, {"@id": "_:nad31ec64da4242ac933057984244271db9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sestines"}}, {"@id": "_:nad31ec64da4242ac933057984244271db11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nad31ec64da4242ac933057984244271db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sextines"}}, {"@id": "_:nad31ec64da4242ac933057984244271db12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sextines"}}, {"@id": "_:nad31ec64da4242ac933057984244271db14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nad31ec64da4242ac933057984244271db15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sextains"}}, {"@id": "_:nad31ec64da4242ac933057984244271db15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sextains"}}], "@id": "/authorities/genreForms/gf2014026539"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026540", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSewamono", "identifiers:lccn": "gf2014026540", "madsrdf:adminMetadata": [{"@id": "_:ndb3199562b184810bfef222b1387b3f7b1"}, {"@id": "_:ndb3199562b184810bfef222b1387b3f7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sewamono"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndb3199562b184810bfef222b1387b3f7b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026294"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026393"}], "madsrdf:hasSource": [{"@id": "_:ndb3199562b184810bfef222b1387b3f7b5"}, {"@id": "_:ndb3199562b184810bfef222b1387b3f7b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Kabuki plays of the Edo period that feature the lives of ordinary people."}, {"@id": "_:ndb3199562b184810bfef222b1387b3f7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ndb3199562b184810bfef222b1387b3f7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:48:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndb3199562b184810bfef222b1387b3f7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sewamono"}}, {"@id": "_:ndb3199562b184810bfef222b1387b3f7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (sewamono: Play relating to everyday life in the Edo period. In contrast to the jidaimono, sewamono deals with the lives of the ordinary citizens of the Edo period such as the merchants and farmers)"}, "madsrdf:citationSource": "The kabuki story, via WWW, Feb. 17, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb3199562b184810bfef222b1387b3f7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sewamono. BT Domestic drama, Japanese; Kabuki plays)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026540"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026541", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aShadow plays", "identifiers:lccn": "gf2014026541", "madsrdf:adminMetadata": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b1"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Shadow plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026493"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b5"}, "madsrdf:hasSource": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b8"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b9"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b10"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b11"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b12"}], "madsrdf:hasVariant": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b13"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b16"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b19"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b22"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b25"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b28"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b31"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b34"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b37"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b40"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays in which the characters and scenery consist of shadows cast onto a screen by two-dimensional puppets and other objects.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026278"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-24T10:11:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shadow plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed shadow plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed shadow plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "March, B. Chinese shadow figure plays and their making, 1938.", "madsrdf:citationStatus": "found"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Liu, Q. Chinese shadow puppet plays, 1988.", "madsrdf:citationStatus": "found"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Shadow play (Shadow play or also known as shadow puppetry is an ancient form of storytelling and entertainment which uses flat articulated figures (shadow puppets) to create the impression of moving humans and other three-dimensional objects; shadow theatre; shadow plays; shadow show; shadow puppet theater is called wayang kulit in Indonesia and it is particularly popular in Java and Bali; in Malaysia, shadow puppet plays are also known as wayang kulit; shadow theatre in Thailand is called Nang Yai; in the south there is a tradition called nang talung; nang drama has influence modern Thai cinema)"}, "madsrdf:citationSource": "Wikipedia, Nov. 12, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(shadow-show, form of puppetry in which flat, jointed figures are passed between a translucent screen and lighted candles or, nowadays, electric light bulbs, so that the audience, seated in front of the screen, sees only their shadows; originated in the Far East, particularly in Java and India; as 'les Ombres Chinoises', shadow-shows were popular in Paris for about 100 years; the classic shadow-play The Broken Bridge; well known in the streets of London, where, as the Galanty Show, shadow-plays continued to be given up to the end of the 19th century)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hart, E. Funny shadow pantomimes, c1933.", "madsrdf:citationStatus": "found"}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nang drama"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nang drama"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nang yai plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nang yai plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shadow puppet plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shadow puppet plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed shadow plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed shadow plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shadow drama"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shadow drama"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shadow pantomimes"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shadow pantomimes"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nang talung plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nang talung plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shadow shows"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shadow shows"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shadow figure plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shadow figure plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b40", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b41"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wayang kulit plays"}}, {"@id": "_:n18b1255bc2f447b794bded37e1e5bd25b41", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wayang kulit plays"}}], "@id": "/authorities/genreForms/gf2014026541"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026542", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aShort stories", "identifiers:lccn": "gf2014026542", "madsrdf:adminMetadata": [{"@id": "_:n6d8b2fdc03794bf4948018a4909de840b1"}, {"@id": "_:n6d8b2fdc03794bf4948018a4909de840b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Short stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6d8b2fdc03794bf4948018a4909de840b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026543"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026126"}], "madsrdf:hasSource": {"@id": "_:n6d8b2fdc03794bf4948018a4909de840b5"}, "madsrdf:hasVariant": {"@id": "_:n6d8b2fdc03794bf4948018a4909de840b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6d8b2fdc03794bf4948018a4909de840b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n6d8b2fdc03794bf4948018a4909de840b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-13T18:11:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6d8b2fdc03794bf4948018a4909de840b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Short stories"}}, {"@id": "_:n6d8b2fdc03794bf4948018a4909de840b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(short story: A fictional prose tale of no specified length, but too short to be published as a volume on its own, as novellas sometimes and novels usually are; a short story will normally concentrate on a single event with only one or two characters, more economically than a novel's sustained exploration of social background; there are similar fictional forms of greater antiquity--fables, lais, folktales, parables, and the French conte--but the short story as we know it flourished in the magazines of the 19th and early 20th centuries, especially in the USA, which has a particularly strong tradition)"}, "madsrdf:citationSource": "Oxford dictionary of literary terms, via Oxford reference online, Nov. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d8b2fdc03794bf4948018a4909de840b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6d8b2fdc03794bf4948018a4909de840b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Short fiction"}}, {"@id": "_:n6d8b2fdc03794bf4948018a4909de840b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Short fiction"}}], "@id": "/authorities/genreForms/gf2014026542"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026543", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFlash fiction", "identifiers:lccn": "gf2014026543", "madsrdf:adminMetadata": [{"@id": "_:nd0a31094f68644f4b985797e21fffddeb1"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Flash fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd0a31094f68644f4b985797e21fffddeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026542"}, "madsrdf:hasSource": [{"@id": "_:nd0a31094f68644f4b985797e21fffddeb5"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb6"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb7"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb8"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb9"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb10"}], "madsrdf:hasVariant": [{"@id": "_:nd0a31094f68644f4b985797e21fffddeb11"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb14"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb17"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb20"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flash fiction"}}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Minifiction is a new form of writing found under many names; flash fiction, sudden fiction, nanofiction, microfiction or the short short story; all of these have one thing in common: their extreme brevity)"}, "madsrdf:citationSource": "Minifiction, via WWW, Dec. 20, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(SmokeLong Quarterly is dedicated to bringing the best flash fiction to the web on a quarterly basis, whether written by widely published authors, or those new to the craft. The term \"smoke-long\" comes from the Chinese, who noted that reading a piece of flash takes about the same length of time as smoking a cigarette. All the work we publish is precisely that--about a smoke long)"}, "madsrdf:citationSource": "SmokeLong Quarterly, via WWW, Dec. 20, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p.13 (sudden fictions are very short stories, only a few pages long; what is short-short fiction? Experimental fictions? Sketches? Prose poems? Anecdotes?) p. 15 (stories of only a page or two seemed to us different not only in length but in nature; they evoked a single moment, or an idea, whereas a five page story however experimental, was more akin to the traditional short story; so the longer story became \"new\" sudden fiction while the shorter became flash, named by James Thomas, editor of Flash fiction; ever shorter fiction was appearing in the literary magazines; now came fast fiction, skinny fiction, mini fiction, quick fiction, and micro fiction, the last a mere 250 words)"}, "madsrdf:citationSource": "New sudden fiction : short-short stories from America and beyond, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hot & bothered : short short fiction on lesbian desire, c1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Contributor answers to question \"What is the difference between a prose poem and flash fiction?\": Johnathan Carr: \"Flash fiction is a compact distilled piece of writing that follows all of the dictates (or lack thereof) that one would place on a work of fiction. It is an act of distillation. Of sparseness. Minimal strokes. A prose poem is often the very opposite.) Issue 2 (Anthony Tognazzini: \"As for the differences between short fictions and prose poems-the former clearly focuses on character and situations, the latter on the elasticity of sound and language-meaning\")"}, "madsrdf:citationSource": "Double room: a journal of prose poetry and flash fiction, via WWW, Dec. 19, 2012: Issue 1", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Flash fiction is a style of fictional literature or fiction of extreme brevity. There is no widely accepted definition of the length of the category; variants: sudden fiction, micro fiction, micro-story, short short, postcard fiction, short short story, micro narrative)"}, "madsrdf:citationSource": "Wikipedia, July 16, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0a31094f68644f4b985797e21fffddeb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Micro fiction"}}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Micro fiction"}}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0a31094f68644f4b985797e21fffddeb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Very short fiction"}}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Very short fiction"}}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0a31094f68644f4b985797e21fffddeb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sudden fiction"}}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sudden fiction"}}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0a31094f68644f4b985797e21fffddeb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Microfiction"}}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Microfiction"}}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0a31094f68644f4b985797e21fffddeb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Short-short stories"}}, {"@id": "_:nd0a31094f68644f4b985797e21fffddeb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Short-short stories"}}], "@id": "/authorities/genreForms/gf2014026543"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026544", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSijo", "identifiers:lccn": "gf2014026544", "madsrdf:adminMetadata": [{"@id": "_:n641a683ae1bd4d9da86db8a4c5cbeb73b1"}, {"@id": "_:n641a683ae1bd4d9da86db8a4c5cbeb73b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sijo"}, "madsrdf:elementList": {"@list": [{"@id": "_:n641a683ae1bd4d9da86db8a4c5cbeb73b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026524"}, "madsrdf:hasSource": [{"@id": "_:n641a683ae1bd4d9da86db8a4c5cbeb73b5"}, {"@id": "_:n641a683ae1bd4d9da86db8a4c5cbeb73b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Traditional Korean lyrics with stanzas that average 45 syllables, arranged in three lines of four phrase-groupings apiece."}, {"@id": "_:n641a683ae1bd4d9da86db8a4c5cbeb73b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:48:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n641a683ae1bd4d9da86db8a4c5cbeb73b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n641a683ae1bd4d9da86db8a4c5cbeb73b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sijo"}}, {"@id": "_:n641a683ae1bd4d9da86db8a4c5cbeb73b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 880 (A Korean verse form, originally sung or changed to the accompaniment of music. A complex form, the conventional sijo comprises three lines, each being composed of four groups of syllables. The first two lines had either fourteen or fifteen syllables, the third fifteen. There were slight variations, but a sijo was usually of forty-three, forty-four or forty-five syllables. Head rhyme (q.v.) is common. The sijo is of great antiquity and dates back at least to the 14th c. It is still used by Korean poets.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1991:", "madsrdf:citationStatus": "found"}, {"@id": "_:n641a683ae1bd4d9da86db8a4c5cbeb73b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xvii (The sijo is a traditional lyric of three lines or verses averaging 45 syllables in a stanza, each line made up of four phrase-groupings with a major pause after each grouping. Extremely elastic in form, the sijo differs from Chinese and Japanese verse forms in that it does not adhere to a strict syllable count.) p. xix (The form of the sijo so far stated applies only to the standard form called plain sijo or p'yong sijo. The other two forms are called the medium or ossijo which is expanded in syllabic count ... and the long sijo or sasol sijo, retaining a three-line structure, is almost formless expanded in every line and mostly in the middle into any number of syllables.)"}, "madsrdf:citationSource": "Kim, J. Classical Korean poetry, 1994:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026544"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026545", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSirventes", "identifiers:lccn": "gf2014026545", "madsrdf:adminMetadata": [{"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b1"}, {"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sirventes"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422"}, "madsrdf:hasSource": [{"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b5"}, {"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b6"}, {"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b7"}, {"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Medieval Proven\u00e7al poems that consist of invective or satire."}, {"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:48:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sirventes"}}, {"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sirventes: a medieval Proven\u00e7al poem of personal or political invective or satire.)"}, "madsrdf:citationSource": "Frye, N. The Harper handbook to literature, c1997", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sirventes: a type of Proven\u00e7al lyric verse written to satirize political figures or personal foes or to instruct morally. It had no fixed form.)"}, "madsrdf:citationSource": "Beckson, K. Literary terms : a dictionary, 1989", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sirventes: a poem in medieval Occitan that is strophic in form but is not a canso or love poem. The main themes are politics and current events, including war and the Crusades, ad hominem attacks or (occasionally) praise, social and literary satire, or moralizing on the decline of society and standards of behavior. The tone is mostly satiric and gross vituperation is common)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf6bd2ab57342fd846787bee6995f51b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sirventes)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026545"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026546", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSkeltonic verse", "identifiers:lccn": "gf2014026546", "madsrdf:adminMetadata": [{"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b1"}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Skeltonic verse"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b5"}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b6"}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b7"}], "madsrdf:hasVariant": [{"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b8"}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b11"}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems consisting of short, irregular lines with parallelism, multiple rhymes, and abundant alliteration."}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:27:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skeltonic verse"}}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Skeltonic verse (also called \"tumbling verse,\" \"skeltonics,\" and \"skeltoniads\"): satiric, roughly hewn verse of revolt written by John Skelton (1460-1529) and consisting of short, irregularly lined and rhymed verses. The form, aimed at the formalists, politicians, and clergymen of his period, resembles doggerel in effect and intention.)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Skeltonics. Or Skeltonic verse (also known as 'tumbling verse', named after John Skelton (1460?-1529), a poet of the Tudor period. It is a headlong, kettle-drum, tumultuous verse related to doggerel whose chief stylistic features are short lines, multiple rhyme, alliteration and parallelism. Pejoratively called 'rude rayling', Skeltonics have become admired and respectable.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Skeltonic. A kind of poem named after its originator, the Eng. poet laureate John Skelton (ca. 1460-1529). Skeltonic poems are distinguished by short lines and long stretches of monorhyme, called leashes. End rhymes are not crossed. Lines have between two and five stresses, although three-stress lines occur most frequently. Alliteration abounds; rhyme, rather than meaning seems to drive the poems forward.)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Skeltoniads"}}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skeltoniads"}}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Skeltonics"}}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skeltonics"}}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tumbling verse"}}, {"@id": "_:ne0a27120a5434c7fb40e798a97a9c175b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tumbling verse"}}], "@id": "/authorities/genreForms/gf2014026546"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026547", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSociety verse", "identifiers:lccn": "gf2014026547", "madsrdf:adminMetadata": [{"@id": "_:n08f27b12d76349b4827839304724757eb1"}, {"@id": "_:n08f27b12d76349b4827839304724757eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Society verse"}, "madsrdf:elementList": {"@list": [{"@id": "_:n08f27b12d76349b4827839304724757eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n08f27b12d76349b4827839304724757eb5"}, {"@id": "_:n08f27b12d76349b4827839304724757eb6"}, {"@id": "_:n08f27b12d76349b4827839304724757eb7"}], "madsrdf:hasVariant": [{"@id": "_:n08f27b12d76349b4827839304724757eb8"}, {"@id": "_:n08f27b12d76349b4827839304724757eb11"}, {"@id": "_:n08f27b12d76349b4827839304724757eb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Epigrammatic or lyrical poems dealing with the superficial problems and events of sophisticated and polite society."}, {"@id": "_:n08f27b12d76349b4827839304724757eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:49:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n08f27b12d76349b4827839304724757eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n08f27b12d76349b4827839304724757eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Society verse"}}, {"@id": "_:n08f27b12d76349b4827839304724757eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Light verse: The term light verse is an omnium gatherum. While light verse once referred principally to vers de soci\u00e9t\u00e9, the Fr. term for verse reserved for one's social circle to amuse or commemorate an occasion, its meaning now includes folk poetry, nonsense verse, ribald verse, kitsch, and more. If the earlier meaning of the term was too narrow, it has now been stretched so far that it has lost its shape)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n08f27b12d76349b4827839304724757eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Society verse: see verse de soci\u00e9t\u00e9: Literally 'society verse', a sub-species of light verse. It is usually epigrammatic or lyrical verse dealing with the superficial problems and events of sophisticated and polite society. It is often satirical and characterized by technical virtuosity, wit, elegance and a conversational tone. Often intricate forms like triolet, villanelle and rondeau are used. The ballads, limericks and the clerihew are also favorite forms.)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n08f27b12d76349b4827839304724757eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Vers de soci\u00e9t\u00e9: \"Society verse\"--witty, polished, and suave light verse written to amuse polite society. Anacreon, Catullus, Martial, and Horace among the ancients, Jean Froissart of the fourteenth century, and Robert Herrick, Thomas Carew, and Richard Lovelace of the early seventeenth wrote many short verses that qualify. But the term originated with the playful and sophisticated lyrics of the seventeenth-century French salons, particularly that of Catherine de Vivonne, marquise de Rambouillet, with Vincent Voiture (1597-1648) the preeminent writer. In England, Matthew Prior (1664-1721) was outstanding, and Alexander Pope's Rape of the Lock, although large for the genre in its mock-epic dimensions, the all-time masterpiece. William Ernest Henley and Austin Dobson revived the form in the late nineteenth century, and Sire John Betjeman in the twentieth. In America, Ogden Nash created his unique unpolished mode.)"}, "madsrdf:citationSource": "Frye, N. The Harper handbook to literature, c1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n08f27b12d76349b4827839304724757eb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n08f27b12d76349b4827839304724757eb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Society poetry"}}, {"@id": "_:n08f27b12d76349b4827839304724757eb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Society poetry"}}, {"@id": "_:n08f27b12d76349b4827839304724757eb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n08f27b12d76349b4827839304724757eb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Light verse"}}, {"@id": "_:n08f27b12d76349b4827839304724757eb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Light verse"}}, {"@id": "_:n08f27b12d76349b4827839304724757eb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n08f27b12d76349b4827839304724757eb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vers de soci\u00e9t\u00e9"}}, {"@id": "_:n08f27b12d76349b4827839304724757eb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vers de soci\u00e9t\u00e9"}}], "@id": "/authorities/genreForms/gf2014026547"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026548", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSoliloquies", "identifiers:lccn": "gf2014026548", "madsrdf:adminMetadata": [{"@id": "_:n489cab027fa14b8b92c2f30c7e273e40b1"}, {"@id": "_:n489cab027fa14b8b92c2f30c7e273e40b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Soliloquies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n489cab027fa14b8b92c2f30c7e273e40b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026440"}, "madsrdf:hasSource": {"@id": "_:n489cab027fa14b8b92c2f30c7e273e40b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Speeches uttered by a character in a play who reveals his or her inner thoughts while alone on stage or while under the impression of being alone."}, {"@id": "_:n489cab027fa14b8b92c2f30c7e273e40b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n489cab027fa14b8b92c2f30c7e273e40b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-03T15:57:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n489cab027fa14b8b92c2f30c7e273e40b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soliloquies"}}, {"@id": "_:n489cab027fa14b8b92c2f30c7e273e40b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(soliloquy. A dramatic speech uttered by one character speaking aloud while alone on stage (or while under the impression of being alone). The soliloquist thus reveals his or her inner thoughts and feelings to the audience, either in supposed self-communion or in a consciously direct address. Soliloquies often appear in plays from the age of Shakespeare, notably in his Hamlet and Macbeth. Soliloquy is a form of monologue, but a monologue is not a soliloquy if (as in the dramatic monologue) the speaker is not alone.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026548"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026549", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSonnets", "identifiers:lccn": "gf2014026549", "madsrdf:adminMetadata": [{"@id": "_:n3de383852a884caf85356d11e61af236b1"}, {"@id": "_:n3de383852a884caf85356d11e61af236b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sonnets"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3de383852a884caf85356d11e61af236b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422"}, "madsrdf:hasSource": [{"@id": "_:n3de383852a884caf85356d11e61af236b5"}, {"@id": "_:n3de383852a884caf85356d11e61af236b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Lyric poems consisting of 14 rhymed lines."}, {"@id": "_:n3de383852a884caf85356d11e61af236b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n3de383852a884caf85356d11e61af236b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:49:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3de383852a884caf85356d11e61af236b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sonnets"}}, {"@id": "_:n3de383852a884caf85356d11e61af236b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sonnet: from Italian, sonetto, \"a little sound or song\"). A 14-line poem normally in hendescasyllables (It.), iambic pentameter (Eng.), or alexandrines (Fr.), whose rhyme scheme varies despite the assumption that the sonnet form is fixed. The three most widely recognized versions of the sonnet, with their traditional rhyme schemes, are the Italian or Petrarchan (octave:abbaabba; sestet: cdecde or cdcdcd or a similar combination that avoids the closing couplet), the Spenserian (ababbcbccdcdee), and the English or Shakespearean (ababcdcdefefgg))"}, "madsrdf:citationSource": "Princeton encyclopedia of poetry and poetics, 4th ed., c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n3de383852a884caf85356d11e61af236b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sonnet. A lyric poem comprising fourteen rhyming lines of equal length: iambic pentameters in English, alexandrines in French, hendecasyllables in Italian)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026549"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026550", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSound poetry", "identifiers:lccn": "gf2014026550", "madsrdf:adminMetadata": [{"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b1"}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sound poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b3"}]}, "madsrdf:exampleNote": "Note under [Spoken word poetry]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026391"}, "madsrdf:hasSource": [{"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b5"}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b6"}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b7"}], "madsrdf:hasVariant": [{"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b8"}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b11"}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry meant to be performed that emphasizes sounds instead of the semantic meaning of the words themselves. For poetry that is meant to be performed and that is heavily stressed, metrically regular, and characterized by improvisation, free association, and word play, see [Spoken word poetry.]"}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-03T08:31:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sound poetry"}}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sound poetry (also \"sonorist rhythms,\" \"phonetic poetry,\" or poesie sonore); multiplies, reduces, or denies semantic reference while amplifying the phonetic and aural properties of language; some sound poems attempt to generate natural signifying relationships between sound and meaning through phonetic symbolism; others use sound as antagonistic or indifferent toward meaning)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sound poetry. Here are entered works on poems that are meant to be performed that emphasize sounds instead of semantics for their meaning. Works on poems that are meant to be performed and that are heavily stressed, metrically regular, and are characterized by improvisation, free association, and word play are entered under Spoken word poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sound poems: poems that depend on the element of sound for the major portion of their meaning)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sonorist rhythms (Poetry)"}}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sonorist rhythms (Poetry)"}}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poesie sonore"}}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poesie sonore"}}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Phonetic poetry"}}, {"@id": "_:nbee6c5a09fe546a8bb9ff3068687ca25b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Phonetic poetry"}}], "@id": "/authorities/genreForms/gf2014026550"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026551", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpace operas (Fiction)", "identifiers:lccn": "gf2014026551", "madsrdf:adminMetadata": [{"@id": "_:n66861071133949d69a65e53e2fb3586cb1"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Space operas (Fiction)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n66861071133949d69a65e53e2fb3586cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026217"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026529"}], "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n66861071133949d69a65e53e2fb3586cb5"}, "madsrdf:hasSource": [{"@id": "_:n66861071133949d69a65e53e2fb3586cb8"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb9"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb10"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb11"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb12"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb13"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb14"}], "madsrdf:hasVariant": [{"@id": "_:n66861071133949d69a65e53e2fb3586cb15"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Large-scale action and adventure fiction involving space travel."}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-04-09T11:07:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Space operas (Fiction)"}}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66861071133949d69a65e53e2fb3586cb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Space operas"}}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Space operas"}}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 190 (three key features that a space opera must have: a spaceship, an exciting adventure story and a tendency towards a formulaic plot or mediocrity)"}, "madsrdf:citationSource": "Erickson, M. Science, culture and society, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(space opera: A subgenre of \"soft\" science fiction especially popular between 1930-1960, often used in a derogatory sense. These space operas are novels or short stories set in the distant future after humanity has spent centuries or millennia colonizing the entire galaxy--or sometimes multiple galaxies. The narratives typically feature some form of easy space travel via imaginary technologies such as \"hyperspace drives\" or \"warp nacelles.\" This easy method of travel and colonization allows the formation of huge space fleets to fight each other using laser cannons and nuclear missiles. Behind these aramadas, vast interstellar empires compete with each other (or with rebel forces, or with alien species) for territorial control or political power. The stories often focus on characterization, drama, and (most especially) action rather than theme, symbolism or other literary devices)"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, Dec. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 35-37 (space opera; tales involving space flight, set aboard spaceships, stories about spaceships; variety of adventure story; space opera is primarily spaceship fiction, stories featuring spacecraft to a large extent and with the action frequently set on board such spacefaring vessels; the adventure genre that prefigures it is the sea story; space opera is a subgenre of sf; space-travel fiction)"}, "madsrdf:citationSource": "Space and beyond : the frontier theme in science fiction, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 134-135 (what science fiction literary critics call space opera, an extravagant adventure set against a fanciful interplanetary background, in which little attention is paid to scientific realism, and where much of the technology functions as if by magic but usually wrapped in the rhetoric of machinery; space opera fiction)"}, "madsrdf:citationSource": "Bainbridge, W.S. The virtual future, \u00a92011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 40 (The space opera: a renaissance in the subgenre of space opera, beginning in the 1980s, has produced some of the most complex and thought-provoking novels in the history of science fiction, though many recent works look back in a self-consciously nostalgic way to the swashbuckling action and larger-than-life heroes of the early space opera)"}, "madsrdf:citationSource": "Booker, M. The science fiction handbook, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Space flight (Fiction). Use: Science fiction; Voyages, Imaginary)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ch. 2 (\"Space opera\" by Alastair Reynolds: Colliding galaxies. Interstellar empires. Vast armadas of space battleships. Heroes and villains. The fates of entire societies - entire solar systems, entire federations of worlds - in perilous balance. Colour and exoticism. Alien cultures, machine civilizations. Deep time and deep space. Sweep and panache. SF in exuberant widescreen, with the volume turned up to eleven. Rayguns and robots. The term \"space opera\" was coined as a derogatory term but now has ceased to have overtly negative connotations; space opera is now an accepted marketing category for a particular sub-genre of SF; Space opera is essentially a form of adventure story in which space travel plays a critical element: it's not enough that a given work be set on an alien world; travel between worlds must figure in the action, ideally mediated by spaceship rather than astral travel or some other non-technological means, and the scope of that action will typically be interstellar)"}, "madsrdf:citationSource": "Strange divisions and alien territories, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66861071133949d69a65e53e2fb3586cb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Space operas"}}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Space operas"}}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66861071133949d69a65e53e2fb3586cb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Space travel fiction"}}, {"@id": "_:n66861071133949d69a65e53e2fb3586cb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Space travel fiction"}}], "@id": "/authorities/genreForms/gf2014026551"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026552", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpoken word poetry", "identifiers:lccn": "gf2014026552", "madsrdf:adminMetadata": [{"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b1"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Spoken word poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b3"}]}, "madsrdf:exampleNote": "Note under [Sound poetry]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b5"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b6"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b7"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b8"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b9"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b10"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b11"}], "madsrdf:hasVariant": [{"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b12"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry that is meant to be performed and that is heavily stressed, metrically regular, and characterized by improvisation, free association, and word play. For poetry meant to be performed that emphasizes sounds instead of the semantic meaning of the words themselves see [Sound poetry.]"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-14T12:45:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spoken word poetry"}}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(performance poetry: A form of poetry intended to be performed as a dramatic monologue or exchange and frequently involving improvisation.)"}, "madsrdf:citationSource": "Oxford dictionaries website, Sept. 28, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Fisher, M.T. Writing in rhythm : spoken word poetry in urban classrooms, c2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Spoken word poetry is poetry that is written on a page but performed for an audience. Because it is performed, this poetry tends to demonstrate a heavy use of rhythm, improvisation, free association, rhymes, rich poetic phrases, word play and slang. It is more aggressive and \"in your face\" than more traditional forms of poetry; spoken word poems are written to be performed)"}, "madsrdf:citationSource": "What is spoken word poetry?, via Nelson-Atkins Museum of Art website, Nov. 15, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Spoken word poetry. Here are entered works on poems that are meant to be performed and that are heavily stressed, metrically regular, and are characterized by improvisation, free association, and word play. Works on poems that are meant to be performed that emphasize sounds instead of semantics for their meaning are entered under Sound poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. opp. t.p. verso (\"This poem was written to be read aloud\") p. 4 of cover (Let Them Eat Chaos, Kate Tempest's new long poem written for live performance)"}, "madsrdf:citationSource": "Tempest, K. Let them eat chaos, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Performance poetry; poems designed expressly for live performance, often in collaborative or multimedia contexts that incorporates music, dance, or the visual arts)"}, "madsrdf:citationSource": "Encyclopedia of American poetry. The twentieth century, c2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Performance poetry might still be a niche concern, but Kate Tempest now gets to do hers on primetime TV - and deservedly so\"; \"on paper at least, Kate Tempest's new album still seems like a tough sell. It's a 48-minute long hip-hop-influenced performance poem about the alienated lives of the residents of one south London street\")"}, "madsrdf:citationSource": "Petridis, A. Kate Tempest: Let them eat chaos review - pop, poetry and politics collide, via The guardian website, posted 6 Oct. 2016, viewed on Sept. 28, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spoken word verse"}}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spoken word verse"}}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Performance poetry"}}, {"@id": "_:nf61b02aa0bde4c2fb2be44b631dca474b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Performance poetry"}}], "@id": "/authorities/genreForms/gf2014026552"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026553", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSports comics", "identifiers:lccn": "gf2014026553", "madsrdf:adminMetadata": [{"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb1"}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sports comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb5"}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb6"}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb7"}], "madsrdf:hasVariant": [{"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb8"}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sports comics"}}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "All-pro sports comics, c1991-", "madsrdf:citationStatus": "found"}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 177 (Sports Manga. Sports and competition is a big genre of manga. The emphasis is on the training, endurance, and end result of the competition.)"}, "madsrdf:citationSource": "Fletcher-Spear, K. Library collections for teens : manga and graphic novels, c2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 468 (Sports. In these graphic novel tales sports play a central role in the story to hook the reader in. Often the sport itself serves to reinforce common values, including teamwork, working to one's full potential, and playing fair. The sport itself may serve as a backdrop to teen-related issues such as relationships, friendship, and personal secrets.)"}, "madsrdf:citationSource": "Pawuk, M. Graphic novels : a genre guide to comic books, manga, and more, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sporting comics"}}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sporting comics"}}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sport comics"}}, {"@id": "_:n310017cbee28449e8d9c5ba738ebd70fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sport comics"}}], "@id": "/authorities/genreForms/gf2014026553"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026554", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpy comics", "identifiers:lccn": "gf2014026554", "madsrdf:adminMetadata": [{"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b1"}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Spy comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b5"}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b6"}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b7"}], "madsrdf:hasVariant": [{"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b8"}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spy comics"}}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Goodwin, A. X-9 Secret Agent Corrigan. Volume 4, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary note: Presents a collection World War II spy stories in graphic novel format)"}, "madsrdf:citationSource": "Kindt, M. Super spy, c2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 183 (in chapter entitled Action and Adventure: Spies/Espionage. These graphic novel tales involve spies, secret agents, and more, typically out to stop some fiendish James Bond-type villain aiming to control the world. Like the prose tales, spy films, and television shows such as the James Bond film series and the television show Alias and 24 that have helped to inspire the subgenre, the tales feature fast pacing, suspense, dangerous escapes, exotic locations, a dash of romance, and a heaping amount of dastardly villains.)"}, "madsrdf:citationSource": "Pawuk, M. Graphic novels : a genre guide to comic books, manga, and more, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Espionage comics"}}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Espionage comics"}}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cloak and dagger comics"}}, {"@id": "_:n8aa5bd789cab417eaabf830f624ba7a7b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cloak and dagger comics"}}], "@id": "/authorities/genreForms/gf2014026554"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026555", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpy fiction", "identifiers:lccn": "gf2014026555", "madsrdf:adminMetadata": [{"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b1"}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Spy fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b5"}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b6"}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b7"}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b8"}], "madsrdf:hasVariant": [{"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b9"}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spy fiction"}}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Spy stories. UF Cloak and dagger fiction; Espionage stories; Spy novels; Spy thrillers; Thrillers, Spy)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xxi (The dividing line between crime and espionage fiction is often hard to detect, and more strict delineations between genres are a relatively recent phenomenon; Espionage fiction, with its potentially wider canvas than crime novels, has been able to make more pertinent points about the society that produced it than most crime fiction; spy novel; spy story)"}, "madsrdf:citationSource": "British crime writing : an encyclopedia, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(spy fiction: novels of espionage, intrigue and violence, in which secret agent heroes battle against villainous spies)"}, "madsrdf:citationSource": "Concise Oxford companion to English literature, via Oxford reference online, Nov. 7, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Spy stories. Use for fiction dealing with espionage, secret agents, and secret service agencies. UF Spy novels; Espionage stories)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cloak and dagger fiction"}}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cloak and dagger fiction"}}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Espionage fiction"}}, {"@id": "_:nce66a9aecfc6486db2c7355fadce8b41b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Espionage fiction"}}], "@id": "/authorities/genreForms/gf2014026555"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026556", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStation drama", "identifiers:lccn": "gf2014026556", "madsrdf:adminMetadata": [{"@id": "_:n9706509800cb40bdb8420307d73c4a7fb1"}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Station drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9706509800cb40bdb8420307d73c4a7fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026313"}, "madsrdf:hasSource": [{"@id": "_:n9706509800cb40bdb8420307d73c4a7fb5"}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb6"}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb7"}], "madsrdf:hasVariant": [{"@id": "_:n9706509800cb40bdb8420307d73c4a7fb8"}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that consist of a series of fragmentary episodes in the life of the main character instead of narrative progression or plot."}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T15:56:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Station drama"}}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "index (Stationendrama, or station drama, or stationen-drama) v. 28, p. 594 (The action of many Expressionist plays was fragmented into a series of small scenes or episodes. This style of theatre was called Stationendrama (\"station drama\") and was clearly derived from the principles of the medieval mystery plays. This led to a consideration of the scene in the theatre as being self-contained. Significance and meaning derived from the juxtaposition or accumulation of scenes rather than from a continuous narrative progression from scene to scene, and from this it followed that there need be no consistency of setting.)"}, "madsrdf:citationSource": "Encyclopaedia Britannica, c2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Murpy, R. Theorizing the avant-garde, 1999: p. 80 (The expressionist \"Ich-Drama\" (\"drama of the self\") and \"Stationendrama\" (\"stations [of the cross]\") also takes on a fragmentary shape similar to a montage in both form and function. It is largely devoid of tension and linear \"plot\" (in the conventional sense of the term) and is frequently constructed instead according to spatial considerations: it commonly consists of a vaguely picaresque series of encounters, with a central figure wandering amongst reflections of his own persona on the path towars an undefined goal of redemption or enlightenment)", "madsrdf:citationStatus": "found"}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1373 (the \"station drama,\" a series of scenes one after the other. The explicit heading \"station\" in the text [of Ernst Toller's Die Wandlung] takes on an added meaning, suggesting that Friedrich's progress resembles the movement of Christ through the stations of the cross)"}, "madsrdf:citationSource": "The Columbia encyclopedia of modern drama, c2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9706509800cb40bdb8420307d73c4a7fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stationendrama"}}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stationendrama"}}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9706509800cb40bdb8420307d73c4a7fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stationen-drama"}}, {"@id": "_:n9706509800cb40bdb8420307d73c4a7fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stationen-drama"}}], "@id": "/authorities/genreForms/gf2014026556"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026557", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSteampunk comics", "identifiers:lccn": "gf2014026557", "madsrdf:adminMetadata": [{"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab1"}, {"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Steampunk comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026530"}, "madsrdf:hasSource": [{"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab5"}, {"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab6"}, {"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Science fiction comics set in the 19th century that feature steam-powered machinery and related technologies extrapolated from the science of that era."}, {"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T15:57:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Steampunk comics"}}, {"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(steampunk: by analogy to cyberpunk a genre of science fiction with a historical setting in the nineteenth century characterized by technologies extrapolated from the science of that era, but which were not invented at that time)"}, "madsrdf:citationSource": "Oxford dictionary of science fiction, via Oxford reference online, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 113 (Basic manga terms. steampunk: genre of speculative fiction represented in manga but also in text-only works, consisting of Victorian era settings melded with science fiction machinery.)"}, "madsrdf:citationSource": "Goldsmith, F. Readers' advisory guide to graphic novels, c2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n46b1c8094fff43c7b6b70138fdf5943ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(steampunk: a genre of science fiction that typically features steam-powered machinery rather than advanced technology)"}, "madsrdf:citationSource": "Oxford dictionary of English, via Oxford reference online, Nov. 5, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026557"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026558", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSteampunk fiction", "identifiers:lccn": "gf2014026558", "madsrdf:adminMetadata": [{"@id": "_:n4c318540c79d46cd8b10433b6627f42bb1"}, {"@id": "_:n4c318540c79d46cd8b10433b6627f42bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Steampunk fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4c318540c79d46cd8b10433b6627f42bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026529"}, "madsrdf:hasSource": [{"@id": "_:n4c318540c79d46cd8b10433b6627f42bb5"}, {"@id": "_:n4c318540c79d46cd8b10433b6627f42bb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Science fiction set in the 19th century that features steam-powered machinery and related technologies extrapolated from the science of that era."}, {"@id": "_:n4c318540c79d46cd8b10433b6627f42bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T15:58:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4c318540c79d46cd8b10433b6627f42bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4c318540c79d46cd8b10433b6627f42bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Steampunk fiction"}}, {"@id": "_:n4c318540c79d46cd8b10433b6627f42bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(steampunk: by analogy to cyberpunk a genre of science fiction with a historical setting in the nineteenth century characterized by technologies extrapolated from the science of that era, but which were not invented at that time)"}, "madsrdf:citationSource": "Oxford dictionary of science fiction, via Oxford reference online, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c318540c79d46cd8b10433b6627f42bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(steampunk: a genre of science fiction that typically features steam-powered machinery rather than advanced technology)"}, "madsrdf:citationSource": "Oxford dictionary of English, via Oxford reference online, Nov. 5, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026558"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026559", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStories in rhyme", "identifiers:lccn": "gf2014026559", "madsrdf:adminMetadata": [{"@id": "_:nbb0db2184d684271a9eb912a2951d646b1"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Stories in rhyme"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbb0db2184d684271a9eb912a2951d646b3"}]}, "madsrdf:exampleNote": "Note under [Novels in verse]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026448"}], "madsrdf:hasSource": [{"@id": "_:nbb0db2184d684271a9eb912a2951d646b5"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b6"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b7"}], "madsrdf:hasVariant": [{"@id": "_:nbb0db2184d684271a9eb912a2951d646b8"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b11"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b14"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short fictional works written in rhymed text. For novel-length fictional narratives expressed in poetry see [Novels in verse.]"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:24:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories in rhyme"}}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dr. Seuss did it, and in the process changed the face of the publishing industry and became a beloved household name to children for several generations. Stories in verse, like their prose counterparts, also must have a distinct voice. The rhythm of the verse, which combines elements like word choice and length of the lines, goes a long way toward creating a tone for each story.)"}, "madsrdf:citationSource": "Backes, L. Writing in rhyme, 2009, via WWW July 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Stories in rhyme. Here are entered short fictional works written in rhymed text. Novel-length fictional narratives expressed in poetry are entered under Novels in verse.)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A child's book world without rhyme would be like a world without music. Good rhyme is fun to read out loud. Good rhyme is enjoyable to listen to. But a good rhyming story can be difficult to write. And that's what this article is about--the layers that go into writing good rhyming stories--and they are: Story, Rhythm, Rhyme. Instead of calling them rhyming stories, more accurately we might call them stories in rhythm and rhyme.)"}, "madsrdf:citationSource": "Chaconas, D. Icing the cake : writing stories in rhythm and rhyme, 2006, via WWW, July 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb0db2184d684271a9eb912a2951d646b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rhymed stories"}}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rhymed stories"}}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb0db2184d684271a9eb912a2951d646b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories in verse"}}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories in verse"}}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb0db2184d684271a9eb912a2951d646b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Verse stories"}}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verse stories"}}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb0db2184d684271a9eb912a2951d646b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rhyming stories"}}, {"@id": "_:nbb0db2184d684271a9eb912a2951d646b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rhyming stories"}}], "@id": "/authorities/genreForms/gf2014026559"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026560", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStrambotti", "identifiers:lccn": "gf2014026560", "madsrdf:adminMetadata": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b1"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Strambotti"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b5"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b6"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b7"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b8"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b9"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b10"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b11"}], "madsrdf:hasVariant": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b12"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b15"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b18"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b21"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b24"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b27"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b30"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b33"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b36"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b39"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b42"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b45"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b48"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems consisting of six or eight 11-syllable lines."}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T15:58:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Strambotti"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Strambotto)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "strambotto (A monostrophic It. composition generally of eight or six hendecasyllables (less commonly of four or ten); rhymes are sentimental and amatory; number of verses and the characteristic rhyme scheme vary from region to region; Sicilian strambotto has the pattern abababab; the Tuscan variety (ottava toscana or rispetto) has several, abababcc, ababccdd, aabbccdd, ababcc, ababab, and aabbcc) rispetto (An It. stanza of variable length, usually ranging from 6 to 12 lines in hendecasyllables, but most commonlyan octave rhyming abababcc, and for this reason often confused with the Sicilian octave (abababab) and the Tuscan variety of the strambotto; some variation in the form occurs in the last four verses or ripresa, which came to have two rhyming couplets of different rhymes, giving ababccdd) ottava rima (ottava rima (or ottava toscana) originated as an Italian prosody, an octave stanza in hendecasyllables rhyming abababcc; see [also] Sicilian octave]) Sicilian octave (ottava siciliana or napoletana); an eight-line It. stanza rhyming abababab and composed of hendecasyllables)"}, "madsrdf:citationSource": "Princeton encyclopedia of poetry and poetics, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(napolitana: a simple madrigal originating in 16th century Naples and similar to the villanella in style; also napoletana)"}, "madsrdf:citationSource": "Merriam-Webster online, Aug. 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(napoletana f (plural napoletane); rispetto m (plural rispetti))"}, "madsrdf:citationSource": "Wiktionary, Aug. 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 266 (The Sicilian octave, in iambic pentameter, rhymes abababab. The strambotto is a Sicilian octave written in hendecasyllabic lines.)"}, "madsrdf:citationSource": "Turco, L. The book of forms, c2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(strambotto: One of the oldest of Italian verse forms, it is a one-stanza composition in hendecasyllables; usually either an octave or a sestet. See ottava rima, rispetto, Sicilian octave, sonnet; Sicilian octave: An eight-line Italian stanza (rhyming abababab) of hendecasyllabic verses. Also called strambotto popolare; related to the medieval French estrabot and to ottava rima, which may have developed from it; rispetto: An eight-line stanza, usually rhyming abababcc)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(strambotto (plural -otti) A short Italian poem meant to be set to music, and usually taking the form of eight rhymed hendecasyllabic lines, although some are of six lines. In the most common form, known as the Sicilian octave (ottava siciliana), the rhyme scheme is abababab, but there are others including the Tuscan octave (ottava tuscana) with the scheme abababcc. This kind of octave is sometimes divided into two quatrains. An alternative name for it, principally in Tuscany, is the rispetto.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Octava rimas"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Octava rimas"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tuscan octaves"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tuscan octaves"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ottava toscanas"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ottava toscanas"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Octaves, Sicilian"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Octaves, Sicilian"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Napoletani, Ottave"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Napoletani, Ottave"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ottave toscane"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ottave toscane"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Octaves, Tuscan"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Octaves, Tuscan"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ottave siciliane"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ottave siciliane"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sicilian octaves"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sicilian octaves"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ottave napoletani"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ottave napoletani"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b42", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b43"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ottava rimas"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b43", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ottava rimas"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b45", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b46"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Strambotti popolari"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b46", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Strambotti popolari"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b48", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b49"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rispetti"}}, {"@id": "_:n8bbfb8ce6c9d42be9ced088c47cc9432b49", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rispetti"}}], "@id": "/authorities/genreForms/gf2014026560"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026561", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStream of consciousness fiction", "identifiers:lccn": "gf2014026561", "madsrdf:adminMetadata": [{"@id": "_:n597af9deea404a6885954c569d40140bb1"}, {"@id": "_:n597af9deea404a6885954c569d40140bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Stream of consciousness fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n597af9deea404a6885954c569d40140bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026492"}, "madsrdf:hasSource": [{"@id": "_:n597af9deea404a6885954c569d40140bb5"}, {"@id": "_:n597af9deea404a6885954c569d40140bb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features a character's perceptions, thoughts, and memories in an apparently random order."}, {"@id": "_:n597af9deea404a6885954c569d40140bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T15:58:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n597af9deea404a6885954c569d40140bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n597af9deea404a6885954c569d40140bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stream of consciousness fiction"}}, {"@id": "_:n597af9deea404a6885954c569d40140bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(stream of consciousness, narrative technique intended to render the flow of myriad impressions--visual, auditory, physical, associative, and subliminal--that impinge on the consciousness of an individual and form part of his awareness along with the trend of his rational thoughts; the stream-of-consciousness novel commonly uses the narrative techniques of interior monologue.)"}, "madsrdf:citationSource": "Britannica online academic edition, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n597af9deea404a6885954c569d40140bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(stream of consciousness: writing in which a character's perceptions, thoughts, and memories are presented in an apparently random form, without regard for logical sequence, chronology, or syntax. Often such writing makes no distinction between various levels of reality--such as dreams, memories, imaginative thoughts or real sensory perception. William James coined the phrase \"stream of consciousness\" in his Principles of Psychology (1890). The technique has been used by several authors and poets: Katherine Anne Porter, Dorothy Richardson, James Joyce, Virginia Woolf, T. S. Eliot, and William Faulkner)"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, Jan. 3, 2013", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026561"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026562", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSuperhero comics", "identifiers:lccn": "gf2014026562", "madsrdf:adminMetadata": [{"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b1"}, {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Superhero comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b5"}, {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b6"}, {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b7"}], "madsrdf:hasVariant": {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Superhero comics"}}, {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Best superhero/supervillain comics, via Goodreads website, Dec. 6, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 39-41 (Graphic novels come in all genres, both fiction and nonfiction--superhero, adventure, mystery, science fiction, fantasy, crime, true crime, horror, romance, historical fiction, historical nonfiction, biography, autobiography, memoir, and more; Superhero. The vast majority of trades are in the superhero genres, with over 70 years worth of stories available) p. 53 (The term can also be written as \"super-hero\" or \"super hero\")"}, "madsrdf:citationSource": "Serchay, D.S. The librarian's guide to graphic novels for adults, c2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Superhero: A superhero is a character who is noted for feats of courage and nobility and who usually has a colorful name and costume which serve to conceal their true identity, and abilities beyond those of normal human beings. A female superhero is sometimes called a superheroine, although this term has fallen out of favor in the modern era. The word superhero originated with Superman, who debuted in 1938, and the stories of superheroes - ranging from episodic adventures to decades-long sagas - have become an entire genre of fiction that has dominated American comic books and crossed over into several other media; Supervillain: A supervillain is a variant of the villain character type, commonly found in comic books. Supervillains concoct complex and ambitious schemes to accumulate power and suppress adversaries. They often have colorful names and costumes and/or other eccentricities. Female supervillains are sometimes known as supervillainesses. Supervillains are often used as foils to superheroes and other fictional heroes. Their extraordinary brainpower and/or superhuman abilities make them viable antagonists for the most gifted heroes.)"}, "madsrdf:citationSource": "Marvel database, via WWW, Dec. 6, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supervillain comics"}}, {"@id": "_:n72be93fdafff457aa7d752b0e5d51b58b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supervillain comics"}}], "@id": "/authorities/genreForms/gf2014026562"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026563", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aThriller comics", "identifiers:lccn": "gf2014026563", "madsrdf:adminMetadata": [{"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b1"}, {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Thriller comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b5"}, {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b6"}, {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b7"}], "madsrdf:hasVariant": {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thriller comics"}}, {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Pawuk, M. Graphic novels : a genre guide to comic books, manga, and more, 2007;Miller, S. Developing and promoting graphic novel collections, c2005;Goldsmith, F. Graphic novels now, 2005;Lyga, A.A.W. Graphic novels in your media center, 2004;Serchay, D.S. The librarian's guide to graphic novels for adults, c2010;Karp, J. Graphic novels in your school library, 2012", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Suspense comic books, strips, etc. UF Thriller comic books, strips, etc.)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 39 (Suspense and Thriller; this genre is richly represented in fine--and not so fine--graphic novels)"}, "madsrdf:citationSource": "Goldsmith, F. The readers' advisory guide to graphic novels, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suspense comics"}}, {"@id": "_:nfe298d70d1a847a68609ccb8a230ae36b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suspense comics"}}], "@id": "/authorities/genreForms/gf2014026563"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026565", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTall tales", "identifiers:lccn": "gf2014026565", "madsrdf:adminMetadata": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b1"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tall tales"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026377"}, "madsrdf:hasSource": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b5"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b6"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b7"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b8"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b9"}], "madsrdf:hasVariant": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b10"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b13"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b16"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b19"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b22"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b25"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b28"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b31"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b34"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b37"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Outlandish or improbable stories of humorously exaggerated feats."}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T15:59:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tall tales"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tall story. A story which is extravagant, outlandish or highly improbable. Usually regarded as false, however good it may be. They are of the same family as fantasy and fairy tale. The epic tradition, and especially the primary epic, contains a good many episodes which are classifiable as tall stories)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tall tales. UF Bragging tales; Lying tales; Tall talk; Windies (Tales). Here are entered collections of tales characterized by their quality of bragging and exaggeration of the truth)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tall tale: narrative that depicts the extravagantly exaggerated wild adventures of North American folk heroes)"}, "madsrdf:citationSource": "Merriam-Webster's encyclopedia of literature, c1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tall tale (tall story). A humorously exaggerated story of impossible feats. Several tall stories attributed to the German Baron M\u00fcnchhausen appeared in the 1780s, but the form flourished in the oral tradition of the American frontier in the 19th century, several tall tales being published by Mark Twain, George Washington Harris, and others.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "fish story (an exaggerated story : a story that is so strange or surprising that it seems very unlikely to be true)"}, "madsrdf:citationSource": "Merriam Webster online, Aug. 27, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tall talk"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tall talk"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lying tales"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lying tales"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tales, Tall"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tales, Tall"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tall stories"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tall stories"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bragging tales"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bragging tales"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tales, Bragging"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tales, Bragging"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories, Tall"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories, Tall"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Windies (Tales)"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Windies (Tales)"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fish stories (Tall tales)"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fish stories (Tall tales)"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tales, Lying"}}, {"@id": "_:n3eb4652e33af4ebc8e0a1b2d69475c14b38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tales, Lying"}}], "@id": "/authorities/genreForms/gf2014026565"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026566", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTanka", "identifiers:lccn": "gf2014026566", "madsrdf:adminMetadata": [{"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb1"}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tanka"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026399"}, "madsrdf:hasSource": [{"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb5"}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb6"}], "madsrdf:hasVariant": [{"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb7"}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems consisting of 31 syllables arranged in lines of five, seven, five, seven, and seven syllables."}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:27:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tanka"}}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tanka (also called waka or uta). A Japanese form originating in the 7th c. which consists of 31 morae (conventionally construed syllables) in lines of 5, 7, 5, 7, and 7. Hypersyllabic but not hyposyllabic lines are allowed; these \"short poems\" have been the premier Japanese form for centuries)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993, via Literature online, Feb. 15, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tanka. A Japanese lyric form of thirty-one syllables, in lines of five/seven/five/seven/seven syllables. Also known as a Waka or an uta, it originated in the 7th c. and is regarded as the classic Japanese poetic form. It has not has so much influence on Western poetry as the haiku.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Waka"}}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Waka"}}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Uta"}}, {"@id": "_:n7dd973cff9f04757bde0d5405ec24b3cb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Uta"}}], "@id": "/authorities/genreForms/gf2014026566"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026567", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTa\u02bbziyah", "identifiers:lccn": "gf2014026567", "madsrdf:adminMetadata": [{"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b1"}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ta\u02bbziyah"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026501"}, "madsrdf:hasSource": [{"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b5"}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b6"}], "madsrdf:hasVariant": [{"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b7"}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b10"}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b13"}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b16"}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b19"}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Shiite passion plays that reenact the martyrdom of the Prophet Mu\u1e25ammad's grandson \u1e24usayn."}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T15:59:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ta\u02bbziyah"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ta\u02bbz\u012byah. The Sh\u012b\u02bb\u012b passion play called ta\u02bbz\u012byah is the only serious drama that developed in the Islamic world; mainly performed in Iran; reenactment of the passion and death of \u1e24usayn, grandson of the Prophet Mu\u1e25ammad and third imam of the Sh\u012b\u02bbah; protagonists sing their parts, whereas antagonists recite their lines; ta\u02bbz\u012byah is musical drama)"}, "madsrdf:citationSource": "The Oxford encyclopedia of the Islamic world, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ta\u02bczia, taziyeh, ta\u02bcziya. Literally: consolation. An Iranian ritual drama enacting the martyrdom of Husain, youngest son of Ali, the latter the son-in-law of Mohammed)"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Passion plays, Shiite"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Passion plays, Shiite"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shiite passion plays"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shiite passion plays"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Taziyeh"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Taziyeh"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ta\u02bbzieh"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ta\u02bbzieh"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ta\u02bbziya"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ta\u02bbziya"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ta\u02bbzia"}}, {"@id": "_:nd6cf11b5b2784553a35a4b6df5c65687b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ta\u02bbzia"}}], "@id": "/authorities/genreForms/gf2014026567"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026568", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision plays", "identifiers:lccn": "gf2014026568", "madsrdf:adminMetadata": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb1"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb5"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb6"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb7"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb8"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb9"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb10"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb11"}], "madsrdf:hasVariant": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb12"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb15"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb18"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb21"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb24"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb27"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb30"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb33"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Scripts of fiction television programs."}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:00:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television plays"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Whitcomb, C. The writer's guide to writing your screenplay : how to write great screenplays for movies and television, c2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Top shelf 2 : five outstanding television screenplays, 2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A screenplay or script is a written work by screenwriters for a film or television program. These screenplays can be original works or adaptations from existing pieces of writing. In them, the movement, actions, expression, and dialogues of the characters are also narrated. A play for television is also known as a teleplay. The major components are action and dialogue. The \"action\" is written in the present tense. The \"dialogue\" is the lines the characters speak. Unique to the screenplay (as opposed to a stage play) is the use of slug lines.)"}, "madsrdf:citationSource": "Wikipedia, Oct. 27, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(teleplay 1. Script for a television movie or series episode. 2. The TV production itself; a television play.)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dictionary, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(entry under television drama; TV plays; TV dramas; television plays)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Armer, A.A. Vest pocket theatre : twenty tested television playlets, 1955.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Television plays. UF Television drama. RT Television scripts)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "TV plays"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "TV plays"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Screen plays, Television"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Screen plays, Television"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television screenplays"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television screenplays"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Screenplays, Television"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Screenplays, Television"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Teleplays"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Teleplays"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television drama (Screenplays)"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television drama (Screenplays)"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television screen plays"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television screen plays"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "TV drama (Screenplays)"}}, {"@id": "_:nbfd9e7d054c34c12b5da68e590a5ca2fb34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "TV drama (Screenplays)"}}], "@id": "/authorities/genreForms/gf2014026568"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026569", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTen-minute plays", "identifiers:lccn": "gf2014026569", "madsrdf:adminMetadata": [{"@id": "_:n8afeb62adce845c2b4b59b84a7701386b1"}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ten-minute plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8afeb62adce845c2b4b59b84a7701386b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026462"}, "madsrdf:hasSource": [{"@id": "_:n8afeb62adce845c2b4b59b84a7701386b5"}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b6"}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b7"}], "madsrdf:hasVariant": [{"@id": "_:n8afeb62adce845c2b4b59b84a7701386b8"}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b11"}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b14"}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ten-minute plays"}}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "section 1 (Ten-minute one-act plays) section 2 (Longer one-act plays)"}, "madsrdf:citationSource": "The art of the one-act, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Playwright: Play formats: 10-minute play: Popularized over the past 20 years and now a staple of most play festivals, and many play contests. Takes on a number of approaches from traditional conflict-driven to very experimental. Useful in playwriting workshops and with beginning playwrights since the format requires rigor, yet can be processed or produced without onerous technical requirements; under One-act play: In recent years, the 10-minute play known as \"flash drama\" has emerged as a popular sub-genre of the one-act play, especially in writing competitions; under Flash drama: Flash drama is a type of theatrical play that does not exceed ten minutes in duration. Groups of four to six flash drama plays are popular with school, university and community drama companies since they offer a wide variety of roles and situations in a single performance. There are no set rules for flash plays but the typical play has certain characteristics, such as: Consisting of one act; Utilising one to three characters; Simple, if any, set design)"}, "madsrdf:citationSource": "Wikipedia, Oct. 30, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Glossary (Ten-Minute Play: A complete play, with a beginning, middle and end, designed to play in ten minutes.)"}, "madsrdf:citationSource": "Dorf, J. Playwriting 101, via WWW, Oct. 30, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8afeb62adce845c2b4b59b84a7701386b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ten-minute drama"}}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ten-minute drama"}}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8afeb62adce845c2b4b59b84a7701386b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "10-minute plays"}}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "10-minute plays"}}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8afeb62adce845c2b4b59b84a7701386b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Flash plays"}}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flash plays"}}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8afeb62adce845c2b4b59b84a7701386b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Flash drama"}}, {"@id": "_:n8afeb62adce845c2b4b59b84a7701386b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flash drama"}}], "@id": "/authorities/genreForms/gf2014026569"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026570", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTerza rima", "identifiers:lccn": "gf2014026570", "madsrdf:adminMetadata": [{"@id": "_:n7e9d6c28f114418bbfaecbf336094a29b1"}, {"@id": "_:n7e9d6c28f114418bbfaecbf336094a29b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Terza rima"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7e9d6c28f114418bbfaecbf336094a29b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n7e9d6c28f114418bbfaecbf336094a29b5"}, {"@id": "_:n7e9d6c28f114418bbfaecbf336094a29b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems composed of tercets in which the end word of the second line in one tercet supplies the rhyme for the first and third lines in the following tercet."}, {"@id": "_:n7e9d6c28f114418bbfaecbf336094a29b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7e9d6c28f114418bbfaecbf336094a29b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:00:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7e9d6c28f114418bbfaecbf336094a29b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Terza rima"}}, {"@id": "_:n7e9d6c28f114418bbfaecbf336094a29b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(terza rima: (It 'third rhyme' The measure adopted by Dante for his Divina Commedia, consisting of a series of interlocking tercets in which the second line of one rhymes with the first and third lines of the one succeeding, thus: aba, bcb, cdc)"}, "madsrdf:citationSource": "Cuddon, J. Dictionary of literary terms and literary theory, 5th ed., via Wiley online library, Aug. 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e9d6c28f114418bbfaecbf336094a29b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetic Form: Terza Rima--Invented by the Italian poet Dante Alighieri in the late thirteenth century to structure his three-part epic poem, The Divine Comedy, terza rima is composed of tercets woven into a rhyme scheme that requires the end-word of the second line in one tercet to supply the rhyme for the first and third lines in the following tercet. Thus, the rhyme scheme (aba, bcb, cdc, ded) continues through to the final stanza or line. Terza rima is typically written in an iambic line, and in English, most often in iambic pentameter. If another line length is chosen, such as tetrameter, the lines should be of the same length. There are no limits to the number of lines a poem composed in terza rima may have.)"}, "madsrdf:citationSource": "Poets.org, viewed Dec. 26, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026570"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026571", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aThrillers (Fiction)", "identifiers:lccn": "gf2014026571", "madsrdf:adminMetadata": [{"@id": "_:n737d28abb4334709800c4d8e5af487d2b1"}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Thrillers (Fiction)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n737d28abb4334709800c4d8e5af487d2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n737d28abb4334709800c4d8e5af487d2b5"}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b6"}], "madsrdf:hasVariant": [{"@id": "_:n737d28abb4334709800c4d8e5af487d2b7"}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction in which the reader is kept on tenterhooks by plots that feature a build-up of suspense, tension, uncertainty, menace, and anxiety."}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:01:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thrillers (Fiction)"}}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p.141 (Legal thrillers are crime stories featuring a lawyer, law student, or judge as the main character. Although they include some detective work, typically these courtroom dramas involve the ingenuity of the attorney in extricating himself or herself from a setup or significant legal troubles threatening his or her law firm and personal integrity.) p. 170 (The legal thriller achieved great prominence in the 1990s. Scott Turow, John Grisham, and Steve Martini all made it to the bestseller lists with their crime novels that feature lawyers. However, the legal thriller's emphasis is not necessarily on detection but rather the crafty attorney's abilities to extricate himself, herself, or others from danger.)"}, "madsrdf:citationSource": "Herald, D. Genreflecting, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 71 (the thriller genre focuses on a particular profession--espionage, medicine, or the law, for example--and tells an action-packed story that reveals the intricacies of that profession and the potential dangers faced by those involved in it) p.72 (distinguishing feature in a thriller is the frame of the story, the details of the profession, and the way in which the hero uses his skill and knowledge within that profession to extricate himself from a dangerous situation) p. 73 (characteristics of thrillers: rapid pace; extensive details and technical language related to each profession; often a political focus with either national or international ramifications and hot topics from the news are frequently explored here) pp. 82-83 (key thriller authors: David Baldacci; Tess Gerritsen; Lisa Scottoline; Daniel Silva; John Grisham; Robin Cook; Michael Crichton)"}, "madsrdf:citationSource": "Saricks, J.G. Readers' advisory to genre fiction, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n737d28abb4334709800c4d8e5af487d2b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suspense fiction"}}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suspense fiction"}}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n737d28abb4334709800c4d8e5af487d2b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Thriller fiction"}}, {"@id": "_:n737d28abb4334709800c4d8e5af487d2b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thriller fiction"}}], "@id": "/authorities/genreForms/gf2014026571"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026572", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEight-pagers (Comic books)", "identifiers:lccn": "gf2014026572", "madsrdf:adminMetadata": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b1"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Eight-pagers (Comic books)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026376"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026485"}], "madsrdf:hasEarlierEstablishedForm": {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b5"}, "madsrdf:hasSource": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b8"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b9"}], "madsrdf:hasVariant": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b10"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b13"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b16"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b19"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b22"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b25"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b28"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b31"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b34"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b37"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b40"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Small, oblong pornographic comics clandestinely published in the United States between the 1920s and 1960s that usually parodied popular newspaper comic strip characters or celebrities."}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-03-03T09:03:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Eight-pagers (Comic books)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tijuana bibles"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tijuana bibles"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tijuana bible. Tijuana bibles (also known as eight-pagers, bluesies, gray-backs, Jiggs-and-Maggie books, jo-jo books, Tillie-and-Mac books, and two-by-fours) were little pornographic comic books produced in the United States from the 1920s to the early 1960s. Their popularity peaked during the Great Depression era. The typical \"bible\" was an eight-panel comic strip in a wallet-size 2.5x4 inch format (approximately 7x10.5 cm) with black print on cheap white paper and running eight pages in length. Illegal, clandestine, and anonymous, the artists, writers, and publishers of these booklets are generally unknown. Most Tijuana bibles were obscene parodies of popular newspaper comic strips of the day, like \"Blondie\", \"Barney Google\", \"Moon Mullins\", \"Popeye\", \"Tillie the Toiler\", \"Dick Tracy\", \"Little Orphan Annie\", \"Bringing Up Father\", \"Dixie Dugan\", and \"Mutt and Jeff\". Others made use of characters based on popular movie stars and sports stars of the day, like Mae West and Joe Louis, sometimes with names thinly changed to (presumably) avoid libel. Before the war almost all the stories were humorous and frequently were cartoon versions of well-known dirty jokes that had been making the rounds for decades.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 4, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tijuana bibles. Use for small, oblong comic books, clandestinely published in the U.S. between the 1930s and 1950s and parodying figures of popular culture in explicit sexual situations. UF Bluesies; Eight-pagers; Sixteen-pagers. BT Comic books)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Dec. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jo-jo books"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jo-jo books"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gray-backs (Eight-pagers)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gray-backs (Eight-pagers)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Two-by-fours (Eight-pagers)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Two-by-fours (Eight-pagers)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tijuana bibles"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tijuana bibles"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bibles, Tijuana (Eight-pagers)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bibles, Tijuana (Eight-pagers)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tillie & Mac books"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tillie & Mac books"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jiggs-and-Maggie books"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jiggs-and-Maggie books"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tillie-and-Mac books"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tillie-and-Mac books"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tijuana bibles (Eight-pagers)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tijuana bibles (Eight-pagers)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sixteen-pagers (Eight-pagers)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sixteen-pagers (Eight-pagers)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b40", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b41"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bluesies (Eight-pagers)"}}, {"@id": "_:ndd89e69b8f894d0f95a3293bcae23a39b41", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bluesies (Eight-pagers)"}}], "@id": "/authorities/genreForms/gf2014026572"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026573", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTime-travel fiction", "identifiers:lccn": "gf2014026573", "madsrdf:adminMetadata": [{"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb1"}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Time-travel fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026529"}, "madsrdf:hasSource": [{"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb5"}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb6"}], "madsrdf:hasVariant": [{"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb7"}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Time-travel fiction"}}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Time travel (Fiction). Use: Fantasy fiction; Science fiction; Voyages, Imaginary)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 15 (the time-travel narrative: a paradigmatic science fictional form; the time travel motif also presents extensive opportunities for humor and satire, giving the genre a particularly wide range; indeed the flexibility of the time-travel story has made it a favorite science fiction subgenre on television and in film, as well as in the novel and short story; narratives involving travel through time represent one of the oldest subgenres in all science fiction; early examples include Irving's \"Rip Van Winkle\" (1819), Bellamy's utopian classic Looking Backward (1888) and Twain's A Connecticut Yankee in King Arthur's Court (1889); however the true founding text of the genre is probably Wells's classic novel The Time Machine (1895), the first genuinely science fictional exploration of time travel in book-length form)"}, "madsrdf:citationSource": "Booker, M. The science fiction handbook, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Time-travel narratives"}}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Time-travel narratives"}}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Narratives, Time-travel"}}, {"@id": "_:nba9c934fbc4c4f67be46eb8c1d50403fb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Narratives, Time-travel"}}], "@id": "/authorities/genreForms/gf2014026573"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026574", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aToasts (Poetry)", "identifiers:lccn": "gf2014026574", "madsrdf:adminMetadata": [{"@id": "_:n357f16ec531d4db4b35c58178359fbcab1"}, {"@id": "_:n357f16ec531d4db4b35c58178359fbcab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Toasts (Poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n357f16ec531d4db4b35c58178359fbcab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026343"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026448"}], "madsrdf:hasSource": [{"@id": "_:n357f16ec531d4db4b35c58178359fbcab5"}, {"@id": "_:n357f16ec531d4db4b35c58178359fbcab6"}, {"@id": "_:n357f16ec531d4db4b35c58178359fbcab7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Narrative poems from the African American oral tradition that are usually rhymed, rhythmic, epical representations of extended conflicts between protagonists, expressed in nonstandard Black English, created for and during male recitative performances."}, {"@id": "_:n357f16ec531d4db4b35c58178359fbcab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:03:06"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n357f16ec531d4db4b35c58178359fbcab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n357f16ec531d4db4b35c58178359fbcab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Toasts (Poetry)"}}, {"@id": "_:n357f16ec531d4db4b35c58178359fbcab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Toasts\" are performed narratives of often urban but always heroic events. For many Blacks, both performers and audience, hearing about or performing the winning ways of the central character becomes as creative a release as Black music. Toasting is today's continuance of an oral tradition, but many contemporary toasters read their complicated and elaborate versions from a text. As with any oral tradition, many versions of the same toast exist. The toast is a dynamic performance within the Black community of recognizable and popular central characters. They are performed in bars, libraries, community centers, and even college campuses. However, less explicit toasts are performed by anyone at any time for entertainment.)"}, "madsrdf:citationSource": "Saloy, M.L. The African American toast tradition, via Louisiana's living traditions website, Aug. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n357f16ec531d4db4b35c58178359fbcab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Get Your Ass in the Water and Swim Like Me: Narrative Poetry From Black Oral Tradition,\" a book collected and compiled by SUNY Distinguished Professor Bruce Jackson, is back for a second go 'round. The book collects a popular form of African-American literature and folk poetry known as \"toasts.\" \"Toasts are just one aspect of a rich tradition of verbal arts in black culture,\" Jackson says. \"Public performance of rhyming verse has ancient African roots. And we see it now in rap and hip-hop, which are a mix of African American, Caribbean and several other traditions.)"}, "madsrdf:citationSource": "Donovan, P. Jackson's classic collection of black \"toasts\" is resurrected, in UB reporter, May 20, 2004, viewed online Aug. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n357f16ec531d4db4b35c58178359fbcab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Toasts (African American folk poetry). BT American poetry--African American authors; Folk poetry, American; Narrative poetry, American. Scope note: Here are entered narrative poems from the African American oral tradition that are usually rhymed, rhythmic, epical representations of extended conflicts between protagonists, expressed in nonstandard Black English, created for and during male recitative performances.)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026574"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026575", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTongue twisters", "identifiers:lccn": "gf2014026575", "madsrdf:adminMetadata": [{"@id": "_:n2b63d64e37114af4a114edd30f3576f0b1"}, {"@id": "_:n2b63d64e37114af4a114edd30f3576f0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tongue twisters"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2b63d64e37114af4a114edd30f3576f0b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026342"}], "madsrdf:hasSource": [{"@id": "_:n2b63d64e37114af4a114edd30f3576f0b5"}, {"@id": "_:n2b63d64e37114af4a114edd30f3576f0b6"}], "madsrdf:hasVariant": {"@id": "_:n2b63d64e37114af4a114edd30f3576f0b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Words or phrases that are difficult to articulate correctly due to a rapid succession of similar consonant sounds."}, {"@id": "_:n2b63d64e37114af4a114edd30f3576f0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2b63d64e37114af4a114edd30f3576f0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:04:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2b63d64e37114af4a114edd30f3576f0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tongue twisters"}}, {"@id": "_:n2b63d64e37114af4a114edd30f3576f0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tongue twister: a word or group of words difficult to articulate rapidly, usually because of a succession of similar consonantal sounds)"}, "madsrdf:citationSource": "The American heritage dictionary of the English language, c2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b63d64e37114af4a114edd30f3576f0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tongue-twister: Associated with nonsense verse, nursery rhyme and patter songs; the tongue-twister is an alliterative jingle of some antiquity. Also known as a tongue-tripper.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms, c1976", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b63d64e37114af4a114edd30f3576f0b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b63d64e37114af4a114edd30f3576f0b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tongue-trippers"}}, {"@id": "_:n2b63d64e37114af4a114edd30f3576f0b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tongue-trippers"}}], "@id": "/authorities/genreForms/gf2014026575"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026576", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTragedies (Drama)", "identifiers:lccn": "gf2014026576", "madsrdf:adminMetadata": [{"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b1"}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tragedies (Drama)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026367"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026508"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026003"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026577"}, "madsrdf:hasSource": [{"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b5"}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b6"}], "madsrdf:hasVariant": [{"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b7"}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-19T16:07:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tragedies (Drama)"}}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tragedy; Greek dramatic tragedy; tragedy has tended to be a form of drama concerned with the fortunes and misfortunes, and, ultimately, the disasters, that befall human beings of title, power and position; the overwhelming part about tragedy is the element of hopelessness, of inevitability; the concept of tragedy has changed greatly since the 16th c. The scale and tone of tragedy or anything resembling it has been modified. We now have the grief, the misery, the disaster, of the ordinary man.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tragedy: A serious play (or, by extension, a novel) representing the disastrous downfall of a central character, the protagonist. In some ancient Greek tragedies a happy ending was possible, provided that the subject was mythological and treatment dignified, but the more usual conclusion, involving the protagonist's death, has become the defining feature in later uses of the term. Until the beginning of the 18th century, tragedies were written in verse, and usually dealt with the fortunes of royal families or other political leaders. Modern tragic drama, however, normally combines the socially inferior protagonist of domestic tragedy with the use of prose)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramatic tragedies"}}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramatic tragedies"}}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tragic drama"}}, {"@id": "_:nb1b7ae4bc97d431d9f0b971a48592a09b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tragic drama"}}], "@id": "/authorities/genreForms/gf2014026576"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026577", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTragicomedies", "identifiers:lccn": "gf2014026577", "madsrdf:adminMetadata": [{"@id": "_:nb4d9141663bc4962887927ec04e27999b1"}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tragicomedies"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb4d9141663bc4962887927ec04e27999b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasReciprocalAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026576"}], "madsrdf:hasSource": [{"@id": "_:nb4d9141663bc4962887927ec04e27999b5"}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b6"}], "madsrdf:hasVariant": [{"@id": "_:nb4d9141663bc4962887927ec04e27999b7"}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b10"}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b13"}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b16"}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that combine elements of both tragedy and comedy."}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:05:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tragicomedies"}}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tragic-comedy: Euripides's Alcestis and Iphigenia (both tragedies) had happy endings; Aristotle made it clear in Poetics that audiences preferred the kind of endings where poetic justice was seen to be done; tragedies with happy endings; tragical comedies (or comical tragedies), which had serious main plots and comic sub-plots; by the end of the 16th c. these two kinds had drawn together and were more or less indistinguishable; Shakespeare also wrote tragic-comedies; with the demise of verse drama, dramatic tragic-comedy virtually disappeared, but occasionally a playwright has combined tragic and comic elements in such a way as to warrant his work being called tragic-comedy; distinctions between tragic-comedy, black comedy and what Jean Anouilh calls pieces noires and pieces grin\u00e7antes are difficult to make)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tragicomedy: A play that combines elements of tragedy and comedy, either by providing a happy ending to a potentially tragic story or by some more complex blending of serious and light moods. In its broadest sense, the term may be applied to almost any kind of drama that does not conform strictly to comic or tragic conventions--from the medieval mystery play to the epic theatre of Brecht--but it is associated more specifically with a dramatic tradition that emerged from Italy in the 16th century, notably in Battista Guarini's pastoral play Il Pastor Fido; the plays of Harold Pinter are often seen as tragicomic)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4d9141663bc4962887927ec04e27999b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tragicomic drama"}}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tragicomic drama"}}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4d9141663bc4962887927ec04e27999b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tragical comedies"}}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tragical comedies"}}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4d9141663bc4962887927ec04e27999b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comical tragedies"}}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comical tragedies"}}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4d9141663bc4962887927ec04e27999b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tragic comedies"}}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tragic comedies"}}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4d9141663bc4962887927ec04e27999b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tragi-comedies"}}, {"@id": "_:nb4d9141663bc4962887927ec04e27999b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tragi-comedies"}}], "@id": "/authorities/genreForms/gf2014026577"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026578", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTriolets", "identifiers:lccn": "gf2014026578", "madsrdf:adminMetadata": [{"@id": "_:n7bb9003d957d4e779644ec701b7f66b5b1"}, {"@id": "_:n7bb9003d957d4e779644ec701b7f66b5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Triolets"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7bb9003d957d4e779644ec701b7f66b5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n7bb9003d957d4e779644ec701b7f66b5b5"}, {"@id": "_:n7bb9003d957d4e779644ec701b7f66b5b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Eight-line poems with only two rhymes, in which the first two lines are repeated as the final two lines, and the first line is repeated as the fourth."}, {"@id": "_:n7bb9003d957d4e779644ec701b7f66b5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7bb9003d957d4e779644ec701b7f66b5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:05:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7bb9003d957d4e779644ec701b7f66b5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Triolets"}}, {"@id": "_:n7bb9003d957d4e779644ec701b7f66b5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Triolet. A French fixed form with eight lines, two rhymes, and two refrain lines, patterned ABaAabAB. It may be split into two quatrains or employed as a stanza form, although poems of one strophe are typical. Line length and meter are not fixed. Today, it is considered the Urform of the entire rondeau family.)"}, "madsrdf:citationSource": "The Princeton encyc. of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n7bb9003d957d4e779644ec701b7f66b5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(triolet. A poem of eight lines using only two rhymes, the first two lines being repeated as the final two lines, the first line also recurring as the fourth. The rhyme scheme--with repeated lines given in capitals--is ABaAabAB. The triolet is one of the medieval French fixed forms, and may be considered as a simplified form of the rondel. A few English poets revived it in the late 19th century.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026578"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026579", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrue crime comics", "identifiers:lccn": "gf2014026579", "madsrdf:adminMetadata": [{"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab1"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "True crime comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026453"}, "madsrdf:hasSource": [{"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab5"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab6"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab7"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab8"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab9"}], "madsrdf:hasVariant": [{"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab10"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab13"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "True crime comics"}}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 50 (Under crime genre: Modern times offer many crime-themed comics and original graphic novels. One of the most notable \"true-crime\" series of OGNs is Rick Geary's Treasure of Victorian Murder, which covers not only the famous killers and victims of the 1800s, such as Jack the Ripper and the two assassinated presidents, but some who are lesser known, including H.H. Holmes and Mary Rogers, who were the subjects of recent nonfiction works.)"}, "madsrdf:citationSource": "Serchay, D. Librarian's guide to graphic novels for adults, c2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Pinstriped bloodbath : an anthology of Chicago comics artists of bloody gangster violence of true crime history, c2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bendis, B.M. Torso : a true crime graphic novel, c2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab8", "@type": "madsrdf:Source", "madsrdf:citationSource": "True crime comics, June 1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 355 (True crime: Whether it is the historical aspects, morbid details, or the psychological questions surrounding the crimes, tales of real-life murders have fascinated people of ages. Listed here is an excellent collection of true-life crime in a graphic novel format.)"}, "madsrdf:citationSource": "Pawuk, M. Graphic novels : a genre guide to comic books, manga, and more, c2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Non-fiction crime comics"}}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Non-fiction crime comics"}}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crime comics, Nonfiction"}}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crime comics, Nonfiction"}}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nonfiction crime comics"}}, {"@id": "_:nf32dbc698fb449b5ae8cfcaf1949f6fab17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonfiction crime comics"}}], "@id": "/authorities/genreForms/gf2014026579"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026580", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aUnderground comics", "identifiers:lccn": "gf2014026580", "madsrdf:adminMetadata": [{"@id": "_:n30da5d52f44b43499cca8a05e328e603b1"}, {"@id": "_:n30da5d52f44b43499cca8a05e328e603b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Underground comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n30da5d52f44b43499cca8a05e328e603b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n30da5d52f44b43499cca8a05e328e603b5"}, {"@id": "_:n30da5d52f44b43499cca8a05e328e603b6"}], "madsrdf:hasVariant": {"@id": "_:n30da5d52f44b43499cca8a05e328e603b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that depict content forbidden to mainstream publications by the Comics Code Authority, including explicit drug use, sexuality, and violence."}, {"@id": "_:n30da5d52f44b43499cca8a05e328e603b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n30da5d52f44b43499cca8a05e328e603b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:05:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n30da5d52f44b43499cca8a05e328e603b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Underground comics"}}, {"@id": "_:n30da5d52f44b43499cca8a05e328e603b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Underground comix are small press or self-published comic books which are often socially relevant or satirical in nature. They differ from mainstream comics in depicting content forbidden to mainstream publications by the Comics Code Authority, including explicit drug use, sexuality and violence. They were most popular in the United States between 1968 and 1975, and in the United Kingdom between 1973 and 1974.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 6, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n30da5d52f44b43499cca8a05e328e603b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Underground comix and the underground press (The late 1960s saw the emergence of underground comics, a new wave of humorous, hippie-inspired comic books that dealt with social and political subjects like sex, drugs, rock music and anti-war protest. For this reason, these new comics became known as \"comix\" to set them apart from mainstream comics and to emphasize the \"x\" for x-rated. A major underground influence was the anti-censorship reaction to the imposed 'comics code'. In the 1950s, there had been a crusade against comics (especially those published by E.C. Comics), which had inspired the passing of the Comics Code, a set of rules to which comics creators had to adhere.)"}, "madsrdf:citationSource": "Comiclopedia, via WWW, Dec. 6, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n30da5d52f44b43499cca8a05e328e603b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n30da5d52f44b43499cca8a05e328e603b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Underground comix"}}, {"@id": "_:n30da5d52f44b43499cca8a05e328e603b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Underground comix"}}], "@id": "/authorities/genreForms/gf2014026580"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026581", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aUrban fiction", "identifiers:lccn": "gf2014026581", "madsrdf:adminMetadata": [{"@id": "_:nd720661849b3427282d27a53960bee07b1"}, {"@id": "_:nd720661849b3427282d27a53960bee07b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Urban fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd720661849b3427282d27a53960bee07b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:nd720661849b3427282d27a53960bee07b5"}, {"@id": "_:nd720661849b3427282d27a53960bee07b6"}, {"@id": "_:nd720661849b3427282d27a53960bee07b7"}], "madsrdf:hasVariant": [{"@id": "_:nd720661849b3427282d27a53960bee07b8"}, {"@id": "_:nd720661849b3427282d27a53960bee07b11"}, {"@id": "_:nd720661849b3427282d27a53960bee07b14"}, {"@id": "_:nd720661849b3427282d27a53960bee07b17"}, {"@id": "_:nd720661849b3427282d27a53960bee07b20"}, {"@id": "_:nd720661849b3427282d27a53960bee07b23"}, {"@id": "_:nd720661849b3427282d27a53960bee07b26"}, {"@id": "_:nd720661849b3427282d27a53960bee07b29"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features African Americans in inner cities and that generally includes explicit profanity, sex, and violence."}, {"@id": "_:nd720661849b3427282d27a53960bee07b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:06:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd720661849b3427282d27a53960bee07b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd720661849b3427282d27a53960bee07b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Urban fiction"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (there's been some debate about what to call this genre: urban fiction; hip-hop lit; ghetto lit; street lit) p.2 (one thing is consistent and clear: street literature is location-specific; it is a genre in which the stories are consistently set in urban, inner-city enclaves, depicting daily lives of people in lower-income city neighborhoods) p. 3 (characteristics of street lit: fast-paced stories; vivid depictions of the inner-city environment; the street as an interactive stage; female and male identity formation often with young adult protagonists; navigation of interpersonal relationships; commodification of lifestyles; surviving street life) p. 7 (contemporary street lit is an African-American-focused genre, featuring mostly African American protagonists and antagonists, as well as African American Vernacular English, hip-hop slang, and American regional dialects)"}, "madsrdf:citationSource": "Morris, V.I. The reader's advisory guide to street literature, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd720661849b3427282d27a53960bee07b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Urban fiction. UF Gangsta fiction; Gangsta lit; Ghetto lit; Hip-hop fiction; Street fiction; Street lit)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd720661849b3427282d27a53960bee07b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(urban fiction: also known as street lit or hip-hop lit; a literary genre set, as the name implies, in a city landscape; however, the genre is as much defined by the socio-economic realities and culture of its characters as the urban setting; The tone for urban fiction is usually dark, focusing on the underside of city living. Profanity, sex, and violence are usually explicit, with the writer not shying away from or watering-down the material)"}, "madsrdf:citationSource": "Wikipedia, Nov. 3, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd720661849b3427282d27a53960bee07b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd720661849b3427282d27a53960bee07b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Street literature"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Street literature"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd720661849b3427282d27a53960bee07b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Street fiction"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Street fiction"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd720661849b3427282d27a53960bee07b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ghetto lit"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghetto lit"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd720661849b3427282d27a53960bee07b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gangsta fiction"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gangsta fiction"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd720661849b3427282d27a53960bee07b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hip-hop fiction"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hip-hop fiction"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd720661849b3427282d27a53960bee07b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hip-hop lit"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hip-hop lit"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd720661849b3427282d27a53960bee07b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Street lit"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Street lit"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd720661849b3427282d27a53960bee07b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gangsta lit"}}, {"@id": "_:nd720661849b3427282d27a53960bee07b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gangsta lit"}}], "@id": "/authorities/genreForms/gf2014026581"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026582", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aUrban legends", "identifiers:lccn": "gf2014026582", "madsrdf:adminMetadata": [{"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b1"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Urban legends"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026344"}, "madsrdf:hasSource": [{"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b5"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b6"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b7"}], "madsrdf:hasVariant": [{"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b8"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b11"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b14"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b17"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b20"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b23"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Stories of supposed events in the recent past that may be humorous and/or horrifying and that are popularly believed to be true."}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:21:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Urban legends"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Urban legend: An urban legend, urban myth, urban tale, or contemporary legend, is a form of modern folklore consisting of stories that may or may not have been believed by their tellers to be true. As with all folklore and mythology, the designation suggests nothing about the story's veracity, but merely that it is in circulation, exhibits variation over time, and carries some significance that motivates the community in preserving and propagating it. The term \"urban legend,\" as used by folklorists, has appeared in print since at least 1968. Many urban legends are framed as complete stories with plot and characters. The compelling appeal of a typical urban legend is its elements of mystery, horror, fear or humor. Often they serve as cautionary tales. Some urban legends are morality tales that depict someone, usually a child, acting in a disagreeable manner, only to wind up in trouble, hurt, or dead.)"}, "madsrdf:citationSource": "Wikipedia, Jan. 22, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Urban legend: An apocryphal story involving incidents of the recent past, often including elements of humor and horror, that spreads quickly and is popularly believed to be true.)"}, "madsrdf:citationSource": "The free dictionary, via WWW", "madsrdf:citationStatus": "found"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Urban Legends. Urban legends are those fascinating and ironic stories, supposedly about actual happenings, that find their way into the public consciousness, mostly by word-of-mouth. A few stories are about supernatural visitors, but most are about ordinary people and the complexities of human relationships and interactions with the technology that is part of everyday life: automobiles, machinery, sewers, microwave ovens, computers, and medical abnormalities. Six features of urban legends: 1. They contain a semblance of seemingly supportive detail. 2. The tellers believe them and pass them on as truth. 3. The stories reflect contemporary fears. 4. They gain momentum from repetition, especially when they find their way into the press. 5. Some of the stories have a grain of truth, which adds immeasurably to their persistence. 6. Formal refutation does nothing to deter the popularity of the fables. Urban legends are also called \"FOAF tales\" because they are told by a \"friend of a friend.\" Urban legends differ from hoaxes or lies, since the people who pass them on honestly believe the events happened.)"}, "madsrdf:citationSource": "Nilsen, A.P. Encyclopedia of 20th-century American humor, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Legends, Urban"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legends, Urban"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "FOAF tales"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "FOAF tales"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Contemporary legends"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Contemporary legends"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Friend of a friend tales"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Friend of a friend tales"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Myths, Urban"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Myths, Urban"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Legends, Contemporary"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legends, Contemporary"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Urban myths"}}, {"@id": "_:n6a00119a5e914191a1bb0abc60cea4d5b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Urban myths"}}], "@id": "/authorities/genreForms/gf2014026582"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026583", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aUtopian fiction", "identifiers:lccn": "gf2014026583", "madsrdf:adminMetadata": [{"@id": "_:n601213ca7f084ad883c1dd19d628fa04b1"}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Utopian fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n601213ca7f084ad883c1dd19d628fa04b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n601213ca7f084ad883c1dd19d628fa04b5"}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b6"}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b7"}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b8"}], "madsrdf:hasVariant": [{"@id": "_:n601213ca7f084ad883c1dd19d628fa04b9"}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that depicts an ideal society."}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:21:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Utopian fiction"}}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 17 (utopic fiction)"}, "madsrdf:citationSource": "Broderick, J.F. Paging New Jersey, c2003, via Google books, viewed Mar. 13, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Utopian fiction. UF Utopias. Use for works which depict an ideal society)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 9 (the utopian science fiction novel) p. 24 (utopian fiction) p. 46 (utopian science fiction novels)"}, "madsrdf:citationSource": "Burns, T. Political theory, science fiction, and utopian literature, 2010, via Google books, viewed Mar. 13, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 75-85 (Utopian fiction: there is an entire tradition of utopian fiction, often with a strong science fiction component, that attempts to envision ideal societies, generally far removed from the author's world either temporally or geographically)"}, "madsrdf:citationSource": "Booker, M. The science fiction handbook, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n601213ca7f084ad883c1dd19d628fa04b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Utopian science fiction"}}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Utopian science fiction"}}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n601213ca7f084ad883c1dd19d628fa04b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Utopic fiction"}}, {"@id": "_:n601213ca7f084ad883c1dd19d628fa04b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Utopic fiction"}}], "@id": "/authorities/genreForms/gf2014026583"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026584", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aUtopian plays", "identifiers:lccn": "gf2014026584", "madsrdf:adminMetadata": [{"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b1"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Utopian plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b5"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b6"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b7"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b8"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b9"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b10"}], "madsrdf:hasVariant": [{"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b11"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that depict an ideal society."}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:22:07"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Utopian plays"}}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 339 (Margaret Cavendish's dramatic utopias) p. 340 (Cavendish's utopian plays)"}, "madsrdf:citationSource": "Studies in English literature, 1500-1900, spring 2000, via Project MUSE, viewed online Mar. 17, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The word robot was originally from Karel Capek's utopic drama about robots revolution agains[t] people; Technology overtakes theater in this utopic play by the successful actor and playwright Yi\u011fit Sertdemir)"}, "madsrdf:citationSource": "Google search, Mar. 17, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 113 (A new utopian comedy; the utopian \"collective drama\" R.U.R.: Rossum's Universal Robots) p. 525 (the utopian play And\u011bl\u00e9 mezi n\u00e1mi) p. 726 (R.U.R.: Rossum's Universal Robots (1921). A utopian drama by Karel \u010capek)"}, "madsrdf:citationSource": "The reader's encyclopedia of world drama, 2002, via Google books, viewed on Mar. 17, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 122 (Starke's utopic play)"}, "madsrdf:citationSource": "Bhattacharya, N. Reading the splendid body, c1998, via Google books, viewed on Mar. 17, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 409 (Howard Brenton's utopian plays; \"Brenton ... has specifically characterized three of his plays as Utopian. These are Sore Throats, Bloody Poetry, and Greenland.\")"}, "madsrdf:citationSource": "Contemporary justice review, Dec. 2005, viewed online Mar. 17, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Utopian fiction. UF Utopias. Use for works which depict an ideal society. BT Fantasy fiction. RT Dystopias)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Utopic drama"}}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Utopic drama"}}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Utopian drama"}}, {"@id": "_:n7a42a57a25e8498a8d84aad6afd73570b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Utopian drama"}}], "@id": "/authorities/genreForms/gf2014026584"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026585", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVerse drama", "identifiers:lccn": "gf2014026585", "madsrdf:adminMetadata": [{"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab1"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Verse drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026029"}, "madsrdf:hasSource": [{"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab5"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab6"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab7"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab8"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab9"}], "madsrdf:hasVariant": [{"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab10"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab13"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab16"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab19"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verse drama"}}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 466-472 (dramas in poetical form; poetic drama; plays in poetry; poetic plays; plays in verse; verse plays; drama in verse; poetical drama)"}, "madsrdf:citationSource": "Literary heritage of the Tamils, 1981:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 161 (verse plays)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008;Quinn, E. A dictionary of literary and thematic terms, c1999;Cuddon, J.A. A dictionary of literary terms and literary theory, 1998.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(poetic drama: A play written wholly or mainly in verse. As this was the norm in early drama (a tradition crowned by the works of Shakespeare), the term is usually reserved for works written since the Restoration (1660); by this time only tragedies were still composed in verse, comedies being more commonly written in prose.)"}, "madsrdf:citationSource": "Dictionary central, via WWW, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Drama: In poetic drama the dialogue is written in verse, which in English is usually blank verse and in French is the twelve-syllable line called an Alexandrine; almost all the heroic dramas of the English Restoration Period, however, were written in heroic couplets (iambic pentameter lines rhyming in pairs))"}, "madsrdf:citationSource": "Abrams, M. A glossary of literary terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poetic drama"}}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poetic drama"}}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Verse plays"}}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verse plays"}}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plays in verse"}}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plays in verse"}}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plays in poetry"}}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plays in poetry"}}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poetical drama"}}, {"@id": "_:n4b7f71f26c8543ffa4de3c49569ba09ab23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poetical drama"}}], "@id": "/authorities/genreForms/gf2014026585"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026586", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVillancicos (Poetry)", "identifiers:lccn": "gf2014026586", "madsrdf:adminMetadata": [{"@id": "_:nfd28f819126f467c8594d5b1b1f13342b1"}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Villancicos (Poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfd28f819126f467c8594d5b1b1f13342b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nfd28f819126f467c8594d5b1b1f13342b5"}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b6"}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b7"}], "madsrdf:hasVariant": [{"@id": "_:nfd28f819126f467c8594d5b1b1f13342b8"}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Spanish and Portuguese poems from the 15th-18th centuries that are generally on religious or popular themes and are intended to be sung."}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:52:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Villancicos (Poetry)"}}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Villancicos (Poetry): UFs Vilancetes (Poetry); Vilancicos (Poetry); BTs: Portuguese poetry; Spanish poetry)"}, "madsrdf:citationSource": "LCSH, Aug. 27, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(villancico: A Sp. poem, often on a religious or popular theme and usually composed in a short meter, to be sung as a carol. The introductory stanza (cabeza, estribillo, repetici\u00f3n, or ritornelo), typically brief, sets forth the theme to be glossed in the body of the poem and frequently serves, in whole or in part, as the refrain (estribillo). The body (pies) of the poem, composed of a few (usually about six) strophes, each of about six lines plus the chorus, develops the theme, often repeating verbatim phrases or lines from the introduction)"}, "madsrdf:citationSource": "New Princeton encyclopedia of poetry and poetics, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The villancico(caca) (or vilancete, in Portuguese) was a common poetic and musical form of the Iberian Peninsula and Latin America popular from the late 15th to 18th centuries. The poetic form of the Spanish villancico was that of an estribillo (or refrain) and coplas (stanzas), with or without an introduction. While the exact order and number of repetitions of the estribillo and coplas varied, the most typical form was a loose ABA framework, often in triple meter.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 15, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd28f819126f467c8594d5b1b1f13342b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Villancetes (Poetry)"}}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Villancetes (Poetry)"}}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd28f819126f467c8594d5b1b1f13342b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vilancicos (Poetry)"}}, {"@id": "_:nfd28f819126f467c8594d5b1b1f13342b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vilancicos (Poetry)"}}], "@id": "/authorities/genreForms/gf2014026586"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026587", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVillanelle", "identifiers:lccn": "gf2014026587", "madsrdf:adminMetadata": [{"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db1"}, {"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Villanelle"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db5"}, {"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db6"}], "madsrdf:hasVariant": {"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Nineteen-line poems with two repeating rhymes and two refrains, structured in five tercets and a concluding quatrain."}, {"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:22:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Villanelle"}}, {"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetic Form: Villanelle--The highly structured villanelle is a nineteen-line poem with two repeating rhymes and two refrains. The form is made up of five tercets followed by a quatrain. The first and third lines of the opening tercet are repeated alternately in the last lines of the succeeding stanzas; then in the final stanza, the refrain serves as the poem's two concluding lines. Using capitals for the refrains and lowercase letters for the rhymes, the form could be expressed as: A1 b A2 / a b A1 / a b A2 / a b A1 / a b A2 / a b A1 A2. Strange as it may seem for a poem with such a rigid rhyme scheme, the villanelle did not start off as a fixed form.)"}, "madsrdf:citationSource": "Poets.org, viewed Dec. 26, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(villanelle: from It. villanella, a rustic song, villano, a peasant). As known today, a 19-line poem with two rhymes and two refrain lines, in the form AJoA 2abAj abA2 abA\u00a1 abA2 abA\u00a1 A2, where capital letters indicate refrains. Also distinctive is the quatrain occurring at the end of a series of tercets, the extra line in the last stanza furnishing a sense of closure to the repetitive pattern with a conclusive couplet)"}, "madsrdf:citationSource": "New Princeton encyclopedia of poetry and poetics, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Villanelles"}}, {"@id": "_:nd9b92d0f4c8f4cefa9a7f62dee742b0db8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Villanelles"}}], "@id": "/authorities/genreForms/gf2014026587"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026588", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVisual poetry", "identifiers:lccn": "gf2014026588", "madsrdf:adminMetadata": [{"@id": "_:n1b49c70715414239b8cd9329d215b22ab1"}, {"@id": "_:n1b49c70715414239b8cd9329d215b22ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Visual poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1b49c70715414239b8cd9329d215b22ab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027266"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026214"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026270"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026402"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026478"}], "madsrdf:hasSource": [{"@id": "_:n1b49c70715414239b8cd9329d215b22ab5"}, {"@id": "_:n1b49c70715414239b8cd9329d215b22ab6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems whose full effect depends on the typographical or pictorial arrangement of text, images and/or symbols."}, {"@id": "_:n1b49c70715414239b8cd9329d215b22ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:46:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1b49c70715414239b8cd9329d215b22ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1b49c70715414239b8cd9329d215b22ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Visual poetry"}}, {"@id": "_:n1b49c70715414239b8cd9329d215b22ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A visual poem may be defined simply as a poem composed or designed to be consciously seen. The modern visual poem is generally composed with disassembled language material. This stuff of language includes word, text, note, code, petroglyph, letter, phonic character, type, cipher, symbol, pictograph, sentence, number, hieroglyph, rhythm, iconograph, grammar, cluster, stroke, ideogram, density, pattern, diagram, logogram, accent, line, color, measure, etc.)"}, "madsrdf:citationSource": "Kempton, K. Visual poetry: a brief history of ancestral roots and modern traditions, via WWW, July 29, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b49c70715414239b8cd9329d215b22ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(visual poetry: In traditional verse, the written text serves mainly a notational role, and its visual aspects are subordinate to the oral form they represent. In visual poetry in the strict sense, the visual form of the text becomes an object for apprehension in its own right. In some visual poetry, text is combined with nontextual graphic elements)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026588"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026589", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWar comics", "identifiers:lccn": "gf2014026589", "madsrdf:adminMetadata": [{"@id": "_:ncb2f10036b73412396a86260e7ef2df6b1"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "War comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncb2f10036b73412396a86260e7ef2df6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:ncb2f10036b73412396a86260e7ef2df6b5"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b6"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b7"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b8"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b9"}], "madsrdf:hasVariant": [{"@id": "_:ncb2f10036b73412396a86260e7ef2df6b10"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b13"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that feature military conflicts."}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:22:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "War comics"}}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Vansant, W. Normandy, a graphic history of D-Day, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(War films; War radio programs; War television programs)"}, "madsrdf:citationSource": "LCGFT, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 46 (in chapter titled What genres do graphic novels cover?: War Comics)"}, "madsrdf:citationSource": "Serchay, D.S. The librarian's guide to graphic novels for adults, c2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 51 (The following genres are included: adventure, biography, fairytale/folktale, fantasy, horror, humor, literary adaptation, mythology, nonfiction, realistic fiction, science fiction, superhero, war and consequences.)"}, "madsrdf:citationSource": "Karp, J. Graphic novels in your school library, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(series: Graphic modern history : World War II)"}, "madsrdf:citationSource": "Jeffrey, G. Battle for the Atlantic, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncb2f10036b73412396a86260e7ef2df6b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anti-war comics"}}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anti-war comics"}}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncb2f10036b73412396a86260e7ef2df6b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Antiwar comics"}}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Antiwar comics"}}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncb2f10036b73412396a86260e7ef2df6b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Combat comics"}}, {"@id": "_:ncb2f10036b73412396a86260e7ef2df6b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Combat comics"}}], "@id": "/authorities/genreForms/gf2014026589"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026590", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWar fiction", "identifiers:lccn": "gf2014026590", "madsrdf:adminMetadata": [{"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b1"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "War fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b3"}]}, "madsrdf:exampleNote": "Note under [Military fiction]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b5"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b6"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b7"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b8"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b9"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b10"}], "madsrdf:hasVariant": [{"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b11"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b14"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features military conflicts. For fiction that features the military lifestyle and loyalty to the armed forces and its codes and is generally set during peacetime see [Military fiction.]"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-15T15:20:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "War fiction"}}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bitz, R.R. An examination of the anti-war statement in selected World War I novels, 1972.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(number of works tagged with term: war-fiction, 2313; war-stories, 3856 (mix of fiction, general nonfiction, history, memoirs, true adventure))"}, "madsrdf:citationSource": "Goodreads, Nov. 15, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Peebles, S.L. \"There it is\" : writing violence in three modern American combat novels, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "introduction (War literature, particularly fiction, lends itself to classification by duration and focus of conflict. That is, plots are derived from such frames as the tour of duty (James Webb's Fields of Fire), campaigns (John Del Vecchio's The 13th Valley), particular battles or skirmishes (Humphrey Cobb's Paths of Glory), and sometimes the contours of a single day (Harry Brown's A Walk in the Sun and David Halberstam's One Very Hot Day). Many successful works, like James Michener's The Bridges at Toko-ri, gain their organizing strength from the combination of parameters: the military objective and the military unit; the great bulk of war narratives that focus on young men (as they so often and so unfortunately must) are essentially initiation or coming of age stories, and the complex of ways in which a tour of duty turns into a trial of selfhood needs detailed examination, as does the corollary motif of bonding and brotherhood; a major subset of war literature is the prisoner of war story; The consequences of war--on the individual, on the war-torn country, and even on the culture of the participating nation whose borders remain secure--have generated a body of work that rivals the literary response to combat itself. Aftermath and homecoming stories have their own dimensions and motifs)"}, "madsrdf:citationSource": "Encyclopedia of American war literature, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Scholl, P.A. Some recent American novels with antiwar themes, 1972.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(War stories. Use for stories dealing with wars, campaigns, or battles from the military angle)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anti-war fiction"}}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anti-war fiction"}}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Antiwar fiction"}}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Antiwar fiction"}}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Combat fiction"}}, {"@id": "_:ne3698b4c5af34cab8a9b5874b95366f2b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Combat fiction"}}], "@id": "/authorities/genreForms/gf2014026590"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026591", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWar drama", "identifiers:lccn": "gf2014026591", "madsrdf:adminMetadata": [{"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb1"}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "War drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb5"}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb6"}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb7"}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb8"}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb9"}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb10"}], "madsrdf:hasVariant": [{"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb11"}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb14"}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb17"}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb20"}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Drama that features military conflicts."}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne87bcc6e15f74bcbb3efab2c9254b47bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.go