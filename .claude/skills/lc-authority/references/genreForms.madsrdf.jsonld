{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026731", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWar television programs", "identifiers:lccn": "gf2011026731", "madsrdf:adminMetadata": [{"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b1"}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "War television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b3"}]}, "madsrdf:exampleNote": "Note under [Military television programs]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b5"}, "madsrdf:hasSource": [{"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b8"}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b9"}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b10"}], "madsrdf:hasVariant": {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that feature military conflicts. For television programs that feature the military lifestyle and loyalty to the armed forces and its codes and are generally set during peacetime see [Military television programs.]", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026054"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025375"}]}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:18:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "War television programs"}}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anti-war television programs"}}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anti-war television programs"}}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: War television programs)"}, "madsrdf:citationSource": "LCSH, April 27, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(War drama. Use for fictional genre films and programs whose protagonists are engaged in warfare, e.g. ground combat by infantry or marines. UF Combat drama, Commando drama, Resistance drama, Secret Service drama, War films, World War I drama, World War II drama. RT Anti-war works)"}, "madsrdf:citationSource": "Yee, M. Moving image materials : genre terms, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(War. Fictional work portraying military conflicts in the twentieth century, primarily the first and second world wars, but also other subsequent wars, such as Vietnam, as well as smaller conflicts. TV examples: China Beach; Hogan's Heroes; Homefront; McHale's Navy; The Rat Patrol; Twelve O'Clock High)"}, "madsrdf:citationSource": "Moving image genre-form guide, via WWW, May 13, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anti-war television programs"}}, {"@id": "_:ne4606fcc1ff54c29a2bc902631af38c0b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anti-war television programs"}}], "@id": "/authorities/genreForms/gf2011026731"}
