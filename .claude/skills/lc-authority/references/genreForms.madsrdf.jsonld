{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026280", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDetective and mystery fiction", "identifiers:lccn": "gf2014026280", "madsrdf:adminMetadata": [{"@id": "_:nffb1444b211b4628a79cd11785b0df40b1"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Detective and mystery fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nffb1444b211b4628a79cd11785b0df40b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026452"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026103"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026071"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026087"}], "madsrdf:hasSource": [{"@id": "_:nffb1444b211b4628a79cd11785b0df40b5"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b6"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b7"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b8"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b9"}], "madsrdf:hasVariant": [{"@id": "_:nffb1444b211b4628a79cd11785b0df40b10"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b13"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b16"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b19"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b22"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-07-17T13:20:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Detective and mystery fiction"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Newgate fiction (Newgate fiction. A minor genre or mode which had some vogue in the 1830s; it has been called 'crime fiction' and is, perhaps, an early form of faction. The so-called Newgate novelists based their stories on actual criminal cases) crime fiction (crime fiction. The commission and detection of crime, with the motives, actions, arraignment, judgement, and punishment of a criminal, is one of the great paradigms of narrative. Critical work on the genre has overwhelmingly concentrated on the detective story, defined by the adoption of the investigator as protagonist; detective fiction; crime writing; crime novel)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Detective story: a story in which the principal action and focus of interest is the investigation of a crime or apparently enigmas by a detective figure, either professional or amateur.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mystery fiction: Use for novels and stories dealing with the detection and solution of crime. UF Crime stories, Detective and mystery fiction, Detective and mystery stories, Fiction, Detective, Fiction, Mystery, Murder mysteries, Mysteries, Mystery and detective stories, Mystery stories, Private eye stories, Whodunits.NT Noir fiction)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "introd. (crime fiction; crime novels)"}, "madsrdf:citationSource": "British crime writing : an encyclopedia, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Detective and mystery stories. UF Detective and mystery fiction. BT Fiction)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffb1444b211b4628a79cd11785b0df40b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Murder mysteries"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Murder mysteries"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffb1444b211b4628a79cd11785b0df40b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Whodunits"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Whodunits"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffb1444b211b4628a79cd11785b0df40b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crime fiction"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crime fiction"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffb1444b211b4628a79cd11785b0df40b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Detective fiction"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Detective fiction"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffb1444b211b4628a79cd11785b0df40b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mystery fiction"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mystery fiction"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffb1444b211b4628a79cd11785b0df40b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Private eye fiction"}}, {"@id": "_:nffb1444b211b4628a79cd11785b0df40b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Private eye fiction"}}], "@id": "/authorities/genreForms/gf2014026280"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026281", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDetective and mystery plays", "identifiers:lccn": "gf2014026281", "madsrdf:adminMetadata": [{"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab1"}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Detective and mystery plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026047"}, "madsrdf:hasSource": [{"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab5"}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab6"}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab7"}], "madsrdf:hasVariant": [{"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab8"}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab11"}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-07-17T13:20:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Detective and mystery plays"}}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab5", "@type": "madsrdf:Source", "madsrdf:citationSource": "LaBorde, C.B. Form and formula in detective drama : a structural study of selected twentieth-century mystery plays, 1976.", "madsrdf:citationStatus": "found"}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sodaro, C. Make it mystery : an anthology of short mystery plays, 2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Detective and mystery plays. UF Mystery plays (Modern))"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Detective and mystery drama"}}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Detective and mystery drama"}}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Detective plays"}}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Detective plays"}}, {"@id": "_:n80053d78e07549e99d9a6ee6967a1f1ab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n80053d78