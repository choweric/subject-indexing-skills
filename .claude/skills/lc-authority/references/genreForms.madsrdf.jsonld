{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2013025058", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGeologic time scales", "identifiers:lccn": "gf2013025058", "madsrdf:adminMetadata": [{"@id": "_:n5b1fa09678794691958bffd3437ce297b1"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Geologic time scales"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5b1fa09678794691958bffd3437ce297b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026062"}, "madsrdf:hasSource": [{"@id": "_:n5b1fa09678794691958bffd3437ce297b5"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b6"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b7"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b8"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b9"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b10"}], "madsrdf:hasVariant": {"@id": "_:n5b1fa09678794691958bffd3437ce297b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:12:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2013-12-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geologic time scales"}}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(geologic time scale: A chronological arrangement of events in geologic history, usually presented in the form of a vertical chart with the event earliest in time at the bottom and the latest at the top. Geologic time scales are often used in conjunction with geologic columns.)"}, "madsrdf:citationSource": "ODLIS: online dictionary for library and information science, viewed Dec. 12, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Geological time scale (GTS98), 2003.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Geologic time scale. The geologic time scale (GTS) is a system of chronological measurement that relates stratigraphy to time, and is used by geologists, paleontologists, and other earth scientists to describe the timing and relationships between events that have occurred throughout Earth's history. The table of geologic time spans presented here agrees with the dates and nomenclature set forth by the International Commission on Stratigraphy standard color codes of the International Commission on Stratigraphy.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 12, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "A geologic time scale 2004, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(2 volumes + 1 color chart (72 x 102 cm, folded to 26 x 18 cm) in pocket)"}, "madsrdf:citationSource": "Work cat.: The geologic time scale 2012, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(includes a laminated card of the complete time scale for use as a handy reference in the office, laboratory, or field)"}, "madsrdf:citationSource": "Ogg, J.G. The concise geologic time scale, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5b1fa09678794691958bffd3437ce297b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geological time scales"}}, {"@id": "_:n5b1fa09678794691958bffd3437ce297b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geological time scales"}}], "@id": "/authorities/genreForms/gf2013025058"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026001", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aZombie television programs", "identifiers:lccn": "gf2014026001", "madsrdf:adminMetadata": [{"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb1"}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Zombie television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026403"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026112"}], "madsrdf:hasSource": [{"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb5"}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb6"}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb7"}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb8"}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional television programs that feature the reanimation of corpses that prey on human beings."}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-01-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zombie television programs"}}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Zombies in television. Examples: Acting Dead; All of Us Are Dead; Dark Shadows; Fear the Walking Dead; The Haunting Hour; Highschool of the Dead; In the Flesh; iZombie; The Walking Dead; Z Nation; Zombie Hunters: City of the Dead)"}, "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Zombie movie; traditionally, zombies are corpses reanimated into a semblance of life by the magic of a voodoo priest. They are strong and powerful and obey unquestioningly their master's orders. At present, voodoo trappings are no longer necessary to awaken the dead; any supernatural or pseudo-scientific method will do.)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "In the Flesh (TV series) (In the Flesh is a three-part BBC supernatural drama series which began airing on BBC Three on 17 March 2013. The show was created and written by Dominic Mitchell. It is set after \"The Rising\", the show's take on a zombie apocalypse, and focuses on a re-animated teenager Kieren Walker as he comes back into the local community.) The Walking Dead (TV series) (The Walking Dead is an American horror drama television series developed by Frank Darabont. It is based on the comic book series of the same name by Robert Kirkman, Tony Moore, and Charlie Adlard. The series stars Andrew Lincoln as sheriff's deputy Rick Grimes, who awakens from a coma to find a post-apocalyptic world dominated by flesh-eating zombies.)"}, "madsrdf:citationSource": "Wikipedia, Jan. 8, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: In the flesh (Television program). Season 1. In the flesh [VR], 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b512072a44f419abdfeb57e1b360f6bb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Walking dead (Television program). Season 2. The walking dead. The complete second season [VR], 2012.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026001"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026007", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSex comedy films", "identifiers:lccn": "gf2014026007", "madsrdf:adminMetadata": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb1"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sex comedy films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026147"}, "madsrdf:hasSource": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb5"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb6"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb7"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb8"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb9"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb10"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb11"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb12"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb13"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb14"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb15"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb16"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb17"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb18"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb19"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb20"}], "madsrdf:hasVariant": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb21"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb24"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb27"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb30"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb33"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb36"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb39"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb42"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-04-25T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-07-14T11:18:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sex comedy films"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Il Decameron, 2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Knots [VR] : a sex comedy with a twist, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bawdy sex comedies; list includes Tie me up! Tie me down!; The Decameron; Boccaccio '70; Turn me on, dammit!; Jam\u00f3n, jam\u00f3n; Swept away; Going places; Cos\u00ec fan tutte; Picnic on the grass; Casanova '70)"}, "madsrdf:citationSource": "Nastasi, A. 10 bawdy international sex comedies, 2012, via Flavorwire website, viewed on Apr. 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bawdy: dealing with sex in a way that is meant to be funny. Full definitions: 1: obscene, lewd 2: boisterously or humorously indecent. Examples: a bawdy film that is not appropriate for children)"}, "madsrdf:citationSource": "Merriam-Webster online, Apr. 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Atame! = Tie me up, tie me down, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 12 (\"The unbridled debauchery during the famous eating scene in Stanley Kubrick's bawdy film Barry Lyndon ...\")"}, "madsrdf:citationSource": "Heller, S. The anatomy of design, c2007, via Google books, viewed Apr. 25, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ribaldry (Ribaldry is humorous entertainment that ranges from bordering on indelicacy to gross indecency. It is also referred to as \"bawdiness\", \"gaminess\" or \"bawdry\". Sex is presented in ribald material more for the purpose of poking fun at the foibles and weaknesses that manifest themselves in human sexuality, rather than to present sexual stimulation either excitingly or artistically. Also, ribaldry may use sex as a metaphor to illustrate some non-sexual concern, in which case ribaldry may verge on the territory of satire. Like any humour, ribaldry may be read as conventional or subversive. Ribaldry typically depends on a shared background of sexual conventions and values, and its comedy generally depends on seeing those conventions broken. More recent works like Candy, Barbarella, L'Infermiera, the comedic works of Russ Meyer, Little Annie Fanny and John Barth's The Sot-Weed Factor are probably better classified as ribaldry than as either pornography or erotica. Blue comedy is comedy that is off-color, risqu\u00e9, indecent or profane, largely about sex. It often contains profanity and/or sexual imagery that may shock and offend some audience members.)"}, "madsrdf:citationSource": "Wikipedia, Apr. 25, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bawdy 1. Humorously coarse; risqu\u00e9. 2. Vulgar; lewd.)"}, "madsrdf:citationSource": "The American heritage dict. of the English language, via TheFreeDictionary.com, Apr. 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lubitsch in Berlin [VR] : fairy-tales, melodramas, and sex comedies, c2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bawdy: 1. (of language, plays, etc) containing references to sex, esp to be humorous. 2. obscenity or eroticism, esp in writing or drama)"}, "madsrdf:citationSource": "Collins English dictionary, \u00a92003, via TheFreeDictionary.com, Apr. 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Decameron (Italian: Il Decameron) is a 1971 film by Italian director Pier Paolo Pasolini, based on the novel Il Decameron by Giovanni Boccaccio. It is the first movie of Pasolini's Trilogy of life, the others being The Canterbury Tales and Arabian Nights. The tales contain abundant nudity, sex, slapstick and scatological humor)"}, "madsrdf:citationSource": "Wikipedia, Apr. 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sex comedy (Comedy of sexual manners, Sexual comedy). The sex comedy has been around for a long time, and it ranges from the timid bedroom farce or boudoir comedy to the more explicit sex romp. Bedroom farce puts its emphasis on the sexual activities of its players; sex romps go for merriment and diversity in partners; sex comedies started to proliferate in the sixties, and they showed what previously had been considered taboo subject matter. Former forbidden aspects of sexual relationships were increasingly portrayed on film. Two major types of sex comedy evolved: the marriage comedy and the stud comedy)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb17", "@type": "madsrdf:Source", "madsrdf:citationSource": "The bawdy adventures of Tom Jones, c1987.", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(#34857322: Diary of forbidden dreams [VR], 198-?, summary note: Ribald comedy about a beautiful young American hitchhiker who seeks refuge at the Italian Rivera villa of an eccentric millionaire and is besieged and trapped into bizarre incidents before making her way out; #173697825: One, two, three [MP], 1961, summary note: The ribald comedy about an American Coca-Cola executive getting involved with love and twisted international politics in war-torn Berlin; #10665890: Get out your handkerchiefs, 1983?, summary note: Ribald comedy in which Freud's question \"What is it that women want?\" is elaborated until the answer--she knows it when she finds it--is discovered.)"}, "madsrdf:citationSource": "OCLC, Apr. 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb19", "@type": "madsrdf:Source", "madsrdf:citationSource": "McGoldrick, A. Have you seen my gender? : how teen sex comedies form and reinforce ideas about masculinity in teenage males, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 55 (\"The Pink Flamingos, a raucous, bawdy film many thought bordered on being pornographic\")"}, "madsrdf:citationSource": "Bacon, A.L. Building leaders, living traditions, c2009, via Google books, viewed Apr. 25, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sex comedies (Motion pictures)"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sex comedies (Motion pictures)"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Blue comedy films"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blue comedy films"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ribald comedies (Motion pictures)"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ribald comedies (Motion pictures)"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sexual comedy films"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sexual comedy films"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sexual comedies (Motion pictures)"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sexual comedies (Motion pictures)"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ribald comedy films"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ribald comedy films"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bawdy films"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bawdy films"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb42", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb43"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ribald films"}}, {"@id": "_:nddd502f115514a02938bddc9d4d9a1ffb43", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ribald films"}}], "@id": "/authorities/genreForms/gf2014026007"}
