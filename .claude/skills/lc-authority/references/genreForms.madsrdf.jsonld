tentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-09-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anatomical atlases"}}, {"@id": "_:naf6203c2a29346909994698a9d42c393b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Phillips, C. Dental & oral anatomy atlas & manual, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Khatijah Hussin. Anatomical atlas of Malaysian medicinal plants, 2006-", "madsrdf:citationStatus": "found"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Drake, R.L. Gray's atlas of anatomy, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under atlas: The term is also used for a type of medical book containing detailed illustrations of human anatomy)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Sept. 12, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Atlases. Annotation: This heading is used as a Publication Type. Use for collections of illustrative plates, charts, etc. and for items in which there are both illustrations and text, even when the text predominates, when the purpose of the text is to explain the illustrations. Do not use for geographic atlases or maps. Use instead the Publication Type Maps. Scope Note: Works consisting of collections of illustrative plates, charts, etc., usually with explanatory captions)"}, "madsrdf:citationSource": "MeSH browser, Sept. 12, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Qian, L. Sectional anatomical atlas of Sprague-Dawley rat, \u00a92010.", "madsrdf:citationStatus": "found"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "McAlpine, W.A. Heart and coronary arteries : an anatomical atlas for clinical diagnosis, radiological investigation, and surgical treatment, 1975.", "madsrdf:citationStatus": "found"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Weir & Abrahams' imaging atlas of human anatomy, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (Anatomy atlases)"}, "madsrdf:citationSource": "Anatomy atlases website, Sept. 12, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Sept. 12, 2017", "madsrdf:citationStatus": "notfound"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Atlas anatomiques. Equivalent: Anatomical atlases; Atlases of human anatomy; Atlases of the human body)"}, "madsrdf:citationSource": "RVMGF, via WWW, Sept. 12, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:naf6203c2a29346909994698a9d42c393b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf6203c2a2934