{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026180", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCustumals", "identifiers:lccn": "gf2011026180", "madsrdf:adminMetadata": [{"@id": "_:n5176528b296649cfbf15129d3539781eb1"}, {"@id": "_:n5176528b296649cfbf15129d3539781eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Custumals"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5176528b296649cfbf15129d3539781eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026179"}, "madsrdf:hasSource": {"@id": "_:n5176528b296649cfbf15129d3539781eb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Custumals or rentals relating to the 13th century English manorial system.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025102"}}, {"@id": "_:n5176528b296649cfbf15129d3539781eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n5176528b296649cfbf15129d3539781eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T13:38:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5176528b296649cfbf15129d3539781eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Custumals"}}, {"@id": "_:n5176528b296649cfbf15129d3539781eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Custumals (This heading is used as a genre/form heading for custumals or rentals relating to the 13th century English manorial system, i.e. written accounts of a manor or group of manors under ecclesiastical lordship, recording owners and occupiers of land, and the rent and customary services owed by manorial tenants and under-tenants (e.g., the custumals and rentals of Battle Abbey, (1283-1312), Shaftesbury Abbey (1089-1216), and Abbey of Holy Trinity (13th century))"}, "madsrdf:citationSource": "Genre/form terms for law materials [report prepared by the Technical Services Special Interest Section of AALL], 2010:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026180"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026181", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCutout animation films", "identifiers:lccn": "gf2011026181", "madsrdf:adminMetadata": [{"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b1"}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cutout animation films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026049"}, "madsrdf:hasSource": [{"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b5"}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b6"}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b7"}], "madsrdf:hasVariant": [{"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b8"}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b11"}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025571"}}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-23T16:15:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cutout animation films"}}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Focus on animation, techniques page (Paper cut-outs: this technique, which is as old as animated film itself...can be applied in a variety of ways. Movement can be achieved by replacing various cut-outs or by animating characters with moveable parts. Moveable parts can also be placed directly on a background drawing or on many separately lit planes)"}, "madsrdf:citationSource": "National Film Board of Canada website, April 14, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cutout animation [uses] flat characters, props and backgrounds cut from materials such as paper, card, stiff fabric or even photographs. The world's earliest known animated feature films were cutout animations...as is the world's earliest surviving animated feature. Today, cutout-style animation is frequently produced using computers, with scanned images or vector graphics taking the place of physically cut materials)"}, "madsrdf:citationSource": "Wikipedia website, April 14, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cutout animation: type of animation using still photos and cut-outs to form a collage. UF: Collage animation)"}, "madsrdf:citationSource": "Moving image genre-form guide online, April 14, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cut-out animation films"}}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cut-out animation films"}}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Collage animation films"}}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Collage animation films"}}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Paper cut-out animation films"}}, {"@id": "_:n33a57f83b5434c279d395c24a8fea1b5b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paper cut-out animation films"}}], "@id": "/authorities/genreForms/gf2011026181"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026188", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDance films", "identifiers:lccn": "gf2011026188", "madsrdf:adminMetadata": [{"@id": "_:n469768f71e664357afcb9aa5b5811c13b1"}, {"@id": "_:n469768f71e664357afcb9aa5b5811c13b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dance films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n469768f71e664357afcb9aa5b5811c13b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026074"}, "madsrdf:hasSource": [{"@id": "_:n469768f71e664357afcb9aa5b5811c13b5"}, {"@id": "_:n469768f71e664357afcb9aa5b5811c13b6"}, {"@id": "_:n469768f71e664357afcb9aa5b5811c13b7"}, {"@id": "_:n469768f71e664357afcb9aa5b5811c13b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025671"}}, {"@id": "_:n469768f71e664357afcb9aa5b5811c13b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n469768f71e664357afcb9aa5b5811c13b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-10-26T22:56:07"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n469768f71e664357afcb9aa5b5811c13b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dance films"}}, {"@id": "_:n469768f71e664357afcb9aa5b5811c13b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dance)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n469768f71e664357afcb9aa5b5811c13b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary note: Flamenco interpretation of the classic drama by Federico Garc\u00eda Lorca)"}, "madsrdf:citationSource": "Work cat.: Bodas de sangre [VR] 1986", "madsrdf:citationStatus": "found"}, {"@id": "_:n469768f71e664357afcb9aa5b5811c13b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dance Film. The term dance film is general and includes any film whose main focus is dance or dancing; it applies also to a film in which dance sequences figure prominently. Films on ballet and modern dance, vaudeville, ballroom, or theatrical dance, ethnic or folk dance are variously included when alluding to the dance film)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n469768f71e664357afcb9aa5b5811c13b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dance. Nonfiction work primarily concerned with dance, dancers, and choreography, including types of dance such as ballet, jazz, modern, ballroom, tap, folk, ethnic, and vaudeville. Dance work may be biographical, ethnographic, educational, or instructional in nature)"}, "madsrdf:citationSource": "Moving image genre/form guide, via WWW, Oct. 8, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026188"}
