rdf:elementValue": {"@language": "en", "@value": "Nigunim"}}, {"@id": "_:n3564d4b3a9204de5b022d2745eec0afbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Niggunim)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n3564d4b3a9204de5b022d2745eec0afbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nigunim; also Niggunim)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n3564d4b3a9204de5b022d2745eec0afbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 7, p. 1424 (Niggunim)"}, "madsrdf:citationSource": "Encyc. Judaica:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3564d4b3a9204de5b022d2745eec0afbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Nigun (In the liturgical music of the Ashkenazi Jews, an early form of centonized chant, also known as nusa\u1e25. Among the East European \u1e24asidic Jews, the term refers to a type of vocal music, often sung to nonsense syllables and accompanied by dancing; Jewish music/Liturgical and paraliturgical/Karaite (The nigunim can be loosely defined as modes, although there is no strict modal system in Karaite cantillation))"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Jan. 7, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3564d4b3a9204de5b022d2745eec0afbb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3564d4b3a9204de5b022d2745eec0afbb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Niggunim"}}, {"@id": "_:n3564d4b3a9204de5b022d2745eec0afbb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Niggunim"}}, {"@id": "_:n3564d4b3a9204de5b022d2745eec0afbb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3564d4b3a9204de5b022d2745eec0afbb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nusa\u1e25"}}, {"@id": "_:n3564d4b3a9204de5b022d2745eec0afbb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nusa\u1e25"}}], "@id": "/authorities/genreForms/gf2014026964"}
