rganizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-16T09:47:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action and adventure plays"}}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (adapted from R.L. Stevenson's novel)"}, "madsrdf:citationSource": "Morgan, Malcolm. Treasure Island : an adventure in three acts, 1954:", "madsrdf:citationStatus": "found"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Baskerville,\" at the Allen Theatre in Cleveland's Playhouse Square, is a rarity in modern theater: an action-adventure play. Once a staple of staged productions over the centuries, live action murder and mayhem largely disappeared as movies and their realistic special effects eclipsed stagecraft in the 20th century)"}, "madsrdf:citationSource": "Rowland, D. \"Baskerville\" bucks theatre trend with action-adventure, via Huffington post blog, 02/06/2017, viewed on Jan. 10, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(screenplay for an action and adventure film)"}, "madsrdf:citationSource": "Kasdan, Lawrence. Raiders of the lost ark, 1979", "madsrdf:citationStatus": "found"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Methuen drama dictionary of the theatre, 2011;The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(contents: The monkey's paw / W.W. Jacobs -- The gold bug / Edward Pomerantz, based on the story by Edgar Allan Poe -- The lonely one / Ray Bradbury -- Captains courageous / John Gay, based on the story by Rudyard Kipling -- The rose-crystal bell / Robert Arthur -- Dracula, a new version / John Mattera, based on the novel by Bram Stoker)"}, "madsrdf:citationSource": "Dracula, and other plays of adventure and suspense, \u00a91986", "madsrdf:citationStatus": "found"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a fantasy and adventure play)"}, "madsrdf:citationSource": "Work cat.: Peter Pan Company (Great Britain). Peter Pan, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Return to Vardia (Return to Vardia - three act adventure play for large cast. Author: Keith Passmore. Genre: Adventure. Tag: full length adventure scripts) Grace will lead me home (Grace will lead me home - heart warming adventure play for teens. Author: Alexia Tiches. Genre: Adventure, teen drama. Type: Two-act adventure play for teens. Tag: adventure plays)"}, "madsrdf:citationSource": "Off The Wall Plays website, Jan. 10, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Six adventure plays, 1987.", "madsrdf:citationStatus": "found"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "2015024047: Guillain, C. Writing and staging adventure plays, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "2006471337: Mast, E. J.R.R. Tolkien's The hobbit : an adventure play, \u00a91996.", "madsrdf:citationStatus": "found"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Chorpenning, C.B. Three adventure plays, 1972.", "madsrdf:citationStatus": "found"}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Action plays"}}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action plays"}}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Action and adventure drama"}}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action and adventure drama"}}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Action-adventure plays"}}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action-adventure plays"}}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Adventure plays"}}, {"@id": "_:nff0fb7d352c54b3d93b9bb200b738ae8b26", "@type": "madsrd