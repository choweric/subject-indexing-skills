{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026246", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n326d2e92648146cfbffe7ae95be6e8b3b1"}, {"@id": "_:n326d2e92648146cfbffe7ae95be6e8b3b2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is covered by the genre/form term Detective and mystery films {(gf2011026195).}"}, "madsrdf:elementList": {"@list": [{"@id": "_:n326d2e92648146cfbffe7ae95be6e8b3b3"}]}, "madsrdf:useInstead": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026195"}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fant\u00f4mas films"}}, {"@id": "_:n326d2e92648146cfbffe7ae95be6e8b3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-03-12T12:34:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n326d2e92648146cfbffe7ae95be6e8b3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n326d2e92648146cfbffe7ae95be6e8b3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fant\u00f4mas films"}}], "@id": "/authorities/genreForms/gf2011026246"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026247", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFeature films", "identifiers:lccn": "gf2011026247", "madsrdf:adminMetadata": [{"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b1"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Feature films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b5"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b6"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b7"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b8"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b9"}], "madsrdf:hasVariant": [{"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b10"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Individual full-length films with a running time of 40 minutes or more.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025003"}}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T13:57:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Feature films"}}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(feature: also called feature film)"}, "madsrdf:citationSource": "Random House", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Film (A \"feature length film\", or \"feature film\", is of a conventional full length, usually 60 minutes or more, and can commercially stand by itself without other films in a ticketed screening. A \"short\" is a film that is not as long as a feature length film, usually screened with other shorts, or preceding a feature length film)"}, "madsrdf:citationSource": "Wikipedia, May 3, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Features: Use for films which consist of 4,000 or more feet of 35mm. film, or 1,600 or more feet of 16 mm. film, i.e. with a running time of 40 min. or more)"}, "madsrdf:citationSource": "MIMS", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Feature length (Feature length is a film term that refers to the length of a feature film. The definition of minimum length varies from 40 minutes (Academy of Motion Picture Arts and Sciences rule) to about 90 minutes (the definition in Cambridge Dictionaries Online))"}, "madsrdf:citationSource": "Wikipedia, May 3, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(At an unprecedented 70 minutes The Story of the Kelly Gang is regarded as the world's first feature length film. It premiered at the Athaneum Hall in Melbourne, Australia on the 26th December 1906)"}, "madsrdf:citationSource": "Birth of the feature length film, via HubPages.com website, May 3, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Feature-length films"}}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Feature-length films"}}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Features (Motion pictures)"}}, {"@id": "_:n9ccf6eaf141d419e9bf584868ffc5101b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Features (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2011026247"}
