8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pottery"}}, {"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pottery; UF Ceramic art; Ceramics (Art); Chinaware; Crockery; Earthenware; BT Ceramics; Decorative arts; House furnishings; RT Firing (Ceramics); Saggers)"}, "madsrdf:citationSource": "LCSH, May 8, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pottery; UF Ceramics; Crockery; Earthenware; BT Furnishings; NT Porcelain; RT Cloisonn\u00e9; Potteries; Potters; Pottery industry; Pottery making; Tableware; Tiles; Urns; Vases)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, May 8, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pottery (visual works); NT include earthenware and stoneware, and more than 125 other terms; Note: Generally, all ware made of ceramic, which is any of various hard, brittle, heat-resistant and corrosion-resistant materials made by shaping and then firing a nonmetallic mineral, such as clay, at a high temperature. In specialized usage, it typically does not include porcelain, which is a type of ceramic ware made of a refractory white clay, or \"kaolin,\" and a feldspathic rock, that react when fired so the clay serves to hold the shape of the object and the rock fuses into a natural glass.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, May 8, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Earthenware"}}, {"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Earthenware"}}, {"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ceramic ware"}}, {"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ceramic ware"}}, {"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crockery"}}, {"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crockery"}}, {"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stoneware"}}, {"@id": "_:n3a3cbe70fc984c7f91c63e724a0bab88b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stoneware"}}], "@id": "/authorities/genreForms/gf2019026028"}
