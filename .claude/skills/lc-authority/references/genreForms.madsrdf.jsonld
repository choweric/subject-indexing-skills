3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bisexual poetry"}}, {"@id": "_:n373234d8d69545c1b1ebddb160e0a92db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (Suzi, the dark lady of these sonnets, is the breathtakingly beautiful, hopelessly elusive love object for their writer; Suzi, the apple of a middle-aged professor's eye--a professor who is definitely not heterosexual, though not entirely gay, either) LCSH assigned (Bisexuality--Poetry)"}, "madsrdf:citationSource": "2005011475: Allen, Edward. 67 mixed messages, \u00a92006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n373234d8d69545c1b1ebddb160e0a92db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 195 (gay/lesbian and bisexual poetry)"}, "madsrdf:citationSource": "Poet's market, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n373234d8d69545c1b1ebddb160e0a92db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (\"What is most remarkable to me about Montgomery's sonnets is how insistent is the voice which explores its bisexuality. That voice is unequivocal. --Jan-Mitchell Sherrill\")"}, "madsrdf:citationSource": "Work cat.: Montgomery, M.S. Telling the beads : sonnets, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n373234d8d69545c1b1ebddb160e0a92db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Winner, Lambda Literary Award in Bisexual Poetry)"}, "madsrdf:citationSource": "EOAGH Books website, web page for Mouth to mouth, by Abigail Child, viewed May 4, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n373234d8d69545c1b1ebddb160e0a92db9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n373234d8d69545c1b1ebddb160e0a92db10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bi poetry"}}, {"@id": "_:n373234d8d69545c1b1ebddb160e0a92db10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bi poetry"}}], "@id": "/authorities/genreForms/gf2018026054"}
