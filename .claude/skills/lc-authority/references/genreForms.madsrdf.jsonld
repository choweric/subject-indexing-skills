n", "@value": "Fakebooks (Music)"}}, {"@id": "_:n7f9840cbac7c4393886ba10581bdc26db5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 95-705862: The great composers fakebook, c1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f9840cbac7c4393886ba10581bdc26db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fake book. An informal collection of scores used by performing musicians and as a tool for learning. A fake book presents (either in loose-leaf or bound form) the music to standards and popular tunes,)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f9840cbac7c4393886ba10581bdc26db7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7f9840cbac7c4393886ba10581bdc26db8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fake books (Music)"}}, {"@id": "_:n7f9840cbac7c4393886ba10581bdc26db8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fake books (Music)"}}], "@id": "/authorities/genreForms/gf2014026798"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026799", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFalsobordone", "identifiers:lccn": "gf2014026799", "madsrdf:adminMetadata": [{"@id": "_:n66aded23b04440b18b7534d5be88c156b1"}, {"@id": "_:n66aded23b04440b18b7534d5be88c156b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Falsobordone"}, "madsrdf:elementList": {"@list": [{"@id": "_:n66aded23b04440b18b7534d5be88c156b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}, "madsrdf:hasSource": [{"@id": "_:n66aded23b04440b18b7534d5be88c156b5"}, {"@id": "_:n66aded23b04440b18b7534d5be88c156b6"}, {"@id": "_:n66aded23b04440b18b7534d5be88c156b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n66aded23b04440b18b7534d5be88c156b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n66aded23b04440b18b7534d5be88c156b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n66aded23b04440b18b7534d5be88c156b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Falsobordone"}}, {"@id": "_:n66aded23b04440b18b7534d5be88c156b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Feb. 24, 2011 (A chordal recitation based on root position triads, with the form and often the melody of a Gregorian psalm tone. Mostly intended for the singing of vesper psalms.)", "madsrdf:citationStatus": "found"}, {"@id": "_:n66aded23b04440b18b7534d5be88c156b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "95183663: Macchiarella, I. Il falsobordone fra tradizione orale e tradizione scritta, 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:n66aded23b04440b18b7534d5be88c156b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Harvard (Falsobordone. Differs from fauxbourdon)", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026799"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026800", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFandangos (Music)", "identifiers:lccn": "gf2014026800", "madsrdf:adminMetadata": [{"@id": "_:ne357bda5a6ab408589d1ac68f438c1cfb1"}, {"@id": "_:ne357bda5a6ab408589d1ac68f438c1cfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fandangos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne357bda5a6ab408589d1ac68f438c1cfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:ne357bda5a6ab408589d1ac68f438c1cfb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne357bda5a6ab408589d1ac68f438c1cfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne357bda5a6ab408589d1ac68f438c1cfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne357bda5a6ab408589d1ac68f438c1cfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fandangos (Music)"}}, {"@id": "_:ne357bda5a6ab408589d1ac68f438c1cfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fandango. A couple-dance in triple metre and lively tempo, accompanied by a guitar and castanets or palmas(hand-clapping). It is considered the most widespread of Spain's traditional dances.)"}, "madsrdf:citationSource": "Grove music online, viewed August 24, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026800"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026801", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFanfares", "identifiers:lccn": "gf2014026801", "madsrdf:adminMetadata": [{"@id": "_:n8ef523d498e245338d57cf8c5f097571b1"}, {"@id": "_:n8ef523d498e245338d57cf8c5f097571b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fanfares"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8ef523d498e245338d57cf8c5f097571b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n8ef523d498e245338d57cf8c5f097571b5"}, {"@id": "_:n8ef523d498e245338d57cf8c5f097571b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8ef523d498e245338d57cf8c5f097571b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8ef523d498e245338d57cf8c5f097571b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8ef523d498e245338d57cf8c5f097571b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fanfares"}}, {"@id": "_:n8ef523d498e245338d57cf8c5f097571b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fanfare: a flourish of trumpets or other brass instruments, often with percussion, for ceremonial purposes; fanfares are distinct from military signals in usage and character; during the 19th cent. the term came to mean a brief composition consisting of a ceremonial flourish for brass (and percussion))"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, June 27, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ef523d498e245338d57cf8c5f097571b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(for orchestra)"}, "madsrdf:citationSource": "Corigliano, J. DC fanfare, c1997", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026801"}
