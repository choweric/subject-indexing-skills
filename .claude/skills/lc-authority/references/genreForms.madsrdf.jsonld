id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-31T10:14:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social issue comics"}}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"social-consciousness comics\")"}, "madsrdf:citationSource": "Callahan, T. Miss America 70th anniversary special #1, via CBR.com, Jun. 16, 2009, viewed 24 May 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (\"genre: sociological comics\"; includes books where social questions are discussed through comics; \"social problems are studied there through a sociological research using visual and text arguments within comics frames\")"}, "madsrdf:citationSource": "Andrade, P. Austerity history through sociological comics : a guide to social media and networks against austeritocracy for use by all generations, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel; depicts the civil rights struggle in the United States)"}, "madsrdf:citationSource": "Lewis, J. March. Book one, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: social issues comics; \"the so-called 'preachies', socially conscious stories\"; discussed issues like civil rights, antisemitism, prejudice in America)"}, "madsrdf:citationSource": "Whitted, Q. EC comics : race, shock, and social protest, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (\"this book analyses graphic novels which document social crises\") p. 103 (\"a comic could be a vehicle for social issues\") p. 196 (\"graphic novels ... offering a serious documentary social analysis\")"}, "madsrdf:citationSource": "Adams, J. Documentary graphic novels and social realism, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"social protest comics\"; \"stories which denounced racism, religious intolerance, and other forms of social discrimination\")"}, "madsrdf:citationSource": "Chamblis, J. Race, shock and social protest : an interview with Qiana Whitted, via AAIHS website, Apr. 10, 2019, viewed May 24, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"an anthology of comics about abortion, from personal stories, to history, to current politics\")"}, "madsrdf:citationSource": "Comics for choice, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel; depicts African American journalists reporting on lynchings in the early 20th century American South)"}, "madsrdf:citationSource": "Work cat.: Johnson, M. Incognegro, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"social issue comics\"; comics with political awareness that focus on social issues; comics on social issues)"}, "madsrdf:citationSource": "Sean Michael Wilson's blog, viewed May 24, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Social protest comics"}}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social protest comics"}}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sociological comics"}}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sociological comics"}}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Social issues comics"}}, {"@id": "_:nbd1a4fc06aa945e59ca068ae06c2d1c7b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social issues comics"}}], "@id": "/authorities/genreForms/gf2019026079"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026080", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTheatrical fiction", "identifiers:lccn": "gf2019026080", "madsrdf:adminMetadata": [{"@id": "_:n78c57d8800094a529828a2988d7fc3f1b1"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Theatrical fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n78c57d8800094a529828a2988d7fc3f1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n78c57d8800094a529828a2988d7fc3f1b5"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b6"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b7"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b8"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b9"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b10"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b11"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b12"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b13"}], "madsrdf:hasVariant": [{"@id": "_:n78c57d8800094a529828a2988d7fc3f1b14"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features the lives and interactions of actors, directors, playwrights, and other people affiliated with the theater."}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-20T11:01:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theatrical fiction"}}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: New York, in the 1970s: rents were cheap, love was free, and the explosion of theater venues off and off-off Broadway afforded aspiring actors the opportunity to work for nothing. After Edward Day joins his fellow actors for a summer weekend on the Jersey shore, his life is never the same)"}, "madsrdf:citationSource": "Martin, V. Confessions of Edward Day : a novel, \u00a92009", "madsrdf:citationStatus": "found"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subj. hdg.: Theater--Fiction; contents: The trouper / Jack Iams -- Providence and the guitar / R.L. Stevenson -- Reginald's drama / Saki -- Shot actress-full story / H.E. Bates -- Glory in the daytime / by Dorothy Parker -- The worst thing of all / Nadine Gordimer -- Mrs. Joseph Porter over the way / Charles Dickens -- Flotsam and jetsam / W. Somerset Maugham --The adventures of a strolling player / Oliver Goldsmith -- Norbert / Kenneth Campbell -- The memento / O. Henry -- There's no business like no business / Barry Davis -- Ashes of roses / Noel Coward)"}, "madsrdf:citationSource": "Best theatre stories, 1968", "madsrdf:citationStatus": "found"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bulgakov, M. Black snow : a theatrical novel, \u00a92014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(short stories) t.p. (a series of Australian theatrical stories)"}, "madsrdf:citationSource": "Work cat.: Whitworth, R.P. Velvet and rags, 1886?:", "madsrdf:citationStatus": "found"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 72 (the Victorian theatrical novel; Victorian novels set in and around the London theater; novels about the theater; the novel's theatrical milieu; theater novels; many essentially domestic novels of the Victorian period, quite enough to form a respectable sub-genre, feature actress heroines who do make a successful transition from stage to home, carrying with them the selfless quality that marks their characters; While secondary actresses in these novels are almost always corrupt, selfish, and vulgar exhibitionists, the \"best\" actresses (talent and goodness go hand in hand) transcend the stage stereotype) p. 73 (Geraldine Jewsbury's The Half Sisters, a typical theater novel; sub-genre of the Victorian novel; theater novels' staging of femininity anticipates feminist theorists' use of the concept of performance to undermine stable categories of gender)"}, "madsrdf:citationSource": "Novel, fall 1994, via JSTOR, viewed on Aug. 4, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (Victorian theatrical fiction) p. 10 (Victorian theatrical novels; Victorian novels of the theatre; represent actresses as enjoying the power their professional abilities give them over the emotional responses of others; texts featuring actresses) p. 15 (Chapter four focuses on fictional actresses who depart from the domestic ideal) p. 17 (Victorian theatrical novels and memoirs reflect contemporary class as well as gender issues. Most commonly, these texts describe theatres as dirty, tawdry, and evil-smelling; stage managers appear driven by a concern for profit, not artistic creation. However, at the same time, they bear witness to the gentrification of the theatre) p. 26 (Victorian actress novels) p. 28 (closure in a Victorian theatrical novel comes not with an actress's attainment of professional success, but with her marrying and leaving the stage) p. 30 (theatrical novels; fictional representations of actresses) p. 36 (Geraldine Jewsbury's theatrical fiction; Jewsbury (1812-1880) was one of the first novelists to depict a poor but virtuous woman taking to the stage and retaining her virtue intact; The Half Sisters (1848), Jewsbury's most fully developed theatre novel)"}, "madsrdf:citationSource": "Pye, Deborah Kelso. \"Irreproachable women and patient workers\" : representations of the actress in Victorian prose, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 256 (Nicholas Nickleby; theatrical novel of theatrical London)"}, "madsrdf:citationSource": "The Dickensian, winter 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(series: Peggy Lane theater stories)"}, "madsrdf:citationSource": "Hughes, V. Peggy plays off-Broadway, 1962", "madsrdf:citationStatus": "found"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Delannoy, B. A thespian detective and other theatrical stories, 1899.", "madsrdf:citationStatus": "found"}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n78c57d8800094a529828a2988d7fc3f1b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Theater fiction"}}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theater fiction"}}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n78c57d8800094a529828a2988d7fc3f1b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Theatre fiction"}}, {"@id": "_:n78c57d8800094a529828a2988d7fc3f1b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theatre fiction"}}], "@id": "/authorities/genreForms/gf2019026080"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026081", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBiostatistics", "identifiers:lccn": "gf2019026081", "madsrdf:adminMetadata": [{"@id": "_:nb38c8369cece4473aa4650016d863fbeb1"}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Biostatistics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb38c8369cece4473aa4650016d863fbeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026181"}, "madsrdf:hasSource": [{"@id": "_:nb38c8369cece4473aa4650016d863fbeb5"}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb6"}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb7"}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb8"}], "madsrdf:hasVariant": {"@id": "_:nb38c8369cece4473aa4650016d863fbeb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "new"}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-04T13:40:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biostatistics"}}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(biostatistics: A narrow definition is 'the branch of science which applies statistical methods to biological problems'. More commonly, however, also includes statistics applied to medicine and health science)"}, "madsrdf:citationSource": "Cambridge Dictionary of Statistics, online, viewed May 28, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(biostatistics: Application of statistics to biological problems. The term should not be restricted to mean the application of statistics to medical problems (Medical Statistics), since its real meaning is broader, subsuming agricultural statistics, forestry, and ecology, among other applications)"}, "madsrdf:citationSource": "Dictionary of Epidemiology, online, viewed May 28, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Biometry. UF Biological statistics; Biometrics (Biology); Biostatistics. BT Statistics)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Biostatistics: The application of statistics to biological systems and organisms involving the retrieval or collection, analysis, reduction, and interpretation of qualitative and quantitative data)"}, "madsrdf:citationSource": "MeSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb38c8369cece4473aa4650016d863fbeb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biological statistics"}}, {"@id": "_:nb38c8369cece4473aa4650016d863fbeb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biological statistics"}}], "@id": "/authorities/genreForms/gf2019026081"}
