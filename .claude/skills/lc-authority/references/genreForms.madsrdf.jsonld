{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026444", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPirate films", "identifiers:lccn": "gf2011026444", "madsrdf:adminMetadata": [{"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b1"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pirate films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026628"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b5"}, "madsrdf:hasSource": [{"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b8"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b9"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b10"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b11"}], "madsrdf:hasVariant": [{"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b12"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b15"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b18"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b21"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b24"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026445"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2010025010"}]}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:03:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pirate films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pirates of the Caribbean films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pirates of the Caribbean films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pirate films are films principally concerning or contain a large subplot concerning pirates. See also Adventure films, Seafaring films. This category has the following 3 subcategories: 20,000 Leagues Under the Sea films, Mysterious Island films, Peter Pan films. Examples include: Captain Blood (1935); The Crimson Pirate; The Goonies; Nate and Hayes; Mysterious Island (1961); Mysterious Island (2005); Pirates of the Caribbean: At World's End; The Princess Bride; The Spanish Main; Treasure Island (1920); Treasure Island (1990))"}, "madsrdf:citationSource": "Wikipedia, Mar. 11, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary note: A cut-throat pirate gang led by the villainous Ben Pease has brutally interrupted the South Seas wedding ceremony of Nate and Sophie. After Sophie is abducted, Nate bands together with the infamous Hayes, a deadly rival of Pease to battle their foes.)"}, "madsrdf:citationSource": "Work cat.: Nate and Hayes [VR] c1984", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 328 (Pirate Films. These films center on the exploits of pirates, variously called corsairs, free-booters, buccaneers or privateers. Whether heroes or villains, they sailed the seven seas and in particular the Spanish Main. Examples: The black pirate (1926), Captain Blood (1935), The buccaneer (1938), The sea hawk (1940), The buccaneer (1958), La venere dei pirati (1960). Listed as a subcategory under Swashbuckler)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yee, M. Moving image materials, 1988;Taves, B. The moving image genre-form guide, via WWW, Mar. 11, 2010 (Adventure. Used for Swashbuckler. Includes fictional works dramatizing piracy and the Spanish Main. Examples listed include Captain Blood, The Sea Wolf, Treasure Island, The Buccaneers)", "madsrdf:citationStatus": "notfound"}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Buccaneer films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Buccaneer films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Corsair films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Corsair films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Freebooter films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Freebooter films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pirates of the Caribbean films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pirates of the Caribbean films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Free-booter films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Free-booter films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Privateer films"}}, {"@id": "_:ne7ea349f0fde4d5ca539549928d3b219b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Privateer films"}}], "@id": "/authorities/genreForms/gf2011026444"}
