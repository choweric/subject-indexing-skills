e": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf22c6676a39a4e8ca5522866f9a988b2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folk music radio programs"}}, {"@id": "_:nf22c6676a39a4e8ca5522866f9a988b2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Web radio browse + listen > By genre (Folk Music) About Trumix (\"TruMix (www.Trumix.com) provides access to Internet Radio and podcasts from around the world. You can download or play the podcasts straight from the website. You can create your own account and store your favourite podcasts and Internet radio stations, and choose from packaged selections of podcasts and music.\")"}, "madsrdf:citationSource": "TruMix home page, Nov. 9, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf22c6676a39a4e8ca5522866f9a988b2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (21 tracks of live Irish traditional music from the RT\u00c9 Libraries and Archives)"}, "madsrdf:citationSource": "Work cat.: Kieran Hanrahan's ten years of C\u00e9il\u00ed house [SR], 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf22c6676a39a4e8ca5522866f9a988b2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk music. UF Ethnic music; Traditional music)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nf22c6676a39a4e8ca5522866f9a988b2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"C\u00e9il\u00ed House is one of RT\u00c9 Radio's most popular programmes of traditional Irish music and song\"; site includes audio links to archived recordings of all the shows from 2004 to the present)"}, "madsrdf:citationSource": "C\u00e9il\u00ed House home page, Nov. 9, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nf22c6676a39a4e8ca5522866f9a988b2b9