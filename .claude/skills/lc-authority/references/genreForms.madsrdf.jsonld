{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026253", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aField recordings", "identifiers:lccn": "gf2011026253", "madsrdf:adminMetadata": [{"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b1"}, {"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Field recordings"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026723"}], "madsrdf:hasSource": [{"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b5"}, {"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b6"}, {"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Recordings of sounds or images made outside a controlled studio environment or professional performance venue that are generally unedited and typically made with portable equipment.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010006087"}}, {"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T13:55:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Field recordings"}}, {"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 (field recordings; those made on location outside a controlled environment)"}, "madsrdf:citationSource": "Dorritie, F. Handbook of field recording, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(field recording: A permanent copy of sounds or images made outside a controlled, studio environment, typically with portable equipment; may be on tape, film, or other media; often made by oral historians, ethnomusicologists, or linguists)"}, "madsrdf:citationSource": "Pearce-Moses, R. A glossary of archival and records terminology, via WWW, Apr. 10, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7e72e44cd064da9a8c8ecd2d83b6d96b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg: Field recordings)"}, "madsrdf:citationSource": "LCSH, Apr. 2, 2010", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026253"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026254", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFilm adaptations", "identifiers:lccn": "gf2011026254", "madsrdf:adminMetadata": [{"@id": "_:n030c041098eb432abae05b41aff49d72b1"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Film adaptations"}, "madsrdf:elementList": {"@list": [{"@id": "_:n030c041098eb432abae05b41aff49d72b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026041"}], "madsrdf:hasSource": [{"@id": "_:n030c041098eb432abae05b41aff49d72b5"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b6"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b7"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b8"}], "madsrdf:hasVariant": [{"@id": "_:n030c041098eb432abae05b41aff49d72b9"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b12"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b15"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b18"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b21"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026598"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025327"}]}, {"@id": "_:n030c041098eb432abae05b41aff49d72b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-12T14:21:23"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film adaptations"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dramatization: The process of adaptation whereby a stage play or film drama is created from major elements (plot, characters, settings) derived from a non-dramatic literary or historical work, usually a novel, romance, short story, or biography; or the new dramatic work thereby created.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dramatization 1. A play or movie adapted from a novel or depicting a particular incident. 1.1. The process of adapting a novel or presenting a particular incident in a play or movie)"}, "madsrdf:citationSource": "Oxford dictionaries online, Jan. 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(notes: Film dramatization of Shakespeare's story of the love affair between Mark Antony and Cleopatra, and its destructive consequences; Film dramatisation of Hugo's novel; A film dramatization of Shakespeare's play about two sets of lovers who sort out their problems with fairy help in the midnight woods of Athens; A film dramatization of the life of poet and novelist, Reinaldo Arenas, based on the memoir Before night falls; Film dramatization of the political struggle between Danton and Robespierre during 1794 in Paris which culminated in the execution of Danton; Set in Vienna, 1885, this film dramatization follows the struggles of Sigmund Freud as a young doctor facing the ridicule of his peers as he attempts to disprove standing medical theories relating to the dark recesses of the mind; A film dramatization of the life of Napoleon Velasco, a public school teacher who becomes a policeman; A film dramatization of the world of the Ugandan dictator Idi Amin Dada, who, in abusing his power, ravaged a half-million lives; A film dramatization of Oscar Wilde's unsuccessful libel suit against the Marquis of Queensberry after he accused Wilde of seducing his son, and Wilde's subsequent trial for sodomy, resulting in Wilde's imprisonment. Based on the book The trials of Oscar Wilde by Montgomery Hyde, and the play The stringed lute by John Furnell; A vivid, compelling film dramatization of Hugo's great novel, which provides students with an excellent historical and social portrait of France-and particularly Paris-at mid-19th century; A film dramatisation of how the events of 11 September 2001 change the lives of three very different families, in Berlin; Film dramatisation of Oscar Wilde's life)"}, "madsrdf:citationSource": "OCLC, Jan. 19, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(adaptation: Fiction or nonfiction work taken from a work already existing in another medium, such as a book, short story, comic strip, radio program, or play)"}, "madsrdf:citationSource": "Moving image genre-form guide, via WWW, July 18, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n030c041098eb432abae05b41aff49d72b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n030c041098eb432abae05b41aff49d72b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Filmed"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Filmed"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n030c041098eb432abae05b41aff49d72b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Films from books"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Films from books"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n030c041098eb432abae05b41aff49d72b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramatisations"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramatisations"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n030c041098eb432abae05b41aff49d72b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed books"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed books"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n030c041098eb432abae05b41aff49d72b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motion picture adaptations"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion picture adaptations"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n030c041098eb432abae05b41aff49d72b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramatizations"}}, {"@id": "_:n030c041098eb432abae05b41aff49d72b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramatizations"}}], "@id": "/authorities/genreForms/gf2011026254"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026255", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFilm clips", "identifiers:lccn": "gf2011026255", "madsrdf:adminMetadata": [{"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b1"}, {"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Film clips"}, "madsrdf:elementList": {"@list": [{"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b3"}]}, "madsrdf:exampleNote": "Note under [Film excerpts]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026097"}], "madsrdf:hasSource": {"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b5"}, "madsrdf:hasVariant": {"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short segments, usually incomplete scenes, of films. For parts, usually complete scenes or sequences, extracted from a complete film see [Film excerpts.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025626"}}, {"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-04T15:28:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film clips"}}, {"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(clips: 1. Short parts or segments from a complete moving image work. Although the work from which the clip was taken may have been distributed, the clip itself has not usually been distributed in this form. 2. In editing, short sections removed from a picture shot, more often called cuts or trims. 3. Also used to describe short film inserts used in live television programming. Excerpts: Parts, normally complete scenes or sequences, taken from a complete moving image work. Although the work from which the excerpt was taken may have been distributed, the excerpt itself has not usually been distributed in this form. An excerpt is distinguished from a clip by the fact that an excerpt is usually longer and gives a more detailed sense of the complete work than a clip does.)"}, "madsrdf:citationSource": "Archival moving image materials online, June 13, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Clips, Film"}}, {"@id": "_:n71371c7a98fb48bb8ea7aa3b660eef65b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Clips, Film"}}], "@id": "/authorities/genreForms/gf2011026255"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026256", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFilm excerpts", "identifiers:lccn": "gf2011026256", "madsrdf:adminMetadata": [{"@id": "_:n42c24b3bae8e4e94bf3f9359e3c43a2fb1"}, {"@id": "_:n42c24b3bae8e4e94bf3f9359e3c43a2fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Film excerpts"}, "madsrdf:elementList": {"@list": [{"@id": "_:n42c24b3bae8e4e94bf3f9359e3c43a2fb3"}]}, "madsrdf:exampleNote": "Note under [Film clips]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026097"}], "madsrdf:hasSource": [{"@id": "_:n42c24b3bae8e4e94bf3f9359e3c43a2fb5"}, {"@id": "_:n42c24b3bae8e4e94bf3f9359e3c43a2fb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Parts, usually complete scenes or sequences, extracted from a complete film. For short segments, usually incomplete scenes, of films see [Film clips.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025328"}}, {"@id": "_:n42c24b3bae8e4e94bf3f9359e3c43a2fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n42c24b3bae8e4e94bf3f9359e3c43a2fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-04T15:31:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n42c24b3bae8e4e94bf3f9359e3c43a2fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film excerpts"}}, {"@id": "_:n42c24b3bae8e4e94bf3f9359e3c43a2fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(excerpt: Portion, usually of a few minutes duration or less, of a longer, fully edited complete work. The material is too brief to be considered an incomplete copy of the work. Typical excerpt material is a title sequence, musical number, or special effects highlight; UF Clip)"}, "madsrdf:citationSource": "Moving image genre-form guide online, June 13, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n42c24b3bae8e4e94bf3f9359e3c43a2fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(excerpts: Parts, normally complete scenes or sequences, taken from a complete moving image work. Although the work from which the excerpt was taken may have been distributed, the excerpt itself has not usually been distributed in this form. An excerpt is distinguished from a clip by the fact that an excerpt is usually longer and gives a more detailed sense of the complete work than a clip does.)"}, "madsrdf:citationSource": "Archival moving image materials online, June 13, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026256"}
