{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026519", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRadio underwriting announcements", "identifiers:lccn": "gf2011026519", "madsrdf:adminMetadata": [{"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b1"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Radio underwriting announcements"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026486"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b5"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b6"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b7"}], "madsrdf:hasVariant": [{"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b8"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b11"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b14"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b17"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Announcements made on non-commercial or public radio stations that acknowledge companies or organizations, and sometimes their products and services, that contribute funds for radio programming.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025042"}}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T09:56:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio underwriting announcements"}}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Underwriting spot (an underwriting spot is an announcement made on public broadcasting outlets, especially in the United States, in exchange for funding; these spots usually mention the name of the sponsor and can resemble traditional advertising in commercial broadcasting) Underwriting (underwriting may refer to financial sponsorship of a venture, and is also used as a term within public broadcasting (both public television and radio) to describe funding given by a company or organization for the operations of the service, in exchange for a mention of their product or service within the station's programming)"}, "madsrdf:citationSource": "Wikipedia, Apr. 26, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "NPR underwriting credit guidelines (Underwriting credits acknowledge organizations which fund public radio programming. Federal law mandates this identification and further allows for the non promotional description of the sponsors products and services)"}, "madsrdf:citationSource": "National Public Radio WWW site, Apr. 26, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Underwriting FAQ (\"Underwriting is a way of supporting KSSU, a non-profit, non-commercial educational radio station, at Sacramento State University. By definition, underwriting is the on-air identification of individuals, corporations or businesses who donate funds that help pay the cost of program production\")"}, "madsrdf:citationSource": "KSSU dotcom, Apr. 26, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Underwriting announcements, Radio"}}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Underwriting announcements, Radio"}}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Underwriting spots, Radio"}}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Underwriting spots, Radio"}}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio underwriting credits"}}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio underwriting credits"}}, {"@id": "_:ndfab01709ea64bedb97c24dce1ae1913b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndfab01709ea64bedb