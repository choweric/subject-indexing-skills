{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026640", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAscension Day music", "identifiers:lccn": "gf2014026640", "madsrdf:adminMetadata": [{"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb1"}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ascension Day music"}, "madsrdf:elementList": {"@list": [{"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasSource": [{"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb5"}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb6"}], "madsrdf:hasVariant": [{"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb7"}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb10"}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music that is traditionally associated with Ascension Day."}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T09:56:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ascension Day music"}}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Feast of the Ascension; also known as Ascension Thursday, Holy Thursday, or Ascension Day, commemorates the bodily Ascension of Jesus into heaven; one of the ecumenical feasts of Christian churches; Johann Sebastian Bach composed several cantatas and the Ascension oratorio to be performed in church services on the feast day)"}, "madsrdf:citationSource": "Wikipedia, viewed August 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Choral evensong for Ascension Day [SR], 1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Feast of the Ascension music"}}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Feast of the Ascension music"}}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Holy Thursday music"}}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Holy Thursday music"}}, {"@id": "_:na8f7cb5a8bca4d0dbf73958200e85dfdb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na8f7cb5a8bca4d0dbf73958200e85