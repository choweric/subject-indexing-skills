{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026101", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBuddy films", "identifiers:lccn": "gf2011026101", "madsrdf:adminMetadata": [{"@id": "_:ned821444902b49e6b91f3da80fa01809b1"}, {"@id": "_:ned821444902b49e6b91f3da80fa01809b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Buddy films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ned821444902b49e6b91f3da80fa01809b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:ned821444902b49e6b91f3da80fa01809b5"}, {"@id": "_:ned821444902b49e6b91f3da80fa01809b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025282"}}, {"@id": "_:ned821444902b49e6b91f3da80fa01809b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-01-04T12:06:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ned821444902b49e6b91f3da80fa01809b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ned821444902b49e6b91f3da80fa01809b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Buddy films"}}, {"@id": "_:ned821444902b49e6b91f3da80fa01809b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Easy rider, 1983.", "madsrdf:citationStatus": "found"}, {"@id": "_:ned821444902b49e6b91f3da80fa01809b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Buddy: Fictional work focusing primarily on the camaraderie between two individuals, usually two men or two women. Often their relationship develops as they are thrown together while traveling or as professional partners. Although perhaps starting out as strangers, or even enemies, a bond usually comes to exist between the pair as they become friends or at least allies)"}, "madsrdf:citationSource": "Moving image genre-form guide online, March 28, 2007", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026101"}
