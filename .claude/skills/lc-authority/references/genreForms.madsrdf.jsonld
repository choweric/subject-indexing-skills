itions"}}, {"@id": "_:nd266e4dd608346efb34a016e7522a817b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Auditions: Material that demonstrates or tests the abilities of a performer(s) or speaker(s); also used for prospective programs intended for evaluation. Examples: Two for the money: rehearsal or audition; Gene Rayburn audition; Roadshow audition #1)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Nov. 28, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nd266e4dd608346efb34a016e7522a817b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Releases, Jan. 19, 2006 (JetHawks and Clear Channel Radio hold radio auditions for on-field host)"}, "madsrdf:citationSource": "Oursports central web site, Nov. 28, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd266e4dd608346efb34a016e7522a817b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd266e4dd608346efb34a016e7522a817b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Auditions, Radio"}}, {"@id": "_:nd266e4dd608346efb34a016e7522a817b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Auditions, Radio"}}], "@id": "/authorities/genreForms/gf2011026488"}
