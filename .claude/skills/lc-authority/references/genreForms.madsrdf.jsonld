{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027169", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWestern swing (Music)", "identifiers:lccn": "gf2014027169", "madsrdf:adminMetadata": [{"@id": "_:nd8157d1aff85403f8517445b6b39f508b1"}, {"@id": "_:nd8157d1aff85403f8517445b6b39f508b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Western swing (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd8157d1aff85403f8517445b6b39f508b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026739"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026879"}], "madsrdf:hasSource": [{"@id": "_:nd8157d1aff85403f8517445b6b39f508b5"}, {"@id": "_:nd8157d1aff85403f8517445b6b39f508b6"}], "madsrdf:hasVariant": {"@id": "_:nd8157d1aff85403f8517445b6b39f508b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd8157d1aff85403f8517445b6b39f508b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd8157d1aff85403f8517445b6b39f508b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd8157d1aff85403f8517445b6b39f508b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Western swing (Music)"}}, {"@id": "_:nd8157d1aff85403f8517445b6b39f508b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Originat[ed] largely in the fiddle and guitar bands in Texas during the 1920s; traditional frontier dance music; improvised like jazz bands, from whom they borrowed freely; term not used widely until after World War II; California the new center of the style in the 1940s; influenced the main stream of country music in the use of drums, walking bass patterns, and electronic instruments)"}, "madsrdf:citationSource": "New Grove dict of jazz", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8157d1aff85403f8517445b6b39f508b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Hunkel, G. Western swing and country jazz, c1983.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8157d1aff85403f8517445b6b39f508b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd8157d1aff85403f8517445b6b39f508b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Texas swing (Music)"}}, {"@id": "_:nd8157d1aff85403f8517445b6b39f508b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Texas swing (Music)"}}], "@id": "/authorities/genreForms/gf2014027169"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027170", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWizard rock (Music)", "identifiers:lccn": "gf2014027170", "madsrdf:adminMetadata": [{"@id": "_:n8db671bd541e4f9489421e82fd540f77b1"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Wizard rock (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8db671bd541e4f9489421e82fd540f77b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}, "madsrdf:hasSource": [{"@id": "_:n8db671bd541e4f9489421e82fd540f77b5"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b6"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b7"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b8"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b9"}], "madsrdf:hasVariant": {"@id": "_:n8db671bd541e4f9489421e82fd540f77b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wizard rock (Music)"}}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "jewel case, etc. (Wizard rock, film about and featuring the music genre inspired by the Harry Potter book series)"}, "madsrdf:citationSource": "Work cat.: The wizard rockumentary : a movie about rocking and Rowling, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "entry (Wizard rock (sometimes shorthanded as \"Wrock\") is a musical movement dating from 2002 that consists of at least 500 bands (including Harry and the Potters, Draco and the Malfoys, The Remus Lupins, the Whomping Willows, Oliver Boyd and the Rememberalls, The Moaning Myrtles, and The Parselmouths), made up of young musicians playing songs about Harry Potter. The movement started in Massachusetts with Harry and the Potters, though it has grown internationally)"}, "madsrdf:citationSource": "Wikipedia.org, Feb. 23, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "\"about\" page (Wizard Rock (Wrock) is a genre of music inspired by the works of J.K. Rowling, author of the popular Harry Potter book series. The first known wizard rock band was Harry and the Potters, founded by brothers Joe and Paul DeGeorge after all the bands intending to come to a backyard rock show Joe was organizing cancelled. The brothers quickly wrote a bunch of songs to perform for the audience, and wizard rock was born. Since then, many other wizard rock bands have formed. Many, like Harry and the Potters, are named for a specific character and sing songs from their point of view. Many also dress up like the character for performances)"}, "madsrdf:citationSource": "Wizardrock.org, Feb. 23, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "chapter 6 (Rocking at Hogwarts, a comprehensive chapter on wizard rock music)"}, "madsrdf:citationSource": "Anelli, Melissa. Harry, a history : the true story of a boy wizard, his fans, and life inside the Harry Potter phenomenon, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "All music guide WWW site, Feb. 23, 2009;Oxfordmusiconline (Grove), Feb. 23, 2009;Shuker, Roy. Popular music, 2005;Ammer, Christine. Facts on File dictionary of music, 2004;Harvard dictionary of music, 2003", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8db671bd541e4f9489421e82fd540f77b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wrock music"}}, {"@id": "_:n8db671bd541e4f9489421e82fd540f77b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wrock music"}}], "@id": "/authorities/genreForms/gf2014027170"}
