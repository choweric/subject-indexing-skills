-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:14:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spy films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bourne films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bourne films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "James Bond films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "James Bond films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Austin Powers films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Austin Powers films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Spy Film (Cloak and Dagger Drama, Espionage Film, Secret-Agent Film, Secret Service Drama, Spy Thriller); may be found in or form a subgenre of adventure stories, war movies, political thrillers, romance or crime films. Regardless of this, spy films have consistency in stereotypes, and similar patterns of behavior and situation keep recurring from film to film. It is best, then, to treat them as a unified, separate genre)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Austin Powers films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Austin Powers films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Secret service films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Secret service films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Espionage films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Espionage films"}}, {"@id": "_:n44f0f7c67fb2463ebcd48e274ec07c39b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": 