oc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6dcccadc41184bff844cebee28c9fa64b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:02:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6dcccadc41184bff844cebee28c9fa64b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dance music"}}, {"@id": "_:n6dcccadc41184bff844cebee28c9fa64b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(music composed specifically to facilitate or accompany dancing)"}, "madsrdf:citationSource": "Wikipedia, viewed August 29, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026753"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026754", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDancehall (Music)", "identifiers:lccn": "gf2014026754", "madsrdf:adminMetadata": [{"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b1"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dancehall (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027045"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026122"}, "madsrdf:hasSource": [{"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b5"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b6"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b7"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b8"}], "madsrdf:hasVariant": [{"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b9"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b12"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b15"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b18"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b21"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dancehall (Music)"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 106 (The emergence of dancehall music. In 1985, Wayne Smith, a popular dancehall singer, released a tune named Under mi sleng teng, which took dancehall by storm. What was new about Smith's song is that it used a drum machine and synthesized instruments as a backing track rather than a live drummer and bass player. Gradually, producers started using more and more synthesized riddims rather than live musicians in the studio. Eventually these digital riddims were used on a majority of new tunes. This combination of synthesized backing tracks and dancehall-style performances became known simply as \"dancehall music\" toward the end of the decade. Outside Jamaica, especially in England, the term ragga was used to refer to dancehall music.) p. 107 (As a result of these changes in musical structure and lyrical themes, local and foreign enthusiasts started arguing over the meaning of dancehall music and whether it was worthy of being called reggae. Not surprisingly, Rasta performers and musicians as well as foreign roots fans joined the purist camp, arguing that dancehall was certainly not reggae, even going so far at times to claim that it wasn't music. The majority of dancehall fans paid no attention to this debate and embraced dancehall as the latest genre of reggae.)"}, "madsrdf:citationSource": "Stolzoff, N., Wake the town & tell the people, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dancehall developed in the '80s as \"ragamuffin\", a hybrid style featuring a DJ or \"sing-jay\" half-singing, half-rapping with often bawdy (\"slack\") themes. The musical structure is rooted in reggae though the rhythms, played by drum machines, are considerably faster. By the '90s, dancehall crossover was common, with many gangsta-rappers incorporating dancehall rhythms and its rapid-fire toasting. Major dancehall figures include Yellowman and Shabba Ranks.)"}, "madsrdf:citationSource": "All Music Guide, online, Jul. 16, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ragga. Raggamuffin music, usually abbreviated as ragga; ragga is now mainly used as a synonym for dancehall reggae or for describing dancehall with a deejay chatting rather than deejaying or singing on top of the riddim.)"}, "madsrdf:citationSource": "Wikipedia, Sept. 2, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dancehall is a genre of Jamaican popular music which developed in the late 1970s, initially as a more sparse and less political and religious variant of reggae than the roots style that had dominated much of the 1970s. In the mid-1980s, digital instrumentation became more prevalent, changing the sound considerably, with digital dancehall (or \"ragga\") becoming increasingly characterized by faster rhythms with little connection to earlier reggae rhythms. Stylistic origins: Reggae, R&B, Ska, Rocksteady, Dub, Toast.)"}, "madsrdf:citationSource": "Wikipedia (Jul. 16, 2009)", "madsrdf:citationStatus": "found"}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Digital dancehall (Music)"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Digital dancehall (Music)"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ragamuffin (Music)"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ragamuffin (Music)"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Raggamuffin (Music)"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Raggamuffin (Music)"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reggae dancehall music"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reggae dancehall music"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dancehall reggae music"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dancehall reggae music"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dance-hall (Music)"}}, {"@id": "_:n87eebb995c2948f2ad36ee098ea3c576b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dance-hall (Music)"}}], "@id": "/authorities/genreForms/gf2014026754"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026755", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDangdut", "identifiers:lccn": "gf2014026755", "madsrdf:adminMetadata": [{"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab1"}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dangdut"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab5"}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab6"}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab7"}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab8"}], "madsrdf:hasVariant": [{"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab9"}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dangdut"}}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2009027535: Weintraub, A. Dangdut stories, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Dang dut Bugis safari, 1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 104 (Dangdut; Indonesian popular music, emerged as a result of exposure to Indian film and Western popular music. Indian film left its musical imprint on orkes melayu, a predecessor to dangdut. With a combination of more traditional orkes melayu and kroncong with the sounds of electrified Western pop and rock, the way was paved for a more lively and provocative style of music. By 1975, largely through the personality and music of Rhoma Irama, the term dangdut came to be used to describe the new Indonesian popular music. Present-day dangdut groups use instruments found in most Western rock bands (electric guitars, bass, trap set, etc.). What distinguishes dangdut from other forms of popular music is the rhythm: emphatic fourth and first beats in 4/4 meter. This rhythm is the source of the name dangdut (rest-rest-dang-dut, rest-rest-dang-dut, etc.), suggesting two different kinds of drumstrokes)"}, "madsrdf:citationSource": "Garland encyc. world music, v. 4, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Dhandhut Buton, 1996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dang dut"}}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dang dut"}}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dhandhut"}}, {"@id": "_:n9881b72c6b0f4700a5ce1616770fc74ab13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dhandhut"}}], "@id": "/authorities/genreForms/gf2014026755"}
