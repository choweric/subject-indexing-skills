{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027008", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPolyphonic Lieder", "identifiers:lccn": "gf2014027008", "madsrdf:adminMetadata": [{"@id": "_:n4d78d13ffff44ee49c71205474b79596b1"}, {"@id": "_:n4d78d13ffff44ee49c71205474b79596b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Polyphonic Lieder"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4d78d13ffff44ee49c71205474b79596b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": {"@id": "_:n4d78d13ffff44ee49c71205474b79596b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "German polyphonic songs of the 14th-16th centuries."}, {"@id": "_:n4d78d13ffff44ee49c71205474b79596b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n4d78d13ffff44ee49c71205474b79596b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:53:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4d78d13ffff44ee49c71205474b79596b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Polyphonic Lieder"}}, {"@id": "_:n4d78d13ffff44ee49c71205474b79596b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Lied, I. The polyphonic lied of the late Middle Ages and Renaissance. The first polyphonic and rhythmically notated German songs are the two-voiced lieder of the Monk of Salzburg (before 1400). The first major composer was Oswald von Wolkenstein (ca. 1377-1445)... a number of anonymous lied manuscripts... date from the latter half of the 15th century... A distinct German genre is the lied in which parts are composed around a pre-existent monophonic melody in the top or a middle voice. In the 16th century, the preexistent lied was most commonly in the tenor voice (whence the term Tenorlied for this genre).)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th edition, 2003 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027008"}
