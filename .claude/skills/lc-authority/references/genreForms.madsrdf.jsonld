8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ang\u00e9lique films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ang\u00e9lique films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indiana Jones films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indiana Jones films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bourne films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bourne films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Die Hard films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Die Hard films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb29", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Action films have tremendous impact, continuous high energy, lots of physical stunts and activity, possibly extended chase scenes, races, rescues, battles, martial arts, mountains and mountaineering, destructive disasters (floods, explosions, natural disasters, fires, etc.), fights, escapes, non-stop motion, spectacular rhythm and pacing, and adventurous heroes -- all designed for pure audience escapism with the action sequences at the core of the film. The main action centers around a male action hero or protagonist. Adventure films are exciting stories, with new experiences or exotic locales. Adventure films are very similar to the action film genre, in that they are designed to provide an action-filled, energetic experience for the film viewer. Rather than the predominant emphasis on violence and fighting that is found in action films, however, the viewer of adventure films can live vicariously through the travels, conquests, explorations, creation of empires, struggles and situations that confront the main characters, actual historical figures or protagonists)"}, "madsrdf:citationSource": "Filmsite WWW site, May 21, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb30", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Swashbucklers. Use for fictional genre films in which the protagonist, in period costume, fights, usually with his sword, for a noble cause. RT Epics; Thrillers: USE Crime drama, Disaster drama, Horror drama, Spy drama)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb31", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Adventure films; UF Swashbucklers, Thrillers)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb32", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Adventure. Fictional work set in a historical period, from the Middle Ages through the 19th century, typically dramatizing the exploits of actual historical figures or incidents, including kings and battles, rebellion, piracy and the Spanish Main, travel, exploration, and the creation of empires. Larger ideological issues are mythicized and conflicts personalized over historical accuracy. Adventure usually involves a courageous, altruistic and patriotic hero willing to fight for his beliefs, who becomes involved in a struggle for freedom by overcoming oppression and helping to create a more just society. Used for Swashbuckler. Other genres often confused with Adventure include Ancient world, Animal, Aviation, Crime, Thriller, Science fiction, Survival, and War; for a comprehensive list, examine the see references under Action-adventure; Action-adventure see such genres as Adventure, Ancient world, Animal, Aviation, Caper, Crime, Disaster, Espionage, Fantasy, Gangster, Jungle, Martial arts, Mystery, Police, Prehistoric, Prison, Science fiction, Singing cowboy, Sports, Survival, Thriller, War, Western, Yukon)"}, "madsrdf:citationSource": "The moving image genre-form guide, via WWW, Mar. 6, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Adventure movies"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Adventure movies"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ang\u00e9lique films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ang\u00e9lique films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tarzan films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tarzan films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb42", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb43"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indiana Jones films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb43", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indiana Jones films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb45", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb46"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bourne films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb46", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bourne films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb48", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb49"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Action films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb49", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb51", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb52"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "James Bond films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb52", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "James Bond films"}}, {"@id": "_:ndf6b3e80ce3147418d2f8c3ba08ed70cb54", "@type": ["madsrdf:GenreFo