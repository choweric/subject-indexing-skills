"@id": "_:nd041963e22f84b99b6bd9a4a34325ef6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Occasional speeches"}}, {"@id": "_:nd041963e22f84b99b6bd9a4a34325ef6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Occasional speeches. BT Speeches, addresses, etc.)"}, "madsrdf:citationSource": "LCSH, Sept. 19, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd041963e22f84b99b6bd9a4a34325ef6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(partial contents: Gen. U.S. Grant : address upon his death, delivered in Portland, Oregon, August 8, 1885 -- William Pitt Fessenden : address upon his death, delivered in the United States Senate, December 14, 1869 -- George Washington : address upon the 100th anniversary of his inauguration as President of the United States, delivered in Portland, Oregon, May 1, 1889 -- Salmon P. Chase : address upon his death, delivered in the Supreme Court of the United States, October 23, 1873 -- Pioneers of Oregon : address at the thirteenth annual reunion of the Oregon Pioneer Association, at Oregon City, June 15, 1885 -- Portland Exposition : address at the opening of the Exposition building, delivered in Portland, Oregon, September 27, 1890 -- Oregon & California Railroad : address upon its completion, delivered at Portland, Oregon, December 20, 1887 -- Portland, Oregon : its growth and prospects : address at the laying of the corner-stone of the Chamber of Commerce building, January 1, 1892 -- Study and practice of medicine : address to the graduating class of the medical department of the Willamette University, Portland, Oregon, delivered April 16, 1885 -- Discovery of America : address upon the 400th anniversary of the discovery of America by Columbus, delivered at Portland, Oregon, October 22, 1892 -- Militia : address at the laying of the corner-stone of the Armory of the Oregon National Guard, Portland, Oregon, August 6, 1887)"}, "madsrdf:citationSource": "Work cat.: Williams, G.H. Occasional addresses, 1895", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026113"}
