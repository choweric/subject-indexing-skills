rdChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6b197b3de225419981db2e7d378f089fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Progressive rock (Music)"}}, {"@id": "_:n6b197b3de225419981db2e7d378f089fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP t.p. (English progressive rock and the counterculture)"}, "madsrdf:citationSource": "Work cat.: 95049637: Macan, E.L. Rocking the classics, 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b197b3de225419981db2e7d378f089fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Progressive rock: a form of rock music in which electric instruments and rock-band formats are integrated with European classical motifs and orchestrations, typically forming extended, intricate, multisectional suites; sometimes known as \"art rock\")"}, "madsrdf:citationSource": "Rolling stone ency. of rock & roll, c1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b197b3de225419981db2e7d378f089fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. ix (Prog rock)"}, "madsrdf:citationSource": "The Billboard guide to progressive music, c1977:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b197b3de225419981db2e7d378f089fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b197b3de225419981db2e7d378f089fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Art rock (Music)"}}, {"@id": "_:n6b197b3de225419981db2e7d378f089fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Art rock (Music)"}}, {"@id": "_:n6b197b3de225419981db2e7d378f089fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b197b3de225419981db2e7d378f089fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prog rock (Music)"}}, {"@id": "_:n6b197b3de225419981db2e7d378f089fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prog rock (Music)"}}], "@id": "/authorities/genreForms/gf2014027018"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027019", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProkeimena", "identifiers:lccn": "gf2014027019", "madsrdf:adminMetadata": [{"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb1"}, {"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Prokeimena"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027020"}, "madsrdf:hasSource": {"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb5"}, "madsrdf:hasVariant": {"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prokeimena"}}, {"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Prokeimenon (A chant sung in the Byzantine Divine Liturgy (see Divine liturgy (byzantine)) and at the Offices of Hesperinos and Orthros. Prokeimenon consist of a response, usually known as the prokeimenon, the text of which is taken from the psalms, and between two and four psalm verses, called stichoi. They are normally chanted before scriptural readings: in the Divine Liturgy, before the Epistle (corresponding to the position of the Roman gradual))"}, "madsrdf:citationSource": "Grove music online, viewed May 28, 2014 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prokimena"}}, {"@id": "_:n1f43fb3b7a32479a861c2be2ec4f18afb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prokimena"}}], "@id": "/authorities/genreForms/gf2014027019"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027020", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPropers (Music)", "identifiers:lccn": "gf2014027020", "madsrdf:adminMetadata": [{"@id": "_:nad17a9bac7b841bc91b87c6165bfd169b1"}, {"@id": "_:nad17a9bac7b841bc91b87c6165bfd169b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Propers (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nad17a9bac7b841bc91b87c6165bfd169b3"}]}, "madsrdf:exampleNote": "Note under [Masses]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026707"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026627"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026841"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026877"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026973"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027019"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027144"}], "madsrdf:hasSource": {"@id": "_:nad17a9bac7b841bc91b87c6165bfd169b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Chants of the Mass propers. For musical settings of the Mass in its entirety or for the Mass ordinary see [Masses.]"}, {"@id": "_:nad17a9bac7b841bc91b87c6165bfd169b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nad17a9bac7b841bc91b87c6165bfd169b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:48:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nad17a9bac7b841bc91b87c6165bfd169b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Propers (Music)"}}, {"@id": "_:nad17a9bac7b841bc91b87c6165bfd169b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Proper chants (from Lat. Proprium [missae et officii]. Chants whose texts vary from day to day, as distinct from those whose texts remain constant (Ordinary chants). Strictly the term applies to chants from both Mass and Office, but it is customary to use the term chiefly to refer to Mass chants, owing to the need for terms that distinguish between those parts of the Mass most often set polyphonically from the second half of the 14th century onwards (the Ordinary), and those usually sung as plainchant. Nevertheless, there are settings of cycles of Proper chants by, for example, composers of the Notre Dame School (see Magnus liber), Isaac and Byrd. The Proper chants of the Mass are the introit, gradual, alleluia, tract, offertory and communion. The sequence, sung throughout the Middle Ages on important feast days, may also be included in this category, as may also tropes, adjuncts to the above group of chants, which were always Proper to a particular feast)"}, "madsrdf:citationSource": "Grove music online, viewed May 28, 2014 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027020"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027021", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProstopinije", "identifiers:lccn": "gf2014027021", "madsrdf:adminMetadata": [{"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b1"}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Prostopinije"}, "madsrdf:elementList": {"@list": [{"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026707"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasSource": [{"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b5"}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b6"}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b7"}], "madsrdf:hasVariant": [{"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b8"}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b11"}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prostopinije"}}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "2006560475: Spanovich, H. The divine liturgy, the eight tones, feastday music in the Carpatho-Russian plain chant,", "madsrdf:citationStatus": "found"}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Website of the American Carpatho-Russian Orthodox Diocese of the U.S.A. (The Carpatho-Rusyn Slavonic plainchant (prostopinije) is a typical and distinctive feature of Rusyn culture. It developed from the znamennyi chant. In the late 15th century, the Slavonic znamennyi chant began to diversify into the North Russian and Ruthenian traditions, the latter employed in the Grand Duchy of Lithuania, the Kingdom of Poland, and the Kingdom of Hungary. The Carpatho-Rusyns have preserved the old znamennyj chant down to the present as the oldest element in their traditional prostopinije. The melodies of znamennyj chant are organized into 8 tones or modes (hlasy). Each chant text is assigned to one of these hlasy, and must be sung to a melody of that tone. The melodies are composed by the same method used by Byzantine chant; they are built up out of standardized melodic phrases. Each hlas contains a large number (up to several hundred) of these phrases.)", "madsrdf:citationStatus": "found"}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove dict.,2nd ed. (Russian and Slavonic church music; 4, The southwestern tradition: Belorussia, Ukraine and Carpathian Rus. The Old Believers in Russia and the village churches of Galicia and Carpathian Rus kept alive the monophonic chant tradition, with concessions to 'folk polyphony'. The Carpatho-Rusyn chant became known as Prostopenije. The original practice of congregational singing continues to the present day in the southwestern Rusyn tradition, including the diaspora churches of Old Believers and Carpatho-Rusyn Greek Catholics and Orthodox in the USA and Canada)", "madsrdf:citationStatus": "found"}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Carpatho-Rusyn chants"}}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Carpatho-Rusyn chants"}}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prostopeniye"}}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prostopeniye"}}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prostopenije"}}, {"@id": "_:na85d1a2f2bbb4e9b866bd5f56ca03e72b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prostopenije"}}], "@id": "/authorities/genreForms/gf2014027021"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027022", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProsulas (Music)", "identifiers:lccn": "gf2014027022", "madsrdf:adminMetadata": [{"@id": "_:nfc5f9c81b53f4a3bb3201fd8ee9177ddb1"}, {"@id": "_:nfc5f9c81b53f4a3bb3201fd8ee9177ddb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Prosulas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfc5f9c81b53f4a3bb3201fd8ee9177ddb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026843"}, "madsrdf:hasSource": [{"@id": "_:nfc5f9c81b53f4a3bb3201fd8ee9177ddb5"}, {"@id": "_:nfc5f9c81b53f4a3bb3201fd8ee9177ddb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfc5f9c81b53f4a3bb3201fd8ee9177ddb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nfc5f9c81b53f4a3bb3201fd8ee9177ddb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfc5f9c81b53f4a3bb3201fd8ee9177ddb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prosulas (Music)"}}, {"@id": "_:nfc5f9c81b53f4a3bb3201fd8ee9177ddb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "00295751: Die Offertoriumsprosuln der aquitanischen Handschriften, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc5f9c81b53f4a3bb3201fd8ee9177ddb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove (Prosula. Text created to fit melisma in Gregorian chant. Alternative term similarly employed in medieval mss. include \"tropus,\" see Trope. There are prosulas for chants of Mass and Office)", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027022"}
