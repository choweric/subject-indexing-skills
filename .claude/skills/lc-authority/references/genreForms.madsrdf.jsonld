2012-04-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photogrammetric maps"}}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(What is a photogrammetric map? [A] topographic map produced by means of aerial photogrammetry)"}, "madsrdf:citationSource": "Answers.com, Apr. 18, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "recto (compiled by photogrammetric methods from aerial photographs taken 1975, field checked 1980, map edited 1983)"}, "madsrdf:citationSource": "Work cat.: Geological Survey (U.S.). Topographic map of the island of Ponape, Federated States of Micronesia, 1983:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Countywide digital photogrammetric maps are now available. These maps were generated from aerial photographs made in 1987) Photogrammetric maps index (Photogrammetric maps index - Town of Clarkstown, Rockland County; Photogrammetric maps index - Town of Haverstraw, Rockland County; Photogrammetric maps index - Town of Orangetown, Rockland County; Photogrammetric maps index - Town of Ramapo, Rockland County; Photogrammetric maps index - Town of Stony Point, Rockland County)"}, "madsrdf:citationSource": "Rockland County (N.Y.) Dept. of Highways Maps & Highway Information System home page, Apr. 18, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "recto (Topography by photogrammetric methods from aerial photographs taken 1955. Field checked 1958. Limited revision 1970)"}, "madsrdf:citationSource": "Geological Survey (U.S.). Map of Yosemite Valley, Yosemite National Park and Wilderness, California, Mariposa County, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: A photogrammetric map of the Ohio State University campus; Photogrammetric map (horizontal) of mummy cave; Photogrammetric maps of a volcanic eruption area, Deception Island, Antarctica; Investigation and determination of planimetric accuracy of photogrammetric maps plotted for cadastral purposes; Testing map accuracy : an investigation of acceptance specifications and inspection procedures for maps prepared by photogrammetric methods; Photogrammetric compilation of a topographic map; The development of a digital photogrammetric map revision system for use in developing countries; 1\u02ba=40\u02b9 series photogrammetric base maps of Washington, D.C.)"}, "madsrdf:citationSource": "OCLC, Apr. 18, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(photogrammetric map: A topographic map produced from aerial photographs and geodetic control data by means of photogrammetric instruments. Also called stereometric map; stereotopographic map)"}, "madsrdf:citationSource": "Glossary of mapping, charting, and geodetic terms, c2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "recto (this map was constructed by photogrammetric methods)"}, "madsrdf:citationSource": "United States. Forest Service. Pacific Northwest Region. Chelan Nat'l Forest and adjacent territory, 1948:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "chapter 12, p. 1 (photogrammetric map compilation)"}, "madsrdf:citationSource": "Falkner, E. Aerial mapping, c2002, viewed online Apr. 18, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a4002737e3348b88cdd5cf61f032518b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stereotopographic maps"}}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stereotopographic maps"}}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a4002737e3348b88cdd5cf61f032518b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stereometric maps"}}, {"@id": "_:n0a4002737e3348b88cdd5cf61f032518b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stereometric maps"}}], "@id": "/authorities/genreForms/gf2012025032"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2012025033", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMental maps", "identifiers:lccn": "gf2012025033", "madsrdf:adminMetadata": [{"@id": "_:n2ce1edc3ce3c46a79b790b4782baef65b1"}, {"@id": "_:n2ce1edc3ce3c46a79b790b4782baef65b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mental maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2ce1edc3ce3c46a79b790b4782baef65b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:n2ce1edc3ce3c46a79b790b4782baef65b5"}, {"@id": "_:n2ce1edc3ce3c46a79b790b4782baef65b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2ce1edc3ce3c46a79b790b4782baef65b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-10-10T09:02:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2ce1edc3ce3c46a79b790b4782baef65b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-07-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n2ce1edc3ce3c46a79b790b4782baef65b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mental maps"}}, {"@id": "_:n2ce1edc3ce3c46a79b790b4782baef65b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(To be geographically informed, a person must keep in mind a lot of information about people, places, and environments and must be able to organize this information in the appropriate spatial context. A very effective way of doing this is to create and use what can be called \"mental maps.\" Such a map is an individual's internalized representation of some aspect or aspects of Earth's surface. Mental maps have several distinguishing characteristics: Mental maps are personal and idiosyncratic and are usually a mixture of both objective knowledge and subjective perceptions. They contain objective and precise knowledge about the location of geographic features, such as continents, countries, cities, mountain ranges, and oceans. They also contain more subjective and less precise information, such as impressions of places, rough estimates of relative size, shape, and location, and a general sense of certain connections between places as well as priorities that reflect the mapmaker's own predilections. Mental maps are used in some form by all people throughout their lives. Such maps enable people to know what routes to take when traveling, comprehend what others say or write about various places, and develop an understanding of the world.)"}, "madsrdf:citationSource": "National geographic xpeditions archive WWW site, July 10, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ce1edc3ce3c46a79b790b4782baef65b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mental maps: A mental map can best be explained as a visual display, inside a person's head, showing where a person has traveled. A mental map shows what the person knows about the location and the uniqueness of a place. No mental map is alike. Every human has his or her own mental map.)"}, "madsrdf:citationSource": "FedStats WWW site, July 10, 2012:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2012025033"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2012025034", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSatirical films", "identifiers:lccn": "gf2012025034", "madsrdf:adminMetadata": [{"@id": "_:na953e9ddcf944fb79a744c2663cfa807b1"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Satirical films"}, "madsrdf:elementList": {"@list": [{"@id": "_:na953e9ddcf944fb79a744c2663cfa807b3"}]}, "madsrdf:exampleNote": "Note under [Parody films]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026147"}, "madsrdf:hasSource": [{"@id": "_:na953e9ddcf944fb79a744c2663cfa807b5"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b6"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b7"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b8"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b9"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b10"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b11"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b12"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b13"}], "madsrdf:hasVariant": [{"@id": "_:na953e9ddcf944fb79a744c2663cfa807b14"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b17"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b20"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b23"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b26"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b29"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b32"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that use wit, irony, or sarcasm to hold up human vices or foibles to ridicule or scorn. For films that comically imitate another work or group of works of a more serious nature see [Parody films.]"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-08-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:20:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical films"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lampoon: satire 1; specifically : a harsh satire usually directed against an individual. Synonyms: satire, pasquinade)"}, "madsrdf:citationSource": "Merriam-Webster online, Aug. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Satire (Satirical Comedy, Satirical Film, Satiric Comedy). Satire seeks to make us aware of human faults and follies by ridiculing them. It casts an eye on society and its institutions and tries to expose wickedness, abuses of power and infringements of human rights and dignity. Straight satire is a continuous flow of scathing humor and caustic wit. It often uses exaggeration and fantastic occurrences to make its point. The most common types of satire are social satire, political satire and religious satire. Quite often, satire uses the vehicle of black comedy, science fiction or fable for its outer form of presentation. Parody and satire are sometimes confused. When the object of satire is a single individual rather than society, the term lampoon is often used. Examples: Modern Times; Animal Farm; A King in New York; Welcome to L.A.; Being There; Deal of the Century; The Act; Repo Man; Brazil; Down and Out in Beverly Hills; Salvation!)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lampoon: a sharp, often virulent satire directed against an individual or institution; a work of literature, art, or the like, ridiculing severely the character or behavior of a person, society, etc.)"}, "madsrdf:citationSource": "Dictionary.com, Aug. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Shampoo (film) (Shampoo is a 1975 satirical film written by Robert Towne and directed by Hal Ashby.) Satire (Satire is primarily a literary genre or form, although in practice it can also be found in the graphic and performing arts. In satire, vices, follies, abuses, and shortcomings are held up to ridicule, ideally with the intent of shaming individuals, and society itself, into improvement. Although satire is usually meant to be funny, its greater purpose is often constructive social criticism, using wit as a weapon. Satire is nowadays found in many artistic forms of expression, including literature, plays, commentary, and media such as lyrics; The film The Great Dictator (1940) by Charlie Chaplin is a satire on Adolf Hitler; The film Dr. Strangelove from 1964 was a popular satire on the Cold War)"}, "madsrdf:citationSource": "Wikipedia, Aug. 16, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"The Internet Movie Database includes 'Satire,' 'Social Satire,' or 'Political Satire' as one of the keywords describing the films below.\")"}, "madsrdf:citationSource": "Top satirical films (#1-100), via WWW, Aug. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category: Satirical films; four subcategories: American satirical films\u200e; Films based on Animal Farm\u200e; Indian satirical films; Political satire films)"}, "madsrdf:citationSource": "Wikipedia, Aug. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "course info page (Satiric Film) films (Excalibur; Monty Python and H.G.; Blazing Saddles; Making Mr. Right; Animal House; South Park; Slaughterhouse-Five; Dr. Strangelove; Starship Troopers; 1984; Brazil; Gattaca; Lathe of Heaven; Fight Club)"}, "madsrdf:citationSource": "Satire in film, via Miami University website, Aug. 16, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Shampoo (Motion picture). Shampoo [VR], c1991.", "madsrdf:citationStatus": "found"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Konigsberg, I. The complete film dictionary, c1997;Beaver, F.E. Dictionary of film terms, c2006;Yee, M.M.Moving image materials, 1988;Taves, B. The moving image genre-form guide, 1998.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na953e9ddcf944fb79a744c2663cfa807b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Film satires"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film satires"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na953e9ddcf944fb79a744c2663cfa807b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satirical comedy films"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical comedy films"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na953e9ddcf944fb79a744c2663cfa807b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric films"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric films"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na953e9ddcf944fb79a744c2663cfa807b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric comedy films"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric comedy films"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na953e9ddcf944fb79a744c2663cfa807b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lampoons (Motion pictures)"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lampoons (Motion pictures)"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na953e9ddcf944fb79a744c2663cfa807b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satire films"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satire films"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na953e9ddcf944fb79a744c2663cfa807b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satires (Motion pictures)"}}, {"@id": "_:na953e9ddcf944fb79a744c2663cfa807b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satires (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2012025034"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2012025035", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSatirical television programs", "identifiers:lccn": "gf2012025035", "madsrdf:adminMetadata": [{"@id": "_:n60bab564cc25400c965cee0db1a8a8eab1"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Satirical television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n60bab564cc25400c965cee0db1a8a8eab3"}]}, "madsrdf:exampleNote": "Note under [Parody television programs]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026654"}, "madsrdf:hasSource": [{"@id": "_:n60bab564cc25400c965cee0db1a8a8eab5"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab6"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab7"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab8"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab9"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab10"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab11"}], "madsrdf:hasVariant": [{"@id": "_:n60bab564cc25400c965cee0db1a8a8eab12"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab15"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab18"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab21"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab24"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab27"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab30"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that use wit, irony, or sarcasm to hold up human vices or foibles to ridicule or scorn. For television programs that comically imitate another work or group of works of a more serious nature see [Parody television programs.]"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:21:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-08-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical television programs"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: South Park (Television program). Season 1. South Park. The complete first season [VR], 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lampoon: satire 1; specifically : a harsh satire usually directed against an individual. Synonyms: satire, pasquinade)"}, "madsrdf:citationSource": "Merriam-Webster online, Aug. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "South Park (South Park is an American animated sitcom; famous for its crude language and dark, surreal humor that lampoons a wide range of topics; Genre: Black comedy; Off-color humor; Surreal humor; Slapstick; Satire) The Colbert Report (The Colbert Report is an American satirical late night television program that airs Monday through Thursday on Comedy Central. It satirizes conservative personality-driven political pundit programs, particularly Fox News' The O'Reilly Factor. Genre: Comedy, Satire, News parody) Satire (Satire is primarily a literary genre or form, although in practice it can also be found in the graphic and performing arts. In satire, vices, follies, abuses, and shortcomings are held up to ridicule, ideally with the intent of shaming individuals, and society itself, into improvement. Although satire is usually meant to be funny, its greater purpose is often constructive social criticism, using wit as a weapon. Satire is nowadays found in many artistic forms of expression, including literature, plays, commentary, and media such as lyrics; Stephen Colbert's television program, The Colbert Report, is instructive in the methods of contemporary American satire; The television program South Park relies almost exclusively on satire to address issues in American culture; Satire is used on many UK television programmes, particularly popular panel shows and quiz shows such as Mock the Week and Have I Got News for You; Canada has had several prominent satirical television series. Some, including CODCO, The Royal Canadian Air Farce, and This Hour Has 22 Minutes deal directly with current news stories and political figures, while others, like History Bites present contemporary social satire in the context of events and figures in history)"}, "madsrdf:citationSource": "Wikipedia, Aug. 16, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Konigsberg, I. The complete film dictionary, c1997;Beaver, F.E. Dictionary of film terms, c2006;Yee, M.M.Moving image materials, 1988;Taves, B. The moving image genre-form guide, 1998.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lampoon: a sharp, often virulent satire directed against an individual or institution; a work of literature, art, or the like, ridiculing severely the character or behavior of a person, society, etc.)"}, "madsrdf:citationSource": "Dictionary.com, Aug. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Colbert report. Selections. The best of The Colbert report [VR], 2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Satire (Satirical Comedy, Satirical Film, Satiric Comedy). Satire seeks to make us aware of human faults and follies by ridiculing them. It casts an eye on society and its institutions and tries to expose wickedness, abuses of power and infringements of human rights and dignity. Straight satire is a continuous flow of scathing humor and caustic wit. It often uses exaggeration and fantastic occurrences to make its point. The most common types of satire are social satire, political satire and religious satire. Quite often, satire uses the vehicle of black comedy, science fiction or fable for its outer form of presentation. Parody and satire are sometimes confused. When the object of satire is a single individual rather than society, the term lampoon is often used. Examples: Glory! Glory! (89 CTV))"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60bab564cc25400c965cee0db1a8a8eab13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satire television programs"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satire television programs"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60bab564cc25400c965cee0db1a8a8eab16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric television programs"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric television programs"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60bab564cc25400c965cee0db1a8a8eab19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television satires"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television satires"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60bab564cc25400c965cee0db1a8a8eab22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satires (Television programs)"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satires (Television programs)"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60bab564cc25400c965cee0db1a8a8eab25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric comedy television programs"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric comedy television programs"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60bab564cc25400c965cee0db1a8a8eab28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satirical comedy television programs"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical comedy television programs"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60bab564cc25400c965cee0db1a8a8eab31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lampoons (Television programs)"}}, {"@id": "_:n60bab564cc25400c965cee0db1a8a8eab31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lampoons (Television programs)"}}], "@id": "/authorities/genreForms/gf2012025035"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2012025038", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSplatter films", "identifiers:lccn": "gf2012025038", "madsrdf:adminMetadata": [{"@id": "_:nbe446224d5854544bf3d6bbda88944ceb1"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Splatter films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbe446224d5854544bf3d6bbda88944ceb3"}]}, "madsrdf:exampleNote": "Note under [Slasher films]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026321"}, "madsrdf:hasSource": [{"@id": "_:nbe446224d5854544bf3d6bbda88944ceb5"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb6"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb7"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb8"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb9"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb10"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb11"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb12"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb13"}], "madsrdf:hasVariant": [{"@id": "_:nbe446224d5854544bf3d6bbda88944ceb14"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb17"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb20"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb23"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb26"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb29"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature graphic depictions of gore, hard-core violence, and murder. For films that feature a psychotic killer who stalks and murders a series of victims, usually with unconventional weapons, see [Slasher films.]"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:22:07"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-11-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Splatter films"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "slasher film (A general category for horror films that focuses on the mutilation and killing of women, generally by a psychotic killer. See slice-and-dice, splatter, and stalker films for related designations) slice-and-dice film, slide-'n'-dice film (Any one of a group of horror films in recent years that features the butchering of human beings, often attractive young females. All of the Friday the 13th films would fit this category.) splatter film (A film with a good deal of violence and a large amount of blood (e.g., Theatre of Blood (1973; dir. Douglas Hickox)) stalker film, stalk-and-slash film (A film that features a knife-wielding maniac tracking and dispatching a series of victims, generally women (e.g., any of the Jack the Ripper films))"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dictionary, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Splatter movies (A splatter film or gore film is a type of horror film that deliberately focuses on graphic portrayals of gore and graphic violence. These films, through the use of special effects and excessive blood and guts, tend to display an overt interest in the vulnerability of the human body. Due to their willingness to portray images society might consider shocking, splatter films share ideological grounds with the transgressive art movement. Sometimes the gore is so excessive it becomes a comedic device. These types of comedic gore films have been dubbed splatstick (a portmanteau of \"splatter\" and \"slapstick\"). As a distinct genre, the splatter film began in the 1960s with the films of Herschell Gordon Lewis, who became notorious for such work as Blood Feast (1963). Lewis has been called the \"Godfather of Gore.\" Blood Feast is widely considered as the first splatter film. While many splatter films fall into the exploitation film subgenre, some make their way into the mainstream. One of the most successful splatter films, critically and commercially, was George A. Romero's 1978 zombie film Dawn of the Dead. The term \"splatter film\" is often confused with \"slasher film.\" While there is often overlap, many slasher movies, like Halloween (1978), are not considered splatter films because they don't have enough on-screen gore.)"}, "madsrdf:citationSource": "Monsters-movies.com, Nov. 9, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Blood feast [VR] c2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Splatter film (A splatter film or gore film is a subgenre of horror film that deliberately focuses on graphic portrayals of gore and graphic violence. These films, through the use of special effects, tend to display an overt interest in the vulnerability of the human body and the theatricality of its mutilation. The combination of graphic violence and sexually suggestive imagery in some films has been labeled \"torture porn\" or \"gorno\" (a portmanteau of \"gore\" and \"porno\")."}, "madsrdf:citationSource": "Wikipedia, Nov. 9, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(blood-and-gore thrilers: 1,620 hits; blood 'n' gore movies: 4,290 hits; gore-fests: 103,000 hits; gorno: 700,000 hits; splatter flicks: 10,000; torture porn: 1,090,000 hits [most probably are not films])"}, "madsrdf:citationSource": "Google, Jan. 11, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gore Film (Blood-and-Gore Thriller, Blood Film, Blood 'n' Gore Movie, Gore-Fest, Meat Movie, Splatter Movie, Ultra-Violent Movie). The most explicit of all the genres that thrive on violence, the gore film presents graphic scenes of mayhem or what is known as hard-core violence. The violence is extremely explicit and of a horrifying or shocking nature with heads and limbs chopped off, tongues torn out, eyes gouged out, disembowelments and guts galore spilled; Examples: Blood Feast (1963), Two Thousand Maniacs1 (1964), The Gruesome Twosome (1966), The Ghastly Ones (1967), The Last House on the Left (1972), The Texas Chainsaw Massacre (1974), The Hills Have Eyes (1976), Dawn of the Dead (1977), Antropophagus (1979), The Driller Killer (1979), Bad Taste (1987))"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "McCarty, J. Splatter movies, 1984.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Splatter Films: Splatter films revel in showcasing large amounts of blood and gore. The name is derived from the blood splatter shown on screen and presumably the vomit splatter from the audience. Director Herschell Gordon Lewis created the style when his Blood Feast (1963) and Two Thousand Maniacs (1964) introduced new levels of gore into the film industry. Later in the '70s and '80s, Italian cannibal films like Cannibal Apocalypse, Cannibal Ferox and Cannibal Holocaust and zombie films like City of the Living Dead, Zombie and Burial Ground continued the splatter tradition.)"}, "madsrdf:citationSource": "Harris, M.H. Exploitation movies 101, via About.com Horror & suspense movies website, Nov. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (splatter flicks; horror films) p. 1 (horror films; commonly termed \"splatter flicks\", \"slashers\", \"spookfests\")"}, "madsrdf:citationSource": "Caldwell, Sara. Splatter flicks, c2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbe446224d5854544bf3d6bbda88944ceb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Splatter flicks"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Splatter flicks"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbe446224d5854544bf3d6bbda88944ceb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Torture porn (Splatter films)"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Torture porn (Splatter films)"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbe446224d5854544bf3d6bbda88944ceb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gorno (Splatter films)"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gorno (Splatter films)"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbe446224d5854544bf3d6bbda88944ceb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Splatter movies"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Splatter movies"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbe446224d5854544bf3d6bbda88944ceb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gore films"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gore films"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbe446224d5854544bf3d6bbda88944ceb30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gore-fests (Motion pictures)"}}, {"@id": "_:nbe446224d5854544bf3d6bbda88944ceb30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gore-fests (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2012025038"}
