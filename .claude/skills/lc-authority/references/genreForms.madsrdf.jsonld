 "_:na88d5ce21300478b9baddcc3e3c34474b46"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b49"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b52"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b55"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b58"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-07-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-09-04T13:09:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Public opinion polls"}}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Public opinion polls. UF Opinion surveys. BT Social surveys> RT Public opinion)"}, "madsrdf:citationSource": "UNESCO thesaurus, via WWW, July 13, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(opinion poll: an activity in which many people are asked the same questions in order to find out what most people think about something; public opinion: what most people think about something)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, July 13, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 6 (findings relating to public attitudes to house building as measured by the British Social Attitudes survey (BSA) 2014; survey has been run annually since 1983; to measure the extent to which the attitudes, values and beliefs of the British public change over time)"}, "madsrdf:citationSource": "Public attitudes to house building : findings from the 2014 British Social Attitudes Survey, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Public opinion polls. UF Opinion polls; Polls, Public opinion; Public opinion--Research; Public opinion research; Straw votes. BT Social surveys. RT Market surveys)"}, "madsrdf:citationSource": "LCSH, July 13, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ormiston, R. Scottish social attitudes survey 2009 : local issues, national concerns : public attitudes to antisocial behaviour in Scotland, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Impact of technological change in the industrial democracies : public attitudes toward information technology : a 1985 international comparative public opinion survey, \u00a91985.", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Monitoring changes in the passenger transport industry : 1992 public attitudes survey, 1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(public-opinion poll: a poll taken by sampling a cross section of the public in an effort to predict election results or to estimate public attitudes on issues)"}, "madsrdf:citationSource": "Dictionary.com, July 13, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Public attitudes towards CCTV : results from the Pre-intervention Public Attitude Survey carried out on areas implementing CCTV, 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Public perceptions of the Queensland Public Service and local government : findings from the 2005 Public Attitudes Survey, 2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Arizona wilderness public opinion survey, 1983.", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. iii (results of the survey show that many Australians consider crime-related issues to be of importance, a large majority would like more spent on police and law enforcement and that television, radio and newspapers are the major source of information about crime and justice for most people; results from the survey are valuable for giving us a measure of public attitudes and perceptions of crime and the criminal justice system) p. ix (AuSSA 2007 consisted of a cross sectional mail-out survey completed by 8,133 adults from all Australian states and territories) p. 1 (public attitudes; public opinion)"}, "madsrdf:citationSource": "Work cat: Roberts, L. What Australians think about crime and justice : results from the 2007 Survey of Social Attitudes, \u00a92009:", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b17", "@type": "madsrdf:Source", "madsrdf:citationSource": "Levi, D. Public attitude survey on solar energy for Portland, Oregon, 1984.", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Opinion poll; alternative title: public opinion poll; a method for collecting information about the views or beliefs of a given group. Information from an opinion poll can shed light on and potentially allow inferences to be drawn about certain attributes of a larger population. Opinion polls typically involve a sample of respondents, drawn to represent a larger relevant population, who are asked a standardized series of questions in a fixed form. The results are analyzed for the entire respondent sample, as well as for specific subsamples that represent subgroups in the population. In some cases, the relevant population is well known and easily operationalized, as in the case of \"adults age 18 and over residing in telephone households.\" But in other cases, the relevant population has to be constructed during the course of the interview, as in the case of \"likely voters.\")"}, "madsrdf:citationSource": "Britannica online, July 13, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(public opinion polls. SN Polls taken by sampling a cross section of the public in an effort to predict election results or establish public attitudes. UF opinion polls)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 13, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Public opinion polls. BT Communication and mass media; Social surveys; RT Public opinion)"}, "madsrdf:citationSource": "UNBIS thesaurus, via WWW, July 13, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b21", "@type": "madsrdf:Source", "madsrdf:citationSource": "Health care issues public opinion survey, 1996 or 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na88d5ce21300478b9baddcc3e3c34474b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surveys, Public attitude"}}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surveys, Public attitude"}}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na88d5ce21300478b9baddcc3e3c34474b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Social attitude surveys"}}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social attitude surveys"}}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na88d5ce21300478b9baddcc3e3c34474b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Opinion surveys"}}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Opinion surveys"}}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na88d5ce21300478b9baddcc3e3c34474b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Public attitude surveys"}}, {"@id": "_:na88d5ce21300478b9baddcc3e3c34474b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Public attitude surveys"}},