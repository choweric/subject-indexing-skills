{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026482", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPolitical fiction", "identifiers:lccn": "gf2014026482", "madsrdf:adminMetadata": [{"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b1"}, {"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Political fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b5"}, {"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b6"}, {"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b7"}, {"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features the political milieu."}, {"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:25:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Political fiction"}}, {"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(political fiction: used for fictional works that feature the political environment including candidates and elections)"}, "madsrdf:citationSource": "WorldCat genres, Nov. 3, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (novels of political estrangement shift attention from political actors and institutions to the general public--ordinary people whose agency has been appropriated by autocratic regimes, by bureaucratic institutions; this shift is from what politics do for people to what they do to people)"}, "madsrdf:citationSource": "Scheingold, S.A. The political novel, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(political fiction: a subgenre of fiction that deals with political affairs to provide commentary on political events, systems and theories; works of political fiction often directly criticize an existing society or present an alternative, sometimes fantastic, reality; political fiction frequently employs the literary modes of satire, often in the genres of utopian and dystopian fiction)"}, "madsrdf:citationSource": "Wikipedia, Nov. 3, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n86906d76e6184e6484e603d7ddf1ef11b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(4062 works tagged with term political-fiction)"}, "madsrdf:citationSource": "Goodreads, Nov. 15, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026482"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026485", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPornographic comics", "identifiers:lccn": "gf2014026485", "madsrdf:adminMetadata": [{"@id": "_:n96e06bcdaab047b4858d1f420991f156b1"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pornographic comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n96e06bcdaab047b4858d1f420991f156b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n96e06bcdaab047b4858d1f420991f156b5"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026572"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026318"}, "madsrdf:hasSource": [{"@id": "_:n96e06bcdaab047b4858d1f420991f156b8"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b9"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b10"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b11"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b12"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b13"}], "madsrdf:hasVariant": [{"@id": "_:n96e06bcdaab047b4858d1f420991f156b14"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b17"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b20"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b23"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b26"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b29"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026354"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-05-02T14:38:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pornographic comics"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96e06bcdaab047b4858d1f420991f156b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay pornographic comics"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay pornographic comics"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Adult comics (Adult comics are comic books intended for adults. They may tell stories of a more mature nature than other comics or may contain material that might be considered disturbing, horrifying, obscene, profane, immoral, and even pornographic. Adult comics include graphic novels, longer serialized comics, and shorter stories.The term \"adult comics\" in the past generally referred to those with explicit sexual content, and was sometimes separated from comics labeled for \"mature readers\") Pornography (Pornography (often abbreviated as \"porn\" in informal usage) is the explicit portrayal of sexual subject matter. The term applies to the depiction of the act rather than the act itself, and so does not include live exhibitions like sex shows and striptease. Pornography is often distinguished from erotica, which consists in the portrayal of sexuality with high-art aspirations, focusing also on feelings and emotions, while pornography involves the depiction of acts in a sensational manner, with the entire focus on the physical act, so as to arouse quick intense reactions.) Hentai (Hentai is a word of Japanese origin which is short for hentai seiyoku, a perverse sexual desire. In Japanese, the term describes any type of perverse or bizarre sexual desire or act; it does not represent a genre of work. Internationally, hentai is a catch-all term to describe a genre of anime and manga pornography. English adopts and uses hentai as a genre of pornography by the commercial sale and marketing of explicit works under this label.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 30, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Note in OCLC bib. record: Pornographic comic books for mature readers)"}, "madsrdf:citationSource": "Carnal comics, 1994-", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (Hentai: A Japanese term meaning \"pervert.\" This refers to pornographic manga or anime)"}, "madsrdf:citationSource": "Fletcher-Spear, K. Library collections for teens : manga and graphic novels, c2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comic porn; porn comics; porno comics; adult comics; pornographic comics; pornographic webcomics; pornographic comic books; pornographic comic strips; sex comics; cartoon pornography; x-rated comics; x-rated comic book porn; x-rated comic strips; x rated comic books; sex picture comics; sexually explicit comics)"}, "madsrdf:citationSource": "Google search, Nov. 30, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Summary note in OCLC bib. record: In the 1930s, American \"Tijuana Bibles,\" little pornographic comic books that parodied popular comics and comic strips, were widely available)"}, "madsrdf:citationSource": "Pilcher, T. Erotic comics : a graphic history from Tijuana bibles to underground comix, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (Explicit content)"}, "madsrdf:citationSource": "Narukami, Y. Pretty poison, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96e06bcdaab047b4858d1f420991f156b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay pornographic comics"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay pornographic comics"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96e06bcdaab047b4858d1f420991f156b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "X-rated comics"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "X-rated comics"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96e06bcdaab047b4858d1f420991f156b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Adult comics (Pornographic comics)"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Adult comics (Pornographic comics)"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96e06bcdaab047b4858d1f420991f156b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Porn comics"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Porn comics"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96e06bcdaab047b4858d1f420991f156b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hentai (Comics)"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hentai (Comics)"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96e06bcdaab047b4858d1f420991f156b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Porno comics"}}, {"@id": "_:n96e06bcdaab047b4858d1f420991f156b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Porno comics"}}], "@id": "/authorities/genreForms/gf2014026485"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026486", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPriamels", "identifiers:lccn": "gf2014026486", "madsrdf:adminMetadata": [{"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b1"}, {"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Priamels"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026312"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}], "madsrdf:hasSource": [{"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b5"}, {"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b6"}, {"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Medieval German epigrammatic poems that consist of a series of seemingly unrelated, often paradoxical statements cleverly brought together at the end."}, {"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:31:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Priamels"}}, {"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Priamel. BT Gnomic poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(priamel: It denotes a form of German folk verse which had some vogue from the 12th to the 16th c. It appears to have developed from a kind of improvised epigram. Basically a priamel comprised a variety of disconnected ideas and observations with a surprise conclusion.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a3086ee67bf4ddc9bebe286350949d6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Priamel. The term was conceived to designate a sub-genre of epigrammatic poems composed primarily in Germany from the 12th through the 16th cs. and characterized by a series of seemingly unrelated, often paradoxical statements cleverly brought together at the end, usually in the final verse. Numerous collections survive. As it is currently defined, the priamel consists of two basic parts: the foil and the climax. The function of the foil is to introduce and highlight the climactic term by enumerating or summarizing a number of other instances that then yield (with varying degrees of contrast or analogy) to the particular point of interest or importance.)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026486"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026487", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProblem plays", "identifiers:lccn": "gf2014026487", "madsrdf:adminMetadata": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b1"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Problem plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026290"}, "madsrdf:hasSource": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b5"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b6"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b7"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b8"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b9"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b10"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b11"}], "madsrdf:hasVariant": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b12"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b15"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b18"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b21"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b24"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b27"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b30"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b33"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that dramatize contemporary social problems and are intended to change public opinion."}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:32:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Problem plays"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(problem play: see thesis play; thesis play: A drama which deals with a specific problem and, very probably, offers a solution. This form appears to have originated in the 19th c. Both Dumas (fils) and Brieux wrote a considerable number between 1860 and 1900. Elsewhere Ibsen was a major influence on the genre, for example A Doll's House (1879); this type of drama is also known as a problem or propaganda play.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Problem Play. Name given to the type of play that dramatizes contemporary social problems, with the characters representing or speaking for the forces involved. Problem plays were written and performed by the ancient Greeks. Not until the late nineteenth century, however, did the problem play come into its own as a popular theatrical genre, with the social problem as its primary reason for being. The problem drama reached its artistic apogee in the later works of Henrik Ibsen)"}, "madsrdf:citationSource": "McGraw-Hill encyclopedia of world drama, c1972", "madsrdf:citationStatus": "found"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 110 (the genre of the social thesis play by dramatists like Eug\u00e8ne Brieux and Paul Hervieu)"}, "madsrdf:citationSource": "Beach, C. Staging politics and gender, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(in titles: thesis play; thesis-play; social thesis drama; problem drama; problem play; problem-play; social problem play)"}, "madsrdf:citationSource": "OCLC, Mar. 12, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(problem play. A form of drama that raises controversial social questions. The modern problem play was first developed by the French playwright Alexandre Dumas in a series of plays attacking social evils. The most celebrated name associated with the form is that of the great Norwegian playwright Henrik Ibsen)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(problem play. Usually a play dealing with a particular social problem in a realistic manner designed to change public opinion; also called a thesis play. Significant examples are Henrik Ibsen's A Doll's House (1879), on women's subordination in marriage, and Bernard Shaw's Mrs. Warren's Profession (1902) on prostitution. See also Discussion play)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Problem Play. A type of drama that was popularized by the Norwegian playwright Henrik Ibsen. In problem plays, the situation faced by the protagonist is put forward by the author as a representative instance of a contemporary social problem; often the dramatist manages--by the use of a character who speaks for the author, or by the evolution of the plot, or both--to propose a solution to the problem which is at odds with prevailing opinion)"}, "madsrdf:citationSource": "Abrams, M. A glossary of literary terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Social problem drama"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social problem drama"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Problem drama"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Problem drama"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Social thesis drama"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social thesis drama"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Thesis plays"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thesis plays"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Social problem plays"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social problem plays"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Social thesis plays"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social thesis plays"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Propaganda drama"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Propaganda drama"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Propaganda plays"}}, {"@id": "_:naec3cea45a7d45a683c8655aaf4869d8b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Propaganda plays"}}], "@id": "/authorities/genreForms/gf2014026487"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026488", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProse poems", "identifiers:lccn": "gf2014026488", "madsrdf:adminMetadata": [{"@id": "_:na2e4d3e646e744eebd21342f058b26bdb1"}, {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Prose poems"}, "madsrdf:elementList": {"@list": [{"@id": "_:na2e4d3e646e744eebd21342f058b26bdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026425"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026071"}], "madsrdf:hasSource": [{"@id": "_:na2e4d3e646e744eebd21342f058b26bdb5"}, {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb6"}, {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb7"}], "madsrdf:hasVariant": {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Prose that utilizes poetic techniques to emphasize sound, imagery, and figurative language."}, {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:32:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prose poems"}}, {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Prose poem. Poetic language printed in prose paragraphs, but displaying the careful attention to sound, imagery, and figurative language characteristic of poetry. While some prose achieves poetic status by virtue of its lyricism, sonority, figurative language, etc., prose poetry goes further in constituting itself as poetry, but without the visible appearance of verse.)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Prose Poem; the controversially hybrid and (aesthetically and politically) revolutionary genre of the prose poem; principal characteristics: high patterning, rhythmic and figural repetition, sustained intensity, and compactness. The short form is a sure model here; otherwise, the prose poem merges with the essay.)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetic Form: Prose Poem--Though the name of the form may appear to be a contradiction, the prose poem essentially appears as prose, but reads like poetry. While it lacks the line breaks associated with poetry, the prose poem maintains a poetic quality, often utilizing techniques common to poetry, such as fragmentation, compression, repetition, and rhyme. The prose poem can range in length from a few lines to several pages long, and it may explore a limitless array of styles and subjects.)"}, "madsrdf:citationSource": "Poets.org, viewed Dec. 26, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na2e4d3e646e744eebd21342f058b26bdb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prose poetry"}}, {"@id": "_:na2e4d3e646e744eebd21342f058b26bdb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prose poetry"}}], "@id": "/authorities/genreForms/gf2014026488"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026492", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPsychological fiction", "identifiers:lccn": "gf2014026492", "madsrdf:adminMetadata": [{"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab1"}, {"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Psychological fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026561"}, "madsrdf:hasSource": [{"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab5"}, {"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab6"}, {"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab7"}, {"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction in which the thoughts, feelings, and motivations of the characters are of equal or greater interest than the external action of the narrative."}, {"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:32:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psychological fiction"}}, {"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(psychological novel, a novel that focuses on the complex mental and emotional lives of its characters and explores the various levels of mental activity)"}, "madsrdf:citationSource": "Random House Webster's unabridged dictionary, c1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Psychological Fiction (Psychological fiction is a work of prose fiction which places more than the usual amount of emphasis on interior characterization, and on the motives, circumstances, and internal action which springs from, and develops, external action. The psychological novel is not content to state what happens but goes on to explain the motivation of this action. In this type of writing character and characterization are more than usually important, and they often delve deeper into the mind of a character than novels of other genres.)"}, "madsrdf:citationSource": "Goodreads website, Feb. 18, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(psychological novel, also called psychological realism)"}, "madsrdf:citationSource": "Wikipedia, Feb. 18, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d881d3c98ee4ffa99a4969090e7741ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(psychological novel, work of fiction in which the thoughts, feelings, and motivations of the characters are of equal or greater interest than is the external action of the narrative; plot is subordinate to and dependent upon the probing delineation of character; events may not be presented in chronological order but rather as they occur in the character's thought associations, memories, fantasies, reveries, contemplations, and dreams)"}, "madsrdf:citationSource": "Encyclop\u00e6dia Britannica online academic edition, Nov. 5, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026492"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026493", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPuppet plays", "identifiers:lccn": "gf2014026493", "madsrdf:adminMetadata": [{"@id": "_:na087c028bb2e48828d320e76b04c2f21b1"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Puppet plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:na087c028bb2e48828d320e76b04c2f21b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:na087c028bb2e48828d320e76b04c2f21b5"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026541"}, "madsrdf:hasSource": [{"@id": "_:na087c028bb2e48828d320e76b04c2f21b8"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b9"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b10"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b11"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b12"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b13"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b14"}], "madsrdf:hasVariant": [{"@id": "_:na087c028bb2e48828d320e76b04c2f21b15"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b18"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b21"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b24"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/genreForms/gf2013025007"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-24T10:11:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puppet plays"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na087c028bb2e48828d320e76b04c2f21b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed puppet plays"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed puppet plays"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "wayang (Derived from baying (shadow). 1. A flat leather puppet used to represent a character in a shadow play (wayang kulit). 2. By extension, a play or performance in which shadow puppets are used and, therefore, an abbreviation of wayang kulit. 3. By further extension, a play or performance derived from wayang kulit, but differing from it either in dramatic repertory or medium of performance. For example, \"listening to wayang on the radio,\" when wayang golek doll-puppet theatre is meant. 4. Also spelled wajang.)"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985:", "madsrdf:citationStatus": "found"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(puppetry: the art of manipulating puppets or marionettes in a dramatic performance. Puppets were used in religious ritual and folk drama in many early civilizations and still have this function in Java and parts of India. In Japan, the form of puppet theatre known as Bunraku or Joruri and developed by Chikamatsu Monzaemon (1653-1724) is still actively maintained. Introduced into England from Italy in the late 17th century, puppet theatre flourished throughout Europe during the 18th century and enjoyed an artistic revival in the late 19th and early 20th centuries)"}, "madsrdf:citationSource": "Macmillan Encyclopedia, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Whanslaw, H.W. A book of marionette plays, 1951?", "madsrdf:citationStatus": "found"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Anderson, D. Amazingly easy puppet plays : 42 new scripts for one-person puppetry, c1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Dunn, C.J. The early Japanese puppet drama, 1966.", "madsrdf:citationStatus": "found"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Schroeder, J. Fun puppet skits for schools and libraries, 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(puppet show, puppet play (a show in which the actors are puppets))"}, "madsrdf:citationSource": "WordNet search, Nov. 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na087c028bb2e48828d320e76b04c2f21b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wayang plays"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wayang plays"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na087c028bb2e48828d320e76b04c2f21b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Marionette plays"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Marionette plays"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na087c028bb2e48828d320e76b04c2f21b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Puppet drama"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puppet drama"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na087c028bb2e48828d320e76b04c2f21b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wajang plays"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wajang plays"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na087c028bb2e48828d320e76b04c2f21b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed puppet plays"}}, {"@id": "_:na087c028bb2e48828d320e76b04c2f21b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed puppet plays"}}], "@id": "/authorities/genreForms/gf2014026493"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026494", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPurim plays", "identifiers:lccn": "gf2014026494", "madsrdf:adminMetadata": [{"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b1"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Purim plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026241"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}], "madsrdf:hasSource": [{"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b5"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b6"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b7"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b8"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b9"}], "madsrdf:hasVariant": [{"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b10"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b13"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b16"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b19"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that depict Old Testament characters and are associated with the Jewish holiday of Purim."}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:33:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Purim plays"}}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Goldberg, D. Purim drama, 193-?", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Purim spiel. A Purim Spiel, or Purimshpil, meaning a Purim play--shpil means 'game' or '(stage) play' in Yiddish. A Purim Spiel is usually a comic dramatization, as a traditional type of Jewish play, or informal theatrical production, with participants, usually children, wearing costumes that depict the characters in the story in the Book of Esther, the central text and narrative that describes what transpired on Purim and why it has become an important Jewish holiday. By the 18th century in eastern Romania and some other parts of Eastern Europe, Purim plays (called Purimshpiln) had evolved into broad-ranging satires with music and dance, precursors to Yiddish theater, for which the story of Esther was little more than a pretext: indeed, by the mid-19th century, some were even based on other stories, such as Joseph sold by his brothers, Daniel, or the Binding of Isaac. Purimspiels are still performed in many communities.)"}, "madsrdf:citationSource": "Wikipedia, May 23, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (The purimshpil (Purim playlet) is the quintessential Jewish folk theatre form, which emerged from both the letter and the spirit of the law of the biblical Book of Esther; traditional folk play) p. 336 (Purimshpil/n - Purim play/s)"}, "madsrdf:citationSource": "Troy, S.S. On the play and the playing : theatricality as leitmotif in the purimshpil of the Bobover Hasidim, c2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Purim plays, associated with the Jewish Festival of Purim on the 14th Adar (roughly the middle of March), appear to have originated in France and Germany as early as the 14th century, mainly as extemporized entertainments centring on the Old Testament story of Esther and Haman. Under the influence of the masquerades and mumming of the Italian Carnival, they developed into plays featuring racy dialogue, with interposed songs and dances, which widened their scope to include other Old Testament figures such as Joseph and his brethren, David and Goliath, Moses and Aaron. Mostly in one act, they featured comic rabbis, apothecaries, midwives, and devils, the whole ending with a final chorus foretelling Israel's salvation)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Daxelm\u00fcller, C. Ester und die Ministerkrisen : Wandlungen des Esterstoffes in j\u00fcdisch-deutschen und jiddischen Purimspielen, 1989.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Purimshpiln"}}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Purimshpiln"}}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Purim drama"}}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Purim drama"}}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Purim Spiels"}}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Purim Spiels"}}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Purimspiels"}}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Purimspiels"}}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Purimspielen"}}, {"@id": "_:n9ff25c37f0ed4752b295855d238f53e0b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Purimspielen"}}], "@id": "/authorities/genreForms/gf2014026494"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026495", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aQa\u1e63\u012bdas", "identifiers:lccn": "gf2014026495", "madsrdf:adminMetadata": [{"@id": "_:na068e6776b7642b3ad6a2100628631f9b1"}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Qa\u1e63\u012bdas"}, "madsrdf:elementList": {"@list": [{"@id": "_:na068e6776b7642b3ad6a2100628631f9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422"}, "madsrdf:hasSource": [{"@id": "_:na068e6776b7642b3ad6a2100628631f9b5"}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b6"}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b7"}], "madsrdf:hasVariant": [{"@id": "_:na068e6776b7642b3ad6a2100628631f9b8"}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems with a single rhyme that reminisce about the narrator's lost love, then describe Bedouin life and/or a journey, and conclude with a tribute to a patron or other person."}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:33:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Qa\u1e63\u012bdas"}}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Qasida: A type of formal ode believed to have originated in the 6th century, and used by Arabic, Persian, Turkish and Urdu poets. The poet began with a nostalgic reference to a re-discovery of a place which recalled his love; then dwelt on his love; then on the ensuing sufferings it caused. There followed a lengthy account of the various journeys he had undertaken. Finally, he sang the praises of one who, he hoped, would become the patron of his efforts. The verses were transmitted orally at first; later they were written down.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(qa\u1e63\u012bdah, also spelled kasida, Turkish kas\u00eede, Persian qa\u1e63\u012bdeh; poetic form developed in pre-Islamic Arabia and perpetuated throughout Islamic literary history into the present. It is a laudatory, elegiac, or satiric poem that is found in Arabic, Persian, and many related Asian literatures. The classic is an elaborately structured ode of 60 to 100 lines, maintaining a single end rhyme that runs through the entire piece; the same rhyme also occurs at the end of the first hemistich (half-line) of the first verse. The qa\u1e63\u012bdah opens with a short prelude, the nasib, which is elegiac in mood and is intended to gain the audience's involvement. The nasib depicts the poet stopping at an old tribal encampment to reminisce about the happiness he shared there with his beloved and about his sorrow when they parted. After this conventional beginning follows the rahil, which consists of descriptions of the poet's horse or camel or of desert animals and scenes of desert events and Bedouin life and warfare; it may conclude with a piece on fakhr, or self-praise. The main theme, the madih, or panegyric, often coupled with hija (satire of enemies), is last and is the poet's tribute to himself, his tribe, or his patron)"}, "madsrdf:citationSource": "Britannica academic edition online, Feb. 15, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Qa\u1e63\u012bda. A monorhymed lyric poem common to Arabic, Persian, Turkish, Pashto, and Urdu literature. The rhyme scheme is aa ba ca, etc. and some qasidas run to over a hundred lines. The Arabic qasida generally shows a tripartite structure consisting of an erotic prelude (nasib) wherein the poet weeps over the deserted campground of his beloved, an account of a desert journey (rahil) which includes a description of his mount, and the panegyric proper (madih))"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na068e6776b7642b3ad6a2100628631f9b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kasidas"}}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kasidas"}}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na068e6776b7642b3ad6a2100628631f9b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Qa\u1e63\u012bdehs"}}, {"@id": "_:na068e6776b7642b3ad6a2100628631f9b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Qa\u1e63\u012bdehs"}}], "@id": "/authorities/genreForms/gf2014026495"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026496", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aQu (Poetry)", "identifiers:lccn": "gf2014026496", "madsrdf:adminMetadata": [{"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb1"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Qu (Poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb5"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb6"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb7"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb8"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb9"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb10"}], "madsrdf:hasVariant": [{"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb11"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb14"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb17"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Classical Chinese poetry consisting of words written in one of a number of certain, set tone patterns, and based upon the tunes of various songs."}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:33:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Qu (Poetry)"}}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003;Baldick, C. The Oxford dictionary of literary terms, 2008;Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "300 Yuan songs = Yuan qu san bai shou, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yuan qu yi bai wu shi shou : Han Ying dui zhao = 150 masterpieces in Yuan qu-poetry, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 236 (under China, Popular Poetry of: to the 14th c. many forms of popular song eventually were taken up by elite writers and developed into genres of cl. poetry such as shi, ci, or qu) p. 237 (under Chinese Poetic Drama: When the component songs are referred to as qu (songs), they related a narrative as experienced by the individual who sings of it and are considered dramatic verse. Set to the exact same music but unconnected by plot, sanqu (or unconnected songs) are considered lyric poetry; qu are characterized by lines of uneven length, dictated by the melody)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Qu are a type of Classical Chinese poetry form, consisting of words written in one of a number of certain, set tone patterns, based upon the tunes of various songs. Thus qu poems are lyrics with lines of varying longer and shorter lengths, set according to the certain and specific, fixed-patterns of rhyme and tone of conventional musical pieces upon which they are based and after which these matched variations in lyrics (or individual qu poems) generally take their name. The fixed-tone type of verse such as the qu and the ci together with the shi and fu forms of poetry comprise the three main forms of Classical Chinese poetry)"}, "madsrdf:citationSource": "Wikipedia, Nov. 15, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Qu (Chinese literature). UF Ch\u02bb\u00fc)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yuan qu (Poetry)"}}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yuan qu (Poetry)"}}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ch\u02bb\u00fc (Poetry)"}}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ch\u02bb\u00fc (Poetry)"}}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yuanqu (Poetry)"}}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yuanqu (Poetry)"}}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yuan songs"}}, {"@id": "_:n0c80ddbef1d84d31a3dd41bf5efae93bb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yuan songs"}}], "@id": "/authorities/genreForms/gf2014026496"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026497", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aQuatrains", "identifiers:lccn": "gf2014026497", "madsrdf:adminMetadata": [{"@id": "_:n580c924076614d37b58500aec86f530eb1"}, {"@id": "_:n580c924076614d37b58500aec86f530eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Quatrains"}, "madsrdf:elementList": {"@list": [{"@id": "_:n580c924076614d37b58500aec86f530eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026466"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026523"}], "madsrdf:hasSource": [{"@id": "_:n580c924076614d37b58500aec86f530eb5"}, {"@id": "_:n580c924076614d37b58500aec86f530eb6"}, {"@id": "_:n580c924076614d37b58500aec86f530eb7"}, {"@id": "_:n580c924076614d37b58500aec86f530eb8"}, {"@id": "_:n580c924076614d37b58500aec86f530eb9"}], "madsrdf:hasVariant": [{"@id": "_:n580c924076614d37b58500aec86f530eb10"}, {"@id": "_:n580c924076614d37b58500aec86f530eb13"}, {"@id": "_:n580c924076614d37b58500aec86f530eb16"}, {"@id": "_:n580c924076614d37b58500aec86f530eb19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems consisting of one or more four-line stanzas."}, {"@id": "_:n580c924076614d37b58500aec86f530eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:33:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n580c924076614d37b58500aec86f530eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n580c924076614d37b58500aec86f530eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quatrains"}}, {"@id": "_:n580c924076614d37b58500aec86f530eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "quatrain (A verse stanza of four lines, rhymed or (less often) unrhymed. The quatrain is the most commonly used stanza in English and most modern European languages.) rub\u00e1iy\u00e1t (A sequence or collection of Arabic or Persian quatrains. The term is most often associated with The Rub\u00e1iy\u00e1t of Omar Khayy\u00e1m (1859), a free English translation by Edward Fitzgerald of the 12th-century Persian poet's quatrains.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n580c924076614d37b58500aec86f530eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Quatrain. A stanza consisting of four lines--for example, the ballad stanza. The quatrain is the most common stanza form used in English-language poetry.)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n580c924076614d37b58500aec86f530eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rub\u0101\u02bf\u012b (pl. rub\u0101\u02bf\u012by\u0101t). A monorhyme quatrain originating in the Persian trad. and subsequently adapted into other Islamicate lits. The term rub\u0101\u02bf\u012b refers to the four hemistichs that comprise the quatrain; rub\u0101\u02bf\u012b quatrains; rub\u0101\u02bf\u012bs)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n580c924076614d37b58500aec86f530eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: The quatrains of \u02bbOmar Khayy\u0101m; Rubaiyat of Omar Khayyam; Rub\u00e1iy\u00e1t of Omar Khayy\u00e1m; The Ruba\u02bbiyat of \u02bbUmar Khayyam; Masterpieces of Urdu rubaiyat; A thousand years of Persian rub\u00e1iy\u00e1t; Rubaiyat and sonnets from a Persian garden; Mark Twain's Rub\u00e1iy\u00e1t; 101 rubaiyat; The new rubaiyat of Stanley Berne; Rubaiyyat of Omar Khayaam; The Rub\u00e1iyy\u00e1t of B\u00e1b\u00e1 T\u00e1hir Ory\u00e1n of Hamad\u00e1n)"}, "madsrdf:citationSource": "OCLC, Feb. 18, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n580c924076614d37b58500aec86f530eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Quatrain poems; quatrain poetry. A stanza or poem consisting of four lines. In the basic form, Lines 2 and 4 must rhyme while having a similar number of syllables.)"}, "madsrdf:citationSource": "PoetrySoup website, Oct. 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n580c924076614d37b58500aec86f530eb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n580c924076614d37b58500aec86f530eb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rub\u0101\u02bf\u012b quatrains"}}, {"@id": "_:n580c924076614d37b58500aec86f530eb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rub\u0101\u02bf\u012b quatrains"}}, {"@id": "_:n580c924076614d37b58500aec86f530eb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n580c924076614d37b58500aec86f530eb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rubaiyyat"}}, {"@id": "_:n580c924076614d37b58500aec86f530eb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rubaiyyat"}}, {"@id": "_:n580c924076614d37b58500aec86f530eb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n580c924076614d37b58500aec86f530eb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rubaiyat"}}, {"@id": "_:n580c924076614d37b58500aec86f530eb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rubaiyat"}}, {"@id": "_:n580c924076614d37b58500aec86f530eb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n580c924076614d37b58500aec86f530eb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rub\u0101\u02bf\u012bs"}}, {"@id": "_:n580c924076614d37b58500aec86f530eb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rub\u0101\u02bf\u012bs"}}], "@id": "/authorities/genreForms/gf2014026497"}
