{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026800", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aArmillary spheres", "identifiers:lccn": "gf2011026800", "madsrdf:adminMetadata": [{"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb1"}, {"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Armillary spheres"}, "madsrdf:elementList": {"@list": [{"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026117"}, "madsrdf:hasSource": [{"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb5"}, {"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb6"}, {"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-01-03T08:19:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-10-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Armillary spheres"}}, {"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Armillary spheres)"}, "madsrdf:citationSource": "LCSH, Dec. 1, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Glossary of the mapping sciences, 1994", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n92a8c2b3e4314e71928341a3ef37585eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(armillary sphere: armillary sphere (variations are known as spherical astrolabe, armilla, or armil) is a model of the celestial sphere; invented by Eratosthenes; usually a ball representing the Earth or, later, the Sun is placed in its center. It is used to demonstrate the motion of the stars around the Earth. Before the advent of the European telescope in the 17th century, the armillary sphere was the prime instrument of all astronomers in determining celestial positions)"}, "madsrdf:citationSource": "Wikipedia, Dec. 1, 2009", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026800"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026802", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRadio actualities", "identifiers:lccn": "gf2011026802", "madsrdf:adminMetadata": [{"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b1"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Radio actualities"}, "madsrdf:elementList": {"@list": [{"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026424"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026097"}], "madsrdf:hasSource": [{"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b5"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b6"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b7"}], "madsrdf:hasVariant": [{"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b8"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b11"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b14"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b17"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Here are entered brief audio clips consisting of quotations from speeches or interviews that are intended for use on radio news broadcasts."}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-08T13:49:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-10-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio actualities"}}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Soundbite: A snippet of audio culled from an interview and used in conjunction with a news story; UF Actuality)"}, "madsrdf:citationSource": "About.com: Radio WWW site, Apr. 24, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 207 (Actuality: A short piece of spoken audio from a newsmaker; news departments use this term most often)"}, "madsrdf:citationSource": "Kaempfer, R. The radio producer's handbook, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 100 (Actualities: The voices of the newsmakers are called actualities or sound bites; they are the heart of radio news)"}, "madsrdf:citationSource": "White, T. Broadcast news, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sound bites, Radio"}}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sound bites, Radio"}}, {"@id": "_:n730e83cfe3bd4ae98b8cda88dea11138b11", "@type": ["madsrdf:GenreForm", "madsrd