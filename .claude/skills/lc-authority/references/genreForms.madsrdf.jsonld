7a9718092e5f55fe8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Intabulation)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:nd60b3b083a6444a7a9718092e5f55fe8b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Johnson, C. Vocal compositions in German organ tablature, 1550-1650, 1989.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd60b3b083a6444a7a9718092e5f55fe8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Intabulation. An arrangement of a vocal or instrumental ensemble work for keyboard or plucked string instrument, notated in tablature.)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027204"}
