{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026545", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRomantic comedy films", "identifiers:lccn": "gf2011026545", "madsrdf:adminMetadata": [{"@id": "_:nbcd40063aaee488a9eba0862d06313bbb1"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Romantic comedy films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbcd40063aaee488a9eba0862d06313bbb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026147"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026543"}], "madsrdf:hasSource": [{"@id": "_:nbcd40063aaee488a9eba0862d06313bbb5"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb6"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb7"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb8"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb9"}], "madsrdf:hasVariant": [{"@id": "_:nbcd40063aaee488a9eba0862d06313bbb10"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025352"}}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:23:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romantic comedy films"}}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Romantic comedy. A film dealing with the relationship of a man and woman, who, after many trials and tribulations caused by their own misunderstandings, a number of obstacle figures, or both, are finally united at the end of the film. A slight variation on this theme is the couple who start off united, are temporarily separated, but are reunited at the end of the film. In both cases, it is crucial that the attraction between the two is evident and that their trials and tribulations be treated in a comic manner. Romantic comedy has sometimes been thought of as synonymous with screwball comedy, but the second classification refers to a group of films too specific to be so all-inclusive. A number of romantic comedies have heroines less aggressive or actions less madcap so that they are distinguishable from the screwball variety)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dictionary, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Romantic comedy. This is a blanket term that includes any comic film in which the protagonists, a man and a woman, engage in courtship, amorous dalliance and sexual games meant to seduce and entrap the member of the opposite sex. Romantic comedies are constructed around the ups and downs of a couple's relationship--the initial antagonism, the misunderstandings, the bouts of jealousy, the conflicts of interest, until all is well at the end of the film. The following types of comedy also qualify as romantic comedy: Marriage comedy, Screwball comedy, Sophisticated comedy)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(romantic comedy. A general term for comedies that deal mainly with the follies and misunderstandings of young lovers, in a lighthearted and happily concluded manner which usually avoids serious satire. The romantic comedy has become a recognized genre of popular film, in which context it is now sometimes abbreviated as romcom.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Romantic comedy films)"}, "madsrdf:citationSource": "LCSH, April 27, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Romantic comedy film. Romantic comedy films are films with light-hearted, humorous plotlines, centered on romantic ideals such as that true love is able to surmount most obstacles. The basic plot of a romantic comedy is that two characters, usually a man and a woman, meet, part ways due to an argument or other obstacle, then ultimately reunite. Romantic comedy films are a certain genre of comedy films as well as of romance films, and may also have elements of screwball comedies and stoner comedies. Some television series can also be classified as romantic comedies)"}, "madsrdf:citationSource": "Wikipedia, July 23, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbcd40063aaee488a9eba0862d06313bbb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romantic comedies (Motion pictures)"}}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romantic comedies (Motion pictures)"}}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbcd40063aaee488a9eba0862d06313bbb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romcoms (Motion pictures)"}}, {"@id": "_:nbcd40063aaee488a9eba0862d06313bbb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romcoms (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2011026545"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026546", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRomantic comedy television programs", "identifiers:lccn": "gf2011026546", "madsrdf:adminMetadata": [{"@id": "_:n542605181cdd4c029ae99fbea1957a77b1"}, {"@id": "_:n542605181cdd4c029ae99fbea1957a77b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Romantic comedy television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n542605181cdd4c029ae99fbea1957a77b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026544"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026654"}], "madsrdf:hasSource": [{"@id": "_:n542605181cdd4c029ae99fbea1957a77b5"}, {"@id": "_:n542605181cdd4c029ae99fbea1957a77b6"}], "madsrdf:hasVariant": {"@id": "_:n542605181cdd4c029ae99fbea1957a77b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025353"}}, {"@id": "_:n542605181cdd4c029ae99fbea1957a77b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:24:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n542605181cdd4c029ae99fbea1957a77b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n542605181cdd4c029ae99fbea1957a77b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romantic comedy television programs"}}, {"@id": "_:n542605181cdd4c029ae99fbea1957a77b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Romance: use Comedies, Drama, Melodrama)"}, "madsrdf:citationSource": "Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n542605181cdd4c029ae99fbea1957a77b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Romance: for romantic comedy, use Screwball comedy, or Romance in conjunction with Comedy)"}, "madsrdf:citationSource": "Moving image genre/form guide via WWW, Oct. 31, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n542605181cdd4c029ae99fbea1957a77b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n542605181cdd4c029ae99fbea1957a77b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romantic comedies (Television programs)"}}, {"@id": "_:n542605181cdd4c029ae99fbea1957a77b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romantic comedies (Television programs)"}}], "@id": "/authorities/genreForms/gf2011026546"}
