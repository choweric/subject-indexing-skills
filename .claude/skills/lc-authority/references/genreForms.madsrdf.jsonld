{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026922", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMarches (Music)", "identifiers:lccn": "gf2014026922", "madsrdf:adminMetadata": [{"@id": "_:nd00b5495da504846a459d4d104b12edfb1"}, {"@id": "_:nd00b5495da504846a459d4d104b12edfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Marches (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd00b5495da504846a459d4d104b12edfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027027"}, "madsrdf:hasSource": [{"@id": "_:nd00b5495da504846a459d4d104b12edfb5"}, {"@id": "_:nd00b5495da504846a459d4d104b12edfb6"}, {"@id": "_:nd00b5495da504846a459d4d104b12edfb7"}], "madsrdf:hasVariant": {"@id": "_:nd00b5495da504846a459d4d104b12edfb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd00b5495da504846a459d4d104b12edfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd00b5495da504846a459d4d104b12edfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-08-17T13:55:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nd00b5495da504846a459d4d104b12edfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Marches (Music)"}}, {"@id": "_:nd00b5495da504846a459d4d104b12edfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a basic walking step and the generic term for a variety of music that could be used to accompany this step in parades and in dance ... quickstep, a march genre)"}, "madsrdf:citationSource": "New Grove dict. of Am. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd00b5495da504846a459d4d104b12edfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (military marches nos. 1-5, op. 39)"}, "madsrdf:citationSource": "Elgar, Edward. Pomp and circumstance, 1977:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd00b5495da504846a459d4d104b12edfb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Beethoven, Ludwig van. Two military marches, \u00a91986.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd00b5495da504846a459d4d104b12edfb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd00b5495da504846a459d4d104b12edfb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Military marches (Music)"}}, {"@id": "_:nd00b5495da504846a459d4d104b12edfb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Military marches (Music)"}}], "@id": "/authorities/genreForms/gf2014026922"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026923", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMariachi (Music)", "identifiers:lccn": "gf2014026923", "madsrdf:adminMetadata": [{"@id": "_:n2b091a8a609840a1b309b78b4c657650b1"}, {"@id": "_:n2b091a8a609840a1b309b78b4c657650b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mariachi (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2b091a8a609840a1b309b78b4c657650b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": {"@id": "_:n2b091a8a609840a1b309b78b4c657650b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2b091a8a609840a1b309b78b4c657650b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2b091a8a609840a1b309b78b4c657650b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2b091a8a609840a1b309b78b4c657650b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mariachi (Music)"}}, {"@id": "_:n2b091a8a609840a1b309b78b4c657650b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Musical tradition originating in western Mexico. Mariachi refers to a rural music and dance tradition from Mexico's western region and is identified specifically with the states of Jalisco, Colima, and Michoac\u00e1n; however as a regional cultural practice, mariachi is also linked to the surrounding states of Aguascalientes, Guanajuato, Guerrero, Nayarit, and Zacatecas. The mariachi ensemble typically consists of trumpet, violin, vihuela, guitar, and guitarr\u00f3n. Musicians wear the traje de charro, or suit of the Mexican cowboy, a style of dress associated with the rural western region. The hallmark of the mariachi repertory is the regional son. While a number of music and dance genres (some with indigenous implications such as the jarabe), were part of pre-20th-century local repertories, the son jalisciense defined the tradition's regional identity.)"}, "madsrdf:citationSource": "Grove music online, viewed August 10, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026923"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026924", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMarineras (Music)", "identifiers:lccn": "gf2014026924", "madsrdf:adminMetadata": [{"@id": "_:n710480e0435345b095d2e8a24ec9bdd2b1"}, {"@id": "_:n710480e0435345b095d2e8a24ec9bdd2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Marineras (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n710480e0435345b095d2e8a24ec9bdd2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n710480e0435345b095d2e8a24ec9bdd2b5"}, {"@id": "_:n710480e0435345b095d2e8a24ec9bdd2b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n710480e0435345b095d2e8a24ec9bdd2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n710480e0435345b095d2e8a24ec9bdd2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n710480e0435345b095d2e8a24ec9bdd2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Marineras (Music)"}}, {"@id": "_:n710480e0435345b095d2e8a24ec9bdd2b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 95-704245: Morales, R.M.A. Palmero sube a la palma : marinera, 1941.", "madsrdf:citationStatus": "found"}, {"@id": "_:n710480e0435345b095d2e8a24ec9bdd2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "s.v. Peru (the marinera, originally a cueca which was renamed during the Pacific war (1880) to distinguish it from the Chilean national dance of the same name, has since developed some new musical characteristics) s.v. Marinera (a social recreational dance (and its music))"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026924"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026925", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMashups (Music)", "identifiers:lccn": "gf2014026925", "madsrdf:adminMetadata": [{"@id": "_:n7594b9161e5345418727a99f6fe165c5b1"}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mashups (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7594b9161e5345418727a99f6fe165c5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027046"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026932"}, "madsrdf:hasSource": [{"@id": "_:n7594b9161e5345418727a99f6fe165c5b5"}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b6"}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b7"}], "madsrdf:hasVariant": [{"@id": "_:n7594b9161e5345418727a99f6fe165c5b8"}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mashups (Music)"}}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mashup, or bastard pop, is a musical genre which, in its purest form, consists of the combination (usually by digital means) of the music from one song with the a cappella from another. Typically, the music and vocals belong to completely different genres)"}, "madsrdf:citationSource": "Wikipedia, Nov, 28, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Beatles. Love, p2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beatles \"Love\"; mash-up)"}, "madsrdf:citationSource": "Chicago sun-times, Nov. 21, 2006 [viewed online]", "madsrdf:citationStatus": "found"}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7594b9161e5345418727a99f6fe165c5b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mash-ups (Music)"}}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mash-ups (Music)"}}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7594b9161e5345418727a99f6fe165c5b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bastard pop (Music)"}}, {"@id": "_:n7594b9161e5345418727a99f6fe165c5b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bastard pop (Music)"}}], "@id": "/authorities/genreForms/gf2014026925"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026926", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMasses", "identifiers:lccn": "gf2014026926", "madsrdf:adminMetadata": [{"@id": "_:na224d8cc0150488889275d9180459b01b1"}, {"@id": "_:na224d8cc0150488889275d9180459b01b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Masses"}, "madsrdf:elementList": {"@list": [{"@id": "_:na224d8cc0150488889275d9180459b01b3"}]}, "madsrdf:exampleNote": "Note under [Propers (Music); Organ masses]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027048"}, "madsrdf:hasReciprocalAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026941"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026077"}], "madsrdf:hasSource": {"@id": "_:na224d8cc0150488889275d9180459b01b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical settings of the Mass in its entirety or for the Mass ordinary. For chants of the Mass propers see [Propers (Music).] For collections of versets for the organ that replace parts of the Ordinary and Proper of the Mass and are played in alternations with the other portions see [Organ masses.]"}, {"@id": "_:na224d8cc0150488889275d9180459b01b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na224d8cc0150488889275d9180459b01b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:45:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na224d8cc0150488889275d9180459b01b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Masses"}}, {"@id": "_:na224d8cc0150488889275d9180459b01b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The term most commonly used to describe the early Christian and medieval Latin eucharistic service. It has been retained within Catholicism during modern times. The plainchant of the medieval Mass, and the polyphonic music of the Mass between the 12th and 16th centuries, are central to the history of Western music. The polyphonic Mass Ordinary of the Renaissance is one of the more important genres of European art music.)"}, "madsrdf:citationSource": "Grove music online, viewed August 10, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026926"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026927", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMath rock (Music)", "identifiers:lccn": "gf2014026927", "madsrdf:adminMetadata": [{"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b1"}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Math rock (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027018"}, "madsrdf:hasSource": [{"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b5"}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b6"}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b7"}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b8"}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Math rock (Music)"}}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 127 (Math rock is a rhythmically complex, guitar-based style of experimental rock that emerged in the late 1980s. It is characterized by complex, atypical rhythmic structures (including irregular stopping and starting), angular melodies, and dissonant chords)"}, "madsrdf:citationSource": "Alternative rock: the complete guide [via GoogleBooks, Sep. 6, 2011]:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(math rock)"}, "madsrdf:citationSource": "RILM via EBSCO, Sept. 6, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "table of contents (How alternative turned progressive : the strange case of math rock)"}, "madsrdf:citationSource": "Progressive rock reconsidered, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Oxford Music online.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n2c6f328b028f4eefada5c46e3d14b9d2b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Progressive rock reconsidered, 2002", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026927"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026928", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMazurkas (Music)", "identifiers:lccn": "gf2014026928", "madsrdf:adminMetadata": [{"@id": "_:n0ebbf3dbe2c94270a67ad0ac13942958b1"}, {"@id": "_:n0ebbf3dbe2c94270a67ad0ac13942958b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mazurkas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0ebbf3dbe2c94270a67ad0ac13942958b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027003"}, "madsrdf:hasSource": {"@id": "_:n0ebbf3dbe2c94270a67ad0ac13942958b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0ebbf3dbe2c94270a67ad0ac13942958b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0ebbf3dbe2c94270a67ad0ac13942958b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0ebbf3dbe2c94270a67ad0ac13942958b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mazurkas (Music)"}}, {"@id": "_:n0ebbf3dbe2c94270a67ad0ac13942958b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a Polish folk dance, in triple time, from the province of Mazovia near Warsaw. Mazurkas in art music, such as those of Chopin, exhibit strong differences in tempo and expressive character)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026928"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026929", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMbalax", "identifiers:lccn": "gf2014026929", "madsrdf:adminMetadata": [{"@id": "_:n76a063297ed54585a087e045033f7922b1"}, {"@id": "_:n76a063297ed54585a087e045033f7922b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mbalax"}, "madsrdf:elementList": {"@list": [{"@id": "_:n76a063297ed54585a087e045033f7922b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n76a063297ed54585a087e045033f7922b5"}, {"@id": "_:n76a063297ed54585a087e045033f7922b6"}, {"@id": "_:n76a063297ed54585a087e045033f7922b7"}, {"@id": "_:n76a063297ed54585a087e045033f7922b8"}], "madsrdf:hasVariant": {"@id": "_:n76a063297ed54585a087e045033f7922b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n76a063297ed54585a087e045033f7922b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n76a063297ed54585a087e045033f7922b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n76a063297ed54585a087e045033f7922b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mbalax"}}, {"@id": "_:n76a063297ed54585a087e045033f7922b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (zur Entstehung einer senegalesischen Popularmusik)"}, "madsrdf:citationSource": "Work cat.: 2010516047: Brunner, A. Die Anf\u00e4nge des Mbalax, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n76a063297ed54585a087e045033f7922b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mbalax. A Wolof music of Senegal; rooted in the rhythms played by medium-sized closed sabar drums and bugarabu drums, punctuated by the proverbs and phrases produced by the tama (a small, double-headed, hourglass talking drum))"}, "madsrdf:citationSource": "New Grove online, July 22, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n76a063297ed54585a087e045033f7922b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mbalax; popular music style; Senegal and Gambia; fusion of traditional griot and modern Western music)"}, "madsrdf:citationSource": "African Music Safari WWW site, July 22, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n76a063297ed54585a087e045033f7922b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mbalax (Mbalakh); national popular dance music of Senegal and The Gambia. Mbalax is a fusion of popular Western music and dance such as jazz, soul, Latin, and rock blended with sabar, the traditional drumming and dance music of Senegal)"}, "madsrdf:citationSource": "Wikipedia, July 22, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n76a063297ed54585a087e045033f7922b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n76a063297ed54585a087e045033f7922b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mbalakh"}}, {"@id": "_:n76a063297ed54585a087e045033f7922b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mbalakh"}}], "@id": "/authorities/genreForms/gf2014026929"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026930", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMbaqanga", "identifiers:lccn": "gf2014026930", "madsrdf:adminMetadata": [{"@id": "_:n9dd24eae980d4829b0909b256e72aea6b1"}, {"@id": "_:n9dd24eae980d4829b0909b256e72aea6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mbaqanga"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9dd24eae980d4829b0909b256e72aea6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n9dd24eae980d4829b0909b256e72aea6b5"}, {"@id": "_:n9dd24eae980d4829b0909b256e72aea6b6"}], "madsrdf:hasVariant": {"@id": "_:n9dd24eae980d4829b0909b256e72aea6b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9dd24eae980d4829b0909b256e72aea6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n9dd24eae980d4829b0909b256e72aea6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9dd24eae980d4829b0909b256e72aea6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mbaqanga"}}, {"@id": "_:n9dd24eae980d4829b0909b256e72aea6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "accompanying booklet ( \"The [Soul] Brothers epitomize the best in township jive (also known as mbaqanga), the 'poor man's soup' blended from readily available ingredients, both local and imported\")"}, "madsrdf:citationSource": "Work cat.: Soul Brothers. The rough guide to the Soul Brothers [SR] p2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9dd24eae980d4829b0909b256e72aea6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "AMG All Music Guide: Mbaqanga (Mbaqanga was one of South Africa's most popular native musical styles, originating in the black townships in the late '50s and early '60s. At first, mbaqanga was an instrumental music, an urban outgrowth of the pennywhistle jive music (or kwela) that groups of black street musicians had imported from rural areas ... As mbaqanga developed, electric bass was added to the rhythm section, and the percussion accompaniment became correspondingly more powerful and danceable in order to keep pace. Electric guitars completed the transition to fully non-acoustic instrumentation in the early '60s, and soon afterwards, vocals began to appear on mbaqanga records ... vocal mbaqanga (dubbed \"mqashiyo\") relied on female vocalists to handle the intricate harmonies, and a growling deep-voiced \"groaner\", as the male vocalist came to be known, who provided a sharply contrasting sound. This formula persevered into the '70s ... most new mbaqanga bands featured only male vocalists ... However, imported American soul and disco records were capturing the younger audiences by this time, and had it not been for the international discovery of mbaqanga in 1986 thanks to records like The indestructible beat of Soweto ... most of the music's audiences would have disappeared)"}, "madsrdf:citationSource": "Online, March. 18, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9dd24eae980d4829b0909b256e72aea6b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9dd24eae980d4829b0909b256e72aea6b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Township jive music"}}, {"@id": "_:n9dd24eae980d4829b0909b256e72aea6b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Township jive music"}}], "@id": "/authorities/genreForms/gf2014026930"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026931", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMchiriku", "identifiers:lccn": "gf2014026931", "madsrdf:adminMetadata": [{"@id": "_:n2dfe1dfc16c54d88a24719bc28841922b1"}, {"@id": "_:n2dfe1dfc16c54d88a24719bc28841922b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mchiriku"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2dfe1dfc16c54d88a24719bc28841922b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n2dfe1dfc16c54d88a24719bc28841922b5"}, {"@id": "_:n2dfe1dfc16c54d88a24719bc28841922b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2dfe1dfc16c54d88a24719bc28841922b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2dfe1dfc16c54d88a24719bc28841922b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2dfe1dfc16c54d88a24719bc28841922b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mchiriku"}}, {"@id": "_:n2dfe1dfc16c54d88a24719bc28841922b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "documentation (mchiriku)"}, "madsrdf:citationSource": "Work cat.: Perullo, A. I. Tanzania, Dar es Salaam, 2000-2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2dfe1dfc16c54d88a24719bc28841922b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mchiriku; A revival of an earlier musical style found along the East African coast of Tanzania and Kenya; Mchiriku developed in the 1970s and was quickly banned due to obscene lyrics and the erotic nature of the accompanying dance. It is now performed primarily by youths in the Mombasa (Kenya) and Tanga (Tanzania) regions. Mchiriku ensembles typically comprise a tambourine, local drums and electronic keyboard)"}, "madsrdf:citationSource": "Grovemusic WWW site, Oct. 5, 2004", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026931"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026932", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMedleys (Music)", "identifiers:lccn": "gf2014026932", "madsrdf:adminMetadata": [{"@id": "_:n8d75852af397494098c0359cc94b5e9fb1"}, {"@id": "_:n8d75852af397494098c0359cc94b5e9fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Medleys (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8d75852af397494098c0359cc94b5e9fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026925"}, "madsrdf:hasSource": {"@id": "_:n8d75852af397494098c0359cc94b5e9fb5"}, "madsrdf:hasVariant": {"@id": "_:n8d75852af397494098c0359cc94b5e9fb6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8d75852af397494098c0359cc94b5e9fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8d75852af397494098c0359cc94b5e9fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8d75852af397494098c0359cc94b5e9fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Medleys (Music)"}}, {"@id": "_:n8d75852af397494098c0359cc94b5e9fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Medley (An English term for a succession of well-known tunes strung together, generally without any formal construction... A medley is similar to a potpourri, though generally of a smoother construction. The constituent tunes are very often from a similar source, as for example 'a medley of tunes from X' or 'a medley of songs by Y') under Potpourri (From its original application to a jar, literally a 'rotten pot', in which were kept miscellaneous spices, vegetables and so on, the term came to be applied to a musical composition which was a similar hotch potch of tunes from a pre-existing source or sources. During the 18th century the term was used in France for collections of songs which, with a thematic link, were sometimes given stage presentation. Later the term was used for instrumental collections, such as the Potpourry fran\u00e7ais, which was a collection of originally unconnected dance pieces issued by the publisher Bou\u00efn. Still in the 18th century, the term was used by the publisher Breitkopf for a collection of new compositions by various composers, and around the end of the century it came to be applied to a string of melodies from an opera or operas)"}, "madsrdf:citationSource": "Grove music online, viewed July 18, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d75852af397494098c0359cc94b5e9fb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d75852af397494098c0359cc94b5e9fb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Potpourris (Music)"}}, {"@id": "_:n8d75852af397494098c0359cc94b5e9fb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Potpourris (Music)"}}], "@id": "/authorities/genreForms/gf2014026932"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026933", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMerengues (Music)", "identifiers:lccn": "gf2014026933", "madsrdf:adminMetadata": [{"@id": "_:n6ef577d9cd2445c8b9bc0dcc89380d74b1"}, {"@id": "_:n6ef577d9cd2445c8b9bc0dcc89380d74b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Merengues (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6ef577d9cd2445c8b9bc0dcc89380d74b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:n6ef577d9cd2445c8b9bc0dcc89380d74b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6ef577d9cd2445c8b9bc0dcc89380d74b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6ef577d9cd2445c8b9bc0dcc89380d74b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6ef577d9cd2445c8b9bc0dcc89380d74b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Merengues (Music)"}}, {"@id": "_:n6ef577d9cd2445c8b9bc0dcc89380d74b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A folk and popular dance-music genre of the Dominican Republic. In rapid 2/4 meter, it typically alternates sections of stanza and refrain with responsorial singing of short phrases common in both sections.)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026933"}
