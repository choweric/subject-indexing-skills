{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027055", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRockabilly music", "identifiers:lccn": "gf2014027055", "madsrdf:adminMetadata": [{"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb1"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rockabilly music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026665"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026739"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026171"}, "madsrdf:hasSource": [{"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb5"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb6"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb7"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb8"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb9"}], "madsrdf:hasVariant": {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rockabilly music"}}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The earliest recognized style of rock and roll by white performers. Its practitioners were white southerners in the USA who had been attracted to and learned from the music of African-Americans; they called it country rock, but music industry figures and fans dubbed it rockabilly as a different way of signifying the merger of blues and hillbilly styles.)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Mar. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The earliest style of white rock-and-roll, which blended blues with country music; the term is a combination of \"rock\" and \"hillbilly.\" Rockabilly was created in the early 1950s in Sam Phillips's Sun Records studio in Memphis; it was characterized by an exuberant, twanging electric lead guitar, a rollicking, slapping string bass line, a percussively strummed acoustic rhythm guitar, punctuating drums, and a vocal style marked by insinuating yelps, hiccups, stuttering, and teasing inflections.)"}, "madsrdf:citationSource": "New Grove dict. of Amer. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Rock-a-billy from Tennessee [SR] 1982.", "madsrdf:citationStatus": "found"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rockabilly)"}, "madsrdf:citationSource": "9000 words", "madsrdf:citationStatus": "found"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rockabilly)"}, "madsrdf:citationSource": "Hennepin", "madsrdf:citationStatus": "found"}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock-a-billy music"}}, {"@id": "_:n89d9e98eccb5426eafa365eb9deef90eb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock-a-billy music"}}], "@id": "/authorities/genreForms/gf2014027055"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027056", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRocksteady (Music)", "identifiers:lccn": "gf2014027056", "madsrdf:adminMetadata": [{"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b1"}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rocksteady (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b5"}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b6"}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b7"}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b8"}], "madsrdf:hasVariant": {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-19T16:44:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rocksteady (Music)"}}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rocksteady; grew out of ska, spanning the period ca. 1966-68)"}, "madsrdf:citationSource": "Encyc. pop. mus., 1996", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Rocksteady was a style of popular music that developed out of ska in the 1960s. In its simplest terms, rocksteady is half-speed ska with the trombone replaced by piano and prominent bass. The lyrics are more socially and politically conscious, and there is a greater focus on harmonies, particularly in trios like the Heptones, Gaylads, Dominoes, Aces, and Wailers. Other major figures include Alton Ellis and Ken Boothe. With its relaxed beat and social-protest lyrics, the music served as a forerunner to reggae.\")"}, "madsrdf:citationSource": "All music guide WWW site, Apr. 22, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Rocksteady is a music genre that originated in Jamaica around 1962. A successor to ska and a precursor to reggae, rocksteady was performed by Jamaican vocal harmony groups such as The Gaylads, The Maytals and The Paragons. The term rocksteady comes from a dance style that was mentioned in the Alton Ellis song \"Rock Steady\". Dances performed to rocksteady were less energetic than the earlier ska dances.\")"}, "madsrdf:citationSource": "Wikipedia, Apr. 22, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Trojan rocksteady box set.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock steady (Music)"}}, {"@id": "_:nc4a557bd1e19452b8215b4ad9df3cf52b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock steady (Music)"}}], "@id": "/authorities/genreForms/gf2014027056"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027057", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRondos", "identifiers:lccn": "gf2014027057", "madsrdf:adminMetadata": [{"@id": "_:na175fd3bd60347e9bc50ef07405fddbfb1"}, {"@id": "_:na175fd3bd60347e9bc50ef07405fddbfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rondos"}, "madsrdf:elementList": {"@list": [{"@id": "_:na175fd3bd60347e9bc50ef07405fddbfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": {"@id": "_:na175fd3bd60347e9bc50ef07405fddbfb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na175fd3bd60347e9bc50ef07405fddbfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na175fd3bd60347e9bc50ef07405fddbfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na175fd3bd60347e9bc50ef07405fddbfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rondos"}}, {"@id": "_:na175fd3bd60347e9bc50ef07405fddbfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rondo. (1). A multisectional form, movement, or composition based on the principle of multiple recurrence of a them or section in the tonic key)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027057"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027058", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRounds (Music)", "identifiers:lccn": "gf2014027058", "madsrdf:adminMetadata": [{"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db1"}, {"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rounds (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026687"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026984"}], "madsrdf:hasSource": [{"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db5"}, {"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db6"}], "madsrdf:hasVariant": {"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Songs in which two or more voices sing exactly the same melody beginning at different times."}, {"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:57:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rounds (Music)"}}, {"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Round (Short unacc. vocal \"perpetual canon\" at the unison or octave in which the vv. enter in turn) Catch (A type of round; term is now often used in a less general sense which confines its application to such rounds as, in the singing, afford a laugh by the way the words are heard)"}, "madsrdf:citationSource": "Oxford dictionary of music online, viewed July 8, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Round (A generic term for a song consisting of a single-line melody constructed so that it forms its own harmony when sung as a canon at the unison) Catch (A type of comic round for male voices, popular in England from the late 16th century until about 1800)"}, "madsrdf:citationSource": "Grove music online, viewed July 8, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Catches (Music)"}}, {"@id": "_:n2620e7ba7141434a862c7b8ca7eabd7db8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Catches (Music)"}}], "@id": "/authorities/genreForms/gf2014027058"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027059", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRumbas (Music)", "identifiers:lccn": "gf2014027059", "madsrdf:adminMetadata": [{"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab1"}, {"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rumbas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026845"}, "madsrdf:hasSource": [{"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab5"}, {"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab6"}], "madsrdf:hasVariant": {"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rumbas (Music)"}}, {"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rumba. An Afro-Cuban recreational event, dance, and accompanying music. The rumba, of which there are several named subtypes (e.g., guguanc\u00f3...), is secular but contains elements from African-derived sacred traditions.)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (the rhumba)"}, "madsrdf:citationSource": "Rumba de Cuba, 1948:", "madsrdf:citationStatus": "found"}, {"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rhumbas (Music)"}}, {"@id": "_:n89cd456ee1db45fd906d3a0c1ed61d1ab8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rhumbas (Music)"}}], "@id": "/authorities/genreForms/gf2014027059"}
