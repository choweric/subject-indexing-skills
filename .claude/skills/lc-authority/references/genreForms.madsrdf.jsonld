{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026054", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSafety regulations", "identifiers:lccn": "gf2022026054", "madsrdf:adminMetadata": [{"@id": "_:n0dd209d3808342c687ac40c29c0e78deb1"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Safety regulations"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0dd209d3808342c687ac40c29c0e78deb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026030"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026074"}], "madsrdf:hasSource": [{"@id": "_:n0dd209d3808342c687ac40c29c0e78deb5"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb6"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb7"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb8"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb9"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb10"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb11"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb12"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb13"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb14"}], "madsrdf:hasVariant": [{"@id": "_:n0dd209d3808342c687ac40c29c0e78deb15"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb18"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb21"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb24"}], "madsrdf:historyNote": "[Established November 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Safety regulations"}}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A standard (or regulation) is a regulatory requirement established and published by the agency to serve as criteria for measuring whether employers are in compliance with the OSH Act laws. OSHA standards are published in Title 29 of the Code of Federal Regulations (CFR) and are divided into separate standards for General Industry, Construction, and Maritime)"}, "madsrdf:citationSource": "What is a standard/regulation?, via U.S. Occupational Safety & Health Administration website, Aug. 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)71213050"}, "madsrdf:citationSource": "United States. Pipeline and Hazardous Materials Safety Administration. Pipeline safety regulations, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Safety regulations can be either prescriptive or non-prescriptive (goal-based). Prescriptive regulations are what most people think of when safety is discussed, and are often associated with traditional occupational safety standards such as the height of hand-rails or the use of PPE; Statutory safety regulations lay down the responsibilities of employers and employees for safety in the work place)"}, "madsrdf:citationSource": "Safety regulation - an overview, via ScienceDirect website, Aug. 10, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)45092441"}, "madsrdf:citationSource": "United States. Interstate Commerce Commission. Motor carrier safety regulations : revision of 1952, revised to include amendments as of January 1, 1965, 1965.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(safety regulations: regulations or rules that are put in place to ensure a product, event, etc, is safe and not dangerous)"}, "madsrdf:citationSource": "Collins English dictionary online, Aug. 10, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(issued by the International Atomic Energy Agency; series: Safety standards series ; no. ST-1. Requirements) (OCoLC)36376487"}, "madsrdf:citationSource": "Work cat.: Regulations for the safe transport of radioactive material, 1996", "madsrdf:citationStatus": "found"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(issued by the Institution of Engineering and Technology and British Standards Institution) p. 5 (Electricity Safety, Quality and Continuity Regulations) p. 12 (safety rules) (OCoLC)761052906"}, "madsrdf:citationSource": "Requirements for electrical installations : IET wiring regulations, \u00a92011", "madsrdf:citationStatus": "found"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)6870769"}, "madsrdf:citationSource": "American National Standards Institute. National electrical safety code, 1973-", "madsrdf:citationStatus": "found"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)54523152"}, "madsrdf:citationSource": "National Fire Protection Association. Life safety code.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Safety regulations are defined as mandatory requirements that aim to prevent or reduce injury. They include laws and regulations, such as prohibiting the sale of fireworks, and mandatory standards, such as specifying that children's nightwear be fire resistant; Regulations can be prescriptive or performance based. In relation to a product, prescriptive regulations prescribe how the product must be constructed but performance-based regulations require that the product meet certain performance criteria (e.g., acceleration values on a crash test dummy))"}, "madsrdf:citationSource": "Encyclopedia.com, Aug. 10, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0dd209d3808342c687ac40c29c0e78deb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Safety standards"}}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Safety standards"}}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0dd209d3808342c687ac40c29c0e78deb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Safety codes"}}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Safety codes"}}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0dd209d3808342c687ac40c29c0e78deb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Regulations, Safety"}}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Regulations, Safety"}}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0dd209d3808342c687ac40c29c0e78deb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Codes, Safety"}}, {"@id": "_:n0dd209d3808342c687ac40c29c0e78deb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Codes, Safety"}}], "@id": "/authorities/genreForms/gf2022026054"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026055", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMixtapes", "identifiers:lccn": "gf2022026055", "madsrdf:adminMetadata": [{"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b1"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mixtapes"}, "madsrdf:elementList": {"@list": [{"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}], "madsrdf:hasSource": [{"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b5"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b6"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b7"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b8"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b9"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b10"}], "madsrdf:hasVariant": [{"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b11"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b14"}], "madsrdf:historyNote": "[Established March 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Sound recording compilations, regardless of medium, created by artists or music fans."}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-08T09:05:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mixtapes"}}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mixtape; a compilation of songs recorded (as onto a cassette tape or a CD) from various sources)"}, "madsrdf:citationSource": "Merriam-Webster WWW site, September 30, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Dirty South mix tape 2K4 : skrewed & chopped) (OCoLC)981125566"}, "madsrdf:citationSource": "Dirty South mixtape, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mixtape; a mixtape (mix-tape, mix tape, or mixed tape) is a compilation of music, typically from multiple sources, recorded onto a medium; with origins in the 1980s, the term normally describes a homemade compilation of music onto a cassette, tape, CD, or digital playlist; the songs are either ordered sequentially or made into a continuous programme by beatmatching the songs and creating seamless transitions at their beginnings and endings with fades or abrupt edits; in hip hop and R&B culture, a mixtape often describes a self-produced or independently released album issued free of charge to gain publicity or avoid possible copyright infringement, however, the term has been applied to a number of releases published for profit in the 2010s, and the line between a release billed as a mixtape and one referred to as a studio album or extended play has become increasingly blurred)"}, "madsrdf:citationSource": "Wikipedia, May 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Black ni mimi : mixtape) (OCoLC)816238078"}, "madsrdf:citationSource": "Work cat: Blackfella. Black ni mimi, 2000?:", "madsrdf:citationStatus": "found"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ecip introduction (Among the first to use the term mix tape were hip hop artists creating compilations of live performances for fans. Mix tape simultaneously appeared in the late-1970s referring to personally crafted compilations to be shared between individuals. Over time the single word mixtape predominated, but some individuals continue to use the other variations. Hip hop culture has used mixtape continually since the 1970s to refer to non-commercially created products, regardless of the medium on which the music is recorded [...] as time progressed people continued to use the term mixtape even if the final product appeared on a CD or digitally. By the late-1990s the term mixtape stuck, regardless of the recording medium) DLC(2021036011)"}, "madsrdf:citationSource": "Burns, J., Mixtape nostalgia, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1260698657"}, "madsrdf:citationSource": "DJ Screw. June 27th, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mix tapes"}}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mix tapes"}}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mixed tapes"}}, {"@id": "_:na47cfd19ffe6463b9609d4dea2e77045b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mixed tapes"}}], "@id": "/authorities/genreForms/gf2022026055"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026056", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aParanormal films", "identifiers:lccn": "gf2022026056", "madsrdf:adminMetadata": [{"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b1"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Paranormal films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026298"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026307"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026716"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026733"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026749"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026034"}], "madsrdf:hasSource": [{"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b5"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b6"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b7"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b8"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b9"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b10"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b11"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b12"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b13"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b14"}], "madsrdf:hasVariant": [{"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b15"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b18"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b21"}], "madsrdf:historyNote": "[Established November 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature human characters that are often involved in the occult, witchcraft, spiritualism, psychic phenomena, vodou, etc., interacting with supernatural beings."}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paranormal films"}}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "paranormal (not scientifically explainable : supernatural) supernatural (1. of or relating to an order of existence beyond the visible observable universe especially : of or relating to God or a god, demigod, spirit, or devil. 2 a: departing from what is usual or normal especially so as to appear to transcend the laws of nature. b: attributed to an invisible agent (such as a ghost or spirit)) occult (noun: matters regarded as involving the action or influence of supernatural or supernormal powers or some secret knowledge of them --used with \"the\"; adjective, 4. of or relating to the occult)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Aug. 11, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Paranormal films (The paranormal and the fear of the unknown is naturally a classic topic of horror. Gathering everything from ghost to demons and even witches, it is usually the part of horror cinema that gets the scariest; includes The Conjuring (2013))"}, "madsrdf:citationSource": "Horror film Wiki, Aug. 11, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Paranormal films. Films about the paranormal, purported phenomena described in popular culture, folk, and other non-scientific bodies of knowledge, whose existence within these contexts is described as beyond normal experience or scientific explanation; paranormal phenomena include extrasensory perception (ESP), telekinesis, ghosts, poltergeists, life after death, reincarnation, faith healing, human auras, and so forth; Category:Supernatural films. Films about supernatural fiction, a genre of speculative fiction that exploits or is centered on supernatural themes, often contradicting naturalist assumptions of the real world. In its broadest definition, supernatural fiction overlaps with examples of weird fiction, horror fiction, vampire literature, ghost story, and fantasy)"}, "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a paranormal film; the story of ghost hunters Lorraine and Ed Warren who help a family terrorized by an evil spirit in their mysterious farmhouse) (OCoLC)861372702"}, "madsrdf:citationSource": "Work cat.: The conjuring, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Some good supernatural horror movies involve ghostly hauntings while other good supernatural horror movies are about demons and devils; 1. The Conjuring: In 1970, paranormal investigators and demonologists Lorraine and Ed Warren are summoned to the home of Carolyn and Roger Perron. The Perrons and their five daughters have recently moved into a secluded farmhouse, where a supernatural presence has made itself known. Though the manifestations are relatively benign at first, events soon escalate in horrifying fashion, especially after the Warrens discover the house's macabre history)"}, "madsrdf:citationSource": "The best supernatural horror movies, ranked, via Ranker website, updated May 12, 2022, viewed on Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(7. The Conjuring (2013). Paranormal investigators Ed and Lorraine Warren work to help a family terrorized by a dark presence in their farmhouse)"}, "madsrdf:citationSource": "Scariest paranormal films ever, via IMDb, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 26 (the supernaturalist films of our day, like The Sixth Sense)"}, "madsrdf:citationSource": "Caputo, John D. What would Jesus deconstruct?, \u00a92007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pt. 1 (Supernatural Films: These are films that have themes including gods or goddesses, ghosts, apparitions, spirits, miracles, and other similar ideas or depictions of extraordinary phenomena. They may be combined with other genres, including comedy, sci-fi, fantasy or horror. Interestingly however, until recently, supernatural films were usually presented in a comical, whimsical, or a romantic fashion, and were not designed to frighten the audience. There are also many hybrids that have combinations of fear, fantasy, horror, romance and comedy.)"}, "madsrdf:citationSource": "Supernatural films, via Filmsite website, Aug. 11, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(occult movies; occult films; movies about satanism, witchcraft, cults, and supernatural powers)"}, "madsrdf:citationSource": "The best movies about the occult, via Ranker website, updated July 31, 2020, viewed on Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Occult films"}}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Occult films"}}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supernaturalist films"}}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supernaturalist films"}}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supernatural films"}}, {"@id": "_:n5e10b037834c41e89a7f0cd08beebda8b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supernatural films"}}], "@id": "/authorities/genreForms/gf2022026056"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026057", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWitch television programs", "identifiers:lccn": "gf2022026057", "madsrdf:adminMetadata": [{"@id": "_:n696b982f6b974046bf721a3eebdb162cb1"}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Witch television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n696b982f6b974046bf721a3eebdb162cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026252"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026112"}], "madsrdf:hasSource": [{"@id": "_:n696b982f6b974046bf721a3eebdb162cb5"}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb6"}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb7"}], "madsrdf:hasVariant": [{"@id": "_:n696b982f6b974046bf721a3eebdb162cb8"}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb11"}], "madsrdf:historyNote": "[Established November 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that feature witches and/or warlocks and the practice of witchcraft."}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Witch television programs"}}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subject headings assigned include: Witches--Drama; Supernatural--Drama) (OCoLC)919177638"}, "madsrdf:citationSource": "Work cat.: Penny dreadful. The complete second season, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022: Penny Dreadful (TV series) (Penny Dreadful is a horror drama television series; In the second season, [Vanessa] Ives is hunted by a coven of witches led by the charismatic Evelyn Poole, wanting to bring Ives to Lucifer, who is their master)", "madsrdf:citationStatus": "found"}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Witchcraft in television. Depictions of witchcraft in television. Examples: The Addams Family (1964); Bewitched; Buffy the Vampire Slayer; Charmed; Dante's Cove; Paranormal Witness; Penny Dreadful; Sabrina the Teenage Witch (1970); Sabrina the Teenage Witch (1996); Tabitha; Tweeny Witches; The Vampire Diaries; WandaVision; The Witcher; Witches of East End)"}, "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n696b982f6b974046bf721a3eebdb162cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Warlock television programs"}}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Warlock television programs"}}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n696b982f6b974046bf721a3eebdb162cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Witchcraft television programs"}}, {"@id": "_:n696b982f6b974046bf721a3eebdb162cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Witchcraft television programs"}}], "@id": "/authorities/genreForms/gf2022026057"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026058", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPirate comics", "identifiers:lccn": "gf2022026058", "madsrdf:adminMetadata": [{"@id": "_:n25c238b596a24f419306f3950e35f4d3b1"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pirate comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n25c238b596a24f419306f3950e35f4d3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026216"}, "madsrdf:hasSource": [{"@id": "_:n25c238b596a24f419306f3950e35f4d3b5"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b6"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b7"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b8"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b9"}], "madsrdf:hasVariant": [{"@id": "_:n25c238b596a24f419306f3950e35f4d3b10"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b13"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b16"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b19"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b22"}], "madsrdf:historyNote": "[Established November 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that feature the adventures and exploits of pirates."}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pirate comics"}}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "bk. 1, t.p. (Captain Raven and the all-girl pirate crew) (OCoLC)938144645"}, "madsrdf:citationSource": "Whitley, Jeremy. Princeless. Raven, the pirate princess, 2016- :", "madsrdf:citationStatus": "found"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a choose-your-own-story comic; summary: Match your wits against a band of pirates on the high seas. You decide whether to try to defeat them or to join them) (OCoLC)77011594"}, "madsrdf:citationSource": "Work cat.: Fontes, Justine. Captured by pirates, \u00a92007", "madsrdf:citationStatus": "found"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Pirate comics. A list of comic strips, comic books and comic series about pirates and buccaneers. Examples: Asterix; Captain Kate; Captain Pugwash; Donald Duck Finds Pirate Gold; El Cazador; Long John Silver; Polly and the Pirates; Redbeard; Swords of the Swashbucklers; Le Vieux Nick et Barbe-Noire)"}, "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the superhero genre is a subgenre of the adventure genre and therefore sits alongside other subgenres like jungle and pirate comics; pirate comics are adventure comics primarily featuring pirates)"}, "madsrdf:citationSource": "Cowling, Sam. Philosophy of comics, 2022, via Google books, viewed Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Swashbuckler: Pirate Films. These films center on the exploits of pirates, variously called corsairs, free-booters, buccaneers or privateers.)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c238b596a24f419306f3950e35f4d3b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Corsair comics"}}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Corsair comics"}}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c238b596a24f419306f3950e35f4d3b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Free-booter comics"}}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Free-booter comics"}}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c238b596a24f419306f3950e35f4d3b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Freebooter comics"}}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Freebooter comics"}}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c238b596a24f419306f3950e35f4d3b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Privateer comics"}}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Privateer comics"}}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c238b596a24f419306f3950e35f4d3b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Buccaneer comics"}}, {"@id": "_:n25c238b596a24f419306f3950e35f4d3b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Buccaneer comics"}}], "@id": "/authorities/genreForms/gf2022026058"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026059", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPrank telephone calls", "identifiers:lccn": "gf2022026059", "madsrdf:adminMetadata": [{"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab1"}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Prank telephone calls"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026265"}, "madsrdf:hasSource": [{"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab5"}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab6"}], "madsrdf:hasVariant": [{"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab7"}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab10"}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab13"}], "madsrdf:historyNote": "[Established December 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-22T12:05:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prank telephone calls"}}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Prank call (A prank call (also known as a crank call) is a telephone call intended by the caller as a practical joke played on the person answering. It is often a type of nuisance call. Recordings of prank phone calls became a staple of the obscure and amusing cassette tapes traded among musicians, sound engineers, and media traders in the United States from the late 1970s)"}, "madsrdf:citationSource": "Wikipedia, viewed Aug. 17, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Phone jackin, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crank telephone calls"}}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crank telephone calls"}}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prank calls"}}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prank calls"}}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crank calls"}}, {"@id": "_:nd55d7a2d70794876adfe15dd57364a0ab14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crank calls"}}], "@id": "/authorities/genreForms/gf2022026059"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026060", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAudio interactive games", "identifiers:lccn": "gf2022026060", "madsrdf:adminMetadata": [{"@id": "_:na87f9bc9735041008713d6444e3b3f4db1"}, {"@id": "_:na87f9bc9735041008713d6444e3b3f4db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Audio interactive games"}, "madsrdf:elementList": {"@list": [{"@id": "_:na87f9bc9735041008713d6444e3b3f4db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}], "madsrdf:hasSource": [{"@id": "_:na87f9bc9735041008713d6444e3b3f4db5"}, {"@id": "_:na87f9bc9735041008713d6444e3b3f4db6"}], "madsrdf:hasVariant": {"@id": "_:na87f9bc9735041008713d6444e3b3f4db7"}, "madsrdf:historyNote": "[Established July 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na87f9bc9735041008713d6444e3b3f4db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na87f9bc9735041008713d6444e3b3f4db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T14:52:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na87f9bc9735041008713d6444e3b3f4db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Audio interactive games"}}, {"@id": "_:na87f9bc9735041008713d6444e3b3f4db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Track of the vampire) container (Track of the vampire; \"an audio CD interactive game.\" This recording is similar to how a choose-your-own adventure book instructs readers to navigate to different pages based on prompts in the text. The recording prompts listeners to choose tracks, resulting in a choose-your-own adventure type of interactive game)"}, "madsrdf:citationSource": "Work cat: Terror T.R.A.X., Track of the vampire, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:na87f9bc9735041008713d6444e3b3f4db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Audio games (An audio game is an electronic game played on a device such as a personal computer. It is similar to a video game save that there is audible and tactile feedback but not visual. Audio games originally started out as 'blind accessible'-games and were developed mostly by amateurs and blind programmers. But more and more people are showing interest in audio games, ranging from sound artists, game accessibility researchers, mobile game developers and mainstream video gamers. Most audio games run on a personal computer platform, although there are a few audio games for handhelds and video game consoles. Audio games feature the same variety of genres as video games, such as adventure games, racing games, etc.)"}, "madsrdf:citationSource": "Wikipedia, viewed August 17, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:na87f9bc9735041008713d6444e3b3f4db7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na87f9bc9735041008713d6444e3b3f4db8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Audio games"}}, {"@id": "_:na87f9bc9735041008713d6444e3b3f4db8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Audio games"}}], "@id": "/authorities/genreForms/gf2022026060"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026062", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSlice-of-life comics", "identifiers:lccn": "gf2022026062", "madsrdf:adminMetadata": [{"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b1"}, {"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Slice-of-life comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b5"}, {"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b6"}, {"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b7"}, {"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b8"}], "madsrdf:historyNote": "[Established December 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics centered on normal people and everyday life, sometimes told in vignette, abstract, or episodic format."}, {"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-22T12:05:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Slice-of-life comics"}}, {"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Failure collects Karl Stevens' beautifully rendered humorous comic strips from The Boston Phoenix, winner of the Association of Alternative Newsweeklies award for Best Cartoon. His slice of life vignettes and surreal anthropomorphic experiments are revealing sketches of urban America and beyond\") (OCoLC)829744619"}, "madsrdf:citationSource": "Stevens, K. Failure, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(So when I say \"slice of life,\" you might be wondering what that means in terms of genre. In slice-of-life fiction, the story focuses on a short episode in a character's life, usually incorporating mundane aspects of their daily routine as a way to discuss the character's interior world. It doesn't generally emphasize plot development or it at least always plays second fiddle to character development. Slice-of-life graphic novels have this way of always feeling cozy; even when characters are dealing with tough topics, those topics are human-sized and usually catalyze growth and resilience)"}, "madsrdf:citationSource": "Slice-of-life graphic novels for all ages, from Richmond Public Library, viewed Aug. 22, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Contemporary graphic novels show an interesting shift from the extraordinary to the ordinary in slice-of-life series in which nothing happens. Present-day graphic accounts are inhabited by melancholic characters whining about the lack of meaning in life. This book examines this intriguing transition and brings a historical, aesthetical and narratological approach to comics in which boredom is not only a topic, but also awakens a deliberate affective response in the very experience of reading) (OCoLC)936533437"}, "madsrdf:citationSource": "Schneider, G. What happens when nothing happens : boredom and everyday life in contemporary comics, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n90f4feb9b3bc43d0baf1db6e8e405735b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Madame means mischief in this series of slice-of-life vignettes that present the private love, laughter and frustrations of a pet who thinks she's an owner! Whether she's tearing up clothes, spilling ink on the carpet or filling the air with stinky tuna-breath, Madame is both wonderfully frustrating and endearingly whimsical) (OCoLC)1047781360"}, "madsrdf:citationSource": "Work cat.: Pe\u00f1a, N. Madame Cat, 2018", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2022026062"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026063", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aQueer fiction", "identifiers:lccn": "gf2022026063", "madsrdf:adminMetadata": [{"@id": "_:n6453b054c6e54fa0852302bdc527faedb1"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Queer fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6453b054c6e54fa0852302bdc527faedb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026122"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026001"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026027"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026053"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026002"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026001"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026071"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026073"}], "madsrdf:hasSource": [{"@id": "_:n6453b054c6e54fa0852302bdc527faedb5"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb6"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb7"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb8"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb9"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb10"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb11"}], "madsrdf:hasVariant": [{"@id": "_:n6453b054c6e54fa0852302bdc527faedb12"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb15"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb18"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb21"}], "madsrdf:historyNote": "[Established December 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction featuring queer characters or addressing queer themes."}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ic"}, "ri:recordStatus": "revised"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Queer fiction"}}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: The essays in Queer Universes investigate both contemporary and historical practices of constructing sexualities and genders in science fiction literature. While individual essays examine many different depictions of sexuality in sf and its relation to race, gender, class and species, all are informed by some aspect of queer theory and its critique of binary sexual definitions and of sexual normativity\" (OCoLC)182736124"}, "madsrdf:citationSource": "Queer universes : sexualities in science fiction, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: At age nineteen, the queer narrator of Green Glass Ghosts steps off a bus on Granville Street in downtown Vancouver, a city where the faceless condo towers of the wealthy loom over the streets of the east side where folks are just trying to get by, set against the deceptively beautiful backdrop of snow-capped mountains and sparkling ocean. Armed with only their guitar and their voice, our hopeful hero arrives on the West Coast fleeing a traumatic childhood. They're eager to build a better life among like-minded folks, and before they know it, they've got a job, an apartment, openly non-binary friends, and a new queer love...) (OCoLC)1191230423"}, "madsrdf:citationSource": "Spoon, R. Green glass ghosts, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Good Omens meets The Long Way to a Small, Angry Planet in Ryka Aoki's Light From Uncommon Stars, a defiantly joyful adventure set in California's San Gabriel Valley, with cursed violins, Faustian bargains, and queer alien courtship over fresh-made donuts) (OCoLC)1257312938"}, "madsrdf:citationSource": "Aoki, R. Light from uncommon stars, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LGBTQ fiction; has narrow synonym: LGBT fiction; has related synonym: queer fiction)"}, "madsrdf:citationSource": "GSSO - the Gender, Sex, and Sexual Orientation ontology, Aug, 29, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Queer fiction. BT LGBTQ+ fiction)"}, "madsrdf:citationSource": "Homosaurus, Aug. 29, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Queer women of color have historically been underrepresented or excluded completely in fiction and comics. When present, they are depicted as \"less than\" the white, Eurocentric norm. Drawing on semiotics, queer theory, and gender studies, this book addresses the imbalanced representation of queer women of color in graphic narratives and fiction and explores ways of rewriting queer women of color back into the frame. The author interrogates what it means to be \"Other\" and how \"Othering\" can be more creatively resisted\" (OCoLC)1088527464"}, "madsrdf:citationSource": "Earle, M. Writing queer women of color : representation and misdirection in contemporary fiction and graphic narratives, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "summary (Knowing that queer voices have been making themselves heard in Germany, Switzerland, and Austria decades before Stonewall, editors Gary Schmidt and Merrill Cole curated thrilling snapshots of prose fiction from more than twenty contemporary writers whose work defies stereotypes, disciplines, and expectations. These authors produce fiction for adults and young people that celebrates the multiplicity of the present, casts a queer eye on the past, and interrogates LGBTQ+ futures) (OCoLC)1228913248"}, "madsrdf:citationSource": "Work cat.: Quertext : an anthology of queer voices from German-speaking Europe, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6453b054c6e54fa0852302bdc527faedb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "LGBT fiction"}}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "LGBT fiction"}}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6453b054c6e54fa0852302bdc527faedb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "GLBTQ+ fiction"}}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "GLBTQ+ fiction"}}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6453b054c6e54fa0852302bdc527faedb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "LGBTQ+ fiction"}}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "LGBTQ+ fiction"}}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6453b054c6e54fa0852302bdc527faedb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sexual minority fiction"}}, {"@id": "_:n6453b054c6e54fa0852302bdc527faedb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sexual minority fiction"}}], "@id": "/authorities/genreForms/gf2022026063"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026064", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPostludes (Music)", "identifiers:lccn": "gf2022026064", "madsrdf:adminMetadata": [{"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b1"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Postludes (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b5"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b6"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b7"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b8"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b9"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b10"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b11"}], "madsrdf:historyNote": "[Established December 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Parts of musical compositions that conclude a larger work or stand-alone works performed at the end of a ceremony."}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-22T12:05:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Postludes (Music)"}}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (24 postli\ufe20u\ufe21dii dli\ufe20a\ufe21 fortepiano = 24 postludes pour piano)"}, "madsrdf:citationSource": "Polovinkin, Leonid. 24 postli\ufe20u\ufe21dii dli\ufe20a\ufe21 fortepiano, 1941:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Postludien-Buch)"}, "madsrdf:citationSource": "K\u00f6rner, Gotthilf Wilhelm. Postludien-Buch, between 1860 and 1869:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Postlude; a work forming the conclusion of a larger work or one performed at the end of a ceremony; especially a piece played (sometimes improvised) on the organ at the conclusion of a church service)"}, "madsrdf:citationSource": "Harvard dictionary of music, 1986", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover ('Postlude' could be programmed perfectly as an intelligent alternative to the stereotypically flashy encore or even as an unusual concert opener)"}, "madsrdf:citationSource": "Watkins, Huw. Postlude for flute, clarinet, harp and string quartet, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Vor- und Nachspiele f\u00fcr die Orgel : op. 271 = [Preludes and postludes for organ : op. 271]) p. 18 (Nachspiel in A major)"}, "madsrdf:citationSource": "Kern, Carl August. 12 Vor- und Nachspiele f\u00fcr die Orgel, 1880?:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Postlude; variants Postludium, Nachspiel; movement or section of a movement concluding a composition (especially for organ), hence the equivalent of a coda, conclusion or epilogue; the term is sometimes given to the organ piece, frequently improvised, which is played at the end of a service during the exit of the congregation, that is, the concluding voluntary)"}, "madsrdf:citationSource": "Grove music online, June 16, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e1a1a0d6467498b913719b1dcb02232b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 122 (Postlude in C) (OCoLC) 7987340"}, "madsrdf:citationSource": "Work cat: Thirty postludes for the organ, 1900?:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2022026064"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026065", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExperimental music", "identifiers:lccn": "gf2022026065", "madsrdf:adminMetadata": [{"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b1"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Experimental music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, "madsrdf:hasSource": [{"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b5"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b6"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b7"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b8"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b9"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b10"}], "madsrdf:hasVariant": {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b11"}, "madsrdf:historyNote": "[Established April 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical works which are defined by sensibilities radically opposed to or pushing the boundaries of institutionalized aesthetic conventions in music at the time they were composed."}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-25T15:56:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Experimental music"}}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (for solo television performer) unnumbered leaf 4 (performance instructions for graphic score with diagram showing suggested placement of instruments and objects)"}, "madsrdf:citationSource": "Cage, John. Water walk, 1965:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Experimental music (A diverse set of musical practices that gained momentum in the middle of the 20th century, characterized by its radical opposition to and questioning of institutionalized modes of composition, performance, and aesthetics) Avant garde (in our own age the term is often used loosely to describe any artists who have made radical departures from tradition, but it has also been freighted with particular meanings, and these have supported a more specific usage referring to art histories of the late 19th and early 20th centuries, the era of cultural history usually labelled 'Modernism')"}, "madsrdf:citationSource": "Grove music online, May 12, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Experimental music (Experimental music is a general label for any music that pushes existing boundaries and genre definitions. Experimental compositional practice is defined broadly by exploratory sensibilities radically opposed to, and questioning of, institutionalized compositional, performing, and aesthetic conventions in music; a number of early 20th-century American composers... are sometimes referred to as the \"American Experimental School.\" These include Charles Ives, Charles and Ruth Crawford Seeger, Henry Cowell, Carl Ruggles, and John Becker) Avant-garde music (music that is considered to be at the forefront of innovation in its field)"}, "madsrdf:citationSource": "Wikipedia, July 22, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "opening credits (Here's a piano I prepared earlier : experimental music in the 1960s) video (features the music of Steve Reich, John Cage, Cornelius Cardew, and Karlheinz Stockhausen)"}, "madsrdf:citationSource": "Work cat: Here's a piano I prepared earlier, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 516 (although the terms \"avant-garde\" and \"experimental\" are often used to categorize radical composers and their works, it has been noted that \"avant garde remains more a slogan than a definition\" (Griffiths 1980, p. 743) and that \"'experimental music' is ill-defined and the concept it is used to describe is vague\" (Rockwell 1986, p. 91) ...but equally problematically, there is no clear demarcation line between the composers and repertories to which the terms are usually applied)"}, "madsrdf:citationSource": "The Cambridge history of American music, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Articles; Music; Experimental music guide (Experimental music is an umbrella label for a diverse array of contemporary music, from classical and jazz to electronic music, that differs, often radically, from traditional forms of popular music in its composition, performance, and production. The music style... uses various instruments and production methods, including using non-musical objects to create traditional instruments or sounds and manipulating the instruments or recording through physical or electroacoustic means. The compositional structure may even abandon traditional building blocks like rhythm, melody, timbre, or tempo in favor of free improvisation or total deconstruction; the terms \"experimental\" and \"avant-garde\" are sometimes used interchangeably)"}, "madsrdf:citationSource": [{"@id": "https://www.masterclass.com/articles/experimental-music-guide"}, "MasterClass WWW site, viewed May 13, 2022:"], "madsrdf:citationStatus": "found"}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Avant-garde music"}}, {"@id": "_:n74d10e61438d4b4e8d16058ffc1d63a5b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Avant-garde music"}}], "@id": "/authorities/genreForms/gf2022026065"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026066", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLarge print books", "identifiers:lccn": "gf2022026066", "madsrdf:adminMetadata": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b1"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Large print books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b3"}]}, "madsrdf:hasSource": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b5"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b6"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b7"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b8"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b9"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b10"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b11"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b12"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b13"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b14"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b15"}], "madsrdf:hasVariant": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b16"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b19"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b22"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b25"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b28"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b31"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b34"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b37"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b40"}], "madsrdf:historyNote": "[Established December 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Books set in a type size larger than normal to enhance readability, improve letter and word recognition, and aid reading comprehension."}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-22T12:05:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Large print books"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Large-print materials are most commonly available in 16- to 18-point type. The minimum size for large-print materials as defined by the US Postal Service Free Matter for the Blind mailing standard is 14-point type\")"}, "madsrdf:citationSource": "Large print materials, via National Library Service for the Blind and Print Disabled, Library of Congress website, viewed Sep. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Large print books. Use for books set in a type size larger than normal for the benefit of people with impaired vision. UF Books, Large print; Large font books; Large type books; Largeprint books; Sight-saving books)"}, "madsrdf:citationSource": "RBMS controlled vocabularies: genre terms, viewed Sep. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Large-print book; a book where the text is printed in larger text than normal, so as to make it easier to read, especially for visually impaired people)"}, "madsrdf:citationSource": "Collins English dictionary, viewed Sep. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Large print edition\" published by Thorndike Press) (OCoLC)1268120500"}, "madsrdf:citationSource": "Work cat.: Toews, M. Fight night, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Large print books; Books set in type larger than normal, generally over 16-point, usually for the benefit of readers with visual impairments; UF Large print book; Books, large print; Large-print books; Large type books; Large-type books; Sight-saving books)"}, "madsrdf:citationSource": "Art and architecture thesaurus, viewed Sep. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Large print; a larger typeface than is usual, esp. one designed to enhance readability for partially-sighted people; frequently attributive in later use)"}, "madsrdf:citationSource": "Oxford English dictionary, viewed Sep. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"large print (LP)\"; \"Any type size larger than 16-point. Also refers to books printed in type larger than the 9-, 10-, or 11-point size normally used for text, mostly publications for visually impaired, elderly, and young readers (picture books, beginning readers, etc.)\"; \"The National Association for Visually Handicapped has established standards for LP materials\")"}, "madsrdf:citationSource": "ODLIS: online dictionary for library and information science, viewed Sep. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Large-print; being set in a large size of type (such as 14 point or larger) especially for use by the partially sighted)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, viewed Sep. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Center Point Large Print edition\") (OCoLC)1309960013"}, "madsrdf:citationSource": "McGuire, S. Across the green grass fields, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"large print books are a well-known solution for visually impaired readers\"; \"Large print is not just a bigger font size that makes reading accessible for the visually impaired. It's also proven to improve letter and word recognition, aid reading comprehension, and increase feelings of confidence and satisfaction when reading. That makes it perfect for beginning or reluctant readers and ESL/ELL students. Large print books are an essential resource for any literacy program\"; also useful for people with digital eye strain)"}, "madsrdf:citationSource": "The biggest large print myths busted!, Apr. 20, 2016 via Blog.Gale.com, viewed Sep. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title p. (\"Published in large print\") (OCoLC)4503801"}, "madsrdf:citationSource": "Rinehart, M. R. The circular staircase, 1978:", "madsrdf:citationStatus": "found"}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Largeprint books"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Largeprint books"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Large print"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Large print"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Sight-saving"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Sight-saving"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Large font"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Large font"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Large type"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Large type"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Large type books"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Large type books"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Largeprint"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Largeprint"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sight-saving books"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sight-saving books"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b40", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n082008054ab143e49b8d6223e935ebd8b41"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Large font books"}}, {"@id": "_:n082008054ab143e49b8d6223e935ebd8b41", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Large font books"}}], "@id": "/authorities/genreForms/gf2022026066"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026067", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScience fiction operas", "identifiers:lccn": "gf2022026067", "madsrdf:adminMetadata": [{"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b1"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Science fiction operas"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026976"}, "madsrdf:hasSource": [{"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b5"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b6"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b7"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b8"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b9"}], "madsrdf:hasVariant": [{"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b10"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b13"}], "madsrdf:historyNote": "[Established December 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Operas that depict imagined scientific or technological advances (e.g., time travel, artificial intelligence) and their impact on society."}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-22T12:05:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Science fiction operas"}}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Aniara (opera) (Aniara is an opera in two acts by Karl-Birger Blomdahl, with a libretto by Erik Lindegren based on the poem Aniara by Harry Martinson; synopsis: Controlled by the computer Mima, the space ship Aniara leaves the poisoned Earth, heading for Mars. Through Mimaroben, who is the operator of Mima, the emigrants learn of the evil of mankind. During the celebration of midsummer, the vessel is thrown off course, causing panic, and forcing a journey to the constellation Lyra which commander Chefone says will last for the rest of the lives of the crew and passengers)"}, "madsrdf:citationSource": "Wikipedia, Sept. 12, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Berkovec, Ji\u0159\u00ed (His most successful achievements include the science-fiction opera Krakatit and pieces written for Concertino Praga) White, Ruth (S.) (A continuing project is a science fiction opera trilogy, for which she is writing both the text and score) Glass, Philip (Glass has undertaken many other varied collaborations: Doris Lessing on two science-fiction operas, The Making of the Representative for Planet 8 (1985-86) and The Marriages between Zones Three, Four and Five (1997))"}, "madsrdf:citationSource": "Grove music online, Sept. 12, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Science fiction opera (Science fiction opera is a subgenre of science fiction. It refers to operas whose subject-matter fits in the science fiction genre. Like science-fiction literature, science-fiction operas may be set in the future and involve spaceflight or alien invasion. Other science-fiction operas focus on a dystopian view of the future. Like Lorin Maazel's opera 1984, they may be based on a previously written science fiction book; List of science fiction operas: Karl-Birger Blomdahl: Aniara; Viktor Ullmann: The Emperor of Atlantis; Eef van Breen: 'u', the first opera in Klingon; Gavin Bryars: Doctor Ox's Experiment; Philip Glass: The Making of the Representative for Planet 8 and The Marriages Between Zones Three, Four and Five, and The Voyage; Joseph Haydn: Il mondo della luna; Leo\u0161 Jan\u00e1\u010dek: The Makropulos Affair, and The Excursions of Mr. Brou\u010dek to the Moon and to the 15th Century; Karel Janovick\u00fd: The Utmost Sail; Lorin Maazel: 1984; Tod Machover: Valis; Gian Carlo Menotti: A Bride from Pluto, and Help, Help, the Globolinks!; Jacques Offenbach: Le voyage dans la lune; Poul Ruders: The Handmaid's Tale; Howard Shore: The Fly; Karlheinz Stockhausen: Licht; Steven Andrew Taylor: Paradises Lost; Michael Tippett: New Year)"}, "madsrdf:citationSource": "Wikipedia, Sept. 12, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "( Haydn's opera Life on the Moon (Il mondo della luna) was first performed in 1777 and with a plot involving a--faked--journey to the Moon has been described as one of the first sci-fi operas; Jan\u00e1\u010dek - The Makropulos Affair; The Excursions of Mr. Brou\u010dek to the Moon and to the 15th Century; Stockhausen - Licht; Max Richter - Sum; Lorin Maazel - 1984; Eef van Breen - /U/; Offenbach - Le voyage dans la Lune; Tippett - New Year;Tod Machover - VALIS; Philip Glass - The Marriages Between Zones Three, Four and Five; No list of science fictional operas would be complete without ETO's own contribution to the genre: Russell Hepplewhite - Laika the Spacedog)"}, "madsrdf:citationSource": "Eleven mostly weird and sometimes wonderful science fiction operas, via English Touring Opera website, posted Sept. 29, 2014, viewed on Sept. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(score of a science fiction opera) t.p. (Opera in 2 acts (7 scenes) after Harry Martinson's verse epic Aniara) (OCoLC)1685327"}, "madsrdf:citationSource": "Work cat.: Blomdahl, Karl-Birger. Aniara, 1959", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Science fictional operas"}}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Science fictional operas"}}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sci-fi operas"}}, {"@id": "_:nf9e8a337583d47d0bd76b4d7b082a320b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sci-fi operas"}}], "@id": "/authorities/genreForms/gf2022026067"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026068", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBiographical operas", "identifiers:lccn": "gf2022026068", "madsrdf:adminMetadata": [{"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db1"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Biographical operas"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026976"}, "madsrdf:hasSource": [{"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db5"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db6"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db7"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db8"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db9"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db10"}], "madsrdf:hasVariant": {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db11"}, "madsrdf:historyNote": "[Established December 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-22T12:05:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biographical operas"}}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alessandro Stradella; Stradella's life was used for the basis of multiple biographic operas and romanticised novels)"}, "madsrdf:citationSource": "Stradella: is that a pasta dish?, via Spitalfields Music website, posted Nov. 18, 2015, viewed on Sept. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Boston Modern Orchestra Project is co-producing five operas in five years and each of them chronicles the life of a Black American historical figure; The first in the series of five is on Malcolm X, a work called \"X: The Life and Times of Malcolm X\"; In addition to Malcolm X, biographical operas on Harriet Tubman, Frederick Douglass, Langston Hughes and Martin Luther King, Jr will also stage between now and late 2026)"}, "madsrdf:citationSource": "Jones, Glenn. Boston Orchestra Project highlighting lives of 5 Black historical figures, via NBC Boston website, updated on June 21, 2022, viewed on Sept. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Biographical operas are nothing new, with subject matter ranging from Anne Boleyn to Steve Jobs)"}, "madsrdf:citationSource": "Hereford, Preston. Historical figures that deserve their own operas, via Opera offstage website, viewed Sept. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(score of a biographical opera) (OCoLC)972331743"}, "madsrdf:citationSource": "Work cat.: Glass, Philip. Akhnaten : an opera in three acts, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anna Nicole Smith; a brand-new opera based on her life; the opera fell like a failed souffle. By deliberately opting for a TV-biopic approach, it became the latest entry in the lists of failed biographical operas)"}, "madsrdf:citationSource": "Midgette, Anne. Royal Opera's \"Anna Nicole\" misses the inner beauty, via Washington post website, posted Feb. 17, 2011, viewed Sept. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Akhnaten (opera) (opera in three acts based on the life and religious convictions of the Egyptian pharaoh Akhenaten (Amenhotep IV), written by Philip Glass; According to the composer, this work is the culmination of his two other biographical operas, Einstein on the Beach (about Albert Einstein) and Satyagraha (about Mahatma Gandhi))"}, "madsrdf:citationSource": "Wikipedia, Sept. 12, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biographic operas"}}, {"@id": "_:nc7669c77d1b94d5c9863cb71547fa44db12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biographic operas"}}], "@id": "/authorities/genreForms/gf2022026068"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026069", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTables of contents", "identifiers:lccn": "gf2022026069", "madsrdf:adminMetadata": [{"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b1"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tables of contents"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasSource": [{"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b5"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b6"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b7"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b8"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b9"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b10"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b11"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b12"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b13"}], "madsrdf:hasVariant": [{"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b14"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b17"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b20"}], "madsrdf:historyNote": "[Established December 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-22T12:05:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tables of contents"}}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)37770914"}, "madsrdf:citationSource": "Tables of contents from the Proceedings of the Mechanical Failures Prevention Group meetings 1-48 and the 49th Meeting of the Society for Machinery Failure Prevention Technology, 1967-1995, 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)12106067"}, "madsrdf:citationSource": "Provisional table of contents for the complete works of Voltaire, \u0152uvres compl\u00e8tes de Voltaire, 1983.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)8764992"}, "madsrdf:citationSource": "Compiled table of contents to the publications of the State Historical Society of North Dakota, 1906-1980, with author, title, and subject indices, 1981.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1041191058"}, "madsrdf:citationSource": "Hannigan, Ken. Wicklow Historical Society journal cumulative list of contents, vols. 1-5, 1988-2018, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)871824480"}, "madsrdf:citationSource": "Tables of contents, Allred family newsletter : issues 1-97, October 1989-winter 2013, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(table of contents (TOC): A list of the contents of a printed publication in the order of their appearance, usually with page numbers as locators. In a book, the TOC lists the front matter, chapters or other major divisions of the work, and the back matter (see this example). In an anthology or collection, the TOC lists the titles of the works included by the editor(s) (stories, poems, plays, essays, etc.) in order of appearance. In books, the TOC is printed in the front matter on the first recto following the dedication or title page. In periodicals, the TOC appears near the front of each issue or on the back cover, listing the editorial content (articles, columns, reviews, etc.) but not any advertising. See also: current contents; current contents: A periodical that reproduces the tables of contents of the leading scholarly journals in an academic discipline or field to assist researchers in keeping abreast of the most recently published literature in their areas of interest or specialization, usually published weekly or monthly. Because currency is the raison d'\u00eatre of this type of publication, libraries may limit back files to the most recent three to five years)"}, "madsrdf:citationSource": "Online dictionary for library and information science, Sept. 13, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tables of contents. UF contents (table of contents); contents, tables of. SN In written or printed works, a list of the work's parts in sequence, usually with a page number or other symbol indicating where each part begins. BT partial documents; partial documents has BT document genres; document genres has BT information forms (objects))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Sept. 13, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivision --Tables of contents; UF --Contents, Tables of. SN Use as a form subdivision under uniform titles of individual works and under types of publications for works that consist of tables of contents of those works.)"}, "madsrdf:citationSource": "LCSH, Sept. 13, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tables of contents of the Austin, Texas, underground press publication The rag) (OCoLC)876149177"}, "madsrdf:citationSource": "Prim, Phil. The rag table of contents, July 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "TOCs (Tables of contents)"}}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "TOCs (Tables of contents)"}}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Contents, Tables of"}}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Contents, Tables of"}}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "TOC (Tables of contents)"}}, {"@id": "_:nb18bc89e8f3d4ad4aebeda36b0fad3e6b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "TOC (Tables of contents)"}}], "@id": "/authorities/genreForms/gf2022026069"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026070", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAromantic comics", "identifiers:lccn": "gf2022026070", "madsrdf:adminMetadata": [{"@id": "_:n28e249a8bd2b46f38f56791275777c69b1"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Aromantic comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n28e249a8bd2b46f38f56791275777c69b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026162"}, "madsrdf:hasSource": [{"@id": "_:n28e249a8bd2b46f38f56791275777c69b5"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b6"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b7"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b8"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b9"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b10"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b11"}], "madsrdf:hasVariant": {"@id": "_:n28e249a8bd2b46f38f56791275777c69b12"}, "madsrdf:historyNote": "[Established December 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics featuring aromantic characters or addressing aromantic themes."}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "revised"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aromantic comics"}}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"A comic exploring asexuality and aromanticism!\")"}, "madsrdf:citationSource": "Nyugen, T. Aros and aces, via Instagram, viewed Sep. 14, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Program/Schedule (panel titled \"Too ace for this: crafting asexual and aromantic comics\")"}, "madsrdf:citationSource": "Queers & comics conference website, viewed Sep. 14, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Kiryuu-sensei wa Ren'ai ga Wakaranai (Kiryuu-sensei Doesn't Understand Love) is a not-quite-romantic comedy by Ono Haruka, published in the josei magazine Ura Sunday in 2016. It is one of the few mangas that tackle the subject of asexuality and aromanticism\"; \"All 5 volumes were released in France by Akata under the title Aromantic (Love) Story\")"}, "madsrdf:citationSource": "Manga / Kiryuu-sensei wa Ren'ai ga Wakaranai, via TV Tropes website, viewed Sep. 14, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"folks at Archie Comics announce they're taking the characters in a whole new direction. Among the changes? Jughead Jones, so often the voice of wisdom among his hormone-fueled cohorts at Riverdale High, would officially come out as aromantic and asexual [in the 2016 'Jughead' comics series by Chip Zdarsky and Erica Henderson]\"; \"Jughead was always basically aro-ace anyway, even if the creators never heard of such a concept\")"}, "madsrdf:citationSource": "Gonzalez, E. Acing it : an aro-ace reader's view on Jughead, Jun. 21, 2018, via Bookriot website, viewed Sep. 14, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Yuriko, an asexual woman, agrees to take a husband to satisfy her parents--which is how she finds herself tying the knot with Gakurouta, a gay man in love with his childhood friend with his own family circumstances. And so begins the tale of their marriage of convenience\"; female lead is aroace--both aromantic and asexual) (OCoLC)1281587973"}, "madsrdf:citationSource": "Work cat: Shirono, H. I want to be a wall. 1, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Comics about being aro\")"}, "madsrdf:citationSource": "Celia. Aro comics, via Instagram, viewed Sep. 14, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"I'd seen aroace representation in manga before and I'm so glad that more aro-ace characters are being created\"; \"I was worried that because the plot revolved around an aroace woman and a gay man pretending to marry in order to fit in with society, they would develop romantic feelings for each other, but thankfully, this does not appear to be the case\"; \"the initial definition of 'asexual' [in the book] is actually the definition of 'aromantic'\"; \"Yuriko is the strongest element of the book, honestly, and the portrayal of her aromantic nature seems about right\")"}, "madsrdf:citationSource": "Goodreads reviews of I want to be a wall, viewed Sep. 14, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n28e249a8bd2b46f38f56791275777c69b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Aro comics"}}, {"@id": "_:n28e249a8bd2b46f38f56791275777c69b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aro comics"}}], "@id": "/authorities/genreForms/gf2022026070"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026071", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAromantic fiction", "identifiers:lccn": "gf2022026071", "madsrdf:adminMetadata": [{"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb1"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Aromantic fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026063"}, "madsrdf:hasSource": [{"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb5"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb6"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb7"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb8"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb9"}], "madsrdf:hasVariant": {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb10"}, "madsrdf:historyNote": "[Established December 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction featuring aromantic characters or addressing aromantic themes."}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ic"}, "ri:recordStatus": "revised"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aromantic fiction"}}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Georgia has parents who are still in love, two sets of grandparents that are still together, and a brother who married his girlfriend, but at eighteen she has never even kissed someone (not even her lesbian best friend, Felipa) or particularly even wanted to; at the prom afterparty she is surrounded by couples making out, and she really does not know what is wrong-- but in college she comes to understand herself as asexual/aromantic, and to capture the part of her identity that has always eluded her) (OCoLC)1224300827"}, "madsrdf:citationSource": "Work cat: Oseman, A. Loveless, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Today the field of aspec (aromantic/asexual) literature is steadily increasing, giving a new generation the kind of genuine reflection that they desperately need. From academic texts explaining the ins and outs of asexuality, to swoony romances, to high-stakes speculative adventures on Earth or in space, this list highlights some of the best diverse books featuring canonically aromantic and asexual characters!)"}, "madsrdf:citationSource": "Kirichanskaya, M. 17 books that tackle aromantic and asexual validation, Jan. 22, 2022, via Buzzfeed website, viewed Sep. 15, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Take me to your nerdy leader (under Community reviews: \"AlloAro Rep!; \"love the aro rep\"; \"Oh and it was cool to see an aromantic character! So many people confuse aromanticism with asexuality but the author knew the difference! You can have sexual attraction without romantic attraction!\"; \"It was also wonderful seeing an allosexual aro person navigating things\")"}, "madsrdf:citationSource": "Goodreads website, Sept. 15, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Foreword (Common Bonds is the culmination of three things we love: aromantic representation, speculative fiction, and platonic relationships) (OCoLC)1247155368"}, "madsrdf:citationSource": "Common bonds : a speculative aromantic anthology, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Aromantic fiction. UF Aro fiction. BT LQBTQ+ fiction. SN Written works of fiction featuring aromantic characters or addressing aromantic themes)"}, "madsrdf:citationSource": "Homosaurus, viewed Sept. 15, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Aro fiction"}}, {"@id": "_:n9a55d777028549b3ba9edc6b44f4e6abb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aro fiction"}}], "@id": "/authorities/genreForms/gf2022026071"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026073", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGenderqueer fiction", "identifiers:lccn": "gf2022026073", "madsrdf:adminMetadata": [{"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb1"}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Genderqueer fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026063"}, "madsrdf:hasSource": [{"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb5"}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb6"}], "madsrdf:hasVariant": [{"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb7"}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb10"}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb13"}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb16"}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb19"}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb22"}], "madsrdf:historyNote": "[Established March 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction featuring genderqueer characters or addressing genderqueer themes."}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ic"}, "ri:recordStatus": "revised"}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Genderqueer fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gender-nonconforming people. UFs: Gender-creative people; Gender-independent people; Gender-non-normative people; Gender-variant people; Genderqueer people; Non-binary people)"}, "madsrdf:citationSource": "LCSH, March 3, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP data view (summary: In 2003 New York, a genderqueer book conservator who feels trapped by her gender presentation, ill-fitting relationship, and artistic block discovers a decades-old hidden queer love letter and becomes obsessed with tracking down its author) (DLC)2022040937"}, "madsrdf:citationSource": "Work cat: Endpapers, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Genderfluid fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Genderfluid fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nonbinary fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonbinary fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gender-fluid fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gender-fluid fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gender-nonconforming fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gender-nonconforming fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gender-queer fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gender-queer fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Non-binary fiction"}}, {"@id": "_:ndc0c0ba69ffc41409f3c4c599544945cb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Non-binary fiction"}}], "@id": "/authorities/genreForms/gf2022026073"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026075", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTaksims", "identifiers:lccn": "gf2022026075", "madsrdf:adminMetadata": [{"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb1"}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Taksims"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026133"}], "madsrdf:hasSource": [{"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb5"}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb6"}], "madsrdf:hasVariant": [{"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb7"}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb10"}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb13"}], "madsrdf:historyNote": "[Established February 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-22T15:58:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Taksims"}}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Taqs\u012bm (taksim) (Term referring to an improvisation section in Arab and Turkish art music) Arab music. I. Art music. 5. The Ottoman age. (ii) Practice (both Arab and Turkish traditions recognized improvisation as a separate genre, whether instrumental (taqs\u012bm) or vocal (lay\u0101l\u012b)) Turkey. IV. Art music. 4. Formal structure (taksim (Arab. taqsim); important instrumental form, often simply translated as \"improvisation\"; uses \"taksims\" as a plural) Ottoman music. 1. 1580-1700 (uses \"taksim\" as both singular and plural)"}, "madsrdf:citationSource": "Grove music online, September 20, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert, pages 4-5 (taksim; middle eastern improvisation; \"A musician's knowledge of makam [mode, set of compositional rules] is displayed in the performance of a taksim\"; \"The classical taksim is constructed in three parts. The first section serves as an opening to the makam ... In the second section (meyan) the performer modulates to related makams and reaches the highest note and climax of the taksim. The third section gradually travels back to the tonic and original makam. There is no rhythmic metre or set time limit\"; uses \"taksims\" as the plural) (DLC)2022623891"}, "madsrdf:citationSource": "Work cat: Kartal, G\u00f6ksel. The art of taksim, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Taqs\u012bm"}}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Taqs\u012bm"}}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Taksim"}}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Taksim"}}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Taqs\u012bms"}}, {"@id": "_:n0346b24414b343e0ab3c60fc5e239bccb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Taqs\u012bms"}}], "@id": "/authorities/genreForms/gf2022026075"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026076", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnimal comics", "identifiers:lccn": "gf2022026076", "madsrdf:adminMetadata": [{"@id": "_:nc0f77077ae444dfcb271906265e0df2bb1"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Animal comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc0f77077ae444dfcb271906265e0df2bb3"}]}, "madsrdf:exampleNote": "Note under [Funny animal comics]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:nc0f77077ae444dfcb271906265e0df2bb5"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb6"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb7"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb8"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb9"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb10"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb11"}], "madsrdf:historyNote": "[Established February 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that feature stories about animals. For comics that feature anthropomorphic animals see [Funny animal comics.]"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-22T15:58:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Animal comics"}}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel) p. 4 of cover (Peanutbutter is a cute little kitty who thinks she works in an office. She wears her little hat and tie and frequently falls asleep on the reams of paper overflowing her inbox. Jeremy is the crafty crow who lives in the tree outside of Peanutbutter's window. Jeremy tries to trick Peanutbutter again and again and steal her hat. Somehow Peanutbutter and Jeremy build a friendship together) (OCoLC)53992637"}, "madsrdf:citationSource": "Kochalka, James. Peanutbutter & Jeremy's best book ever!, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel; summary: Petey is a compulsive dog that values his unchecked freedom and exemption from responsibility. Pussy is an irritable, self-absorbed cat, of course, with a gambling problem. They are joined by the obnoxious Bernie the bird, who has courted a new girlfriend (or is it just a mirror?) and their owner, a sexually frustrated geriatric who is more concerned with online shopping then her pets. Their darkly hilarious adventures include tracking down troublesome squirrels, barely taking care of a new litter of puppies, and avoiding the dreaded \"snip- snip\" from the veterinarian) (OCoLC)1005691258"}, "madsrdf:citationSource": "Work cat.: Kerschbaum, John. Petey & Pussy in puppy love, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)988580824"}, "madsrdf:citationSource": "Animal comics : multispecies storyworlds in graphic narratives, 2018.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel; summary: This is the journey of Laika, the abandoned puppy destined to become Earth's first space traveler. With the blending of fact and fiction, this story intertwines three compelling lives. Along with Laika, there is Korolev, a driven engineer at the top of the Soviet space program and Yelena, the lab technician responsible for Laika's health and life) (OCoLC)84900438"}, "madsrdf:citationSource": "Abadzis, Nick. Laika, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel; summary: After a stack of fashion magazines falls on Kiki Kitty's head while she is blowing out the candles on her birthday cake, Kiki turns into Fashion Kitty, a feline superhero who saves other kitties from fashion disaster) (OCoLC)58043265"}, "madsrdf:citationSource": "Harper, Charise Mericle. Fashion Kitty, \u00a92005", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comic book serial) (OCoLC)20964434"}, "madsrdf:citationSource": "Animal comics, 1941-1948.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0f77077ae444dfcb271906265e0df2bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel; summary: A loveable and delusional house cat named Binky, who, while in hot pursuit of an alien wanderer (a bug), falls out of the space station porthole (the bathroom window), and finds himself in outer space (outside the house)) (OCoLC)468103107"}, "madsrdf:citationSource": "Spires, Ashley. Binky to the rescue, \u00a92010", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2022026076"}
