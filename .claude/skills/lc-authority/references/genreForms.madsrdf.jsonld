, "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scripts, Stage"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b45", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b46"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stage plays"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b46", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stage plays"}}], "@id": "/authorities/genreForms/gf2014026297"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026298", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDramatic monologues (Poetry)", "identifiers:lccn": "gf2014026298", "madsrdf:adminMetadata": [{"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b1"}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dramatic monologues (Poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422"}, "madsrdf:hasSource": [{"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b5"}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b6"}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b7"}], "madsrdf:hasVariant": [{"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b8"}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems in which a character other than the poet addresses a silent audience, thus unwittingly revealing the character's own nature."}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:18:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramatic monologues (Poetry)"}}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dramatic monologue: A poem presented as though spoken not by the poet but by a single imagined or historical person, usually to an imagined auditor: the speaker or 'persona' is thus dramatized, often ironically, through his or her own words)"}, "madsrdf:citationSource": "Concise Oxford companion to English literature, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dramatic monologue: A kind of poem in which a single fictional or historical character other than the poet speaks to a silent 'audience' of one or more persons. Such poems reveal not the poet's own thoughts but the mind of the impersonated character, whose personality is revealed unwittingly; this distinguishes a dramatic monologue from a lyric, while the implied presence of an auditor distinguishes it from a soliloquy. Major examples of this form in English are Tennyson's 'Ulysses' (1842), Browning's 'Fra Lippo Lippi' (1855), and T. S. Eliot's 'The Love Song of J. Alfred Prufrock' (1917). Some plays in which only one character speaks, in the form of a monologue or soliloquy, have also been called dramatic monologues; but to avoid confusion it is preferable to refer to these simply as monologues or as monodramas)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "dramatic monologue (a type of soliloquy in which a character (not the poet) addresses a silent listener, and in his speech reveals his own nature, the nature of the conflict in his situation, and the period and setting of the poem or play. Robert Browning's synonymous term is \"dramatic lyric\") lyric (originally, poetry meant to be sung, accompanied by music from the lyre or lute. the term now refers to a category of poetry (distinct from Narrative poem and Dramatic poetry) that is short in form, concentrated in its expression, subjective in its observations, personal in subject matter, and songlike in quality; Most often, its strategy is to create a private expression intended to be overheard; if the lyric is directly addressed to another person, it is called a dramatic lyric or dramatic monologue. In the 20th century, the lyric is the dominant poetic form)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramatic lyrics"}}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramatic lyrics"}}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Monologues, Dramatic (Poetry)"}}, {"@id": "_:ne3920e2974034b23b5ee3b0aaa3515f9b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monologues, Dramatic (Poetry)"}}], "@id": "/authorities/genreForms/gf2014026298"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026299", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDrames \u00e0 clef", "identifiers:lccn": "gf2014026299", "madsrdf:adminMetadata": [{"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b1"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Drames \u00e0 clef"}, "madsrdf:elementList": {"@list": [{"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b3"}]}, "madsrdf:exampleNote": "Note under [Biographical drama]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b5"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b6"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b7"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b8"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays in which real persons, places, or events are depicted under invented names. For plays that depict the lives of real people interspersed with fictional characters and events see [Biographical drama.]"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:16:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drames \u00e0 clef"}}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(romans \u00e0 clef; drames \u00e0 clef)"}, "madsrdf:citationSource": "Walbridge, E. Literary characters drawn from life, 1936", "madsrdf:citationStatus": "found"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(roman \u00e0 clef; romans \u00e0 clef: a novel in which actual persons, places, or events are depicted in fictional guise)"}, "madsrdf:citationSource": "Am. heritage dict.", "madsrdf:citationStatus": "found"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Heinrich von Kleist: Die Hermannsschlacht. Written as a drame \u00e0 clef to promote a self-evident political agenda and conceived of with typically Kleistian enthusiasm, Die Hermannsschlacht [Hermann's Battle] has met with either a warm or cool reception upon the stage almost solely on the basis of the current German political climate. Kleist intended his version of Arminius's defeat of the Romans in the year 9 CE as a propaganda play to incite the Prussians and the Austrians to unite against their common foe, France, but Napoleon's victory at Wagram rendered performance impossible.)"}, "madsrdf:citationSource": "The literary encyclopedia, via WWW, Nov. 15, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Drames \u00e0 clef. BT Drama)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n18f80c3142b84b7c9f903f8535c7cf98b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Front Page was very much a drame \u00e0 clef, with the mayor based on a combination of Fred Busse and William Hale (Big Bill) Thompson, Jr.; the hapless leftist, Earl Williams, based on Terrible Tommy O'Connor who, sentenced to hang in 1921, escaped and was never recaptured; Hildy, the reporter, on Hilding Johnson, a Swedish immigrant who rose from copyboy to top reporter; and Walter Burns, the city editor, on Walter C. Howey, for whom MacArthur had worked on the Chicago Tribune and the Chicago Herald and Examiner.)"}, "madsrdf:citationSource": "Ben Hecht biography, via YourDictionary.com, Nov. 15, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026299"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026300", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDrolls", "identifiers:lccn": "gf2014026300", "madsrdf:adminMetadata": [{"@id": "_:n56683f7360f949fa923ddb7ac85a413cb1"}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Drolls"}, "madsrdf:elementList": {"@list": [{"@id": "_:n56683f7360f949fa923ddb7ac85a413cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026265"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026335"}], "madsrdf:hasSource": [{"@id": "_:n56683f7360f949fa923ddb7ac85a413cb5"}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb6"}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb7"}], "madsrdf:hasVariant": [{"@id": "_:n56683f7360f949fa923ddb7ac85a413cb8"}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb11"}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short farces and comic scenes adapted from other plays as a substitute for full-length or serious plays that were not permitted by the government during England's Commonwealth period."}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:18:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drolls"}}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(drolls. Also known as droll-humours. They were brief farces and comic scenes adapted from plays or merely improvised and invented by actors, and traditionally presented in public houses or in taverns during the Commonwealth period when the theatres were shut and stage plays forbidden. Some of these entertainments were collected and published by Francis Kirkham in a work titled The Wits, or Sport upon Sport (1662, 1673).)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Drolls. BT Comedy sketches; Farces)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Droll. A short dramatic piece (also known as \"drollery\" or \"droll humor\") cultivated on the Commonwealth Interregnum stage in England as a substitute for full-length or serious plays that were not permitted by the government. A droll was likely to be a \"short, racy, comic\" scene selected from some popular play (as a Launcelot Gobbo scene from The Merchant of Venice) and completed by dancing somewhat in the manner of the earlier jig.)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n56683f7360f949fa923ddb7ac85a413cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Drolleries"}}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drolleries"}}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n56683f7360f949fa923ddb7ac85a413cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Droll-humours"}}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Droll-humours"}}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n56683f7360f949fa923ddb7ac85a413cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Droll humors"}}, {"@id": "_:n56683f7360f949fa923ddb7ac85a413cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Droll humors"}}], "@id": "/authorities/genreForms/gf2014026300"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026301", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDystopian comics", "identifiers:lccn": "gf2014026301", "madsrdf:adminMetadata": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b1"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dystopian comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b3"}]}, "madsrdf:exampleNote": "Noted under [Apocalyptic comics]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026530"}, "madsrdf:hasSource": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b5"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b6"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b7"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b8"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b9"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b10"}], "madsrdf:hasVariant": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b11"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b14"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b17"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b20"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b23"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b26"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b29"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b32"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b35"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b38"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics set in an uncertain future, in a society ruled by an ineffectual, corrupt, or oppressive regime or by aliens, robots, etc. For comics set in a world or civilization after a catastrophic event (e.g., nuclear war, an alien invasion), sometimes also including the period immediately preceding the event see [Apocalyptic comics.]"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:16:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dystopian plays. UF Anti-utopian plays; Cacotopian plays; Dystopias--Drama; Dystopic plays; Negative utopian plays)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Chapter 3--Science Fiction, p. 241 (Dystopian and Utopian Worlds. Dystopian fiction showcases an alternate look at the world, with the protagonist trying to cope with a totalitarian form of government--typically a fascist state.) Chapter 3--Science Fiction, p. 245 (Post-Apocalypse. This subgenre examines what life would be like if a planet wide disaster struck Earth. In the tales there may be an ecological change, civilization may nearly be made extinct, and strange life-forms may now inhabit Earth. The subgenre is closely related to dystopian science fiction, but goes one step further by showcasing the entire collapse of society following a nuclear holocaust or other devastating event.)"}, "madsrdf:citationSource": "Pawuk, M. Graphic novels : a genre guide to comic books, manga, and more, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (the genre of utopian fiction, typically written today within \"an explicitly science-fictional context,\" through three distinct frameworks: anti-utopia, heterotopia, and dystopia; George Schuyler's Black No More (1931) is often seen as an anti-utopian text) p. 3 (Octavia Butler presents readers with a negative utopia, also known as dystopia, in Parable of the Sower (1993); counter-utopian science fiction novels)"}, "madsrdf:citationSource": "Gill, V.K. African American utopian critiques, 2006, viewed online Feb. 13, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 65-73 (dystopian science fiction: if a utopia is an imaginary ideal society that dreams of a world in which the social, political, and economic problems of the real present have been solved ... then a dystopia is an imagined world in which the dream has become a nightmare)"}, "madsrdf:citationSource": "Booker, M. The science fiction handbook, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 597 (traditional utopian, dystopian, anti-utopian, and counterutopian fiction)"}, "madsrdf:citationSource": "World literature today, summer 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dystopian films; Dystopian television programs)"}, "madsrdf:citationSource": "LCGFT", "madsrdf:citationStatus": "found"}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Counter-utopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Counter-utopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Negative utopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Negative utopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dystopia comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopia comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Antiutopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Antiutopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anti-utopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anti-utopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Counterutopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Counterutopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dystopian science fiction comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopian science fiction comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cacotopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cacotopian comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dystopic comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopic comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b38", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25c74cff4fb740a882335233f47385c9b39"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dystopic science fiction comics"}}, {"@id": "_:n25c74cff4fb740a882335233f47385c9b39", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopic science fiction comics"}}], "@id": "/authorities/genreForms/gf2014026301"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026302", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDystopian fiction", "identifiers:lccn": "gf2014026302", "madsrdf:adminMetadata": [{"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb1"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dystopian fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb3"}]}, "madsrdf:exampleNote": "Note under [Apocalyptic fiction]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026529"}, "madsrdf:hasSource": [{"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb5"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb6"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb7"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb8"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb9"}], "madsrdf:hasVariant": [{"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb10"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb13"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb16"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb19"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb22"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb25"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb28"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb31"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction set in an uncertain future, in a society ruled by an ineffectual, corrupt, or oppressive regime or by aliens, robots, etc. For fiction set in a world or civilization after a catastrophic event (e.g., nuclear war, alien invasion, pandemic, environmental collapse), sometimes also including the period immediately preceding the event, see [Apocalyptic fiction.]"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-03T08:30:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopian fiction"}}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dystopias: Literally, \"bad place.\" Use for works that are accounts of imaginary worlds, usually in the future, in which present tendencies, beliefs, principles, or theories are carried out to their intensely unpleasant culmination. Examples include George Orwell's 1984 and Aldous Huxley's Brave new world.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 65-73 (dystopian science fiction: if a utopia is an imaginary ideal society that dreams of a world in which the social, political, and economic problems of the real present have been solved ... then a dystopia is an imagined world in which the dream has become a nightmare. Also known as anti-utopias, dystopias are often designed to critique the possible negative implications of certain forms of utopian thought)"}, "madsrdf:citationSource": "Booker, M. The science fiction handbook, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (George Schuyler's Black No More (1931) is often seen as an anti-utopian text) p. 3 (Octavia Butler presents readers with a negative utopia, also known as dystopia, in Parable of the Sower (1993); counter-utopian science fiction novels) p. 5 (counter-utopian novels)"}, "madsrdf:citationSource": "Gill, V.K. African American utopian critiques, 2006, viewed online Feb. 13, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 597 (traditional utopian, dystopian, anti-utopian, and counterutopian fiction)"}, "madsrdf:citationSource": "World literature today, summer 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dystopian plays. UF Anti-utopian plays; Cacotopian plays; Dystopias--Drama; Dystopic plays; Negative utopian plays)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Antiutopian fiction"}}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Antiutopian fiction"}}, {"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n26e0ae1732c347ef8f7d1d6cff59c38eb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cacotopian fiction"}}, {"@id": "_:n