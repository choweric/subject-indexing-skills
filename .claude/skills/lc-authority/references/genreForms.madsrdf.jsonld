{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026017", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAutograph verse", "identifiers:lccn": "gf2017026017", "madsrdf:adminMetadata": [{"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b1"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Autograph verse"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026460"}, "madsrdf:hasSource": [{"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b5"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b6"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b7"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b8"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b9"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b10"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b11"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b12"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b13"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b14"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b15"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b16"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b17"}], "madsrdf:hasVariant": [{"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b18"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b21"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b24"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b27"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b30"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Rhyming poems that were written in autograph books."}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autograph verse"}}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 61 (many autograph rhymes give the book's owner advice for the future)"}, "madsrdf:citationSource": "Tucker, E. Children's folklore, \u00a92008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autograph verse. UF Autograph album verse; Autograph poetry; Autograph rhymes. BT Poetry. RT Autograph albums)"}, "madsrdf:citationSource": "LCSH, Jan. 26, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autograph book: A volume for collecting handwritten verse and prose. This written material can be traditional or original, comically irreverent or high-mindedly serious. It can represent very personal feelings or repeat customary formulas. Messages are usually quite brief, perhaps consisting only of a traditional greeting phrase with the writer's signature ... Autograph book inscriptions also may comment humorously and sometimes sardonically about such concerns as schoolwork and boy-girl relationships. Though writers still stress the importance of friendships, twentieth-century autograph verse is often comically insulting. Inscriptions may be preserved in albums designed especially for the purpose. Today, school year-books, produced even for elementary schools, are designed to accommodate autographed sentiments from one's classmates)"}, "madsrdf:citationSource": "Folklore : an encyclopedia of beliefs, customs, tales, music, and art, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. ix (The custom among American children of writing sayings and verse for memory's sake in each other's autograph albums goes on) pp. x-xi (The albums began to be popular in the early nineteenth century and became more and more so, until in the eighteen-seventies and eighties they were a fad; The verses inscribed tended to be sentimental effusions or homely aphorisms, often original rather than quoted, or taken from printed collections of album verse; now, in our day, the album entries ... are much more down-to-earth, cynical, humorous, and the people who write them are younger (usually fifth through ninth grade); verses are a hodgepodge of the sentimental and the mocking, the nostalgic and the impudent; contain awful puns, insults, moral advice, complaints, and compliments, and they deal, if ever so lightly, with basic subjects--love, marriage, personality, school, success)"}, "madsrdf:citationSource": "74002456: Morrison, L. Best wishes, amen : a new collection of autograph verses, \u00a91974:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autograph album rimes: Verses, preferably original, were written in personal blank books called albums by relatives, acquaintances, and schoolmates of the owners of the albums, asserting undying friendship, conveying good wishes, prophesying a bright future, or merely asking to be remembered forever. The rhymes were signed, dated, often decorated elaborately with floral designs and calligraphic flourishes and paraphs, and the residence of the writer was usually given)"}, "madsrdf:citationSource": "Funk & Wagnall's standard dictionary of folklore, mythology, and legend, \u00a91949", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(autograph album rhymes. UF autograph rhymes. BT written poetry. RT autograph albums)"}, "madsrdf:citationSource": "American Folklore Society ethnographic thesaurus, via LC Linked Data Service website, Jan. 26, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 87 (Autograph verse offers sage advice, or flippant advice, about the same things with which the commencement speaker will fill his allotted hour. Love and its concomitants--marriage and children--are the bases on which most of the verse is grounded)"}, "madsrdf:citationSource": "Allison, L. Traditional verse from autograph books, in Hoosier folklore, Dec. 1949, viewed via JSTOR, Jan. 26, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"an autograph book is meant to be a keepsake. They were customarily filled with rhymes and memorable sayings, each signer choosing a page and trying to come up with a poem that no one else had used. Autograph books' popularity has declined in recent years, but you can still purchase one for graduation or your next trip to a Disney theme park, and there is even a book of autograph rhymes if you haven't had a chance to memorize anything beyond \"Roses are red, violets are blue...\")"}, "madsrdf:citationSource": "\"When this you see, remember me\"--an autograph book from nineteenth-century Texas, via Baylor University The Texas Collection online, Jan. 26, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "2003051987: It rained all day that night : autograph album verses and inscriptions, 2003.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "bk. jkt. (verses shared, passed along, and written down by young graduates, sweethearts, and friends for the past forty years; for signing autograph books and yearbooks) p. 3 (Roses are red, Violets are blue, God made me pretty, But what happened to you?) p. 106 (If your husband is thirsty, And wants a drink, Take him to the kitchen, And show him the sink) p. 147 (Remember Grant, Remember Lee, The heck with them, Remember me)"}, "madsrdf:citationSource": "Work cat.: 89082520: Morrison, L. Yours till Niagara Falls : a book of autograph verses, \u00a91990:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fifty years ago a Salt Lake City schoolteacher, Marguerite Ivins Wilson, studied the rhymes Utah children wrote in their classmates' autograph books. She concluded that the rhymes reflected \"both the spirit of the age in which they have been produced and the attitudes of the children\" who wrote them. ... Wilson found that \"In general, the same types of rhymes were reported by all the children, and it seems that the variations in them are due more to individual attempts at originality than to anything else.\" Girls submitted most of the rhymes, Wilson said, but that was expected. \"Boys do write in the autograph books, although not as much as the girls, but for a twelve-year old boy to own a book and carry it around to be signed would mark him as a 'sissy' in most groups. ... Most of the verses which they do write are flippant and not particularly flattering,\" such as: Roses are red, Violets are blue, You like Miss________, So phooey to you. ... An amusing category of verses provided advice on marriage, husbands, and children. A two-liner popular among all children was: When you are married and have some twins, Call on me for some safety pins (or, alternatively, Don't call on me for safety pins).)"}, "madsrdf:citationSource": "Murphy, M.B. Rhymes filled children's autograph books, via Utah history to go website, viewed on Jan. 26, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b16", "@type": "madsrdf:Source", "madsrdf:citationSource": "84090501: Forget-me-not : a collection of autograph verses, 1880s-1980s, \u00a91984.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 181-182 (album rhymes and sayings; album verse; autograph rhymes; autograph album rhymes)"}, "madsrdf:citationSource": "60011536: Morrison, L. Remember me when this you see : a new collection of autograph verses, \u00a91961:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autograph album rhymes"}}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autograph album rhymes"}}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autograph poetry"}}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autograph poetry"}}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autograph rhymes"}}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autograph rhymes"}}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autograph book rhymes"}}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autograph book rhymes"}}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Album verse (Autograph verse)"}}, {"@id": "_:n4165835b05b7447c9b9a0dc6cb2a5c18b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Album verse (Autograph verse)"}}], "@id": "/authorities/genreForms/gf2017026017"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026018", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSports poetry", "identifiers:lccn": "gf2017026018", "madsrdf:adminMetadata": [{"@id": "_:nc3c39beba8ba410aa78b7f555755a802b1"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sports poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc3c39beba8ba410aa78b7f555755a802b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nc3c39beba8ba410aa78b7f555755a802b5"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b6"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b7"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b8"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b9"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b10"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b11"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b12"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b13"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b14"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b15"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b16"}], "madsrdf:hasVariant": {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b17"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sports poetry"}}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(4 titles with \"sports poetry\" in them; 22 titles with \"sports poems\" in them; 1 title with \"sports verse\" in it; 10 titles with \"sporting verse\" in them; 1 title with \"sporting verses\" in it; 3 titles with \"sporting poems\" in them; 4 titles with \"sporting poetry\" in them)"}, "madsrdf:citationSource": "OCLC, Jan. 26, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "31010776: Anthology of sporting verse, 1930.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Not just a game : an anthology of sporting poems, 2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "86155926: We are the champions : a collection of sporting verse, 1986.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "94043364: Opening days : sports poems, \u00a91996.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "2014945665: Raisor, P. Headhunting and other sports poems, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Morrison, L. Way to go! : sports poems, \u00a92001.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "87024384: American sports poems, \u00a91988.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "00050938: Motion : American sports poems, 2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Croft, A. Sports poetry, 2003.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "2007023798: I hope I don't strike out! and other funny sports poems, \u00a92008.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b16", "@type": "madsrdf:Source", "madsrdf:citationSource": "2007011433: Hamblin, R.W. Keeping score : sports poems for every season, \u00a92007.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc3c39beba8ba410aa78b7f555755a802b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sporting poetry"}}, {"@id": "_:nc3c39beba8ba410aa78b7f555755a802b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sporting poetry"}}], "@id": "/authorities/genreForms/gf2017026018"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026019", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFatwas", "identifiers:lccn": "gf2017026019", "madsrdf:adminMetadata": [{"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b1"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fatwas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026351"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026026"}], "madsrdf:hasSource": [{"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b5"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b6"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b7"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b8"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b9"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b10"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b11"}], "madsrdf:hasVariant": {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fatwas"}}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A fatw\u0101 is an Islamic legal pronouncement, issued by an expert in religious law (mufti), pertaining to a specific issue, usually at the request of an individual or judge to resolve an issue where Islamic jurisprudence (fiqh), is unclear; We might compare a fatw\u0101 to the legal ruling of a high court or the Supreme Court, depending on the authority of the mufti behind it. However, a fatw\u0101 is not binding as is the verdict of the secular courts; while correct and applicable to all members of the Muslim faith, the fatw\u0101 is optional for the individual to respect or not)"}, "madsrdf:citationSource": "What is a fatwa?, via Islamic Supreme Council of America website, viewed Jan. 26, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fatwa: A ruling on a point of Islamic law given by a recognized authority)"}, "madsrdf:citationSource": "Oxford dictionaries website, Jan. 26, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fatwa. Authoritative legal opinion given by a mufti (legal scholar) in response to a question posed by an individual or a court of law. A fatwa is typically requested in cases not covered by the fiqh literature and is neither binding nor enforceable. Its authority is based on the mufti's education and status within the community. If the inquirer is not persuaded by the fatwa, he is free to go to another mufti and obtain another opinion; but once he finds a convincing opinion, he should obey it. Theoretically, muftis should be capable of exercising legal reasoning independently of schools of law (ijtihad), although followers of tradition (muqallids) are also allowed to issue fatwas. Historically, fatwas were independent of the judicial system, although some muftis were officially attached to various courts. In the Ottoman and Mughal political systems, the chief mufti was designated shaykh al-Islam. Other muftis were appointed to positions as market inspectors, guardians of public morals, and advisers to government on religious affairs. Under colonial rule, madrasas took over the role of religious guides, and special institutions were established to issue fatwas. In modern times, print and electronic media have reinforced the role and impact of fatwas by making them instantly available to the public. Present-day Muslim states have tried to control fatwas through official consultative/advisory organizations within religious ministries.)"}, "madsrdf:citationSource": "Oxford Islamic studies online, Jan. 26, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fatwa: a legal opinion or decree handed down by an Islamic religious leader)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Jan. 26, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection of the author's fatwas)"}, "madsrdf:citationSource": "Work cat.: Ibn Ghu\u1e63\u016bn, \u1e62\u0101li\u1e25 ibn \u02bbAl\u012b. Fatwas. Thamar al-ghu\u1e63\u016bn min fat\u0101w\u00e1 al-shaykh \u1e62\u0101li\u1e25 ibn \u02bbAl\u012b ibn Ghu\u1e63\u016bn, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fatwas. UF Fat\u0101w\u00e1; Fatwas--Law and legislation. BT Advisory opinions (Islamic law); Islamic law--Sources)"}, "madsrdf:citationSource": "LCSH, Jan. 26, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fatwa. Islamic legal opinion. Issued by a mufti, a fatwa determines the legal category of a specific case, as well as the appropriate course of action. It is not legally binding, but carries the weight of the cited authorities as well as precedent reasoning and opinion. The mufti must be a person of integrity, and have thorough knowledge of the religious law (sharia), that is to say, he must be a competent jurist, one skilled in fiqh ('jurisprudence'). Fatwas were commonly sought by qadis as well as private individuals, to aid in resolving disputes.)"}, "madsrdf:citationSource": "The Oxford dictionary of the Middle Ages, 2010, via Oxford reference online, Jan. 26, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fat\u0101w\u00e1"}}, {"@id": "_:n6a310d80c8994b3f8c9d48d28b3a4c79b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fat\u0101w\u00e1"}}], "@id": "/authorities/genreForms/gf2017026019"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026020", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aComplaints (Poetry)", "identifiers:lccn": "gf2017026020", "madsrdf:adminMetadata": [{"@id": "_:n56a5c851727040f58975448998182feab1"}, {"@id": "_:n56a5c851727040f58975448998182feab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Complaints (Poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n56a5c851727040f58975448998182feab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422"}, "madsrdf:hasSource": [{"@id": "_:n56a5c851727040f58975448998182feab5"}, {"@id": "_:n56a5c851727040f58975448998182feab6"}, {"@id": "_:n56a5c851727040f58975448998182feab7"}, {"@id": "_:n56a5c851727040f58975448998182feab8"}, {"@id": "_:n56a5c851727040f58975448998182feab9"}, {"@id": "_:n56a5c851727040f58975448998182feab10"}, {"@id": "_:n56a5c851727040f58975448998182feab11"}, {"@id": "_:n56a5c851727040f58975448998182feab12"}, {"@id": "_:n56a5c851727040f58975448998182feab13"}], "madsrdf:hasVariant": {"@id": "_:n56a5c851727040f58975448998182feab14"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry that bemoans lost or unrequited love, personal misfortune, or the state of the world."}, {"@id": "_:n56a5c851727040f58975448998182feab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n56a5c851727040f58975448998182feab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n56a5c851727040f58975448998182feab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Complaints (Poetry)"}}, {"@id": "_:n56a5c851727040f58975448998182feab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anthology of four Middle English complaints and debate poems) p. 17 (this volume participates in anthologizing love complaints, debates, and visions with a Chaucerian flavor) contents (The boke of Cupide, god of love (John Clanvowe) -- A complaynte of a lovers lyfe (John Lydgate) -- The quare of jelusy (Anonymous) -- La belle dame sans mercy (Alain Charter, translator Richard Roos))"}, "madsrdf:citationSource": "Work cat.: Chaucerian dream visions and complaints, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n56a5c851727040f58975448998182feab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Complaint: A plaintive poem; frequently the complaint of a lover to his inconstant, unresponsive or exacting mistress. For example, Surrey's Complaint by Night of the Lover not Beloved. The theme or burden of complaint became a convention, and finally a clich\u00e9, of a great deal of love poetry, but is was still being worked successfully in the middle of the 17th century by poets like Thomas Carew and Thomas Stanley. There are other types of complaint; most of them lament the state of the world, the vicissitudes of Fortune and the poet's personal griefs ... There are a number of curiosities in this genre. For instance, Sire David Lyndsay's poem The Dreme, an allegorical lament on the misgovernment of the country, and the same poet's Complaynt to the King, and his Testament and Complaynt of Our Soverane Lordis Papyngo--both of similar import and tone as The Dreme)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms, 1982", "madsrdf:citationStatus": "found"}, {"@id": "_:n56a5c851727040f58975448998182feab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Complaint. Usually, it is a dramatic, highly emotional lament that reveals the complainant's specific grievances against a public or private injustice; three strains of complaint are evident in the Middle Ages and Renaissance: satiric complaints; didactic complaints; and lover's complaints)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012", "madsrdf:citationStatus": "found"}, {"@id": "_:n56a5c851727040f58975448998182feab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Complaint poetry. BT Poetry)"}, "madsrdf:citationSource": "LCSH, Jan. 27, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n56a5c851727040f58975448998182feab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(complaint: A kind of lyric poem common from the Middle Ages to the 17th century, in which the speaker bewails either the cruelty of a faithless lover or the advent of some misfortune like poverty or exile. This kind of monologue became highly conventional in love poetry; Chaucer wrote serious complaints, as did Villon, Surrey, and Spenser)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n56a5c851727040f58975448998182feab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Complaint: a kind of lament, often about the state of the world as well as personal misfortune)"}, "madsrdf:citationSource": "Ruse, C. The Cassell dictionary of literary and language terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:n56a5c851727040f58975448998182feab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Complaint: A lyric poem, common in Renaissance, which bewails the misery of the speaker, who is often someone whose beloved is unresponsive or absent. Occasionally, however, a complaint may be humorous, as in \"The Complaint of Chaucer to his Empty Purse\")"}, "madsrdf:citationSource": "Beckson, K. Literary terms, 1989", "madsrdf:citationStatus": "found"}, {"@id": "_:n56a5c851727040f58975448998182feab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Complaint: A type of poem in which the speaker laments his or her unhappy condition or bemoans the general condition of life. A popular feature of medieval or Renaissance poetry, the complaint might involve a lamentation for a lost or unrequited love, as in Sir Thomas Wyatt's \"They Flee From Me\" and the Earl of Surrey's \"Complaint of a Lover's Rebuked,\" or it might represent a cry against \"the wretched world\" as the seat of \"filth and fowle iniquite,\" as in Edmund Spenser's Complaints (1591). Another popular form in this period was the narrative complaint, in which historical or mythological figures recounted the twist of fortune which lead them to a tragic end ... Another example of the form is \"A Lover's Complaint,\" notable because it was attributed to Shakespeare in his lifetime and included in the first edition of his sonnets (1609))"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, \u00a91999", "madsrdf:citationStatus": "found"}, {"@id": "_:n56a5c851727040f58975448998182feab13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Complaint: A lyric poem in the Middle Ages and Renaissance, in which the poet (1) laments the unresponsiveness of his mistress, as in Surrey's \"A Complaint by Night of the Lover Not Beloved\"; (2) bemoans his unhappy lot and seeks to remedy it, as in \"The Complaint of Chaucer to his Empty Purse\"; (3) regrets the sorry state of the world, as in Spenser's Complaints. In a complaint, which usually takes the form of a monologue, the poet commonly explains his sad mood, describes the causes of it, discusses possible remedies, or appeals to some lady or divinity for help from his distress)"}, "madsrdf:citationSource": "Harmon. W. A handbook to literature, \u00a92006", "madsrdf:citationStatus": "found"}, {"@id": "_:n56a5c851727040f58975448998182feab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n56a5c851727040f58975448998182feab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Complaint poetry"}}, {"@id": "_:n56a5c851727040f58975448998182feab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Complaint poetry"}}], "@id": "/authorities/genreForms/gf2017026020"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026021", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPost-rock music", "identifiers:lccn": "gf2017026021", "madsrdf:adminMetadata": [{"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb1"}, {"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Post-rock music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026632"}, "madsrdf:hasSource": [{"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb5"}, {"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb6"}, {"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Post-rock music"}}, {"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sigur R\u00f3s (Musical group). \u00c1g\u00e6tis byrjun, p2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Mogwai (Musical group). Hardcore will never die, but you will, p2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n47c4714f88e7433ba97ce05aaedc54dcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Post-Rock (Post-rock is a highly experimental form of indie rock whose description sounds more like a jigsaw puzzle than a subgenre of music. Post-rockers take traditional rock sounds and foundations--guitar, bass, and drums--and mix them up in new creative ways to make groundbreaking new sounds. This so-called rock \"instrumentation\" means that post-rockers use all of the ingredients of traditional rock bands, but they create full sweeping chord progressions, rhythms, melodies, and harmonies. In other words, post-rockers are minimalists that create mostly instrumental pieces employing less commonly used instruments such as oboes, cellos, the piano, synthesizers, and such in their rock compositions. Post-rockers' music is actually not typically similar in sound to indie rock, but it is categorized as such for its experimental and DIY (Do-It-Yourself) nature. Post-rock music is also usually ambient and can also include acts from other subgenres such as shoegazing, space rock, art rock, and progressive rock movements. Post-rockers were also among the first acts to combine electronically generated and digitally made music with traditional rock instruments. Notable post-rock acts include Slint, Talk Talk, Flying Saucer Attack, Mogwai, Stereolab, Godspeed You Black Emperor, Cul de Sac, Tortoise, the beautiful, ethereal arrangments of the Rachel's, and Sigur R\u00f3s)"}, "madsrdf:citationSource": "Smith, K.L. Encyclopedia of indie rock, 2008:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026021"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026022", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSound art", "identifiers:lccn": "gf2017026022", "madsrdf:adminMetadata": [{"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b1"}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sound art"}, "madsrdf:elementList": {"@list": [{"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027218"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027107"}, "madsrdf:hasSource": [{"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b5"}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b6"}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b7"}], "madsrdf:hasVariant": [{"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b8"}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b11"}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-11-12T13:50:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sound art"}}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Sound art (A term encompassing a variety of art forms that utilize sound, or comment on auditory cultures. Sound artworks tend to subvert, combine, or expand upon entrenched practices in music, the visual arts, and poetry. As a relatively new term that may apply to a multitude of divergent practices, sound art has no fixed or agreed-upon definition. Sound installation, Sound sculpture, Performance art, Soundscape composition, soundwalking, field recording, circuit bending, sound design, interactive sonic games, concrete poetry, conceptual art, and creative experiments with listening and audio media may technically constitute sound art. So may experimental electronic music, ambient music, noise music, and collage-based music. Some doubt the usefulness of \"sound art\" as a blanket term for experimental artistic forays, to which more precise designations might be more appropriate. But the broader scope of \"sound art\" accounts for the fact that multiple sound artists share certain aesthetic problems)"}, "madsrdf:citationSource": "Grove music online, viewed August 20, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sound art is an artistic discipline in which sound is utilised as a medium. Like many genres of contemporary art, sound art is interdisciplinary in nature, or takes on hybrid forms. Sound art can engage with subjects such as acoustics, psychoacoustics, electronics, noise music, audio media, found or environmental sound, explorations of the human body, sculpture, film or video and an ever-expanding set of subjects that are part of the current discourse of contemporary art)"}, "madsrdf:citationSource": "Wikipedia, viewed August 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sound art (general term for works, particularly contemporary works, that integrate sound and the visual arts; UF ars acustica, audio art)"}, "madsrdf:citationSource": "Art and architecture thesaurus WWW site, viewed Aug. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Audio art"}}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Audio art"}}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sound art installations"}}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sound art installations"}}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ars acustica"}}, {"@id": "_:n77f6a02e25614a9c8abde8e7a3a3b459b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ars acustica"}}], "@id": "/authorities/genreForms/gf2017026022"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026023", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTwist songs", "identifiers:lccn": "gf2017026023", "madsrdf:adminMetadata": [{"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab1"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Twist songs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab5"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab6"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab7"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab8"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab9"}], "madsrdf:hasVariant": {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Twist songs"}}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Twist (The twist ushered in the era of the rock dance-song, with its fast, pounding, evenly stressed beat in 4/4 meter)"}, "madsrdf:citationSource": "Grove music online, July 24, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Google search, July 24, 2016 (\"Twist songs\"; about 173 results)", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Twist (A plethora of twisting songs have been released... There were even twisting albums released)"}, "madsrdf:citationSource": "Encylopedia of popular music online, July 24, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Twist (Dance) (List of twist hits on Billboard) under List of twist songs (\"The following songs... are associated with the dance 'The Twist' and the associated cultural craze\")"}, "madsrdf:citationSource": "Wikipedia, viewed July 24, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 174 (While many were twisting, others were copying and imitating. Trying to cash in on the fad, several other twist songs appeared between 1960 and 1962)"}, "madsrdf:citationSource": "Studwell, William E. The classic rock and roll reader, 2014, viewed in Google Books, July 24, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Twisting songs"}}, {"@id": "_:n2cf29c5679154f748ff4c6cf2b06bc6ab11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Twisting songs"}}], "@id": "/authorities/genreForms/gf2017026023"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026024", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aYoiks", "identifiers:lccn": "gf2017026024", "madsrdf:adminMetadata": [{"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb1"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Yoiks"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, "madsrdf:hasSource": [{"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb5"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb6"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb7"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb8"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb9"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb10"}], "madsrdf:hasVariant": [{"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb11"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb14"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb17"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb20"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb23"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-03T13:39:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yoiks"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(joik; English yoik, pl. yoiks)"}, "madsrdf:citationSource": "Work cat.: Internasjonale forskningskongressen om samisk joik (1st : 1990 : Universitet i Troms\u00f8). Joikens frie lyder n\u00e5r lengre enn mange ord, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under S\u00e1mi [Saami] music (\"Johannes Schefferus was one of the first influential writers to study S\u00e1mi culture and music, and his Lapponia of 1673 concentrated on the role of juoi'gat in traditional shamanic rituals. Ethnomusicological study of juoi'gat began in the early 20th century, with Armas Launis the first researcher actively to collect juoigos melodies. He was followed by Karl Tir\u00e9n, who recorded juoigos melodies, transcribed them and categorized them into different types and regions... Juoi'gat -- to joik, joiking, joik: pronounced 'yoik' -- (mainly solo singing without instrumental accompaniment) has since the 1970s been the sole form of traditional musical expression. Newer musical styles based on traditional juoi'gat and retaining some of its features are also found (see below)... Syllables and particles form the basis and often the entire text of a juoigos melody. In earlier times they were thought to be magical interjections and were believed by the shaman to derive from the language of the spirits. There are many ways in which the texts could be made up from now 'meaningless' syllables and particles such as no, na, lo, la etc. In many songs only the name of the person or animal concerned is given... But other words or whole phrases may be woven in or a coherent syntactical text such as a long tale may be used... The 'S\u00e1mi way' of singing relates to the vocal technique of the songs and to their structure, which is distinguished by its formal construction, melodic contours and rhythm, and by the way the texts are arranged. The peculiar Samish vocal timbre is marked by frequent use of glottal stops... and, above all, by ornamenting the melody with appoggiaturas, terminal notes and double glides... A juoigos is composed from a definite sequence of two, four, six or more phrases equal in length, but melodically distinct: the melody is repeated at least once, usually three to six times, frequently with added variants. During performance an orderly system of repetition is established to build what Tir\u00e9n has described as a 'chain song'. Repetitions or variants may contain pitch-changes up to a fifth throughout a juoigos. This refers to a joik-singer's musical experience and his or her personal identification with the joiked theme. Most melodies are based on anhemitonic pentatonic modes and show a preference for disjunct movement A small category of pentatonic melodies contains clearly emphasized and definitely sounded semitones.\")"}, "madsrdf:citationSource": "Grove music online, July 24, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "art. Finland (juoigos; Finnish joiku)"}, "madsrdf:citationSource": "New Harvard dict. of music:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(yoik: 1.17 million results; joik: 1.24 million results; also joiking, yoiking)"}, "madsrdf:citationSource": "Google search, July 24, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "art. Samish music (juoigos; Eng. joik; jojk; yoik)"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Joik (also spelled yoik))"}, "madsrdf:citationSource": "Wikipedia, viewed July 24, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Joiking"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Joiking"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jojks"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jojks"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Joiks"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Joiks"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Juoi'gat"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Juoi'gat"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Juoigos"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Juoigos"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yoiking"}}, {"@id": "_:n2b8dd4e976c54cdd8376c72aae7bc9bfb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yoiking"}}], "@id": "/authorities/genreForms/gf2017026024"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026025", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVillancicos (Music)", "identifiers:lccn": "gf2017026025", "madsrdf:adminMetadata": [{"@id": "_:ncf646e4f6e2a4dfe803e4de2a0a8d742b1"}, {"@id": "_:ncf646e4f6e2a4dfe803e4de2a0a8d742b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Villancicos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncf646e4f6e2a4dfe803e4de2a0a8d742b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026984"}, "madsrdf:hasSource": {"@id": "_:ncf646e4f6e2a4dfe803e4de2a0a8d742b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Spanish-language part songs from the 15th-19th centuries that are based on the villancico poetic form."}, {"@id": "_:ncf646e4f6e2a4dfe803e4de2a0a8d742b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ncf646e4f6e2a4dfe803e4de2a0a8d742b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-03T13:39:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncf646e4f6e2a4dfe803e4de2a0a8d742b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Villancicos (Music)"}}, {"@id": "_:ncf646e4f6e2a4dfe803e4de2a0a8d742b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Villancico. A term first applied in the late 15th century to a Spanish vernacular musical and poetic form consisting of several stanzas (coplas) framed by a refrain (estribillo) at the beginning and end, giving an overall ABA structure. The number of stanzas varied, as did the number of times the estribillo was repeated between stanzas in performance. Originally derived from a medieval dance lyric of the virelai or ballata type and associated with rustic or popular themes, the villancico was extensively cultivated in secular polyphonic music of the late 15th century and the 16th. In the second half of the 16th century devotional and religious themes gained in importance and the form became used increasingly for sacred compositions in the vernacular which were introduced into the liturgy on feast days. In the 17th century it became more important than the Latin motet, and although its artistic quality rapidly declined in the 18th and 19th centuries it remained popular in both Spain and Latin America. Since then 'villancico' has come to mean simply 'Christmas carol')"}, "madsrdf:citationSource": "Grove music online, July 24, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026025"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026026", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPatriotic music", "identifiers:lccn": "gf2017026026", "madsrdf:adminMetadata": [{"@id": "_:n244e51ff4d25402dbfed85ee8404090cb1"}, {"@id": "_:n244e51ff4d25402dbfed85ee8404090cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Patriotic music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n244e51ff4d25402dbfed85ee8404090cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026027"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026028"}], "madsrdf:hasSource": {"@id": "_:n244e51ff4d25402dbfed85ee8404090cb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n244e51ff4d25402dbfed85ee8404090cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n244e51ff4d25402dbfed85ee8404090cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-21T12:35:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n244e51ff4d25402dbfed85ee8404090cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Patriotic music"}}, {"@id": "_:n244e51ff4d25402dbfed85ee8404090cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Patriotic music; music that expresses devotion to the nation... Once established, patriotic music can become a site for rehearsal, reinterpretation, and even protest by individual performers or as mass singing. Patriotic songs often figure in social rituals--military pageantry, funerals, concerts, legislative sessions, graduations, and so on-- and their performance traditions and even musical details may shift over time in both new arrangements and the oral tradition.)"}, "madsrdf:citationSource": "Grove music online, viewed November 16, 2015", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026026"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026027", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aState songs", "identifiers:lccn": "gf2017026027", "madsrdf:adminMetadata": [{"@id": "_:n5cc741bd58d54b3592768efb83a69586b1"}, {"@id": "_:n5cc741bd58d54b3592768efb83a69586b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "State songs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5cc741bd58d54b3592768efb83a69586b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026026"}], "madsrdf:hasSource": [{"@id": "_:n5cc741bd58d54b3592768efb83a69586b5"}, {"@id": "_:n5cc741bd58d54b3592768efb83a69586b6"}, {"@id": "_:n5cc741bd58d54b3592768efb83a69586b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5cc741bd58d54b3592768efb83a69586b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5cc741bd58d54b3592768efb83a69586b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-05-14T09:20:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5cc741bd58d54b3592768efb83a69586b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "State songs"}}, {"@id": "_:n5cc741bd58d54b3592768efb83a69586b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under List of U.S. state songs (Forty-nine of the fifty U.S. states that make up the United States of America have one or more state songs, which are selected by each state legislature, and/or state governor, as a symbol (or emblem) of that particular U.S. state...)"}, "madsrdf:citationSource": "Wikipedia, viewed November 16, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cc741bd58d54b3592768efb83a69586b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "State songs of America, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cc741bd58d54b3592768efb83a69586b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (Fifty songs--fifty states : a song for every state in the U.S.A)"}, "madsrdf:citationSource": "Fifty songs--fifty states, \u00a91971 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026027"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026028", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNational anthems", "identifiers:lccn": "gf2017026028", "madsrdf:adminMetadata": [{"@id": "_:na004109f7ccf42c780835500a0eb4dd5b1"}, {"@id": "_:na004109f7ccf42c780835500a0eb4dd5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "National anthems"}, "madsrdf:elementList": {"@list": [{"@id": "_:na004109f7ccf42c780835500a0eb4dd5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026026"}, "madsrdf:hasSource": [{"@id": "_:na004109f7ccf42c780835500a0eb4dd5b5"}, {"@id": "_:na004109f7ccf42c780835500a0eb4dd5b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions, with or without text, that are recognized as national anthems by a government or by convention."}, {"@id": "_:na004109f7ccf42c780835500a0eb4dd5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-21T12:37:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na004109f7ccf42c780835500a0eb4dd5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na004109f7ccf42c780835500a0eb4dd5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "National anthems"}}, {"@id": "_:na004109f7ccf42c780835500a0eb4dd5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(National anthem (also national hymn, national song, etc.) is a generally patriotic musical composition that evokes and eulogizes the history, traditions and struggles of its people, recognized either by a nations' government as the official national song, or by convention through use by the people)"}, "madsrdf:citationSource": "Wikipedia, viewed June 19, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na004109f7ccf42c780835500a0eb4dd5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(National anthems. Hymns, marches, songs or fanfares used as official patriotic symbols)"}, "madsrdf:citationSource": "Grove music online, viewed June 19, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026028"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026029", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKonkoma", "identifiers:lccn": "gf2017026029", "madsrdf:adminMetadata": [{"@id": "_:nab6e2f62463d4b6aa6bd94a2bd7266e0b1"}, {"@id": "_:nab6e2f62463d4b6aa6bd94a2bd7266e0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Konkoma"}, "madsrdf:elementList": {"@list": [{"@id": "_:nab6e2f62463d4b6aa6bd94a2bd7266e0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": {"@id": "_:nab6e2f62463d4b6aa6bd94a2bd7266e0b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nab6e2f62463d4b6aa6bd94a2bd7266e0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nab6e2f62463d4b6aa6bd94a2bd7266e0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nab6e2f62463d4b6aa6bd94a2bd7266e0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Konkoma"}}, {"@id": "_:nab6e2f62463d4b6aa6bd94a2bd7266e0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (Konkoma : eine Musikform der Fanti-Jungfischer in den 40er und 50er Jahren (Ghana, Westafrika); page 1-2, etc. (a popular music genre that was popular with the young fishermen (ages 11-20) of the Fante people in Ghana, West Africa in the 1940s and 1950s; also performed at funerals; author considers this form an attempt by the young fisherman to break free of the traditional music which was predominant in rural areas; music is characterized by several non-African elements: marching, the use of uniforms, and the use of a conductor; a konkoma group usually consisted of 20-25 people, including a conductor, 4 drummers, an awasaa player, an adawuranta player, a kew-kew player, and 10-15 singers and clappers.)"}, "madsrdf:citationSource": "Work cat: Sackey, C.K. Konkoma, \u00a91989:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026029"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026030", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJukebox musicals", "identifiers:lccn": "gf2017026030", "madsrdf:adminMetadata": [{"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab1"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jukebox musicals"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026957"}, "madsrdf:hasSource": [{"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab5"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab6"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab7"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab8"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab9"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab10"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab11"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab12"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab13"}], "madsrdf:hasVariant": {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab14"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musicals that use previously released popular songs as their scores."}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jukebox musicals"}}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Andersson, B. Mamma mia! : the musical : based on the songs of ABBA, p1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A jukebox musical is a show that feature a collection of pre-existing pop-songs and toss them into a (typically shallow) storyline. Instead of gambling on new melodies and lyrics, the producers go with name recognition.)"}, "madsrdf:citationSource": "Jukebox musicals : the top ten best \"jukebox musicals\" of all time, via About.com website, Aug. 25, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Holler If Ya Hear Me is the first hip-hop jukebox musical in Broadway history--and possibly the first in theater history--a genre that's been kind to Abba, Frankie Valli and the Four Seasons, Green Day and Fela Kuti.)"}, "madsrdf:citationSource": "Weingarten, C.R. Hip-hop's first jukebox musical debuts, in Rolling stone, June 9, 2014, viewed online Aug. 25, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Jersey boys : original Broadway cast recording, p2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jukebox Musicals. In 2001, Mamma Mia! took the music of disco royalty ABBA, wound it around a spun-sugar plot--and audiences packed the aisles. A parade of songbook shows followed, including Lennon, Good Vibrations, Jersey Boys, Rock of Ages, Come Fly Away, American Idiot and Million Dollar Quartet. Of course, not every juke-boxer can match the appeal of MM!, but they're a no-brainer for investor-fans of the music being served up. Jukebox tuners have put revues on life support.)"}, "madsrdf:citationSource": "Kaye, K. Broadway.com at 10 : the 10 biggest Broadway trends of the decade, via Broadway.com website, Aug. 25, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(According to everyone's favorite online encyclopedia, \"A jukebox musical is a stage or film musical that uses previously released popular songs as its musical score.\" I disagree. ... Here's my definition: \"A jukebox musical is an original stage musical not based on a film that uses previously released popular songs that have no direct relation to the story as its musical score.\")"}, "madsrdf:citationSource": "Davenport, K. The definition of a jukebox musical, via The producer's perspective website, Aug. 25, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Musicals > Find a show by type > Jukebox (jukebox musicals, or musicals compiling and incorporating popular music of a time period or the music of a specific artist or group; examples: Beautiful: The Carole King Musical; The Boy from Oz; Jersey Boys; Let it Be; Mamma Mia!; Moving Out; Priscilla, Queen of the Desert)"}, "madsrdf:citationSource": "Broadway musical home website, Aug. 25, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"jukebox musical\": 172,000 results; juke box musical: 11,200 results; \"jukebox musicals\": 29,100 results; \"juke box musicals\": 1,710 results)"}, "madsrdf:citationSource": "Google search, Aug. 25, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Peters, T. What does it take to make a hit juke box musical?, via London Theatre Direct website, 04 Mar. 2015, viewed online Aug. 25, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jukebox tuners (Musicals)"}}, {"@id": "_:n2b28fc0810da4ffc8d5a04eea848aaaab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jukebox tuners (Musicals)"}}], "@id": "/authorities/genreForms/gf2017026030"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026032", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCampus fiction", "identifiers:lccn": "gf2017026032", "madsrdf:adminMetadata": [{"@id": "_:n4db926e7f6af475985f9062761cd9823b1"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Campus fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4db926e7f6af475985f9062761cd9823b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n4db926e7f6af475985f9062761cd9823b5"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b6"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b7"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b8"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b9"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b10"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b11"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b12"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b13"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b14"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b15"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b16"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b17"}], "madsrdf:hasVariant": [{"@id": "_:n4db926e7f6af475985f9062761cd9823b18"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b21"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that is set on and around a college or university campus and focuses on the lives and interactions of students, faculty, administrators, and staff."}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-02-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:34:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Campus fiction"}}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(College stories. UF Universities and colleges--Fiction; Universities and colleges--Juvenile fiction. BT Fiction)"}, "madsrdf:citationSource": "LCSH, Feb. 5, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(campus novel: A novel, usually comic or satirical, in which the action is set within the enclosed world of a university (or similar seat of learning) and highlights the follies of academic life. The campus novel in the usual modern sense dates from the 1950s)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "introd. (The campus novel is a mainly Anglo-American literary phenomenon. The first classic example was American, Mary McCarthy's The Groves of Academe (1952), followed in England by Kingsley Amis's Lucky Jim in 1954)"}, "madsrdf:citationSource": "Work cat.: Lodge, D. The campus trilogy, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (a new sub-genre in contemporary Spanish peninsular literature, the Spanish campus novel; the texts in question build upon the British and American campus novel tradition while inflecting it with issues, styles and themes particular to Spanish literature; the Anglo academic novel and established essential characteristics of the majority of the novels: campus location, academic protagonist, satire and humor, job-insecurity, political correctness and departmental politics)"}, "madsrdf:citationSource": "Moore-Martinez, P. The emergence of the Spanish peninsular campus novel, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kramer, J.E. The American college novel : an annotated bibliography, 1981.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "University fiction, 1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ant\u00e9ne, P. Campus novel variations : a comparative study of an Anglo-American genre, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Campus Novel. Though \"campus fiction\" often is used today to describe imaginative literature set in British universities, the term's origins are American. Thus its growing presence against the native descriptor \"university novels\" signifies changes over time within British academic life -- and in novelists' responses to these changes. Three features mark fictional accounts of British university life. First, conservative comedy is the dominant mode. Second, some institutions are massively overrepresented relative to staff and student numbers. Thus 145 out of 204 novels published between 1945 and 1988 were set in just two smallish universities -- Oxford (principally) and Cambridge. Third, most novels were written by English graduates, and many authors themselves taught in university English departments)"}, "madsrdf:citationSource": "The encyclopedia of twentieth-century fiction, 2011, via Blackwell reference online, Feb. 5, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The favorite tropes of the academic novel are easily listed. The college is located in New York or Pennsylvania or is nestled in a forest in New England. When a university appears in the novel, it is massive, impersonal, and midwestern. Administrators, especially the president, know how to shake hands, make small talk, and raise funds. Professors come in one of three guises: the daft, otherworldly scholar; the irresponsible (and often lecherous) failure; and the venal, back-stabbing careerist. Students are clean-cut upper-class men, working-class \"grinds,\" or unclassifiable outcasts. The academic novel's most familiar narrative trope is that of high expectations brought low. Over and over, the genre tells us that American higher education promises much but delivers little; Two of the genre's defining texts, published within two years of each other, establish the tenor of many of the works to follow. Mary McCarthy's The Groves of Academe (1952) and Randall Jarrell's Pictures from an Institution (1954) are pitiless satires of academic life; The genre is treated as the poor cousin of a handful of more distinguished genres: the comic novel, the social novel, the bildungsroman (novel of spiritual awakening), and the Kunstlerroman (novel of artistic awakening). Although the academic novel is distinguished by certain repeated themes and characters and episodes, it is most clearly marked by its setting: An academic novel takes place primarily on a college campus)"}, "madsrdf:citationSource": "The Oxford encyclopedia of American literature, 2004, via Oxford reference online, Feb. 5, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Academic novels as satire : critical studies of an emerging genre, \u00a92007.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Campus fiction is generally described as a novel whose main action occurs in and around the campus of a university. The stories are usually told from the viewpoint of either a student or professor)"}, "madsrdf:citationSource": "Carmel Clay Public Library website, Feb. 5, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b16", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lambertsson Bj\u00f6rk, E. Campus clowns and the canon : David Lodge's campus fiction, 1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b17", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bogen, A. Women's university fiction, 1880-1945, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4db926e7f6af475985f9062761cd9823b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "University fiction (Campus fiction)"}}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "University fiction (Campus fiction)"}}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4db926e7f6af475985f9062761cd9823b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "College fiction"}}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "College fiction"}}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4db926e7f6af475985f9062761cd9823b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Academic fiction (Campus fiction)"}}, {"@id": "_:n4db926e7f6af475985f9062761cd9823b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Academic fiction (Campus fiction)"}}], "@id": "/authorities/genreForms/gf2017026032"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026033", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMumblecore films", "identifiers:lccn": "gf2017026033", "madsrdf:adminMetadata": [{"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db1"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mumblecore films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026250"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026324"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026376"}], "madsrdf:hasSource": [{"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db5"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db6"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db7"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db8"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db9"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db10"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db11"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db12"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Low-budget independent fiction films that feature personal relationships of young adults with realistic scenes, naturalistic acting and dialogue, and minimal action."}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:34:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-02-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mumblecore films"}}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beeswax is a 2009 American mumblecore film written and directed by Andrew Bujalski. The film examines a few days in the life of twins, played by real-life sisters Tilly and Maggie Hatcher)"}, "madsrdf:citationSource": "Wikipedia, Feb. 7, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mumblecore is a subgenre of independent film characterized by naturalistic acting and dialogue (often improvised), low-budget film production, an emphasis on dialogue over plot, and a focus on the personal relationships of people in their 20s and 30s; Naturalism--both in performance and dialogue--is a key feature of almost all mumblecore films)"}, "madsrdf:citationSource": "Wikipedia, Feb. 7, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "credits (writer, director, editor, Andrew Bujalski)"}, "madsrdf:citationSource": "Work cat.: Beeswax, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(To quote David Denby's New Yorker explanation of the genre, \"Mumblecore movies are made by buddies, casual and serious lovers, and networks of friends, and they're about college-educated men and women who aren't driven by ideas or by passions or even by a desire to make their way in the world. Neither rebels nor bohemians, they remain stuck in a limbo of semi-genteel, moderately hip poverty, though some of the films end with a lurch into the working world. The actors (almost always nonprofessionals) rarely say what they mean; a lot of the time, they don't know what they mean. The movies tell stories but they're also a kind of lyrical documentary of American stasis and inarticulateness\")"}, "madsrdf:citationSource": "Renninger, B.J. Bujalski's \"Beeswax\" makes people say \"mumblecore\", via IndieWire website, Aug. 6, 2009, viewed on Feb. 7, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mumblecore films; low-budget indie film; not so much a story as a situation, a milieu, and some characters)"}, "madsrdf:citationSource": "Horton, R. 'Beeswax': a fine example of 'mumblecore' genre, via HeraldNet website, Oct. 30, 2009, viewed on Feb. 7, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The \"mumblecore\" label--used to describe crude-looking improvisation--and hesitation-heavy American independent productions populated almost exclusively by underemployed white creative types--has been applied so often to the films of Andrew Bujalski that it's become all too easy to forget what makes them exceptional; takes as its primary concern something more substantial than just a painstaking naturalism: the uncomfortable intermingling of personal matters with business concerns)"}, "madsrdf:citationSource": "Mercer, B. 'Beeswax': a mumblecore movie at its finest, in The Atlantic, Apr. 9, 2010, viewed online Feb. 7, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mumblecore has a few focuses; first is that they aim to tell small human stories about unique characters with an emphasis on realism. In order to achieve that realism, they need natural dialogue; in some cases, then, the dialogue is ad-libbed. At times, there is so much improvisation that the actors get writing credits)"}, "madsrdf:citationSource": "10 essential mumblecore films, via WhatCulture website, Feb. 7, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mumblecore: a genre of low-budget movie using nonprofessionals to depict mundane postcollege or early adult existence; in filmmaking, a genre of very low-budget productions focused on personal relationships and daily life)"}, "madsrdf:citationSource": "Dictionary.com, Feb. 7, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd59ad3e29a1c4fd9a3e706fc5f033c0db13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mumblecore: a genre of narrative film focusing primarily on the intimate lives of young characters and featuring scenes of ample dialogue and minimal action)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Feb. 7, 2017", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026033"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026034", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnimal fiction", "identifiers:lccn": "gf2017026034", "madsrdf:adminMetadata": [{"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b1"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Animal fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b5"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b6"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b7"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b8"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b9"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b10"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b11"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b12"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction whose main characters are animals that may be anthropomorphized."}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:34:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-02-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Animal fiction"}}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Oswald, L.J. Heroes and victims : the stereotyping of animal characters in children's realistic animal fiction, 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xv (These excerpts from my various books depict the way I think and feel about animals. Each segment was an integral part of the novel in which it appeared)"}, "madsrdf:citationSource": "Work cat.: Michener, J.A. Creatures of the kingdom : stories of animals and nature, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (\"This animal fiction book is written in rhyming verse\")"}, "madsrdf:citationSource": "Kilmer, J. Animal dreams & fantasies, 2011, viewed via Google books, Feb. 14, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Animals (Animal Fiction. Fiction involving animals. Such works may take the viewpoint of animals, in which case they may be classified as xenofiction. Some books portray animals as having human traits (anthropomorphic fiction). Animals are very common characters in children's literature)"}, "madsrdf:citationSource": "Goodreads website, Feb. 14, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kipling, R. Animal stories from Rudyard Kipling, 1938.", "madsrdf:citationStatus": "found"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xii (animal stories; animal novels) p. xiii (animal fiction) p. xiv (animal fiction; animal novels and short stories) p. 2 (Modern animal stories can be divided into three major periods. The Founders of the North American animal story--Jack London, Ernest Thompson Seton, and Charles G. D. Roberts--were active from the 1890s through the 1920s. They portrayed mammals (and sometimes birds) as sensitive, intelligent creatures, and frequently used anthropomorphic language to best express the rich mental lives they attributed to the higher animals; during the middle of the twentieth century, roughly from 1930 into the 1970s, such anthropomorphism fell into disfavor, and most writers of animal stories in this period are categorized by Lori Oswald as \"traditionalists.\" These midcentury authors are careful not to ascribe complex mental states to animals, and they avoid representing any animal's thoughts and feelings as if they were equivalent to those of humans. Few of the animal stories written during this period display an animal rights philosophy, and the dominant view of animals in stories of the era is one of humane animal welfare orthodoxy, at best; in the 1970s the animal rights movement, along with feminism and other liberation philosophies, began to influence the writers of animal stories. Oswald calls this the \"animal rights era,\" linking the animal protection movement to those other liberation movements) p. 4 (the animal story genre)"}, "madsrdf:citationSource": "Hogan, W. Animals in young adult fiction, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (animal characters, symbolic, realistic, or both, to act as analogues by which human predicaments may be presented and clarified) p. 4 (A writer may draw his animals either as abstract 'counters', important only for the general quality they represent, or as real beings evoked with the full force of naturalistic detail. The former manner is often associated with the fable and allegory where the author is not particularly interested in the animal as animal. Usually, in this type of literature an animal is personified, represents an abstract human quality, and is endowed with human speech and ratiocination; In contrast to this style is the mode of representation in which an animal behaves realistically and without any overt interference from the author. This method is clearly based on the biases of fictional realism which demand that humans, animals, as well as inanimate objects, be evoked accurately and as they really are)"}, "madsrdf:citationSource": "Asker, D.B.D. The modern bestiary : animal fiction from Hardy to Orwell, 1978:", "madsrdf:citationStatus": "found"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "The best animal stories of science fiction and fantasy, \u00a91979.", "madsrdf:citationStatus": "found"}, {"@id": "_:n253f5a899c2544a99321dd8d2ff14a51b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Animal Fiction (The Animal Genre: Animal stories appear in a variety of forms but all include one or more animals as the focus of the story; It is not surprising that animal stories appeal to children. Many wish for a pet - something that belongs to them, and something they can love; Pets allow children to feel clever, protective, and nurturing; Animals help children compensate for their essentially powerless position; Very young children do not see animals as \"other\"; they believe that animals have human characteristics; Some of the most well-known picturebooks focus on animal protagonists - for example, Babar, Curious George, Peter Rabbit, and Paddington Bear; Authors use animal characters because they can convey ideas by analogy, ideas which have greater impact than if child characters are used. Like the adventure story, there are different types of animal stories: Animal fable; Pet stories; Animal fantasy; Real animals) Recommended Animal Fiction (examples listed include: Watership Down; Fantastic Mr. Fox; The Tale of Despereaux; The Black Stallion; The Wind in the Willows; The Jungle Book; The Voyage of Doctor Dolittle; The Call of the Wild; White Fang; The Yearling; Bambi; Black Beauty; Stuart Little; Charlotte's Web)"}, "madsrdf:citationSource": "Children's literature classics website, Feb. 14, 2017:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026034"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026035", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWar posters", "identifiers:lccn": "gf2017026035", "madsrdf:adminMetadata": [{"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb1"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "War posters"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026152"}, "madsrdf:hasSource": [{"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb5"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb6"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb7"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb8"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb9"}], "madsrdf:hasVariant": [{"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb10"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-02-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:34:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "War posters"}}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(set of 16 posters; contents: American wounded making way to first aid station, pastel / George Matthews Harding -- Traffic to Mont-St.-Pere, pastel / George Matthews Harding -- Railhead dump at Menil-La-Tour, ink/watercolor / J. Andre Smith -- Over the top, pastel / J. Andre Smith -- Crossing the pontoon bridge, watercolor / William James Aylward -- On the trail of the Hun, watercolor / William James Aylward -- Battery of French 75s, ink / Walter Jack Duncan -- Newly arrived troops debarking at Brest, ink / Walter Jack Duncan -- Tanks at Seicheprey, watercolor / Harvey Thomas Dunn -- Sunday morning at Cunel, watercolor / Harvey Thomas Dunn -- On the gas alert, ink / Harry Everett Townsend -- Infantryman, charcoal / Harry Everett Townsend -- Mopping up Cierges, charcoal / Wallace Morgan -- Infantry and tanks advancing, ink / Wallace Morgan -- Neufmaison, ink / Ernest Clifford Peixotto -- Church, St. Aignant, ink / Ernest Clifford Peixotto)"}, "madsrdf:citationSource": "Army art of World War I, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(War posters. Scope note: Posters issued to support military or civilian war efforts, including propaganda. Search under Protest posters for posters that protest war. BT Posters. RT Political posters)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Feb. 19, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(set of 10 war posters; contents: Destruction in Liuchow, China / Samuel D. Smith -- China life line, China / Howard Baer -- Night shift, Italy / Joseph Hirsch -- Digging in, Italy / Savo Radulovic -- Back road to Cassino, Italy / Edward Reep -- Omaha Beach, France / Gary Sheahan -- Road block, France / Olin Dows -- Convoy to the marshalling area, England / Olin Dows --Explaining the problem, England / Olin Dows -- Queen Elizabeth comes up the Clyde, England / Byron Thomas)"}, "madsrdf:citationSource": "Work cat.: World War II, the tide turns : a commemorative print set, 1992?", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Art & architecture thesaurus online, Feb. 19, 2017", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Anderson, Kinsey. Kinsey Anderson anti-war poster collection, ca. 1970.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anti-war posters"}}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anti-war posters"}}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Antiwar posters"}}, {"@id": "_:nbfe47de6342c4561afc6e681f599ed3bb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Antiwar posters"}}], "@id": "/authorities/genreForms/gf2017026035"}
