{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHumorous poetry", "identifiers:lccn": "gf2014026379", "madsrdf:adminMetadata": [{"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b1"}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Humorous poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026255"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026261"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026328"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026399"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026412"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026455"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026506"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026524"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026528"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026534"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026091"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026077"}], "madsrdf:hasSource": [{"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b5"}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b6"}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b7"}], "madsrdf:hasVariant": [{"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b8"}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-13T18:11:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Humorous poetry"}}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Light verse: Humorous verse, usually rhymed; verse in the service of amusement; rhymed lines whose subject matter and attitudes are light as opposed to weighty, dark, and serious.)"}, "madsrdf:citationSource": "Drury, J. A poetry dictionary, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Humorous poetry. UF Humorous verse; Light verse)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Light verse: The term light verse is an omnium gatherum. While light verse once referred principally to vers de soci\u00e9t\u00e9, the Fr. term for verse reserved for one's social circle to amuse or commemorate an occasion, its meaning now includes folk poetry, nonsense verse, ribald verse, kitsch, and more. If the earlier meaning of the term was too narrow, it has now been stretched so far that it has lost its shape. The Library of Congress cataloging system has no subject heading for \"light verse\"; its closest approximation is \"humorous poetry,\" suggesting one devel. in light verse is its movement to the comic mode)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Light verse"}}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Light verse"}}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comic poetry"}}, {"@id": "_:n2d36aadc87af45bbbf773ee8e87ea9f2b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comic poetry"}}], "@id": "/authorities/genreForms/gf2014026379"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026380", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHyangga", "identifiers:lccn": "gf2014026380", "madsrdf:adminMetadata": [{"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb1"}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hyangga"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb5"}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb6"}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb7"}], "madsrdf:hasVariant": [{"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb8"}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb11"}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems composed of four, eight or ten lines written in Korean using Chinese characters during the 10th-14th centuries."}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:31:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hyangga"}}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hyangga. UF Saenaennorae; Sanoega; Sinoega)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hyangga, (native song or back country song) from the 6th-10th centuries Korea. This verse form was originally written using Chinese characters in the Korean language called hyangchal or idu (clerk's writing) hence \"native song\" rather than \"Chinese song\". Up to this time Chinese was the accepted language of literature in Korea; Hyangga is the first \"Korean language\" poetry."}, "madsrdf:citationSource": "Poetry magnum opus online, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The oldest poetic form is the hyangga poems transcribed in the hyangch'al system, dating from the middle period of the Unified Silla dynasty to the early period of the Korv\u014f dynasty (935-1392). The poems were written in four, eight, or 10 lines; the 10-line form--comprising two four-line stanzas and a concluding two-line stanza--was the most popular. The poets were either Buddhist monks or members of the Hwarangdo, a school in which chivalrous youth were trained in civil and military virtues in preparation for state service. Seventeen of the 25 extant hyangga are Buddhist in inspiration and content)"}, "madsrdf:citationSource": "Britannica academic edition online, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sinoega"}}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sinoega"}}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Saenaennorae"}}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Saenaennorae"}}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sanoega"}}, {"@id": "_:n2af648dbe4db4b228eab4d405db01a6cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sanoega"}}], "@id": "/authorities/genreForms/gf2014026380"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026381", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHypertext fiction", "identifiers:lccn": "gf2014026381", "madsrdf:adminMetadata": [{"@id": "_:n66bedf6a3bb54208b9930d91435eab92b1"}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hypertext fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n66bedf6a3bb54208b9930d91435eab92b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n66bedf6a3bb54208b9930d91435eab92b5"}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b6"}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b7"}], "madsrdf:hasVariant": [{"@id": "_:n66bedf6a3bb54208b9930d91435eab92b8"}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b11"}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b14"}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that relies on hypertext links to allow the reader to create the work's structure interactively."}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:31:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hypertext fiction"}}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hypertext: a term used since 1965 in the discussion of computerized text, now referring to the realm of electronically interlinked texts and multimedia resources found on the World Wide Web (from 1990) and on CD-ROM reference sources. Hypertext is sometimes distinguished from 'linear' printed text in terms of the reader's changed experience of moving around and among texts.)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hypertext fiction. UF Digital fiction (Hypertext fiction); Electronic fiction (Hypertext fiction); Network fiction (Hypertext fiction))"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Hypertext fiction (genre of electronic literature, characterized by the use of hypertext links which provides a new context for non-linearity and reader interaction.) Interactive novel (The interactive novel is a form of web fiction and interactive fiction.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 1, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66bedf6a3bb54208b9930d91435eab92b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Digital fiction (Hypertext fiction)"}}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Digital fiction (Hypertext fiction)"}}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66bedf6a3bb54208b9930d91435eab92b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Interactive fiction (Hypertext fiction)"}}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Interactive fiction (Hypertext fiction)"}}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66bedf6a3bb54208b9930d91435eab92b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Electronic fiction (Hypertext fiction)"}}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Electronic fiction (Hypertext fiction)"}}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66bedf6a3bb54208b9930d91435eab92b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Network fiction (Hypertext fiction)"}}, {"@id": "_:n66bedf6a3bb54208b9930d91435eab92b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Network fiction (Hypertext fiction)"}}], "@id": "/authorities/genreForms/gf2014026381"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026382", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHypertext poetry", "identifiers:lccn": "gf2014026382", "madsrdf:adminMetadata": [{"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b1"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hypertext poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b5"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b6"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b7"}], "madsrdf:hasVariant": [{"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b8"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b11"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b14"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b17"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b20"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems composed for the computer screen that may often combine words with sounds, visual images, movement, or other visual effects."}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:32:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hypertext poetry"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hypertext poetry and hypertext fiction are new genres of literature that use the computer screen as medium, rather than the printed page. The literary works rely on the qualities unique to a digital environment, such as linked World Wide Web pages or effects such as sound and movement. Hypertext \"poetry\" can consist of words, although not necessarily organized into lines and stanzas, as well as, sounds, visual images, movement or other special effects.)"}, "madsrdf:citationSource": "Hypertext poetry and fiction, via WWW, May 21, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hypertext poetry. UF Digital poetry (Hypertext poetry); E-poetry (Hypertext poetry); Electronic poetry (Hypertext poetry); Hypermedia poetry; Hypertextual poetry; New-media poetry (Hypertext poetry))"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Digital poetry (Digital poetry is a form of electronic literature, displaying a wide range of approaches to poetry, with a prominent and crucial use of computers. There are many types of \"digital poetry\" such as hypertext, kinetic poetry, computer generated animation, digital visual poetry, interactive poetry, code poetry, holographic poetry (holopoetry), experimental video poetry, and poetries that take advantage of the programmable nature of the computer to create works that are interactive, or use generative or combinatorial approach to create text (or one of its states), or involve sound poetry, or take advantage of things like listservs, blogs, and other forms of network communication to create communities of collaborative writing and publication (as in poetical wikis))"}, "madsrdf:citationSource": "Wikipedia, May 21, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "New media poetry (Hypertext poetry)"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "New media poetry (Hypertext poetry)"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hypertextual poetry"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hypertextual poetry"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Digital poetry (Hypertext poetry)"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Digital poetry (Hypertext poetry)"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Electronic poetry (Hypertext poetry)"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Electronic poetry (Hypertext poetry)"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hypermedia poetry"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hypermedia poetry"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "E-poetry (Hypertext poetry)"}}, {"@id": "_:n991fb53a07cb4cd18db60b25573a8e30b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "E-poetry (Hypertext poetry)"}}], "@id": "/authorities/genreForms/gf2014026382"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026383", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIambic poetry", "identifiers:lccn": "gf2014026383", "madsrdf:adminMetadata": [{"@id": "_:nffadaf1260584e22b11dcb8150a26e27b1"}, {"@id": "_:nffadaf1260584e22b11dcb8150a26e27b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Iambic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nffadaf1260584e22b11dcb8150a26e27b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026061"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026094"}], "madsrdf:hasSource": [{"@id": "_:nffadaf1260584e22b11dcb8150a26e27b5"}, {"@id": "_:nffadaf1260584e22b11dcb8150a26e27b6"}], "madsrdf:hasVariant": {"@id": "_:nffadaf1260584e22b11dcb8150a26e27b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that consist of alternating stressed and unstressed syllables."}, {"@id": "_:nffadaf1260584e22b11dcb8150a26e27b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nffadaf1260584e22b11dcb8150a26e27b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:32:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nffadaf1260584e22b11dcb8150a26e27b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Iambic poetry"}}, {"@id": "_:nffadaf1260584e22b11dcb8150a26e27b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Iamb, iambic: An iamb is a two-syllable poetic foot which consists of an unstressed syllable followed by a stressed syllable. 'Iambic verse' is poetry which uses the foot as its frame. Iambic poetry, notably the iambic pentameter, is perhaps the most significant metre in English poetry.)"}, "madsrdf:citationSource": "Strachan, J. Poetry : an introduction, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nffadaf1260584e22b11dcb8150a26e27b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Iambics: a verse or poem consisting of iambs; satirical poem in this meter.)"}, "madsrdf:citationSource": "Dictionary.com. Jan. 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nffadaf1260584e22b11dcb8150a26e27b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffadaf1260584e22b11dcb8150a26e27b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Iambics"}}, {"@id": "_:nffadaf1260584e22b11dcb8150a26e27b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Iambics"}}], "@id": "/authorities/genreForms/gf2014026383"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026384", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aImagist poetry", "identifiers:lccn": "gf2014026384", "madsrdf:adminMetadata": [{"@id": "_:nd8858fda755a42df8c653a1479b360b7b1"}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Imagist poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd8858fda755a42df8c653a1479b360b7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nd8858fda755a42df8c653a1479b360b7b5"}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b6"}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b7"}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b8"}], "madsrdf:hasVariant": [{"@id": "_:nd8858fda755a42df8c653a1479b360b7b9"}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems aimed at clarity of expression through the use of precise visual images."}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:33:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Imagist poetry"}}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Imagist Poetry was practised mostly by Americans of whom Ezra Pound was the most conspicuous. It represented a reaction against the less disciplined forms of romanticism and its adherents claimed to pursue description and objectivity through orderly and concise expression It later influenced T.S. Eliot. The length and obscurity of some of Ezra Pound's Cantos and T.S. Eliot's longer poems indicate the difficulty in achieving the objectives.)"}, "madsrdf:citationSource": "Companion to British history, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Imagism; imagism poetry; imagism poems; Name given to a movement in poetry aimed at clarity of expression through the use of precise visual images. In the early period often written in the French form Imagisme. To use the language of common speech, but to employ the exact word, not the nearly-exact, nor the merely decorative word.)"}, "madsrdf:citationSource": "Poetry soup, via WWW, Jan. 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Physical poetry: poetry (as imagist poetry) that is primarily concerned with the projection of a descriptive image of material things.)"}, "madsrdf:citationSource": "Merriam-Webster online, Jan. 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 142 (Imagist poems, strongly influenced by haiku and other eastern verse, were short, written in free verse, and presented images without comment or explanation.)"}, "madsrdf:citationSource": "Drury, J. The poetic dictionary, c2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd8858fda755a42df8c653a1479b360b7b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Imagism poetry"}}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Imagism poetry"}}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd8858fda755a42df8c653a1479b360b7b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Physical poetry"}}, {"@id": "_:nd8858fda755a42df8c653a1479b360b7b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Physical poetry"}}], "@id": "/authorities/genreForms/gf2014026384"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026385", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aInstructional comics", "identifiers:lccn": "gf2014026385", "madsrdf:adminMetadata": [{"@id": "_:nda84bda9dc884ca99f35c903ba4915f1b1"}, {"@id": "_:nda84bda9dc884ca99f35c903ba4915f1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Instructional comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nda84bda9dc884ca99f35c903ba4915f1b3"}]}, "madsrdf:exampleNote": "Note under [Educational comics]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026453"}], "madsrdf:hasSource": [{"@id": "_:nda84bda9dc884ca99f35c903ba4915f1b5"}, {"@id": "_:nda84bda9dc884ca99f35c903ba4915f1b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that use a structured format to teach or train the reader. For comics that are intended to impart knowledge and information, including those for classroom use, see [Educational comics.]"}, {"@id": "_:nda84bda9dc884ca99f35c903ba4915f1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nda84bda9dc884ca99f35c903ba4915f1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:19:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nda84bda9dc884ca99f35c903ba4915f1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Instructional comics"}}, {"@id": "_:nda84bda9dc884ca99f35c903ba4915f1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 51 (Comics have been sources of nonfiction information for adults for a long time as well as for instructional methods, propaganda, information on current events, and politics.)"}, "madsrdf:citationSource": "Serchay, D.S. The librarian's guide to graphic novels for adults, c2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nda84bda9dc884ca99f35c903ba4915f1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In Comics and Sequential Art (1985) Eisner divides comics into instructional comics and entertainment comics with several subtypes ranging from technical comics to graphic novels. Such comics could teach readers how to perform a process or even how to think about it)"}, "madsrdf:citationSource": "Garrelts, N. The children of anthropomorphic guns : current scholarship on teaching with comics, via Berfrois website, viewed Dec. 13, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026385"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026386", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aInterludes (Drama)", "identifiers:lccn": "gf2014026386", "madsrdf:adminMetadata": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b1"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Interludes (Drama)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026398"}, "madsrdf:hasSource": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b5"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b6"}], "madsrdf:hasVariant": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b7"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b10"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b13"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b16"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b19"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b22"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b25"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b28"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b31"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b34"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Brief plays performed between the courses of a banquet or the acts of a longer play."}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T08:47:07"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Interludes (Drama)"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "interlude (interlude, in early English drama the name for a short dramatic sketch. For these Renaissance Italy adopted the term intermedio or intermezzo, the former term giving rise to the French entremets or interm\u00e8de, meaning a short comedy or farce.)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "interlude (interlude. A short entertainment put on between the courses of a feast or the acts of a play. During the Middle Ages and up to the 16th c. the term was used to describe a variety of dramatic entertainments. Italian Renaissance drama had intermezzi. In France and Spain similar diversions were called entremets and entremeses.) intermezzi (intermezzi. Light, comic interpolations put on between the acts of serious plays in Italy during the 15th and 16th c. They were usually devoted to mythological subjects. They were similar to the momeries and entremets in France, and the entremeses in Spain. See also entr'acte; interlude) entrem\u00e9s (entrem\u00e9s. A Spanish term deriving from French entremets. A diversion (dramatic or otherwise) between the courses of a banquet. In Catalonia they were called entrameses and the term was later applied to dramatic interludes during the Corpus Christi procession. In Castilian, during the 16th and 17th c., they were brief comic interludes performed between the acts of a play. In the 18th c., similar entertainments were named sainete; and in the 19th c., the g\u00e9nero chico was comparable. See also entr'acte; interlude; intermezzi)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Intermedi"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intermedi"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Intermezzos (Drama)"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intermezzos (Drama)"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Entrameses"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Entrameses"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Entremets (Drama)"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Entremets (Drama)"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Momeries"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Momeries"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sainetes (Drama)"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sainetes (Drama)"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Interm\u00e8des"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Interm\u00e8des"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Intermezzi (Drama)"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intermezzi (Drama)"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Entremeses"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Entremeses"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramatic interludes"}}, {"@id": "_:n1a9955aa17a1440289a9a38a682cb3f9b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramatic interludes"}}], "@id": "/authorities/genreForms/gf2014026386"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026387", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIrohauta", "identifiers:lccn": "gf2014026387", "madsrdf:adminMetadata": [{"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb1"}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Irohauta"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb5"}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb6"}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb7"}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb8"}], "madsrdf:hasVariant": [{"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb9"}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Japanese poems that contain each character of the Japanese syllabary exactly once."}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:44:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Irohauta"}}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Iroha uta: Before the two syllabaries, katakana and hiragana, were arranged in the modern fashion (a-i-u-e-o, etc.), a poem was made using forty-seven, or most, of the syllables: \"n\" is a conspicuous omission. This poem became a child's first step in tenarai. By memorizing the poem, the child learned as it were the alphabet; and the order of the syllables became the basis for arranging compiled information.)"}, "madsrdf:citationSource": "Miner, E. The Princeton companion to classical Japanese literature, c1985", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mitsuta, K. Nazo no irohauta, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The iroha is a Japanese poem most likely written sometime during the Heian era (794-1179 AD). The iroha is unique in that it uses each and every kana precisely once (with the exception of [-n], which was added to the syllabary later.)"}, "madsrdf:citationSource": "Japan-101.com, Jan. 7, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Irohauta)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Iroha"}}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Iroha"}}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Iroha uta"}}, {"@id": "_:n7ace0c2fbcef4fdd9d0d580b2f2d867fb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Iroha uta"}}], "@id": "/authorities/genreForms/gf2014026387"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026388", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJack tales", "identifiers:lccn": "gf2014026388", "madsrdf:adminMetadata": [{"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb1"}, {"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jack tales"}, "madsrdf:elementList": {"@list": [{"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026344"}, "madsrdf:hasSource": [{"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb5"}, {"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb6"}, {"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb7"}, {"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Folk tales focused on the adventures of an unsophisticated but lucky and resourceful main character generally named Jack."}, {"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:44:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jack tales"}}, {"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jack tales)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The \"Jack tales\" typically involve a young hero named Jack who is thrown onto the long road to adulthood, and must overcome many obstacles using his intelligence, bravery, and occasionally, trickery.)"}, "madsrdf:citationSource": "The moonlit road, via WWW, Jan. 16, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folklore: The Jack tales of Appalachia; Jack tales are long, humorous stories that tell of the adventures of the fictional hero named Jack, an Appalachian farm boy who possesses uncanny good luck and manages to continually stumble upon success. Jack is usually portrayed as somewhat unworldly or unsophisticated, yet possessing remarkable street smarts, being particularly imaginative, quick-thinking, and resourceful. While folktales of similar structure and motifs are found in various cultures throughout the world, Jack tales appear to be most similar to European marchen and the various African American genres of trickster tales)"}, "madsrdf:citationSource": "The Greenwood encyclopedia of American regional cultures: the South, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:n81ad528e4f0a436b879d8fe3e1d2380bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jack tales: So-called Jack tales from Celtic and English oral traditions typically narrate an ordinary young man's fantastic adventures. Traveling away from home, with varying combinations of luck, magical help, trickery, and resourcefulness, Jack completes arduous tasks or defeats giants or witches to obtain riches, rescue girls, and sometimes marry a princess. Although some storytellers immersed in Jack tales try to give Jack consistency, they inevitably acknowledge that his personality and circumstances change from tale to tale. He may be an only child, often a poor widow's son, but sometimes two brothers attempt similar quests and hinder his progress. Jack can be a clever, boastful, greedy trickster, or more virtuous like the heroes in European fairy tales. Or he plays the fool, succeeding through dumb luck. As in nursery rhymes and folk expressions (Little Jack Horner, Jack Frost, Jack-o-lantern), Jack is a generic name.)"}, "madsrdf:citationSource": "Oxford encyclopedia of children's literature, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026388"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026389", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJataka stories", "identifiers:lccn": "gf2014026389", "madsrdf:adminMetadata": [{"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b1"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jataka stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasSource": [{"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b5"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b6"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b7"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b8"}], "madsrdf:hasVariant": [{"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b9"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b12"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b15"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b18"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b21"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Paraphrases of J\u0101taka texts in story form."}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:31:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jataka stories"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary note: A retelling of six Jatakas, or birth stories, which illustrate some of the central tenets of Buddha's teachings, such as compassion, honesty, and thinking clearly before acting)"}, "madsrdf:citationSource": "Lee, Jeanne M. I once was a monkey : stories Buddha told, 1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jataka tales. The J\u0101takas refer to a voluminous body of literature native to India concerning the previous births (j\u0101ti) of the Bodhisattva.)"}, "madsrdf:citationSource": "Wikipedia, July 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Davids, T.W.R. Buddhist birth-stories, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Tipi\u1e6daka. Suttapi\u1e6daka. Khuddakanik\u0101ya. J\u0101taka. English. Selections. The revered book of five hundred & fifty J\u0103taka stories : translated from the 14th century Sinhala version, 2012-", "madsrdf:citationStatus": "found"}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Buddhist birth stories"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Buddhist birth stories"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories, Jataka"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories, Jataka"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Birth stories, Buddhist"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Birth stories, Buddhist"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jataka tales"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jataka tales"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tales, Jataka"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tales, Jataka"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories, Buddhist birth"}}, {"@id": "_:n481217496a974ebf8fe9975ee2a06ee1b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories, Buddhist birth"}}], "@id": "/authorities/genreForms/gf2014026389"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026390", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJazz poetry", "identifiers:lccn": "gf2014026390", "madsrdf:adminMetadata": [{"@id": "_:ncc95754ecd4344da9b28cf640fba2404b1"}, {"@id": "_:ncc95754ecd4344da9b28cf640fba2404b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jazz poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncc95754ecd4344da9b28cf640fba2404b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:ncc95754ecd4344da9b28cf640fba2404b5"}, {"@id": "_:ncc95754ecd4344da9b28cf640fba2404b6"}], "madsrdf:hasVariant": {"@id": "_:ncc95754ecd4344da9b28cf640fba2404b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry that displays the rhythm and improvisational feel of jazz music."}, {"@id": "_:ncc95754ecd4344da9b28cf640fba2404b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ncc95754ecd4344da9b28cf640fba2404b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:31:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncc95754ecd4344da9b28cf640fba2404b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jazz poetry"}}, {"@id": "_:ncc95754ecd4344da9b28cf640fba2404b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jazz Poetry; jazz poetics; the invigorating, if originally contested, presence of jazz as the muse for a substantial body of American poetry can be traced back to the art form's emergence in the early 1920s; other periods in which jazz poetry has flourished as a style and in performance were the eras of the Beats and the Black Arts movement, and more recently, the New Renaissance movement in black writing from the 1990s to the present; Jazz poems are animated esp. by the productive tension between what is written and what is spoken; jazz-influenced poems; improvised jazz poetic forms many poets deeply influenced by jazz tend to perform their verses without substantial changes, whether they perform with or without musical accompaniment; verse alluding to or incorporating jazz aesthetics; jazz verse; In jazz poetry, poetic structure thrives on the artful balance between discipline and freedom, silence and noise, and presence or absence of notation. The white space beyond and between lines informs pacing within the poem)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ncc95754ecd4344da9b28cf640fba2404b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jazz poetry is poetry that \"demonstrates jazz-like rhythm or the feel of improvisation\".)"}, "madsrdf:citationSource": "Wikipedia, May 23, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:ncc95754ecd4344da9b28cf640fba2404b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncc95754ecd4344da9b28cf640fba2404b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jazz-influenced poetry"}}, {"@id": "_:ncc95754ecd4344da9b28cf640fba2404b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jazz-influenced poetry"}}], "@id": "/authorities/genreForms/gf2014026390"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026391", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJitanj\u00e1foras", "identifiers:lccn": "gf2014026391", "madsrdf:adminMetadata": [{"@id": "_:n0c165ad210d94dcbb706e618ca640d60b1"}, {"@id": "_:n0c165ad210d94dcbb706e618ca640d60b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jitanj\u00e1foras"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0c165ad210d94dcbb706e618ca640d60b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026455"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026550"}], "madsrdf:hasSource": [{"@id": "_:n0c165ad210d94dcbb706e618ca640d60b5"}, {"@id": "_:n0c165ad210d94dcbb706e618ca640d60b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Sound poems in which words invented for their acoustic qualities may alternate with or imitate real ones."}, {"@id": "_:n0c165ad210d94dcbb706e618ca640d60b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0c165ad210d94dcbb706e618ca640d60b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:31:33"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0c165ad210d94dcbb706e618ca640d60b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jitanj\u00e1foras"}}, {"@id": "_:n0c165ad210d94dcbb706e618ca640d60b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jitanj\u00e1fora. A kind of sound poetry where words invented for their acoustic qualities may alternate with or imitate real ones.)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c165ad210d94dcbb706e618ca640d60b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jitanj\u00e1foras. BT Nonsense verses; Sound poetry)"}, "madsrdf:citationSource": "LCSH, Sept. 6, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026391"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026392", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJue ju", "identifiers:lccn": "gf2014026392", "madsrdf:adminMetadata": [{"@id": "_:n7af26c77ac91421eb71587c245298f21b1"}, {"@id": "_:n7af26c77ac91421eb71587c245298f21b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jue ju"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7af26c77ac91421eb71587c245298f21b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n7af26c77ac91421eb71587c245298f21b5"}, {"@id": "_:n7af26c77ac91421eb71587c245298f21b6"}, {"@id": "_:n7af26c77ac91421eb71587c245298f21b7"}], "madsrdf:hasVariant": {"@id": "_:n7af26c77ac91421eb71587c245298f21b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Chinese poems that consist of four lines with five or seven syllables each and that often have suggestive or erotic themes."}, {"@id": "_:n7af26c77ac91421eb71587c245298f21b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:31:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7af26c77ac91421eb71587c245298f21b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7af26c77ac91421eb71587c245298f21b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jue ju"}}, {"@id": "_:n7af26c77ac91421eb71587c245298f21b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jueju poems are always quatrains; or, more specifically, a matched pair of couplets, with each line consisting of five or seven syllables.)"}, "madsrdf:citationSource": "Poets Poetry Poems online, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n7af26c77ac91421eb71587c245298f21b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 40 (Jueju: A Chinese verse form that was popular during the Tang dynasty (618-907), the jueju (also spelled ch\u00fceh-ch\u00fc) is a four-line poem, each line of which consists of five or seven words.)"}, "madsrdf:citationSource": "Poetry and drama : literary terms and concepts, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7af26c77ac91421eb71587c245298f21b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jue Ju (curtailed or frustrated verse) is one of the oldest of the Chinese patterns and in the 3rd century AD the Jue Ju was very popular. It often carried \"suggestively erotic themes\". It does not tell a story but attempts to create a mood)"}, "madsrdf:citationSource": "Poetry magnum opus online, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n7af26c77ac91421eb71587c245298f21b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7af26c77ac91421eb71587c245298f21b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jueju"}}, {"@id": "_:n7af26c77ac91421eb71587c245298f21b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jueju"}}], "@id": "/authorities/genreForms/gf2014026392"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026393", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKabuki plays", "identifiers:lccn": "gf2014026393", "madsrdf:adminMetadata": [{"@id": "_:nbc5000f1030b4587961ece129e6b3943b1"}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kabuki plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbc5000f1030b4587961ece129e6b3943b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:nbc5000f1030b4587961ece129e6b3943b5"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026540"}, "madsrdf:hasSource": [{"@id": "_:nbc5000f1030b4587961ece129e6b3943b8"}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b9"}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b10"}], "madsrdf:hasVariant": [{"@id": "_:nbc5000f1030b4587961ece129e6b3943b11"}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Highly theatrical Japanese dance dramas that feature a non-realistic style and an episodic structure, in which the roles of both sexes are performed by men.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/genreForms/gf2013025001"}}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-24T10:11:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kabuki plays"}}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbc5000f1030b4587961ece129e6b3943b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed kabuki plays"}}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed kabuki plays"}}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(kabuki. A Japanese form of theatrical entertainment which is more popular than the aristocratic n\u014d plays, and combines song, dance, and stylized gesture in a prolonged spectacle set on a low stage. Scenery and costumes are elaborate, and the female roles are all played by men. Unlike the n\u014d actor, the kabuki performer does not make use of masks, but employs heavy make-up. Kabuki plays are usually based on well-known legends and myths.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kabuki plays)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (Kabuki: The most eclectic and theatrical of the major forms of Japanese theater. Roles of both sexes are performed by men in a highly theatrical, nonrealistic style. Kabuki combines music, dance, and dramatic scenes with an emphasis on color and movement. The plays are long and episodic, consisting of loosely connected dramatic scenes which are often performed independently.)"}, "madsrdf:citationSource": "Wilson, E. The theater experience, c2004, via McGraw-Hill Higher Education online learning center, Nov. 14, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbc5000f1030b4587961ece129e6b3943b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed kabuki plays"}}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed kabuki plays"}}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbc5000f1030b4587961ece129e6b3943b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kabuki drama"}}, {"@id": "_:nbc5000f1030b4587961ece129e6b3943b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kabuki drama"}}], "@id": "/authorities/genreForms/gf2014026393"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026394", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKafas", "identifiers:lccn": "gf2014026394", "madsrdf:adminMetadata": [{"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b1"}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kafas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b5"}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b6"}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b7"}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b8"}], "madsrdf:hasVariant": {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Medieval Armenian lyric poems that were composed of single-rhymed stanzas of four lines."}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:32:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kafas"}}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 383-384 (These interludes are composed in mono-rhymed stanzas of four lines known as kafa, from the Arabic qafiya. From musical notation preserved for some, and other types of later evidence, it suggests that the poems were meant to be sung to the accompaniment of a stringed instrument such as the saz.)"}, "madsrdf:citationSource": "Redefining Christian identity, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kafa (Armenian poetry). UF Kafay)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 417 (Kafay: derived from the Arabic q\u0101fiya - rhyme.)"}, "madsrdf:citationSource": "Malkhasyants, S. Hayer\u0113n batsatrakan ba\u1e5baran, 1944:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 31 (Kafa (from the Arabic q\u0101fiyah) originated in the eleventh century and fell into disuse after the sixteenth century.)"}, "madsrdf:citationSource": "Bardakjian, K.B. A reference guide to modern Armenian literature, 1500-1920, c2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kafays"}}, {"@id": "_:n2c87e90bec704bb6b43ddbc0796e87e8b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kafays"}}], "@id": "/authorities/genreForms/gf2014026394"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026395", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aK\u0101f\u012b (Poetry)", "identifiers:lccn": "gf2014026395", "madsrdf:adminMetadata": [{"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b1"}, {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "K\u0101f\u012b (Poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b5"}, "madsrdf:hasSource": [{"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b8"}, {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b9"}], "madsrdf:hasVariant": {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "This heading is used as a genre/form heading for classical Sufi poems that are often set to music and have heroic, romantic, spiritual, or mystical themes."}, {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-07-13T14:38:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "K\u0101f\u012b (Poetry)"}}, {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "K\u0101f\u012bs"}}, {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "K\u0101f\u012bs"}}, {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kafi is a genre of Sufi poetry meant to be a \"dialogue between Soul and Creator.\" A descendant of the Qasida, the Kafi is popular in Pakistan and India and usually sung. It is described as a monorhymed ode with a refrain of one or two lines repeated throughout the poem)"}, "madsrdf:citationSource": "Poetry magnum opus online, Jan. 4, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kafi is a classical form of Sufi poetry; the genre is said to be derived from the Arabic poetry genre, qasidah, a monorhyme ode that is always meant to be sung, using one or two lines as a refrain that is repeated to create a mood. Kafi poetry is usually themed around heroic and great romantic tales from the folklore, often used as a metaphor for mystical truths, and spiritual longing)"}, "madsrdf:citationSource": "Wikipedia, Jan. 4, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "K\u0101f\u012bs"}}, {"@id": "_:nb33a1c7e6b77459d9f03cbcf96890b58b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "K\u0101f\u012bs"}}], "@id": "/authorities/genreForms/gf2014026395"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026396", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKasa", "identifiers:lccn": "gf2014026396", "madsrdf:adminMetadata": [{"@id": "_:n96693b64326941d3b362f5114fa53d6db1"}, {"@id": "_:n96693b64326941d3b362f5114fa53d6db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kasa"}, "madsrdf:elementList": {"@list": [{"@id": "_:n96693b64326941d3b362f5114fa53d6db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n96693b64326941d3b362f5114fa53d6db5"}, {"@id": "_:n96693b64326941d3b362f5114fa53d6db6"}, {"@id": "_:n96693b64326941d3b362f5114fa53d6db7"}], "madsrdf:hasVariant": {"@id": "_:n96693b64326941d3b362f5114fa53d6db8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Lengthy Korean poems whose lines are each broken by pauses into two phrases which create a parallel structure."}, {"@id": "_:n96693b64326941d3b362f5114fa53d6db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n96693b64326941d3b362f5114fa53d6db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:32:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n96693b64326941d3b362f5114fa53d6db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kasa"}}, {"@id": "_:n96693b64326941d3b362f5114fa53d6db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kasa: The kasa that emerged as a new form toward the middle of the 15th century can be compared to the Ch. rhymepose (q.v.), the fu. It is characterized by a lack of stanzaic division, varying lengths, a tendency toward description and exposition, at times lyricism, and verbal, syntactical parallelism. Its norm is a group of two 4-syllable words, or alternating groups of 3 and 4 syllables, forming a line often employing syntactic and semantic parallelism)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n96693b64326941d3b362f5114fa53d6db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Kasa, (song-words) is: syllabic, 7-syllable lines broken by caesura into alternating groups of 3 and 4 syllables or 8 syllable lines broken by caesura into equal 4 syllable phrases; strophic which can vary in number of lines, tends to describe or expose through parallels; [and] written from unrequited love, patriotism, daily life, nostalgia, etc.)"}, "madsrdf:citationSource": "Poetry magnum opus online, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n96693b64326941d3b362f5114fa53d6db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The kasa tends to be much longer than other forms of Korean poetry and is usually written in balanced couplets. Either line of a couplet is divided into two groups, the first having three or four syllables and the second having four syllables. The history of the kasa is divided into two periods, the division being marked by the Japanese invasion of 1592--97. During the earlier period the poem was generally about 100 lines long and dealt with such subjects as female beauty, war, and seclusion. During the later period the poem tended to be longer and to concern itself with moral instruction, travel accounts, banishment, and the writer's personal misfortunes)"}, "madsrdf:citationSource": "Britannica Academic Edition online, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n96693b64326941d3b362f5114fa53d6db8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96693b64326941d3b362f5114fa53d6db9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gasa"}}, {"@id": "_:n96693b64326941d3b362f5114fa53d6db9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gasa"}}], "@id": "/authorities/genreForms/gf2014026396"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026398", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKy\u014dgen plays", "identifiers:lccn": "gf2014026398", "madsrdf:adminMetadata": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb1"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ky\u014dgen plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026386"}], "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb5"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb8"}], "madsrdf:hasSource": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb11"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb12"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb13"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb14"}], "madsrdf:hasVariant": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb15"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb18"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb21"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb24"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Japanese comic interludes presented between n\u014d plays.", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2013025003"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2013025004"}]}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-24T10:11:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ky\u014dgen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised ky\u014dgen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised ky\u014dgen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed kyogen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed kyogen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ky\u014dgen plays. UF Kabuki ky\u014dgen plays; N\u014d ky\u014dgen plays)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ky\u014dgen (literally \"mad words\" or \"wild speech\") is a form of traditional Japanese comic theater. It developed alongside Noh, was performed along with Noh as an intermission of sorts between Noh acts, on the same Noh stage, and retains close links to Noh in the modern day; therefore, it is sometimes designated Noh-ky\u014dgen.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 7, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Fujii, T. Humor and satire in early English comedy and Japanese ky\u014dgen drama, c1983.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(kyogen. A form of Japanese comic drama which originally developed as a type of interlude in N\u014d performances. The plays are short and irreverent. A stock theme concerns the smart, opportunist servant, who outwits his blockheaded master; the kind of theme popular in low comedy and commedia dell'arte.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dict. of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "N\u014d ky\u014dgen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "N\u014d ky\u014dgen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ky\u014dgen drama"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ky\u014dgen drama"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Noh ky\u014dgen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noh ky\u014dgen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised ky\u014dgen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised ky\u014dgen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed kyogen plays"}}, {"@id": "_:nb1e8264bbab7441c9455cf2188c567bbb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed kyogen plays"}}], "@id": "/authorities/genreForms/gf2014026398"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026399", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKy\u014dka", "identifiers:lccn": "gf2014026399", "madsrdf:adminMetadata": [{"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb1"}, {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ky\u014dka"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026566"}, "madsrdf:hasSource": [{"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb5"}, {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb6"}, {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb7"}], "madsrdf:hasVariant": {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Satirical poems written in the tanka form but parodying it with bawdy or vulgar content and wordplay."}, {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:33:18"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ky\u014dka"}}, {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kyoka: The tone and feel of a limerick written in tanka form and sometimes just as bawdy. Often the subject is about poets or the writing of poems which makes fun of both. Also means tanka using an excessive amount of wordplay)"}, "madsrdf:citationSource": "Glossary of literary poems online, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ky\u014dka: Mad poems. Waka with a humorous or witty cast of language or thought. Word plays involving several meanings were especially popular)"}, "madsrdf:citationSource": "The Princeton companion to classical Japanese literature, c1985", "madsrdf:citationStatus": "found"}, {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Waka poets wrote ky\u014dka, a parodic and popular form of the thirty-one syllable waka, as a form of amusement or diversion. The humor of ky\u014dka essentially derives from placing something vulgar, low, or mundane in an elegant Japanese form or context.)"}, "madsrdf:citationSource": "Early modern Japanese literature, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mad poetry (Ky\u014dka)"}}, {"@id": "_:n2e8c38bc34644169a7ce13ac383211bdb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mad poetry (Ky\u014dka)"}}], "@id": "/authorities/genreForms/gf2014026399"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026400", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLaments", "identifiers:lccn": "gf2014026400", "madsrdf:adminMetadata": [{"@id": "_:nb01b74bf2a694574bcc9252b793eb884b1"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Laments"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb01b74bf2a694574bcc9252b793eb884b3"}]}, "madsrdf:exampleNote": "Note under [Elegies (Poetry)]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026062"}, "madsrdf:hasSource": [{"@id": "_:nb01b74bf2a694574bcc9252b793eb884b5"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b6"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b7"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b8"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b9"}], "madsrdf:hasVariant": [{"@id": "_:nb01b74bf2a694574bcc9252b793eb884b10"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b13"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that express a deep regret or sorrow for the loss of a person or position. For serious, formal lyric poems that reflect on a solemn subject, generally someone's death, see [Elegies (Poetry).]"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-18T07:01:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Laments"}}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lament: A poem expressing grief, usually more intense and more personal than in a complaint.)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lament: An expression of deep regret or sorrow for the loss of a person or position. A non-narrative kind of poetry)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Laments. UF Complancha; Lamentations)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "lament (Lament, a nonnarrative poem expressing deep grief or sorrow over a personal loss. The form developed as part of the oral tradition along with heroic poetry and exists in most languages. Examples include Deor's Lament, an early Anglo-Saxon poem, in which a minstrel regrets his change of status in relation to his patron, and the ancient Sumerian \"Lament for the Destruction of Ur.\" Compare complaint; elegy.)"}, "madsrdf:citationSource": [{"@id": "https://www.britannica.com/art/lament-poetry"}, "Britannica online, July 11, 2024:"], "madsrdf:citationStatus": "found"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)61194283"}, "madsrdf:citationSource": "Oem, Kui Duck. The boudoir lament poetry of the Six Dynasties, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb01b74bf2a694574bcc9252b793eb884b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lamentations"}}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lamentations"}}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb01b74bf2a694574bcc9252b793eb884b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lament poetry"}}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lament poetry"}}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb01b74bf2a694574bcc9252b793eb884b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Complancha"}}, {"@id": "_:nb01b74bf2a694574bcc9252b793eb884b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Complancha"}}], "@id": "/authorities/genreForms/gf2014026400"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026401", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLanguage poetry", "identifiers:lccn": "gf2014026401", "madsrdf:adminMetadata": [{"@id": "_:n8740ab76402342969197197f3647ce2ab1"}, {"@id": "_:n8740ab76402342969197197f3647ce2ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Language poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8740ab76402342969197197f3647ce2ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n8740ab76402342969197197f3647ce2ab5"}, {"@id": "_:n8740ab76402342969197197f3647ce2ab6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Modern poems that are characterized by an attempt to unsettle the ordinary working language by systematically disrupting features such as syntax, referentiality and structural principles like argument and narrative."}, {"@id": "_:n8740ab76402342969197197f3647ce2ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:33:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8740ab76402342969197197f3647ce2ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8740ab76402342969197197f3647ce2ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Language poetry"}}, {"@id": "_:n8740ab76402342969197197f3647ce2ab5", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCSH, Oct. 22, 2014 (Language poetry. Here are entered works on a type of modern poetry that is characterized by an attempt to unsettle the ordinary working of language by systematically disrupting features such as syntax, referentiality, and structural principles like argument and narrative)", "madsrdf:citationStatus": "found"}, {"@id": "_:n8740ab76402342969197197f3647ce2ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Language poetry: Poetry that seeks to detach words from their conventional moorings so something new and unprecedented emerges, not an imitation of life or the world)"}, "madsrdf:citationSource": "Drury, J. The poetry dictionary, c2006", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026401"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026402", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLanternes", "identifiers:lccn": "gf2014026402", "madsrdf:adminMetadata": [{"@id": "_:ncb6404c677474518bc4e6d59643424acb1"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lanternes"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncb6404c677474518bc4e6d59643424acb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026588"}, "madsrdf:hasSource": [{"@id": "_:ncb6404c677474518bc4e6d59643424acb5"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb6"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb7"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb8"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb9"}], "madsrdf:hasVariant": {"@id": "_:ncb6404c677474518bc4e6d59643424acb10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems consisting of five unrhymed lines of one, two, three, four, and one syllables that form the shape of a Japanese lantern."}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:09:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lanternes"}}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(poetic form invented in 1936; unrimed lines of 1, 2, 3, 4, and 1 syllables; lanterne, the French spelling of lantern)"}, "madsrdf:citationSource": "Cantoni, L.J. A festival of lanternes, c1994", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A lanterne is a five line quintain verse shaped like a Japanese lantern with a syllabic pattern of one, two, three, four, one.)"}, "madsrdf:citationSource": "Quintain blogspot.com, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Holman, H.C. A handbook to literature, 1992;Beckson, K.E. Literary terms, 1989;Cuddon, J.A. A dictionary of literary terms, 1998", "madsrdf:citationStatus": "notfound"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lanternes. UF Lanterns (Poetry))"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lanterne - A type of poem that has one syllable in the first line, two syllables in the second line, three syllables in the third line, four syllables in the fourth line, and one syllable in the fifth line that related to the first word of the poem; lines do not rhyme; poem is based on one sentence or idea)"}, "madsrdf:citationSource": "Poetrysoup.com, August 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncb6404c677474518bc4e6d59643424acb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lanterns (Poetry)"}}, {"@id": "_:ncb6404c677474518bc4e6d59643424acb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lanterns (Poetry)"}}], "@id": "/authorities/genreForms/gf2014026402"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026403", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLaudatory poetry", "identifiers:lccn": "gf2014026403", "madsrdf:adminMetadata": [{"@id": "_:n4348331065b94e709238b4272f280da6b1"}, {"@id": "_:n4348331065b94e709238b4272f280da6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Laudatory poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4348331065b94e709238b4272f280da6b3"}]}, "madsrdf:exampleNote": "Note under [Commendatory poetry]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026090"}, "madsrdf:hasSource": [{"@id": "_:n4348331065b94e709238b4272f280da6b5"}, {"@id": "_:n4348331065b94e709238b4272f280da6b6"}, {"@id": "_:n4348331065b94e709238b4272f280da6b7"}, {"@id": "_:n4348331065b94e709238b4272f280da6b8"}], "madsrdf:hasVariant": [{"@id": "_:n4348331065b94e709238b4272f280da6b9"}, {"@id": "_:n4348331065b94e709238b4272f280da6b12"}, {"@id": "_:n4348331065b94e709238b4272f280da6b15"}, {"@id": "_:n4348331065b94e709238b4272f280da6b18"}, {"@id": "_:n4348331065b94e709238b4272f280da6b21"}, {"@id": "_:n4348331065b94e709238b4272f280da6b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that praise a person, place, event, or thing. For poems that generally appear in the preliminaries of books and praise the author and/or work see [Commendatory poetry.]"}, {"@id": "_:n4348331065b94e709238b4272f280da6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:27:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4348331065b94e709238b4272f280da6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4348331065b94e709238b4272f280da6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Laudatory poetry"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epideictic poetry is verse for special occasions, such as epithalamia, many odes, and other kinds of poems now usually referred to as occasional verses; encomium (plural -mia) A composition in prose or verse written in praise of some person, event, or idea; a eulogy. Many odes and elegies are wholly or partly encomiastic; panegyric A public speech or written composition devoted to the prolonged, effusive praise of some person, group of people, or public body.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n4348331065b94e709238b4272f280da6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "encomium (Formal eulogy in prose or verse glorifying people, objects, ideas or events) epinicion (A triumphal ode commemorating a victory at the Olympic Games)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4348331065b94e709238b4272f280da6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Encomium: Strictly, a Greek choral lyric performed \"in the revel\" to celebrate a person's achievements. More generally, the name is applied to any poem praising a man rather than a god, and it overlaps other designations such as panegyric and epinikion; Panegyric originally denoted an oration delivered at one of the Greek festivals; later it came to designate a speech or poem in praise of some person, object, or event; Panegyric is closely related to, and may have been developed from, the eulogy, a speech or poem in praise of the dead; Epinikion: A triumphal song, an ode commemorating a victory at one of the four great Greek national games.)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n4348331065b94e709238b4272f280da6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Laudatory poetry. UF Encomiums; Epideictic poetry; Eulogistic poetry; Panegyrics; Praise poems)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4348331065b94e709238b4272f280da6b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4348331065b94e709238b4272f280da6b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epinicia"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epinicia"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4348331065b94e709238b4272f280da6b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Panegyrics"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Panegyrics"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4348331065b94e709238b4272f280da6b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epinikions"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epinikions"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4348331065b94e709238b4272f280da6b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Praise poetry"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Praise poetry"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4348331065b94e709238b4272f280da6b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Encomia"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Encomia"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4348331065b94e709238b4272f280da6b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Encomiums"}}, {"@id": "_:n4348331065b94e709238b4272f280da6b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Encomiums"}}], "@id": "/authorities/genreForms/gf2014026403"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026404", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLays (Narrative poetry)", "identifiers:lccn": "gf2014026404", "madsrdf:adminMetadata": [{"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b1"}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lays (Narrative poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026448"}, "madsrdf:hasSource": [{"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b5"}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b6"}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b7"}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b8"}], "madsrdf:hasVariant": {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short medieval French narrative poems that were often written in verses of eight syllables."}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:33:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lays (Narrative poetry)"}}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lays)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lai: OF; Eng. lay; Ger. leich). A short narrative or lyric poem, perhaps based on Celtic material but primarily Fr., most of them secular and usually set to music.)"}, "madsrdf:citationSource": "New Princeton encyclopedia of poetry and poetics, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lay, also spelled lai, in medieval French literature, a short romance, usually written in octosyllabic verse, that dealt with subjects thought to be of Celtic origin. The earliest lay narratives were written in the 12th century. The term lay may refer to a medieval lyric poem. The earliest extant examples are those composed in the 13th century. These lays had nonuniform stanzas of about 6 to 16 or more lines of 4 to 8 syllables. One or two rhymes were maintained throughout each stanza)"}, "madsrdf:citationSource": "Britannica online, Oct. 29, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lai: also spelled lay, originally, a short narrative or lyric meant to be sung. The oldest extant l. narrative on record is Marie de France's from the 12th century. The oldest extant lyric l. is Gautier de Dargies' from the 13th century. In form, the l. verse is composed of octosyllabic couplets)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lais (Narrative poetry)"}}, {"@id": "_:nc27257ae953b4986a1b78aecbcac76d5b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lais (Narrative poetry)"}}], "@id": "/authorities/genreForms/gf2014026404"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026405", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLegal drama (Literature)", "identifiers:lccn": "gf2014026405", "madsrdf:adminMetadata": [{"@id": "_:n4b0720fac25a4110ac1fa51e72607607b1"}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Legal drama (Literature)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4b0720fac25a4110ac1fa51e72607607b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n4b0720fac25a4110ac1fa51e72607607b5"}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b6"}], "madsrdf:hasVariant": [{"@id": "_:n4b0720fac25a4110ac1fa51e72607607b7"}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b10"}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b13"}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that feature the practice of law."}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:33:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legal drama (Literature)"}}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(court-related plays; courtroom dramas; legal plays; legal dramas)"}, "madsrdf:citationSource": "Chanen, J.S. The theater's 12 greatest courtroom dramas, in ABA journal, Aug. 2012, viewed online Mar. 14, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Legal drama. UF Courtroom drama; Law-related drama; Lawyer drama; Legal plays)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b0720fac25a4110ac1fa51e72607607b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lawyer drama"}}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lawyer drama"}}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b0720fac25a4110ac1fa51e72607607b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Court-related drama"}}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Court-related drama"}}, {"@id": "_:n4b0720fac25a4110ac1fa51e72607607b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b0720fac25a4110ac1fa51e72607607b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Courtroom drama"}}, {"@id": "_:n4b0720fac25a4110ac1fa51e