{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026067", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSones cubanos", "identifiers:lccn": "gf2018026067", "madsrdf:adminMetadata": [{"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b1"}, {"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sones cubanos"}, "madsrdf:elementList": {"@list": [{"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027100"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026042"}, "madsrdf:hasSource": [{"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b5"}, {"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b6"}, {"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-05-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/miem"}, "ri:recordStatus": "new"}, {"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-03T13:39:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sones cubanos"}}, {"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Son cubano; originated in the highlands of eastern Cuba during late 19th century; syncretic genre that blends elements of Spanish and African origin; fundamental Hispanic components are vocal style, lyrical metre and the primacy of the tres, derived from the Spanish guitar; its characteristic clave rhythm, call and response structure and percussion section (bongo, maracas, etc.) all rooted in traditions of Bantu origin)"}, "madsrdf:citationSource": "Wikipedia, May 24, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Son (Cuba) (Son cubano, the most important genre of 20th century Cuban music; derived from European and African traditions; gave birth to or heavily influenced multiple subgenres of Latino popular dance music, including mambo, rumba, charanga, boogaloo, salsa, songo, timba, and Latin jazz; qualifier 'cubano' is added to distinguish genre from Mexican sones such as son huasteco; binary composition structure includes 32-bar song known as 'tema' or 'son' (based on European song conventions) followed by the 'montuno' (based on African song conventions), a longer section of improvisational instrumental solos, short precomposed horn sections, and call and response vocals; ensembles often include the guitar, the tres, the bongos, the marimbula, and vocals sung in the bel canto style)"}, "madsrdf:citationSource": "Encyc. of Latin Amer. pop. music:", "madsrdf:citationStatus": "found"}, {"@id": "_:n30889c5e507f4d3285b94dc86d3c82c8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (Mi son cubano)"}, "madsrdf:citationSource": "Work cat.: 15 Grandes exitos, 1985:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026067"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026068", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTopological maps", "identifiers:lccn": "gf2018026068", "madsrdf:adminMetadata": [{"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b1"}, {"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Topological maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b5"}, {"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b6"}, {"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b7"}, {"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-05-31T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ukoxu"}, "ri:recordStatus": "new"}, {"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-03T13:39:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topological maps"}}, {"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Drawn in the style of the London Underground map)"}, "madsrdf:citationSource": "Pub stops of Oxford, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Topological map. A map designed to show only a selected feature, such as the stations on the London Underground. Locations are shown as dots, with straight lines connecting them)"}, "madsrdf:citationSource": "A dictionary of geography, 5th ed., 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Design based on the London Underground map. Shows sports as tube lines, names of British medal winners as stations)"}, "madsrdf:citationSource": "Work cat.: Team GB Olympic medallists map 2012, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n4a3e90fa21b8479c9333e80066eee0f3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Topological map. A type of diagram that has been simplified so that only vital information remains and unnecessary detail has been removed. These maps lack scale, and distance and direction are subject to change and variation, but the relationship between points is maintained. A good example is the tube map of the London Underground or the map for the New York City Subway)"}, "madsrdf:citationSource": "Wikipedia, May 31, 2018", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026068"}
