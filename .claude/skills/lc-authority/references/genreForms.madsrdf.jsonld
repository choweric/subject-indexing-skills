26574"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026575", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSilent films", "identifiers:lccn": "gf2011026575", "madsrdf:adminMetadata": [{"@id": "_:n15ce4efb0c0e49438892f68a83bd217db1"}, {"@id": "_:n15ce4efb0c0e49438892f68a83bd217db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Silent films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n15ce4efb0c0e49438892f68a83bd217db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026007"}, "madsrdf:hasSource": {"@id": "_:n15ce4efb0c0e49438892f68a83bd217db5"}, "madsrdf:hasVariant": {"@id": "_:n15ce4efb0c0e49438892f68a83bd217db6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films produced in the early days of the motion picture industry before the advent of talking films.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007005588"}}, {"@id": "_:n15ce4efb0c0e49438892f68a83bd217db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:09:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n15ce4efb0c0e49438892f68a83bd217db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n15ce4efb0c0e49438892f68a83bd217db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Silent films"}}, {"@id": "_:n15ce4efb0c0e49438892f68a83bd217db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(silent film: the term is self-explanatory as it applies to a film without sound track or to a film of the \"silent era,\" that is, up to 1928 when sound pictures became commercially available. However, silent films were never strictly silent but were usually accompanied by music; practically ceased to exist by 1929)"}, "madsrdf:citationSource": "Films by genre, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n15ce4efb0c0e49438892f68a83bd217db6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n15ce4efb0c0e49438892f68a83bd217db7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Silent motion pictures"}}, {"@id": "_:n15ce4efb0c0e49438892f68a83bd217db7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Silent motion pictures"}}], "@id": "/authorities/genreForms/gf2011026575"}
