{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026937", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMilongas (Music)", "identifiers:lccn": "gf2014026937", "madsrdf:adminMetadata": [{"@id": "_:nc98e10d5c6504e85a76cd11831306873b1"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Milongas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc98e10d5c6504e85a76cd11831306873b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:nc98e10d5c6504e85a76cd11831306873b5"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b6"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b7"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b8"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b9"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b10"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b11"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-19T16:42:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Milongas (Music)"}}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(milonga, milongas; includes both vocal and original instrumental works)"}, "madsrdf:citationSource": "LC database, Feb. 23, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(milonga: South American dance song, popular in the southern part of the continent)"}, "madsrdf:citationSource": "Baker's dict. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(milonga: an Argentinian dance, forerunner and faster version of the tango; a piece of music for this dance)"}, "madsrdf:citationSource": "OED online, Feb. 23, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 987 (milonga: 1. Argentine song; 2. Uruguayan musical form used in the payada)"}, "madsrdf:citationSource": "Garland encyc. of world mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2001545423: Tangos & milongas for solo guitar, c2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Milonga: A song genre of Uruguay and Argentina. It is the vehicle of expression in payas or payadas (vocal duels). Lighthearted in mood, the texts are in corrido, romance, d\u00e9cima, or verso structures, and can be in a question-and-answer format. Melodies tend to descend scalewise and are in duple metre, contrasting with the guitar accompaniment in 6/8 metre. When estribillos (refrains) are added they are commonly harmonized in parallel 3rds. Under Tango: The milonga, a dance of alleged African origin in duple metre and syncopated rhythm, contributed to the rhythmic structure of the tango)"}, "madsrdf:citationSource": "Grove music online WWW site, Feb. 23, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Milonga: A traditional song genre of Argentina; became popular in Buenos Aires in the late 19th cent. and is generally regarded as a principal source of the Argentine tango)"}, "madsrdf:citationSource": "New Harvard dict. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc98e10d5c6504e85a76cd11831306873b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Argentina: milonga. A song and dance that originated in the slums of Buenos Aires and evolved into the tango; under Uruguay: milonga. A type of song from the slums of Buenos Aires in neighboring Argentina)"}, "madsrdf:citationSource": "White, D. Dict. pop. mus. styles world", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026937"}
