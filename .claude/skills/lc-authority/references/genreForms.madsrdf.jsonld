tus": "new"}, {"@id": "_:n68a275ee8d7a4086bd59d982b7d114f6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horoscopes"}}, {"@id": "_:n68a275ee8d7a4086bd59d982b7d114f6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Horoscope; a diagram representing the twelve mundane houses and showing the relative positions of planets and signs of the zodiac at a particular time used by astrologers to foretell the events of a person's life or to answer horary questions)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n68a275ee8d7a4086bd59d982b7d114f6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Series 1, Lesson 3, page 1 (The Horoscope Chart or Theme of a Nativity is a graphic circle showing the Zodiac divided into 12 equal segments, each of which is called a House)"}, "madsrdf:citationSource": "Pentaur, (active 1890-1930?). Astrology, [1930]:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68a275ee8d7a4086bd59d982b7d114f6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 154 (Horoscopes ... a representation of the orientation of the heavens around an individual at their birth; position of the heavens at the moment of birth ... is called a natal horoscope; birth of a person or country (mundane astrology); asking a question (horary astrology))"}, "madsrdf:citationSource": "Astrology through history, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68a275ee8d7a4086bd59d982b7d114f6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "All about astrology. The horoscope (Astrologers use a kind of chart or diagram called a horoscope to find out the very special relationship between a person and the Sun, Moon and planets)"}, "madsrdf:citationSource": [{"@id": "https://www.astro.com/astrology/in_kdhoros_e.htm"}, "Work cat: Astro-databank, 2009:"