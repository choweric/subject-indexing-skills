riant"], "madsrdf:elementList": {"@list": [{"@id": "_:na71cd18d02e34ade93f354b720729c16b42"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hockey films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b42", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hockey films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b44", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sports: Fictional work concentrating on how an individual athlete or team, through strength, training, agility, and/or tactics, compete in the often corrupt world of sports. Plots usually relate the victory of an underdog or the fall (and sometimes return) of the champion. Usually the world of a single sport is dramatized, such as baseball, basketball, boxing, football, horse racing, bullfighting, or automobile racing)"}, "madsrdf:citationSource": "Moving image genre form guide via WWW, July 19, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b45", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sports picture (sporting film, sports-themed film); Sports movies include the filming of the Olympic Games, sports biographies, and naturally, films on any sport or match that may arouse the interest of the spectator)"}, "madsrdf:citationSource": "Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b46", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na71cd18d02e34ade93f354b720729c16b47"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surfing films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b47", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surfing films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b49", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list":