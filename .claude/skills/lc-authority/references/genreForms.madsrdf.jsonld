": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Highlife (Music)"}}, {"@id": "_:ne84de51672514fe19fee1ea553ae113bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(highlife, hi-life)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:ne84de51672514fe19fee1ea553ae113bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(highlife, high-life, hi-life)"}, "madsrdf:citationSource": "Work cat.: Crentsil, A.B. Moses [SR], 198-", "madsrdf:citationStatus": "found"}, {"@id": "_:ne84de51672514fe19fee1ea553ae113bb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Harvard dict. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne84de51672514fe19fee1ea553ae113bb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne84de51672514fe19fee1ea553ae113bb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "High-life (Music)"}}, {"@id": "_:ne84de51672514fe19fee1ea553ae113bb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "High-life (Music)"}}, {"@id": "_:ne84de51672514fe19fee1ea553ae113bb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne84de51672514fe19fee1ea553ae113bb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hi-life (Music)"}}, {"@id": "_:ne84de51672514fe19fee1ea553ae113bb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hi-life (Music)"}}], "@id": "/authorities/genreForms/gf2014026858"}
