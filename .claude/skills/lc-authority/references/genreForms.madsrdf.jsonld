b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "([Title means \"we'll read and color\" resource is a coloring book])"}, "madsrdf:citationSource": "Work cat.: 36891975: Ni\u1e33ra \u1e7fe-nitsba\u02bb, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c0e6b539ed644eab3fcb2fe4107ff79b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Walt Disney Productions. Walt Disney's Alice in Wonderland coloring book, 1951.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c0e6b539ed644eab3fcb2fe4107ff79b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "coloring book (a book of line drawings for coloring especially with crayons)"}, "madsrdf:citationSource": "Merriam-Webster online, Aug. 9, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c0e6b539ed644eab3fcb2fe4107ff79b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hazel, Felicia. Coloring books for adults relaxation animals, 2016.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026082"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026083", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCom\u00e9dies-ballets", "identifiers:lccn": "gf2017026083", "madsrdf:adminMetadata": [{"@id": "_:nf100f91917604ea5ada72b4100ecb254b1"}, {"@id": "_:nf100f91917604ea5ada72b4100ecb254b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Com\u00e9dies-ballets"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf100f91917604ea5ada72b4100ecb254b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:nf100f91917604ea5ada72b4100ecb254b5"}, {"@id": "_:nf100f91917604ea5ada72b4100ecb254b6"}, {"@id": "_:nf100f91917604ea5ada72b4100ecb254b7"}, {"@id": "_:nf100f91917604ea5ada72b4100ecb254b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf100f91917604ea5ada72b4100ecb254b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-03T13:39:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf100f91917604ea5ada72b4100ecb254b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-07-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf100f91917604ea5ada72b4100ecb254b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Com\u00e9dies-ballets"}}, {"@id": "_:nf100f91917604ea5ada72b4100ecb254b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(com\u00e9die-ballet: A form of musical play popular at the court of Louis XIV during the 17th century. Combining elements of dance, music, and dialogue and involving the participation of the courtiers themselves, the com\u00e9die-ballet was transformed by Moli\u00e8re, who placed the emphasis upon the dialogue in such pieces as Le Bourgeois gentilhomme (1671). Ultimately the genre gave way to opera and operetta)"}, "madsrdf:citationSource": "The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nf100f91917604ea5ada72b4100ecb254b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(com\u00e9die-ballet: A 17th-century French genre in which scenes of dialogue alternated with ballet and music. It became especially popular during the 1660s at the court of Louis XIV, where courtiers participated in the entertainment. Moli\u00e8re refined the com\u00e9die-ballet by enlarging the role of the dialogue in such works as The Bores (1661) and The Forced Marriage (1664).)"}, "madsrdf:citationSource": "The Methuen Drama dictionary of the theatre, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nf100f91917604ea5ada72b4100ecb254b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Com\u00e9die-ballet. A form of drama developed by Moli\u00e8re, in which he interwove balletic interludes with the action of a play)"}, "madsrdf:citationSource": "Hodgson, T. The drama dictionary, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:nf100f91917604ea5ada72b4100ecb254b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (com\u00e9die-ballet)"}, "madsrdf:citationSource": "Work cat.: Moli\u00e8re. Le bourgeois gentilhomme, 2014:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026083"}
