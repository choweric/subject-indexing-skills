0"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026057"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026030"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026049"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026101"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026021"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026075"}], "madsrdf:hasSource": [{"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b5"}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b6"}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b7"}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b8"}], "madsrdf:hasVariant": {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical works composed for mass appeal and usually dependent on mass media for transmission to large audiences. For popular music lyrics that appear without a musical setting see [Popular music lyrics.]"}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:36:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "revised"}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Popular music"}}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rock and pop, 1963-75)"}, "madsrdf:citationSource": "Joynson, V. Dreams, fantasies, and nightmares from far away lands, 1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Popular music; usage: popular music, pop, pop music)"}, "madsrdf:citationSource": "LC database, Oct. 25, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pop music; while the use of the word \"popular\" in relation to the lighter forms of music goes back to the mid-19th century, the abbreviation \"pop\" was not in use as a generic term until the 1950s, when it was adopted as the umbrella name for a special kind of musical product aimed at a teenage market; often used in an oppositional sense to rock music; seen as a somewhat watered-down, blander version of rock'n'roll, associated with a more rhythmic style and smoother vocal harmony; best of pop survives as \"golden oldies\"; musically defined by general accessibility, emphasis on memorable hooks, and preoccupation with romantic love as a theme)"}, "madsrdf:citationSource": "Shuker, R. Key concepts in popular music, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pop: basically any popular music that places a premium on accessibility; employs various means to boost both instant appeal and memorability (distinctive syncopation, novel instrumental flourishes, danceable rhythms, repeated riffs), but its signal feature is melodic emphasis; generally, any pop record avoids the experimental, arcane, or edgy, aiming instead, in its production, structural familiarity, and clear sentiment to reach the widest possible audience)"}, "madsrdf:citationSource": "New Rolling stone encyc. of rock & roll, c1995", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pop music"}}, {"@id": "_:nb0e0be9e02434debbaa1152fa7a10ba9b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pop music"}}], "@id": "/authorities/genreForms/gf2014027009"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027010", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPorros (Music)", "identifiers:lccn": "gf2014027010", "madsrdf:adminMetadata": [{"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b1"}, {"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Porros (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b5"}, {"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b6"}, {"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b7"}, {"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Porros (Music)"}}, {"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v.2, p. 990 (porro; fast rhythmical Atlantic coastal Colombian musical style for ensemble of gaitas that developed from the cumbia)"}, "madsrdf:citationSource": "Garland enc. of world music:", "madsrdf:citationStatus": "found"}, {"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 317 (porro; A variant of cumbia, developed by the town bands of the Atlantic Coast and then further taken up by 1940s and '50s dance bands)"}, "madsrdf:citationSource": "Waxer, L. Situating salsa, 2002, as viewed in Google books:", "madsrdf:citationStatus": "found"}, {"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 212 (the porro, a slower version of cumbia with singing, was the first Afro-Colombian genre from La Costa to be adapted to suit international middle- and upper-class tastes. Around 1905 to 1910, brass bands in the region's towns began adapting the porro by adding introductory sections that used the cinquillo (five beat) rhythmic motive of the Cuban danz\u00f3n, by translating the traditional drum's accents to the cymbals and bass drum by adding contrapuntal melodic lines)"}, "madsrdf:citationSource": "Candelaria, C. Encyclopedia of Latino popular culture, 2004, as viewed in Google books:", "madsrdf:citationStatus": "found"}, {"@id": "_:n89498bbe36454f4c8f42463d2e6cf7a2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (porro)"}, "madsrdf:citationSource": "Work cat.: Orquesta Emisoras Fuentes. El palomo blanco [SR] 196-:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027010"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027011", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPower metal (Music)", "identifiers:lccn": "gf2014027011", "madsrdf:adminMetadata": [{"@id": "_:n515a10df37844610aa9b7cbef6c49351b1"}, {"@id": "_:n515a10df37844610aa9b7cbef6c49351b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Power metal (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n515a10df37844610aa9b7cbef6c49351b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026854"}, "madsrdf:hasSource": [{"@id": "_:n515a10df37844610aa9b7cbef6c49351b5"}, {"@id": "_:n515a10df37844610aa9b7cbef6c49351b6"}, {"@id": "_:n515a10df37844610aa9b7cbef6c49351b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n515a10df37844610aa9b7cbef6c49351b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n515a10df37844610aa9b7cbef6c49351b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n515a10df37844610aa9b7cbef6c49351b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Power metal (Music)"}}, {"@id": "_:n515a10df37844610aa9b7cbef6c49351b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Power metal crystallized during the mid-'90s, mostly as a reaction against the harshness and lack of melody in death and black metal. Though it sometimes incorporated the complexity of progressive metal, or the menace and growling vocals of death metal, power metal was essentially a classicist style, paying unabashed tribute to its influences. Power metal was primarily (though not exclusively) a continental-European phenomenon)"}, "madsrdf:citationSource": "All music guide WWW site, Jan. 24, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n515a10df37844610aa9b7cbef6c49351b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 6, pp. 204-205 (power metal is more symphonic and reaching than death metal; derived mainly from classical metal of the '80s like Judas Priest, Helloween, and Iron Maiden, power metal focuses on epic themes based on virtuosic singing and playing)"}, "madsrdf:citationSource": "Gulla, B. The Greenwood Encyclopedia of rock history, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n515a10df37844610aa9b7cbef6c49351b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Primal Fear)"}, "madsrdf:citationSource": "Work cat.: Primal Fear (Musical group). New religion [SR] 2007:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027011"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027012", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPowwow songs", "identifiers:lccn": "gf2014027012", "madsrdf:adminMetadata": [{"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb1"}, {"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Powwow songs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb5"}, {"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb6"}, {"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb7"}, {"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Powwow songs"}}, {"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "93-729351: Intertribal pow-wow songs recorded live!, p1989.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Powwow songs)"}, "madsrdf:citationSource": "Hennepin cataloging bulletin #142", "madsrdf:citationStatus": "found"}, {"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "AmeriGrove", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n7071390ae17a40f4bcbd24b03e2717adb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "86-743039: Powwow songs, p1986.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027012"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027013", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPreludes (Music)", "identifiers:lccn": "gf2014027013", "madsrdf:adminMetadata": [{"@id": "_:nbd83bddffa7d4d45a7a0f06d12e86a5fb1"}, {"@id": "_:nbd83bddffa7d4d45a7a0f06d12e86a5fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Preludes (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbd83bddffa7d4d45a7a0f06d12e86a5fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": {"@id": "_:nbd83bddffa7d4d45a7a0f06d12e86a5fb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions that introduce another or larger instrumental work (e.g., a fugue, a suite), or that are relatively short stand-alone pieces that explore particular moods, musical figures, or technical problems. For musical compositions that are intended to introduce a dramatic vocal work or spoken drama, and independent works with the word \"overture\" in the composer's title, see [Overtures.]"}, {"@id": "_:nbd83bddffa7d4d45a7a0f06d12e86a5fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:47:23"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbd83bddffa7d4d45a7a0f06d12e86a5fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbd83bddffa7d4d45a7a0f06d12e86a5fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Preludes (Music)"}}, {"@id": "_:nbd83bddffa7d4d45a7a0f06d12e86a5fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(prelude; a term of varied application that, in its original usage, indicated a piece that preceded other music whose mode or key it was designed to introduce; was instrumental ... and was improvised; with Bach the prelude reached the pinnacle of its development; the prelude and fugue for keyboard continued into the late 18th century in central and northern Germany; more typical of the Romantic period and its aftermath, however, are the many independent preludes for piano, whose prototype was Chopin's matchless set of 24 Preludes op.28 of 1836-9; although some of his preludes are epigrammatically short, others are so large in scale and so dramatic in content that they would overshadow any alien sequel to which they might be attached; preludes [by later composers] have no prefatory function and are simply collections of short pieces exploring particular moods, musical figures or technical problems)"}, "madsrdf:citationSource": "Grove music online, viewed July 11, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027013"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027014", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProcessionals (Service books)", "identifiers:lccn": "gf2014027014", "madsrdf:adminMetadata": [{"@id": "_:nb917ef87d2cd4d1abc13eb8704ae0607b1"}, {"@id": "_:nb917ef87d2cd4d1abc13eb8704ae0607b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Processionals (Service books)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb917ef87d2cd4d1abc13eb8704ae0607b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027085"}, "madsrdf:hasSource": {"@id": "_:nb917ef87d2cd4d1abc13eb8704ae0607b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb917ef87d2cd4d1abc13eb8704ae0607b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb917ef87d2cd4d1abc13eb8704ae0607b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb917ef87d2cd4d1abc13eb8704ae0607b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Processionals (Service books)"}}, {"@id": "_:nb917ef87d2cd4d1abc13eb8704ae0607b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Processional. A small portable liturgical book of the Western Church, containing the chants, rubrics and collects appropriate to liturgical processions. It is of particular musical interest since it contains antiphons, verses, rhymed Preces and even polyphonic chants that do not occur in other liturgical books. Like the pontifical, it was a comparatively late addition to the repertory of official liturgical books, originating in the 10th and 11th centuries; the processional antiphons are much older, and formerly occurred in the gradual.)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027014"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027015", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProduction music", "identifiers:lccn": "gf2014027015", "madsrdf:adminMetadata": [{"@id": "_:nb2f8582aa8664551b0cc557000ae6899b1"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Production music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb2f8582aa8664551b0cc557000ae6899b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026593"}, "madsrdf:hasSource": [{"@id": "_:nb2f8582aa8664551b0cc557000ae6899b5"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b6"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b7"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b8"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b9"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b10"}], "madsrdf:hasVariant": [{"@id": "_:nb2f8582aa8664551b0cc557000ae6899b11"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Prerecorded music used in the production of film, radio, television, and theatrical works."}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:54:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Production music"}}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Manhattan Production Music coll. [SR] 1987.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(background music)"}, "madsrdf:citationSource": "Ensign, L.N. Comp. dict. TV and film, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 67 (... over 40 CDs of original production music ...)"}, "madsrdf:citationSource": "In motion, Apr. 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(background music may either be composed ... may buy it \"canned\" ...)"}, "madsrdf:citationSource": "Harmon, R. Film producing low-budget films ... 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(canned music)"}, "madsrdf:citationSource": "Oakey, V. Dict. film and TV terms, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2f8582aa8664551b0cc557000ae6899b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 444 (Associated Production Music)"}, "madsrdf:citationSource": "Recording industry sourcebook, 1991:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb