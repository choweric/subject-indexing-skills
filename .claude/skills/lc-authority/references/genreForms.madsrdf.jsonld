cordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-03-04T14:25:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock films"}}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rock films: \"The films in this category are centered on the rock music theme, or have it play an important role in it.\")"}, "madsrdf:citationSource": "Wikipedia, 26 Sept. 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: The Beatles [VR] 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg: Rock films; BT: Musical films)"}, "madsrdf:citationSource": "LCSH, Nov. 17, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rock Film (Rock and Roll Film, Rock and Roll Musical, Rock 'n' Roll Picture). A subgenre of the musical, rock and roll movies came into being with Rock Around the Clock, produced in 1956; not all rock films are musicals; some combine a rock soundtrack with strong dramatic content; also include rock documentaries and rock concert films)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Musical: Predominantly theatrical fiction work whose plot is structured around segments featuring combinations of music, song, and dance, including such various types as backstage, comedy, rock, and musical biographies)"}, "madsrdf:citationSource": "Taves, B. Moving image genre-form guide online, Nov. 24, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock 'n' roll films"}}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock 'n' roll films"}}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock and roll films"}}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock and roll films"}}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock music films"}}, {"@id": "_:n0b64f3d18f1343b08c6d6ec89da50318b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock music films"}}], "@id": "/authorities/genreForms/gf2011026539"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026540", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRock music radio programs", "identifiers:lccn": "gf2011026540", "madsrdf:adminMetadata": [{"@id": "_:n30f63ff645b140b2912d039dfd41f79fb1"}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rock music radio programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n30f63ff645b140b2912d039dfd41f79fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026506"}, "madsrdf:hasSource": [{"@id": "_:n30f63ff645b140b2912d039dfd41f79fb5"}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb6"}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb7"}], "madsrdf:hasVariant": [{"@id": "_:n30f63ff645b140b2912d039dfd41f79fb8"}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb11"}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025528"}}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T13:52:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock music radio programs"}}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. B-511 (rock music from the sixties to the present; album-oriented rock programs and stations feature uninterrupted sets; news plays a secondary role)"}, "madsrdf:citationSource": "Broadcasting & cable yearbook, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mostly current rock music, whether single releases or album cuts; due to the diversity of rock music, the playlists of different rock stations will tend to fall within different stylistic ranges, such as modern rock and alternative rock)"}, "madsrdf:citationSource": "New York radio guide, via WWW, Feb. 4, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Radio form/genre guide online, Oct. 1, 2008", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n30f63ff645b140b2912d039dfd41f79fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Music radio programs, Rock"}}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Music radio programs, Rock"}}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n30f63ff645b140b2912d039dfd41f79fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock and roll music radio programs"}}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock and roll music radio programs"}}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n30f63ff645b140b2912d039dfd41f79fb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock-n-roll music radio programs"}}, {"@id": "_:n30f63ff645b140b2912d039dfd41f79fb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock-n-roll music radio programs"}}], "@id": "/authorities/genreForms/gf2011026540"}
