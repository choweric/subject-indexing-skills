3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poetry"}}, {"@id": "_:nb089ece3234d4095a0034f3843586c49b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "De Vries, L.P. The nature of poetic literature, 1930.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb089ece3234d4095a0034f3843586c49b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rhyme 1: a (1) : rhyming verse (2) : poetry. b : a composition in verse that rhymes. Variant: rime)"}, "madsrdf:citationSource": "Merriam-Webster online, July 18, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb089ece3234d4095a0034f3843586c49b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(poetry: Literary work in which special intensity is given to the expression of feelings and ideas by the use of distinctive style and rhythm; poems collectively or as a genre of literature. Synonyms: poems, verse, versification, metrical composition, rhymes, balladry, archaic: poesy)"}, "madsrdf:citationSource": "Oxford dictionaries website, July 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb089ece3234d4095a0034f3843586c49b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sidney, P. The defence of poesie, 1908.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb089ece3234d4095a0034f3843586c49b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Puttenham, G. The art of English poesy, 2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb089ece3234d4095a0034f3843586c49b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. v (\"George Frederick Cameron, the author of the following poems\")"}, "madsrdf:citationSource": "Cameron, G.F. Lyrics on freedom, love and death, \u00a91973:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb089ece3234d4095a0034f3843586c49b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list":