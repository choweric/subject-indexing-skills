pe": "xsd:dateTime", "@value": "2015-12-07T16:38:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0028da9f37c04d5e9dab2a47dbb765e9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Registers (Lists)"}}, {"@id": "_:n0028da9f37c04d5e9dab2a47dbb765e9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 69 (register: 1 written record or collection of entries, 2 official records of legal, parliamentary or public nature, 3 entry in register, 4 record-book (of baptisms etc.))"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0028da9f37c04d5e9dab2a47dbb765e9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Registers. UF Rosters. BT Books)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0028da9f37c04d5e9dab2a47dbb765e9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(register: Also refers to a list of names, addresses, events, dates, etc., usually compiled in a single chronological or numerical sequence and maintained as an official log or record)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0028da9f37c04d5e9dab2a47dbb765e9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Registers. Use subdivision Registers under names of countries, cities, etc., individual corporate bodies and families, and under classes of persons, ethnic groups, individual wars, and topical headings; and headings beginning with the word Registers, for lists of names of persons, organizations, objects, etc., without addresses or other identifying data)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026166"}
