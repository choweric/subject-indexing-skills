{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026592", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWar poetry", "identifiers:lccn": "gf2014026592", "madsrdf:adminMetadata": [{"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b1"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "War poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b5"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b6"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b7"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b8"}], "madsrdf:hasVariant": [{"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b9"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b12"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry that features military conflicts."}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:23:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "War poetry"}}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(combat poems; combat poetry)"}, "madsrdf:citationSource": "PoetrySoup website, July 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(War poetry. UF Anti-war poetry)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(war poetry: War poetry, incl. depictions of battle, celebrations of victory, lamentations over defeat and captivity, and meditations on confronting death, has existed since the birth of lit. Terms like antiwar poetry should be used with care, since the frightfulness of war may be told as fully by those committed to violent resolution of conflict as by those opposed to it; yet poets have undeniably moved from the glory of killing to the glory of being killed and then to the doubt and shame of killing.)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Eger, C. Combat poetry of WWI, 2010, via WWW, July 9, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Antiwar poetry"}}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Antiwar poetry"}}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anti-war poetry"}}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anti-war poetry"}}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Combat poetry"}}, {"@id": "_:n32b7d22e4ea7493fb6f1ff1d1b384f85b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Combat poetry"}}], "@id": "/authorities/genreForms/gf2014026592"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026593", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWestern comics", "identifiers:lccn": "gf2014026593", "madsrdf:adminMetadata": [{"@id": "_:n1ed61839218b486a8d3e4993263259a2b1"}, {"@id": "_:n1ed61839218b486a8d3e4993263259a2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Western comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1ed61839218b486a8d3e4993263259a2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": {"@id": "_:n1ed61839218b486a8d3e4993263259a2b5"}, "madsrdf:hasVariant": {"@id": "_:n1ed61839218b486a8d3e4993263259a2b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that feature the American West during the period of westward expansion."}, {"@id": "_:n1ed61839218b486a8d3e4993263259a2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1ed61839218b486a8d3e4993263259a2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:23:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1ed61839218b486a8d3e4993263259a2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Western comics"}}, {"@id": "_:n1ed61839218b486a8d3e4993263259a2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Western comics is a comics genre usually depicting the American Old West frontier (usually anywhere west of the Mississippi River) and typically set during the late nineteenth century. The term is generally associated with an American comic books genre published from the late 1940s through the 1950s (though the genre had continuing popularity in Europe, and persists in limited form in American comics today). Western comics of the period typically featured dramatic scripts about cowboys, gunfighters, lawmen, bounty hunters, outlaws, and Native Americans. Accompanying artwork depicted a rural America populated with such iconic images as guns, cowboy hats, vests, horses, saloons, ranches, and deserts, contemporaneous with the setting.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 8, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ed61839218b486a8d3e4993263259a2b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ed61839218b486a8d3e4993263259a2b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Westerns (Comics)"}}, {"@id": "_:n1ed61839218b486a8d3e4993263259a2b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Westerns (Comics)"}}], "@id": "/authorities/genreForms/gf2014026593"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026594", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWestern fiction", "identifiers:lccn": "gf2014026594", "madsrdf:adminMetadata": [{"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b1"}, {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Western fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b5"}, {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b6"}, {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b7"}], "madsrdf:hasVariant": {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features the American West during the period of westward expansion."}, {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T16:24:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Western fiction"}}, {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Western stories. UF Westerns. Use for post-19th century works set in the 19th century American West)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(western: a genre of novels and short stories, motion pictures, and television and radio shows that are set in the American West, usually in the period from the 1850s to the end of the 19th century; in literature the western story had its beginnings in the first adventure narratives that accompanied the opening of the West to white settlement shortly before the Civil War; accounts of the Western plainsmen, scouts, buffalo hunters, and trappers were highly popular in the East; novel (types of novel/western): the peculiar and perennial appeal of the western lies in its ethical simplicity, the frequent violence, the desperate attempt to maintain minimal civilized order, as well as the stark, near-epic figures from true western history, such as Billy the Kid, Calamity Jane, Wyatt Earp, Annie Oakley, and Jesse James)"}, "madsrdf:citationSource": "Britannica online academic edition, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 314 (westerns are novels set in the western United States primarily from the end of the Civil War to the beginning of the twentieth century; they feature the adventures of cowboys, scouts, Indians, settlers, and lawmen, as they explore the clash between civilization and anarchy in mythic stories of men and the land)"}, "madsrdf:citationSource": "Saricks, J.G. Readers' advisory to genre fiction, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Westerns (Fiction)"}}, {"@id": "_:nf85bfcd9b0ca463381f4ce98cef48e69b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Westerns (Fiction)"}}], "@id": "/authorities/genreForms/gf2014026594"}
