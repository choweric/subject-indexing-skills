{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026064", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAutobiographical films", "identifiers:lccn": "gf2011026064", "madsrdf:adminMetadata": [{"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb1"}, {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Autobiographical films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026089"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026047"}], "madsrdf:hasSource": [{"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb5"}, {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb6"}, {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb7"}], "madsrdf:hasVariant": {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025584"}}, {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-04T14:46:06"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autobiographical films"}}, {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autobiographical: work using the filmmaker as subject)"}, "madsrdf:citationSource": "Moving image genre-form guide online, November 19, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A biographical film, or biopic (biographical motion picture), is a film that dramatizes the life of an actual person or people. In rare cases, sometimes called autobiopics, the subject of the film plays himself or herself: Jackie Robinson in The Jackie Robinson Story; Muhammad Ali in The Greatest; Audie Murphy in To Hell and Back; Patty Duke in Call Me Anna; Arlo Guthrie in Alice's Restaurant; and Howard Stern in Private Parts)"}, "madsrdf:citationSource": "Wikipedia, Mar. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 29 (Autobiographical works: a personal/independent work about a living person's life or an incident in his life, made by the person himself)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autobiopics"}}, {"@id": "_:n779a41fa1d3b4f08ab004b3a9f954e8bb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autobiopics"}}], "@id": "/authorities/genreForms/gf2011026064"}
