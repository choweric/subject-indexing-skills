{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026084", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDomestic poetry", "identifiers:lccn": "gf2018026084", "madsrdf:adminMetadata": [{"@id": "_:nc1323015eae54baa85da81cdc1391500b1"}, {"@id": "_:nc1323015eae54baa85da81cdc1391500b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Domestic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc1323015eae54baa85da81cdc1391500b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nc1323015eae54baa85da81cdc1391500b5"}, {"@id": "_:nc1323015eae54baa85da81cdc1391500b6"}, {"@id": "_:nc1323015eae54baa85da81cdc1391500b7"}, {"@id": "_:nc1323015eae54baa85da81cdc1391500b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry that features home and family life."}, {"@id": "_:nc1323015eae54baa85da81cdc1391500b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc1323015eae54baa85da81cdc1391500b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-09-11T08:02:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc1323015eae54baa85da81cdc1391500b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Domestic poetry"}}, {"@id": "_:nc1323015eae54baa85da81cdc1391500b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 11 (Sylvia Plath's domestic poetry) p. 23 (her domestic poems)"}, "madsrdf:citationSource": "Modern language studies, autumn 1977, via JSTOR, viewed June 18, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1323015eae54baa85da81cdc1391500b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Domestic poetry lost currency in the last century as a genre for scholarly analysis, but the Victorians recognized it as a kind of poetry both popular among readers and esteemed by critics. The domestic ideology that dominated Victorian culture - the set of beliefs that located moral value and psychological health in the home, that sanctified the Victorian hearth as a domestic altar and the woman as an \"angel in the house\", and that praised the \"domestic affections\" as the source of the nation's strength - emerged in the work of early Victorian poets, male and female alike, in descriptive scenes of home, narratives of family life, and verses on the domestic affections.)"}, "madsrdf:citationSource": "A companion to Victorian poetry, 2002, via Blackwell reference online, viewed June 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1323015eae54baa85da81cdc1391500b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"I've written poems about boyfriends and lovers, cats, ex-husbands, my parents, Maine, my neighbors and friends. By far, most of my poems are about my kids. ... domestic poetry is about private matters (no public odes to heroes or tragic epics) and relationships in a family.\")"}, "madsrdf:citationSource": "Brown, J.S. Domestic poetry, 2016, via Retrospect website, viewed on June 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1323015eae54baa85da81cdc1391500b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "publisher's website (\"Steeped in Jewish tradition and lore, The Insatiable Psalm is an exploration of the troubled but enduring love between a devout mother and her increasingly less observant son.\") subj. hdgs. (Jewish families--Poetry. Mothers and sons--Poetry.)"}, "madsrdf:citationSource": "Work cat.: Taub, Y.A. The insatiable psalm, 2005:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026084"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026087", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrap (Music)", "identifiers:lccn": "gf2018026087", "madsrdf:adminMetadata": [{"@id": "_:n566069ecf7cc49c18c85188b282be42eb1"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trap (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n566069ecf7cc49c18c85188b282be42eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027037"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026121"}, "madsrdf:hasSource": [{"@id": "_:n566069ecf7cc49c18c85188b282be42eb5"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb6"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb7"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb8"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb9"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb10"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb11"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-04T14:38:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/mel"}, "ri:recordStatus": "new"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trap (Music)"}}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (Trap mix; Trap remix)"}, "madsrdf:citationSource": "Trap music box, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 69 (trap music; Trap, a subgenre of rap originating in Atlanta and circulating especially through the US South, glorifies drug trafficking and sounds black in a post-race society that values diversity, not black solidarity)"}, "madsrdf:citationSource": "Burton, J.A. Posthuman rap, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (\"This project will be a comparative case study of two rappers (Jody Breeze and Gorilla Zoe), their labels, their subgenre (which has become popularly known as trap music) and their city (Atlanta) as a site of cultural production.\") p. 70 (the trap music genre) p. 87 (rap subgenre styles such as crunk, snap and trap)"}, "madsrdf:citationSource": "Balaji, M. Trap(ped) music and masculinity : the cultural production of Southern hip-hop at the intersection of corporate control and self-construction, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "All trap music. Vol. 2, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "2018621554: 2 Chainz. Pretty girls like trap music, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (Trap Paris / featuring Quavo + Ty Dolla Sign; track consists of trap music)"}, "madsrdf:citationSource": "Work cat.: MGK. Bloom, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Trap kings: how the hip-hop sub-genre dominated the decade (trap; subgenre of rap developed in Atlanta, Georgia in the early 2000s; \"trap\" referred to \"an abandoned house where drugs are peddled\"; Jeezy, Gucci Mane and TI, early practitioners and the \"holy trinity of trap\"; production eventually crossed over to EDM and pop and lost its sociopolitical context; \"now, there may be just a few constants in what is considered trap production: an 808 heartbeat, bass, and rapid-fire cascading percussion fills\")"}, "madsrdf:citationSource": "The guardian, viewed June 26, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n566069ecf7cc49c18c85188b282be42eb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Trap music: under lock & key (trap music; trap; originated in the early 2000 in the American South; early trap \"brought rap music to a new sonic dimension: with dark energy, a gothic feel, street culture (guns, drug houses, strippers) and an allover gigantic sound\"; around 2010 some artists blended trap with electronic music, including dubstep, producing a fusion genre of \"EDM trap\")"}, "madsrdf:citationSource": "DJ mag, viewed June 26, 2018:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026087"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026088", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLesson plans", "identifiers:lccn": "gf2018026088", "madsrdf:adminMetadata": [{"@id": "_:nd96a1765982744c18ae0779af4d34ea8b1"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lesson plans"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd96a1765982744c18ae0779af4d34ea8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, "madsrdf:hasSource": [{"@id": "_:nd96a1765982744c18ae0779af4d34ea8b5"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b6"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b7"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b8"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b9"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b10"}], "madsrdf:hasVariant": {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:23:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/gvas"}, "ri:recordStatus": "new"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lesson plans"}}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lesson plan: written plan for a lesson to be taught during a single class period. Such plans normally include entries identifying objectives, review items, new material, points to be stressed, reference materials, and assignments to be made)"}, "madsrdf:citationSource": "Dejnozka, Edward L. Educational administration glossary, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Folklife lesson plans, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lesson plans by Glen Blankenship)"}, "madsrdf:citationSource": "Sunbury sleeps, 1995", "madsrdf:citationStatus": "found"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page i (book combines folklife and writing background information with lesson plans and resources)"}, "madsrdf:citationSource": "Work cat.: Howard, Diane W. Folkwriting, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lesson Plans; used for Lesson Notes)"}, "madsrdf:citationSource": "ERIC thesaurus, viewed June 29, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd96a1765982744c18ae0779af4d34ea8b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lesson notes"}}, {"@id": "_:nd96a1765982744c18ae0779af4d34ea8b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lesson notes"}}], "@id": "/authorities/genreForms/gf2018026088"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026089", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGrimoires", "identifiers:lccn": "gf2018026089", "madsrdf:adminMetadata": [{"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab1"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Grimoires"}, "madsrdf:elementList": {"@list": [{"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026109"}, "madsrdf:hasSource": [{"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab5"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab6"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab7"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab8"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab9"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab10"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab11"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab12"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab13"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab14"}], "madsrdf:hasVariant": [{"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab15"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/gvas"}, "ri:recordStatus": "new"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T10:43:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Grimoires"}}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 35 (Book of shadows; In contemporary witchcraft and Wicca, a book of beliefs, rituals, Witchcraft laws and ethics, herbal and healing lore, incantations, chants, dances, spells, divination methods, rituals and miscellaneous topics that serves as a guide for Witches in practicing their Craft and religion)"}, "madsrdf:citationSource": "Guiley, Rosemary Ellen. The encyclopedia of witches, witchcraft and Wicca, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(grimoires: Handbooks of magic ... the original purpose of the grimoires was to conjure and control demons and spirits)"}, "madsrdf:citationSource": "Guiley, Rosemary Ellen. The Encyclopedia of Witches, Witchcraft and Wicca, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "grimoire (origin and etymology: French, from Old French, alteration of gramaire grammar, grammar book, learned work, book of witchcraft; definition: a magician's manual for invoking demons and the spirits of the dead)"}, "madsrdf:citationSource": "Web.3.", "madsrdf:citationStatus": "found"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(What is the difference between a grimoire and a book of shadows? A book of shadows is a grimoire specific to the practice of Wicca, it was a term originally coined to describe the ritual texts of Wicca)"}, "madsrdf:citationSource": "The Traveling Witch website, viewed May 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 1 (Contains the ATC BOS)"}, "madsrdf:citationSource": "Work cat: Aquarian Tabernacle Church. The A.T.C. redbook of Wiccan liturgy, 1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Book of Shadows is essentially a modern grimoire)"}, "madsrdf:citationSource": "Wicca Living website, viewed May 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Witchy terms: Grimoire vs. Book of Shadows. In occult sources on the web and elsewhere, and the terms \"grimoire\" and \"book of shadows\" will seem to be essentially interchangeable. Each appears to refer to some kind of magical journal in which practices, magical experiences, and knowledge are recorded, but the exact difference between the two is less apparent. Some differentiate them by keeping one for personal information and the other for public information, but there appears to be no consensus as to which is which, and every group or individual seems to have their own definition of each term)"}, "madsrdf:citationSource": "Coven of the open mind website, viewed May 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page ix (Grimoire: an ancient book of knowledge)"}, "madsrdf:citationSource": "Work cat: Frost, Gavin. Witch's grimoire of ancient omens, portents, talismans, amulets, and charms, 2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "volume 1, page 203 (Book of shadows; The 'bible' of the modern witch coven. It contains basic beliefs, rituals, charms, spells, and incantations. Normal procedure is for a witch to copy the work in her own handwriting)"}, "madsrdf:citationSource": "Encyclopedia of occultism & parapsychology, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(name not given; handwritten; contains rituals, charms, spells, and incantations)"}, "madsrdf:citationSource": "Kim (Egyptian Wiccan). Book of shadows, [approximately 1981]", "madsrdf:citationStatus": "found"}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books of Shadows"}}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books of Shadows"}}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shadows, Books of"}}, {"@id": "_:n90aef1e8d88b497d91a0cf7aec9603cab19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shadows, Books of"}}], "@id": "/authorities/genreForms/gf2018026089"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026090", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLove letters", "identifiers:lccn": "gf2018026090", "madsrdf:adminMetadata": [{"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b1"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Love letters"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026141"}, "madsrdf:hasSource": [{"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b5"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b6"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b7"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b8"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b9"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b10"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b11"}], "madsrdf:hasVariant": [{"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b12"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b15"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-09-11T08:02:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Love letters"}}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Rawlings, M.K. The private Marjorie : the love letters of Marjorie Kinnan Rawlings to Norton S. Baskin, \u00a92004.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "jkt. (\"This volume offers the first translation into English of two seminal works by the seventeenth-century French woman author, Marie-Catherine Desjardins, better known as Madame de Villedieu. The first of these works, Lettres et billets galants [Love Notes and Letters], was published in 1668 and contains her most intimate letters to her lover, Antoine de Villedieu.\")"}, "madsrdf:citationSource": "Villedieu, Madame de. Love notes and letters, \u00a92005:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "RBMS controlled vocabularies: genre terms, via WWW, June 30, 2018", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(love letters. UF love-letters; love-notes; love notes. BT letters (correspondence))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, June 30, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Love letters. Used For: Letters, Love. Broader Term: Correspondence. Related Term(s): Courtship; Love)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, June 30, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Stein, G. Baby precious always shines : selected love notes between Gertrude Stein and Alice B. Toklas, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Love-letters. BT Erotic literature. BT Letters. RT Courtship)"}, "madsrdf:citationSource": "LCSH, June 30, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Notes, Love"}}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Notes, Love"}}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Letters, Love"}}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Letters, Love"}}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Love notes"}}, {"@id": "_:nb6c465e088a347718fd9d25f7ba389b8b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Love notes"}}], "@id": "/authorities/genreForms/gf2018026090"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026091", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSoft rock (Music)", "identifiers:lccn": "gf2018026091", "madsrdf:adminMetadata": [{"@id": "_:nc3339067f307442ba83864797d4629b8b1"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Soft rock (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc3339067f307442ba83864797d4629b8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}, "madsrdf:hasSource": [{"@id": "_:nc3339067f307442ba83864797d4629b8b5"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b6"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b7"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b8"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b9"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b10"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc3339067f307442ba83864797d4629b8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-04T14:38:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-07-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soft rock (Music)"}}, {"@id": "_:nc3339067f307442ba83864797d4629b8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Carpenters, Made in America (Genre: Pop/Rock. Styles: Soft Rock) Michael McDonald, If That's What It Takes (Styles: Adult Contemporary; Blue-Eyed Soul; Contemporary Pop/Rock; Soft Rock; Soul)"}, "madsrdf:citationSource": "AllMusic website, July 6, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(soft rock album)"}, "madsrdf:citationSource": "Work cat.: McDonald, Michael. If that's what it takes, \u21171982", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Soft Rock emerged in the early '70s, partially as a reaction to the extreme sounds of the late '60s. Soft rock was commercial and inoffensive, taking the sound of singer/songwriter and pop/rock but smoothing out all the edges. Bands like Bread, the Carpenters, and Chicago relied on simple, melodic songs with big, lush productions. Throughout the '70s, soft rock dominated the airwaves and it eventually metamorphosed into the synthesized sounds of adult contemporary in the '80s.)"}, "madsrdf:citationSource": "Soft rock music overview, via AllMusic website, July 6, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(soft rock album)"}, "madsrdf:citationSource": "Work cat.: Carpenters (Musical group). Made in America, \u21171981", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Soft rock. A term invented in the early 1970s to describe acoustic folk-rock and other tuneful, soothing types of popular music that use electric instruments. James Taylor, Neil Young (the early recordings), and Cat Stevens typify the folk element in soft rock; in Los Angeles the pop-rock groups Bread and the Carpenters made polished, soft-rock recordings that the music industry designated 'middle of the road'. The term is now applied broadly to quieter popular music of all sorts that uses mild rock rhythms and some electric instruments in songs of the ballad type.)"}, "madsrdf:citationSource": "Grove music online, July 6, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(soft rock; The genre gained more widespread recognition following the rise of folk rock and the singer/songwriter tradition in the mid-1960s. These two styles, both based in the Los Angeles recording scene, ushered in a softer form of rock music which made a significant dent in the singles and album charts. Soft rock had the following identifying features: (1) the rock beat and other abrasive coloring (e.g., intense electric guitar lines, harsh vocalizing) were de-emphasized, and (2) song lyrics tended to be upbeat and/or introspective rather than rebellious in nature.)"}, "madsrdf:citationSource": "Soft rock and related styles, via Hybrid children of rock website, July 6, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3339067f307442ba83864797d4629b8b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(soft rock: rock music that is less driving and gentler sounding than hard rock)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, July 6, 2018", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026091"}
