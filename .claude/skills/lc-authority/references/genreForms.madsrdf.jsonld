6808"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFolk music", "identifiers:lccn": "gf2014026809", "madsrdf:adminMetadata": [{"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b1"}, {"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Folk music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026625"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026665"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026679"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026680"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026697"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026727"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026806"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026808"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026810"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026845"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026853"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026867"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026896"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026897"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026900"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026919"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026923"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026948"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026951"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026953"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026969"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026974"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027002"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027040"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027070"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027100"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027105"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027111"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027131"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027155"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027172"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026022"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026090"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026102"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026105"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026016"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026043"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026045"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026031"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026163"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026174"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026025"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026049"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026064"}], "madsrdf:hasSource": {"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b5"}, "madsrdf:hasVariant": [{"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b6"}, {"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Locally or regionally traditional music that was originally developed in performance and aurally transmitted in community contexts, and for music composed stylistically and/or ideologically within these traditions."}, {"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:25:18"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folk music"}}, {"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk music; this concept has been defined and developed in multiple ways by collectors, scholars, and practitioners, within different geographical locations and in different historical periods; has been used both covertly and overtly in the construction and negation of identities in relation to class, nation, or ethnicity and continues to be the source of controversy and heated debate; Volkslied coined by Johann Gottfried Herder, characteristics include necessity of production by \"communal composition\" and an aesthetic of \"dignity\"; from the late 19th century onwards, the concept became increasingly crucial to the debates on nationalism; English folksong collector Cecil Sharp perceived folk music as only produced by artisan and labouring rural people; argued that continuity, variation, and selection were the three vital components of folksongs and that anonymous composition and oral transmission were defining elements; International Folk Music Council attempted a definition of folk music in 1955: \"the product of a musical tradition that has been evolved through the process of oral transmission\"; from the 1960s onwards, North Americans increasingly extended the meaning of \"folk music\" to include the musics of ethnic and racial communities; for European countries, New Grove distinguishes between \"art\" music, \"folk\" or \"traditional\" music and \"popular\" music)"}, "madsrdf:citationSource": "Grove music online, viewed August 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Traditional music"}}, {"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Traditional music"}}, {"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ethnic music"}}, {"@id": "_:n4bc5a266dedf4c328f8ff8c972c7f6f4b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnic music"}}], "@id": "/authorities/genreForms/gf2014026809"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026810", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFolk-rock music", "identifiers:lccn": "gf2014026810", "madsrdf:adminMetadata": [{"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab1"}, {"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Folk-rock music"}, "madsrdf:elementList": {"@list": [{"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}], "madsrdf:hasSource": [{"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab5"}, {"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab6"}, {"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab7"}, {"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab8"}, {"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab9"}], "madsrdf:hasVariant": [{"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab10"}, {"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab13"}, {"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab16"}, {"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na191df9f29cc4b248dfaaf3f5fa84a0ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@va