{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026055", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCalendars", "identifiers:lccn": "gf2014026055", "madsrdf:adminMetadata": [{"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b1"}, {"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Calendars"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026140"}, "madsrdf:hasSource": [{"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b5"}, {"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b6"}, {"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b7"}, {"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Calendars"}}, {"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 31 (calendar)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(calendars. Registers of days or other contrivances for reckoning days, months, years, etc., such as a table showing the division of a given year into its months, weeks, days, years, or other divisions of time. A calendar may include important astronomical data, ecclesiastical or other festivals, and other events belonging to specific days.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(calendar: A tabular register of the days in a year, usually arranged by month and within each month by week, sometimes indicating the dates of important events such as national and religious holidays)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne9d7c9999cb845b28794840a6481e0d2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Calendars. Use for tabular registers of days, not for lists of manuscripts or documents; subdivide by date. BT Reference works. NT Perpetual calendars. RT Devotional calendars)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 26 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026055"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026056", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCaptivity narratives", "identifiers:lccn": "gf2014026056", "madsrdf:adminMetadata": [{"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b1"}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Captivity narratives"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026047"}, "madsrdf:hasSource": [{"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b5"}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b6"}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b7"}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b8"}], "madsrdf:hasVariant": [{"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b9"}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "First-person accounts of European settlers who were kidnapped by American Indians during the colonial period."}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Captivity narratives"}}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Captivity narratives. UF Indian captivity narratives. BT Narratives)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 26 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Captivity narratives: refers to accounts of Europeans detained by, or residing with, non-European peoples. By the eighteenth century, the captivity (and survival) genre was commonly associated with the kidnapping of white settlers by indigenous peoples as a tactic of warfare in North America. In the nineteenth century, increasingly romantic and formulaic texts of actual and fictional white captivity in various colonial locales were widely published throughout the English-speaking world, including the Australian colonies)"}, "madsrdf:citationSource": "The Oxford companion to Australian history, via Oxford reference online, Dec. 14, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Captivity narrative: account of kidnapping by Indians of white persons, usually women, taken by long journeys into the wilderness; the tale of Mary Rowlandson (1682) the earliest example; the genre passed into fiction with Ann Bleecker's The history of Maria Kittle (1797); later narratives were like melodramatic penny dreadfuls, as in R.B. Stratton's The captivity of the Oatman girls (1857) dealing with Far Western Indians)"}, "madsrdf:citationSource": "The Oxford companion to English literature, via Oxford reference online, Dec. 14, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(captivity narrative: An account of the experiences of a person captured and held against his or her will, usually by an enemy or by members of a society or culture foreign to the captive. Accounts by men and women of European descent, captured by Native Americans, were popular in the United States and Europe from the colonial period until the close of the frontier in the late 19th century. Narratives based on journals written in captivity are generally less fictionalized than accounts written from memory after the event.)"}, "madsrdf:citationSource": "Reitz, J.M ODLIS : online dictionary for library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Narratives, Captivity"}}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Narratives, Captivity"}}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indian captivity narratives"}}, {"@id": "_:n0227eb2b9c03495d8d4010573c51ef93b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indian captivity narratives"}}], "@id": "/authorities/genreForms/gf2014026056"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026057", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCatalogs", "identifiers:lccn": "gf2014026057", "madsrdf:adminMetadata": [{"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b1"}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Catalogs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026058"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026088"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026098"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027136"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026003"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026050"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027228"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027257"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026055"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026014"}], "madsrdf:hasSource": [{"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b5"}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b6"}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b7"}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b8"}], "madsrdf:hasVariant": {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Catalogs"}}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 32 (catalogue: register, systematic enumeration, list of books in a library)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(catalog: A comprehensive list of the books, periodicals, maps, and other materials in a given collection, arranged in systematic order to facilitate retrieval (usually alphabetically by author, title, and/or subject). In a more general sense, an enumeration of items systematically arranged for a specific purpose, usually with brief descriptive information included in each entry, for example, an exhibition catalog, auction catalog, catalogue raisonn\u00e9, course catalog, publisher's catalog, or film rental catalog.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(catalogs (documents). UF catalogues (documents). Enumerations of items, such as a file of bibliographic records or a list of art objects, usually arranged systematically and with descriptive details; may be in book or pamphlet form, on cards, or online. Catalogs are created according to specific and uniform principles of construction and usually under the control of an authority file.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Catalogs. Scope Note: Use for a list of items, arranged methodically, containing descriptive details for each item. BT Purpose of work (Gathering term; do not assign). NT Academic catalogs; Exhibition catalogs; Library catalogs; Museum catalogs; Sales catalogs. RT Price lists)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Catalogues"}}, {"@id": "_:nf8ed3623afb840c2a5c9af5cbdfe8698b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Catalogues"}}], "@id": "/authorities/genreForms/gf2014026057"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026058", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCatalogues raisonn\u00e9s", "identifiers:lccn": "gf2014026058", "madsrdf:adminMetadata": [{"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b1"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Catalogues raisonn\u00e9s"}, "madsrdf:elementList": {"@list": [{"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026057"}, "madsrdf:hasSource": [{"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b5"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b6"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b7"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b8"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b9"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b10"}], "madsrdf:hasVariant": [{"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b11"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comprehensive, annotated listings of an artist's works in one or more mediums, the works of a school of artists or art movement, or art works in a particular medium."}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:19:18"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Catalogues raisonn\u00e9s"}}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(catalogues raisonn\u00e9s. UF oeuvre catalogues. Complete, systematic, and critical listings of all the known works of a single artist, providing comprehensive information, including provenance, for each work.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 32 (catalogue raisonn\u00e9: descriptive catalogue with comments)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Catalogue raisonn\u00e9, A catalogue of an author's work, especially of an artist's pictures, engravings, etc., usually arranged by subjects, with comments, elucidations, appraisals, and bibliographical details. Also called Classed catalogue and Classified catalogue; Classified catalogue: A catalogue in which the entries are arranged in classified order of subjects, whether logically, in systematic order, exhibiting hierarchical relationship between subjects as in the systematic catalogue--the more usual, or alphabetically, as in the alphabetico-classed catalogue. It is usually in two parts: the classified file of entries in systematic order, and the alphabetical subject index to the classified file. Also called Classed catalogue, Classified subject catalogue.)"}, "madsrdf:citationSource": "The librarians' glossary of terms used in librarianship and the book crafts and reference book, 1971", "madsrdf:citationStatus": "found"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(catalogue raisonn\u00e9: A book or set of books listing and/or illustrating all the known works 1) of a particular artist (including photographers and architects), 2) of a school of artists or art movement, or 3) in a given medium, usually written by a leading expert and sometimes published as a supplement to another volume. As a general rule, each entry in the list includes date of production, size, condition, provenance, location, exhibition history, and other important information about the work. The images in a catalogue raisonn\u00e9 are often small and may be printed in black and white, the primary purpose being to authoritatively document the body of work rather than to display it for the reader's appreciation and enjoyment.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(catalogue raisonn\u00e9 see classed catalog; classed catalog: A subject catalog with primary arrangement of bibliographic records by the class numbers of a classification schedule; also includes an alphabetical index to the class numbers used. Synonymous with catalogue raisonn\u00e9, class catalog, classified catalog, classified subject catalog, and systematic catalog. Compare with alphabetico-classed catalog.)"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A catalogue raisonn\u00e9 is a comprehensive, annotated listing of all the known artworks by an artist either in a particular medium or all media. The works are described in such a way that they may be reliably identified by third parties. There are many variations, both broader and narrower than \"all the works\" or \"one artist\". The parameters may be restricted to one type of art work by one artist or widened to all the works by a group of artists. The spelling is never Americanized to \"catalog\", even in the United States. The French pluralization \"catalogues raisonn\u00e9s\" is used.)"}, "madsrdf:citationSource": "Wikipedia, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oeuvre catalogues"}}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oeuvre catalogues"}}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oeuvre catalogs"}}, {"@id": "_:nda7aa491cb6d4c48ba9ca2389d674758b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oeuvre catalogs"}}], "@id": "/authorities/genreForms/gf2014026058"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026059", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCensus data", "identifiers:lccn": "gf2014026059", "madsrdf:adminMetadata": [{"@id": "_:n218fa766a6fe46829aba45325e0be408b1"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Census data"}, "madsrdf:elementList": {"@list": [{"@id": "_:n218fa766a6fe46829aba45325e0be408b3"}]}, "madsrdf:exampleNote": "Notes under [Demographic surveys; Vital statistics]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026163"}, "madsrdf:hasReciprocalAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026207"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026102"}], "madsrdf:hasSource": [{"@id": "_:n218fa766a6fe46829aba45325e0be408b5"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b6"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b7"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b8"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b9"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b10"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b11"}], "madsrdf:hasVariant": [{"@id": "_:n218fa766a6fe46829aba45325e0be408b12"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b15"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b18"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b21"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b24"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b27"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b30"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Official counts of the population of a place or ethnic group that sometimes include data relating to economic and social conditions. For reports about the social, economic, health, or other characteristics of a population that are generally based on estimates calculated through sampling techniques see [Demographic surveys.] For official public records of births, deaths, marriages, divorces, and other life events see [Vital statistics.]"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-14T12:45:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Census data"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 32 (census return: published results of census)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 103 (census records) p. 104 (provide some of the most fascinating and useful pieces of personal history to be found in any source; if nothing else, census records are important sources for placing individuals in specific places at specific times)"}, "madsrdf:citationSource": "The source : a guidebook of American genealogy, c1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(census: An official count and statistical analysis of the living population of a species (human or nonhuman) in a given geographic area (city, county, state, province, country, etc.) taken at a particular point in time. A census is distinct from a sampling in which information obtained about a portion of a population is used as the basis for generalization about the whole. In the United States, the national census, mandated by the federal Constitution, is conducted every ten years by the U.S. Census Bureau, which reports the detailed results in statistical form by state. Census data is used to apportion seats in Congress and to gather demographic and economic information about citizens and other residents, later compiled and analyzed in federal statistical publications. U.S. census data is available in the government documents collections of larger libraries and online at www.census.gov)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(census returns. The first census for the whole of Britain, except Ireland, was taken in 1801, but no central archival material survives from that exercise or from the following censuses of 1811, 1821, and 1831. A few schedules compiled by the census takers have come to light in local record offices, but the great bulk of this material was destroyed ...The transcriptions, or 'enumerators' returns', for 1841-91 survive ... Many family history societies have also made indexes of the personal names in the census returns for their area; census enumerators' returns)"}, "madsrdf:citationSource": "The Oxford companion to local and family history, 1996", "madsrdf:citationStatus": "found"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(census records. UF census returns; census schedules. Official, usually periodic, lists of persons or property with varying degrees of descriptive detail)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xi (American genealogists have long been constructing their family histories using information gathered from census records) p. 1 (Census records by state)"}, "madsrdf:citationSource": "Kemp, T.J. The American census handbook, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Census Figures. BT Statistical Data)"}, "madsrdf:citationSource": "ERIC thesaurus, via WWW, Oct. 3, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n218fa766a6fe46829aba45325e0be408b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Census figures"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Census figures"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n218fa766a6fe46829aba45325e0be408b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Returns, Census"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Returns, Census"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n218fa766a6fe46829aba45325e0be408b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Data, Census"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Data, Census"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n218fa766a6fe46829aba45325e0be408b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Census returns"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Census returns"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n218fa766a6fe46829aba45325e0be408b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Census schedules"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Census schedules"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n218fa766a6fe46829aba45325e0be408b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Census records"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Census records"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n218fa766a6fe46829aba45325e0be408b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Schedules, Census"}}, {"@id": "_:n218fa766a6fe46829aba45325e0be408b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Schedules, Census"}}], "@id": "/authorities/genreForms/gf2014026059"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026060", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCharades", "identifiers:lccn": "gf2014026060", "madsrdf:adminMetadata": [{"@id": "_:ne4585499ecd343528e95d05a7c2d547eb1"}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Charades"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne4585499ecd343528e95d05a7c2d547eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, "madsrdf:hasSource": [{"@id": "_:ne4585499ecd343528e95d05a7c2d547eb5"}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb6"}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb7"}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb8"}], "madsrdf:hasVariant": {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Charades"}}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Charades or charade is a word guessing game. In the form most played today, it is an acting game in which one player acts out a word or phrase, often by miming similar-sounding words, and the other players guess the word or phrase. The idea is to use physical rather than verbal language to convey the meaning to another party. It was originally also used to indicate a riddle either in verse or prose, of which the listener must guess the meaning, often given syllable by syllable--see riddle. In France and Italy the word 'charade' still refers to this kind of written linguistic riddle.)"}, "madsrdf:citationSource": "Wikipedia, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Charades. BT Amateur plays; Amusements; Literary recreations; Tableaux. RT Riddles)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Charades. Use for collections of puzzles and conundrums in which words, phrases, concepts, short dramatic scenes, etc. are meant to be conveyed by brief enigmatic rhymes or by means of pantomime, to be interpreted by listeners or onlookers. UF Acting charades. BT Puzzles)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(charade 1. A word or phrase acted out or described as in verse, for others to guess)"}, "madsrdf:citationSource": "Webster's new world dictionary, c1998", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne4585499ecd343528e95d05a7c2d547eb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Acting charades"}}, {"@id": "_:ne4585499ecd343528e95d05a7c2d547eb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Acting charades"}}], "@id": "/authorities/genreForms/gf2014026060"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026061", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGraphs", "identifiers:lccn": "gf2014026061", "madsrdf:adminMetadata": [{"@id": "_:na692120b1f844964aa1e0a014bd3eec2b1"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Graphs"}, "madsrdf:elementList": {"@list": [{"@id": "_:na692120b1f844964aa1e0a014bd3eec2b3"}]}, "madsrdf:exampleNote": "Note under [Tables (Data)]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026186"}, "madsrdf:hasSource": [{"@id": "_:na692120b1f844964aa1e0a014bd3eec2b5"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b6"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b7"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b8"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b9"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b10"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b11"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b12"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b13"}], "madsrdf:hasVariant": [{"@id": "_:na692120b1f844964aa1e0a014bd3eec2b14"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b17"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b20"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b23"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b26"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b29"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Graphic representations of data. For data in textual form arranged in columns and rows see [Tables (Data).]"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:26:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphs"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(chart 1. a sheet exhibiting information in tabular form. 2. a graphic representation, as by curves, of a dependent variable, as temperature, price, etc.; graph.)"}, "madsrdf:citationSource": "Dictionary.com, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(chart: A special-purpose map designed primarily to meet the requirements of navigation or one showing meteorological phenomena or heavenly bodies. A nautical chart indicates soundings, currents, coastlines, and other important maritime features. Also, an opaque sheet on which data is displayed in graphic or tabular form, for example, a calendar. See also: flip chart.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS: online dictionary for library and information science, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wikipedia, July 25, 2014 (A chart is a graphical representation of data, in which \"the data is represented by symbols, such as bars in a bar chart, lines in a line chart, or slices in a pie chart\". A chart can represent tabular numeric data, functions or some kinds of qualitative structure and provides different info. The term \"chart\" as a graphical representation of data has multiple meanings: A data chart is a type of diagram or graph, that organizes and represents a set of numerical or qualitative data. Maps that are adorned with extra information for some specific purpose are often known as charts, such as a nautical chart or aeronautical chart. Other domain specific constructs are sometimes called charts, such as the chord chart in music notation or a record chart for album popularity. ... Typically the data in a chart is represented graphically, since humans are generally able to infer meaning from pictures quicker than from text. Text is generally used only to annotate the data.)", "madsrdf:citationStatus": "found"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(charts (graphic documents). A tabular or graphic representation of a fluctuating or dependent variable, such as magnitude, temperature, cost, etc.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(chart 1. An opaque sheet that exhibits data in the form of graphs or tables, or by the use of contours, shapes, or figures.)"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Chart 1) A two-dimensional representation of data in graphic or tabular form (e.g., a wall chart). 2) A map designed primarily for navigation through water, air, or space.)"}, "madsrdf:citationSource": "RDA glossary, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Spreadsheets webpage (Charts are what we call graphs in math class. Charts are visual representations of worksheet data. Charts often makes it easier to understand the data in a worksheet because users can easily pick out patterns and trends illustrated in the chart that are otherwise difficult to see. Different types of charts serve different purposes; pie charts; column charts; bar charts; line charts)"}, "madsrdf:citationSource": "About.com Computing website, July 25, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(chart 2 a : a sheet giving information in tabular form b : graph c : diagram)"}, "madsrdf:citationSource": "Merriam-Webster online, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(chart: a list, drawing, or graph showing information in a way that is easy to understand)"}, "madsrdf:citationSource": "Macmillian dictionary online, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na692120b1f844964aa1e0a014bd3eec2b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Diagrams"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Diagrams"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na692120b1f844964aa1e0a014bd3eec2b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pie charts"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pie charts"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na692120b1f844964aa1e0a014bd3eec2b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Charts (Graphs)"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Charts (Graphs)"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na692120b1f844964aa1e0a014bd3eec2b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Line charts"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Line charts"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na692120b1f844964aa1e0a014bd3eec2b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bar charts"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bar charts"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na692120b1f844964aa1e0a014bd3eec2b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Column charts"}}, {"@id": "_:na692120b1f844964aa1e0a014bd3eec2b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Column charts"}}], "@id": "/authorities/genreForms/gf2014026061"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026062", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChronologies", "identifiers:lccn": "gf2014026062", "madsrdf:adminMetadata": [{"@id": "_:n64f517611c084fdc8ddc182259848c8fb1"}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Chronologies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n64f517611c084fdc8ddc182259848c8fb3"}]}, "madsrdf:exampleNote": "Note under [Annals and chronicles]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2013025058"}, "madsrdf:hasSource": [{"@id": "_:n64f517611c084fdc8ddc182259848c8fb5"}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb6"}], "madsrdf:hasVariant": [{"@id": "_:n64f517611c084fdc8ddc182259848c8fb7"}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb10"}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb13"}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Lists of events arranged by date or time. For discussions of events written in chronological order see [Annals and chronicles.]"}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-05-25T13:49:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chronologies"}}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(chronology: A book or section of a book that lists events and their dates in the order of their occurrence. Most chronologies are limited to a specific period, event, or theme. Book-length chronologies are usually shelved in the reference section of a library. In a more general sense, a document that describes events or other information in order of their occurrence, to allow the reader to follow their development in time.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(chronologies (lists). Tables, lists, or treatises listing events, biographies, milestones, or other items in serial temporal order relative to given dates or time periods.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n64f517611c084fdc8ddc182259848c8fb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Timelines"}}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Timelines"}}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n64f517611c084fdc8ddc182259848c8fb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chronological lists"}}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chronological lists"}}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n64f517611c084fdc8ddc182259848c8fb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tables, Chronological"}}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tables, Chronological"}}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n64f517611c084fdc8ddc182259848c8fb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chronological tables"}}, {"@id": "_:n64f517611c084fdc8ddc182259848c8fb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chronological tables"}}], "@id": "/authorities/genreForms/gf2014026062"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026063", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCity directories", "identifiers:lccn": "gf2014026063", "madsrdf:adminMetadata": [{"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b1"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "City directories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026087"}, "madsrdf:hasSource": [{"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b5"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b6"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b7"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b8"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b9"}], "madsrdf:hasVariant": [{"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b10"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b13"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "City directories"}}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(city directory: A three-way directory that lists the residents and businesses located in a specific town or city alphabetically by name, with street address and telephone number included in each entry. In a second section, name(s) and addresses are listed by phone number, and in a third section, names and phone numbers are listed by street address. Published annually and sold by subscription, current city directories often include zip code and census tract locators for use in marketing. Synonymous with cross-reference directory.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (City directories, arguably one of the most over-looked resources by genealogists, have been around since the 1700s.)"}, "madsrdf:citationSource": "City directories of the United States of America website, July 28, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(City directories. Use for works containing names, addresses, and other identifying data of inhabitants and/or businesses of a city or cities. UF Local directories. BT Directories)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (These directories provide a great deal of information for genealogists, local history researchers, and history enthusiasts, including: historical information about Seattle and the surrounding area; addresses & occupations of residents; business listings; advertisements; and information about schools, churches, & social organizations.)"}, "madsrdf:citationSource": "Seattle city directories, via The Seattle Public Library website, July 28, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (town directories)"}, "madsrdf:citationSource": "Directories in England and Wales, via FamilySearch website, July 28, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Local directories"}}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Local directories"}}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Town directories"}}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Town directories"}}, {"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n80e5e35f05f84a9a90e36bcd0ce4aea1b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cross-reference directories"}}, {"@id": "_:n80e5e35f05f84a9a90e36bc