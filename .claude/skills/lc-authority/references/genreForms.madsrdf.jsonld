@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Erotic television programs"}}, {"@id": "_:n67a1172bd86e40a9a4154cf34d81f7a4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 46 (Erotica: use for film and video the content of which is primarily sexual or sex-related, and which tends to be produced and distributed by small, independent companies. UF Pornographic works; Adult films and video)"}, "madsrdf:citationSource": "Yee, Martha M. Moving image materials : genre terms, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n67a1172bd86e40a9a4154cf34d81f7a4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(adult, adj.: containing or dealing in explicitly sexual material, ... adult movies, adult bookstores)"}, "madsrdf:citationSource": "Am. heritage dict.", "madsrdf:citationStatus": "found"}, {"@id": "_:n67a1172bd86e40a9a4154cf34d81f7a4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(erotic: Sexually oriented material that is not of an explicit nature; related term: pornography; pornography: Work representing persons \"engaged in explicit, usually unfaked, sexual acts with a primary intent of arousing viewers.\" (Linda Williams, Hard Core, p. 30))"}, "madsrdf:citationSource": "Moving image genre form guide online, July 2, 2007", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026228"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026229", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEthnic films", "identifiers:lccn": "gf2011026229", "madsrdf:adminMetadata": [{"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb1"}, {"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ethnic films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasReciprocalAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026483"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026747"}], "madsrdf:hasSource": [{"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb5"}, {"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb6"}, {"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films made by or intended for a specific ethnic audience and that often feature ethnic experiences.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025610"}}, {"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T13:44:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnic films"}}, {"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ethnic (Nonfiction): work that focuses on issues and individuals relating to the American ethnic experience. Ethnic: Fictional work typically made for viewing by ethnic audiences, most prominently African American, Yiddish, and Latino. Similar work has also been made in much smaller quantities for such groups as Ukrainian, Armenian, Italian, Greek, Polish, Japanese, Chinese, Vietnamese, and Native Americans...Fictional narratives typically present situations unique to the specific group, and are often based on classical ethnic plays and stories, or feature performers who are stars within their community, but may not be as well known to a broader public...The designation of this genre term does not necessarily connote the veracity of the portrayals, but rather, indicates the main focus of the subject matter)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 3, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 93-94 (Ethnic film; Race film: films made by or addressed to a country's ethnic and cultural minorities; also applies to films which look at the characteristics of a particular race or ethnic group, or examine the cultural interrelationships existing amongst different cultures)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9f504da2a09844c5989f305df0ac7ebcb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: El Norte, 1983.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026229"}
