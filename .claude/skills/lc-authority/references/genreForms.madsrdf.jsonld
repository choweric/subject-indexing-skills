{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026124", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLogic puzzles", "identifiers:lccn": "gf2014026124", "madsrdf:adminMetadata": [{"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b1"}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Logic puzzles"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, "madsrdf:hasSource": [{"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b5"}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b6"}], "madsrdf:hasVariant": [{"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b7"}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Logic puzzles"}}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Logic puzzles. UF Logical puzzles. BT Mathematical recreations)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Logic puzzles come in all shapes and sizes, but the kind of puzzles we offer here are most commonly referred to as \"logic grid\" puzzles. In each puzzle you are given a series of categories, and an equal number of options within each category. Each option is used once and only once. Your goal is to figure out which options are linked together based on a series of given clues. Each puzzle has only one unique solution, and each can be solved using simple logical processes (i.e. educated guesses are not required).)"}, "madsrdf:citationSource": "Logic-Puzzles.org website, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Logical puzzles"}}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Logical puzzles"}}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Logic grid puzzles"}}, {"@id": "_:nf69d941ea7ed4f18872bf9c14b8b72a1b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Logic grid puzzles"}}], "@id": "/authorities/genreForms/gf2014026124"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026125", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMaze puzzles", "identifiers:lccn": "gf2014026125", "madsrdf:adminMetadata": [{"@id": "_:n1afedf1b78a54732972527bd8a774a67b1"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Maze puzzles"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1afedf1b78a54732972527bd8a774a67b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, "madsrdf:hasSource": [{"@id": "_:n1afedf1b78a54732972527bd8a774a67b5"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b6"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b7"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b8"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b9"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b10"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b11"}], "madsrdf:hasVariant": [{"@id": "_:n1afedf1b78a54732972527bd8a774a67b12"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maze puzzles"}}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (Mazelog is a collection of original logic maze puzzles. Unlike conventional mazes, the route through these mazes is defined not by paths and walls, but by logical rules determining how you can move.)"}, "madsrdf:citationSource": "Mazelog website, Aug. 7, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Blundell, K. The Usborne book of maze puzzles, 1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Maze puzzles. UF Mazes. BT Labyrinths; Puzzles)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mazes. UF Labyrinths. BT Passageways; Puzzles)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Aug. 7, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Amazing puzzle mazes, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (mazes; maze puzzles)"}, "madsrdf:citationSource": "Mazes to print website, Aug. 7, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A maze is a tour puzzle in the form of a complex branching passage through which the solver must find a route. The pathways and walls in a maze are fixed, and puzzles in which the walls and paths can change during the game are categorised as tour puzzles. The Cretan labyrinth is the oldest known maze. Technically the maze is distinguished from the labyrinth, which has a single through-route with twists and turns but without branches, and is not designed to be as difficult to navigate. In everyday speech, both maze and labyrinth denote a complex and confusing series of pathways.)"}, "madsrdf:citationSource": "Wikipedia, Aug. 7, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1afedf1b78a54732972527bd8a774a67b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Puzzle mazes"}}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puzzle mazes"}}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1afedf1b78a54732972527bd8a774a67b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mazes (Puzzles)"}}, {"@id": "_:n1afedf1b78a54732972527bd8a774a67b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mazes (Puzzles)"}}], "@id": "/authorities/genreForms/gf2014026125"}
