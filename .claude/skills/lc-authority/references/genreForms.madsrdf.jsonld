{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026282", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDialect drama", "identifiers:lccn": "gf2014026282", "madsrdf:adminMetadata": [{"@id": "_:n2f9bbbc654bc443e8eeb005c081caa3fb1"}, {"@id": "_:n2f9bbbc654bc443e8eeb005c081caa3fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dialect drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2f9bbbc654bc443e8eeb005c081caa3fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n2f9bbbc654bc443e8eeb005c081caa3fb5"}, {"@id": "_:n2f9bbbc654bc443e8eeb005c081caa3fb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that incorporate the speech patterns of a particular region or social group."}, {"@id": "_:n2f9bbbc654bc443e8eeb005c081caa3fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2f9bbbc654bc443e8eeb005c081caa3fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T13:01:33"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2f9bbbc654bc443e8eeb005c081caa3fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dialect drama"}}, {"@id": "_:n2f9bbbc654bc443e8eeb005c081caa3fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dialect drama)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f9bbbc654bc443e8eeb005c081caa3fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dialect. A particular variation of a language spoken by members of a class or region. A dialect may include a distinct vocabulary, syntax, conversational style, or accent. In rendering a specific accent, many contemporary writers attempt to capture its distinctive features without resorting to the distracting practice of phonic spelling, which was a feature of dialect writing around the turn of the century.)"}, "madsrdf:citationSource": "Quinn, E. A dict. of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026282"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026283", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDialect fiction", "identifiers:lccn": "gf2014026283", "madsrdf:adminMetadata": [{"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb1"}, {"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dialect fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb5"}, {"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb6"}, {"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works of fiction that incorporate the speech patterns of a particular region or social group."}, {"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T13:01:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dialect fiction"}}, {"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A literary dialect is best defined as an author's attempt to represent in writing a speech that is restricted regionally, socially or both. The use of regional dialects in creative literature (short story, novel, drama, poetry) gives an authenticity to the creative work.)"}, "madsrdf:citationSource": "Karantzi, C. Literary dialects and dialectal literature, via WWW, Oct. 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dialect: A language or manner of speaking peculiar to an individual or class or region. Usually belongs to a region. A dialect differs from the standard language of a country, in some cases very considerably. A good deal of literature is in dialect, especially that created in the earlier stages of a country's civilization. A large number of novelists have used dialect forms, particularly to give verisimilitude to dialogue.)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:na40a8387701e48f2a3a2eb04bf573ffbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dialect: The distinctive habits of speech used by a particular race, class or regional group. \"y'all\", for example is an example of southern dialect. Effective dialect in general will be composed of a combination of techniques, expressing the rhythms of entire sentences rather than simply substituting standard English words with colorful regionalisms. See eye dialect. Eye dialect: An author's misspelling of a word to indicate that it is being spoken by an ignorant or non-native speaker of the language--even though, if the word were actually pronounced the way it has been misspelled, the pronunciation would be the standard, correct spelling. In the sentence, \"Ah cain't kum raht naow,\" \"kum\" is eye-dialect spelling.)"}, "madsrdf:citationSource": "Henry, L. A fiction dictionary, c1995", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026283"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026284", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDialect poetry", "identifiers:lccn": "gf2014026284", "madsrdf:adminMetadata": [{"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b1"}, {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dialect poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b5"}, {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b6"}, {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b7"}], "madsrdf:hasVariant": {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that incorporate the speech patterns of a particular region or social group."}, {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T13:02:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dialect poetry"}}, {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dialect: A particular variation of a language spoken by members of a class or region. A dialect may include a distinct vocabulary, syntax, conversational style, or accent. In rendering a specific accent, many contemporary writers attempt to capture its distinctive features without resorting to the distracting practice of phonic spelling, which was a feature of writing around the turn of the century.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dialect poetry: In every culture or nation-state of any size there is normally more than one distinct way of speaking the language; these are dialects. The line between two dialects of one language and two languages is very difficult to draw in theory, but in practice the differences seem to be lexical; quite a few major literatures of the world have produced poems of major importance in dialects other than the standard language, whether in the language of the provinces, or of the urban poor, or of minorities; understanding of dialect poetry is essential to the thorough appreciation of any national poetry)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 14 (Dialect poetry: an important development that paralleled the \"local color\" movement in fiction; there is dialect poetry ... written in the voices of blacks, Chinese, Jews, Irish, Germans, rural whites, and others.)"}, "madsrdf:citationSource": "Heath anthology of American literature, c1990:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dialect poems"}}, {"@id": "_:ndc22796f322f48cb96b17a0c1eeb5399b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dialect poems"}}], "@id": "/authorities/genreForms/gf2014026284"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026285", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDialogues (Literature)", "identifiers:lccn": "gf2014026285", "madsrdf:adminMetadata": [{"@id": "_:ne1f240e6659a449b8a5625959a4d348ab1"}, {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dialogues (Literature)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne1f240e6659a449b8a5625959a4d348ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026125"}, "madsrdf:hasSource": [{"@id": "_:ne1f240e6659a449b8a5625959a4d348ab5"}, {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab6"}, {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab7"}], "madsrdf:hasVariant": {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-05T13:55:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dialogues (Literature)"}}, {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dialogue. Spoken exchanges between or among characters in a dramatic or narrative work; or a literary form in prose or verse based on a debate or discussion, usually between two speakers)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dialogues. UF Dialogs)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dialogue, the. In addition to being a feature of fiction and drama which represents characters' speech, the dialogue is also a type of literature in which two or more people engage in a discussion. By the 19th century the form had fallen into disuse; nevertheless the dialogue has made occasional reappearances in modern literature, notably in the poems of Paul Val\u00e9ry)"}, "madsrdf:citationSource": "Quinn, E. A dict. of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne1f240e6659a449b8a5625959a4d348ab9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dialogs (Literature)"}}, {"@id": "_:ne1f240e6659a449b8a5625959a4d348ab9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dialogs (Literature)"}}], "@id": "/authorities/genreForms/gf2014026285"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026286", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDiary fiction", "identifiers:lccn": "gf2014026286", "madsrdf:adminMetadata": [{"@id": "_:n6b1c917d152543a4b24b53c57ce5214db1"}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Diary fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6b1c917d152543a4b24b53c57ce5214db3"}]}, "madsrdf:exampleNote": "Note under [Epistolary fiction]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n6b1c917d152543a4b24b53c57ce5214db5"}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db6"}], "madsrdf:hasVariant": [{"@id": "_:n6b1c917d152543a4b24b53c57ce5214db7"}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db10"}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db13"}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db16"}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction written in diary form. For fiction written wholly or partially in the form of letters, telegrams, electronic mail messages, instant messages, etc., see [Epistolary fiction.]"}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-03T08:30:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Diary fiction"}}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Diary fiction: fiction written in the form of a character's journal or diary. Diary fiction shares a lot with epistolary fiction (a story made up of letters) in that the author tries to create the illusion stat the story was written by one of the characters.)"}, "madsrdf:citationSource": "Henry, L. The fiction dictionary, c1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Diary fiction. Here are entered works of fiction written in diary form. Works of fiction written wholly or partially in the form of letters, telegrams, electronic mail messages, instant messages, etc. are entered under Epistolary fiction. UF Dagboksromans; Diary novels; Epistolary journals (Fiction); Fictional journals; Journal novels; Journals, Fictional)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b1c917d152543a4b24b53c57ce5214db8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Journals, Fictional"}}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Journals, Fictional"}}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b1c917d152543a4b24b53c57ce5214db11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fictional diaries"}}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fictional diaries"}}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b1c917d152543a4b24b53c57ce5214db14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Diaries, Fictional"}}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Diaries, Fictional"}}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b1c917d152543a4b24b53c57ce5214db17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fictional journals"}}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fictional journals"}}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b1c917d152543a4b24b53c57ce5214db20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Journal novels"}}, {"@id": "_:n6b1c917d152543a4b24b53c57ce5214db20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Journal novels"}}], "@id": "/authorities/genreForms/gf2014026286"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026287", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDidactic drama", "identifiers:lccn": "gf2014026287", "madsrdf:adminMetadata": [{"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b1"}, {"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Didactic drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026442"}, "madsrdf:hasSource": [{"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b5"}, {"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b6"}, {"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that are intended to be instructional."}, {"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T13:02:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Didactic drama"}}, {"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(didactic. Any work of literature which sets out to instruct may be called didactic. The Middle Ages produced the bulk of didactic literature in Europe and most of it was in verse.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dict. of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Didactic drama)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n16ea922a95f94c4fabaf3f7bcac2a771b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(didactic. Instructive; designed to impart information, advice, or some doctrine of morality or philosophy. Much of the most ancient surviving literature is didactic, containing genealogies, proverbial wisdom, and religious instruction. Since the ascendancy of romanticism and aestheticism in the 19th century, didactic writing has been viewed unfavourably as foreign to true art.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026287"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026288", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDidactic fiction", "identifiers:lccn": "gf2014026288", "madsrdf:adminMetadata": [{"@id": "_:na93ec7f9e99c461693719b2496362041b1"}, {"@id": "_:na93ec7f9e99c461693719b2496362041b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Didactic fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:na93ec7f9e99c461693719b2496362041b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}], "madsrdf:hasSource": [{"@id": "_:na93ec7f9e99c461693719b2496362041b5"}, {"@id": "_:na93ec7f9e99c461693719b2496362041b6"}, {"@id": "_:na93ec7f9e99c461693719b2496362041b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that is intended to be instructional."}, {"@id": "_:na93ec7f9e99c461693719b2496362041b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na93ec7f9e99c461693719b2496362041b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T13:02:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na93ec7f9e99c461693719b2496362041b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Didactic fiction"}}, {"@id": "_:na93ec7f9e99c461693719b2496362041b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Didactic fiction: Use for works that are primarily intended to teach a lesson)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:na93ec7f9e99c461693719b2496362041b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(didactic: instructive; designed to impart information, advice, or some doctrine of morality or philosophy. In the broadest sense, most allegories and satires implying a moral or political view may be regarded as didactic, along with many other kinds of work in which the theme embodies some philosophical or other belief of the author. A stricter definition would confine the term to those works that explicitly tell the reader what they should do.)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:na93ec7f9e99c461693719b2496362041b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Didactic fiction: usually a pejorative term describing fiction whose goal is to teach the reader something; fiction that tries to teach the reader to feel a certain way about some subject, rather than to impart objective information.)"}, "madsrdf:citationSource": "Henry, L. The fiction dictionary, c1995", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026288"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026289", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDidactic poetry", "identifiers:lccn": "gf2014026289", "madsrdf:adminMetadata": [{"@id": "_:n69c1c558fd654845b55d15c0660a7e78b1"}, {"@id": "_:n69c1c558fd654845b55d15c0660a7e78b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Didactic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n69c1c558fd654845b55d15c0660a7e78b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026070"}, "madsrdf:hasSource": [{"@id": "_:n69c1c558fd654845b55d15c0660a7e78b5"}, {"@id": "_:n69c1c558fd654845b55d15c0660a7e78b6"}, {"@id": "_:n69c1c558fd654845b55d15c0660a7e78b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that are intended to be instructional."}, {"@id": "_:n69c1c558fd654845b55d15c0660a7e78b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n69c1c558fd654845b55d15c0660a7e78b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T13:02:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n69c1c558fd654845b55d15c0660a7e78b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Didactic poetry"}}, {"@id": "_:n69c1c558fd654845b55d15c0660a7e78b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Didactic: Any work of literature which sets out to instruct may be called didactic. Didactic poetry is almost a special category of its own)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms, 1982", "madsrdf:citationStatus": "found"}, {"@id": "_:n69c1c558fd654845b55d15c0660a7e78b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Didactic poetry: Poetry that is intended primarily to teach a lesson)"}, "madsrdf:citationSource": "Harmon, J. A handbook to literature, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n69c1c558fd654845b55d15c0660a7e78b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Didactic poetry: Poetry that teaches something; more specifically, poetry whose primary purpose is to instruct)"}, "madsrdf:citationSource": "Drury, J. The poetry dictionary, c2006", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026289"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026290", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDiscussion plays", "identifiers:lccn": "gf2014026290", "madsrdf:adminMetadata": [{"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b1"}, {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Discussion plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026487"}, "madsrdf:hasSource": [{"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b5"}, {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b6"}, {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b7"}], "madsrdf:hasVariant": {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays in which debate and discussion on social problems are more important than plot, action, or character."}, {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:08:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Discussion plays"}}, {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(discussion play. A kind of drama in which debate and discussion are more important than plot, action, or character. Some of Bernard Shaw's plays are of this kind, notably Misalliance (1910) and Heartbreak House (1919). See also Problem play)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under thesis play: A drama which deals with a specific problem and, very probably, offers a solution. This type of drama is also known as a problem or propaganda play. A sub-species of the problem play is what has been called the 'discussion play'. This is more like a debate in which characters put forward different points of view.)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Problem Play. A type of drama that was popularized by the Norwegian playwright Henrik Ibsen. In problem plays, the situation faced by the protagonist is put forward by the author as a representative instance of a contemporary social problem; often the dramatist manages--by the use of a character who speaks for the author, or by the evolution of the plot, or both--to propose a solution to the problem which is at odds with prevailing opinion. A subtype of the modern problem play is the discussion play, in which the social issue is not incorporated into a plot but expounded in the give and take of a sustained debate among the characters.)"}, "madsrdf:citationSource": "Abrams, M. A glossary of literary terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Discussion drama"}}, {"@id": "_:n0c5743cbe39246c9a2a2851205c5b539b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Discussion drama"}}], "@id": "/authorities/genreForms/gf2014026290"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026291", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDoctrine and Covenants stories", "identifiers:lccn": "gf2014026291", "madsrdf:adminMetadata": [{"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b1"}, {"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Doctrine and Covenants stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasSource": [{"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b5"}, {"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b6"}], "madsrdf:hasVariant": {"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Paraphrases of Doctrine and Covenants texts in story form."}, {"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T14:59:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Doctrine and Covenants stories"}}, {"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Doctrine and Covenants stories)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Doctrine and Covenants stories, c2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories, Doctrine and Covenants"}}, {"@id": "_:nf2a63eee299a490e8639f9a940dac2e7b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories, Doctrine and Covenants"}}], "@id": "/authorities/genreForms/gf2014026291"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026292", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDocumentary comics", "identifiers:lccn": "gf2014026292", "madsrdf:adminMetadata": [{"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb1"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Documentary comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb3"}]}, "madsrdf:exampleNote": "Note under [Comics journalism]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026453"}, "madsrdf:hasSource": [{"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb5"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb6"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb7"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb8"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb9"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb10"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb11"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics intended to document reality to instruct, educate, or maintain a historical record. For comics that employ journalistic techniques, such as interviews, to report on news or nonfiction topics, see [Comics journalism.]"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-11T12:18:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentary comics"}}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 93 (\"In comics studies the term documentary has emerged in response to the notable expansion in comics works that uses witnessing as methodology and presents 'encounter' as a prominent feature. However, documentary can also describe the process of using archival sources to retrospectively construct a narrative\"; \"Documentary comics have been situated in relation to a range of historical precursors, including but not limited to illustrated journalism\"; \"The umbrella term documentary captures concerns shared by comics journalism, biography, autobiography and comics performing advocacy: narrative construction and notions of authenticity, credibility and claims to truth, questions of intent, affect and the ethics of representation\")"}, "madsrdf:citationSource": "Key Terms in comics studies, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 29 (\"Documentary comics: comics that claim to truthfully represent historical people, sociohistorical issues, and events in specific, actual contexts\")"}, "madsrdf:citationSource": "Pedri, N. A concise dictionary of comics, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Documentary comic books, strips, etc.)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"with the pioneering work of Joe Sacco, comics has also been fruitfully employed to materialize the experiences of others, often from marginalized groups. Yet, as this special issue shows, graphic narrative forms a long-standing tradition of addressing 'realities' that precedes the current format of the graphic reportage. Comics have been analyzed and theorized as works of documentary ..., history ... and journalism\"; \"These different genres all face the challenge to do justice to the lives of other people, with a keen awareness of their responsibilities to the encountered witnesses\")"}, "madsrdf:citationSource": "Schlichting, L. Introduction to graphic realities : comics as documentary, history, and journalism, in ImageText v. 11, iss. 1, 2019, viewed May 18, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Documentary: 4. \"Factual, realistic; applied esp. to a film or literary work, etc., based on real events or circumstances, and intended primarily for instruction or record purposes\")"}, "madsrdf:citationSource": "Oxford English dictionary, viewed May 15, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 42 (journalistic comics \"are sometimes wrongly equated with 'documentary comics.' But while documentary 'is about the presentation of evidence' ... the journalistic form of reportage negotiates between 'artistically reshaped journalism and journalistically legitimized art'\") (OCoLC)1263743261"}, "madsrdf:citationSource": "Schlichting, L. Authorship in comics journalism, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 311 (Peruvian comics artist Jesus Cossio prefers \"to call what I do documentary comics\" because he \"did not do any journalistic fieldwork, but looked for [already created] documentation\" about the topics of his comics)"}, "madsrdf:citationSource": "Jordan Schnitzer Museum of Art. Art of the news : comics journalism, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf40ee0a3c1f14431b85ad6a50891035cb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 7 (\"documentary comics\" concerned with \"the politics of representation historically embedded in social realism\") p. 8 (\"'documentary manga'\" as \"manga with pedagogical aims and factual content\") p. 9 (\"those comics that take the actual and historical real as their subject and documentary (more commonly assumed to be identified by its use of recording technologies) share an ambition to narrate and visually represent real people, events, and experiences, and consequently offer their readers and audiences comparable positions\"; \"documentary involves construction rather than transparent duplication of the reality it records\")"}, "madsrdf:citationSource": "Mickwitz, N. Documentary comics : graphic truth-telling in a skeptical age, 2016:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026292"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026293", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDoggerel", "identifiers:lccn": "gf2014026293", "madsrdf:adminMetadata": [{"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b1"}, {"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Doggerel"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b5"}, {"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b6"}, {"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b7"}, {"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Irregularly fashioned poems that are often of a humorous or burlesque nature."}, {"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:00:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Doggerel"}}, {"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Doggerel: Rude verse. Any poorly executed attempt at poetry. Characteristic of doggerel are monotony of rhyme and rhythm, cheap sentiment and trivial, trite subject matter. Some doggerel does, however, because of certain humorous and burlesque qualities, become amusing and earn a place in one of the lower shelves of literature.)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Doggerel: Rough, crudely written verse, usually)"}, "madsrdf:citationSource": "Beckson, K. Literary terms, 1989", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(doggerel: of poetry: quickly contrived, loose, and often irregular especially if also burlesque or comic)"}, "madsrdf:citationSource": "Merriam-Webster unabridged online dictionary, March 17, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d675f0b5abc4b09a30431f8a9173ea7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Doggerel: Rough, poorly constructed verse, characterized by either (1) extreme metrical irregularity or (2) easy rhyme and monotonous rhythm, cheap sentiment, and triviality.)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026293"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026294", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDomestic drama", "identifiers:lccn": "gf2014026294", "madsrdf:adminMetadata": [{"@id": "_:n067dc406cced4a9597064bf8a708e209b1"}, {"@id": "_:n067dc406cced4a9597064bf8a708e209b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Domestic drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n067dc406cced4a9597064bf8a708e209b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026540"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026088"}], "madsrdf:hasSource": [{"@id": "_:n067dc406cced4a9597064bf8a708e209b5"}, {"@id": "_:n067dc406cced4a9597064bf8a708e209b6"}], "madsrdf:hasVariant": {"@id": "_:n067dc406cced4a9597064bf8a708e209b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays depicting the problems of the middle and lower classes, particularly within the family and home."}, {"@id": "_:n067dc406cced4a9597064bf8a708e209b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:00:23"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n067dc406cced4a9597064bf8a708e209b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n067dc406cced4a9597064bf8a708e209b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Domestic drama"}}, {"@id": "_:n067dc406cced4a9597064bf8a708e209b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Domestic drama. UF Bourgeois drama. BT Drama)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n067dc406cced4a9597064bf8a708e209b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (Domestic drama: Also known as bourgeois drama. Domestic drama deals with problems of the middle and lower classes, particularly problems of the family and home.)"}, "madsrdf:citationSource": "Wilson, E. The theater experience, c2004, via McGraw-Hill Higher Education online learning center, Nov. 14, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n067dc406cced4a9597064bf8a708e209b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n067dc406cced4a9597064bf8a708e209b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bourgeois drama"}}, {"@id": "_:n067dc406cced4a9597064bf8a708e209b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bourgeois drama"}}], "@id": "/authorities/genreForms/gf2014026294"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026295", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDomestic fiction", "identifiers:lccn": "gf2014026295", "madsrdf:adminMetadata": [{"@id": "_:n86bb423496814831ab53ca38617c3564b1"}, {"@id": "_:n86bb423496814831ab53ca38617c3564b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Domestic fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n86bb423496814831ab53ca38617c3564b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n86bb423496814831ab53ca38617c3564b5"}, {"@id": "_:n86bb423496814831ab53ca38617c3564b6"}, {"@id": "_:n86bb423496814831ab53ca38617c3564b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works of fiction that feature home and family life."}, {"@id": "_:n86bb423496814831ab53ca38617c3564b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n86bb423496814831ab53ca38617c3564b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-08T12:32:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n86bb423496814831ab53ca38617c3564b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Domestic fiction"}}, {"@id": "_:n86bb423496814831ab53ca38617c3564b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Domestic fiction. Here are entered collections of fiction that focus on home and family life)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n86bb423496814831ab53ca38617c3564b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Domestic fiction: The rise of domestic fiction was concurrent with the rise of both the novel and the middle classes in England. Reaching its high-water mark in the middle of the 19th century, domestic fiction differed from 18th-century fiction through its articulation of human desires and actions in individualized moral terms, firmly establishing the novel as a moral form. In domestic fiction, modern domesticity is established as the only haven from the harsh vicissitudes of an unmerciful economic world)"}, "madsrdf:citationSource": "Oxford reader's companion to Dickens, via Oxford reference online, Apr. 15, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n86bb423496814831ab53ca38617c3564b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Domestic fiction. Used for fictional works that focus on home and family life.)"}, "madsrdf:citationSource": "WorldCat genres, via WWW, Oct. 20, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026295"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026296", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDouble dactyls", "identifiers:lccn": "gf2014026296", "madsrdf:adminMetadata": [{"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b1"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Double dactyls"}, "madsrdf:elementList": {"@list": [{"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b5"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b6"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b7"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b8"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b9"}], "madsrdf:hasVariant": {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Light verse that consists of two quatrains with two dactyls each."}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:01:07"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Double dactyls"}}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Double dactyl: A fixed form in light verse in which there are two stanzas of four double dactyls lines. The rules ... require the last lines of the stanza to rhyme and the last lines to be truncated. The first line should be a jingle, the second line a name, and one line in the second stanza should consist of one word.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Double dactyls: A form of light verse consisting of two stanzas, each having four lines of two dactyls. It was promoted by Anthony Hecht and John Hollander in the collection Jiggery-Pokery. The rules are complex. The first line must be a jingle, such as \"Jiggery-pokery.\" The second line must be a name. The last lines of the stanza must be rhymed, and the second stanza must have one line that is a single word.)"}, "madsrdf:citationSource": "Harmon, J. A handbook to literature, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Double dactyl: A recent genre of light verse in two quatrains. The last lines of the first and second quatrains must rhyme and must comprise four syllables, a dactylic foot followed by a stress. The other six lines are all hexasyllables of two dactylic feet, hence the name. The first line of the poem must be a nonsense phrase, usually \"Higgledy piggledy\"; the second line must be a proper name; and the second line of the second quatrain must be polysyllable, often scientific or technical, and the more recondite the better)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Double dactyl: An eight-line light verse form, invented by Anthony Hecht, consisting of two quatrains of dactylic dimeter. The first line is made up of nonsense words; the second line is the name of a famous person; at least one line in the second quatrain consists of a single six-syllable word; the fourth and eighth lines rhyme; the final two unstressed syllables are omitted at the end of each quatrain.)"}, "madsrdf:citationSource": "Drury, J. The poetry dictionary, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Double dactyls. UF Dactyls, Double)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dactyls, Double"}}, {"@id": "_:n824cb66bb46546a59edb2d88c77b2aa7b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dactyls, Double"}}], "@id": "/authorities/genreForms/gf2014026296"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDrama", "identifiers:lccn": "gf2014026297", "madsrdf:adminMetadata": [{"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b1"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b5"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b8"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026031"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026215"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026245"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026281"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026282"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026287"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026294"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026299"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026313"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026319"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026324"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026332"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026336"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026369"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026374"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026