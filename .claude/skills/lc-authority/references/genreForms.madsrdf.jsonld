": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n42130ea6c2e64b59944300707ce4418bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vesnianky"}}, {"@id": "_:n42130ea6c2e64b59944300707ce4418bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 592 (Vesnianky-hahilky, also known in Galicia as ha\u00efvky, iahilky, maivky; hahulky, halahilky, iaholoiky, and rohulky [no pubs in LC]; ritual folk songs sung by girls in conjunction with ritual dances and games from early spring)"}, "madsrdf:citationSource": "Encyc. of Ukraine, v. 5:", "madsrdf:citationStatus": "found"}, {"@id": "_:n42130ea6c2e64b59944300707ce4418bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ha\u00efvky)"}, "madsrdf:citationSource": "Work cat.: 2005429419 : Smoli\ufe20a\ufe21k, Oleh. Vesni\ufe20a\ufe21na obri\ufe20a\ufe21dovist\u02b9 Zakhidnoho Podilli\ufe20a\ufe21 v konteksti ukra\u00efns\u02b9ko\u00ef kul\u02b9tury, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n42130ea6c2e64b59944300707ce4418bb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n42130ea6c2e64b59944300707ce4418bb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hailky"}}, {"@id": "_:n42130ea6c2e64b59944300707ce4418bb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hailky"}}, {"@id": "_:n42130ea6c2e64b59944300707ce4418bb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n42130ea6c2e64b59944300707ce4418bb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Iahilky"}}, {"@id": "_:n42130ea6c2e64b59944300707ce4418bb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Iahilky"}}, {"@id": "_:n42130ea6c2e64b59944300707ce4418bb13", "@type": ["madsrdf:GenreForm"