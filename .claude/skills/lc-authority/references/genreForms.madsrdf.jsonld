0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n5391f49a569c43ac9b8d5b4bbe0031b0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantasy television programs"}}, {"@id": "_:n5391f49a569c43ac9b8d5b4bbe0031b0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy television: a genre of television featuring elements of the fantastic, often including magic, supernatural forces, or exotic fantasy worlds. Fantasy television programs are often based on tales from mythology and folklore, or are adapted from fantasy stories in other media. In the United Kingdom, the term \"telefantasy\" is used as an umbrella term to collectively describe all types of programs that feature elements of the fantastic)"}, "madsrdf:citationSource": "Wikipedia website, June 21, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5391f49a569c43ac9b8d5b4bbe0031b0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy: fictional work set in a netherworld where events trespass physical laws and the bounds of human possibility, mixing the otherwise separate worlds of the natural and the supernatural. The hero often undergoes mystical experiences, and must call on powerful, extra-human forces outside themselves to prevail)"}, "madsrdf:citationSource": "Moving image genre-form guide online, June 21, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5391f49a569c43ac9b8d5b4bbe0031b0b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5391f49a569c43ac9b8d5b4bbe0031b0b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fantastic television programs"}}, {"@id": "_:n5391f49a569c43ac9b8d5b4bbe0031b0b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantastic television programs"}}, {"@id": "_:n5391f49a569c43ac9b8d5b4bbe0031b0b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5391f49a569c43ac9b8d5b4bbe0031b0b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Telefantasy"}}, {"@id": "_:n5391f49a569c43ac9b8d5b4bbe0031b0b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telefantasy"}}], "@id": "/authorities/genreForms/gf2011026244"}
