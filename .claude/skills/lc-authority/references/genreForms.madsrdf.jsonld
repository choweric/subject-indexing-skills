{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026399"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026400"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026418"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026434"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026440"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026441"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026462"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026482"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026531"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026536"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026610"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026613"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026617"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026690"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026697"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026699"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026728"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026743"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026752"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026755"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026756"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2012025007"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2012025033"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026012"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026068"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026021"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026077"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026051"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026056"}], "madsrdf:hasSource": [{"@id": "_:nc91d04c3830547e1ab3538d81959eb0db5"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db6"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db7"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db8"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db9"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db10"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db11"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db12"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db13"}], "madsrdf:hasVariant": [{"@id": "_:nc91d04c3830547e1ab3538d81959eb0db14"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025072"}}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-23T11:21:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maps"}}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(physical map: redirect to map: a visual representation of an area; a symbolic depiction highlighting relationships between elements of that space such as objects, regions, and themes)"}, "madsrdf:citationSource": "Wikipedia, Dec. 1, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "map (a graphic representation, usually on a plane surface and at an established scale, of natural and manmade features on or under the surface of the earth or other planetary body. The features are positioned as accurately as possible, usually relative to a coordinate reference system. Also, a graphic representation of a part or the whole of the celestial sphere) physical map [no entry]"}, "madsrdf:citationSource": "Glossary of mapping, charting, and geodetic terms, 1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "map (A drawing or other representation of the earth's surface or a part of it made on a flat surface, showing the distribution of physical or geographical features (and often also including socio-economic, political, agricultural, meteorological, etc., information), with each point in the representation corresponding to an actual geographical position according to a fixed scale or projection; a similar representation of the positions of stars in the sky, the surface of a planet, or the like) physical map [no entry]"}, "madsrdf:citationSource": "OED online, Dec. 1, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db8", "@type": "madsrdf:Source", "madsrdf:citationSource": "00557339: George Washington University. 1999 campus plan, George Washington University at Mount Vernon College. Scale [ca. 1:1,750], 1999?", "madsrdf:citationStatus": "found"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(plan: A large-scale (1:5,000 or larger) detailed map of a relatively small area, such as a university campus, small park, garden, battlefield, or site on which a building or complex of buildings stands, showing relative positions on a horizontal plane parallel to the picture plane and features drawn to scale with little generalization)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Sept. 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db10", "@type": "madsrdf:Source", "madsrdf:citationSource": "2008620665: Quail Map Company. Exeter street plan, \u00a92007.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(plans (maps). Note: Refers to maps depicting a relatively small district or region, such as a town or city, drawn on a large scale and with considerable detail. For maps of larger regions, use \"topographic maps\" or \"chorographic maps.\" For depictions of smaller plots of land, particularly as related to the planning of architecture, use \"site plans.\" For representations of buildings or objects depicted on a horizontal plane, use \"plans (orthographic projections).\" BT maps (documents))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Sept. 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db12", "@type": "madsrdf:Source", "madsrdf:citationSource": "University of Washington. University of Washington, plan of present campus. Scale [ca. 1:2,400], 1959.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "map (1. a conventional representation, usually on a plane surface and at an established scale, of the physical features (natural, artificial, or both) of a part or whole of the Earth's surface by means of signs and symbols and with the means of orientation indicated; 2. a conventional representation, usually on a plane surface, and at an established scale, of the physical features (natural, artificial, or both) of a part or whole of the celestial sphere by means of signs and symbols and with the means of orientation indicated. Because of the widespread use of such maps for navigation, a map of the celestial sphere is often referred to as a star chart. The type of information a map is designed primarily to convey is frequently indicated by an adjective, to distinguish it from other types) chart (a map designed for use in navigation; applied chiefly to maps made primarily for nautical or aeronautical navigation, and to maps of the heavens)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc91d04c3830547e1ab3538d81959eb0db15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plans (Maps)"}}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plans (Maps)"}}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc91d04c3830547e1ab3538d81959eb0db18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Charts (Cartography)"}}, {"@id": "_:nc91d04c3830547e1ab3538d81959eb0db18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Charts (Cartography)"}}], "@id": "/authorities/genreForms/gf2011026387"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026388", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMartial arts films", "identifiers:lccn": "gf2011026388", "madsrdf:adminMetadata": [{"@id": "_:nd40f6312e6d84d72a17d53d401380634b1"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Martial arts films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd40f6312e6d84d72a17d53d401380634b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026005"}, "madsrdf:hasSource": [{"@id": "_:nd40f6312e6d84d72a17d53d401380634b5"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b6"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b7"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b8"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b9"}], "madsrdf:hasVariant": [{"@id": "_:nd40f6312e6d84d72a17d53d401380634b10"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b13"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b16"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b19"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025340"}}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-13T09:57:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Martial arts films"}}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kung fu film (Chop-chop Film, Chop-'em-Sock-'em Flick, Chopsocky Picture): An extremely popular genre in the early to mid-seventies, the kung fu films, originating in Hong Kong and later imitated in other countries, came and went as the repetitive and familiar plots of this type of martial arts film saturated the market. The plots of the kung fu films frequently center on the theme of revenge, the hero often having to accept reluctantly the task of avenging some injustice or the death of his/her mentor, teacher, family or friends.)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Martial arts. Fictional work designed to showcase the hero's athletic agility and ability to turn his body into a weapon. This skill has been achieved through his dedication to, and personification of, Oriental teachings about physical and mental discipline, allowing the hero to execute fast, fluid, but spare movements that knock out or kill his numerous adversaries and allow him to triumph over formidable odds. The hero's adversaries range from criminals to supernatural beings. The emphasis on the actual choreographed movement dominates the narrative, which can be set in historical to modern times, in the East or the West. Used for Kung fu)"}, "madsrdf:citationSource": "The moving image genre-form guide, via WWW, Mar. 16, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(martial-arts film: Movie featuring numerous fight scenes involving various Asian forms of fighting using the hands and feet, such as karate and jujitsu)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dict., c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Martial arts drama. Use for fictional genre films and programs which consist largely of choreographed fight sequences employing martial arts which originally developed in the Orient (e.g. karate, kung fu, eastern sword-play techniques, etc.). UF Chinese action drama, Oriental action drama, Swordplay drama, Swordsmen in motion pictures, Kung fu drama, Oriental swordplay drama, Chinese swordplay drama, Jidai-geki, Chambara, Samurai drama, Samurai films, Spaghetti easterns)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 9, p. 259 (three exploitation genres in ascending order of market strength: black action film, martial arts film, and feature-length hardcore porno film) pp. 266-267 (category: Martial Arts, or Kung Fu; martial arts film; kung fu films; kung fu movies; martial arts genre; an ethnic action genre; Japan's martial arts films tended to be more violent than their Chinese counterparts; occasionally combined with other exploitation genres)"}, "madsrdf:citationSource": "History of the American cinema, c1990:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd40f6312e6d84d72a17d53d401380634b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chop-chop films"}}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chop-chop films"}}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd40f6312e6d84d72a17d53d401380634b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spaghetti Easterns"}}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spaghetti Easterns"}}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd40f6312e6d84d72a17d53d401380634b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chopsocky films"}}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chopsocky films"}}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd40f6312e6d84d72a17d53d401380634b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kung fu films"}}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kung fu films"}}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd40f6312e6d84d72a17d53d401380634b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chop-'em-sock-'em films"}}, {"@id": "_:nd40f6312e6d84d72a17d53d401380634b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chop-'em-sock-'em films"}}], "@id": "/authorities/genreForms/gf2011026388"}
