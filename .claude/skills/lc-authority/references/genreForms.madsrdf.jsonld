{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026097", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExcerpts", "identifiers:lccn": "gf2014026097", "madsrdf:adminMetadata": [{"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b1"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Excerpts"}, "madsrdf:elementList": {"@list": [{"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026084"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026255"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026256"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026435"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026502"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026505"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026671"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026672"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026802"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026037"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026046"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026055"}], "madsrdf:hasSource": [{"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b5"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b6"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b7"}], "madsrdf:hasVariant": [{"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b8"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b11"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b14"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b17"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b20"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b23"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b26"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b29"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b32"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Excerpts"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 43 (excerpt: extract from a book, manuscript; offprint; excerption: excerpt, collection of excerpts)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(excerpts. UF selections (excerpts). Portions of a larger work, such as a literary work or motion picture, reproduced or excised without further change from their original context.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(excerpt: A lengthy verbatim selection taken from a speech or written work, usually longer than a quotation. Reprinting an excerpt without permission may be an infringement of copyright. Excerpts are sometimes published in the form of a digest (example: Book Review Digest). Compare with extract. In film and video, a portion (usually a few minutes or less in duration) of a longer, fully edited, complete work. Too brief to be considered a incomplete version of the work, an excerpt typically consists of the title sequence, a musical number, or footage highlighting a dramatic moment or special effects. Synonymous in this sense with film clip. The term is not used for unedited material or stock shots, or for footage not utilized in the final cut (see outtake); extract: One or more lengthy quotations from a book or other work set within the main text of another work, usually indented and sometimes printed in distinguishing type. When printed in the same type size as the text and without indention, an extract is enclosed in quotation marks and preceded and followed by a blank line. In a more general sense, any piece taken from one work and used in another, sometimes to represent the whole, as in a scene from a motion picture used in a trailer.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Parts (Excerpts)"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Parts (Excerpts)"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Excerpted resources"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Excerpted resources"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Selections (Excerpts)"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Selections (Excerpts)"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Samples (Excerpts)"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Samples (Excerpts)"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Extracts (Excerpts)"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Extracts (Excerpts)"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sections (Excerpts)"}}, {"@id": "_:n09d73b98d7de4e038d943fe02ff6b702b24", "@t