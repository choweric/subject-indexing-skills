urce": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ncd60ac98244d459b8762624a4ef7efc6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rebetika"}}, {"@id": "_:ncd60ac98244d459b8762624a4ef7efc6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. 3 (Rempetiko) p. 10 (Rebetika) p. 195 (Rempetika)"}, "madsrdf:citationSource": "Dietrich, E. Das Rabetiko, 1987:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd60ac98244d459b8762624a4ef7efc6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 13 (Songs of the Greek urban sub-proletariate from the end of the 19th cent. to the 1950s)"}, "madsrdf:citationSource": "Work cat.: Holst, G. Road to rembetika, 1983, c1975:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd60ac98244d459b8762624a4ef7efc6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 7, p. 673 (rebetiko, Greek urban popular song)"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd60ac98244d459b8762624a4ef7efc6b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd60ac98244d459b8762624a4ef7efc6b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rempetiko"}}, {"@id": "_:ncd60ac98244d459b8762624a4ef7efc6b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rempetiko"}}, {"@id": "_:ncd60ac98244d459b8762624a4ef7efc6b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd60ac98244d459b8762624a4ef7efc6b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rebetiko"}}, {"@id": "_:ncd60ac98244d459b8762624a4ef7efc6b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rebetiko"}}, {"@id": "_:ncd60ac98244d459b876