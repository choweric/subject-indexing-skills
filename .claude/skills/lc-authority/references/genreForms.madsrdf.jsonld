{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026304", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEcho verse", "identifiers:lccn": "gf2014026304", "madsrdf:adminMetadata": [{"@id": "_:ne25d4a17801949418d87e61f12c439adb1"}, {"@id": "_:ne25d4a17801949418d87e61f12c439adb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Echo verse"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne25d4a17801949418d87e61f12c439adb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:ne25d4a17801949418d87e61f12c439adb5"}, {"@id": "_:ne25d4a17801949418d87e61f12c439adb6"}], "madsrdf:hasVariant": {"@id": "_:ne25d4a17801949418d87e61f12c439adb7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems in which the last syllable of one line is repeated in the next line with a different meaning."}, {"@id": "_:ne25d4a17801949418d87e61f12c439adb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:04:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne25d4a17801949418d87e61f12c439adb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne25d4a17801949418d87e61f12c439adb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Echo verse"}}, {"@id": "_:ne25d4a17801949418d87e61f12c439adb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(echo verse. Poetry or light verse in which the last syllable(s) of one line is (are) repeated in the next line but with a different meaning. The form was popular in Renaissance France, Italy, and England, and was used extensively in pastoral poetry.)"}, "madsrdf:citationSource": "Meyers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:ne25d4a17801949418d87e61f12c439adb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Echo Verse. A poem of which the final syllables of the lines are repeated, as by an echo, with the effect of making a reply to a question or a comment, often contrastive, punning, or ironic; found most often in pastoral poetry and drama; echo poems)"}, "madsrdf:citationSource": "The Princeton encyc. of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne25d4a17801949418d87e61f12c439adb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne25d4a17801949418d87e61f12c439adb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Echo poetry"}}, {"@id": "_:ne25d4a17801949418d87e61f12c439adb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Echo poetry"}}], "@id": "/authorities/genreForms/gf2014026304"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026305", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEducational comics", "identifiers:lccn": "gf2014026305", "madsrdf:adminMetadata": [{"@id": "_:n31440500915347f0b53193ff3b482a20b1"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Educational comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n31440500915347f0b53193ff3b482a20b3"}]}, "madsrdf:exampleNote": "Note under [Instructional comics]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026453"}], "madsrdf:hasSource": [{"@id": "_:n31440500915347f0b53193ff3b482a20b5"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b6"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b7"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b8"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b9"}], "madsrdf:hasVariant": {"@id": "_:n31440500915347f0b53193ff3b482a20b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that are intended to impart knowledge and information, including those for classroom use. For comics that use a structured format to teach or train the reader see [Instructional comics.]"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:17:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Educational comics"}}, {"@id": "_:n31440500915347f0b53193ff3b482a20b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Educational comic books are a great way to give children a complete lesson that they can read and review at their own pace.)"}, "madsrdf:citationSource": "Educational comic books, via Discovery Comics website, Dec. 4, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Educational films; Educational radio programs; Educational television programs)"}, "madsrdf:citationSource": "LCGFT", "madsrdf:citationStatus": "found"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Schultz, M. The stuff of life : a graphic guide to genetics and DNA, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "('The Comic Strip of Neoliberalism' is a series of informational comics which you can read by hitting the links at the bottom of this page. These comics show attempts in various countries to resist the neoliberal regime.)"}, "madsrdf:citationSource": "The comic strip of neoliberalism, via WWW, Dec. 13, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Gonick, L. The cartoon guide to calculus, c2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n31440500915347f0b53193ff3b482a20b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n31440500915347f0b53193ff3b482a20b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Informational comics"}}, {"@id": "_:n31440500915347f0b53193ff3b482a20b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Informational comics"}}], "@id": "/authorities/genreForms/gf2014026305"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026306", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEkphrastic poetry", "identifiers:lccn": "gf2014026306", "madsrdf:adminMetadata": [{"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b1"}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ekphrastic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b5"}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b6"}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b7"}], "madsrdf:hasVariant": [{"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b8"}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry that describes or meditates on works of visual art."}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:01:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ekphrastic poetry"}}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ekphrasis (pl. ekphraseis). Detailed description of an image, primarily visual; in specialized form, limited to description of a work of visual art; poetic ekphraseis; ekphraseis play important roles in novels, too)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ekphrastic poetry; poetry that engages with a work of visual art, speaking to, for, or about a painting, sculpture, ornament, or photograph. The work may be real or imagined; ekphrases; ekphrastic poems are not only poetic readings of individual works but also examinations of the process of representation; ekphrastic poetry has become a booming genre of American verse in the last decades of the twentieth century)"}, "madsrdf:citationSource": "The Greenwood encyclopedia of American poets and poetry, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ekphrasis (ecphrasis) (plural -ases) A verbal description of, or meditation upon, a non-verbal work of art, real or imagined, usually a painting or sculpture; ekphrastic poem; English class of this genre is John Keats's 'Ode on a Grecian Urn' (1820); ekphrastic passages can be found in prose writings too)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ekphrases (Poetry)"}}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ekphrases (Poetry)"}}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ecphrases (Poetry)"}}, {"@id": "_:nacf70f58daf847a48e4a68b4bb8e3ee1b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ecphrases (Poetry)"}}], "@id": "/authorities/genreForms/gf2014026306"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026307", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aElegies (Poetry)", "identifiers:lccn": "gf2014026307", "madsrdf:adminMetadata": [{"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b1"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Elegies (Poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b3"}]}, "madsrdf:exampleNote": "Note under [Laments]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026064"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422"}], "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b5"}, "madsrdf:hasSource": [{"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b8"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b9"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b10"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b11"}], "madsrdf:hasVariant": [{"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b12"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Serious, formal lyric poems that reflect on a solemn subject, generally someone's death. For non-narrative poems that express a deep regret or sorrow for the loss of a person or position see [Laments.]"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-20T08:03:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Elegies (Poetry)"}}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Elegies"}}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Elegies"}}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(elegy. An elaborately formal lyric poem lamenting the death of a friend or public figure, or reflecting seriously on a solemn subject. In Greek and Latin verse, the term referred to the metre of a poem (alternating dactylic hexameters and pentameters in couplets known as elegiac distichs), not to its mood or content: love poems were often included. But since Milton's Lycidas (1637), the term in English has usually denoted a lament, while the adjective 'elegiac' has come to refer to the mournful mood of such poems.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetic Form: Elegy--The elegy began as an ancient Greek metrical form and is traditionally written in response to the death of a person or group. Though similar in function, the elegy is distinct from the epitaph, ode, and eulogy: the epitaph is very brief; the ode solely exalts; and the eulogy is most often written in formal prose. The elements of a traditional elegy mirror three stages of loss. First, there is a lament, where the speaker expresses grief and sorrow, then praise and admiration of the idealized dead, and finally consolation and solace. These three stages can be seen in W. H. Auden's classic \"In Memory of W. B. Yeats.\" Other well-known elegies include \"Fugue of Death\" by Paul Celan, written for victims of the Holocaust, and \"O Captain! My Captain!\" by Walt Whitman, written for President Abraham Lincoln. Many modern elegies have been written not out of a sense of personal grief, but rather a broad feeling of loss and metaphysical sadness)"}, "madsrdf:citationSource": "Poets.org, viewed Dec. 26, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Elegy. A lament or a meditative poem, often written on the occasion of a death or other solemn event or theme; usually a complete poem in a formal style; one kind of elegy that is especially important in English literary history is the pastoral elegy; pastoral elegies combine pastoral themes and images--nature deities, seasonal vegetation--with a memorialization of a deceased friend or comrade)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dict. of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Elegiac poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Elegiac poetry"}}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Elegiac poetry"}}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Elegies"}}, {"@id": "_:n77a84ca7e7754f46984ef2f8d58ebf54b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Elegies"}}], "@id": "/authorities/genreForms/gf2014026307"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026308", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEnglyns", "identifiers:lccn": "gf2014026308", "madsrdf:adminMetadata": [{"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b1"}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Englyns"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b5"}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b6"}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b7"}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b8"}], "madsrdf:hasVariant": {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short Welsh poems generally written in quatrains or tercets with complex rules governing alliteration and rhyme."}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:02:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Englyns"}}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Englyn: A venerable Welsh pattern of verse, usually quatrain with complex rules governing alliteration and rhyme)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(englyn, a group of strict Welsh poetic metres. The most popular form is the englyn unodl union (\"direct monorhyme englyn\"), which is a combination of a cywydd, a type of rhyming couplet, and another form and is written in an intricate pattern of alliteration and rhyme called cynghanedd. The englyn unodl union consists of 30 syllables in lines of 10, 6, 7, and 7 syllables. In this form the last syllables of the last three lines rhyme with the 6th, 7th, 8th, or 9th syllable of the first line. The various forms of englyns were among the 24 strict bardic metres available to Welsh poets from roughly the 14th century.)"}, "madsrdf:citationSource": "Britannica Academic Edition online, Dec. 21, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Englyn (pl. englynion): Along with awdl and cywydd, one of the three classes of the 24 \"strict meters\" of Welsh poetry. The earliest forms are tercets, but after the 12th c. these are replaced by quatrains in monorhyme or consonance. Six of the eight varieties of englynion are quatrains, and the most common line length is the heptasyllable, though combinations of 10, 6, and 7 are also common. Since the 12th c., the most common variety has been the e. unodl union (direct monorhyme e.), a quatrain of lines of 10, 6, 7 and 7 syllables.)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Englyn: A group of certain Welsh tercets and quatrains written in strict Welsh meters including monorhyme and cywydd, especially in poems that make use of cynghanedd. The simplest example of an englyn is the soldiers' englyn, a rhymed tercet in which each line has seven syllables.)"}, "madsrdf:citationSource": "SuperGlossary.com, Dec. 21, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Englynion"}}, {"@id": "_:nb4e83024d2d24a85adee5eb38acff2c6b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Englynion"}}], "@id": "/authorities/genreForms/gf2014026308"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026309", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEpic fiction", "identifiers:lccn": "gf2014026309", "madsrdf:adminMetadata": [{"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b1"}, {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Epic fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b5"}, {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b6"}, {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b7"}], "madsrdf:hasVariant": {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction depicting action on a broad scale and often characterized by grandiose treatment of individual and/or national destiny."}, {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:03:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epic fiction"}}, {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epic fiction: while 'epic; occasionally is used simply to describe a very long novel, most epics also have certain elements in common, including a plot involving characters whose actions create national or international consequences and settings encompassing a variety of locations. Epic was originally used to describe poems such as Homer's Odyssey, which were passed on orally and involved the great deeds of celebrated historical figures. But there are marked differences between oral epic poetry and epic fiction. The fictional epic is often, although not always, humorous, and its characters and plot generally are invented, rather than based on mythology or history. Leo Tolstoy's War and peace is an example of a fictional epic.)"}, "madsrdf:citationSource": "Henry, L. The fiction dictionary, c1995", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epic fiction: use for works that parallel traditional epics in range and magnitude, and are, or could be, characterized by grandiose treatment of individuals or national destiny. Examples include James Michener's Centennial and Leon Uris' Exodus. UF Epic literature; Fiction, Epic)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 264 (epic: An epic is a long narrative poem, on a grand scale, about the deeds of warriors and heroes; epics are often of national significance in the sense that they embody the history and aspirations of a nation in a lofty or grandiose manner) p. 272 (in the last hundred years or more the novel, the cinema, and to a lesser extent, the theatre have been much favoured media for narratives on an epic scale; novelists have found the novel an increasingly suitable vehicle for a grandiose treatment of individual and national destiny; there has been an impressive number of novels which can fairly be described as epic in their range and magnitude)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epics (Fiction)"}}, {"@id": "_:nf9a13cc2ca5d46ae833a78ffcb4c8a53b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epics (Fiction)"}}], "@id": "/authorities/genreForms/gf2014026309"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026310", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEpic poetry", "identifiers:lccn": "gf2014026310", "madsrdf:adminMetadata": [{"@id": "_:n04fad061c4924bab946edae6fde65533b1"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Epic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n04fad061c4924bab946edae6fde65533b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026448"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026258"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026059"}], "madsrdf:hasSource": [{"@id": "_:n04fad061c4924bab946edae6fde65533b5"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b6"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b7"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b8"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b9"}], "madsrdf:hasVariant": [{"@id": "_:n04fad061c4924bab946edae6fde65533b10"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b13"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b16"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b19"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Lengthy poems narrating heroic deeds and events."}, {"@id": "_:n04fad061c4924bab946edae6fde65533b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-09T06:46:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epic poetry"}}, {"@id": "_:n04fad061c4924bab946edae6fde65533b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epic: A long narrative poem about heroic deeds and adventures. The earlier ones concern the history and legends of a country or region and include stories and information from many anonymous sources. These were oral or folk epics of which some were later written down.)"}, "madsrdf:citationSource": "Ruse, C. The Cassell dictionary of literary and language terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(An epic is a long narrativepoem that treats a single heroic figure or a group of such figures and concerns an historical event, such as a war or conquest, or an heroic quest or some other significant mythic or legendary achievement that is central to the traditions and belief of its culture ... Epic often focuses on a hero, sometimes semi-divine, who performs difficult and virtuous deeds; it frequently involves the interaction between human beings and gods.)"}, "madsrdf:citationSource": "New Princeton encyclopedia of poetry and poetics, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bylina: A type of Russian epic folksong or poetry often associated with an historical event or movement. The term bylina is of academic provenance and came into use in the 1830s; the peasants use the word starina ('what is old').)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epic: A long narrative poem that tells a story central to the myths and beliefs of a people.)"}, "madsrdf:citationSource": "Drury, J. The poetry dictionary, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Byliny (singular bylina) is the conventional name given to Russian oral heroic poems. The poems, known to those who recited them as stariny, meaning \"old songs\", were firstly collected in Northern Russia, in the province of Olonets, in the 1860s and their collection continued on until the 1930s, in the regions near Lake Ladoga)"}, "madsrdf:citationSource": "The literary encyclopedia online, Dec. 20, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n04fad061c4924bab946edae6fde65533b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n04fad061c4924bab946edae6fde65533b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Byliny"}}, {"@id": "_:n04fad061c4924bab946edae6fde65533b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Byliny"}}, {"@id": "_:n04fad061c4924bab946edae6fde65533b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n04fad061c4924bab946edae6fde65533b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Heroic poetry"}}, {"@id": "_:n04fad061c4924bab946edae6fde65533b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heroic poetry"}}, {"@id": "_:n04fad061c4924bab946edae6fde65533b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n04fad061c4924bab946edae6fde65533b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epics (Poetry)"}}, {"@id": "_:n04fad061c4924bab946edae6fde65533b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epics (Poetry)"}}, {"@id": "_:n04fad061c4924bab946edae6fde65533b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n04fad061c4924bab946edae6fde65533b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "B\u00eelin\u00ee"}}, {"@id": "_:n04fad061c4924bab946edae6fde65533b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "B\u00eelin\u00ee"}}, {"@id": "_:n04fad061c4924bab946edae6fde65533b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n04fad061c4924bab946edae6fde65533b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stariny"}}, {"@id": "_:n04fad061c4924bab946edae6fde65533b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stariny"}}], "@id": "/authorities/genreForms/gf2014026310"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026311", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEpicedia", "identifiers:lccn": "gf2014026311", "madsrdf:adminMetadata": [{"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b1"}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Epicedia"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026460"}, "madsrdf:hasSource": [{"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b5"}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b6"}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b7"}], "madsrdf:hasVariant": [{"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b8"}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b11"}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems composed for funerals."}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:08:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epicedia"}}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Chapman, G. An epicede or funerall song : on the most disastrous death, of the high-borne prince of men, Henry Prince of Wales, &c., 1612.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epicedium (plural epicedia): a funeral ode; originally in the anglicized form epicede)"}, "madsrdf:citationSource": "Oxford dictionaries website, Oct. 1, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epicedium. A song of mourning in praise of the dead, sung in the presence of the corpse and distinguished from threnos, a dirge, which was not limited by time or place. Written originally in a variety of meters, it was confined after the cl. period entirely to elegiac distichs and hexameters. Epicedia also included lamentations in verse for pet animals and birds.)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epicedes"}}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epicedes"}}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epicediums"}}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epicediums"}}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Funeral poetry"}}, {"@id": "_:ne8ebb0cf5344421d86f80a3fff4dc057b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Funeral poetry"}}], "@id": "/authorities/genreForms/gf2014026311"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026312", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEpigrams", "identifiers:lccn": "gf2014026312", "madsrdf:adminMetadata": [{"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb1"}, {"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Epigrams"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026170"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026486"}, "madsrdf:hasSource": [{"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb5"}, {"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb6"}, {"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb7"}, {"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short, witty statements."}, {"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:04:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epigrams"}}, {"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epigram: A short, pithy comic or satirical poem. In English, an epigram is usually in rhyme and meter, but in the Greek Anthology some of the earliest epigrams are unrhymed and not necessarily comic. Even prose can be described as epigrammatic, as in Oscar Wilde's The Importance of Being Earnest. An epigram will often contain, or embody, an aphorism: a memorable remark that encapsulates an insight into some aspect of human nature or the world at large.)"}, "madsrdf:citationSource": "Drury, J. The poetry dictionary, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epigram: A concise and witty comments that expresses a personal opinion about a general principle, such as this one from William Blake's The marriage of heaven and hell (1790): 'Truth can never be told so as to be understood and not be believed'; A verse epigram is a short satirical poem that expresses a particular thought.)"}, "madsrdf:citationSource": "Ruse, C. The Cassell dictionary of literary and language terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epigram. As a rule a short, witty statement in verse or prose which may be complimentary, satiric or aphoristic)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n4555dcd8961845cba3e1601cc5ebbcabb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epigram: A form of writing which makes a satiric or aphoristic observation with wit, extreme condensation, and, above all, brevity. As a poetic form, the epigram generally takes the shape of a couplet or quatrain, but tone defines it better than verse-form.)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026312"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026313", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEpisodic plays", "identifiers:lccn": "gf2014026313", "madsrdf:adminMetadata": [{"@id": "_:ned2c828d974144739b7916720cfbfc2ab1"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Episodic plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:ned2c828d974144739b7916720cfbfc2ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026556"}, "madsrdf:hasSource": [{"@id": "_:ned2c828d974144739b7916720cfbfc2ab5"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab6"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab7"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab8"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab9"}], "madsrdf:hasVariant": {"@id": "_:ned2c828d974144739b7916720cfbfc2ab10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that consist of episodes that are each more or less self-contained but together follow a common theme."}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:04:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Episodic plays"}}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Episodic plays are fine crafted one-act or full length plays that are made up of several short tales or short complete stories following a theme.)"}, "madsrdf:citationSource": "Anchorage Press plays website, Apr. 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Galsworthy, J. Escape : an episodic play in a prologue and two parts, c1926.", "madsrdf:citationStatus": "found"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The vagina monologues is an episodic play made up of varying numbers of monologues read by women. The monologues cover a range of topics including women's sexuality, the LGBQT experience, domestic and systematic abuse against women, women's health, as well as how women are viewed and interacted with on a societal level.)"}, "madsrdf:citationSource": "Performance of The vagina monologues commemorates plays 15th anniversary, via Westfield State University website, Apr. 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(episodic novel. A novel that features a significant number of loosely connected incidents, each one more or less self-contained.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Episodic Structure. A term applied to writing that consists of little more than a series of incidents, with the episodes succeeding each other, with no particularly logical arrangement or complication.)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009", "madsrdf:citationStatus": "found"}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ned2c828d974144739b7916720cfbfc2ab11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Episodic drama"}}, {"@id": "_:ned2c828d974144739b7916720cfbfc2ab11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Episodic drama"}}], "@id": "/authorities/genreForms/gf2014026313"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026314", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEpistolary fiction", "identifiers:lccn": "gf2014026314", "madsrdf:adminMetadata": [{"@id": "_:n49280026251b494cafd6372b30df90afb1"}, {"@id": "_:n49280026251b494cafd6372b30df90afb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Epistolary fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n49280026251b494cafd6372b30df90afb3"}]}, "madsrdf:exampleNote": "Note under [Diary fiction]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n49280026251b494cafd6372b30df90afb5"}, {"@id": "_:n49280026251b494cafd6372b30df90afb6"}, {"@id": "_:n49280026251b494cafd6372b30df90afb7"}], "madsrdf:hasVariant": {"@id": "_:n49280026251b494cafd6372b30df90afb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction written wholly or partially in the form of letters, telegrams, electronic mail messages, instant messages, etc. For fiction written in diary form see [Diary fiction.]"}, {"@id": "_:n49280026251b494cafd6372b30df90afb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n49280026251b494cafd6372b30df90afb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-03-05T16:56:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n49280026251b494cafd6372b30df90afb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epistolary fiction"}}, {"@id": "_:n49280026251b494cafd6372b30df90afb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epistolary novel: a novel written in the form of a series of letters exchanged among the characters of the story, with extracts from their journals sometimes included.)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n49280026251b494cafd6372b30df90afb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epistolary fiction. Here are entered works of fiction written wholly or partially in the form of letters, telegrams, electronic mail messages, instant messages, etc. Works of fiction written in diary form are entered under Diary fiction. UF Epistolary novels; Epistolary short stories; Epistolary stories; Novels, Epistolary; Novels in letters; Short stories, Epistolary. BT Fiction.)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n49280026251b494cafd6372b30df90afb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epistolary fiction. Use for novels written in the form of a series of letters. UF Epistolary novels; Fiction, Epistolary; Novels in letters)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n49280026251b494cafd6372b30df90afb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n49280026251b494cafd6372b30df90afb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novels in letters"}}, {"@id": "_:n49280026251b494cafd6372b30df90afb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novels in letters"}}], "@id": "/authorities/genreForms/gf2014026314"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026315", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEpistolary poetry", "identifiers:lccn": "gf2014026315", "madsrdf:adminMetadata": [{"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb1"}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Epistolary poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb5"}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb6"}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb7"}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb8"}], "madsrdf:hasVariant": [{"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb9"}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems in the form of a letter."}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:05:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epistolary poetry"}}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epistle: A poem addressed to a friend or patron, thus a kind of 'letter' in verse. There are approximately twotypes: (a) on moral and philosophical themes; (b) on romantic or sentimental themes.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epistle. A letter. As a literary form, the verse epistle is a poem in the form of a letter to a friend or patron in a familiar, conversational style. The theme of the most common kind (the Horatian, moral, or familiar epistle) is usually some moral, philosophical, or literary subject. The Horatian epistle was a favoured form among poets from the Renaissance to the 18th century: Jonson's Epistle to Elizabeth, Countess of Rutland (1616) and Pope's Epistle to Dr Arbuthnot (1735) are fine examples.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epistolary poetry)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epistolary poetry. UF Verse epistles)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Horatian epistles"}}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horatian epistles"}}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Verse epistles"}}, {"@id": "_:ncb030ffcc5de4de290ed4cda6750491bb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verse epistles"}}], "@id": "/authorities/genreForms/gf2014026315"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026316", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEpitaphs", "identifiers:lccn": "gf2014026316", "madsrdf:adminMetadata": [{"@id": "_:n01bd4801e8924acfb469d528a5046f60b1"}, {"@id": "_:n01bd4801e8924acfb469d528a5046f60b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Epitaphs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n01bd4801e8924acfb469d528a5046f60b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026064"}, "madsrdf:hasSource": [{"@id": "_:n01bd4801e8924acfb469d528a5046f60b5"}, {"@id": "_:n01bd4801e8924acfb469d528a5046f60b6"}, {"@id": "_:n01bd4801e8924acfb469d528a5046f60b7"}, {"@id": "_:n01bd4801e8924acfb469d528a5046f60b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Inscriptions commemorating the dead that are etched on tombstones and graves."}, {"@id": "_:n01bd4801e8924acfb469d528a5046f60b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n01bd4801e8924acfb469d528a5046f60b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:08:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n01bd4801e8924acfb469d528a5046f60b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epitaphs"}}, {"@id": "_:n01bd4801e8924acfb469d528a5046f60b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epitaph: An inscription on a gravestone or tomb; it can be of any variety, such as a short phrase or a complimentary, pious or satirical verse; An epitaph can also be a commemorative comment, either referring to another person or to oneself, that is not produced as an inscription.)"}, "madsrdf:citationSource": "Ruse, C. The Cassell dictionary of literary and language terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:n01bd4801e8924acfb469d528a5046f60b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epitaph: A short poem intended for (or imagined as) an inscription on a tombstone and often serving as a brief elegy.)"}, "madsrdf:citationSource": "Poetry foundation, via WWW, Jan. 9, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n01bd4801e8924acfb469d528a5046f60b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epitaph. An epitaph (from ancient Greek, meaning \"upon a tomb\") is an inscription on a tomb, or writing suitable for that purpose. The epitaph can be in prose or poetry; if poetry, it can be in any rhythmical pattern or none, rhymed or unrhymed. It should not be confused with the elegy, which, although often similar to the epitaph in subject and tone, is quite a bit longer. Epitaphs range from the lofty to the coarse, from the sublimely serious to the shockingly hilarious.)"}, "madsrdf:citationSource": "The Teachers & Writers handbook of poetic forms, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n01bd4801e8924acfb469d528a5046f60b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Devlin, D.D. Wordsworth and the poetry of epitaphs, 1981.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026316"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026317", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEpithalamia", "identifiers:lccn": "gf2014026317", "madsrdf:adminMetadata": [{"@id": "_:nf833e145fdbc432cacb8085553685aacb1"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Epithalamia"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf833e145fdbc432cacb8085553685aacb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026064"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026460"}], "madsrdf:hasSource": [{"@id": "_:nf833e145fdbc432cacb8085553685aacb5"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb6"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb7"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb8"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb9"}], "madsrdf:hasVariant": [{"@id": "_:nf833e145fdbc432cacb8085553685aacb10"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb13"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb16"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb19"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb22"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems written on the occasion of a wedding."}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-05T11:46:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epithalamia"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Book description: In the genre of poetry, nuptial poetry is singularly under-represented. The only extant anthology on nuptial poetry, published in the last decade of the nineteenth century, is now difficult to find, and does not have entries beyond the eighteenth century)"}, "madsrdf:citationSource": "Epithalamiums : an anthology of marriage poems from Chaucer to the modern, 2013, in Amazon.com website, viewed Feb. 7, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epithalamion plural epithalamia. A song or poem in honor of a bride and bridegroom)"}, "madsrdf:citationSource": "Dictionary.com, Feb. 7, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Genre of the wedding poetry, developed in the ancient Greece, manifested itself as two kinds of the wedding hymns, i.e. hymeneals and epithalamies; epithalamic compositions; epithalamic poem)"}, "madsrdf:citationSource": "Feature of the Latin epithalamies of 18th century Lithuania, via WWW, Feb. 7, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epithalamion A poem written on the occasion of a wedding, usually celebrating the virtue and beauty of the bride.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epithalamion (epithalamium) (plural -amia) A song or poem celebrating a wedding, and traditional intended to be sung outside the bridal chamber on the wedding night. Adjective: epithalamic)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf833e145fdbc432cacb8085553685aacb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wedding poetry"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wedding poetry"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf833e145fdbc432cacb8085553685aacb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epithalamions"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epithalamions"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf833e145fdbc432cacb8085553685aacb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epithalamiums"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epithalamiums"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf833e145fdbc432cacb8085553685aacb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epithalamic poetry"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epithalamic poetry"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf833e145fdbc432cacb8085553685aacb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nuptial poetry"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nuptial poetry"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf833e145fdbc432cacb8085553685aacb26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epithalamies"}}, {"@id": "_:nf833e145fdbc432cacb8085553685aacb26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epithalamies"}}], "@id": "/authorities/genreForms/gf2014026317"}
