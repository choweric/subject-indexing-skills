{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026747", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aYiddish films", "identifiers:lccn": "gf2011026747", "madsrdf:adminMetadata": [{"@id": "_:ne4d59371c3f54695abdba999bdd163e8b1"}, {"@id": "_:ne4d59371c3f54695abdba999bdd163e8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Yiddish films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne4d59371c3f54695abdba999bdd163e8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026229"}, "madsrdf:hasSource": [{"@id": "_:ne4d59371c3f54695abdba999bdd163e8b5"}, {"@id": "_:ne4d59371c3f54695abdba999bdd163e8b6"}, {"@id": "_:ne4d59371c3f54695abdba999bdd163e8b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films in Yiddish produced from the 1920s to the 1940s in Europe and the United States.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025673"}}, {"@id": "_:ne4d59371c3f54695abdba999bdd163e8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne4d59371c3f54695abdba999bdd163e8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:07:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne4d59371c3f54695abdba999bdd163e8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yiddish films"}}, {"@id": "_:ne4d59371c3f54695abdba999bdd163e8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Yiddish films--History and criticism)"}, "madsrdf:citationSource": "LCSH, October 20, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4d59371c3f54695abdba999bdd163e8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Yiddish film page (Yiddish film: produced from the 1920s to the 1940s in Poland and the United States; reflect a wide spectrum of Jewish life--rich and poor, educated and illiterate, traditional and assimilationist. These films capture the atmosphere, concerns values, and myths of the Yiddish milieu as well as the unique flavor and nuances of the Yiddish mameloshen [mother tongue]. As Jim Hoberman writes in his book Bridge of light: Yiddish film between two worlds, \"drawing upon an extablished dramice and literary tradition, yet employing a language virtually unknown to the Gentile world, this was not just a national cinema without a nation-state, but a national cinema that, with every presentation, created its own ephemeral nation-state.\")"}, "madsrdf:citationSource": "MyJewishLearning WWW site, Oct. 14, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4d59371c3f54695abdba999bdd163e8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "catalog (Jewish Luck was among the first Soviet Yiddish films to be released in the U.S. during the 1920's)"}, "madsrdf:citationSource": "The National Center for Jewish Film WWW site, October 20, 2008:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026747"}
