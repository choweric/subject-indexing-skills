Status": "revised"}, {"@id": "_:n9a90751ba55c4a2d8251b51c926afe03b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ragas"}}, {"@id": "_:n9a90751ba55c4a2d8251b51c926afe03b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a90751ba55c4a2d8251b51c926afe03b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(R\u0101ga: In Indian musical theory and practice a melody-type or mode, suitable for expressing aesthetic ethos and religious devotion; provides the melodic material for the composition of vocal or instrumental melodies and for improvisation; characterized by a variety of melodic features, including a basic scale (perhaps with additional or omitted notes), grammatical rules governing the relative emphasis of different scale degrees and the sequence of notes in ascending and descending contexts, distinctive ways of ornamenting or pitching particular notes, and motifs or formulae from which complete melodies or improvisations can be constructed; each has a unique aesthetic identity, sometimes described in terms of the classical rasa aesthetic system)"}, "madsrdf:citationSource": "Oxford music online, Dec. 10, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a90751ba55c4a2d8251b51c926afe03b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (A rag in Afghanistan, a raga in India)"}, "madsrdf:citationSource": "Kassimi, E. Le luth afghan [SR] p1979:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a90751ba55c4a2d8251b51c926afe03b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9a90751ba55c4a2d8251b51c926afe03b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ragam"}}, {"@id": "_:n9a90751ba55c4a2d8251b51c926afe03b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ragam"}}, {"@id": "_:n9a90751ba55c4a2d8251b51c926afe03b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9a90751ba55c4a2d8251b51c926afe03b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rags (South Asian music)"}}, {"@id": "_:n9a90751ba55c4a2d8251b51c926afe03b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rags (South Asian music)"}}], "@id": "/authorities/genreForms/gf2014027180"}
