"_:n18abd753587241f388af3e4c6fa18644b19"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b22"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative rock music"}}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(alternative; alternative music)"}, "madsrdf:citationSource": "Work cat.: 96019373: Blashill, P. Noise from the underground : a secret history of alternative rock, 1996", "madsrdf:citationStatus": "found"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternative rock; also called alternative music, alt rock or simply alternative); genre of rock music that emerged from the independent music underground of the 1980s and became widely popular by the 1990s; a broad umbrella term consisting of music that differs greatly in terms of its sound, its social context, and its regional roots)"}, "madsrdf:citationSource": "Wikipedia WWW site, viewed March 13, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. C18 (alternative rock)"}, "madsrdf:citationSource": "NY Times, Jan. 10, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(alternative rock/alternative music: broad label and loose genre/style, used since late 1960s for popular music seen as less commercial and mainstream, and more authentic and \"uncompromising\"; closely associated with independent record labels, and accordingly sometimes referred to as indie music; term \"alternative\" originally used in late 1960s to refer to UK and US underground or counter culture performers; punk in late 1970s was clearly alternative, and present scene builds on remains of punk; alternative label has subsequently been applied to the grunge bands of the late 1980s and 1990s and remnants of the underground/counter culture)"}, "madsrdf:citationSource": "Shuker, R. Key concepts in popular music, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternative rock; label was applied to rock artists who met one or more of the following criteria: they recorded and performed on independent (\"indie\") networks of record companies and venues; they subverted rock and pop conventions musically in some way; or their stylistic pedigree could be traced back to punk; since the mid-1990s, alternative rock has been synonymous with modern and mainstream rock)"}, "madsrdf:citationSource": "Grove music online, viewed March 13, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "no. 709 (alternative rock)"}, "madsrdf:citationSource": "Rolling stone, 1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(originally intended to cover punk and new wave; also covers grunge)"}, "madsrdf:citationSource": "00300326: Strong, M.C. The great alternative & indie discography, 1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Alternative Pop/Rock (catch-all term for post-punk bands from the mid-'80s to the mid-'90s; variety of musical styles within alternative rock, all tied together since they existed outside of the mainstream; lost some of its quirkier tendencies in the '90s, most experimental bands relegated to indie rock)"}, "madsrdf:citationSource": "AMG All Music Guide WWW home page, Feb. 26, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18abd753587241f388af3e4c6fa18644b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alt rock music"}}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alt rock music"}}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18abd753587241f388af3e4c6fa18644b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternative pop rock music"}}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative pop rock music"}}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18abd753587241f388af3e4c6fa18644b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternative music"}}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative music"}}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18abd753587241f388af3e4c6fa18644b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pop music, Alternative"}}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pop music, Alternative"}}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18abd753587241f388af3e4c6fa18644b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indie music"}}, {"@id": "_:n18abd753587241f388af3e4c6fa18644b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indie music"}}], "@id": "/authorities/genreForms/gf2014026632"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026633", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnimated film music", "identifiers:lccn": "gf2014026633", "madsrdf:adminMetadata": [{"@id": "_:n1ee8136e814443928d9da97a79be3942b1"}, {"@id": "_:n1ee8136e814443928d9da97a79be3942b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Animated film music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1ee8136e814443928d9da97a79be3942b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026950"}, "madsrdf:hasSource": [{"@id": "_:n1ee8136e814443928d9da97a79be3942b5"}, {"@id": "_:n1ee8136e814443928d9da97a79be3942b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1ee8136e814443928d9da97a79be3942b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1ee8136e814443928d9da97a79be3942b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n1ee8136e814443928d9da97a79be3942b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Animated film music"}}, {"@id": "_:n1ee8136e814443928d9da97a79be3942b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 99218005: Michelone, G. Bibidi bobidi bu, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ee8136e814443928d9da97a79be3942b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Film music (In the field of animation, film scores quickly achieved a formidable virtuosity; the Disney studio added a soundtrack to Steamboat Willie in 1928 and thereafter specialized in comic shorts and full-length animated musicals, the first of which was Snow White and the seven dwarfs (1937); established Hollywood composers who contributed to full-length animated features include Raskin, Rosenman, and Hans Zimmer)"}, "madsrdf:citationSource": "Grove music online, viewed August 8, 2014:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026633"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026634", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnimated television music", "identifiers:lccn": "gf2014026634", "madsrdf:adminMetadata": [{"@id": "_:n311dc9580c7140859c51c723250ba857b1"}, {"@id": "_:n311dc9580c7140859c51c723250ba857b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Animated television music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n311dc9580c7140859c51c723250ba857b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027132"}, "madsrdf:hasSource": [{"@id": "_:n311dc9580c7140859c51c723250ba857b5"}, {"@id": "_:n311dc9580c7140859c51c723250ba857b6"}, {"@id": "_:n311dc9580c7140859c51c723250ba857b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n311dc9580c7140859c51c723250ba857b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n311dc9580c7140859c51c723250ba857b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n311dc9580c7140859c51c723250ba857b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Animated television music"}}, {"@id": "_:n311dc9580c7140859c51c723250ba857b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (original music from the television series)"}, "madsrdf:citationSource": "The Simpsons [SR] : songs in the key of Springfield, p1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n311dc9580c7140859c51c723250ba857b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (the original sound track recording of the CBS television special)"}, "madsrdf:citationSource": "Work cat.: Guaraldi, V. A Charlie Brown Christmas [SR] p1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n311dc9580c7140859c51c723250ba857b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Television music (Children's cartoon shows provided the same types of music as that found in adult programming; animated shows such as The Simpsons, Family Guy, and King of the Hll have followed the format of The Flintstones as adult cartoons and have employed music imaginatively, using musical style and specific pieces to conjure up parody, metaphor, and irony in their narratives)"}, "madsrdf:citationSource": "Grove music online, viewed August 14, 2014:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026634"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026635", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnthems", "identifiers:lccn": "gf2014026635", "madsrdf:adminMetadata": [{"@id": "_:n66e1609abfd04013a3ab60174e6505a9b1"}, {"@id": "_:n66e1609abfd04013a3ab60174e6505a9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Anthems"}, "madsrdf:elementList": {"@list": [{"@id": "_:n66e1609abfd04013a3ab60174e6505a9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n66e1609abfd04013a3ab60174e6505a9b5"}, {"@id": "_:n66e1609abfd04013a3ab60174e6505a9b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Choral settings of religious or moral texts that are performed in liturgical or ceremonial settings."}, {"@id": "_:n66e1609abfd04013a3ab60174e6505a9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T09:56:33"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n66e1609abfd04013a3ab60174e6505a9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n66e1609abfd04013a3ab60174e6505a9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anthems"}}, {"@id": "_:n66e1609abfd04013a3ab60174e6505a9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a choral setting of a religious or moral text in English, generally designed for liturgical performance)"}, "madsrdf:citationSource": "New Grove dict. of mus. online, Mar. 28, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n66e1609abfd04013a3ab60174e6505a9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a choral composition with a sacred or moralizing text in English, performed in a liturgical or ceremonial context)"}, "madsrdf:citationSource": "New Harvard dict. of mus.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026635"}
