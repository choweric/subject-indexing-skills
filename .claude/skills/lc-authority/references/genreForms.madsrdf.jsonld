{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026671", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBossa nova (Music)", "identifiers:lccn": "gf2014026671", "madsrdf:adminMetadata": [{"@id": "_:nbd76308e68454398a4ba88ad6caaac85b1"}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bossa nova (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbd76308e68454398a4ba88ad6caaac85b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nbd76308e68454398a4ba88ad6caaac85b5"}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b6"}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b7"}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b8"}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bossa nova (Music)"}}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Harvard dict. mus., 1986.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A musical style of Brazilian origin blending elements of the samba and cool jazz)"}, "madsrdf:citationSource": "New Grove dict. jazz, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 92832395: Suzigan, G. Bossa nova, 1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd76308e68454398a4ba88ad6caaac85b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026671"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026672", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBounce (Music)", "identifiers:lccn": "gf2014026672", "madsrdf:adminMetadata": [{"@id": "_:n01baedd8032648e6ae981e09e561e44bb1"}, {"@id": "_:n01baedd8032648e6ae981e09e561e44bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bounce (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n01baedd8032648e6ae981e09e561e44bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027037"}, "madsrdf:hasSource": [{"@id": "_:n01baedd8032648e6ae981e09e561e44bb5"}, {"@id": "_:n01baedd8032648e6ae981e09e561e44bb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n01baedd8032648e6ae981e09e561e44bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n01baedd8032648e6ae981e09e561e44bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n01baedd8032648e6ae981e09e561e44bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bounce (Music)"}}, {"@id": "_:n01baedd8032648e6ae981e09e561e44bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ECIP galley, ch. 3 (In the years between 1992 and 1995, New Orleans's rap scene was transformed by the sudden emergence and rise to widespread local popularity of a distinctive style of rap music, eventually labeled \"bounce.\")"}, "madsrdf:citationSource": "Work cat: 2012003648: Miller, M., Bounce, c2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n01baedd8032648e6ae981e09e561e44bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bounce music; characterized by call and response style party and Mardi Gras Indian chants and dance call-outs that are frequently hypersexual)"}, "madsrdf:citationSource": "Wikipedia, Feb. 1, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026672"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026673", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBourr\u00e9es (Music)", "identifiers:lccn": "gf2014026673", "madsrdf:adminMetadata": [{"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb1"}, {"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bourr\u00e9es (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb5"}, "madsrdf:hasVariant": {"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bourr\u00e9es (Music)"}}, {"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bourr\u00e9e [Bour\u00e9e]; a French folk dance, court dance and instrumental form, which flourished from the mid-17th century until the mid-18th)"}, "madsrdf:citationSource": "Grove music online, viewed July 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bour\u00e9es (Music)"}}, {"@id": "_:n4db1305c29fc4fc5896602df9a5603ebb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bour\u00e9es (Music)"}}], "@id": "/authorities/genreForms/gf2014026673"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026674", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBrega (Music)", "identifiers:lccn": "gf2014026674", "madsrdf:adminMetadata": [{"@id": "_:neee320dbbb1d4f97b742be5989e44b55b1"}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Brega (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:neee320dbbb1d4f97b742be5989e44b55b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:neee320dbbb1d4f97b742be5989e44b55b5"}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b6"}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b7"}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b8"}], "madsrdf:hasVariant": {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Brega (Music)"}}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(brega: term used since ca. 1982 to designate: 1) something cheap, neglected, or badly made; 2) in bad taste, synonymous with \"cafona\" or kitsch; 3) the most banal, obvious, direct, sentimental, and routine music possible, that does not avoid the uncreative use of musical or literary clich\u00e9s. Popularly considered as music made by and for the lowest social classes, brega is generally accepted in economically more powerful segments. Its roots lie in the tragic chansonettes of Vicente Celestino, the bolero-influenced samba-can\u00e7\u00e3o of the 1950s, the boleros of singers like Silvinho and Waldik Soriano, and the imitators and diluters of \"Jovem Guarda\" pop-rock (Paulo S\u00e9rgio, Odair Jos\u00e9, Fernando Mendes, Peninha). In the second half of the 1970s, the musical and interpretative style that would later be labeled \"brega\" was already formed)"}, "madsrdf:citationSource": "Enciclop\u00e9dia da m\u00fasica brasileira popular, erudita e folcl\u00f3rica, 3a ed. rev. e atualizada, 1a reimpr.", "madsrdf:citationStatus": "found"}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Movements, styles & genres: Brega (Tacky). Since the early 1980s, the word brega (tacky) has been used to denominate bad music, usually made for the poorly educated, with big amounts of drama and/or stupidly puerile lyrics. The origins of this undesirable branch of Brazilian music, currently regarded as almost a style, date back to the 1930s. In the following decades, samba-can\u00e7\u00e3o and bolero would push that aesthetic ahead, especially when interpreted by the classically trained voices of Orlando Dias (a widower who would let go of his grief on stage), Nelson Gon\u00e7alves, Altemar Dutra, Waldick Soriano, Agnaldo Tim\u00f3teo, and many others. The style went on through the 90s, with bands that specialized in recreating brega standards for educated audiences. In 1999, brega culture was already so incorporated in the country's culture that Universal released a 6-CD box set, featuring the best of the worst in Brazilian music from the 70s)"}, "madsrdf:citationSource": "AllBrazilianMusic WWW site, Apr. 22, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the word \"brega\" began to be used to define this style of popular song at the beginning of the 1980s; through the 1970s, the expression used was \"cafona\")"}, "madsrdf:citationSource": "Work cat.: 2002354796: Ara\u00fajo, P.C. de. Eu n\u00e3o sou cachorro, n\u00e3o : m\u00fasica popular cafona e ditadura militar, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online WWW site, Apr. 22, 2005;Garland encyc. of world music;Dictionary of popular music styles of the world", "madsrdf:citationStatus": "notfound"}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neee320dbbb1d4f97b742be5989e44b55b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cafona (Music)"}}, {"@id": "_:neee320dbbb1d4f97b742be5989e44b55b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cafona (Music)"}}], "@id": "/authorities/genreForms/gf2014026674"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026675", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBugaku (Music)", "identifiers:lccn": "gf2014026675", "madsrdf:adminMetadata": [{"@id": "_:n99e086eda1d24fa8a2fe0d0a6698aa48b1"}, {"@id": "_:n99e086eda1d24fa8a2fe0d0a6698aa48b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bugaku (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n99e086eda1d24fa8a2fe0d0a6698aa48b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026826"}], "madsrdf:hasSource": {"@id": "_:n99e086eda1d24fa8a2fe0d0a6698aa48b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n99e086eda1d24fa8a2fe0d0a6698aa48b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n99e086eda1d24fa8a2fe0d0a6698aa48b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n99e086eda1d24fa8a2fe0d0a6698aa48b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bugaku (Music)"}}, {"@id": "_:n99e086eda1d24fa8a2fe0d0a6698aa48b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Japan. V, Court music (Gagaku, the ancient traditional music of the Japanese court, today comprises the following repertories: t\u014dgaku, komagaku, saibara, r\u014dei and Shint\u014d ritual music and dance)"}, "madsrdf:citationSource": "Grove music online, viewed July 14, 2014 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026675"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026676", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBullerengue (Music)", "identifiers:lccn": "gf2014026676", "madsrdf:adminMetadata": [{"@id": "_:n342a44066504459d940c0ea6f19c5b19b1"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bullerengue (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n342a44066504459d940c0ea6f19c5b19b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n342a44066504459d940c0ea6f19c5b19b5"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b6"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b7"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b8"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b9"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b10"}], "madsrdf:hasVariant": [{"@id": "_:n342a44066504459d940c0ea6f19c5b19b11"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bullerengue (Music)"}}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Panama (bullerengue, Afro-Panamanian musical tradition found in Darien province; accompaniment to dance consists of several drums, hand clapping and responsorial female singing)"}, "madsrdf:citationSource": "Grove music online, Jan. 29, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Cantadoras afrocolombianas de bullerengue, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Colombia (bullerengue, dance from the Atlantic coastal region with African characteristics; accompanied by a solo singer, a chorus of women, a tambor mayor and a llamador)"}, "madsrdf:citationSource": "Grove music online, Jan. 29, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Garland encyc. of world music: v. 2, p. 405-406 (bullerengue, also known as tambor or chand\u00e9, may have originated in African puberty rites; has become a common musical form with many uses along the Caribbean (Atlantic) coast; frequently occurs at the beginning of festivals and at velorios (wakes) and to accompany the danza de negro; soloist sings texts on subjects such as relationships between the sexes, poverty, death, and the desire to leave his homeland, and the chorus responds with an unchanging refrain)", "madsrdf:citationStatus": "found"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "All Music Guide online, Feb. 8, 2010;Encyclopedia of Latino Popular Culture, 2004;Google Books, Feb. 8, 2010", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "World music genres and song styles (bullerengue, Afro-Colombian song and dance from the Bolivar and Cordoba depts.; women play an important role in both the song and dance)"}, "madsrdf:citationSource": "World Music Central WWW Home page, Feb. 8, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n342a44066504459d940c0ea6f19c5b19b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chand\u00e9 (Music)"}}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chand\u00e9 (Music)"}}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n342a44066504459d940c0ea6f19c5b19b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tambor (Music)"}}, {"@id": "_:n342a44066504459d940c0ea6f19c5b19b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tambor (Music)"}}], "@id": "/authorities/genreForms/gf2014026676"}
