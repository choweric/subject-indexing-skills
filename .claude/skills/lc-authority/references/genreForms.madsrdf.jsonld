{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026624", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:nc6d138df9bd74bc4ba751173bfd9d399b1"}, {"@id": "_:nc6d138df9bd74bc4ba751173bfd9d399b2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is covered by the genre/form term {Sports films} (gf2011026601)."}, "madsrdf:elementList": {"@list": [{"@id": "_:nc6d138df9bd74bc4ba751173bfd9d399b3"}]}, "madsrdf:useInstead": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026601"}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surfing films"}}, {"@id": "_:nc6d138df9bd74bc4ba751173bfd9d399b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc6d138df9bd74bc4ba751173bfd9d399b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-07-16T13:31:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:nc6d138df9bd74bc4ba751173bfd9d399b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surfing films"}}], "@id": "/authorities/genreForms/gf2011026624"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026625", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSurrealist films", "identifiers:lccn": "gf2011026625", "madsrdf:adminMetadata": [{"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b1"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Surrealist films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026235"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026775"}, "madsrdf:hasSource": [{"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b5"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b6"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b7"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b8"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b9"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that employ symbolism, juxtaposition of unlike objects, dream-like sequences, etc., to allow the viewer's subconscious to make free associations.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025612"}}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T15:07:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surrealist films"}}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(listed as subcategory under Surrealist Film (Surrealism): Dada (Dadaism): artistic and literary movement that rejected form and traditional art; believed in \"accidental\" creation, automatic writing and drawing and the use of ready-mades for exhibition as works of art; it produced few filmic manifestations, the movement being superseded by the more vigorous and optimistic surrealist venture.)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Surrealist Film (Surrealism). Surrealism is a movement that seeks to expand reality, to attain a supra-reality...and thus free man from the constraints exerted by society and convention...it focuses on the workings of the subconscious, the power of dreams...Surrealist films are laden with symbols...among the many techniques used by Surrealist filmmakers are the juxtaposition of different objects that one would not associate with each other and the lack of conscious logic in the imagery)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 42 (Surrealism; the first surrealist film, Ren\u00e9 Clair's Entr'acte (1924); key characteristics: dreams; eroticism; irrationality; mirror images; nonlinear. Key works: Being John Malkovich; Un chien andalou. Other works: Entr'acte; La coquille et le clergyman; L'\u00e9toile de mer; L'\u00e2ge d'or; The blood of the poet; Duck soup; Fireworks; Orph\u00e9e; The testament of Orpheus; Last year at Marienbad; The discreet charm of the bourgeoisie; Eraserhead; Blue velvet; Songs from the second floor; You, the living)"}, "madsrdf:citationSource": "Bergan, R. Film isms--, c2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dada: A literary/art movement founded in 1916 in Zurich; to negate the traditional relationship between calculation and creativity in the arts by approaching expression in a more playful, aleatory manner; was a stepping-stone to surrealism, which developed in the 1920s)"}, "madsrdf:citationSource": "Beaver, F.E. Dictionary of film terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 10 (\"The difference between Dada and Surrealist films ... lies in their different strategies of defamiliarizing social reality. Surrealist filmmakers largely rely on conventional cinematography (narratives, optical realism, characters) as a means to draw the viewer into the reality produced by the film. The incoherent, non-narrative, illogical nature of Dada films, which constantly defamiliarize the familiar world through cinematic manipulations, never let the viewer enter the world of the film.\")"}, "madsrdf:citationSource": "Dada and surrealist film, 1996, via Google books, viewed Aug. 10, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c97a640d0ff465485b2f7e8beca0ba6b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Surrealist: work following the Surrealist art movement aesthetic of allowing the subconscious to make free associations with images and content. Surrealist work is similar to Dada in that at times both juxtapose seemingly nonsensical images and vignettes, giving the appearance of spontaneity. However, while Dada is rooted in visual and verbal \"puns\" used for the sake of their own enjoyment and absurdity, Surrealist works use this technique to explore social and political issues)"}, "madsrdf:citationSource": "Moving image genre-form guide online, June 4, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026625"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026626", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSurvival films", "identifiers:lccn": "gf2011026626", "madsrdf:adminMetadata": [{"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b1"}, {"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Survival films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b3"}]}, "madsrdf:exampleNote": "Note under [Disaster films]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026808"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026200"}, "madsrdf:hasSource": [{"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b5"}, {"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b6"}], "madsrdf:hasVariant": {"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature individuals or groups struggling for their lives in a harsh setting. For films that feature a man-made or natural calamity that places people in imminent danger see [Disaster films.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025272"}}, {"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:11:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Survival films"}}, {"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 326 (Survival picture: the survival film places man or woman in a harsh environment and challenges him/her to survive against nature and sometimes against their own kind)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(survival: Fictional work usually set in a desert, island, polar, or other harsh, barren locale, in which an individual or group must struggle for their lives against the forces of nature; related term: disaster)"}, "madsrdf:citationSource": "Moving image genre-form guide online, May 1, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Survival pictures (Motion pictures)"}}, {"@id": "_:n0fb5a93df56b469ab7bad3635320bb18b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Survival pictures (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2011026626"}
