": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd932b42a34594bae97690817f48224afb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Purim music"}}, {"@id": "_:nd932b42a34594bae97690817f48224afb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Purim (Hebrew: \"Lots\"), English Feast of Lots, a joyous Jewish festival commemorating the survival of the Jews who, in the 5th century BC, were marked for death by their Persian rulers. The story is related in the Old Testament Book of Esther)"}, "madsrdf:citationSource": "Britannica online, Sept. 21, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd932b42a34594bae97690817f48224afb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Purim. UF Esther, Feast of; Feast of Esther; Feast of Lots; Lots, Feast of. BT Fasts and feasts--Judaism. RT Half-shekel (Jewish rite))"}, "madsrdf:citationSource": "LCSH, Sept. 21, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd932b42a34594bae97690817f48224afb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Zim, P. Purim sing-a-long : 15 of your favorite Purim songs, \u00a91997.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd932b42a34594bae97690817f48224afb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Purim, or the Feast of Esther, celebrates God's deliverance of his people through the wisdom and godliness of a beautiful woman.)"}, "madsrdf:citationSource": "Purim or the Feast of Esther, via wildolive website, Sept. 21, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd932b42a34594bae97690817f48224afb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Krawitz, M.J. Purim songs, \u00a91956.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd932b42a34594bae97690817f48224afb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Shurin, D. Purim XTC : a 