ulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd81c2bece9ed4fc48cbdfcbbc1ae339ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lesbian comics"}}, {"@id": "_:nd81c2bece9ed4fc48cbdfcbbc1ae339ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel)"}, "madsrdf:citationSource": "Nagata, K. My lesbian experience with loneliness, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd81c2bece9ed4fc48cbdfcbbc1ae339ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 12 (everyone's favorite lesbian comic strip, \"Dykes to Watch Out For\")"}, "madsrdf:citationSource": "Fitch, J.H. Out's gay & lesbian guide to the Web, \u00a91997:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd81c2bece9ed4fc48cbdfcbbc1ae339ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 60 (lesbian comics)"}, "madsrdf:citationSource": "Martindale, K. Un/popular culture : lesbian writing after the sex wars, \u00a91997:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd81c2bece9ed4fc48cbdfcbbc1ae339ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "leaf 134 (the popular lesbian comic strip, \"Dykes to Watch Out For,\" created by Alison Bechdel)"}, "madsrdf:citationSource": "Stein, A.J. Sexuality, generation and the self, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd81c2bece9ed4fc48cbdfcbbc1ae339ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Blue is the Warmest Color is a graphic novel about growing up, falling in love, and coming out. Clementine, a high school student, has an average life: she has friends, family, and the romantic attention of the boys in her school. When her openly gay best friend takes her out on the town, she wanders into a lesbian bar where she encounters Emma: a punkish, confident girl with blue hair. Their attraction is instant and electric, and Clementine finds herself in a relationship that will test her friends, parents, and her own ideas about herself and her identity\")"}, "madsrdf:citationSource": "Work cat.: Maroh, J. Blue is the warmest color, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nd81c2bece9ed4fc48cbdfcbbc1ae339ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel) p. 4 of cover (\"On loving women is a collection of stories about first love and sexual identity. Diane Obomsawin shares her friends' and lovers' personal accounts of coming into their queerness or first finding love with another woman\")"}, "madsrdf:citationSource": "Obomsawin, D. On loving women, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd81c2bece9ed4fc48cbdfcbbc1ae339ab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd81c2bece9ed4fc48cbdfcbbc1ae339ab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Homosexual comics"}}, {"@id": "_:nd81c2bece9ed4fc48cbdfcbbc1ae339ab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Homosexual comics"}}], "@id": "/authorities/genreForms/gf2018026010"}
