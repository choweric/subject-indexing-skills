Forms/gf2017026026"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026100"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026101"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026161"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026040"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026041"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026043"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026136"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026008"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026034"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026147"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions composed or adapted to accompany activities or events, incite actions or emotions, or to use in particular locations."}, {"@id": "_:nf69894b714ce4f9985622a13bc7e70abb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nf69894b714ce4f9985622a13bc7e70abb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:25:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf69894b714ce4f9985622a13bc7e70abb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Functional music"}}], "@id": "/authorities/genreForms/gf2014026821"}
