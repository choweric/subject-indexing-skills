{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027104", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSongs without words (Instrumental music)", "identifiers:lccn": "gf2014027104", "madsrdf:adminMetadata": [{"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b1"}, {"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Songs without words (Instrumental music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b3"}]}, "madsrdf:exampleNote": "Note under [Vocalises]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b5"}, {"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b6"}, {"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b7"}, {"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Instrumental compositions in song style. For compositions for solo voice(s) without text see [Vocalises.]"}, {"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:10:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Songs without words (Instrumental music)"}}, {"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(song without words: an instrumental composition in the style of a song (after Mendelssohn's title Lieder ohne Worte))"}, "madsrdf:citationSource": "Oxford English dict. WWW site, Feb. 2, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Song without words (Ger. Lied ohne Worte; Fr. chanson, chant (or romance) sans paroles): A short piece of a lyrical nature. It is thus like the romance, but unlike it in being confined to piano music. The German form of the term was invented by Mendelssohn)"}, "madsrdf:citationSource": "Grove music online WWW site, Feb. 2, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2006421621: Huber, A. Das Lied ohne Worte als kunst\u00fcbergreifendes Experiment, 2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne8a09f5b9c5042438292f3b34c01f899b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Song/Songs without words, Lied/Lieder ohne Worte, Chanson/Chant/Chants/Romance/Romances sans paroles, Canzoni/Romanza/Romanze senza parole, Pesni\ufe20a\ufe21/Pesni bez slov; used in titles of compositions for various instrumental and vocal mediums of performance)"}, "madsrdf:citationSource": "LC database, Feb. 2, 2007", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027104"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027105", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSoukous (Music)", "identifiers:lccn": "gf2014027105", "madsrdf:adminMetadata": [{"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb1"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Soukous (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb5"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb6"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb7"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb8"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb9"}], "madsrdf:hasVariant": {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soukous (Music)"}}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Soukous; genre emerging in Congo/Zaire now widely played throughout Africa; early influences include highlife and the Cuban rumba; lyrics are often in Lingala; guitars predominate in ensembles of as many as 20 musicians)"}, "madsrdf:citationSource": "Peng. encyc. of popular music, 1990", "madsrdf:citationStatus": "found"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 00511518: Soukouss Club. Tenue correcte exig\u00e9e, 199-.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Soukous; a rumba-like form of popular music from Zaire which became known in Europe during the 1970's through the performances of emigrant groups in Paris)"}, "madsrdf:citationSource": "Wicke, P. Handbuch der popul\u00e4ren Musik, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove dict. of music;New Harvard dict. of music;Guinness encyc. of popular music;Web. 3", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Soukous; popular modern Congolese rumba music; the term is entered under Angola, Central African Republic, Comoros, Congo (Brazzaville), and Congo (Kinshasa); the term means body movement from the French secouer, to shake)"}, "madsrdf:citationSource": "White, D. Dict. of popular music styles of the world, c1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Soukouss (Music)"}}, {"@id": "_:nb85b62b8f3d247f0b9898197396ede5fb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soukouss (Music)"}}], "@id": "/authorities/genreForms/gf2014027105"}
