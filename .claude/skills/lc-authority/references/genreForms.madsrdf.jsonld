n", "@value": "Reggae music"}}, {"@id": "_:nd7bade656bb04a27a49d5fc70d499437b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the modern popular music of Jamaica and its diaspora)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, June 1, 2005", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027045"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027046", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRemixes (Music)", "identifiers:lccn": "gf2014027046", "madsrdf:adminMetadata": [{"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b1"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Remixes (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026925"}, "madsrdf:hasSource": [{"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b5"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b6"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b7"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b8"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b9"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b10"}], "madsrdf:hasVariant": [{"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b11"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b14"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions derived from one or more existing sound recordings through the process known as remixing."}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:56:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Remixes (Music)"}}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(remix (-mixed, -mixing, -mixes) verb: to produce a new version of a piece of music by altering the emphasis of the sound and, in pop music, often adding new tracks in place of existing ones; short definition: produce new version of music; noun: a recording that has been remixed; short definition: new recording)"}, "madsrdf:citationSource": "Encarta dict.", "madsrdf:citationStatus": "found"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(remix)"}, "madsrdf:citationSource": "Wicke, P. Handbuch der popul\u00e4ren Musik, c1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(remix: recording produced by combining sections of existing recorded tracks in new patterns and with new material; found in many different types of popular music, but most usually associated with club dance music)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Oct. 15, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(remix. tr. v. -mixed, -mixing, -mixes. To recombine (audio tracks or channels from a recording) to produce a new or modified audio recording; \"remixed a popular ballad and turned it into a dance hit\". n. A recording produced by remixing)"}, "madsrdf:citationSource": "Amer. heritage dict., 4th ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(remix, remixes, mixes, dance mix(es), disco mix, extended mix, club mix, dance club mix, and many other more distinctive terms involving \"mix\")"}, "madsrdf:citationSource": "LC database, Dec. 7, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "subtitle (the electronic music explosion) pref. (Remix embraces the entire DJ culture, the lifestyle of dance music, and what has become known as electronica) p. 1 (Remix is about dancing, creating music that leaves you with no other choice but to move) p. 36 (Remixing is the art of creating an alternate version of a song or instrumental piece. Early methods such as manual tape splicing and live mixing have given way to a dazzling array of digitally-based tools) p. 41 (A remix can be sampled from any piece of music-- electronic, jazz, rock, funk, classical or world) p. 6, 11, ff. (early remixes were known as extended mixes and club mixes; DJ's create special mixes; \"mixes\" sometimes used instead of remixes) p. 30-34 (lists and describes dance genres remixes are created for: house, acid house, progressive house, techno, dub, jungle, trip-hop, garage, tribal, etc.)"}, "madsrdf:citationSource": "Work cat.: 00100535: Gerrish, B.M. Remix, c2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dance mixes"}}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dance mixes"}}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Club mixes"}}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Club mixes"}}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mixes (Music)"}}, {"@id": "_:n45c6fe54b3554f9d891904e2c0104fa1b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mixes (Music)"}}], "@id": "/authorities/genreForms/gf2014027046"}
