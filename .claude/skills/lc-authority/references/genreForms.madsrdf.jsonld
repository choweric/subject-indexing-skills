df:elementList": {"@list": [{"@id": "_:nf2ae73f8532a4057988094dc09fc1ee5b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Palm Sunday music"}}, {"@id": "_:nf2ae73f8532a4057988094dc09fc1ee5b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Palm Sunday music"}}, {"@id": "_:nf2ae73f8532a4057988094dc09fc1ee5b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ae73f8532a4057988094dc09fc1ee5b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Holy Saturday music"}}, {"@id": "_:nf2ae73f8532a4057988094dc09fc1ee5b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Holy Saturday music"}}, {"@id": "_:nf2ae73f8532a4057988094dc09fc1ee5b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ae73f8532a4057988094dc09fc1ee5b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Passion music"}}, {"@id": "_:nf2ae73f8532a4057988094dc09fc1ee5b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Passion music"}}, {"@id": "_:nf2ae73f8532a4057988094dc09fc1ee5b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ae73f8532a4057988094dc09fc1ee5b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Holy Thursday music"}}, {"@id": "_:nf2ae73f8532a4057988094dc09fc1ee5b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Holy Thursday music"}}], "@id": "/authorities/genreForms/gf2014026861"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026862", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHonkyoku", "identifiers:lccn": "gf2014026862", "madsrdf:adminMetadata": [{"@id": "_:n82f282327d3948d19d89835b2437c1c2b1"}, {"@id": "_:n82f282327d3948d19d89835b2437c1c2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Honkyoku"}, "madsrdf:elementList": {"@list": [{"@id": "_:n82f282327d3948d19d89835b2437c1c2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n82f282327d3948d19d89835b2437c1c2b5"}, {"@id": "_:n82f282327d3948d19d89835b2437c1c2b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n82f282327d3948d19d89835b2437c1c2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n82f282327d3948d19d89835b2437c1c2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n82f282327d3948d19d89835b2437c1c2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Honkyoku"}}, {"@id": "_:n82f282327d3948d19d89835b2437c1c2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 9, p. 533 (honkyoku; originated bet. 14th and 16th cent., reached its final state in early 18th cent.)"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}, {"@id": "_:n82f282327d3948d19d89835b2437c1c2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(honkyoku; one of 2 styles of solo shakuhachi music)"}, "madsrdf:citationSource": "Work cat.: Yokoyama, K. Zen [SR] p1982", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026862"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026863", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHonky-tonk music", "identifiers:lccn": "gf2014026863", "madsrdf:adminMetadata": [{"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab1"}, {"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Honky-tonk music"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026739"}, "madsrdf:hasSource": {"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab5"}, "madsrdf:hasVariant": {"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Honky-tonk music"}}, {"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Honky-tonk music is a genre of American country music that developed in tandem with the burgeoning oil industry of Texas and Oklahoma in the 1930s. Especially after the 1933 repeal of Prohibition, roadhouses, known as honky-tonks... Though related to the stylistic features of western swing, honky-tonk music emphasizes the vocalist in songs with diatonic melodies and basic chord progressions that incorporate aspects of the blues, Tin Pan Alley, and gospel hymnody. To project above the noise of the typical roadhouse, the music features amplified guitar solos over the insistent beat of the rhythm section.)"}, "madsrdf:citationSource": "Grove music online, viewed August 10, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Honkytonk music"}}, {"@id": "_:ne272c2c7f7cf45a1a798505bd38fbb1ab7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Honkytonk music"}}], "@id": "/authorities/genreForms/gf2014026863"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026864", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHornpipes (Music)", "identifiers:lccn": "gf2014026864", "madsrdf:adminMetadata": [{"@id": "_:n7b036dad40664e09899781ccfeb06bd0b1"}, {"@id": "_:n7b036dad40664e09899781ccfeb06bd0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hornpipes (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7b036dad40664e09899781ccfeb06bd0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:n7b036dad40664e09899781ccfeb06bd0b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7b036dad40664e09899781ccfeb06bd0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n7b036dad40664e09899781ccfeb06bd0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7b036dad40664e09899781ccfeb06bd0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hornpipes (Music)"}}, {"@id": "_:n7b036dad40664e09899781ccfeb06bd0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hornpipe. (1) A dance popular in England, Wales, and Scotland from the 16th to 19th centuries related to the jig and country-dance families of dances)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026864"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026865", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHouse music", "identifiers:lccn": "gf2014026865", "madsrdf:adminMetadata": [{"@id": "_:n67942cb839894865860160a7374782a8b1"}, {"@id": "_:n67942cb839894865860160a7374782a8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "House music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n67942cb839894865860160a7374782a8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153"}, "madsrdf:hasSource": [{"@id": "_:n67942cb839894865860160a7374782a8b5"}, {"@id": "_:n67942cb839894865860160a7374782a8b6"}, {"@id": "_:n67942cb839894865860160a7374782a8b7"}, {"@id": "_:n67942cb839894865860160a7374782a8b8"}, {"@id": "_:n67942cb839894865860160a7374782a8b9"}, {"@id": "_:n67942cb839894865860160a7374782a8b10"}, {"@id": "_:n67942cb839894865860160a7374782a8b11"}, {"@id": "_:n67942cb839894865860160a7374782a8b12"}, {"@id": "_:n67942cb839894865860160a7374782a8b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n67942cb839894865860160a7374782a8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n67942cb839894865860160a7374782a8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-07-13T13:04:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "revised"}, {"@id": "_:n67942cb839894865860160a7374782a8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "House music"}}, {"@id": "_:n67942cb839894865860160a7374782a8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(house music; Warehouse DJ Frankie Knuckles took parts of recordings and mixed them up, adding synthesizers and a drum machine's beat; mosaic of rap's rhythm and go-go's percussion, streamlined over a pulsating bass line)"}, "madsrdf:citationSource": "Reader's guide abstracts", "madsrdf:citationStatus": "found"}, {"@id": "_:n67942cb839894865860160a7374782a8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(online record store specializing in all kinds of underground dance music: includes house)"}, "madsrdf:citationSource": "DanceGrooves WWW site, 04-18-00", "madsrdf:citationStatus": "found"}, {"@id": "_:n67942cb839894865860160a7374782a8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(house, house music; dance music, repetitive 4/4 beat, roughly 120-140 bpm; term first used in Chicago in late 1970s; originated in a dance club called the Warehouse; DJ there would mix Philadelphia soul music, New York club music, Euro-disco and sound effects, creating a soundtrack for an entire night, or would re-edit disco favorites, adding a bass rhythm at high volume, using rhythm makers and drum machines; originally aimed at a gay audience, mainly of African-American and Latino background; music has elements of gospel, soul, jazz, funk, and salsa; also shows influence of contemporary European electronic dance music; such categories of music as rave, techno, and trance house share with house music the use of similar technologies, DJ techniques, rhythm, tempo, and places of consumption; in 1987, when Chicago police banned after-hours parties, development of house music there stagnated, but thereafter it spread to the mainly white heterosexual club world of Europe, especially England (where it became the soundtrack for \"acid house parties,\" called \"raves\" from 1989 onwards), the Netherlands, Germany, Belgium, and Italy, gradually losing its African-American sensibilities; European house music styles were then exported back to U.S., where they were known as techno-rave)"}, "madsrdf:citationSource": "Work cat.: 97046173: Rietveld, Hillegonda C. This is our house, c1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n67942cb839894865860160a7374782a8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(UDM; house music is the predominant musical [sub]category of UDM)"}, "madsrdf:citationSource": "Fikentscher, Kai. \"You better work!\" : underground dance music in New York City, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n67942cb839894865860160a7374782a8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(house music/acid house; created around 1981 as musical style for Chicago's Black gay culture; its developer, DJ Frankie Knuckles, mixed speedy disco beats with records of Latin, Philly, Salsoul, and African music; the more hypnotic acid house is a psychedelic variation on the Chicago style, developed in London; so named because the word \"acid,\" Chicago slang for \"sampling\" or \"taking someone else's music,\" was interpreted as a reference to LSD)"}, "madsrdf:citationSource": "New Rolling Stone encyc. of rock & roll, c1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n67942cb839894865860160a7374782a8b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(house, house music; a continuation of disco, that is, classic, Black, urban, Philadelphia, R&B-style disco)"}, "madsrdf:citationSource": "HouseNation.com WWW site, Dec. 9, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n67942cb839894865860160a7374782a8b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hennepin.", "madsrdf:citationStatus": "found"}, {"@id": "_:n67942cb839894865860160a7374782a8b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(house, house music; evolved from disco)"}, "madsrdf:citationSource": "Streetsound's House of House WWW site, Dec. 9, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n67942cb839894865860160a7374782a8b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(supplier of quality underground dance music: includes house [and varieties of house])"}, "madsrdf:citationSource": "WWW.elevatorrecords.com WWW site, Apr. 18, 2000", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026865"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026866", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHuapangos (Music)", "identifiers:lccn": "gf2014026866", "madsrdf:adminMetadata": [{"@id": "_:ne4a079f49aa1448a9f73400416c7318bb1"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Huapangos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne4a079f49aa1448a9f73400416c7318bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027100"}, "madsrdf:hasSource": [{"@id": "_:ne4a079f49aa1448a9f73400416c7318bb5"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb6"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb7"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb8"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb9"}], "madsrdf:hasVariant": [{"@id": "_:ne4a079f49aa1448a9f73400416c7318bb10"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb13"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Huapangos (Music)"}}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 608 (under Mexico, M\u00fasica regional: the mestizo son, Regional sones: Son huasteco of the northwestern geocultural region known as the Huasteca; also known as huapango; typically performed by a trio of musicians playing a violin, a huapanguera (guitarra quinta, a deep-bodied guitar with eight strings in five single and double courses), and a jarana (small five-stringed guitar); vocal style includes brief, ornamental breaks into falsetto)"}, "madsrdf:citationSource": "Garland encyc. world mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(huapango (guapango))"}, "madsrdf:citationSource": "Diccionario de la m\u00fasica espa\u00f1ola e hispanoamericana", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Mexico, sec. II, 2: Traditional music: Mestizo forms: The huapango (also known as huasteco) is both a type of son and a widespread Mexican term for a type of son accompaniment pattern executed rasgueado on instruments of the guitar family in much of Latin America. As a musical form the huapango is indigenous to the Huastec region, which extends from the Gulf Coast south of Tampico into the Highlands. The word huapango itself derives from a Nahuatl word for the raised wooden platform on which the dance may be executed. The normal ensemble consists of one violin, a jarana and a huapanguera (large five-course guitar with eight or ten strings))"}, "madsrdf:citationSource": "Grovemusic.com WWW site, Feb. 4, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Huapango: Traditional dance and dance music of the Huasteca region of northern Veracruz and adjacent states in Mexico, also known as son huasteco; lyric texts most typically sung by two vocalists in alternation and with frequent falsetto; accompanied by an ensemble of violin, five-string jarana, and eight-string guitarra quinta (huapanguera); the term huapango is also often applied to the related son jarocho of the southern Gulf coastal plain of Mexico, and the distinctive huapango rhythm, in simplified form, has been widely popularized)"}, "madsrdf:citationSource": "New Harvard dict. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(huapangos)"}, "madsrdf:citationSource": "Work cat.: 2002388762: Aguilar Le\u00f3n, J.J. Los trovadores huastecos en Tamaulipas, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne4a079f49aa1448a9f73400416c7318bb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sones huastecos (Music)"}}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sones huastecos (Music)"}}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne4a079f49aa1448a9f73400416c7318bb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Huastecos (Music)"}}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Huastecos (Music)"}}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne4a079f49aa1448a9f73400416c7318bb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Guapangos (Music)"}}, {"@id": "_:ne4a079f49aa1448a9f73400416c7318bb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Guapangos (Music)"}}], "@id": "/authorities/genreForms/gf2014026866"}
