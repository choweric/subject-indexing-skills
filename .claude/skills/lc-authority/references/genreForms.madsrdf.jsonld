{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026318", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHome shopping television programs", "identifiers:lccn": "gf2011026318", "madsrdf:adminMetadata": [{"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb1"}, {"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Home shopping television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb3"}]}, "madsrdf:exampleNote": "Note under [Infomercials]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026331"}, "madsrdf:hasSource": [{"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb5"}, {"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb6"}, {"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Live television programs that purvey a wide variety of goods that can be purchased by the viewers. For program length television commercials that are devoted to one product, and that usually include a discussion or demonstration, see [Infomercials.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025244"}}, {"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T09:50:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Home shopping television programs"}}, {"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(home shopping: Television work in which hosts display various types of merchandise that the viewer can then purchase by using the telephone)"}, "madsrdf:citationSource": "Moving image genre-form guide, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"home shopping\" usually associated exclusively with television shopping, as in the Home Shopping Network; shopping programs: ongoing programs, some of which are broadcast 24 hours a day, purvey a wide variety of goods, and are broadcast on network, cable, and satellite television; contrasted with infomercials, which are program length TV commercials devoted solely to one product)"}, "madsrdf:citationSource": "Home shopping in the United States, April 2005 via Research and Markets WWW Homepage, Aug. 27, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6634a41ca09e4a65b3578b85ae01a9acb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(home shopping is a term now used to describe the live, 24 hour per day home shopping networks)"}, "madsrdf:citationSource": "Infomercial.tv glossary WWW Home page, Aug. 27, 2007:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026318"}
