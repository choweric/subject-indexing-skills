{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026065", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlcaics", "identifiers:lccn": "gf2020026065", "madsrdf:adminMetadata": [{"@id": "_:n8daf5408c0dc4433bfd1320192678362b1"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Alcaics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8daf5408c0dc4433bfd1320192678362b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n8daf5408c0dc4433bfd1320192678362b5"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b6"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b7"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b8"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b9"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b10"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b11"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b12"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b13"}], "madsrdf:hasVariant": {"@id": "_:n8daf5408c0dc4433bfd1320192678362b14"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-08-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-11-13T13:45:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alcaics"}}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(alcaic adjective: A four-line verse stanza in the meter invented by the Greek poet Alcaeus, and later used in a slightly altered form by the Roman poet Horace; alcaics plural nount: Alcaic verse)"}, "madsrdf:citationSource": "Lexico (OED) website, Aug. 20, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(alcaic adjective, often capitalized: relating to or written in a verse or strophe marked by complicated variation of a dominant iambic pattern; alcaic noun, often capitalized)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Aug. 20, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)277993251"}, "madsrdf:citationSource": "Horton-Smith, L.G.H. Mors Sauli in monte Gilboa interfecti : a poem in Latin alcaics, 1899.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "contents (Alcaics before Horace -- The Horatian alcaic -- Post-Horatian alcaics in Latin -- Alcaics into English)"}, "madsrdf:citationSource": "Talbot, J. The alcaic strophe : a critical survey, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. vi (Alcaic strophe, as reputedly invented by Alcaeus, Greek lyric poet from Mytilene, around 600 B.C.) (OCoLC)619128"}, "madsrdf:citationSource": "Work cat.: H\u00f6lderlin, F. Alcaic poems, 1963:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alcaic, classical Greek poetic stanza composed of four lines of varied metrical feet, with five long syllables in the first two lines, four in the third and fourth lines, and an unaccented syllable at the beginning of the first three lines (anacrusis). Named for and perhaps invented by Alcaeus, a poet of the late 7th and early 6th centuries BC, the alcaic became an important Latin verse form, especially in the Odes of Horace. Variations on the traditional alcaic include the use of a long initial syllable and of a spondee in the first complete foot of the first three lines. Alcaics were adapted to English and French verse during the Renaissance and later appeared in works such as \"Milton\" by Alfred, Lord Tennyson)"}, "madsrdf:citationSource": "Britannica online, Aug. 20, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bonavia-Hunt, N.A. Horace the minstrel : a study of his sapphic and alcaic lyrics, 1954", "madsrdf:citationStatus": "found"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (posthumous poem by Edwin Arlington Robinson) cover (an alcaic) (OCoLC)1281058"}, "madsrdf:citationSource": "Robinson, E.A. Hannibal Brown, 1936:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alcaic: A four-line stanza invented by the Classical Greek poet Alcaeus that employs a specific syllabic count per line and a predominantly dactylic meter. Alfred, Lord Tennyson imitated its form in his poem \"Milton.\")"}, "madsrdf:citationSource": "Glossary of poetic terms, via Poetry Foundation website, Aug. 20, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8daf5408c0dc4433bfd1320192678362b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alcaic verse"}}, {"@id": "_:n8daf5408c0dc4433bfd1320192678362b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alcaic verse"}}], "@id": "/authorities/genreForms/gf2020026065"}
