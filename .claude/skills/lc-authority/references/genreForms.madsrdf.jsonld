d": "_:nec5165711cef483c878c37ef2bc8fc05b55"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b58"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b61"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b64"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music that is traditionally associated with Shavuot."}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shavuot music"}}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hag habikurim : Festival of First Fruits : a choral pageant, c1947.", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Shevuot = Shavu\u02bbot, 195-?", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Shovuoth Feast of Weeks, 19--?", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Shavuot. UF Feast of Weeks; Jewish Pentecost; Pentecost Festival, Jewish; Shabuot; Shabuoth; Shavuos; Shavuoth; Shavu\u02bboth (Feast of Weeks); Shevuos; Shevuoth)"}, "madsrdf:citationSource": "LCSH, Dec. 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Shovuoth : Feast of Weeks, 1928.", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Songs from the Festival of First Fruits, 194-?", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "My favorite Lag b'Omer & Shavuos piano book, 2003?", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lag b'Omer and Shavuot songster, 1941.", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Shavuot (Shavuot (or Shovuos, in Ashkenazi usage; Shavu\u02bfoth in Sephardi and Mizrahi Hebrew, known as the Feast of Weeks in English and as Pentecost in Ancient Greek, is a Jewish holiday that occurs on the sixth day of the Hebrew month of Sivan (late May or early June). Shavuot commemorates the anniversary of the day God gave the Torah to the entire nation of Israel assembled at Mount Sinai ... The holiday is one of the Shalosh Regalim, the three Biblical pilgrimage festivals.) Three Pilgrimage Festivals (The Three Pilgrimage Festivals, known as the Shalosh Regalim, are three major festivals in Judaism - Pesach (Passover), Shavuot (Weeks), and Sukkot (Tents or Booths) - when the Israelites living in the Kingdom of Judah would make a pilgrimage to Temple in Jerusalem, as commanded by the Torah. After the destruction of the Second Temple and until the building of the Third Temple, the actual pilgrimage is no longer obligatory upon Jews, and no longer takes place on a national scale. ... During the Jewish holidays in modern-day Israel, many Jews living in or near Jerusalem make an effort to attend prayer services at the Western Wall \"emulating\" the ancient \"pilgrimages\" in some small fashion)"}, "madsrdf:citationSource": "Wikipedia, Dec. 14, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Songs for Shavuot, 196-?", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "10 Shavuot songs : for accordion, 1966?", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nec5165711cef483c878c37ef2bc8fc05b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "\u1e24ag ha-bikurim music"}}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "\u1e24ag ha-bikurim music"}}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nec5165711cef483c878c37ef2bc8fc05b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shabuot music"}}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shabuot music"}}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nec5165711cef483c878c37ef2bc8fc05b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Feast of First Fruits music"}}, {"@id": "_:nec5165711cef483c878c37ef2bc8fc05b23", "@typ