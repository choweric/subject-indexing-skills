{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026661", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision game shows", "identifiers:lccn": "gf2011026661", "madsrdf:adminMetadata": [{"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b1"}, {"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television game shows"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b3"}]}, "madsrdf:exampleNote": "Note under [Television quiz shows]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasSource": [{"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b5"}, {"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b6"}], "madsrdf:hasVariant": {"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that feature contestants participating in various types of competitive activities for prizes. For television programs that feature a question-and-answer format see [Television quiz shows.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025625"}}, {"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:13:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television game shows"}}, {"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 51 (Game shows: use for programs on which two or more celebrities or members of the viewing public compete, following specific rules, usually for prizes)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Game: television work in which contestants participate in various types of competitive activities for prizes, usually by answering questions on given topics. The prizes can range from automobiles to cash awards to \"dates,\" and the mediating role of the host with contestants and celebrities is an important entertainment element)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 5, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Game shows (Television programs)"}}, {"@id": "_:n2cd548b22d194998955ebaca20c8e3c7b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Game shows (Television programs)"}}], "@id": "/authorities/genreForms/gf2011026661"}
