3cc77815042db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Latin jazz; sometimes called Afro-Cuban jazz)"}, "madsrdf:citationSource": "All-music guide WWW site, Feb. 3, 1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n16cdc939eb2f4bfea9913cc77815042db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Latin jazz)"}, "madsrdf:citationSource": "New Grove dict. of jazz", "madsrdf:citationStatus": "found"}, {"@id": "_:n16cdc939eb2f4bfea9913cc77815042db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Latin jazz)"}, "madsrdf:citationSource": "Hennepin", "madsrdf:citationStatus": "found"}, {"@id": "_:n16cdc939eb2f4bfea9913cc77815042db8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n16cdc939eb2f4bfea9913cc77815042db9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Afro-Cuban jazz"}}, {"@id": "_:n16cdc939eb2f4bfea9913cc77815042db9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Afro-Cuban jazz"}}], "@id": "/authorities/genreForms/gf2014026903"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026904", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLatin pop", "identifiers:lccn": "gf2014026904", "madsrdf:adminMetadata": [{"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b1"}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Latin pop"}, "madsrdf:elementList": {"@list": [{"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b5"}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b6"}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b7"}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b8"}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Latin pop"}}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Grammy Awards: Latin: best Latin pop album)"}, "madsrdf:citationSource": "Wikipedia WWW site, Aug. 16, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Latin pop)"}, "madsrdf:citationSource": "Amazon.com, Aug. 16, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Pop, North America, the 1990s: Latin pop)"}, "madsrdf:citationSource": "Grove music online, Aug. 16, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Latin pop became the most popular form of Latin music in the United States during the '80s and '90s. It retained Latin rhythms in its uptempo numbers but relied more on mainstream pop for its melodic sense. Most of its artists sang in Spanish for Latino audiences, although Latin pop's similarity to the mainstream helped several performers score crossover hits when they chose to record in English. Latin pop's first major crossover star was Gloria Estefan; others include Jon Secada, Selena, Ricky Martin, and Jennifer Lopez. Under Latin: Latin pop--either dance-based or pop oriented-music sung in Spanish or Tejano)"}, "madsrdf:citationSource": "All music guide WWW site, Aug. 16, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n06222da3ae6740479ba1ea9ebad201c3b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Martin, R. Vuelve [SR] p1998.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026904"}
