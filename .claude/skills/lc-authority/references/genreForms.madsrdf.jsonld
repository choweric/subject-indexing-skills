{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2012025002", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPeep shows (Motion pictures)", "identifiers:lccn": "gf2012025002", "madsrdf:adminMetadata": [{"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b1"}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Peep shows (Motion pictures)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b5"}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b6"}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b7"}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b8"}], "madsrdf:hasVariant": [{"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b9"}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short films intended to be viewed through a small hole or magnifying glass."}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-01-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:13:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Peep shows (Motion pictures)"}}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A peep show or peepshow is an exhibition of pictures, objects or people viewed through a small hole or magnifying glass)"}, "madsrdf:citationSource": "Wikipedia WWW site, viewed Jan. 20, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 104-105 (The boxing cats (Prof. Welton's) was filmed mid-July 1894 in Edison's Black Maria studio)"}, "madsrdf:citationSource": "Musser, C. Edison motion pictures 1890-1900, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "History of the motion picture (the Edison Co. established the Black Maria studio to supply films for their Kinetoscope, a peep-show viewing device. In April, 1894 the first Kinetoscope parlour opened in New York City)"}, "madsrdf:citationSource": "Britannica online, viewed Jan. 30, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 98799004: The boxing cats (Prof. Welton's), 1894.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Peepshows (Motion pictures)"}}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Peepshows (Motion pictures)"}}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Raree shows (Motion pictures)"}}, {"@id": "_:n0c4d6b13f1f04cc585c69180b13bde00b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Raree shows (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2012025002"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2012025003", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFilmed vaudeville acts", "identifiers:lccn": "gf2012025003", "madsrdf:adminMetadata": [{"@id": "_:ne0d69d133188437c9775394a2a8b119ab1"}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Filmed vaudeville acts"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne0d69d133188437c9775394a2a8b119ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026276"}, "madsrdf:hasSource": [{"@id": "_:ne0d69d133188437c9775394a2a8b119ab5"}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab6"}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab7"}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab8"}], "madsrdf:hasVariant": {"@id": "_:ne0d69d133188437c9775394a2a8b119ab9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-01-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:12:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed vaudeville acts"}}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 101 (Vaudeville; use for films of video used to record a vaudeville performance)"}, "madsrdf:citationSource": "Yee, M. Moving image materials: genre terms, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "American Memory exhibit, American Variety Stage: Vaudeville and Popular Entertainment 1870-1920 (The use of vaudeville acts as material for motion pictures made sense for early filmmakers. Early films were very short; thus the abbreviated nature of the early vaudeville act, or \"turn,\" made an ideal subject for films. Vaudeville and other types of popular entertainment offered a pool of ready talent for filmmakers who frequently chose to record the less expensive, and, therefore, less famous)"}, "madsrdf:citationSource": "Library of Congress WWW site, viewed Jan. 30, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 96520338: Ameta, 1903.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(vaudville; a light entertainment popular from the mid-1890s until the early 1930s that consisted of 10 to 14 individual unrelated acts, featuring magicians, acrobats, comedians, trained animals, jugglers, singers, and dancers)"}, "madsrdf:citationSource": "Encyclopedia Britannica online, viewed Jan. 30, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne0d69d133188437c9775394a2a8b119ab10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vaudeville acts, Filmed"}}, {"@id": "_:ne0d69d133188437c9775394a2a8b119ab10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vaudeville acts, Filmed"}}], "@id": "/authorities/genreForms/gf2012025003"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2012025004", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFilmed burlesque acts", "identifiers:lccn": "gf2012025004", "madsrdf:adminMetadata": [{"@id": "_:n302aeedf85394340a4561c0a43c542d9b1"}, {"@id": "_:n302aeedf85394340a4561c0a43c542d9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Filmed burlesque acts"}, "madsrdf:elementList": {"@list": [{"@id": "_:n302aeedf85394340a4561c0a43c542d9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026276"}, "madsrdf:hasSource": [{"@id": "_:n302aeedf85394340a4561c0a43c542d9b5"}, {"@id": "_:n302aeedf85394340a4561c0a43c542d9b6"}, {"@id": "_:n302aeedf85394340a4561c0a43c542d9b7"}], "madsrdf:hasVariant": {"@id": "_:n302aeedf85394340a4561c0a43c542d9b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n302aeedf85394340a4561c0a43c542d9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-01-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n302aeedf85394340a4561c0a43c542d9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-23T16:21:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n302aeedf85394340a4561c0a43c542d9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed burlesque acts"}}, {"@id": "_:n302aeedf85394340a4561c0a43c542d9b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 96519945: From showgirl to burlesque queen, 1903.", "madsrdf:citationStatus": "found"}, {"@id": "_:n302aeedf85394340a4561c0a43c542d9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(burlesque show: stage entertainment, developed in the United States, that came to be designed for exclusively male patronage; included slapstick sketches, dirty jokes, coarsely humorous sketches or \"bits\", variety acts, a \"burlesque\" on politics or a current play, wrestling or boxing matches, and exotic dances billed as \"daring\" or \"sensational\"; with their show of exposed legs and bawdy, obscene entertainment, burlesque shows were not considered respectable)"}, "madsrdf:citationSource": "Encyclopedia Britannica online, viewed Jan. 30, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n302aeedf85394340a4561c0a43c542d9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "American Memory exhibit, American Variety Stage: Vaudeville and Popular Entertainment 1870-1920 (The word \"burlesque\" refers to two kinds of entertainment. In its original meaning, burlesque signified a comedy that parodied its original source. Burlesque eventually also came to denote \"leg shows\" or acts that focused on a woman's body and featured scantily-clad women, often in the act of undressing. The films in this collection do not represent the full range of burlesque on the variety stage ... Still, filmmakers took burlesque subjects as their inspiration and captured burlesque performers)"}, "madsrdf:citationSource": "Library of Congress WWW site, viewed Jan. 30, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n302aeedf85394340a4561c0a43c542d9b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n302aeedf85394340a4561c0a43c542d9b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Burlesque acts, Filmed"}}, {"@id": "_:n302aeedf85394340a4561c0a43c542d9b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Burlesque acts, Filmed"}}], "@id": "/authorities/genreForms/gf2012025004"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2012025005", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFilmed parades", "identifiers:lccn": "gf2012025005", "madsrdf:adminMetadata": [{"@id": "_:n9c031bd61c984d2d9d9824920f405485b1"}, {"@id": "_:n9c031bd61c984d2d9d9824920f405485b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Filmed parades"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9c031bd61c984d2d9d9824920f405485b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026423"}, "madsrdf:hasSource": [{"@id": "_:n9c031bd61c984d2d9d9824920f405485b5"}, {"@id": "_:n9c031bd61c984d2d9d9824920f405485b6"}], "madsrdf:hasVariant": {"@id": "_:n9c031bd61c984d2d9d9824920f405485b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9c031bd61c984d2d9d9824920f405485b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-01-31T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9c031bd61c984d2d9d9824920f405485b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-23T16:23:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9c031bd61c984d2d9d9824920f405485b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed parades"}}, {"@id": "_:n9c031bd61c984d2d9d9824920f405485b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 98501278: Admiral Dewey leading land parade, 1899.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c031bd61c984d2d9d9824920f405485b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "American Memory exhibit, The Spanish-American War in Motion Pictures (These films were made by the Edison Manufacturing Company and the American Mutoscope & Biograph Company and consist of actualities filmed in the U.S., Cuba, and the Philippines, showing troops, ships, notable figures, and parades)"}, "madsrdf:citationSource": "Library of Congress WWW site, viewed Jan. 31, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c031bd61c984d2d9d9824920f405485b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9c031bd61c984d2d9d9824920f405485b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Parades, Filmed"}}, {"@id": "_:n9c031bd61c984d2d9d9824920f405485b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Parades, Filmed"}}], "@id": "/authorities/genreForms/gf2012025005"}
