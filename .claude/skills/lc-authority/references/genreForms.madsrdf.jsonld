y/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:46:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n36375348895e484ea3430382cdd868ccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aerial photographs"}}, {"@id": "_:n36375348895e484ea3430382cdd868ccb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (aerial photograph: Any photograph taken from the air. When used in a cartographic context, this term normally refers to photographs of the surface of the Earth (or other celestial body) taken downwards, vertically, or at a predetermined angle from the vertical)"}, "madsrdf:citationSource": "Cartographic materials, 2002, 2005 update via Cataloger's Desktop March 23, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n36375348895e484ea3430382cdd868ccb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "photograph, aerial (a photograph taken from the air)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026032"}
