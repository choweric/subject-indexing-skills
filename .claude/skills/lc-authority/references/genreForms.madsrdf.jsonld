{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027074", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScat singing", "identifiers:lccn": "gf2014027074", "madsrdf:adminMetadata": [{"@id": "_:nda5892999fce4c70bb38f5218259cffeb1"}, {"@id": "_:nda5892999fce4c70bb38f5218259cffeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Scat singing"}, "madsrdf:elementList": {"@list": [{"@id": "_:nda5892999fce4c70bb38f5218259cffeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": {"@id": "_:nda5892999fce4c70bb38f5218259cffeb5"}, "madsrdf:hasVariant": {"@id": "_:nda5892999fce4c70bb38f5218259cffeb6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions in which a singer improvises syllables and melodies in jazz style."}, {"@id": "_:nda5892999fce4c70bb38f5218259cffeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:57:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nda5892999fce4c70bb38f5218259cffeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nda5892999fce4c70bb38f5218259cffeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scat singing"}}, {"@id": "_:nda5892999fce4c70bb38f5218259cffeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A technique of jazz singing in which onomatopoeic or nonsense syllables are sung to improvised melodies)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Mar. 26, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nda5892999fce4c70bb38f5218259cffeb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nda5892999fce4c70bb38f5218259cffeb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jazz scat singing"}}, {"@id": "_:nda5892999fce4c70bb38f5218259cffeb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jazz scat singing"}}], "@id": "/authorities/genreForms/gf2014027074"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027075", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScherzos", "identifiers:lccn": "gf2014027075", "madsrdf:adminMetadata": [{"@id": "_:na344719614d74793ac165ecf500c9634b1"}, {"@id": "_:na344719614d74793ac165ecf500c9634b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Scherzos"}, "madsrdf:elementList": {"@list": [{"@id": "_:na344719614d74793ac165ecf500c9634b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:na344719614d74793ac165ecf500c9634b5"}, {"@id": "_:na344719614d74793ac165ecf500c9634b6"}, {"@id": "_:na344719614d74793ac165ecf500c9634b7"}, {"@id": "_:na344719614d74793ac165ecf500c9634b8"}, {"@id": "_:na344719614d74793ac165ecf500c9634b9"}, {"@id": "_:na344719614d74793ac165ecf500c9634b10"}, {"@id": "_:na344719614d74793ac165ecf500c9634b11"}, {"@id": "_:na344719614d74793ac165ecf500c9634b12"}], "madsrdf:hasVariant": [{"@id": "_:na344719614d74793ac165ecf500c9634b13"}, {"@id": "_:na344719614d74793ac165ecf500c9634b16"}, {"@id": "_:na344719614d74793ac165ecf500c9634b19"}, {"@id": "_:na344719614d74793ac165ecf500c9634b22"}, {"@id": "_:na344719614d74793ac165ecf500c9634b25"}, {"@id": "_:na344719614d74793ac165ecf500c9634b28"}, {"@id": "_:na344719614d74793ac165ecf500c9634b31"}, {"@id": "_:na344719614d74793ac165ecf500c9634b34"}, {"@id": "_:na344719614d74793ac165ecf500c9634b37"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na344719614d74793ac165ecf500c9634b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-15T15:20:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:na344719614d74793ac165ecf500c9634b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scherzos"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(includes: Scherzino mexicano / Manuel Ponce)"}, "madsrdf:citationSource": "Mexico entre dos siglos, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:na344719614d74793ac165ecf500c9634b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Scherzo (It.: \"joke\"). Term applied to a number of types of piece since the early 17th century. The Italian word scherzo and its derivatives came from the German Scherz and scherzen (\"to joke\") in the late Middle Ages. Since Beethoven's time it has been applied generically to any movement that takes the place of a minuet in a sonata cycle (whether or not specifically labelled \"scherzo\"), and it has also been used to indicate a comic or ironically comic composition, usually fast-moving and often one movement within a larger work; scherzi; scherzos; earliest examples of scherzos as independent movements are three by J.S. Bach; the orchestral scherzo appeared during the first half of the 19th century. Related terminology: A number of terms related to \"scherzo\" occasionally appear, among them the performance direction \"scherzando\" and the diminutive \"scherzetto\". \"Scherzando\" (\"jokingly\"), from the gerund of scherzare, is used primarily as a performing direction and as a title, usually as the heading of a movement. ... Loosely used by musicians, \"scherzando\" may serve equally as noun or modifier; Two diminutives of scherzo are \"scherzino\" and \"scherzetto\". The former is the more widely used; \"Scherzetto\", which appears in the second half of the century, is applied more often to individual pieces than to movements within longer works. The whimsicality implicit in these terms is exemplified in Alkan's usage in his 48 motifs op.63 - one a \"scherzetto\" with a \"trioletto\", the other a \"scherzettino\". None of these terms necessarily indicates a composition significantly smaller (i.e. shorter, lighter or simpler) than an ordinary scherzo)"}, "madsrdf:citationSource": "Grove music online, Mar. 19, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:na344719614d74793ac165ecf500c9634b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(scherzetto, scherzino: A short scherzo)"}, "madsrdf:citationSource": "The concise Oxford dictionary of music, 1996", "madsrdf:citationStatus": "found"}, {"@id": "_:na344719614d74793ac165ecf500c9634b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove.", "madsrdf:citationStatus": "found"}, {"@id": "_:na344719614d74793ac165ecf500c9634b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 99-388185: Orgelscherzi der Belle Epoque, c1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:na344719614d74793ac165ecf500c9634b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Harvard dict. of music.", "madsrdf:citationStatus": "found"}, {"@id": "_:na344719614d74793ac165ecf500c9634b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Scherzo, plural scherzos or scherzi, in music, frequently the third movement of a symphony, sonata, or string quartet; also, in the Baroque era (c. 1600-c. 1750), a light vocal or instrumental piece (e.g., the Scherzi musicali of Claudio Monteverdi, 1607), and, in the 19th century, an independent orchestral composition. In symphonies, sonatas, and string quartets of the 19th century, the scherzo replaced the 18th-century minuet. Unlike the rather stately minuet, originally a dance of the aristocracy, the scherzo in rapid 3/4 time was replete with elements of surprise in dynamics and orchestration. ... In the 19th century the scherzo was not necessarily bound to larger works, but it was still a characteristically swift-moving piece of music. Brilliant effects of orchestration and exhilarating rhythms in a swift tempo characterize Felix Mendelssohn's scherzo from his Midsummer Night's Dream, while in the four piano scherzos of Fr\u00e9d\u00e9ric Chopin dramatic, somewhat dark moods alternate with more lyrical trios. A later Romantic example is Paul Dukas's The Sorcerer's Apprentice, a \"scherzo based on a ballad of Goethe,\" and in the early 20th century Igor Stravinsky wrote his Scherzo \u00e0 la Russe, set first for jazz band and later for full orchestra.)"}, "madsrdf:citationSource": "Britannica online, Mar. 19, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:na344719614d74793ac165ecf500c9634b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(scherzo (plural scherzos or scherzi), see also: scherzando, scherzino; scherzetto (plural scherzetti), diminutive of: scherzo); scherzando (plural scherzandos or scherzandi))"}, "madsrdf:citationSource": "Wiktionary, Mar. 19, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:na344719614d74793ac165ecf500c9634b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na344719614d74793ac165ecf500c9634b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scherzettinos"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scherzettinos"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na344719614d74793ac165ecf500c9634b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scherzini"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scherzini"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na344719614d74793ac165ecf500c9634b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scherzandi"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scherzandi"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na344719614d74793ac165ecf500c9634b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scherzettini"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scherzettini"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na344719614d74793ac165ecf500c9634b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scherzandos"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scherzandos"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na344719614d74793ac165ecf500c9634b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scherzinos"}}, {"@id": "_:na344719614d74793ac165ecf500c9634b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@l