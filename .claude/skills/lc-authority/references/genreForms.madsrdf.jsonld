GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n31882ecbac3848bfae438506adf221bdb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Seder songs"}}, {"@id": "_:n31882ecbac3848bfae438506adf221bdb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Seder songs"}}, {"@id": "_:n31882ecbac3848bfae438506adf221bdb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n31882ecbac3848bfae438506adf221bdb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Seder music"}}, {"@id": "_:n31882ecbac3848bfae438506adf221bdb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Seder music"}}], "@id": "/authorities/genreForms/gf2014026992"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026993", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPastoral music", "identifiers:lccn": "gf2014026993", "madsrdf:adminMetadata": [{"@id": "_:nd847c28bd858488f963b95e5dde948bfb1"}, {"@id": "_:nd847c28bd858488f963b95e5dde948bfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pastoral music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd847c28bd858488f963b95e5dde948bfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": {"@id": "_:nd847c28bd858488f963b95e5dde948bfb5"}, "madsrdf:hasVariant": {"@id": "_:nd847c28bd858488f963b95e5dde948bfb6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music that portrays rural life or a rural atmosphere."}, {"@id": "_:nd847c28bd858488f963b95e5dde948bfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:52:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd847c28bd858488f963b95e5dde948bfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd847c28bd858488f963b95e5dde948bfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastoral music"}}, {"@id": "_:nd847c28bd858488f963b95e5dde948bfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pastoral (also pastorale; A literary, dramatic or musical genre that depicts the characters and scenes of rural life or is expressive of its atmosphere. The term has been used in musical titles as both an adjective (Beethoven's Pastoral Symphony) and a noun (Franck's Pastorale) and may be used both ways in referring to the type in general.)"}, "madsrdf:citationSource": "Grove music online, Jan. 28, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd847c28bd858488f963b95e5dde948bfb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd847c28bd858488f963b95e5dde948bfb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pastorale (Music)"}}, {"@id": "_:nd847c28bd858488f963b95e5dde948bfb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastorale (Music)"}}], "@id": "/authorities/genreForms/gf2014026993"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026994", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPavans (Music)", "identifiers:lccn": "gf2014026994", "madsrdf:adminMetadata": [{"@id": "_:ncdde15e84d774493b61f414714bd0fdab1"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pavans (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncdde15e84d774493b61f414714bd0fdab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:ncdde15e84d774493b61f414714bd0fdab5"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab6"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab7"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab8"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab9"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab10"}], "madsrdf:hasVariant": [{"@id": "_:ncdde15e84d774493b61f414714bd0fdab11"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab14"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab17"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:25:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pavans (Music)"}}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "contents (Pavane and gaillarde / Estienne Dutertre)"}, "madsrdf:citationSource": "Renaissance of the spirit, \u21172000:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mil\u00e1n, L. Six pavanas and a fantasia, \u00a91961.", "madsrdf:citationStatus": "found"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pavan [pavane, paven, pavin] (It. pavana, padovana; Fr. pavane; Ger. Paduana). A court dance of the 16th and early 17th centuries. There are hundreds of examples in the contemporary sources of consort, keyboard and lute music; the music of a pavan is almost invariably in duple metre (two or four beats to the bar in modern transcriptions) and usually consists of two, three or four sections of regular metrical structure, each repeated; Like other dance forms of the Renaissance and Baroque periods, the pavan has occasionally been reinterpreted by more recent composers; Pavans by Faur\u00e9 (op.50, 1887) and Ravel (Pavane pour une infante d\u00e9funte, 1899; 'Pavane de la belle au bois dormant' from Ma m\u00e8re l'oye, 1908-10) are justly celebrated))"}, "madsrdf:citationSource": "Grove music online, Oct. 1, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pavane, or less commonly pavan: 1. a stately court dance by couples that was introduced from southern Europe into England in the 16th century. 2. music for the pavane; also : music having the slow duple rhythm of a pavane)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Oct. 1, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pavane (probably from Italian padovana, \"Paduan\"), majestic processional dance of the 16th- and 17th-century European aristocracy; The pavane's basic movement, to music in 2/2 or 4/4 time, consisted of forward and backward steps; the dancers rose onto the balls of their feet and swayed from side to side; The pavane was customarily followed by its afterdance, the vigorous galliard; The paired dances, pavane and galliard, were a forerunner of the instrumental dance suites of the 17th century, and pavanes appear in a few early suites--e.g., the padouanas in some suites of Johann Hermann Schein. Later composers occasionally used the pavane as an instrumental piece; e.g., Faur\u00e9 (Pavane for Orchestra) and Ravel (Pavane for a Dead Princess))"}, "madsrdf:citationSource": "Britannica online, Oct. 1, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Pavana (Pavana; It., Sp., Fr., pavane, pavenne; Eng. pavan, paven, pavin. A 16th-century court dance of Italian provenance. It was restored and revitalized in idealized musical form and attained its highest point of artistic perfection under the aegis of the English virginalists...)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncdde15e84d774493b61f414714bd0fdab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pavens (Music)"}}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pavens (Music)"}}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncdde15e84d774493b61f414714bd0fdab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pavanes (Music)"}}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pavanes (Music)"}}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncdde15e84d774493b61f414714bd0fdab18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pavins (Music)"}}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pavins (Music)"}}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncdde15e84d774493b61f414714bd0fdab21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pavanas (Music)"}}, {"@id": "_:ncdde15e84d774493b61f414714bd0fdab21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pavanas (Music)"}}], "@id": "/authorities/genreForms/gf2014026994"}
