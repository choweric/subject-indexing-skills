nd"}, {"@id": "_:nbb126838de5e4a72a27ff5c801834d64b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)965799901"}, "madsrdf:citationSource": "Buz, Yusuf. Turkish grammar in practice : a self-study reference and practice book for learners of Turkish, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb126838de5e4a72a27ff5c801834d64b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(self-instruction: the act or process of teaching oneself : instruction of oneself; other words from self-instruction: self-instructional, adjective; e.g. self-instructional software)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, July 15, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb126838de5e4a72a27ff5c801834d64b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)40140799"}, "madsrdf:citationSource": "Harrison, Nigel. How to design self-directed and distance learning : a guide for creators of web-based training, computer-based training, and self-study materials, \u00a91999.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb126838de5e4a72a27ff5c801834d64b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)4503639"}, "madsrdf:citationSource": "Leela, S. V. Veena, self-taught : an introduction to Carnatic music, 1976.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb126838de5e4a72a27ff5c801834d64b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Self-instruction. USE subdivision Self-instruction under names of languages; and subdivision Methods--Self-instruction under individual musical instruments and families of instruments; and subdivision Programmed instruction under subjects, e.g. Trigonometry--Programmed instruction; form subdivison --Self-instruction. Use as a form subdivision under individual languages and groups of languages for self-instruction