{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026117", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCelestial globes", "identifiers:lccn": "gf2011026117", "madsrdf:adminMetadata": [{"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb1"}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Celestial globes"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026056"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026800"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026116"}, "madsrdf:hasSource": [{"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb5"}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb6"}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb7"}], "madsrdf:hasVariant": [{"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb8"}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb11"}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025012"}}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T09:44:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Celestial globes"}}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Celestial globes)"}, "madsrdf:citationSource": "LCSH, Jan. 8, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(celestial sphere: an imaginary sphere of infinite radius, described about an assumed center, and upon which imagined positions of celestial bodies are projected along radii passing through the bodies; for observations on bodies within the limits of the solar system, the assumed center is the center of the earth; for bodies where the parallax is negligible, the assumed center may be the point of observation)"}, "madsrdf:citationSource": "Glossary of mapping, charting,and geodetic terms, 1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "globes, celestial (a sphere on which the locations and brightness of stars and other celestial bodies are shown by symbols.  The outlines or boundaries of constellations usually are shown also)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Star globes"}}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Star globes"}}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Globes, Star"}}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Globes, Star"}}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Globes, Celestial"}}, {"@id": "_:nc82cc2218f8c4c239c9c1fe5e567d60fb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Globes, Celestial"}}], "@id": "/authorities/genreForms/gf2011026117"}
