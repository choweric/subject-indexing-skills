": "_:n8ce3328b2c564210b26d003207bbcaccb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Bach, J.S. Cantata 10 : My soul doth exalt the Lord God : for the Feast of the Visitation, 1948.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027163"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027164", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVocalises", "identifiers:lccn": "gf2014027164", "madsrdf:adminMetadata": [{"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb1"}, {"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Vocalises"}, "madsrdf:elementList": {"@list": [{"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb3"}]}, "madsrdf:exampleNote": "Note under [Songs without words (Instrumental music)]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": {"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb5"}, "madsrdf:hasVariant": {"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Compositions for solo voice(s) without text. For instrumental compositions in song style see [Songs without words (Instrumental music).]"}, {"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:10:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vocalises"}}, {"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a composition for voice without text)"}, "madsrdf:citationSource": "New Harvard dict. of mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Songs without words (Vocal music)"}}, {"@id": "_:nebd1ae2da5294fd48ff14b94d3014a0cb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Songs without words (Vocal music)"}}], "@id": "/authorities/genreForms/gf2014027164"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027165", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aV\u1ecdng c\u1ed1", "identifiers:lccn": "gf2014027165", "madsrdf:adminMetadata": [{"@id": "_:n5afb40c08ae44360a4a66980084bbc70b1"}, {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "V\u1ecdng c\u1ed1"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5afb40c08ae44360a4a66980084bbc70b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n5afb40c08ae44360a4a66980084bbc70b5"}, {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b6"}, {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b7"}], "madsrdf:hasVariant": {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "V\u1ecdng c\u1ed1"}}, {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Vietnam (Dan tai tu (\"amateurs' music\"). This music, found in the south, belongs to the same tradition as Hu\u00ea music, though repertory and instrumental technique are slightly different; most popular piece in southern tradition is Vong c\u00f4 (\"Nostalgia for the past\"), composed in 1917 by M. Sau L\u00e2u, native of Bac Li\u00eau in south Vietnam; since then, this piece of 20 phrases of 2 bars has become a piece of 6 phrases of 32 bars; its melodic line, with fixed notes on certain beats, can be infinitely varied according to musicians and instruments)"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 95, under Vietnam (vong c\u00f4, a style of song which conveys \"nostalgia for the past\")"}, "madsrdf:citationSource": "White, D. Dict. of pop. music styles of the world, c1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 97-218992: J\u00e4hnichen, G. Studien zu traditionellen vietnamesischen Instrumentalpraktiken des h\u00e1t \u1ea3 \u0111\u00e0o und des ca v\u1ecdng c\u1ecf\u0302, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5afb40c08ae44360a4a66980084bbc70b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ca v\u1ecdng c\u1ecf\u0302"}}, {"@id": "_:n5afb40c08ae44360a4a66980084bbc70b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ca v\u1ecdng c\u1ecf\u0302"}}], "@id": "/authorities/genreForms/gf2014027165"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027166", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWaila music", "identifiers:lccn": "gf2014027166", "madsrdf:adminMetadata": [{"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b1"}, {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Waila music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b5"}, {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b6"}, {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b7"}], "madsrdf:hasVariant": {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Waila music"}}, {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Chicken scratch (also known as waila music) is a kind of dance music developed by the Tohono O'odham people. The genre evolved out of acoustic fiddle bands in southern Arizona, in the Sonoran desert. These bands began playing European and Mexican tunes, in styles that include the polka, schottisch and mazurka)"}, "madsrdf:citationSource": "Wikipedia, Mar. 23, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Means, A. Chicken scratch : the Waila music of the O'odham peoples of Arizona, 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "jkt. (Cisco Band and the Joaquin Brothers are two legendary bands in the history of Waila, popularly known as \"chicken scratch\")"}, "madsrdf:citationSource": "The Cisco Band and the Joaquin Brothers : popular dance of the natives of southern Arizona, c2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chicken scratch music"}}, {"@id": "_:nd3d4b13a36a3450e97eb2da5f779bf75b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chicken scratch music"}}], "@id": "/authorities/genreForms/gf2014027166"}
