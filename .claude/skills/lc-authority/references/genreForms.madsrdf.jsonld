, "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: 00563635: Basket ball, Missouri Valley College.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc97fd252a3334259a39bfd1f3bae4261b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "America at Work, School, and Leisure, 1894-1915, About this collection (Work, school, and leisure activities in the United States from 1894 to 1915; includes films of the United States Postal Service from 1903, cattle breeding, fire fighters, ice manufacturing, logging, calisthenic and gymnastic exercises in schools, amusement parks, boxing, expositions, football, parades, swimming, and other sporting events)"}, "madsrdf:citationSource": "Library of Congress WWW site, viewed December 21, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc97fd252a3334259a39bfd1f3bae4261b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc97fd252a3334259a39bfd1f3bae4261b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Basketball games, Filmed"}}, {"@id": "_:nc97fd252a3334259a39bfd1f3bae4261b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Basketball games, Filmed"}}], "@id": "/authorities/genreForms/gf2015026113"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026114", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPicaresque films", "identifiers:lccn": "gf2015026114", "madsrdf:adminMetadata": [{"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b1"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Picaresque films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b5"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b6"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b7"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b8"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b9"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films featuring the adventures of a resourceful hero."}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-04T16:49:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picaresque films"}}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Picaresque: An episodic string of adventures by a hero who moves from place to place. Stellar example, Tom Jones, and more recently, Forrest Gump.)"}, "madsrdf:citationSource": "Movie genres examples from the Create Your Screenplay Seminar, via WWW, Dec. 21, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Underground Film: Picaresque Films. The picaresque film narrates the adventures, misadventures or vicissitudes of a picaresque hero, sometimes naive, intent on surviving in a frequently hostile environment. The Flower Thief (1959-60); Senseless (1962); The Queen of Sheba Meets the Atom Man (1963 and 68 version); The Great Blondino (1967))"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Tom Jones (Motion picture). Tom Jones, 1992.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Picaresque. Picaresque is a genre of usually satiric prose fiction originating in Spain and depicting in realistic, often humorous detail the adventures of a roguish hero of low social degree living by his or her wits in a corrupt society. A traditional picaresque is often a Shaggy Dog Story and/or has a Random Events Plot. Elements of the picaresque frequently show up in Cyberpunk stories. Film: All of the Dollars Trilogy, especially The Good, the Bad and the Ugly.)"}, "madsrdf:citationSource": "TV tropes website, Dec. 22, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"As The Lone Ranger shifts from the point of view of its hero, John Reid (Armie Hammer), to the first-person narrative of his Indian sidekick Tonto (Johnny Depp), the tired pulp story becomes a postmodern picaresque. A type of story with a long literary tradition but seldom seen on film, a picaresque is usually episodic in nature, a fact that contributes to what many perceive is the messiness of The Lone Ranger. Tonto exemplifies the typical picaresque hero (or picaro), noble in intentions but misguided and perhaps even unreliable in his perception of the events in which he is usually at the center.\")"}, "madsrdf:citationSource": "Dayoub, T. Rehabbing Tonto : The Lone Ranger as picaresque tale, 2013, via Press play blog, viewed on Dec. 21, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n9708f70b475f4daf963e7f43b5ea7ca7b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tom Jones; Film by Richardson (1963); picaresque adventure)"}, "madsrdf:citationSource": "Britannica online, Dec. 21, 2015", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026114"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026115", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCircus films", "identifiers:lccn": "gf2015026115", "madsrdf:adminMetadata": [{"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b1"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Circus films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b5"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b6"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b7"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b8"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b9"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b10"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b11"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b12"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b13"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b14"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b15"}], "madsrdf:hasVariant": [{"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b16"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b19"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-04T16:49:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Circus films"}}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(circus films; At the Circus (1939); Killer Klowns From Outer Space (1988); Freaks (1932); Big Top Pee-wee (1988); Something Wicked This Way Comes (1983); The Greatest Show On Earth (1952); The Elephant Man (1980); The Circus (1928); Dumbo (1941))"}, "madsrdf:citationSource": "The 9 greatest circus movies on Earth, via Screen junkies website, Dec. 30, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Circus Film (Big-Top Movie). The small, enclosed world of the circus offers ample opportunity for conflict amongst its people with their jealousies, rivalries, and flare-ups of passion. Filmmakers saw in the Big Top ready-made scenarios and brought the circus to the screen. Charlie Chaplin's The Circus (1925-27) is an early masterpiece. Circus movies are mostly of a dramatic nature with occasional inroads into the bizarre (e.g., Freaks, 1932) and the field of horror. Examples: He Who Gets Slapped (1924); Street Angel (1928); The Mighty Barnum (1934); The Greatest Show on Earth (1951); Man on a Tightrope (1953); La Strada (1954); The Big Circus (1959); subgenre under Circus Film: Funfair Movies (Fairground Movies): Closely connected with the circus world is the world of carnivals and itinerant sideshows. Funfairs and fairgrounds have figured in many films; in some, they provide the setting for the film's story. They make a good background for horror films.)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Strada (Motion picture). La strada, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Greatest show on Earth (Motion picture : 1952). The greatest show on Earth, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"The circus grotesquerie suggests Fellini, though Tod Browning's big-top movies 'Freaks' and 'The Unknown' are perhaps even more relevant.\")"}, "madsrdf:citationSource": "Lim, D. A second look: Alejandro Jodorowsky's 'Santa sangre', in Los Angeles times, Jan. 23, 2011, viewed online Dec. 30, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Freaks (Motion picture). Freaks, \u00a92004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category: Circus films. Films in this category are set in (or significantly feature) a circus, traveling carnival, travelling funfair or freak show.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 30, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 558 (\"the circus films of Federico Fellini use the brightly lit ring and its outer darkness to manifest psychological interiors, in the same way that the haunted house came to be used in many horror films\")"}, "madsrdf:citationSource": "Organization studies, Apr. 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"The circus is an obsessively recurring image in Browning's work, an oeuvre composed almost entirely, it seems, of obsessively recurring images. ... Disability and disfigurement, evil, revenge, perverse desire, and lust for money are Browning's themes, and they unspool in the claustrophobic half-world of the Hollywood soundstage, which doubles for Gothic castles, misty cemeteries, dingy garrets, sinister pet shops--and the big top, always the big top. While Fellini's vaguely threatening carnivals stem from a child's impression of the glamour and terror of the fairground (evoked most clearly in 1970's I Clowns), Browning offers a backstage view, reeking of horseshit and petty rivalries, rife with larceny and lust. ... The Unknown (1927) is Browning's first fully circus-based drama ... Next to these extravaganzas of careless plotting and wild sensation, the infamous Freaks (1932) might almost be expected to disappoint, since its plot--a sexy trapeze artist marries a midget for his money and poisons him--seems virtually routine, plausible, decent, by comparison with previous Browning outrages. But no. Browning's relentless parade of human oddities--in which mere bearded ladies and hermaphrodites count for very little next to the living skeleton, the man with half a body, the pinheads, and the human torso--ensures the film stays freaky to its dying seconds. And Browning's mercurial attitude toward his subject--horrifying us, inviting us to laugh, winning our sympathy, then horrifying us again while retaining our sympathy--creates a dynamic spectrum of emotion that prevents the film from ever seeming merely like a cabinet of curiosities\")"}, "madsrdf:citationSource": "Cairns, D. At the circus : the big-top movies of Tod Browning, via Museum of the Moving Image Moving image source blog, Dec. 16, 2009, viewed on Dec. 30, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(blog entries for: \"The 34 circus movies that I know\"; \"Best circus films\")"}, "madsrdf:citationSource": "IMDb, Dec. 30, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 294 (\"Circus films are set in the world of professional circus artists, and the circus is the setting for usually dramatic stories of love, passion and destiny. Chaplin's film The Circus was the most successful circus film between 1925 and 1932; the reason for this must be that it was appealing to both the audience of circus films and the Chaplin audience.\")"}, "madsrdf:citationSource": "Early popular visual culture, Aug. 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fairground films"}}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fairground films"}}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Big-top films"}}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Big-top films"}}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Funfair films"}}, {"@id": "_:n3b8e26bc2bfc40e78e74a9ead5573a85b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Funfair films"}}], "@id": "/authorities/genreForms/gf2015026115"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026001", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPhilosophical fiction", "identifiers:lccn": "gf2016026001", "madsrdf:adminMetadata": [{"@id": "_:na51fcfdc367647288552ee4f0b967dbdb1"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Philosophical fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:na51fcfdc367647288552ee4f0b967dbdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:na51fcfdc367647288552ee4f0b967dbdb5"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb6"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb7"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb8"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb9"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb10"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb11"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb12"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb13"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb14"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb15"}], "madsrdf:hasVariant": {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb16"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that emphasizes philosophical propositions."}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:12:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-01-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Philosophical fiction"}}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 791 (Thomas Mann's first novel, Buddenbrooks, is a work with naturalistic elements but is also a philosophical novel in the sense that it bears the imprint of Arthur Schopenhauer's thought in Die Welt als Wille und Vorstellung; the essential Schopenhauerian plot is that the will comes to know itself and, astonished at its own activities, begins to inquire into its own character; existentialist themes in the work of Wolfgang Borchert)"}, "madsrdf:citationSource": "Encyclopedia of German literature, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mikkonen, J. The cognitive value of philosophical fiction, \u00a92013.", "madsrdf:citationStatus": "found"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998;Kennedy, X.J. The Longman dictionary of literary terms, c2006;Baldick, C. The Oxford dictionary of literary terms, 2008;Harmon, W. A handbook to literature, c2009;Harris, W.V. Dictionary of concepts in literary criticism and theory, 1992", "madsrdf:citationStatus": "notfound"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A fiction novel that has philosophical ponderings and concepts woven throughout the plotline, characters, and thematic backdrop; lists works by Albert Camus, Robert Musil, Johann Wolfgang von Goethe, Fyodor Dostoyevsky, Rainer Maria Rilke, Hermann Hesse, Voltaire, Friedrich Nietzsche, George Orwell, Ayn Rand, Jean-Paul Sartre, Aldous Huxley, Franz Kafka, Milan Kundera, Robert M. Pirsig and others)"}, "madsrdf:citationSource": "Best philosophical fiction, via Goodreads website, Jan. 4, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Camus, Albert. \u00c9tranger. English. The stranger, 1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Although he denied his affiliation with the movement, critics are generally inclined to say that Albert Camus was an existentialist. Born 100 years ago today, the author is responsible for Nobel Prize-winning classics like The Stranger and The Fall that sit at the top of the \"philosophical fiction\" pile. Philosophical fiction isn't always the easiest to define unless the author clearly states that there was a philosophical framework guiding the text, thus embedding that philosophy within the plot.)"}, "madsrdf:citationSource": "Diamond, J. 10 great works of fiction for philosophers, via Flavorwire website, Nov. 7, 2013, viewed online Jan. 4, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "List of genres (Philosophical fiction is fiction in which a significant proportion of the work is devoted to a discussion of the sort of questions normally addressed in discursive philosophy. These might include the function and role of society, the purpose of life, ethics or morals, the role of art in human lives, and the role of experience or reason in the development of knowledge. Philosophical fiction works would include the so-called novel of ideas, including a significant proportion of science fiction, utopian and dystopian fiction, and Bildungsroman. The modus operandi seems to be to use a normal story to simply explain difficult and dark parts of human life.)"}, "madsrdf:citationSource": "Wikipedia, Jan. 1, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novelists with philosophical backgrounds; philosophically trained novelists, including David Foster Wallace, William H. Gass and Clancy Martin; philosophers like Jean-Paul Sartre and George Santayana have written novels, while novelists like Thomas Mann and Robert Musil have created fiction dense with philosophical allusion; David Foster Wallace ... his most overtly philosophical novel--his first, The Broom of the System (1987), which incorporates the ideas of Ludwig Wittgenstein; David Markson, whose bleak, abstract, solitary novel Wittgenstein's Mistress (1988) ... praised for evoking the bleak, abstract, solitary feel of Wittgenstein's early philosophy; Rebecca Newberger Goldstein, whose latest novel is 36 Arguments for the Existence of God, treats philosophical questions with unabashed directness in her fiction, often featuring debates or dialogues among characters who are themselves philosophers or physicists or mathematicians; Clancy Martin's first novel, How to Sell (2009) ... disguised versions of Kant's argument on the supposed right to lie in order to save a life, Aristotle's typology of four kinds of liars, and Nietzsche's theory of deception)"}, "madsrdf:citationSource": "Ryerson, J. The philosophical novel, in New York times, Jan. 20, 2011, viewed online Jan. 4, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(works of fiction with philosophy as their basis/inspiration or where philosophy plays a significant role in the work)"}, "madsrdf:citationSource": "What do you think is the best philosophical fiction?, via Reddit website, viewed Jan. 4, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wenke, J.P. Melville's muse : literary creation & the forms of philosophical fiction, \u00a91995.", "madsrdf:citationStatus": "found"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "index (philosophical novel, see conte philosophique; novel of ideas) conte philosophique (The conte philosophique (philosophical tale) is a short, usually satiric narrative whose characters and story illustrate a philosophical proposition. A synthesis of fiction and philosophy, the conte philosophique avoids the abstraction of logical argument by relying on allegorical characters and a fast-moving narrative freed from any concern with realism and psychology; reached its highest development with the short prose fiction of Voltaire; the more than 25 contes philosophiques Voltaire wrote between 1747 and 1774; in England, the closest equivalents to the genre are Jonathan Swift's Gulliver's Travels and Samuel Johnson's Rasselas, Prince of Abyssinia; if we emphasize the genre's narrativizing of philosophical premises, it may be seen as leading to a long and varied tradition that includes Guy de Maupassant's tales, the prose parables of Arthur Schopenhauer and Franz Kafka, such narrative illustrations of existential philosophy as Jean-Paul Sartre's La Naus\u00e9e and Albert Camus' L'\u00c9tranger, Jorge Luis Borges' and Leonardo Sciascia's narrative meditations on the paradoxes of representation, and even Salmon Rushdie's distinctly Voltairean parodies of religious intolerance)"}, "madsrdf:citationSource": "Encyclopedia of the novel, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na51fcfdc367647288552ee4f0b967dbdb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Contes philosophiques"}}, {"@id": "_:na51fcfdc367647288552ee4f0b967dbdb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Contes philosophiques"}}], "@id": "/authorities/genreForms/gf2016026001"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026002", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNonsense fiction", "identifiers:lccn": "gf2016026002", "madsrdf:adminMetadata": [{"@id": "_:nef75eaac3e4343719b3d45ca22a114ceb1"}, {"@id": "_:nef75eaac3e4343719b3d45ca22a114ceb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nonsense fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nef75eaac3e4343719b3d45ca22a114ceb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:nef75eaac3e4343719b3d45ca22a114ceb5"}, {"@id": "_:nef75eaac3e4343719b3d45ca22a114ceb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that emphasizes playful wordplay and rhythm instead of meaning and emotional involvement."}, {"@id": "_:nef75eaac3e4343719b3d45ca22a114ceb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-04T16:49:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nef75eaac3e4343719b3d45ca22a114ceb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-01-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nef75eaac3e4343719b3d45ca22a114ceb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonsense fiction"}}, {"@id": "_:nef75eaac3e4343719b3d45ca22a114ceb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nonsense: nonsense writing comes in two forms: the kind of silly explorations of sound and sense often generated by young children, and the much more complex body of work that can be called literary nonsense, best known through Victorian writers such as Edward Lear and Lewis Carroll; the two kinds of nonsense share some characteristics: both are ludic and delight in wordplay and rhythm, but whereas nonsense by children is largely spontaneous, fugitive, and essentially meaningless, literary nonsense has a distinguished intellectual tradition)"}, "madsrdf:citationSource": "Oxford encyclopedia of children's literature (via Oxford reference online), Nov. 2, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nef75eaac3e4343719b3d45ca22a114ceb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ch. 2 (the most essential characteristic of the genre of nonsense is that it presents an unresolved tension, a balance between presence and absence of meaning; literary nonsense is characterized by four essential elements: an unresolved tension between presence and absence of meaning, lack of emotional involvement, playlike presentation, and an emphasis, stronger than in any other type of literature, upon its verbal nature) Ch. 3 (\"What nonsense is not\": nonsense differentiated from humor, nursery rhymes, light verse, surrealism, Dada, absurdism, metafiction) Ch. 4 (Examples of nonsense fiction: Lewis Carroll's Alice in Wonderland, and Through the Looking-Glass; Anthony Burgess's A Long Trip to Teatime; Flann O'Brien's The Third Policeman)"}, "madsrdf:citationSource": "Tigges, W. An anatomy of literary nonsense, 1988:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026002"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026003", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSerial poetry", "identifiers:lccn": "gf2016026003", "madsrdf:adminMetadata": [{"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb1"}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Serial poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb5"}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb6"}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb7"}], "madsrdf:hasVariant": [{"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb8"}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Collections of individual poems that together form an extended narrative."}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-04T16:49:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-01-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serial poetry"}}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The serial form in contemporary poetry represents a radical alternative to the epic model. The series describes the complicated and often desultory manner in which one thing follows another. Its modular form--in which individual elements are both discontinuous and capable of recombination--distinguishes it from the thematic development or narrative progression that characterize other types of the long poem. The series resists a systematic or determinate ordering of its materials, preferring constant change and even accident, a protean shape and an aleatory method. The series is an ongoing process of accumulation. In contrast to the epic demand for completion, the series remains essentially and deliberately incomplete.)"}, "madsrdf:citationSource": "Conte, J. Seriality and the contemporary long poem, via WWW, July 26, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(cycle: a group of poems, stories or plays which are united by a central theme. A series of lyrical poems may also form a cycle. For instance, Dante's Vita Nuova, Petrarch's Canzoniere, and Shakespeare's Sonnets)"}, "madsrdf:citationSource": "Cuddon, A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Serial poetry comprises a branch of literature in which a sequential or kaleidoscopic story is told in verse. Each installment reveals a new part of the story arc. When read together, the individual poems combine to show the big picture. This often creates an extended narrative -- poems unfolding events one at a time -- but it doesn't have to. A series might also explore a single event from the perspective of multiple characters, or how individual devices influence life in a cultural setting. What matters is that the poems 1) have individual identity, standing alone well enough to make sense before the whole set has been read, which distinguishes a series from a single epic poem; and 2) have collective integrity, fitting together like the pieces of a puzzle, which distinguishes a series from random poems by the same author or other unrelated collections. Another name for this is \"poetic cycle\")"}, "madsrdf:citationSource": "Poetree.org online, Nov. 21, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cycles, Poetic"}}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cycles, Poetic"}}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poetic cycles"}}, {"@id": "_:nc8c57d9f317e472cb1c142d2b04cc07fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poetic cycles"}}], "@id": "/authorities/genreForms/gf2016026003"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026004", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAubades", "identifiers:lccn": "gf2016026004", "madsrdf:adminMetadata": [{"@id": "_:n68b8c5912ad34124986c29ac7109c88eb1"}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Aubades"}, "madsrdf:elementList": {"@list": [{"@id": "_:n68b8c5912ad34124986c29ac7109c88eb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026419"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422"}], "madsrdf:hasSource": [{"@id": "_:n68b8c5912ad34124986c29ac7109c88eb5"}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb6"}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb7"}], "madsrdf:hasVariant": [{"@id": "_:n68b8c5912ad34124986c29ac7109c88eb8"}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems about the parting of lovers at dawn."}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-04T16:49:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-01-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aubades"}}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Aubade (The Proven\u00e7al and German equivalents are alba and Tagelied respectively. The dawn song is found in almost all of the world's early literatures and expresses the regret of lovers parting at daybreak. The earliest examples date from the end of the 12th c. There is a theory that the aubade grew out of the night watchman's announcement from his tower of the passing of night and the renewal of day. The exchange between Romeo and Juliet at the end of their wedding night is a good example)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1991.", "madsrdf:citationStatus": "found"}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Aubade: a poem set at sunrise, usually about the parting of lovers, like the scene in Act III, Scene V of Shakespeare's Romeo and Juliet...)"}, "madsrdf:citationSource": "Drury, J. The poetry dictionary, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Aube (or aubade): In French medieval poetry, a song of regret, usually in dialogue form, sung by lovers who must part at dawn. (In Proven\u00e7al verse, such a poem is called an \"alba.\") The most famous English example occurs in Shakespeare's Romeo and Juliet, when lovers must part after their wedding night)"}, "madsrdf:citationSource": "Beckson, K. Literary terms, 1989:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n68b8c5912ad34124986c29ac7109c88eb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Albas"}}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Albas"}}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n68b8c5912ad34124986c29ac7109c88eb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tagelieder"}}, {"@id": "_:n68b8c5912ad34124986c29ac7109c88eb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tagelieder"}}], "@id": "/authorities/genreForms/gf2016026004"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026005", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aComics adaptations", "identifiers:lccn": "gf2016026005", "madsrdf:adminMetadata": [{"@id": "_:n91fe6ed8e10548779474e7eb158bfa52b1"}, {"@id": "_:n91fe6ed8e10548779474e7eb158bfa52b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Comics adaptations"}, "madsrdf:elementList": {"@list": [{"@id": "_:n91fe6ed8e10548779474e7eb158bfa52b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026041"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026130"}, "madsrdf:hasSource": {"@id": "_:n91fe6ed8e10548779474e7eb158bfa52b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n91fe6ed8e10548779474e7eb158bfa52b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-04T16:49:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n91fe6ed8e10548779474e7eb158bfa52b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-01-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n91fe6ed8e10548779474e7eb158bfa52b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comics adaptations"}}, {"@id": "_:n91fe6ed8e10548779474e7eb158bfa52b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 44 (Adaptations and licensed works. Comics and graphic novels that adapt or expand works from other sources have been around since at least 1921, when a comic book version of Swiss Family Robinson was produced. ... Literary adaptations for younger readers are also among the graphic novels becoming popular, both highly abridged and close to the full work, including manga versions of Shakespeare. Other adaptations are usually found in the adult fiction section of the library, often works of science fiction, fantasy, or horror, possibly because many comic readers are interested in that genre. ... While television shows and movies have been based on comic books, the reverse is also true, dating back to the early years of the modern comic book. ... Westerns and sitcoms have been made into comic books. Although some are direct film-to-comic adaptations, most are new adventures. One of the best examples are the comics based on the Star Wars films.)"}, "madsrdf:citationSource": "Serchay, D.S. The librarian's guide to graphic novels for adults, c2010:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026005"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026006", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSea fiction", "identifiers:lccn": "gf2016026006", "madsrdf:adminMetadata": [{"@id": "_:n4643937557514cb4b1a44ab838e8c231b1"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sea fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4643937557514cb4b1a44ab838e8c231b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n4643937557514cb4b1a44ab838e8c231b5"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b6"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b7"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b8"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b9"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b10"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b11"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b12"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b13"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b14"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b15"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b16"}], "madsrdf:hasVariant": [{"@id": "_:n4643937557514cb4b1a44ab838e8c231b17"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b20"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that depicts a heroic main character on the open sea and whose plot progressively strips away the norms of land-based society."}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-01-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-06T10:07:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sea fiction"}}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. vii (sea stories; sea fiction) p. 4 (My attention began to switch from pure sea novels to all novels that seemed to engage in some significant way with the maritime history of the country. It was at this point that I began to think about an appropriate title. The most widely used terms are 'sea fiction' and 'nautical fiction', but both, by placing their emphasis on events at sea, seemed somewhat wide of the mark of what I had in mind. 'Maritime fiction' emerged as the best alternative; maritime novels)"}, "madsrdf:citationSource": "Peck, J. Maritime fiction : sailors and the sea in British and American novels, 1719-1917, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Stani\ufe20u\ufe21kovich, K.M. Running to the shrouds : nineteenth-century sea stories, 1986.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Taylor, T. Rogue wave : and other red-blooded sea stories, \u00a91996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Brown, G.M. Sea stories, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (naval fiction set in the Age of Sail) nautical genres (Privateer Fiction - Novels where the main featured vessel is a privateer; Pirate Fiction - Pirate and Buccaneer stories; Other Nautical Fiction - Merchant ships, smuggling, etc. set in the age of sail; ME [Modern Era] Naval Fiction - Naval Fiction books set during the periods of Steam, Oil and Nuclear Power; ME Other Nautical Fiction - Merchant ships and other nautical fiction in the modern era)"}, "madsrdf:citationSource": [{"@id": "https://www.historicnavalfiction.com/"}, "Hayes, D. Historic naval fiction, via WWW, Dec. 22, 2016:"], "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Nautical fiction (Nautical fiction, frequently also naval fiction, sea fiction, naval adventure fiction or maritime fiction, is a genre of literature with a setting on or near the sea, that focuses on the human relationship to the sea and sea voyages and highlights nautical culture in these environments. The settings of nautical fiction vary greatly, including merchant ships, liners, naval ships, fishing vessels, life boats, etc., along with sea ports and fishing villages. When describing nautical fiction, scholars most frequently refer to novels, novellas, and short stories, sometimes under the name of sea novels or sea stories.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 22, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sea stories. Use for novels and stories using the sea as a setting or dealing generally with the sea as an environment)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Allyn, S. Top deck twenty! : best West Coast sea stories!, \u00a91989.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bruss, P. Conrad's early sea fiction, \u00a91979.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Nautical Literature: nautical fiction; nautical novels; sea stories; the sea novel; the nautical story)"}, "madsrdf:citationSource": "American history through literature, 1820-1870, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Philbrick, T. James Fenimore Cooper and the development of American sea fiction, 1961.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sea fiction: distinct novelistic genre emerging in 1820s, inaugurated by James Fenimore Cooper with The Pilot; sea fiction remained vital throughout the nineteenth century in a transatlantic republic of letters; in sea fiction, novelistic techniques like suspense and the portrayal of emotionally deep characters help to involve the reader in an inquiry into the heroism of the mariner detailed across the history of open-ocean narrative; this inquiry occurs as the plot progressively strips away the norms of land-based society to reveal the violence at the basis of nature and society)"}, "madsrdf:citationSource": "Oxford encyclopedia of maritime history (via Oxford reference online), Nov. 6, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4643937557514cb4b1a44ab838e8c231b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Naval fiction"}}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Naval fiction"}}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4643937557514cb4b1a44ab838e8c231b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nautical fiction"}}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nautical fiction"}}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4643937557514cb4b1a44ab838e8c231b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Maritime fiction"}}, {"@id": "_:n4643937557514cb4b1a44ab838e8c231b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maritime fiction"}}], "@id": "/authorities/genreForms/gf2016026006"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026007", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTheatrical adaptations", "identifiers:lccn": "gf2016026007", "madsrdf:adminMetadata": [{"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b1"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Theatrical adaptations"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026041"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}], "madsrdf:hasSource": [{"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b5"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b6"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b7"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b8"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b9"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b10"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b11"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b12"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b13"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b14"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b15"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b16"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b17"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b18"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b19"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b20"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b21"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b22"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b23"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b24"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b25"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b26"}], "madsrdf:hasVariant": [{"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b27"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b30"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b33"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b36"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b39"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b42"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b45"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b48"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays adapted from works in another medium or from other plays."}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-01-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-12T14:20:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theatrical adaptations"}}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Adaptation: Theatrical Adaptations: Film historians have noted the close links between theatrical melodrama of the late nineteenth century and the techniques and narrative structure of early film--in content and elaborate lighting and stage effects. The obvious similarities between a play and a film--in overall length, use of sets, the apparent realism of character and dialogue--have obscured the very real differences. Stage dialogue can sound artificial and tedious when transferred directly to the more naturalistic medium of film, and, as with fiction, a successful adaptation has to be thoroughly rethought in terms of the new, primarily visual, medium of cinema. While the faults of mechanically adapted \"filmed theater\" are usually obvious, there is equal danger in attempts to \"open out\" a play by transferring interior scenes into exotic outdoor locations and hoping that will somehow make the work more cinematic. Some sort of balance between stage and film effects is therefore essential.)"}, "madsrdf:citationSource": [{"@id": "http://www.filmreference.com/encyclopedia/Academy-Awards-Crime-Films/Adaptation-THEATRICAL-ADAPTATIONS.html"}, "Film reference website, Jan. 9, 2016"], "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bland, J. Playing scenes from classic literature : short dramatizations of the world's most famous literature, \u00a91996.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "table of contents (Stage adaptations and the Dublin Theatre Festival; Brian Friel's theatrical adaptations of Chekhov works)"}, "madsrdf:citationSource": "Drama reinvented : theatre adaptation in Ireland, 1970-2007, \u00a92012:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "table of contents (Frankenstein / play adaptation by Tim Kelly -- Stand and deliver / play adaptation by Robert Bella -- Selkie / play adaptation by Laurie Brooks Gollobin -- Great expectations / play adaptation by Barbara Field -- Ordinary people / play adaptation by Nancy Gilsenan -- The veldt / play adaptation by Ray Bradbury -- Sir Gawain and the Green Knight / play adaptation by Dennis Scott -- The red badge of courage / play adaptation by Kathryn Schultz Miller -- Black Elk speaks / play adaptation by Christopher Sergel -- Twain by the tale / play adaptation by Dennis Snee -- Two Chekhov stories : The audition and A defenseless creature / play adaptation by Neil Simon -- Sweat / play adaptation by George C. Wolfe -- The scarlet letter / play adaptation by James F. De Maiolo -- The devil and Daniel Webster / play adaptation by Stephen Vincent Ben\u00e9t -- Animal farm / play adaptation by Nelson Bond -- The summer people / play adaptation by Brainerd Duffield -- The gift of the magi / play adaptation by Arthur L. Zapel)"}, "madsrdf:citationSource": "Page to stage : plays from classic literature, \u00a92002:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Saxon, B.S. \"Borrowing from the East\" : a study of types of Western theater adaptations of Chinese opera, Japanese noh, and kabuki, 1992.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dramatization: The process of adaptation whereby a stage play or film drama is created from major elements (plot, characters, settings) derived from a non-dramatic literary or historical work, usually a novel, romance, short story, or biography; or the new dramatic work thereby created.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (adaptations of novels into stage plays) p. 4 (a stage adaptation)"}, "madsrdf:citationSource": "Knight, L. Adaptation : re-creating the novel as a stage play, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dramatization: The act of making a play out of a story in another genre; from a chronicle, novel, short story and so forth. In medieval drama the Bible was dramatized into the Mystery Plays. In the Tudor period dramatists 'lifted' plots, stories, and ideas from historians like Plutarch and Holinshed, and novelists like Lodge and Nashe. But it was not until the 18th c. that dramatization really began to flourish. Then novels provided the material. ... it is a practice by no means extinct, as television and recent theatrical history amply demonstrate.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Appendix J.2.2 (dramatization of (work) A work that has been adapted as a drama; dramatized as (work) A dramatic work adapted from the source work)"}, "madsrdf:citationSource": "RDA: resource description & access, via WWW, Jan. 9, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (\"A dramatization of Lewis Carroll's 'Alice's Adventures in Wonderland' and 'Through the Looking-glass'\")"}, "madsrdf:citationSource": "Gerstenberg, A. Alice in Wonderland : a play, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dramatizations: 372,000 hits; dramatizations NOT (\"motion pictures\" OR films OR television OR radio): 187,000 hits); dramatisations: 105,000 hits; dramatisations NOT (\"motion pictures\" OR films OR television OR radio): 44,400 hits; stage adaptations: 75,000 hits; dramatizations AND stage: 250,000 hits; theater adaptations: 3,200 hits; theatre adaptations: 9,860 hits; theatrical adaptations: 25,000 hits)"}, "madsrdf:citationSource": "Google search, March 17, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Theatrical adaptation (In a theatrical adaptation, material from another artistic medium, such as a novel or a film is re-written according to the needs and requirements of the theatre and turned into a play or musical.)"}, "madsrdf:citationSource": "Wikipedia, Jan. 9, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b17", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ford, R. Dramatisations of Scott's novels : a catalogue, 1979.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dramatization 1 : the action of dramatizing. 2 : a dramatized version (as of a novel); dramatize 1 : to adapt (as a novel) for theatrical presentation)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Jan. 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b19", "@type": "madsrdf:Source", "madsrdf:citationSource": "Scott, M.B. The processes of dramatic adaptation : three playscripts with commentaries and annotations, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b20", "@type": "madsrdf:Source", "madsrdf:citationSource": "Berkoff, S. The trial ; and, Metamorphosis : two theatre adaptations from Franz Kafka, 1981.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b21", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Stage adaptations)"}, "madsrdf:citationSource": "LCSH, Jan. 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b22", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "table of contents (theatrical adaptation) introd. (adaptation for the stage) ch. 3 (stage versions of movies) publisher's blurb (approaches to stage adaptation)"}, "madsrdf:citationSource": "Theatre and adaptation, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b23", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 8 (a series of new drama adaptations of the ballad, Southeast Flies the Peacock (Kongque dongnan fei, hereafter, Peacock) that were circulated either as script, or stage performances, or both in the 1920s) p. 12 (dramatic adaptations of Peacock in the 1920s) p. 24 (dramatic adaptations of Southeast Flies the Peacock) p. 107 (In 1927, Ouyang Yuqian staged his most successful theatrical adaptation, Pan Jinlian) p. 126 (modern dramatic adaptations of Peacock) p. 127 (four more new drama adaptations, as this thesis has traced, were later produced either in print or on stage, and together constitute the \"Peacock fad\" of the 1920s)"}, "madsrdf:citationSource": "He, M. The Peacock on stage and in print : a study of the 1920s new drama adaptations of Southeast flies the peacock, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b24", "@type": "madsrdf:Source", "madsrdf:citationSource": "Campbell, T.J. Agape day : the journey of a stage adaptation, 2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b25", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(371,000 results for \"dramatizations\"; 98,200 results for \"dramatisations\"; 67,700 results for \"stage adaptations\"; 13,500 results for \"play adaptations\"; 25,200 results for \"theatrical adaptations\"; 15,800 results for \"dramatic adaptations\"; 12,600 results for \"drama adaptations\"; 3,170 results for \"theater adaptations\"; 9,260 results for \"theatre adaptations\")"}, "madsrdf:citationSource": "Google search, Jan. 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b26", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dramatization 1. A play or movie adapted from a novel or depicting a particular incident. 1.1. The process of adapting a novel or presenting a particular incident in a play or movie)"}, "madsrdf:citationSource": "Oxford dictionaries online, Jan. 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramatizations"}}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramatizations"}}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramatic adaptations"}}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramatic adaptations"}}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Theatre adaptations"}}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theatre adaptations"}}, {"@id": "_:ne929414f0ff44bf4acb4e577bcd6bc77b36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "