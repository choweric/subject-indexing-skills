OfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-22T15:58:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graded lists"}}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "ERIC thesaurus, via WWW, Sept. 21, 2022;Art & architecture thesaurus online, Sept. 21, 2022;Online dictionary of library and information science, Sept. 21, 2022", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1289324993"}, "madsrdf:citationSource": "Magrath, Jane. Piano literature for teaching and performance : a graded and annotated bibliography, 2021.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)59591962"}, "madsrdf:citationSource": "Hinson, Mike. The NASEN A-Z : a graded list of reading books, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1341465"}, "madsrdf:citationSource": "Withrow, Dorothy. Gateways to readable books : an annotated graded list of books in many fields for adolescents who are reluctant to read or find reading difficult, 1975.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1004830962"}, "madsrdf:citationSource": "Corn, Michael Alan. A select graded bibliography of the student literature for classical guitar, 1984.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(form subdivision --Bibliography--Graded lists. UF --Graded lists. SN Use as a form subdivision under forms and types of musical compositions.)"}, "madsrdf:citationSource": "LCSH, Sept. 21, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)609413531"}, "madsrdf:citationSource": "Selected flute repertoire and studies : a graded guide, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xi (Grading. An effort has been made to grade representative works of each composer. Four broad categories are used: Easy, Intermediate (Int.), Moderately Difficult (M-D), and Difficult (D)) p. 1 (Individual composers: their solo piano works in various editions and facsimile reproductions) p. 1043 (Anthologies and collections)"}, "madsrdf:citationSource": "Work cat.: Hinson, Maurice. Guide to the pianist's repertoire, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1102765145"}, "madsrdf:citationSource": "Gleam, Elfreda Sewell. A selected, graded list of compositions for unaccompanied violin, with preparatory studies, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)76910390"}, "madsrdf:citationSource": "Bailie, Eleanor. Haydn : a graded practical guide, 2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)65746343"}, "madsrdf:citationSource": "Stubley, Eleanor Victoria. A graded list of unpublished Canadian brass chamber music suitable for student performers, 1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5a87eba09f1f49a48e53014106cd0933b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graded bibliographies"}}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graded bibliographies"}}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5a87eba09f1f49a48e53014106cd0933b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Guides, Graded"}}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Guides, Graded"}}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5a87eba09f1f49a48e53014106cd0933b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graded guides"}}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graded guides"}}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5a87eba09f1f49a48e53014106cd0933b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lists, Graded"}}, {"@id": "_:n5a87eba09f1f49a48e53014106cd0933b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lists, Graded"}}], "@id": "/authorities/genreForms/gf2022026077"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026079", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPrimary sources", "identifiers:lccn": "gf2022026079", "madsrdf:adminMetadata": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b1"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Primary sources"}, "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b5"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b6"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b7"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b8"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b9"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b10"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b11"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b12"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b13"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b14"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b15"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b16"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b17"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b18"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b19"}], "madsrdf:hasVariant": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b20"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b23"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b26"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b29"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b32"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b35"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b38"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b41"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b44"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b47"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b50"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b53"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b56"}], "madsrdf:historyNote": "[Established February 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Use this term for both collections of primary sources and individual documents. For individual documents, pair this heading with the type of primary source."}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-22T15:58:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Primary sources"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(form subdivision --Sources. UF --Primary sources. SN Use as a form subdivision under historical topics, and headings for systems of law for collections of source materials of all types on those topics or systems. Also use under names of individual persons for collections of materials that served as sources of their ideas or inspiration; form subdivision --Biography--Sources. SN Use this subdivision combination as a form subdivision under names of countries, cities, etc., classes of persons, and ethnic groups for collections of biographical source materials pertaining to persons from those places or belonging to those groups; form subdivision --History--Sources. SN Use this subdivision combination as a form subdivision under names of countries, cities, etc., and individual corporate bodies, and under classes of persons, ethnic groups, and topical headings not inherently historical for collections of materials of all types, such as legal documents, letters, diaries, family papers, visual and moving image materials, assembled at a later time to serve as source materials for use by students, scholars, etc., in their research on the subject)"}, "madsrdf:citationSource": "LCSH, Sept. 23, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 9 (selection of North African captivity narratives; texts in this selection are contemporary eyewitness accounts of major historical developments in the early modern period)"}, "madsrdf:citationSource": "Barbary captives : an anthology of early modern slave memoirs by Europeans in North Africa, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 1-2 (Although casual readers may seldom encounter them, primary sources--the texts written by people at the time of the events themselves--are the principal foundations upon which our understanding of history is built; our selection of sources ... include scripture and works on theology, scientific texts, works of literature--stories, songs, and poems--chronicles and histories written at the time, letters and dispatches, biographies and memoirs, business contracts, receipts, account books, trial records, and so on)"}, "madsrdf:citationSource": "Texts from the middle : documents from the Mediterranean world, 650-1650, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Secret documents of Intelligence Branch on father of the nation, Bangladesh : Bangabandhu Sheikh Mujibur Rahman, 1948-1971 : declassified documents. Volume X, (January-April 1966), 2022.", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(source book or sourcebook: 1. an original writing, as a document, record, or diary, that supplies an authoritative basis for future writing, study, evaluation, etc. 2. a volume containing a small collection of such writings, usually on a specific subject, used in research)"}, "madsrdf:citationSource": "Dictionary.com, Sept. 23, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Primary Sources are immediate, first-hand accounts of a topic, from people who had a direct connection with it. Primary sources can include: Texts of laws and other original documents; Newspaper reports, by reporters who witnessed an event or who quote people who did; Speeches, diaries, letters and interviews - what the people involved said or wrote; Original research; Datasets, survey data, such as census or economic statistics; Photographs, video, or audio that capture an event. Secondary Sources are one step removed from primary sources, though they often quote or otherwise use primary sources. They can cover the same topic, but add a layer of interpretation and analysis. Secondary sources can include: Most books about a topic; Analysis or interpretation of data; Scholarly or other articles about a topic, especially by people not directly involved; Documentaries (though they often include photos or video portions that can be considered primary sources))"}, "madsrdf:citationSource": "Primary sources: a research guide, via Healey Library, University of Massachusetts Boston website, Sept. 23, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Primary biographical sources are sources written by the person you are researching. These first-hand sources can include autobiographies, diaries, letters, speeches, and poems. Primary sources can also include audio recordings, film recordings, or transcripts of interviews in which the person you are researching is the interviewee. Secondary biographical sources are sources written by someone other than the person you are researching. Secondary sources provide second-hand accounts that analyze, interpret, or comment on a person's life)"}, "madsrdf:citationSource": "Biographical information, via Murphy Library, University of Wisconsin La Crosse Library Guides website, Sept. 23, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "primary source (In scholarship, a document or record containing firsthand information or original data on a topic, used in preparing a derivative work. Primary sources include original manuscripts, periodical articles reporting original research or thought, diaries, memoirs, letters, journals, photographs, drawings, posters, film footage, sheet music, songs, interviews, government documents, public records, eyewitness accounts, newspaper clippings, etc. Compare with secondary source and tertiary source.) secondary source (Any published or unpublished work that is one step removed from the original source, usually describing, summarizing, analyzing, evaluating, derived from, or based on primary source materials, for example, a review, critical analysis, second-person account, or biographical or historical study. Also refers to material other than primary sources used in the preparation of a written work) tertiary source (A written work, such as a chapter in a textbook or entry in a reference book, based entirely on secondary sources, rather than on original research involving primary documents. Whether a source is secondary or tertiary can be determined by examining the bibliography (if one is provided). Another clue is that secondary sources are almost always written by experts, but tertiary sources may be written by staff writers who have an interest in the topic but are not scholars on the subject)"}, "madsrdf:citationSource": "Reitz, J.M. Online dictionary for library and information science, Sept. 23, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A primary source is an original object or document -- the raw material or first-hand information, source material that is closest to what is being studied. Primary sources vary by discipline and can include historical and legal documents, eye witness accounts, results of an experiment, statistical data, pieces of creative writing, and art objects. In the natural and social sciences, the results of an experiment or study are typically found in scholarly articles or papers delivered at conferences, so those articles and papers that present the original results are considered primary sources. A secondary source is something written about a primary source. Secondary sources include comments on, interpretations of, or discussions about the original material. Secondary source materials can be articles in newspapers or popular magazines, book or movie reviews, or articles found in scholarly journals that evaluate or criticize someone else's original research. A tertiary source is a distillation and collection of primary and secondary sources)"}, "madsrdf:citationSource": "Primary sources: definition & examples, via Austin Peay State University LibGuides website, Sept. 23, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(in titles: primary sources; primary source material; primary source materials; primary historical sources; primary historical source materials; primary historical documents; primary historical and genealogical data; primary source reader)"}, "madsrdf:citationSource": "OCLC, Sept. 23, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sourcebook: a fundamental document or record (as of history, literature, art, or religion) on which subsequent writings, compositions, opinions, beliefs, or practices are based also : a collection of such documents)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Sept. 23, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p.xiii (Beginning with sword inscriptions (the oldest known writings related to Japanese warriors), this book is arranged more or less chronologically, proceeding on to works of court literature, diaries, letters, documents, and law codes as well as portraits and picture scrolls; texts such as the late sixteenth-century documents formalizing the creation of the samurai order as well as ordinances from the 1870s abolishing that very same order) p. xxix (the sources translated in this text)"}, "madsrdf:citationSource": "Samurai and the warrior culture of Japan, 471-1877 : a sourcebook, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Primary sources are original sources created at the time a historical event occurs (or possibly afterwards) and are directly associated with their creater (or user). Essentially, a primary source is the subjective interpretation of a witness to an event. Primary sources serve as the raw materials historians use to interpret / analyze the past. Some examples include: Diaries; Memoirs; Letters; Advertisements; Speeches; Newspapers; Interviews; Government Documents; Photographs; Works of Art; Wills; Audio / Video Recordings; Maps; Manuscripts; Research Data; Ancient Artifacts)"}, "madsrdf:citationSource": "Primary sources for history, via UCI Libraries website, Sept. 23, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. vii (primary historical sources) p. 3 (Primary sources are manuscripts, first-person diaries, oral histories, letters, interviews, photographs, maps, films, sound recordings, music, song sheets--fragments of history, incomplete in themselves, but when assembled, analyzed, and researched, they can provide personal insights, human drama, and deep historical understandings)"}, "madsrdf:citationSource": "Veccia, Susan H. Uncovering our history : teaching with primary sources, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. i (Collects an extensive range of evidence for how people in the European Middle Ages thought about the emotional state of love, the physical act of sex, and the social institution of marriage. Included are extracts from literary and theological works, medical and legal writings, conduct books, chronicles, and letters)"}, "madsrdf:citationSource": "Work cat.: Love, sex & marriage in the Middle Ages : a sourcebook, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Primary source materials"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Primary source materials"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Historical sources, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical sources, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Source materials, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Source materials, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Source books"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Source books"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sourcebooks"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sourcebooks"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biographical sources, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biographical sources, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b38", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b39"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Primary historical sources"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b39", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Primary historical sources"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b41", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b42"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biographical source materials, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b42", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biographical source materials, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b44", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b45"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Historical source materials, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b45", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical source materials, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b47", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b48"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sources, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b48", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sources, Primary"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b50", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b51"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Primary biographical sources"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b51", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Primary biographical sources"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b53", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b54"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Primary historical source materials"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b54", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Primary historical source materials"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b56", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b57"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Primary biographical source materials"}}, {"@id": "_:n416b279a367d40b19af5e3f8eea8d4b5b57", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Primary biographical source materials"}}], "@id": "/authorities/genreForms/gf2022026079"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026080", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPanorama books", "identifiers:lccn": "gf2022026080", "madsrdf:adminMetadata": [{"@id": "_:n23a4cf5334774456841881e68420eba9b1"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Panorama books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n23a4cf5334774456841881e68420eba9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026082"}, "madsrdf:hasSource": [{"@id": "_:n23a4cf5334774456841881e68420eba9b5"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b6"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b7"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b8"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b9"}], "madsrdf:hasVariant": {"@id": "_:n23a4cf5334774456841881e68420eba9b10"}, "madsrdf:historyNote": "[Established February 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Accordion books featuring cut-out panels which pivot from the accordion structure to face the reader when the book is opened and displayed upright."}, {"@id": "_:n23a4cf5334774456841881e68420eba9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-22T15:58:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Panorama books"}}, {"@id": "_:n23a4cf5334774456841881e68420eba9b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Language of binding, via WWW, Sept. 27, 2022;Art & architecture thesaurus online, Sept. 29, 2022", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "2014 Christmas Card--Panel Book based on Hedi Kyle design (The panels are a result of the cuts INTO the accordion--so the panels swing open and closed as you open and close the [structure])"}, "madsrdf:citationSource": "Abbadabble blog, Sept. 27, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(panel books)"}, "madsrdf:citationSource": "How to make a Hedi Kyle panel book, via Byopia Press blog, posted on Jan. 15, 2017, viewed Sept. 27, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 133 (One can think of the Panorama Book as a portable gallery. When standing, the broad flat panels create a continuous array of the book's contents. Cut from a single sheet of paper, small portions of the accordion's mountain folds are utilized as hinges, allowing the panels to semi-rotate on their axis. The negative spaces of the panels become windows, allowing light and shadow to play upon all surfaces)"}, "madsrdf:citationSource": "Kyle, H. The art of the fold, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(one-of-a-kind artists' book) colophon (Hedi Kyle panel book structure) (OCoLC)1346126517"}, "madsrdf:citationSource": "Work cat.: Bingham, A. 2020 vision test, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n23a4cf5334774456841881e68420eba9b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n23a4cf5334774456841881e68420eba9b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Panel books"}}, {"@id": "_:n23a4cf5334774456841881e68420eba9b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Panel books"}}], "@id": "/authorities/genreForms/gf2022026080"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026081", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFairy tale plays", "identifiers:lccn": "gf2022026081", "madsrdf:adminMetadata": [{"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab1"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fairy tale plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026332"}, "madsrdf:hasSource": [{"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab5"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab6"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab7"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab8"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab9"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab10"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab11"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab12"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab13"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab14"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab15"}], "madsrdf:hasVariant": [{"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab16"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab19"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab22"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab25"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab28"}], "madsrdf:historyNote": "[Established February 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays, often adapted from fairy tales, that feature fantastic forces and magical beings and that are usually intended for children."}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-22T15:58:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fairy tale plays"}}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. v (Writers turn to fairy tales not merely because, as fundamentally dualistic structures, the tales are ready-made for adaptation, but also to take advantage of their fantasy, magic, and symbolism) p. 1 (Translated onto the stage, they [fairy tales] undergo yet another sea-change, from the narrative to the theatrical mode) p. 2 (the modern fairy-tale play; all the German Romantics wrote fairy tales, and many of them, following Tieck, wrote them in dramatic form) p. 8 (fairy-tale plays) p. 9 (The term \"fairy-tale play\" refers to plays related to these tales in any of three ways: (a) dramatizations or adaptations of the tales for theatrical production, whether or not actually produced; (b) plays which allude not to a particular story but to the genre of fairy tale as a whole, using any of the motifs which appear in Stith Thompson's Motif-Index of Folk-Literature. 2nd ed. Copenhagen, 1955-58); and (c) a special case of the above, plays which create a world of magic and enchantment--a \"fairy-tale world\"--which stands in opposition to the world of reality)"}, "madsrdf:citationSource": "Nicholson, David B. The fairy tale in modern drama, 1982, via ProQuest, viewed Sept. 27, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)959927508"}, "madsrdf:citationSource": "Campbell, Marilyn L. Rumplestiltskin : a fairytale play, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)8271737"}, "madsrdf:citationSource": "Frost, S. Annie. Aladdin, or, The wonderful lamp : a fairy tale drama for the little folks, 189-?", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)11841548"}, "madsrdf:citationSource": "Walser, Robert. Robert Walser rediscovered : stories, fairy-tale plays, and critical responses, 1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)44683133"}, "madsrdf:citationSource": "Carstarphen, Anita Cotter. The wishing potion : a fairy tale drama for children, 19--", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Fairy Tale (A fairy tale is a story, often intended for children, that features fanciful and wondrous characters such as elves, goblins, wizards, and even, but not necessarily, fairies. The term \"fairy\" tale seems to refer more to the fantastic and magical setting or magical influences within a story, rather than the presence of the character of a fairy within that story. Fairy tales are often traditional; many were passed down from story-teller to story-teller before being recorded in books; If a story takes place in a magical land, with fantastical creatures who perform wondrous tasks, it is very likely a fairy tale)"}, "madsrdf:citationSource": "Literary terms (Website), Sept. 27, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (5 funny plays with related writing activities and graphic organizers that motivate kids to explore plot, character, and setting) contents (Cinderella outgrows the glass slipper -- Two pigs, a wolf, and a mud pie -- Reading, writing and Little Red Riding Hood -- Live: It's fairy tale news! -- Once upon a hundred-years' nap) (OCoLC)49945485"}, "madsrdf:citationSource": "Work cat.: Wolf, Joan M. Cinderella outgrows the glass slipper and other zany fractured fairy tale plays, \u00a92002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection of plays based on folklore and fairy tales; contents: Tortoise and the hare -- Fisherman and his wife -- Little red hen -- Bremen town musicians -- Little red lighthouse and the great gray bridge -- Nightingale) (OCoLC)36622975"}, "madsrdf:citationSource": "Pugliano, Carol. Easy-to-read folk & fairy tale plays, \u00a91997", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1007846517"}, "madsrdf:citationSource": "Hamilton, Dorothy M. Fun French fairy tale plays, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fiabe: A type of fairytale play created in 18th-century Italy by Carlo Gozzi; used mythological subjects and added an element of fantasy)"}, "madsrdf:citationSource": "The Methuen Drama dictionary of the theatre, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)5922045"}, "madsrdf:citationSource": "Frost, S. Annie. Amateur theatricals and fairy-tale dramas : a collection of original plays, expressly designed for drawing-room performance, 1868.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fairytales (Drama)"}}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fairytales (Drama)"}}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fairytale drama"}}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fairytale drama"}}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fairy tales (Drama)"}}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fairy tales (Drama)"}}, {"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f3eae2ed6f548bbb237641b6ad539fab26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fairytale plays"}}, 