{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026006", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVaporwave (Music)", "identifiers:lccn": "gf2021026006", "madsrdf:adminMetadata": [{"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb1"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Vaporwave (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026783"}, "madsrdf:hasSource": [{"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb5"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb6"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb7"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb8"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb9"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb10"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-03-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-23T12:31:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vaporwave (Music)"}}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "issue 142, p. 65 (in article 10 years of vaporwave: the sound of adverts, shopping centres, slowed-down pop classics, hold music and turn-of-the-millenium computing; almost every sonic element that vaporwave either lifts wholesale or draws heavily upon is commercial to the core)"}, "madsrdf:citationSource": "Cartledge, L. Loud and quiet, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: FM Skyline. Liteware, 2020.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 119 (in article Personal take : vaporwave is dead, long live vaporwave!: the growth and speed of infrastructure had made it easy to maintain every level of a complex musical culture from networked digital devices, even the live streaming of concerts) p. 120 (artists were beginning to exchange music with like-minded others without releasing it \"physically.\" The music, later known as vaporwave, offers an archetypical case of a musical style and subculture being digital not just in form but in content) p. 122 (vaporwave might present a key example of the form and content of digital culture, it cannot be reduced to a uniquely \"online\" culture)"}, "madsrdf:citationSource": "Harper, A. The Cambridge companion to music in digital culture:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 451 (Vaporwave, first emerging in the early 2010s, is a genre of music characterised by extensive sampling of earlier \"elevator music,\" such as smooth jazz, MoR, easy listening, and muzak; audio and visual markers of the 1980s and 1990s, white-collar workspaces, media technology, and advertising are prominent features of the aesthetic)"}, "madsrdf:citationSource": "Whelan, A., Nowak, R., Open cultural studies, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(vaporwave (the name derives from \"vaporware,\" a term for commercial software that is announced but never released) is a microgenre of electronic music; it is defined partly by its slowed-down, chopped and screwed samples of smooth jazz, elevator, R&B, and lounge music from the 1980s and 1990s; the style was pioneered by producers such as James Ferraro, Daniel Lopatin, and Ramona Xavier, who each used various pseudonyms; a wealth of subgenres and offshoots emerged, such as future funk, mallsoft, and hardvapour)"}, "madsrdf:citationSource": "Wikipedia, viewed March 5, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "\u732b \u30b7 Corp., t e l e p a t h. Building a better world, \u21172019.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6490847f4a54af5b97a01a226e54d3eb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: George Clanton. Slide, 2020.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2021026006"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026007", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFilm criticism", "identifiers:lccn": "gf2021026007", "madsrdf:adminMetadata": [{"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b1"}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Film criticism"}, "madsrdf:elementList": {"@list": [{"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}, "madsrdf:hasSource": [{"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b5"}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b6"}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b7"}], "madsrdf:hasVariant": [{"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b8"}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b11"}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that evaluate, study, and discuss films of any genre."}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-03-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-23T12:31:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film criticism"}}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "How to appreciate motion pictures : a manual of motion picture criticism prepared for high school students, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(film criticism: the practice of critically appraising or reviewing films; (also) an instance of this)"}, "madsrdf:citationSource": "Oxford English Dictionary, viewed Dec. 8, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xi (\"This book is a selective study of ... certain key films of the 1940s that translated hard-boiled novels to the screen and in turn established many of the themes and cinematic techniques of film noir\")"}, "madsrdf:citationSource": "Work cat: Irwin, J. T. Unless the threat of death is behind them : hard-boiled fiction and film noir, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Criticism, Film"}}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Criticism, Film"}}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Criticism, Motion picture"}}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Criticism, Motion picture"}}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motion picture criticism"}}, {"@id": "_:naae42ef48de743e9a45d3ef42ac5a582b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion picture criticism"}}], "@id": "/authorities/genreForms/gf2021026007"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026008", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrance music", "identifiers:lccn": "gf2021026008", "madsrdf:adminMetadata": [{"@id": "_:n447824fda1214d29bc772044098e0f67b1"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trance music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n447824fda1214d29bc772044098e0f67b3"}]}, "madsrdf:exampleNote": "Note under: [Trance (Electronic dance music)]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026042"}, "madsrdf:hasSource": [{"@id": "_:n447824fda1214d29bc772044098e0f67b5"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b6"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b7"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b8"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b9"}], "madsrdf:historyNote": "[Established November 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music meant to induce a trance or performed by persons said to be in a trance. For electronic dance music characterized by a slow buildup leading to a euphoric peak see [Trance (Electronic dance music)]"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-03-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-14T11:32:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trance music"}}, {"@id": "_:n447824fda1214d29bc772044098e0f67b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Jamaica folk trance possession : mystic music from Jamaica)"}, "madsrdf:citationSource": "Work cat: Jamaica folk trance possession, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 41 (in Becker, Judith. Music and Trance: I define trance as a state of mind characterized by intense focus, the loss of the strong sense of self and access to types of knowledge and experience that are inaccessible in non-trance states. While Rouget prefers to distinguish between states of \"trance\" and \"ecstasy\", I prefer a generic category of \"trance\" that includes meditative states, possession trance, shamanic trance, communal trance, aesthetic trance and isolated moments of transcendence. Trance states can be of different kinds: there is the trance of the performer who feels herself to be one with the music she plays; the mild trance of the listener whose whole attention becomes focused on the music)"}, "madsrdf:citationSource": "Leonardo music journal, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Voodoo trance music, 1975.", "madsrdf:citationStatus": "found"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 60 (trances are gestures towards flow in the sense implied by this verb; these gestures co-occur with music of course; indeed music is a medium for transitions of ontological register. By enveloping the trance in a soundscape that suggests, invokes, or represents other times and distant spaces, the transition out of quotidian time and space comes easier) p. 234 (in its recontextualization from a local context to a global one, \"trance\" transforms and reinvents \"the sacred\" in secular and market context)"}, "madsrdf:citationSource": "Kapchan, Deborah A. (Deborah Anne). Traveling spirit masters: Moroccan Gnawa trance and music in the global marketplace, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n447824fda1214d29bc772044098e0f67b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(DLC)2005455873"}, "madsrdf:citationSource": "Work cat: Vatin, X. Rites et musiques de possession \u00e0 Bahia, c2005", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2021026008"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026009", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTarana (Music)", "identifiers:lccn": "gf2021026009", "madsrdf:adminMetadata": [{"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb1"}, {"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tarana (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026859"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb5"}, {"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb6"}, {"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Hindustani classical vocal music in which certain words and syllables based on Persian or Arabic phonemes are rendered at a medium or fast tempo."}, {"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-23T12:31:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-03-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tarana (Music)"}}, {"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Glossary (tarana: Idiom/composition using musical syllables based on Persian and Arabic phonemes)"}, "madsrdf:citationSource": "ITC Sangeet Research Academy WWW site, March 8, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert (The album is an alchemy of traditional thumris and taranas with contemporary music arrangement)"}, "madsrdf:citationSource": "Work cat: Sajanwa, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4daaec71a38c4c78a2e5881ec7d6cadeb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "volume 5, page 162 (Tar\u0101n\u0101) pages 178-179 (tar\u0101n\u0101; has South Indian counterpart till\u0101na; tar\u0101n\u0101 requires skill in rhythmic manipulation and ability to sing syllables rapidly;uses mostly vocables which permit crisp and quick rhythmic enunciation; occasionally will include a Persian-language couplet revealing historical link to Indo-Muslim culture and music)"}, "madsrdf:citationSource": "The Garland encyclopedia of world music, 1997:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2021026009"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026010", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSong parodies", "identifiers:lccn": "gf2021026010", "madsrdf:adminMetadata": [{"@id": "_:nec5b2e5941ab421b901de42526c15c6bb1"}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Song parodies"}, "madsrdf:elementList": {"@list": [{"@id": "_:nec5b2e5941ab421b901de42526c15c6bb3"}]}, "madsrdf:exampleNote": "Note under [Musical parodies; Contrafacta]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026729"}, "madsrdf:hasSource": [{"@id": "_:nec5b2e5941ab421b901de42526c15c6bb5"}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb6"}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb7"}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb8"}], "madsrdf:hasVariant": {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Post-Renaissance songs in which a new text has been substituted for the original without a significant change to the music. For vocal works from the Middle Ages or Renaissance in which a new text has been substituted for the original without a significant change to the music see [Contrafacta.] For compositions that distort or exaggerate features of another composition or a composer's works in general for humorous or satirical ends see [Musical parodies.]"}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-03-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-23T12:31:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Song parodies"}}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Weird Al Yankovic (his song parodies...are popular songs to which new, humorous lyrics are set; the stylistic parodies also employ humorous lyrics, but, instead of using actual songs, emulate the style of a popular artist)"}, "madsrdf:citationSource": "Grove music online, March 8, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 1 of cover (parodies of You made me love you, There won't be a shortage of love...) page 4 of cover (parodies on songs old or new)"}, "madsrdf:citationSource": "Work cat: Broadway parody songs, July 1942", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (Airman's song book : being an anthology of squadron, concert party, training and camp songs, and song-parodies)"}, "madsrdf:citationSource": "Airman's song book, 1967:", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Parody (2: A work in which a new text has been substituted for the original, often without humorous intent. A work of this type from the Middle Ages or Renaissance is usually termed a contrafactum)"}, "madsrdf:citationSource": "New Harvard dictionary of music, 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nec5b2e5941ab421b901de42526c15c6bb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Parody songs"}}, {"@id": "_:nec5b2e5941ab421b901de42526c15c6bb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Parody songs"}}], "@id": "/authorities/genreForms/gf2021026010"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026014", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOnline news", "identifiers:lccn": "gf2021026014", "madsrdf:adminMetadata": [{"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b1"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Online news"}, "madsrdf:elementList": {"@list": [{"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b5"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b6"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b7"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b8"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b9"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b10"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b11"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b12"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b13"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b14"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b15"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b16"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b17"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b18"}], "madsrdf:hasVariant": [{"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b19"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b22"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b25"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b28"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-04-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-23T12:31:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Online news"}}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 44 (news sites) p. 54 (news blogs) p. 125 (online news sites)"}, "madsrdf:citationSource": "Genres in the Internet, c2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"articles on online news\")"}, "madsrdf:citationSource": "The conversation WWW site, May 11, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 (ten genre classes that we found interesting: publications/articles, scholar material, news, shops, link collections, help and FAQ, private portrayals, commercial portrayals, discussion forums, and product presentations)"}, "madsrdf:citationSource": "Meyer zu Eissen, S. Genre classification of web pages, via WWW, Apr. 5, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(online journalism awards)"}, "madsrdf:citationSource": "Online News Association WWW site, May 11, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "News websites (News sites; News websites are sites devoted to delivering the news in a different format than television, print or radio. News sites include sites that have a large variety of information which may not be considered \"news\" by all audiences, but may include entertainment, games, news that may not be current but is interesting, or other miscellaneous information. An example of a site like this is MSN.com. Another type of news site is the site that is completely devoted to news. These sites may include all types of news like political, judicial, entertainment, sports or more. An example of this type of site is CNN.com. Also, there are many news sites devoted to one particular type of news or certain activity. For instance, there may be a website completely devoted to one sport or to a certain hobby.)"}, "madsrdf:citationSource": "Bruins, L. Web genre fluency projects, via WWW, Apr. 5, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "subtitle (the role of social media, news websites, and topics) abstract (online news consumption)"}, "madsrdf:citationSource": "Vermeer, Susan. Online news user journeys, article in Digital journalism 8(9), 2020, viewed on T&F online, May 11, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(news websites; news sites; news aggregation sites like Google News)"}, "madsrdf:citationSource": "Top 10 news sites in 2021, via Top10.com, viewed Apr. 5, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "News (News web sites are those which contain material which informs, explains, or comments on the events and issues of the day)"}, "madsrdf:citationSource": "Best of the Web, Apr. 5, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Top online news sites; The list below consists of the \"Top 50 Online News Entities\" (January 2015), compiled by the Pew Research Center and ComScore, ranked by level of use.)"}, "madsrdf:citationSource": "Washington and Lee University Library WWW site, May 11, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(news websites; news sites; online news websites; news aggregation site)"}, "madsrdf:citationSource": "Majid, A. Top 50 largest news websites in the world, via PressGazette website, posted Jan. 27, 2021, viewed Apr. 5, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a news website focused on North Korea)"}, "madsrdf:citationSource": "Work cat.: NK pro, via WWW, Apr. 5, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 5 (journalistic genres such as news) pp. 22-23 (news articles; newspaper article)"}, "madsrdf:citationSource": "Crowston, K. Internet genres, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(News Web sites. UF Internet news sites; Online news sites; Web news sites. BT Web sites. SN Here are entered Web sites whose primary purpose is to report general news, as well as works about such Web sites.)"}, "madsrdf:citationSource": "LCSH, Apr. 5, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(newspaper and television news websites; news sites)"}, "madsrdf:citationSource": "Stroud, N.J. Analysis of news sites, 2014, via University of Texas at Austin Center for Media Engagement website, Apr. 5, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Internet news"}}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Internet news"}}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Web news"}}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Web news"}}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Online journalism"}}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Online journalism"}}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Journalism, Online"}}, {"@id": "_:n41f27dda1fe94a388515dc441a4b08e9b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Journalism, Online"}}], "@id": "/authorities/genreForms/gf2021026014"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026015", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIndigenous futurisms comics", "identifiers:lccn": "gf2021026015", "madsrdf:adminMetadata": [{"@id": "_:n68d94f15322146a88d1edc657c617eb8b1"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Indigenous futurisms comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n68d94f15322146a88d1edc657c617eb8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n68d94f15322146a88d1edc657c617eb8b5"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b6"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b7"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b8"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b9"}], "madsrdf:hasVariant": [{"@id": "_:n68d94f15322146a88d1edc657c617eb8b10"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that express indigenous perspectives of a non-linear past, present, and future."}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-07-19T15:02:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-04-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indigenous futurisms comics"}}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Oct. 30, 2019 post by Beth LaPens\u00e9e (\"indigenous futurisms comics\")"}, "madsrdf:citationSource": "Imagining Indigenous Futurisms Facebook page, viewed Apr. 14, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Pauls, C. Dakw\u00e4k\u00e3da warriors, 2019 (an Indigenous futurisms comic; summary: \"Artist Cole Pauls ... created a comic about two Earth Protectors saving the Earth from evil pioneers and cyborg sasquatches. But he also went to his elders and asked them to translate his comic into the two dialects of Southern Tutchone. The resulting work is an allegory of colonialization done in an accessible format, a whimsical young adult graphic novel which helps to revitalize the language\")", "madsrdf:citationStatus": "found"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 45 (Moonshot comic contains an \"imaginative combinations of storytelling and science fiction [that] exemplify Grace Dillon's concept of 'Indigenous futurisms'\")"}, "madsrdf:citationSource": "Bladow, K. Framing storytelling : Indigenous graphic narratives, in The journal of popular culture, v. 52, no. 1 (2019):", "madsrdf:citationStatus": "found"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover p. 4 (\"In Indigenous storytelling, the concept of Indigenous Futurisms--a term coined by Anishinaabe scholar Grace L. Dillon--tells of the past, present, and future as being a nonlinear reality. Using the knowledge of the ancestors, it is possible to experience history, be in the present, and witness the future all at once\"; \"The stories in Moonshot Volume 3 illustrate the Indigenous Futurisms concept ... space and time travel, parallel dimensions, advanced technology, post-apocalyptic settings, robots, aliens, and more\")"}, "madsrdf:citationSource": "Work cat: Moonshot : the Indigenous comics collection. Volume 3, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"stories focused on the theme of Indigenous Futurisms will make up the third instalment of the award-winning comic collection series, Moonshot\" edited by Beth LaPens\u00e9e and Michael Sheyahshe; \"Indigenous Futurisms is a method of storytelling that looks to the past in order to inform the present and future realities\"; \"Indigenous futurism provides a vision where readers can see Indigenous people and cultures existing in the future\")"}, "madsrdf:citationSource": "Johnson, R. Space travel and parallel dimensions : popular comic series does all-Indigenous futurisms volume, via CBC website, Jan. 16, 2019, viewed Apr. 14, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n68d94f15322146a88d1edc657c617eb8b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indigenous futurism comics"}}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indigenous futurism comics"}}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n68d94f15322146a88d1edc657c617eb8b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indigenous futurist comics"}}, {"@id": "_:n68d94f15322146a88d1edc657c617eb8b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indigenous futurist comics"}}], "@id": "/authorities/genreForms/gf2021026015"}
