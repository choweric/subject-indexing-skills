{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027264", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrading cards", "identifiers:lccn": "gf2017027264", "madsrdf:adminMetadata": [{"@id": "_:n6dcd961bbc34436e877840d4351cb453b1"}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trading cards"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6dcd961bbc34436e877840d4351cb453b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}], "madsrdf:hasSource": [{"@id": "_:n6dcd961bbc34436e877840d4351cb453b5"}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b6"}], "madsrdf:hasVariant": [{"@id": "_:n6dcd961bbc34436e877840d4351cb453b7"}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b10"}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b13"}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Cards that are issued singly or in sets, bear a wide variety of images, and are intended for collecting and trading."}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trading cards"}}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "trading card (one of a collection of cards (as playing cards of different back designs) collected and traded especially by children)"}, "madsrdf:citationSource": "Merriam Webster online, June 1, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "trading card (a trading card is one of a set of thin pieces of cardboard with a picture relating to a particular theme, such as baseball or football, printed on it. Collectors buy the cards or trade them with other collectors)"}, "madsrdf:citationSource": "Collins dictionary online, June 1, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6dcd961bbc34436e877840d4351cb453b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Collecting cards"}}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Collecting cards"}}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6dcd961bbc34436e877840d4351cb453b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cards, Trading"}}, {"@id": "_:n6dcd961bbc34436e877840d4351cb453b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cards, Trading"}}, {"@id": "_:n6dcd961bbc34436e877840