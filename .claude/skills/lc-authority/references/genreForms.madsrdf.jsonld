es/genreForms/gf2019026138"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026139"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026014"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026002"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026063"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026013"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026041"}], "madsrdf:hasSource": [{"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b5"}, {"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b6"}], "madsrdf:hasVariant": [{"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b7"}, {"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-13T18:11:23"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fiction"}}, {"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fiction: the general term for invented stories, now usually applied to novels, short stories, novellas, romances, fables and other narrative works in prose, even though most plays and narrative poems are also fictional.)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fiction: literature created from the imagination, not presented as fact, though it may be based on a true story or situation. Types of literature in the fiction genre include the novel, short story, and novella. The word is from the Latin ficti\u014d, \"the act of making, fashioning, or molding.\")"}, "madsrdf:citationSource": "Britannica online, April 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories"}}, {"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories"}}, {"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tales"}}, {"@id": "_:n0d85d92bf3d74b8f8fb66ef8ae148aa4b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tales"}}], "@id": "/authorities/genreForms/gf2014026339"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026340", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFictional autobiographies", "identifiers:lccn": "gf2014026340", "madsrdf:adminMetadata": [{"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b1"}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fictional autobiographies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b3"}]}, "madsrdf:exampleNote": "Note under [Autobiographical fiction]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b5"}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b6"}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b7"}], "madsrdf:hasVariant": [{"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b8"}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b11"}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that present themselves as autobiographies but whose narrators and events are fictional. For fiction that is based on events in the author's life, but employs fictional characters intermixed with fictional events, see [Autobiographical fiction.]"}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-03T08:31:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fictional autobiographies"}}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autofiction: A kind of novel or story that is written as a first-person narrative and that commonly presents itself fictionally as an autobiography of the narrator or as an episode within such an autobiographical account. Mark Twain's Adventures of Huckleberry Finn (1884) is one among many classic novels that fall into this category. The term emerged from modern French narrative theory, but has sometimes been borrowed in English.)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1 (under Autobiographical novel: The distinction between autobiographical fiction and fictional autobiography is more straightforward. An autobiographical novel follows novelistic conventions but contains some material taken from the author's life. A fictional autobiography, such as Daniel Defoe's Moll Flanders (1722), is entirely fictional but observes the conventions of autobiography in its account of the life of the narrator)"}, "madsrdf:citationSource": "Encyclopedia of the novel, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Memoir-novel: A novel purporting to be a factual or autobiographical account but which is completely or partially imaginary. The authorial voice or speaker is typically a made-up character who never actually lived. This creation is not so much a hoax as a literary convention or an artistic device. An early example would be Daniel Defoe's Robinson Crusoe and Moll Flanders. Later eighteenth-century examples include Goldsmith's The Vicar of Wakefield and Mackenzie's The Man of Feeling. While this convention became less popular in the nineteenth-century, some examples have appeared in twentieth- and twenty-first century literature--including Umberto Eco's Baudolino)"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, Apr. 17, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autobiographies, Fictional"}}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autobiographies, Fictional"}}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autofiction"}}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autofiction"}}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Memoir-novels"}}, {"@id": "_:n6ca831ede11c46429e5e3b0b4665bc15b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Memoir-novels"}}], "@id": "/authorities/genreForms/gf2014026340"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFolk drama", "identifiers:lccn": "gf2014026341", "madsrdf:adminMetadata": [{"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b1"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Folk drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026342"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026408"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026444"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026494"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026019"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026020"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026023"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026025"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026026"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026029"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026030"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026031"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026033"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026036"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026037"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026060"}], "madsrdf:hasSource": [{"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b5"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b6"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b7"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b8"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b9"}], "madsrdf:hasVariant": [{"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b10"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b13"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Amateur dramas based on folk traditions and local history."}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:20:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folk drama"}}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk drama. UF Folk plays)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(folk drama, noncommercial, generally rural theater and pageantry based on folk traditions and local history. This form of drama, common throughout the world, declined in popularity in the West (although not in Asia) with the advent of printing, general literacy, and the increasing emphasis on the individual contribution to the drama of playwright, director, and actors. The mid-19th cent. witnessed a revival of folk drama in the United States and parts of Western Europe; regional history plays)"}, "madsrdf:citationSource": "The Columbia encyclopedia, 2013, via Credo Reference online, March 20, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk play. Under this heading may be grouped the rough-and-ready dramatic entertainments given at village festivals by the villagers themselves; derived from the dramatic tendencies inherent in primitive folk festivals, and were given on May-day, at Harvest Home, or at Christmas, when to the central theme of a symbolic death and resurrection, which comes from remotest antiquity, were added the names and feats of local worthies)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folklore definition--originating or traditional with the common people of a country or region and typically reflecting their lifestyle)"}, "madsrdf:citationSource": "Merriam-Webster online, Nov. 2, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: Mexican folk plays; New anthology of contemporary Austrian folk plays; Epic and folk plays of the Yiddish theatre; An interim list of Nottinghamshire folk plays and related customs; Home to Canaan : a Negro folkplay from Bible narrative; Spanish folkplays of the San Juan Basin; Folkplays of Dingxian; European lyric folkdrama; Javanese folkdrama and social change; Origin, definition & introduction of Bengal's folkdrama; Cheshire folk drama; Efik folk drama; The folk drama of Ceylon; Introduction to Korean folk drama; Glimpses of Bengali folk dramas; Puppetry and folk dramas, for non-formal education; Six Nuevomexicano folk dramas for Advent season)"}, "madsrdf:citationSource": "OCLC, Apr. 19, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Folk plays"}}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folk plays"}}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Folkdrama"}}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folkdrama"}}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Folkplays"}}, {"@id": "_:n0075081bd8ae4b75a753a550dc1c7b57b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folkplays"}}], "@id": "/authorities/genreForms/gf2014026341"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026342", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFolk literature", "identifiers:lccn": "gf2014026342", "madsrdf:adminMetadata": [{"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb1"}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Folk literature"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026343"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026344"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026407"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026480"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026575"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026043"}], "madsrdf:hasSource": [{"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb5"}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb6"}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb7"}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb8"}], "madsrdf:hasVariant": [{"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb9"}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works based on oral traditions."}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:20:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folk literature"}}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk literature. UF Oral literature. BT Literature)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(folk literature, also called folklore or oral tradition, the lore (traditional knowledge and beliefs) of cultures having no written language. It is transmitted by word of mouth and consists, as does written literature, of both prose and verse narratives, poems and songs, myths, dramas, rituals, proverbs, riddles, and the like.)"}, "madsrdf:citationSource": "Encyclop\u00e6dia Britannica online, Apr. 8, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folklore. Folklore includes myths, legends, stories, riddles, proverbs, nursery rhymes, charms, spells, omens, beliefs of all sorts, popular ballads, cowboy songs, plant lore, animal lore, and customs dealing with birth, initiation, courtship, marriage, medicine, work, amusements, and death.)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk literature. Definition: Folk or traditional literature is the collection of tales passed from generation to generation and from the old to the young by word of mouth (also called the oral tradition). Folk literature is believed to be people's efforts to organize their experiences into meaningful patterns. Folk literature includes fairy tales, myths, legends, fables, tall tales, and other oral traditions of preliterate societies.)"}, "madsrdf:citationSource": "Southern Connecticut State University website Literature for children, viewed Apr. 8, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Traditional literature"}}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Traditional literature"}}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oral literature"}}, {"@id": "_:nbfa4f3e47dc2477ab340cca7ca497decb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oral literature"}}], "@id": "/authorities/genreForms/gf2014026342"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026343", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFolk poetry", "identifiers:lccn": "gf2014026343", "madsrdf:adminMetadata": [{"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b1"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Folk poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026342"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026028"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026574"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026062"}], "madsrdf:hasSource": [{"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b5"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b6"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b7"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b8"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b9"}], "madsrdf:hasVariant": [{"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b10"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that are composed and transmitted via oral tradition."}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:26:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folk poetry"}}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 86 (Seven factors of folk poetry: i. It is a social activity. ii. It is an activity which belongs to all people. iii. It may relate to all aspects of life. iv. Its forms are very numerous and non-static. v. It is, in essence, an oral activity. vi. It communicates messages in a direct and colourful manner, with the emphasis on narration and communication. vii. Folk poetry is functional, applied poetry.)"}, "madsrdf:citationSource": "Folklore : electronic journal of folklore, v. 33, viewed Jan. 11, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 347 (Folk poetry typically circulates orally, through recitations or songs)"}, "madsrdf:citationSource": "Encyclopedia of American poetry. The Nineteenth century, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "American folk poetry, 1974.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 863 (Oral poetry, especially oral traditional poetry, is poetry composed and transmitted mainly but not exclusively by people who cannot read or write. Oral poetry is traditional when each generation has received it orally from the preceding one, back to the dawn of poetry, and transmits it to the next as long as the tradition lives. Oral poetry has its own methods of composition and transmission which differentiate it from written literature.)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oral traditional poetry"}}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oral traditional poetry"}}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Traditional poetry, Oral"}}, {"@id": "_:nb9f46a2e9c6e4813a450c8dbd39d1d86b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Traditional poetry, Oral"}}], "@id": "/authorities/genreForms/gf2014026343"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026344", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFolk tales", "identifiers:lccn": "gf2014026344", "madsrdf:adminMetadata": [{"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b1"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Folk tales"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026342"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026213"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026327"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026329"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026388"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026582"}], "madsrdf:hasSource": [{"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b5"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b6"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b7"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b8"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b9"}], "madsrdf:hasVariant": [{"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b10"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short narratives of uncertain origin that are based on oral tradition."}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:21:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folk tales"}}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(M\u00e4rchen. A German term for a folk tale or fairy story. The classic collection is that made by the Grimm brothers early in the 19th c.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "folk tale (noun, 1. a tale or legend originating and traditions among a people or folk, especially one forming part of the oral tradition of the common people. 2. any belief or story passed on traditionally, especially one considered to be false or based on superstition. Also, folk-tale. Also called folk story)"}, "madsrdf:citationSource": "Dictionary.com, Apr. 11, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Folktale (A short narrative handed down through oral tradition, with various tellers and groups modifying it, so that it acquires cumulative authorship. Most folktales eventually move from oral tradition to written form) Tale (A relatively simple narrative. Formerly, no very real distinction was made between the tale and the short story. Tale, however, has always been a more general term, because short story has been reserved for fictional narratives having a conscious structure and tale has been used loosely for any short narrative, either true or fictitious)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tale. A word originating from the Old English talu, or \"speech,\" a tale is a short, anonymous narrative without a complex plot or three-dimensional characters. An ancient form of narrative found in folklore and oral tradition, tales present basic stories with simple motivations, their literary power stemming from supernatural elements, twists of fate, and comic or tragic outcomes. A tale differs from a short story by its tendency to linear plotting and flat and stock characters, a distinction that British writer A.E. Coppard attributes to the fact that a story is something that is written and a tale is something that is told. The ambition of a tale is usually similar to that of a yarn: a concentrated revelation of the marvelous, comical, and ironic, rather than the careful representation of the everyday world.)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Folktale (Folktales are stories passed along from one generation to the next by word-of-mouth rather than by a written text) Folklore (Many works of literature originated in folktales before the narratives were written down. Examples in American culture include the story of George Washington chopping down the cherry tree; George Washington throwing a silver dollar across the Potomac river; Paul Bunyon cutting lumber with his blue ox, Babe; Pecos Bill roping a twister; and Johnny Appleseed planting apples across the west over a 120-year period)"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, Jan. 22, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "M\u00e4rchen"}}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "M\u00e4rchen"}}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Folktales"}}, {"@id": "_:nb6e563085c9b42f89e0086a6cb4866d9b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folktales"}}], "@id": "/authorities/genreForms/gf2014026344"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026345", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFotonovelas", "identifiers:lccn": "gf2014026345", "madsrdf:adminMetadata": [{"@id": "_:n130fcb0c807b44eb8095942335776a73b1"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fotonovelas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n130fcb0c807b44eb8095942335776a73b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n130fcb0c807b44eb8095942335776a73b5"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b6"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b7"}], "madsrdf:hasVariant": [{"@id": "_:n130fcb0c807b44eb8095942335776a73b8"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b11"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b14"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b17"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b20"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b23"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Narratives consisting of photographs laid out in the style of a comic book."}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:21:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fotonovelas"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fotonovelas. UF Photo comic books; Photo novels; Photocomics; Photographic novels; Photonovelas; Photonovels)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (fotonovelas; the fotonovela may be comic book-like in its serial nature, or close-ended, as is the graphic novel, but it is told through camera snapshots rather than drawing)"}, "madsrdf:citationSource": "Goldsmith, F. The readers' advisory guide to graphic novels, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A fotonovela also known as novela or novelita, is a small pamphlet akin to comic-book format, with photographs instead of illustrations, combined with small dialogue bubbles. They typically depict a simple story enveloped in a dramatic plot that contains a moral.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 14, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n130fcb0c807b44eb8095942335776a73b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photo comic books"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photo comic books"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n130fcb0c807b44eb8095942335776a73b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photocomics"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photocomics"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n130fcb0c807b44eb8095942335776a73b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novels, Photographic"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novels, Photographic"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n130fcb0c807b44eb8095942335776a73b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photo novels"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photo novels"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n130fcb0c807b44eb8095942335776a73b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photonovelas"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photonovelas"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n130fcb0c807b44eb8095942335776a73b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photonovels"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photonovels"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n130fcb0c807b44eb8095942335776a73b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photographic novels"}}, {"@id": "_:n130fcb0c807b44eb8095942335776a73b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photographic novels"}}], "@id": "/authorities/genreForms/gf2014026345"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026346", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFound poetry", "identifiers:lccn": "gf2014026346", "madsrdf:adminMetadata": [{"@id": "_:n54f50d4745e241b6abaa27718071b672b1"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Found poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n54f50d4745e241b6abaa27718071b672b3"}]}, "madsrdf:exampleNote": "Note under [Centos]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026017"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026017"}, "madsrdf:hasSource": [{"@id": "_:n54f50d4745e241b6abaa27718071b672b5"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b6"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b7"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b8"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b9"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b10"}], "madsrdf:hasVariant": {"@id": "_:n54f50d4745e241b6abaa27718071b672b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems consisting of words or text taken from various sources and reframed as poetry. For poems consisting of passages from poems by one or more other authors see [Centos.]"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-07-08T14:38:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Found poetry"}}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Found poetry is a type of poetry created by taking words, phrases, and sometimes whole passages from other sources and reframing them as poetry by making changes in spacing and/or lines (and consequently meaning), or by altering the text by additions and/or deletions. The resulting poem can be defined as either treated: changed in a profound and systematic manner; or untreated: virtually unchanged from the order, syntax and meaning of the original)"}, "madsrdf:citationSource": "Wikipedia, May 27, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A found poem is the gathering and assembling of grouped words \"found\" in the environment and incorporating the \"found\" phrases and words into a larger poetic piece. It is a \"snatch of poetry.\" Printed images or phrases assembled in a literary collage. The lineal arrangement rearranges the phrases to create an entirely different piece. It presents things found in the poet's surroundings such as a news article, a poem, letters, dialogue or anything)"}, "madsrdf:citationSource": "Poetry magnum opus online, Jan. 9, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetic Form: Found Poem; Found poems take existing texts and refashion them, reorder them, and present them as poems. The literary equivalent of a collage, found poetry is often made from newspaper articles, street signs, graffiti, speeches, letters, or even other poems. A pure found poem consists exclusively of outside texts: the words of the poem remain as they were found, with few additions or omissions. Decisions of form, such as where to break a line, are left to the poet.)"}, "madsrdf:citationSource": "Poets.org, viewed Dec. 26, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Found poetry. UF Collage poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Found poem. A found poem is a piece of writing that was not intended as a poem, but is so declared by its \"finder.\" Parts of newspaper articles are often declared to be \"found poems,\" as are lists, notes passed among children, scraps of conversation, and other incidental uses of language. Some of the earliest and most engrossing found poetry is in Charles Reznikoff's Testimony, based on courtroom trials.)"}, "madsrdf:citationSource": "The Teachers & Writers handbook of poetic forms, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Collage poetry, sometimes called found poetry)"}, "madsrdf:citationSource": "Answers.yahoo.com, May 27, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n54f50d4745e241b6abaa27718071b672b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Collage poetry"}}, {"@id": "_:n54f50d4745e241b6abaa27718071b672b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Collage poetry"}}], "@id": "/authorities/genreForms/gf2014026346"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026347", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFrame stories", "identifiers:lccn": "gf2014026347", "madsrdf:adminMetadata": [{"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab1"}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Frame stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026456"}, "madsrdf:hasSource": [{"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab5"}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab6"}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab7"}], "madsrdf:hasVariant": [{"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab8"}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab11"}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Stories that contain other stories."}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:22:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Frame stories"}}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Frame narrative (frame story): a story in which another story is enclosed or embedded as a 'tale within the tale', or which contains several such tales.)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(frame story (also frame tale, frame narrative, etc.) is a literary technique that sometimes serves as a companion piece to a story within a story, whereby an introductory or main narrative is presented, at least in part, for the purpose of setting the stage either for a more emphasized second narrative or for a set of shorter stories. The frame story leads readers from a first story into another, smaller one (or several ones) within it.)"}, "madsrdf:citationSource": "Wikipedia, October 31, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Frame story: one which contains either another tale, a story within a story, or a series of stories.)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, c1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Frame narratives"}}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Frame narratives"}}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Narratives, Frame"}}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Narratives, Frame"}}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Frame tales"}}, {"@id": "_:nd6dfd6bcb84046199a21ed05788ae93ab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Frame tales"}}], "@id": "/authorities/genreForms/gf2014026347"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026348", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFree verse", "identifiers:lccn": "gf2014026348", "madsrdf:adminMetadata": [{"@id": "_:n570f9d72a41b4f17954205e06904cf9ab1"}, {"@id": "_:n570f9d72a41b4f17954205e06904cf9ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Free verse"}, "madsrdf:elementList": {"@list": [{"@id": "_:n570f9d72a41b4f17954205e06904cf9ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026507"}, "madsrdf:hasSource": [{"@id": "_:n570f9d72a41b4f17954205e06904cf9ab5"}, {"@id": "_:n570f9d72a41b4f17954205e06904cf9ab6"}, {"@id": "_:n570f9d72a41b4f17954205e06904cf9ab7"}, {"@id": "_:n570f9d72a41b4f17954205e06904cf9ab8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems whose rhythms are based on the cadences of common speech instead of on conventional metrical patterns."}, {"@id": "_:n570f9d72a41b4f17954205e06904cf9ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n570f9d72a41b4f17954205e06904cf9ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:22:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n570f9d72a41b4f17954205e06904cf9ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Free verse"}}, {"@id": "_:n570f9d72a41b4f17954205e06904cf9ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Free verse: Verse that does not conform to conventional forms of structure and organization such as metrical foot, rhyme and stress patterns. Instead, it has lines of varying length and uses the more natural cadences of everyday speech to gain its rhythm.)"}, "madsrdf:citationSource": "Ruse, C. The Cassell dictionary of literary and language terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:n570f9d72a41b4f17954205e06904cf9ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Free verse: Nonmetrical verse; lines that are not measured or counted for number of accents, number of syllables, or lengths of syllables; lines that are free of meter; also called vers libre.)"}, "madsrdf:citationSource": "Drury, J. A poetry dictionary, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n570f9d72a41b4f17954205e06904cf9ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Free verse: Lines of poetry written without regular meter and usually without rhyme. Although scattered examples of free verse appear in earlier poetry, the great pioneer of the form was Walt Whitman; in the 20th century, free verse has become the dominant poetic form.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n570f9d72a41b4f17954205e06904cf9ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free verse: term loosely used for rhymed or unrhymed verse made free of conventional and traditional limitations and restrictions in regard to metrical structure. Cadence, especially that of common speech, is often substituted for regular metrical pattern. Free verse is a literal translation of the French vers libre, which originated in late 19th-century France among poets, such as Arthur Rimbaud and Jules Laforgue, who sought to free poetry from the metrical regularity of the alexandrine)"}, "madsrdf:citationSource": "Columbia encyclopedia, 2013", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026348"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026349", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFu", "identifiers:lccn": "gf2014026349", "madsrdf:adminMetadata": [{"@id": "_:n962d97d331124b9290de9fd16e0a41cfb1"}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fu"}, "madsrdf:elementList": {"@list": [{"@id": "_:n962d97d331124b9290de9fd16e0a41cfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n962d97d331124b9290de9fd16e0a41cfb5"}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb6"}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb7"}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb8"}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Chinese poems in which an object, feeling, or subject is described in exhaustive detail."}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:23:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fu"}}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fu)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fu is a kind of prose-poem popular in ancient China, especially during the Han Dynasty. It is a type of prose-poem with introductory, concluding, or other interspersed passages that are in prose, typically in the form of questions and answers. A Han fu is typically very long, describes a subject exhaustively from every possible angle, and is usually meant to display the poet's rhetorical and lexical skill rather than express personal feeling)"}, "madsrdf:citationSource": "Cultural China online, Jan. 2, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The poetic genre known as the fu (rhapsodies), which became the typical court poetry of the Han dynasty, may be regarded as deriving from sao poetry. The fu generally opens with a short introduction in prose, and the main body in verse employs a variety of line lengths (3-, 4-, 6-, or 7-character lines), end rhymes, onomatopoeia, dazzling images, occasional verbal and syntactic parallelism, lengthy enumeration of fantastic objects and place names, etc. Like sao, the early fu tends to take a panoramic, cosmological approach, focusing on imaginary celestial journeys with an aim to impress and enrapture the reader)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The fu is a type of poem in which an object, action, or feeling is described in exhaustive detail. The author not only tries to deal with all aspects of his subject matter, he also tries to exhaust all relevant resources of the language; The fu was intended to be read aloud, not sung; in this respect it differs from all other genres of traditional Chinese poetry, as these all originated in song. Accordingly, a fixed line-length was less essential in fu than in other poetic forms. The length of a fu depends on its subject. Prose passages may occur as an introduction to the fu or as insertions providing variety)"}, "madsrdf:citationSource": "Idema, W. A guide to Chinese literature, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n962d97d331124b9290de9fd16e0a41cfb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The fu is an intermediary genre between verse and prose. Fu compositions are for the most part rhymed and have a regular number of syllables per line. However, there are no strict prosodic rules, and sometimes there are unrhymed prose lines intermingled with the rhymed sections. The first fu appeared during the late Warring States period)"}, "madsrdf:citationSource": "Ancient and early medieval Chinese literature, 2010", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026349"}
