{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026293", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGeodatabases", "identifiers:lccn": "gf2011026293", "madsrdf:adminMetadata": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b1"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Geodatabases"}, "madsrdf:elementList": {"@list": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026294"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026081"}], "madsrdf:hasSource": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b5"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b6"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b7"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b8"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b9"}], "madsrdf:hasVariant": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b10"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b13"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b16"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b19"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b22"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b25"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b28"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b31"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b34"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b37"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b40"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025021"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T11:34:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geodatabases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(An example of object-oriented (OO) data models is the geodatabase data model developed by Environmental Systems Research Institute, Inc. (ESRI). The geodatabase model, shorthand for \"geographic database,\" uses standard relational database technology and supports a model of topologically integrated feature classes. Much like the file-based coverage model, the geodatabase model consists of a storage mechanism for geographic data and a series of data access components.)"}, "madsrdf:citationSource": "Object-oriented representation, via WWW (PDF), June 16, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "geodatabases explored (A geodatabase is a database that is in some way referenced to locations on the earth. Coupled with this data is usually data known as attribute data. Attribute data generally defined as additional information, which can then be tied to spatial data. Geodatabases are grouped into two different types: vector and raster. Most GIS software applications mainly focus on the usage and manipulation of vector geodatabases with added components to work with raster-based geodatabases.)"}, "madsrdf:citationSource": "GIS lounge website, June 16, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "products overview/the geodatabase/personal and multiuser (Geodatabases work across a range of RDBMS architectures, come in many sizes, and have varying numbers of users. They can scale from smaller, single user databases built on the Microsoft Jet Engine (Access) database up to larger work group, department, and enterprise databases accessed by many users. Two types of geodatabase implementations are available: personal geodatabases and multiuser geodatabases.)"}, "madsrdf:citationSource": "ESRI home page, June 16, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 20 (Geodatabases organize geographic data into a hierarchy of data objects. These data objects are stored in feature classes, object classes, and feature datasets.) p. 354 (geodatabase: An object-oriented data model introduced by ESRI that represents geographic features and attributes as objects and the relationships between objects but is hosted inside a relational database management system. A geodatabase can store objects, such as feature classes, feature datasets, nonspatial tables, and relationship classes. GDB, see geodatabase) p. 4 of cover (geographic database)"}, "madsrdf:citationSource": "Work cat.: ArcGIS 9. Building a geodatabase, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(geodatabase; GIS geodatabase; relational geodatabase; geographic information system (GIS) database; geographic information system database; geographic databases; GIS database; geographical database; geographical information system database; geographical information systems databases; digital geographical databases; geographic information database; geographic and object-oriented databases; geographic information systems (GIS) database)"}, "madsrdf:citationSource": "OCLC, June 16, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographic information system databases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographic information system databases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Digital geographical databases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Digital geographical databases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographic databases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographic databases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "GIS geodatabases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "GIS geodatabases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographical information systems databases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographical information systems databases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographical databases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographical databases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "GDBs (Geodatabases)"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "GDBs (Geodatabases)"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographic information databases"}}, {"@id": "_:n11515d0bba9b4368bfcf703ff80fd6a7b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographic information databases"}}, {"@id": "_: