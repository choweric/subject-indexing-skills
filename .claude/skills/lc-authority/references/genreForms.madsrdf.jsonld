": "en", "@value": "Memorial programs"}}], "@id": "/authorities/genreForms/gf2014026126"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026127", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMenus", "identifiers:lccn": "gf2014026127", "madsrdf:adminMetadata": [{"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b1"}, {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Menus"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026086"}, "madsrdf:hasSource": [{"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b5"}, {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b6"}, {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b7"}, {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b8"}], "madsrdf:hasVariant": {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Lists of foods and/or beverages served at a meal or available for purchase in a restaurant."}, {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-03T13:41:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Menus"}}, {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(menu: a written or printed list of the dishes and beverages that may be ordered at a restaurant or other eating establishment or that are to be served at a banquet or other occasion, often divided into categories to facilitate selection. Menus are considered a form of ephemera and are collected by libraries and archives mainly for their historical value. Synonymous with bill of fare.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 27, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Menus. Scope Note: Lists of the dishes that may be ordered in an eating establishment or that are to be served at a banquet or other occasion. UF Bills of fare. BT Ephemera)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, July 27, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(menus. UF bills of fare. Lists of dishes to be served or available for meals.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 27, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc59a4adf263346b1b27ce225a6da77e9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 56 (menu: list of dishes; computer list)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types an