{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026012", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCanzonas (Instrumental music)", "identifiers:lccn": "gf2018026012", "madsrdf:adminMetadata": [{"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b1"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Canzonas (Instrumental music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b5"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b6"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b7"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b8"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b9"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b10"}], "madsrdf:hasVariant": [{"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b11"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b14"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Instrumental music of the 16th to 17th centuries that was modeled on the style and structure of the chanson."}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-15T14:49:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Canzonas (Instrumental music)"}}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(canzona: a type of 16th- or 17th-century contrapuntal music, usually for keyboard, lute, or instrumental ensemble)"}, "madsrdf:citationSource": "Collins English dictionary online, Jan. 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Canzona: A type of instrumental music of the 16th and 17th centuries that developed from the Netherlandish chanson; The spelling 'canzona' was fairly frequently used in Italy after 1600 and has become standard in England and not infrequent in Germany; in older Italian sources, however, 'canzone' and 'canzon' (with the plural 'canzoni') are practically universal, and 'canzone' has subsequently remained the standard Italian form. The word 'canzone' or 'canzona' in its instrumental connotation originally denoted an arrangement of a polyphonic song, usually a French chanson, since although arrangements of Italian works were quite common these were usually called 'frottola' or 'madrigale'. Although it was used at least until the end of the 16th century to mean a straightforward arrangement, there are quite early instances of new compositions based on existing chanson material, and the term eventually came to be applied to original compositions using idioms familiar through arrangements and reworkings. Since chansons of the type favoured for these purposes (i.e. the Parisian chanson as represented in the books of Attaingnant starting in 1528) frequently began with fugal imitation, the canzona came to be considered a fugal genre. A good many 16th-century keyboard canzonas are nothing more than elaborated transcriptions of chansons, for example those of Andrea Gabrieli and Sperindio Bertoldo. Often the ornamentation is very profuse, perhaps slowing down the natural speed of the plain original)"}, "madsrdf:citationSource": "Grove music online, via Oxford music online, Jan. 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(canzona (plural canzonas): (music) A type of instrumental composition based on multipart vocal settings of canzoni, produced chiefly in the 16th and 17th centuries; canzone (plural canzones or canzoni): 1. An Italian or Proven\u00e7al song or ballad. 2. A canzona (mediaeval Italian instrumental composition))"}, "madsrdf:citationSource": "Wiktionary, Jan. 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Andrea Gabrieli issued a whole book of Canzoni alla francese per sonar sopra stromenti da tasti (\"French-type songs for playing on keyboard instruments\") in 1571: it contains arrangements of chansons by Janequin, Lasso, and others. By the end of the century, however, the \"canzona\" (for some reason turned into a feminine noun; the normal Italian word for \"song\" is canzone) had become an independent instrumental genre more or less modeled on the style and structure of the chanson, even taking over its typical \"pseudodactylic\" opening rhythm as a trademark)"}, "madsrdf:citationSource": "Oxford history of Western music, via Oxford music online, Jan. 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(includes two canzonas with title: Canzona \u00e0 4; the canzonas are for instrumental ensemble (cornett, trombones, harp, chitarrone))"}, "madsrdf:citationSource": "Work cat.: Gabrieli, A. Madrigali e canzoni, 1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Canzona, Italian canzone (\"song\" or \"chanson\"), plural canzoni, a genre of Italian instrumental music in the 16th and 17th centuries. In 18th- and 19th-century music, the term canzona refers to a lyrical song or songlike instrumental piece. In the 14th century the Italian scholar, poet, and humanist Petrarch frequently used the canzona poetic form, and in the 16th century canzoni were often used as texts by madrigal composers. In the late 16th century, the term canzona or its diminutive, canzonetta, referred to polyphonic songs whose music and text were in a lighter vein than the madrigal. These include the canzoni villanesche (\"rustic songs\") popular in mid-century. The instrumental canzona derived its form from the French polyphonic chanson known in Italy as canzon(a) francese; many early canzonas were instrumental arrangements of chansons, alternating between polyphonic and homophonic (based on chords) sections; In the late 16th century two varieties emerged: for keyboard and for instrumental ensemble. The keyboard canzona was more intensely polyphonic and, in its frequent treatment of a single theme, prepared the way for the fugue; in early 17th-century Germany \"canzona\" was in fact often synonymous with \"fugue.\" Notable composers of keyboard canzonas include the Italians Girolamo Cavazzoni, Andrea Gabrieli, Claudio Merulo, and, especially, Girolamo Frescobaldi and the German Johann Jakob Froberger. Unlike the keyboard canzonas, which emphasized unity of musical texture, the ensemble canzonas of Giovanni Gabrieli and Frescobaldi, with their contrasting tempos, metres, and rhythms, led the way to the trio sonata, the dominant chamber genre of the Baroque era. Toward the middle of the 17th century, the multisectional canzona was systematically transformed into a four-movement instrumental composition, as a rule for two treble and two bass instruments, known as the sonata da chiesa, or church form of the trio sonata, although the term canzona was still occasionally used for a movement in fugal style)"}, "madsrdf:citationSource": "Encyclop\u00e6dia Britannica online, Jan. 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Canzonettas (Instrumental music)"}}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Canzonettas (Instrumental music)"}}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Canzoni (Instrumental music)"}}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Canzoni (Instrumental music)"}}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Canzones (Instrumental music)"}}, {"@id": "_:n49b44ec77a2149e0ac02afc84dcd8411b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Canzones (Instrumental music)"}}], "@id": "/authorities/genreForms/gf2018026012"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026013", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEthnographies", "identifiers:lccn": "gf2018026013", "madsrdf:adminMetadata": [{"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b1"}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ethnographies"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026232"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026233"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026012"}], "madsrdf:hasSource": [{"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b5"}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b6"}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b7"}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b8"}], "madsrdf:hasVariant": [{"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b9"}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b12"}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b15"}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Anthropological studies of people and their culture."}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-16T09:47:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfb02791bebdf4ced