{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026915", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMadrigals (Music)", "identifiers:lccn": "gf2014026915", "madsrdf:adminMetadata": [{"@id": "_:n294ea23514b9462eb163d88c8b28df7eb1"}, {"@id": "_:n294ea23514b9462eb163d88c8b28df7eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Madrigals (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n294ea23514b9462eb163d88c8b28df7eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026984"}, "madsrdf:hasSource": {"@id": "_:n294ea23514b9462eb163d88c8b28df7eb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Madrigals of the 16th and 17th centuries."}, {"@id": "_:n294ea23514b9462eb163d88c8b28df7eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n294ea23514b9462eb163d88c8b28df7eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:00:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n294ea23514b9462eb163d88c8b28df7eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Madrigals (Music)"}}, {"@id": "_:n294ea23514b9462eb163d88c8b28df7eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A poetic and musical form of 14th-century Italy; more importantly, a term in general use during the 16th century and much of the 17th for settings of various types and forms of secular verse. There is no connection between the 14th- and the 16th-century madrigal other than that of name; the former passed out of fashion a century before the term was revived. The later madrigal became the most popular form of secular polyphony in the second half of the 16th century, serving as a model for madrigals and madrigal-like compositions in languages other than Italian throughout Europe. It set the pace for stylistic developments that culminated in the Baroque period, particularly those involving the expressive relationship between text and music, and must be regarded as the most important genre of the late Renaissance.)"}, "madsrdf:citationSource": "Grove music online, viewed August 6, 2014 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026915"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026916", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMakossa (Music)", "identifiers:lccn": "gf2014026916", "madsrdf:adminMetadata": [{"@id": "_:nf1788326ae7b4699a1e6122d98e43658b1"}, {"@id": "_:nf1788326ae7b4699a1e6122d98e43658b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Makossa (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf1788326ae7b4699a1e6122d98e43658b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:nf1788326ae7b4699a1e6122d98e43658b5"}, {"@id": "_:nf1788326ae7b4699a1e6122d98e43658b6"}], "madsrdf:hasVariant": {"@id": "_:nf1788326ae7b4699a1e6122d98e43658b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf1788326ae7b4699a1e6122d98e43658b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf1788326ae7b4699a1e6122d98e43658b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nf1788326ae7b4699a1e6122d98e43658b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Makossa (Music)"}}, {"@id": "_:nf1788326ae7b4699a1e6122d98e43658b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Internet, Wikipedia, May 16, 2011 (Makossa is a type of music that is most popular in urban areas in Cameroon. It is similar to soukous, except that it includes strong bass rhythm and a prominent horn section. Makossa, which means \"(I) dance\" in Duala, originated from a type of Duala dance called kossa, with significant influences from jazz, zouk, ambasse bey, Latin music, highlife and rumba. While the makossa style began in the 1950s, the first recordings were not seen until a decade later. Artists such as Eboa Lotin, Misse Ngoh and especially Manu Dibango popularized the style outside of Cameroon in the late 1960s. Makassi is a lighter style of makossa)", "madsrdf:citationStatus": "found"}, {"@id": "_:nf1788326ae7b4699a1e6122d98e43658b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Le makossa, une musique africaine moderne, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf1788326ae7b4699a1e6122d98e43658b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf1788326ae7b4699a1e6122d98e43658b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Makassi (Music)"}}, {"@id": "_:nf1788326ae7b4699a1e6122d98e43658b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Makassi (Music)"}}], "@id": "/authorities/genreForms/gf2014026916"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026917", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMa'l\u016bf", "identifiers:lccn": "gf2014026917", "madsrdf:adminMetadata": [{"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb1"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ma'l\u016bf"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb5"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb6"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb7"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb8"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb9"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ma'l\u016bf"}}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2012015035: The ma'l\u016bf in contemporary Libya, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 6, p. 1086 (ma'l\u016bf: term for Andalusian (art) music of the Maghrib.)"}, "madsrdf:citationSource": "Garland encyclopedia of world music:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Algeria, People's Republic of. Urban musics. Andalouse. Schools. Ma'l\u016bf. Ma'l\u016bf or 'traditional' is the name given to the andalouse music from the eastern Algerian school, centered on Constantine and Annaba. This tradition spans the border into Tunisia, where it is regarded as a music of national importance. Ma'l\u016bf is also performed in Libya with a style and repertory heavily influenced by Bedouin and Egyptian musics.)"}, "madsrdf:citationSource": "Grove Music Online, July 11, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ma'l\u016bf. The ma'l\u016bf is a melodic tradition, conceived according to the principles of maq\u0101m 'melodic mode' (plural, maq\u0101m\u0101t) and \u012bq\u0101' 'rhythmic-metric organization' (plural, \u012bq\u0101'\u0101t) characterizing urban Arab music generally. It is primarily a vocal repertoire, although in some regions, notably Tunis, some purely instrumental pieces were added ... Most of the repertoire, including all that is regarded as the authentic Andalusian core, is classified by maq\u0101m into thirteen n\u016bb\u0101t 'suites' (singular, n\u016bba). A n\u016bba comprises a common stock of vocal and instrumental genres, each representing a particular \u012bqa' or, exceptionally, \u012bqa'at, which are performed in a characteristic sequence. Since not every genre nor every example of any one genre need be included, two performances of the same n\u016bba may in principle consist of totally different pieces; in practice, however, musicians keep to a limited, habitual repertoire, which varies from one ensemble to the next.)"}, "madsrdf:citationSource": "Garland Encyclopedia of World Music Online, July 11, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tunisia, Republic of. Urban music traditions. Ma'l\u016bf. The ma'l\u016bf (literally, that which is familiar or customary) is regarded by urban Tunisians as their oldest, most prestigious musical tradition. Musical characteristics. The ma'l\u016bf is essentially a collection of songs and instrumental pieces, organized within a complex system of melodic modes called tubu (sing. tab) or more recently, maqamat (sing. maqam).)"}, "madsrdf:citationSource": "Grove Music Online, July 11, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2635dea527e4588aea5f6ec95e1491fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The maluf (Arabic: \u0645\u0627\u0644\u0648\u0641\u00fd Ma'l\u016bf) (French: Malouf) is a genre of art music in the Andalusian classical music tradition of Algeria, Libya and Tunisia.[1] It was revived in the 1920s by the French musicologist Baron Rodolphe d'Erlanger.)"}, "madsrdf:citationSource": "Wikipedia, July 12, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026917"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026918", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMalh\u016bn (Music)", "identifiers:lccn": "gf2014026918", "madsrdf:adminMetadata": [{"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b1"}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Malh\u016bn (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b5"}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b6"}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b7"}], "madsrdf:hasVariant": [{"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b8"}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Malh\u016bn (Music)"}}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online WWW home page, viewed August 4, 2005: Morocco: specialist music page (malh\u016bn [in rom.]; an urban song style closely associated with Andalusian music, is thought to have originated in the Tafilalet, a chain of oases south of the Atlas mountains; distinguished by the colloquial, but archaic and learned dialect of its long texts. The song is strophic in form, often with a choral refrain; each strophe has a complex rhyme scheme, sometimes modelled on the muwashshah; uses melodies of limited range; basic metre is 2/4, but may have sections with 5/8 or 6/8; form of the text is the qasida, with monorhyme and monometric pattern and is influenced by the muwashshah.)", "madsrdf:citationStatus": "found"}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "[al-\u1e24\u0101jj \u1e24usayn al-Tul\u0101l\u012b, r\u0101\u02bcid al-mal\u1e25\u016bn], 1997: booklet (malhoun [in rom.]; Moroccan musical style, thought to have originated in the Tafilatet, a chain of oases south of the Atlas Mountains; the term arose in the 15th century and developed from two sources: Moroccan bedouin poetry and Andalusian musical tradition. The lyric is derived from poetry (in qasida form) which is sung, accompanied by a percussion instrument (tarija), but also can be accompanied by a flute, violin, or lute (oud); themes can be either religious or secular (love, fables, etc).", "madsrdf:citationStatus": "found"}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Guide bibliographique du melhoun, 1996: t.p. (al-mal\u1e25\u016bn [in ara.])", "madsrdf:citationStatus": "found"}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Malhoun (Music)"}}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Malhoun (Music)"}}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Melhoun (Music)"}}, {"@id": "_:neb57ad06bfb34347be4b1584094ee8d3b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Melhoun (Music)"}}], "@id": "/authorities/genreForms/gf2014026918"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026919", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMaloya (Music)", "identifiers:lccn": "gf2014026919", "madsrdf:adminMetadata": [{"@id": "_:n781255c767cf4b70845588df06b24b66b1"}, {"@id": "_:n781255c767cf4b70845588df06b24b66b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Maloya (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n781255c767cf4b70845588df06b24b66b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n781255c767cf4b70845588df06b24b66b5"}, {"@id": "_:n781255c767cf4b70845588df06b24b66b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n781255c767cf4b70845588df06b24b66b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n781255c767cf4b70845588df06b24b66b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n781255c767cf4b70845588df06b24b66b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maloya (Music)"}}, {"@id": "_:n781255c767cf4b70845588df06b24b66b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 99490649: Viry, Firmin. Ile de la R\u00e9union, p1999: label (Maloya) p. 10 of booklet (The maloya is the popular expression for the resistance of the slaves who came to the island of La Reunion, notably from Mozambique and Madagascar, bringing their myths, customs, beliefs and dreams. The maloya, 'long ago music' (music lontan), survived as underground music in people's backyards, until, thanks to Firmin Viry, it eventually emerged. The maloya is the secular side of a sacred ritual, the kabar\u00e9, or ancestor worship)", "madsrdf:citationStatus": "found"}, {"@id": "_:n781255c767cf4b70845588df06b24b66b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Garland encyclopedia of world music. Southeast Asia, 2000: pp. 609-611 (the term maloya can refer not only to music, but to certain dances and the songs that accompany them; probably inherited from the Malagasy and African slave populations; the maloya follows one of three main trends in performance practice; first style recalls the maloya tradition as preserved in rural areas and performed by older musicians; single vocal line with choral response, always sustained by a group of percussionists; dance traditionally accompanies the singing; two subcatagories: the maloya of the \"cult of the dead,\" whose binary rhythms musicians call \"warlike,\" and the \"profane\" maloya, played in \"the cult honoring the ancestors\" (kabar\u00e9s) and characterized by ternary rhythms; second type of maloya relates closely to the first, but modifying the vocal themes with more politically engaging and socially relevant topics; this type appeared at the end of the 1960s; the third stylistic current has appeared in recent years, marked by the inclusion of Western popular-music elements; part of the emerging \"world music\" category, it is refered to as \"electric maloya,\" \"maloya moden\" (meaning \"modern\"), or \"maloya fusion\")", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026919"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026920", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMambos (Music)", "identifiers:lccn": "gf2014026920", "madsrdf:adminMetadata": [{"@id": "_:n7ca19c7943404c0b99d442d169bd655bb1"}, {"@id": "_:n7ca19c7943404c0b99d442d169bd655bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mambos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7ca19c7943404c0b99d442d169bd655bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n7ca19c7943404c0b99d442d169bd655bb5"}, {"@id": "_:n7ca19c7943404c0b99d442d169bd655bb6"}, {"@id": "_:n7ca19c7943404c0b99d442d169bd655bb7"}, {"@id": "_:n7ca19c7943404c0b99d442d169bd655bb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7ca19c7943404c0b99d442d169bd655bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n7ca19c7943404c0b99d442d169bd655bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7ca19c7943404c0b99d442d169bd655bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mambos (Music)"}}, {"@id": "_:n7ca19c7943404c0b99d442d169bd655bb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 96-703588: Al comp\u00e1s del mambo, p1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ca19c7943404c0b99d442d169bd655bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mambo)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ca19c7943404c0b99d442d169bd655bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mambo; an Afro-Cuban dance-music genre, developed by the early 1940s and quickly popularized internationally)"}, "madsrdf:citationSource": "New Harvard dict. of music", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ca19c7943404c0b99d442d169bd655bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mambo)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026920"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026921", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMangue", "identifiers:lccn": "gf2014026921", "madsrdf:adminMetadata": [{"@id": "_:n240afcd11d1642929875013f1e442d7fb1"}, {"@id": "_:n240afcd11d1642929875013f1e442d7fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mangue"}, "madsrdf:elementList": {"@list": [{"@id": "_:n240afcd11d1642929875013f1e442d7fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n240afcd11d1642929875013f1e442d7fb5"}, {"@id": "_:n240afcd11d1642929875013f1e442d7fb6"}, {"@id": "_:n240afcd11d1642929875013f1e442d7fb7"}, {"@id": "_:n240afcd11d1642929875013f1e442d7fb8"}], "madsrdf:hasVariant": [{"@id": "_:n240afcd11d1642929875013f1e442d7fb9"}, {"@id": "_:n240afcd11d1642929875013f1e442d7fb12"}, {"@id": "_:n240afcd11d1642929875013f1e442d7fb15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n240afcd11d1642929875013f1e442d7fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n240afcd11d1642929875013f1e442d7fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-19T16:41:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n240afcd11d1642929875013f1e442d