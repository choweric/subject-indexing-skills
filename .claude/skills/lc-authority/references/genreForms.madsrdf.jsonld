ities/genreForms/gf2011026608"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025302"}]}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:10:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Science fiction television programs"}}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na52ea04042164ee387e58a0240e2ff77b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Star Trek television programs"}}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Star Trek television programs"}}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Science fiction film (Extrapolative film, Future film, Sci-fier, Sci-fi film, SF film))"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Johnson-Smith, J. American sci fi television, 2003.", "madsrdf:citationStatus": "found"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Science fiction: fictional work that relies on some type(s) of advanced technology, scientific development, or encounter with alien life, to make the narrative possible. Stories frequently have a prophetic nature, forecasting how technological changes may impact society in the years to come. The likely future is often seen as dehumanized, dystopian, or post-apocalyptic. May be set on both Earth or in outer space, and (most often) in the future, although sometimes set in the present or past)"}, "madsrdf:citationSource": "Moving image genre-form guide online, August 14, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 85 (Science fiction: use for fictional genre films and programs which revolve around imaginary science and technology, and visions of future society)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "The greatest sci-fi TV of all time, c2011-", "madsrdf:citationStatus": "found"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "The 50s greatest sci-fi shows [VR], c2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Weaver, T. I talked with a zombie : interviews with 23 veterans of horror and sci-fi films and television, c2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Galactic sci-fi TV series revisited, c1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b16", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Star trek--deep space nine. Statistical probabilities, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b17", "@type": "madsrdf:Source", "madsrdf:citationSource": "Snelgrove, K. The sci-fi film & television quiz book, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na52ea04042164ee387e58a0240e2ff77b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sci-fi television programs"}}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sci-fi television programs"}}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na52ea04042164ee387e58a0240e2ff77b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Star Trek television programs"}}, {"@id": "_:na52ea04042164ee387e58a0240e2ff77b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Star Trek television programs"}}], "@id": "/authorities/genreForms/gf2011026558"}
