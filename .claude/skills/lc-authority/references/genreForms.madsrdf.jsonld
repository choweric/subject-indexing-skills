ormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yom Kippur sermons"}}, {"@id": "_:n4d306c04e36e49908dcd418e93f63f01b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Yom Kippur sermons. BT Jewish festival-day sermons)"}, "madsrdf:citationSource": "LCSH, July 15, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d306c04e36e49908dcd418e93f63f01b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Yom Kippur. UF Atonement, Day of; Day of Atonement (Jewish holiday); Jewish Day of Atonement; Yom ha-Kippurim. BT High Holidays)"}, "madsrdf:citationSource": "LCSH, July 15, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d306c04e36e49908dcd418e93f63f01b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(title translates to: Sermon, on the eve of the Day of Atonement 5640 (September 26, 1879) : held in the new synagogue of the Jewish community in Berlin)"}, "madsrdf:citationSource": "Work cat.: Frankl, P. F. Predigt, am Vorabend des Vers\u00f6hnungstages 5640 (26. September 1879) : gehalten in der neuen Synagoge der j\u00fcdischen Gemeinde in Berlin, 1879", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d306c04e36e49908dcd418e93f63f01b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a Yom Kippur sermon; title translates to: The opening ceremony of the Day of Atonement : an abridged word of instruction and reassurance to his religious community)"}, "madsrdf:citationSource": "Aub, J. Die Eingangsfeier des Vers\u00f6hnungstages : Ein abgedrungenes Wort der Belehrung und Beruhigung an seine Religionsgemeinde, 1863", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d306c04e36e49908dcd418e93f63f01b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d306c04e36e49908dcd418e93f63f01b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yom ha-Kippurim sermons"}}, {"@id": "_:n4d306c04e36e49908dcd418e93f63f01b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yom ha-Kippurim sermons"}}, {"@id": "_:n4d306c04e36e49908dcd418e93f63f01b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d306c04e36e49908dcd418e93f63f01b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Day of Atonement sermons"}}, {"@id": "_:n4d306c04e36e49908dcd418e93f63f01b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Day of Atonement sermons"}}], "@id": "/authorities/genreForms/gf2019026111"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026112", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPhilosophical poetry", "identifiers:lccn": "gf2019026112", "madsrdf:adminMetadata": [{"@id": "_:n7b4b6f6fdda04999afbb512244116a04b1"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Philosophical poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7b4b6f6fdda04999afbb512244116a04b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n7b4b6f6fdda04999afbb512244116a04b5"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b6"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b7"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b8"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b9"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b10"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b11"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b12"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry that explores philosophical ideas."}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-04T13:40:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Philosophical poetry"}}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 379-381 (De Rerum Natura, a philosophical masterpiece in verse; perhaps the highlight of classical philosophical poetry, namely De Rerum Natura by the Roman poet Lucretius, a follower of Epicurus; the agenda of philosophy, namely \"What is nature?\")"}, "madsrdf:citationSource": "Teaching philosophy, Sept. 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Narayana Guru. Shorter philosophical poems of Narayana Guru, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(some of the most cherished poems happen to have an unmistakably philosophical character: e.g., Lao Tzu's Tao Te Ching, Lucretius' De Rerum Natura, Dante's Commedia, Goethe's Faust, Milton's Paradise Lost. And some of the profoundest sages happen to have condensed their thought in poetical form, from the earliest Buddhists right up to Emerson and Santayana and Khalil Gibran)"}, "madsrdf:citationSource": "Philosophical poems, via Philosophical Society website, July 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Philosophical poetry is frequently taken to mean poetry that expounds some sort of system, as Lucretius did with Epicureanism--but systematic philosophy is only one kind of philosophy, and didactic poetry is not the only philosophical mode; Most philosophical poets find one form and stick to it. Rumi and Hafiz, for example, produced hundreds of examples of a single verse form, the ghazal)"}, "madsrdf:citationSource": "Majmudar, A. Two philosophical poets, Jan. 10, 2012, via Kenyon review website, viewed July 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xv (a philosophical poem) p. xxvi (... turning of the poetic to philosophical ends) p. xli (poetico-philosophical inquiry into the nature of things)"}, "madsrdf:citationSource": "Work cat.: Pope, A. An essay on man, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(poetry which incorporates philosophical ideas as a theme or explicitly; A philosophical poet is an author or scholar who employs poetic devices, styles, or forms to explore subjects common to the field of philosophy. Their writing often addresses questions related to the meaning of life, the nature of being, theories of knowledge and knowing, principles of beauty, first principles of things or the existence of God. Some may make broad philosophical inquires and engage with diverse philosophical topics throughout their poetry, while others may concentrate within one branch of philosophical poetry)"}, "madsrdf:citationSource": "What is philosophical poetry?, via Quora website, July 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 1035-1036 (under Philosophy and poetry: \"Lucretius (ca. 99-55 BCE), in De rerum natura, established a more genuine hybrid of philosophy and poetry, imbuing his verse with both the content and the logical sequencing of Epicurean philosophical argumentation. Moreover, he intends manifestly to reveal \"the nature of things\" in a philosophical exposition of the natural world ... Lucretius in this way defined the type of 'philosophical poetry' for centuries to come. The late Goethe, in the second part of Faust, e.g., may be thought to reside within this trad. of versified conceptual thought, along with other mod. writers from Erasmus Darwin's natural historical poetry in the 18th c. to P.B. Shelley's and Robert Browning's in the 19th to Wallace Stevens's and Louis Zukofsky's in the 20th; highly spiritual or philosophical poetry is a restricted, elite phenomenon) p. 1038 (Philosophical ideas form only one set of materials among others that the poet may draw on in constructing the poem)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 97-98 (Robert Snukal's exploration of certain key philosophical concepts in selected Yeats poems; two of Yeats's more important themes, the \"rejection of transcendental answers to questions about the nature of experience\" and the belief that \"reality is a human creation\"; melding of Kantian philosophical idealism and the poetic forms of English romanticism)"}, "madsrdf:citationSource": "Modern philology, Aug. 1975:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b4b6f6fdda04999afbb512244116a04b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Snukal, R. High talk : the philosophical poetry of W.B. Yeats, 1973.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026112"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026113", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMuqams", "identifiers:lccn": "gf2019026113", "madsrdf:adminMetadata": [{"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab1"}, {"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Muqams"}, "madsrdf:elementList": {"@list": [{"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab5"}, {"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab6"}], "madsrdf:hasVariant": {"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-18T14:22:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Muqams"}}, {"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (in Cyrillic: 12 u\u012dgurskikh mukamov [in English, would be 12 Uighur mukams (or muqams)]; Mukam Chapbai\ufe20a\ufe21t [the name of one of the 12]) container (performed by the U\u012dgurskogo Ansambli\ufe20a\ufe21 pesni i tant\ufe20s\ufe21a Radio Televidenii\ufe20a\ufe21 Respubliki Kazakhstan [Uighur song and dance ensemble of the Republic of Kazakhstan Radio-Television]"}, "madsrdf:citationSource": "Work cat: Iz sokrovishchnit\ufe20s\ufe21y mirovo\u012d kul\u02b9tury : 12 u\u012dgurskikh mukamov. Vypusk 2, Mukam Chapbai\ufe20a\ufe21t, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pages 996-997 (\"the term muqam as used by the Uygurs refers more to a sequence of pieces than to a mode or modal category. This sequence is comparable to a suite, although the Uygurs do not use that word to describe it. Muqam may also refer to classical Uygur music and its repertoire in general\"; \"every muqam must have an introduction in a free rhythm, followed by a series of other sections subdivided into items that are quite diverse in nature\")"}, "madsrdf:citationSource": "The Garland encyclopedia of world music. V. 6, The Middle East:", "madsrdf:citationStatus": "found"}, {"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mukams"}}, {"@id": "_:nea864d7e586f438ea53f2ca91252ff9ab8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mukams"}}], "@id": "/authorities/genreForms/gf2019026113"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026114", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aElegies (Music)", "identifiers:lccn": "gf2019026114", "madsrdf:adminMetadata": [{"@id": "_:nf5ab7613569d434c936f9d62e4db71aab1"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Elegies (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf5ab7613569d434c936f9d62e4db71aab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026101"}, "madsrdf:hasSource": [{"@id": "_:nf5ab7613569d434c936f9d62e4db71aab5"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab6"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab7"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab8"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab9"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab10"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab11"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab12"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab13"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab14"}], "madsrdf:hasVariant": [{"@id": "_:nf5ab7613569d434c936f9d62e4db71aab15"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-20T08:02:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Elegies (Music)"}}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Elegy (Fr. \u00e9l\u00e9gie; Ger. Elegie). A setting of a poem, or an instrumental piece, lamenting the loss of someone deceased; earliest surviving type of musical elegy is the medieval Planctus; from the 14th century to the 17th two parallel traditions existed for musical elegies: those commemorating patrons (e.g. Isaac's Quis dabit pacem populo timenti? for Lorenzo de' Medici, Coprario's collection Funeral Teares for the Death of the Right Honorable the Earle of Devonshire, 1606); and those mourning the deaths of colleagues and mentors (e.g. Josquin's Nymphes des bois for Ockeghem, Byrd's Ye sacred muses for Tallis, Purcell's What hope for us remains for Matthew Locke; the instrumental elegy can be traced back to the 17th century. Such commemorative instrumental works began regularly to be called elegies only in the 19th century; of special interest are the elegiac works of Stravinsky, particularly those written during his last years in memory of distinguished friends (e.g. Raoul Dufy, Aldous Huxley, John F. Kennedy))"}, "madsrdf:citationSource": "Grove music online, July 22, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Diamond, D. Elegy in memory of Maurice Ravel, 1950.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Starer, R. Elegy for a woman who died too young : a duo for violin and cello, 1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Stravinsky, I. Elegy for J.F.K., \u00a91964.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(elegy (\u00e9l\u00e9gie [Fr.]; elegia [It.]: A song of lament for the dead or for some melancholy event, or an instr. composition with that suggestion, such as Elgar's Elegy for Strings and Faur\u00e9's \u00c9l\u00e9gie; lament: piece of elegiac music expressing grief, specifically music for bagpipes at Scottish clan funerals)"}, "madsrdf:citationSource": "The Oxford dictionary of music, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 221 (elegies; elegiac music)"}, "madsrdf:citationSource": "Decker, T.R. Hymns for the fallen, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Chadwick, G. W. Orchestra music. Selections. Suite symphonique in E-flat ; Aphrodite ; Elegy, \u21171996.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Faur\u00e9, G. Elegy, cello, piano, op. 24. \u00c9l\u00e9gie f\u00fcr Violoncello und Klavier, opus 24, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 62 (musical elegies)"}, "madsrdf:citationSource": "Cudworth, C. Music in eighteenth-century England, 1983:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 33 (Oriana, Henry Noel, Thomas Morley, Sir Philip Sidney, Prince Henry, and many more modest Elizabethans are celebrated with musical elegies)"}, "madsrdf:citationSource": "Kerman, J. The Elizabethan madrigal, 1962:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5ab7613569d434c936f9d62e4db71aab16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Elegiac music"}}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Elegiac music"}}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5ab7613569d434c936f9d62e4db71aab19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Musical elegies"}}, {"@id": "_:nf5ab7613569d434c936f9d62e4db71aab19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musical elegies"}}], "@id": "/authorities/genreForms/gf2019026114"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026116", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStudio recordings", "identifiers:lccn": "gf2019026116", "madsrdf:adminMetadata": [{"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b1"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Studio recordings"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026037"}, "madsrdf:hasSource": [{"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b5"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b6"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b7"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b8"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b9"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Sound recordings made in a controlled studio environment or other venue without a live audience that may use sound engineering techniques not available in a live performance."}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-08-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-20T11:01:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studio recordings"}}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (Recorded at Solid Sound Studio, Inc., Ann Arbor, MI)"}, "madsrdf:citationSource": "Work cat: Bassett, Leslie. Music for piano and piano-violin duo, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The term studio recording means any recording made in a studio, as opposed to a live recording, which is usually made in a concert venue or a theatre, with an audience attending the performance)"}, "madsrdf:citationSource": "Wikipedia, June 17, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (Fritz Wunderlich : complete studio recordings on Deutsche Grammophon)"}, "madsrdf:citationSource": "Fritz Wunderlich, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (Seeing the unseeable : the complete studio recordings of the Flaming Lips, 1986-1990)"}, "madsrdf:citationSource": "Flaming Lips. Seeing the unseeable, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 38 (a studio recording is a distinct entity not bound by the strict limitations of performance--the compilation of discrete performances or activities mixed to create a unique whole); page 37 (the advent of multitrack recording technology in the 1950s permitted the recordist to record separate tracks (a sound or groups of sound) in synchronization, making possible the total studio production in which no live performance in toto takes place. Current sound processing technologies also allow the recordist to vary the basic elements of sound: volume (potentiometer), dynamic range (compressor/limiter) , pitch (harmonizer), timbre and balance (equalizer), duration (technological variation of delay, reverberation, echo, speed), and spatial imaging (including the selection of monaural, binaural, stereophonic, quadriphonic, surround-sound)\")"}, "madsrdf:citationSource": "Journal of communication, 1990:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne42f8e7044e74c7ea135a7df2c35bde3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Victo (The company was established in the late 1980s in Victoriaville, Quebec, Canada, to issue recordings made at the Festival International Musique Actuelle Victoriaville; later it issued studio recordings as well); under Microphone (Live recording in concerts often involves only two microphones (often configured as a 'crossed' pair) for stereophonic imaging, whereas studio recordings of large forces may require each player or small group of players to be equipped with an individual microphone.); under Sokolov, Grigory (The majority of these are taken live from his concerts, since he no longer values the studio recording process.)"}, "madsrdf:citationSource": "Grove music online, viewed Aug. 9, 2019:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026116"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026120", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGlees (Music)", "identifiers:lccn": "gf2019026120", "madsrdf:adminMetadata": [{"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab1"}, {"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Glees (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026984"}, "madsrdf:hasSource": [{"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab5"}, {"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab6"}, {"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab7"}, {"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-20T08:02:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-08-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Glees (Music)"}}, {"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glee; a secular vocal composition for three or more unaccompanied (originally male) voices, in a simply harmonized, homophonic style with an English-language text. It originated in England in the 17th century and was much favored in music clubs in London and elsewhere in the 18th century)"}, "madsrdf:citationSource": "Grove music online, August 13, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Wainwright, R. The favorite glee of Life's a bumper, [between 1811 and 1816]", "madsrdf:citationStatus": "found"}, {"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glee; A type of unaccompanied English partsong composed in the 17th, 18th, and 19th centuries)"}, "madsrdf:citationSource": "Oxford companion to music online, accessed August 13, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb40faff017eb4f1d889c8816a19ee17ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glee (music); a glee is an English type of part song spanning the late baroque, classical and early romantic periods. It is usually scored for at least three voices, and generally intended to be sung unaccompanied. Glees often consist of a number of short, musically contrasted movements and their texts can be convivial, fraternal, idyllic, tender, philosophical or even (occasionally) dramatic)"}, "madsrdf:citationSource": "Wikipedia, August 13, 2019", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026120"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026122", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDeathrock (Music)", "identifiers:lccn": "gf2019026122", "madsrdf:adminMetadata": [{"@id": "_:nc232a6669de24349b7d9d644e55d000bb1"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Deathrock (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc232a6669de24349b7d9d644e55d000bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027025"}, "madsrdf:hasSource": [{"@id": "_:nc232a6669de24349b7d9d644e55d000bb5"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb6"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb7"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb8"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb9"}], "madsrdf:hasVariant": {"@id": "_:nc232a6669de24349b7d9d644e55d000bb10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-08-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-20T11:01:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Deathrock (Music)"}}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kommunity FK is an American post-punk/gothic rock band, formed in 1978, that helped establish what came to be known as the deathrock scene in Los Angeles)"}, "madsrdf:citationSource": [{"@id": "https://en.wikipedia.org/wiki/Kommunity_FK"}, "Wikipedia, viewed Aug. 15, 2019"], "madsrdf:citationStatus": "found"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Deathrock: a brief history, parts I-III, posted 2012 (strictest and least forgiving definition of deathrock would be that it was a dark postpunk phenomenon that lasted from 1979 until 1985, and was primarily local to Los Angeles; in its most expansive sense, deathrock has also become a descriptive label for a style of music generally; first deathrock revival began in 1998 and petered out around 2004; second and ongoing deathrock revival began a few years ago)"}, "madsrdf:citationSource": "Souciant website, June 24, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kommunity FK was created by Patrik Mata in 1978 in the midst of the LA punk explosion. Unknowingly, Patrik's new musical genre became a cross between post punk against a darker gloom that became the genesis of American alter[n]ative/gothic/deathrock.)"}, "madsrdf:citationSource": "Kommunity FK website, viewed Aug. 15, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Kommunity FK) [term not given]"}, "madsrdf:citationSource": "Work cat: The vision and the voice, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Deathrock; rock music subgenre incorporating horror elements and gothic theatrics; emerged from punk rock on the West Coast of the United States in the early 1980s; overlaps with the gothic rock and horror punk genres; despite the similar-sounding name, deathrock has no connection to death metal)"}, "madsrdf:citationSource": [{"@id": "https://en.wikipedia.org/wiki/Deathrock"}, "Wikipedia, June 24, 2019"], "madsrdf:citationStatus": "found"}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc232a6669de24349b7d9d644e55d000bb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Death rock (Music)"}}, {"@id": "_:nc232a6669de24349b7d9d644e55d000bb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Death rock (Music)"}}], "@id": "/authorities/genreForms/gf2019026122"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026123", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnimal poetry", "identifiers:lccn": "gf2019026123", "madsrdf:adminMetadata": [{"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b1"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Animal poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b5"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b6"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b7"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b8"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b9"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b10"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b11"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-20T11:01:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-08-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Animal poetry"}}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "An anthology of animal poetry, 1940.", "madsrdf:citationStatus": "found"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sells, A.L. Animal poetry in French & English literature & the Greek tradition, \u00a91955.", "madsrdf:citationStatus": "found"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "National Geographic book of animal poetry, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "All shy wildness : an anthology of Irish animal poetry, 1984.", "madsrdf:citationStatus": "found"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Tricker, T. The animal poetry of Ted Hughes, 2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Worth, V. Pug and other animal poems, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Jumpety-bumpety hop : a parade of animal poems, \u00a91997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n72641a38fcba4b6d8bbe2c8d6b454bc5b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(contents: Snake = La serpiente -- Turtle = La tortuga -- Heron = La garza -- Crow = El cuervo -- Cat = La gata -- Cow = La vaca -- Dog = El perro -- Fly = La mosca -- Parrot = El loro -- Deer = El venado -- Whale = La ballena -- Owl = Le buho -- Moth = La polilla -- Fish = El pez.)"}, "madsrdf:citationSource": "Work cat.: Paschkis, J. Flutter & hum : animal poems, 2015", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026123"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026125", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aItineraries", "identifiers:lccn": "gf2019026125", "madsrdf:adminMetadata": [{"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb1"}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Itineraries"}, "madsrdf:elementList": {"@list": [{"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026163"}, "madsrdf:hasSource": [{"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb5"}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb6"}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb7"}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb8"}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-20T08:02:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-08-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Itineraries"}}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(itinerary, plural itineraries 1. the route of a journey or tour or the proposed outline of one. 2. a traveler's guidebook. 3. a travel diary)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Aug. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(itineraries. Scope note: Documents outlining a proposed journey. Originally, a list of destinations in the Roman Empire with the distances between them, thought to be measured from the 'Millarium Aureum' or 'Golden Milestone' in the Roman Forum. Hierarchical position: travel documents - <records by form or function> - records (documents) - <documents by function> - document genres - information forms (objects) - Information Forms (hierarchy name))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(itinerary: a detailed plan or route of a trip)"}, "madsrdf:citationSource": "Cambridge dictionary online, Aug. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(itinerary; itineraries; An itinerary is a plan of a trip, including the route and the places that you will visit)"}, "madsrdf:citationSource": "COBUILD advanced English dictionary, via Collins website, Aug. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n68b661dd4d6a49959580c223c83c6a2eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 (Itinerary. Thursday, May 10, 8:30 a.m. EDT: Group arrives via Swissair, Flight #844 ... Take taxicabs to - Roosevelt Hotel. 2:00 p.m.: Orientation meeting with project manager. Friday, May 11, 9:15 am: Assemble in hotel lobby. 9:30 a.m.: Take taxicabs to H. Wolf & Co. Saturday, May 12: Free. Sunday, May 13: Free. ...) pp. 5-13 (gives remainder of itinerary for May 14 through June 8)"}, "madsrdf:citationSource": "Work cat.: German Bookbinding Plant Study. Program and itinerary, 1956:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026125"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026129", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWitch comics", "identifiers:lccn": "gf2019026129", "madsrdf:adminMetadata": [{"@id": "_:n115bcdf8af17474cb273874d19312f0db1"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Witch comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n115bcdf8af17474cb273874d19312f0db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026468"}, "madsrdf:hasSource": [{"@id": "_:n115bcdf8af17474cb273874d19312f0db5"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db6"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db7"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db8"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db9"}], "madsrdf:hasVariant": [{"@id": "_:n115bcdf8af17474cb273874d19312f0db10"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that feature witches and/or warlocks and the practice of witchcraft."}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-20T11:01:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-08-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Witch comics"}}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel containing tales of wonder and witchcraft inspired by folklore from around the world)"}, "madsrdf:citationSource": "The storyteller. Witches, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "publisher's website (collects fifteen original comics about queer witches of color as they master their abilities, discover their traditions, and navigate love as beings with incredible power)"}, "madsrdf:citationSource": "Power & magic : the queer witch comics anthology, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"When their parents leave them in the forest, Hansel and Gretel must find their way home. During their journey, they discover something better--a house made of sugary sweets! Too bad it's owned by an evil, and hungry, old witch.\")"}, "madsrdf:citationSource": "Lemke, D.B. Hansel and Gretel : the graphic novel, \u00a92009", "madsrdf:citationStatus": "found"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"In thirteen-year-old Aster's family, all the girls are raised to be witches, while boys grow up to be shapeshifters. Anyone who dares cross those lines is exiled. Unfortunately for Aster, he still hasn't shifted ... and he's still fascinated by witchery, no matter how forbidden it might be. When a mysterious danger threatens the other boys, Aster knows he can help -- as a witch. It will take the encouragement of a new friend, the non-magical and non-conforming Charlie, to convince Aster to try practicing his skills. And it will require even more courage to save his family ... and be truly himself.\")"}, "madsrdf:citationSource": "Work cat.: Ostertag, M. The witch boy, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"SuperMutant Magic Academy is a prep-school for mutants and witches but their paranormal abilities take a back seat to everyday teen concerns.\")"}, "madsrdf:citationSource": "Tamaki, J. SuperMutant Magic Academy, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n115bcdf8af17474cb273874d19312f0db11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Warlock comics"}}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Warlock comics"}}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n115bcdf8af17474cb273874d19312f0db14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Witchcraft comics"}}, {"@id": "_:n115bcdf8af17474cb273874d19312f0db14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Witchcraft comics"}}], "@id": "/authorities/genreForms/gf2019026129"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026130", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aArchaeological surveys", "identifiers:lccn": "gf2019026130", "madsrdf:adminMetadata": [{"@id": "_:n9309f972f95541e497cf34359150fcebb1"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Archaeological surveys"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9309f972f95541e497cf34359150fcebb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n9309f972f95541e497cf34359150fcebb5"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb6"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb7"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb8"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb9"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb10"}], "madsrdf:hasVariant": [{"@id": "_:n9309f972f95541e497cf34359150fcebb11"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb14"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9309f972f95541e497cf34359150fcebb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-08-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-20T11:01:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Archaeological surveys"}}, {"@id": "_:n9309f972f95541e497cf34359150fcebb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Phillips, P. Archaeological survey in the Lower Mississippi Alluvial Valley, 1940-1947, \u00a92003.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: An archaeological survey of the Gournia landscape, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(archaeological survey: a systematic attempt to locate, identify, and record the distribution, structure, and form of archaeological sites on the ground and in relation to their natural geographic and environmental setting)"}, "madsrdf:citationSource": "Darvill, T. The concise Oxford dictionary of archaeology, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Burton, J.F. This is Minidoka : an archeological survey of Minidoka Internment National Monument, Idaho, 2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mierendorf, R.R. An archeological site survey and evaluation in the Upper Skagit River Valley, Whatcom County, Washington, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under survey design, theory of: archaeological survey is an integral aspect of contemporary archaeological research)"}, "madsrdf:citationSource": "Archaeological method and theory : an encyclopedia, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n9309f972f95541e497cf34359150fcebb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9309f972f95541e497cf34359150fcebb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Archeological surveys"}}, {"@id": "_:n9309f972f95541e497cf34359150fcebb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Archeological surveys"}}, {"@id": "_:n9309f972f95541e497cf34359150fcebb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9309f972f95541e497cf34359150fcebb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surveys, Archaeological"}}, {"@id": "_:n9309f972f95541e497cf34359150fcebb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surveys, Archaeological"}}, {"@id": "_:n9309f972f95541e497cf34359150fcebb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9309f972f95541e497cf34359150fcebb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surveys, Archeological"}}, {"@id": "_:n9309f972f95541e497cf34359150fcebb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surveys, Archeological"}}], "@id": "/authorities/genreForms/gf2019026130"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026133", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n6cbb5348b01843b79025681b1ba875ddb1"}, {"@id": "_:n6cbb5348b01843b79025681b1ba875ddb2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the genre/form term is covered by the genre/form terms {Satirical literature} (DLC)gf2014026525 and {Comedy plays} (DLC)gf2014026264"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6cbb5348b01843b79025681b1ba875ddb3"}]}, "madsrdf:useInstead": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026525"}], "madsrdf:variantLabel": {"@language": "en", "@value": "Satirical drama"}}, {"@id": "_:n6cbb5348b01843b79025681b1ba875ddb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-13T14:01:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n6cbb5348b01843b79025681b1ba875ddb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-08-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n6cbb5348b01843b79025681b1ba875ddb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical drama"}}], "@id": "/authorities/genreForms/gf2019026133"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026136", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aYoga music", "identifiers:lccn": "gf2019026136", "madsrdf:adminMetadata": [{"@id": "_:na47a38f7291644a8878a0b9516a6a683b1"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Yoga music"}, "madsrdf:elementList": {"@list": [{"@id": "_:na47a38f7291644a8878a0b9516a6a683b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasSource": [{"@id": "_:na47a38f7291644a8878a0b9516a6a683b5"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b6"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b7"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b8"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b9"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b10"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b11"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-21T12:35:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yoga music"}}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Music for yoga and meditation, 2013?", "madsrdf:citationStatus": "found"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 47 (Yoga music has been found to be effective in helping people and especially teenagers dealing with stress and mental exertions)"}, "madsrdf:citationSource": "Victor, S.R. Consciousness of yoga in reducing stress among adolescents, in Artha, v. 10, no. 1 (2011), viewed online Oct. 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (very quiet, non-synchronous music (e.g., yoga music))"}, "madsrdf:citationSource": "Foster, C. Exploring the effects of music on exercise intensity, 2012, via Google scholar website, viewed Oct. 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (effects of yoga music on canine stress) p. 3 (music selected for this study was that used during yoga sessions; primarily instrumental)"}, "madsrdf:citationSource": "Boardman, K. Managing canine patients' stress through music therapy. Part one, 2014, via Google scholar website, viewed Oct. 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 50 (yoga music; to help you meditate better, breathe deeper, and hold those positions longer; there is also yoga music for trance dance and yoga flow)"}, "madsrdf:citationSource": "Divjak, N. What is yoga really about, 2012, via Google books, viewed Oct. 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yoga : essential guide to yoga music, 2012?", "madsrdf:citationStatus": "found"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1875 (Although Yoga and Aerobics all need music, the musical frequencies of the two sports are quite different. Yoga music is generally inclined to nature and lyric, and elegant, slow are important features of Yoga music. However, the Aerobics music requires a cheerful rhythm, can greatly stimulate the mood of the people, to provide a good rhythm for Aerobics. The important differences between the two kinds of movement in the music cause the difference of the body movement. In the process of Yoga movement, it needs a soothing music to stretch the body, to guide the movement of the body and mind to reach a consensus based on the psychological ideas)"}, "madsrdf:citationSource": "Zhang, Y. Research on the interactive teaching of yoga and aerobics, in Proceedings of the 2016 4th International Conference on Management Science, Education Technology, Arts, Social Science and Economics (msetasse-16), 2016, via WWW, viewed Oct. 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na47a38f7291644a8878a0b9516a6a683b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Music for yoga. UF Yoga music)"}, "madsrdf:citationSource": "LCSH, Oct. 10, 2019", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026136"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026137", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aParaphrases", "identifiers:lccn": "gf2019026137", "madsrdf:adminMetadata": [{"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb1"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Paraphrases"}, "madsrdf:elementList": {"@list": [{"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026084"}, "madsrdf:hasSource": [{"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb5"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb6"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb7"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb8"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb9"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-21T12:35:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paraphrases"}}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 6 (article title: Peter Comestor, biblical paraphrase, and the medieval popular Bible; Peter produced the Historia as a biblical abridgment and gloss for students at the cathedral school of Notre Dame in Paris ... . Because of its comprehensive assembly of apocryphal and legendary elements, and because of its frequent translation and paraphrase, the Historia was the single most important medium through which a popular Bible took shape, from the thirteenth into the fifteenth century, in France, England, and elsewhere) p. 24 (Comestor and the vernacular paraphrasers indulged a taste for apocrypha and legend and literally rewrote biblical verses) p. 34 (Comestor provided not only the raw materials for biblical paraphrases but also the model of beginning with a heterogeneous Old Testament paraphrase followed by a Gospel harmony)"}, "madsrdf:citationSource": "Speculum, Jan. 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A paraphrase is a retelling of something in your own words. A paraphrase of the Bible is different from a translation in that a translation attempts (to varying degrees) to communicate as \"word-for-word\" or as \"thought-for-thought\" as possible. A paraphrase takes the meaning of a verse or passage of Scripture and attempts to express the meaning in \"plain language\"--essentially the words the author of the paraphrase would use to say the same thing; a paraphrase is what the author thinks the Bible says; should essentially be used as a commentary on the Bible, a way to get another perspective; can be used alongside a Bible translation to give insight into what the Bible means; should not be viewed as the Bible, but rather as an author's idea of what the Bible says and what it means by what it says)"}, "madsrdf:citationSource": "Should I use a paraphrase of the Bible?, via GotQuestions website, Oct. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a biblical paraphrase)"}, "madsrdf:citationSource": "Work cat.: Petrus, Comestor, active 12th century. Historia scholastica, 1170?", "madsrdf:citationStatus": "found"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "paraphrase (noun: 1. A restatement of a text or passage in another form or other words, often to clarify meaning; 2. The restatement of texts in other words as a studying or teaching device; 3. The adaptation or alteration of a text or quotation to serve a different purpose from that of the original)"}, "madsrdf:citationSource": "American Heritage dictionary of the English language online, Dec. 19, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A paraphrase rewords the Bible into plain or modern language. It is the author's interpretation of God's Word, using imagination and literary skill, rather than an actual translation of the biblical text; Translations, on the other hand, seek to convert the original Hebrew, Aramaic, and Greek language text into English (or another language) either by \"word for word\" methods (formal equivalence) or by \"thought for thought\" methods (dynamic equivalence); For some, paraphrases provide a fresh take on well-known texts)"}, "madsrdf:citationSource": "Is it okay to use a paraphrase of the Bible?, via Compelling truth website, Oct. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n44a6c77881bf4ceaab5d0312073a640cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bible--Paraphrases)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026137"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026138", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProletarian fiction", "identifiers:lccn": "gf2019026138", "madsrdf:adminMetadata": [{"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b1"}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Proletarian fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b5"}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b6"}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b7"}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b8"}], "madsrdf:hasVariant": {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that expresses a working-class perspective on social and political issues."}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-21T12:35:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Proletarian fiction"}}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Proletarian Novel (proletarian novels; working-class novels; proletarian fiction; represent the position of workers as the class antagonists of the ruling bourgeoisie; novels designed to express a genuinely working-class perspective on social and political issues; treat issues of social and economic equality; plight of the poor; miserable living conditions of the underclasses; naturalistic descriptions of working-class poverty, rousing calls for working-class political action, utopian visions of a better socialist future; evocation of working-class experience; Tressell's The Ragged Trousered Philanthropists (1914), literary evocation of working-class experience, the single most influential text in British proletarian literature in the 20th century)"}, "madsrdf:citationSource": "Encyclopedia of the novel, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "The Ragged-Trousered Philanthropists (The Ragged-Trousered Philanthropists (1914) is a semi-biographical novel by the Irish house painter and sign writer Robert Noonan, who wrote the book in his spare time under the pen name Robert Tressell; the novel is widely regarded as a classic of working-class literature)"}, "madsrdf:citationSource": "Wikipedia, Oct. 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(proletarian novel: A novel about the working classes and working-class life; perhaps with the intention of making propaganda in pointing out poor economic conditions)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a proletarian novel)"}, "madsrdf:citationSource": "Work cat.: Tressell, R. The ragged trousered philanthropists, 1914", "madsrdf:citationStatus": "found"}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Working-class fiction"}}, {"@id": "_:n76f1a424e7f64b8e84fa1bd76c45e1d3b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Working-class fiction"}}], "@id": "/authorities/genreForms/gf2019026138"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026139", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPornographic fiction", "identifiers:lccn": "gf2019026139", "madsrdf:adminMetadata": [{"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b1"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pornographic fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026320"}, "madsrdf:hasSource": [{"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b5"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b6"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b7"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b8"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b9"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b10"}], "madsrdf:hasVariant": {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pornographic fiction"}}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Fanny Hill (Memoirs of a Woman of Pleasure, popularly known as Fanny Hill; by English novelist John Cleland first published in London in 1748; considered the first original English prose pornography, and the first pornography to use the form of the novel)"}, "madsrdf:citationSource": "Wikipedia, Oct. 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Shearer, M. The great American gay porno novel, \u00a91984.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pornographic novel)"}, "madsrdf:citationSource": "Work cat.: Cleland, John. Memoirs of a woman of pleasure, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pornographic Novel; the first strictly English pornographic novel is usually said to be John Cleland's Memoirs of a Woman of Pleasure, alternatively known as Memoirs of the Life of Fanny Hill and, ultimately, Fanny Hill (1749); pornographic novels are one part of a larger body of pornographic material)"}, "madsrdf:citationSource": "Encyclopedia of the novel, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Nussbaum, C. Understanding pornographic fiction, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Fanny Hill (Fanny Hill, in full Memoirs of Fanny Hill, erotic novel by John Cleland, first published in two volumes in 1748-49 as Memoirs of a Woman of Pleasure; Although elegantly written, the novel was condemned as pornography and was suppressed from its initial publication, almost never being mentioned in literary circles. It was kept in print surreptitiously, however, and for almost two centuries Fanny Hill enjoyed a salacious reputation) Pornography (Pornography, representation of sexual behaviour in books, pictures, statues, motion pictures, and other media that is intended to cause sexual excitement. The distinction between pornography (illicit and condemned material) and erotica (which is broadly tolerated) is largely subjective and reflects changing community standards) Erotica (Erotica, literary or artistic works having an erotic theme; especially, books treating of sexual love in a sensuous or voluptuous manner. The word erotica typically applies to works in which the sexual element is regarded as part of the larger aesthetic aspect. It is usually distinguished from pornography, which can also have literary merit but which is usually understood to have sexual arousal as its main purpose)"}, "madsrdf:citationSource": "Britannica online, Oct. 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Porno fiction"}}, {"@id": "_:n7b69b31d04f94921bdf433219a44c6a7b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Porno fiction"}}], "@id": "/authorities/genreForms/gf2019026139"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026142", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWordless picture books", "identifiers:lccn": "gf2019026142", "madsrdf:adminMetadata": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b1"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Wordless picture books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026096"}, "madsrdf:hasSource": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b5"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b6"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b7"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b8"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b9"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b10"}], "madsrdf:hasVariant": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b11"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b14"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b17"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b20"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b23"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b26"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b29"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b32"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b35"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-21T12:35:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wordless picture books"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xiv (the wordless picture book genre) p. xvii (wordless storybooks) p. 311 (stories without words)"}, "madsrdf:citationSource": "Martin, W.P. Wonderfully wordless : the 500 most recommended graphic novels and picture books, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (wordless picturebooks have become a sub-genre unto themselves--a publishing trend resulting in author/illustrators who even specialize in this type of book; wordless books; picturebooks without words; while wordless picturebooks are excellent ways to introduce preschoolers to the book's format and design and to book handling and sequencing of a story, the wordless picturebook is no longer just for beginning readers) p. 4 (wordless stories)"}, "madsrdf:citationSource": "Children and libraries, summer 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Stories without words. UF Picture story books; Story picture books; Visual story books; Wordless picture books; Wordless story books. BT Narrative art. BT Picture books)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Tuten-Puckett, K.E. Using wordless picture books, 1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sharing wordless books is a terrific way to build important literacy skills, including listening skills, vocabulary, comprehension and an increased awareness of how stories are structured. And children love them--they can really pore over the pictures and create their own story in their own words. Wordless books can also be used in ELL classrooms and with struggling readers.)"}, "madsrdf:citationSource": "Our favorite wordless picture books, via Reading Rockets website, Oct. 22, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "jacket (Mr. Goodall's wordless picture books)"}, "madsrdf:citationSource": "Work cat.: Goodall, John S. Little Red Riding Hood, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Picture books without words"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picture books without words"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wordless picturebooks"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wordless picturebooks"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Story books, Wordless"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Story books, Wordless"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories without words"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories without words"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wordless story books"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wordless story books"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wordless storybooks"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wordless storybooks"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wordless stories"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wordless stories"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Storybooks, Wordless"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Storybooks, Wordless"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wordless books"}}, {"@id": "_:n9fdf43b939ea41afa0c07532935a15d5b36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wordless books"}}], "@id": "/authorities/genreForms/gf2019026142"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026143", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPanchatantra stories", "identifiers:lccn": "gf2019026143", "madsrdf:adminMetadata": [{"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb1"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Panchatantra stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026327"}, "madsrdf:hasSource": [{"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb5"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb6"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb7"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb8"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb9"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb10"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb11"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb12"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb13"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb14"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb15"}], "madsrdf:hasVariant": [{"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb16"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb19"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb22"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Paraphrases of Panchatantra texts in story form."}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-18T14:22:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Panchatantra stories"}}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (retold by Esther Mary Lyons)"}, "madsrdf:citationSource": "Lyons, Esther M. Stories from the Panchatantra, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Pa\u00f1catantirak kataika\u1e37 = Panchatantra stories for kids, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Panchatantra, (Sanskrit: \"Five Treatises\" or \"Five Chapters\") also spelled Pancatantra, collection of Indian animal fables, which has had extensive circulation both in the country of its origin and throughout the world. In Europe the work was known under the name The Fables of Bidpai (for the narrator, an Indian sage, Bidpai, called Vidyapati in Sanskrit), and one version reached the West as early as the 11th century; In theory, the Panchatantra is intended as a textbook of niti (\"policy,\" especially for kings and statesmen; The original text is a mixture of Sanskrit prose and stanzas of verse, with the stories contained within one of the five frame stories)"}, "madsrdf:citationSource": "Britannica online, Oct. 23, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: 101 Panchatantra stories; 365 Panchatantra stories; 5 min Panchatantra stories; The musical donkey and other Panchatantra stories; Pa\u00f1catantra kathega\u1e37u = Panchatantra stories)"}, "madsrdf:citationSource": "OCLC, Oct. 23, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (retold by Bani Roy Chowdhary)"}, "madsrdf:citationSource": "Roy Choudhury, Bani. Stories from Panchatantra, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Panchatantra stories are the oldest surviving fables from Ancient India. These colourful stories from the Panchatantra have spread all over the world for centuries, especially as bedtime stories for kids. We present here, a list of our versions of 60 such popular short stories from the Panchatantra, in English. Although dividing the Panchatantra into individual stories takes off the essence of its nested interludes, the following short stories include pictures and moral messages, especially for kids.\")"}, "madsrdf:citationSource": "Panchatantra short stories in English with pictures, via Tales of Panchatantra website, Oct. 23, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(title translates as: Panchatantra, exciting stories; children's version of stories from Panchatantra)"}, "madsrdf:citationSource": "Work cat.: Pa\u00f1catantra, rom\u0101\u00f1caka kah\u0101niy\u0101m\u0310, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (retold in Tamil by P.S. Aacharya)"}, "madsrdf:citationSource": "\u0100cc\u0101ry\u0101, Pi. Es. Pa\u00f1catantirak kataikal!, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(title translates as: Panchatantra, well-known stories; children's version of stories from Panchatantra)"}, "madsrdf:citationSource": "Work cat.: Pa\u00f1catantra, j\u0101n\u012b m\u0101n\u012b kah\u0101niy\u0101m\u0310, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jain version of Pa\u00f1catantra by P\u016br\u1e47abhadras\u016bri) t.p. (Pa\u00f1c\u0101khy\u0101na)"}, "madsrdf:citationSource": "Panchatantra. Pa\u00f1catantram, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Venkataraman, Rama. The blue jackal and other Panchatantra stories, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pa\u00f1catantram stories"}}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pa\u00f1catantram stories"}}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pa\u00f1catantra stories"}}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pa\u00f1catantra stories"}}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pa\u00f1c\u0101khy\u0101na stories"}}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pa\u00f1c\u0101khy\u0101na stories"}}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pa\u00f1catantirak stories"}}, {"@id": "_:nbf8bed266f154dc5ba5a8cbac842cf7fb26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pa\u00f1catantirak stories"}}], "@id": "/authorities/genreForms/gf2019026143"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026144", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBath books", "identifiers:lccn": "gf2019026144", "madsrdf:adminMetadata": [{"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b1"}, {"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bath books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026197"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026096"}], "madsrdf:hasSource": [{"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b5"}, {"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b6"}, {"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/caoonl"}, "ri:recordStatus": "new"}, {"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-18T14:22:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bath books"}}, {"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(title translation: Count to five in the woods; it is a bath book used by children to learn to count)"}, "madsrdf:citationSource": "Work cat: Dupuis, K. Compte jusqu'\u00e0 5 dans les bois, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "search (Bath books - \"children's books intended for use in the bath, with plastic or vinyl waterproof leaves, often filled with foam sponge so that they float; usually pictures predominate over text\")"}, "madsrdf:citationSource": "Art & Architecture Thesaurus online, October 29, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2109f334e4204bee9613b7d4b932e7d4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "search (Bath book - \"a waterproof book for children that can be read in the bath\")"}, "madsrdf:citationSource": "Yourdictionary.com website, October 29, 2019:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026144"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026150", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCommunity newspapers", "identifiers:lccn": "gf2019026150", "madsrdf:adminMetadata": [{"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b1"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Community newspapers"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026132"}, "madsrdf:hasSource": [{"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b5"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b6"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b7"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b8"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b9"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b10"}], "madsrdf:hasVariant": [{"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b11"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Newspapers that cover the issues that affect a cohesive geographic, ethnic, cultural, educational, etc., community."}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-11-13T13:46:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Community newspapers"}}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Capitol Hill times, Nov. 18, 1959.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Serving Capitol Hill since 1926; Capitol Hill-focused articles; local journalism dedicated to your neighborhood; Capitol Hill reporting)"}, "madsrdf:citationSource": "With fewer Capitol Hill stories, Capitol Hill times still printing, via Capitol Hill Seattle blog, posted May 14, 2018, viewed Nov. 19, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Capitol Hill Times; newspaper; The Capitol Hill Times is a community weekly that has covered Seattle's most vibrant and eclectic neighborhood since 1926)"}, "madsrdf:citationSource": "Muck Rack website, Nov. 19, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Community newspapers. UF Neighborhood newspapers; Suburban newspapers. SN Use for local newspapers published for a particular neighborhood within a city or county jurisdiction."}, "madsrdf:citationSource": "University of Washington newspaper genre list, via WWW, Nov. 19, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Get started > Lesson 1 (According to the traditional definition, a community newspaper is a small daily or non-daily with less than 15,000 in circulation. But in the digital age, that definition is becoming outdated, as more and more readers get their news from digital sources. Therefore, in the book, we defined a community newspaper as any news organization whose primary mission is to cover the important issues that affect a cohesive and well-defined geographic, ethnic or cultural community. A community newspaper can have a circulation of a few thousand readers or nearly a hundred thousand. What is important is not the size; rather, it is the mission of the newspaper. Under this new definition, when we speak about \"community newspapers\" we are talking about small and midsize dailies, non-dailies, and ethnic newspapers)"}, "madsrdf:citationSource": "Saving community journalism website, Nov. 19, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(early community newspapers were generally non-daily publications serving a small community. Over the years, as markets, technologies and business models changed, distinguishing community newspapers based on frequency or circulation was no longer appropriate; today, the distinguishing characteristic of a community newspaper is its commitment to serving the information needs of a particular community. The community is defined by the community's members and a shared sense of belonging. A community may be geographic, political, social or religious. A community newspaper may be published once a week or daily. Some community newspapers exist only in cyberspace. Any newspaper that defines itself as committed to serving a particular community many be defined as a \"community newspaper\")"}, "madsrdf:citationSource": "About community newspapers, via National Newspapers Association website, Nov. 19, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Neighborhood newspapers"}}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Neighborhood newspapers"}}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suburban newspapers"}}, {"@id": "_:n3ba72ac8ab5446949aca8beccb8f8832b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suburban newspapers"}}], "@id": "/authorities/genreForms/gf2019026150"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026152", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBawdy fiction", "identifiers:lccn": "gf2019026152", "madsrdf:adminMetadata": [{"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b1"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bawdy fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026377"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026320"}, "madsrdf:hasSource": [{"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b5"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b6"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b7"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b8"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b9"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b10"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b11"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b12"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b13"}], "madsrdf:hasVariant": {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b14"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Humorous fiction that is sexually indecent, coarse, or lewd."}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-07-19T15:02:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bawdy fiction"}}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 219 (bawdy fiction)"}, "madsrdf:citationSource": "A companion to the eighteenth-century English novel and culture, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 507 (Sterne's ribald fiction)"}, "madsrdf:citationSource": "The secrets of generation, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 152 (Sterne's \"ill example\" and his bawdy fiction)"}, "madsrdf:citationSource": "Studies in the novel, summer 1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a bawdy novel; summary: The life of an old man who lives for sex. He is Morris Sabbath, 64, a New York puppeteer who made his name with lewd performances. Feeling death approaching, he relives his many amorous adventures in graphic detail.)"}, "madsrdf:citationSource": "Work cat.: Roth, P. Sabbath's theater, 1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 174 (\"Jong reverted in her third novel, Fanny (1980), to a setting based on her literary knowledge of the eighteenth century and satirized notoriously bawdy novels by famous men\")"}, "madsrdf:citationSource": "Tulsa studies in women's literature, spring 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 413 (\"I distinguish my subject, which is often called 'hard core pornography,' from merely erotic or bawdy literature. The latter, including tales by Chaucer, Rabelais, or Boccacio ... are robust, often sexually explicity and/or sensual, but they are not ordinarily sexually stimulating ... Their focus is only incidentally upon profane acts. More central to bawdy fiction is the creative exuberance that lurks beneath the surface of polite manners and often erupts with embarrassing consequences ... bawdy literature displays the lucid innocence of the child; its impulse is mainly boisterous\")"}, "madsrdf:citationSource": "Quarterly journal of speech, Dec. 1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 8 (bawdy novels such as Tom Jones)"}, "madsrdf:citationSource": "Stevens, J.D. Sensationalism and the New York press, \u00a91991:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"It's the most deliciously dirty novel ever written by an American ... If I were to make a list of the greatest literary filth, a canon of high porn, it would include: The Satyricon; Boccaccio at his bawdy best; Rochester's erotic poems; Cleland's Fanny Hill; Constance Chatterley and her constantly chatty gamekeeper; Nabokov's Confessions of a White Widowed Male; Portnoy and Sabbath, Erica Jong's first three novels; a book or two by Samuel Delany; White's The Beautiful Room is Empty; pretty much anything by Genet\")"}, "madsrdf:citationSource": "Oard, B.A. Sabbath's theater by Philip Roth, via Mindful pleasures blog, posted April 14, 2009, viewed on Nov. 19, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bawdy, adjective: A bawdy story or joke contains humorous references to sex.)"}, "madsrdf:citationSource": "COBUILD advanced English dictionary, via Collins dictionary website, Apr. 22, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ribald fiction"}}, {"@id": "_:n8391d1e5df524d3d9ed4b55b5a138cc6b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ribald fiction"}}], "@id": "/authorities/genreForms/gf2019026152"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026154", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlternative histories (Comics)", "identifiers:lccn": "gf2019026154", "madsrdf:adminMetadata": [{"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b1"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Alternative histories (Comics)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b5"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b6"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b7"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b8"}], "madsrdf:hasVariant": [{"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b9"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b12"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b15"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b18"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b21"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional comics in which the plot or setting assumes an alternative outcome of an historical event. For nonfiction that presents alternative outcomes of historical events and subsequent changes in history see [Counterfactual histories.]"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-18T14:22:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative histories (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an alternative history graphic novel; summary: In a famous and well-known episode, Jorge Luis Borges resigned from his position in a municipal library after being appointed to the position of \"Inspector Municipal de Aves y Conejos.\" Nine's graphic novel, \"Borges, Bird Inspector,\" takes this fact as a starting point to wonder what would have happened to the writer having accepted his new destiny)"}, "madsrdf:citationSource": "Work cat.: Nine, L. Borges, inspector de aves, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Grandville is a Hugo Award nominated British graphic novel series written and drawn by Bryan Talbot. It is a mixture of the steampunk, alternative history and thriller genres. It is set in a world in which France won the Napoleonic Wars and invaded Britain)"}, "madsrdf:citationSource": "Wikipedia, Nov. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternate history or alternative history (Commonwealth English) (AH) is a genre of speculative fiction consisting of stories in which one or more historical events occur differently. These stories usually contain \"what if\" scenarios at crucial points in history and present outcomes other than those in the historical record; another term occasionally used for the genre is \"allohistory\"; in Spanish, French, German, Portuguese, Italian, Catalan and Galician, the genre of alternate history is called uchronie / ucronia / ucron\u00eda / Uchronie, which has given rise to the term uchronia in English) List of alternate history fiction (comics listed include: Captain Confederacy by Will Shetterly and Vince Stone; Astro City by Kurt Busiek et al.; Ministry of Space by Warren Ellis; Shin Konpeki no Kantai (New Deep Blue Fleet) by Yoshio Aramaki; Ex Machina by Brian K. Vaughan; General Leonardo by Erik Svane and Dan Greenberg; Roswell, Texas by L. Neil Smith and Rex F. May; Grandville, by Bryan Talbot; Storming Paradise, by Chuck Dixon) Category:Alternate history comics (Comics using the genre of alternate history. A child of historical fiction and speculative fiction, the stories deal with the outcome of a point of divergence in real-world history)"}, "madsrdf:citationSource": "Wikipedia, Nov. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(alternative history graphic novel)"}, "madsrdf:citationSource": "Talbot, B. Grandville, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "What ifs (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "What ifs (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Uchronias (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Uchronias (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Allohistories (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Allohistories (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternate histories (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternate histories (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternative realities (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative realities (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Histories, Alternative (Comics)"}}, {"@id": "_:n8f47db5737cb450180df00b6e4ab6e70b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Histories, Alternative (Comics)"}}], "@id": "/authorities/genreForms/gf2019026154"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026155", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlternative histories (Drama)", "identifiers:lccn": "gf2019026155", "madsrdf:adminMetadata": [{"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab1"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Alternative histories (Drama)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab5"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab6"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab7"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab8"}], "madsrdf:hasVariant": [{"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab9"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab12"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab15"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab18"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab21"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional plays in which the plot or setting assumes an alternative outcome of an historical event. For nonfiction that presents alternative outcomes of historical events and subsequent changes in history see [Counterfactual histories.]"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-18T14:22:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative histories (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Peace in Our Time is a two-act play written in 1946 by No\u00ebl Coward. It focuses on a small group of Londoners in a pub close to Sloane Square, the characters living in a dark, stressful situation in which Nazi Germany won the Battle of Britain and successfully invaded and occupied the United Kingdom. The work of alternative history was first performed at the Lyric Theatre in London in 1947)"}, "madsrdf:citationSource": "Wikipedia, Nov. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternate history or alternative history (Commonwealth English) (AH) is a genre of speculative fiction consisting of stories in which one or more historical events occur differently. These stories usually contain \"what if\" scenarios at crucial points in history and present outcomes other than those in the historical record; another term occasionally used for the genre is \"allohistory\"; in Spanish, French, German, Portuguese, Italian, Catalan and Galician, the genre of alternate history is called uchronie / ucronia / ucron\u00eda / Uchronie, which has given rise to the term uchronia in English) List of alternate history fiction (plays listed: Peace in Our Time by No\u00ebl Coward; The Madagascar Plan by Brian Borowka; The Adventures of Stoke Mandeville, Astronaut and Gentleman by Fraser Charlton and Nikolas Lloyd; Picasso's Closet by Ariel Dorfman; Universal Robots by Mac Rogers)"}, "madsrdf:citationSource": "Wikipedia, Nov. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a play) p. 4 (a \"what if\" scenario) p. 4 of cover (Anne Frank has survived the war, and at age 25, she's ready to start a new chapter in New York City)"}, "madsrdf:citationSource": "Work cat.: Sobler, Alix. The secret annex, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: An alternate history play set in London and based on the idea that Germany won the Battle of Britain and occupied England)"}, "madsrdf:citationSource": "Coward, Noel. Peace in our time : a play in two acts and eight scenes, 1948", "madsrdf:citationStatus": "found"}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Uchronias (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Uchronias (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternative realities (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative realities (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternate histories (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternate histories (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Allohistories (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Allohistories (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "What ifs (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "What ifs (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Histories, Alternative (Drama)"}}, {"@id": "_:n2158c6b1b6ef4cb48071c989b9882e0ab25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Histories, Alternative (Drama)"}}], "@id": "/authorities/genreForms/gf2019026155"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026156", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlternative histories (Motion pictures)", "identifiers:lccn": "gf2019026156", "madsrdf:adminMetadata": [{"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b1"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Alternative histories (Motion pictures)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026250"}, "madsrdf:hasSource": [{"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b5"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b6"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b7"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b8"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b9"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b10"}], "madsrdf:hasVariant": [{"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b11"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b14"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b17"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b20"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional films in which the plot or setting assumes an alternative outcome of an historical event. For nonfiction that presents alternative outcomes of historical events and subsequent changes in history see [Counterfactual histories.]"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-18T14:22:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative histories (Motion pictures)"}}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternate history or alternative history (Commonwealth English) (AH) is a genre of speculative fiction consisting of stories in which one or more historical events occur differently. These stories usually contain \"what if\" scenarios at crucial points in history and present outcomes other than those in the historical record; another term occasionally used for the genre is \"allohistory\"; in Spanish, French, German, Portuguese, Italian, Catalan and Galician, the genre of alternate history is called uchronie / ucronia / ucron\u00eda / Uchronie, which has given rise to the term uchronia in English)"}, "madsrdf:citationSource": "Wikipedia, Nov. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an alternate history is the description or discussion of an historical \"what if\", most likely with some speculation about the consequences of a different result; other names that may apply to the genre include alternative history, allohistory, counterfactuals, if-worlds, uchronia and uchronie, parallel worlds, what-if stories, abwegige geschichten, etc.; alternate history involves one or more past events that \"happened otherwise\" and usually includes some amount of description of the subsequent effects on history; alternate history may appear in novels, short stories, scholarly essays, comic books, movies, television shows, plays and elsewhere)"}, "madsrdf:citationSource": "What is alternate history?, via Uchronia website, Nov. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(uchronia: a work of alternate history; uchronian, adj., uchronic, adj.)"}, "madsrdf:citationSource": "The Oxford dictionary of science fiction, 2006, via Oxford reference, viewed on Nov. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "List of alternate history fiction (films listed include: Went the Day Well?: Nazi paratroopers take over an English village; The Magic Face: Hitler is killed by his valet Rudi Janus and takes his place during World War II; It Happened Here: Nazi Germany successfully invades and occupies the United Kingdom during World War II; Fatherland: based on the 1992 novel about an Axis victory in World War II; Six-String Samurai: the USSR launched several nuclear warheads at the U.S. in 1957, reducing most of the United States to an inhospitable desert; Timequest: a man travels through time to prevent the assassination of John F. Kennedy; 2009 Lost Memories: the Korean peninsula is still a part of the Japanese empire, as Ito Hirobumi was never assassinated, and the Empire of Japan sides with the Allies against Nazi Germany; C.S.A.: The Confederate States of America: the Confederate States won the American Civil War, annexed the United States, and still maintain slavery in the year 2004; Watchmen: Richard Nixon remains President in 1985, years after the USA definitively won the Vietnam War; Inglourious Basterds: a group of Jewish-American soldiers manage to assassinate Hitler)"}, "madsrdf:citationSource": "Wikipedia, Nov. 20, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Inglourious Basterds is a 2009 black comedy and revisionist war film written and directed by Quentin Tarantino; The film tells an alternate history story of two plots to assassinate Nazi Germany's leadership, one planned by Shosanna Dreyfus, a young French Jewish cinema proprietor and the other by a team of Jewish American soldiers led by First Lieutenant Aldo Raine)"}, "madsrdf:citationSource": "Wikipedia, Nov. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an alternative history film)"}, "madsrdf:citationSource": "Work cat.: Inglourious basterds (Motion picture). Inglourious basterds, \u00a92009", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternate histories (Motion pictures)"}}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternate histories (Motion pictures)"}}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Allohistories (Motion pictures)"}}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Allohistories (Motion pictures)"}}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Uchronias (Motion pictures)"}}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Uchronias (Motion pictures)"}}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "What-ifs (Motion pictures)"}}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "What-ifs (Motion pictures)"}}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Histories, Alternative (Motion pictures)"}}, {"@id": "_:n4fa0226dc6634158bbb3b79a51a211c0b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Histories, Alternative (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2019026156"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026158", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSka punk (Music)", "identifiers:lccn": "gf2019026158", "madsrdf:adminMetadata": [{"@id": "_:n52808c198dba418f827a78080084757fb1"}, {"@id": "_:n52808c198dba418f827a78080084757fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ska punk (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n52808c198dba418f827a78080084757fb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027025"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027095"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026159"}, "madsrdf:hasSource": [{"@id": "_:n52808c198dba418f827a78080084757fb5"}, {"@id": "_:n52808c198dba418f827a78080084757fb6"}, {"@id": "_:n52808c198dba418f827a78080084757fb7"}, {"@id": "_:n52808c198dba418f827a78080084757fb8"}, {"@id": "_:n52808c198dba418f827a78080084757fb9"}, {"@id": "_:n52808c198dba418f827a78080084757fb10"}, {"@id": "_:n52808c198dba418f827a78080084757fb11"}, {"@id": "_:n52808c198dba418f827a78080084757fb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n52808c198dba418f827a78080084757fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n52808c198dba418f827a78080084757fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n52808c198dba418f827a78080084757fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ska punk (Music)"}}, {"@id": "_:n52808c198dba418f827a78080084757fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Third wave: Ska across the Atlantic: Punk bands in particular absorbed ska influences, fusing the two genres for a new style known as ska punk music. Most American third wave ska music is quite far removed from the original Jamaican ska, instead favouring punchy guitar riffs and other hallmarks of punk rock. The mid-nineties saw ska punk explode in popularity, with artists such as No Doubt, Sublime, Reel Big Fish, and The Mighty Mighty Bosstones receiving mainstream attention and even appearing on the Billboard 200. This is the ska music you'll most likely find on modern playlists)"}, "madsrdf:citationSource": "An introduction to ska music, via Musical U website, Oct 30, 2017, viewed on Nov. 21, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n52808c198dba418f827a78080084757fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a ska punk album)"}, "madsrdf:citationSource": "Work cat.: Mighty Mighty Bosstones (Musical group). Let's face it, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n52808c198dba418f827a78080084757fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ska-punk: A style of music combining ska and punk rock)"}, "madsrdf:citationSource": "yourdictionary.com, viewed Nov. 21, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n52808c198dba418f827a78080084757fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Combining elements of ska music and hardcore punk rock, ska punk first became popular in the late 1970s and was started in the UK. Featuring faster tempos, distorted guitars, spunky instrumentation and a cleaner sound than punk, ska punk first rose to prominence in the 2 Tone movement; ska punk bands No Doubt, The Specials, Operation Ivy, Streetlight Manifesto, Reel Big Fish, Less Than Jake and The Mighty Mighty Bosstones are among the best not only within their genre, but are also considered some of the greatest bands of all time)"}, "madsrdf:citationSource": "The best ska punk bands of all time, via Ranker website, viewed Nov. 21, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n52808c198dba418f827a78080084757fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Pop/Rock > Alternative/Indie Rock > Ska-Punk (Most of the Third Wave of Ska Revival was based on Ska-Punk, a hybrid that took the 2-Tone movement of the early '80s as its starting point, and added the velocity and volume of hardcore punk for good measure. Throughout the late '80s, ska-punk was an underground phenomenon, with Fishbone being the only one of its practitioners to earn significant exposure. By the mid-'90s, ska-punk bands like Rancid had broken through into the alternative audience, and the Third Wave of Ska Revival--which also included bands that leaned more toward metal than ska--was on its way to becoming part of the mainstream)"}, "madsrdf:citationSource": "AllMusic website, Nov. 21, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n52808c198dba418f827a78080084757fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ska punk is a fusion music genre that combines ska and punk rock; Ska-core (sometimes spelled skacore) is a subgenre of ska punk, blending ska with hardcore punk; the characteristics of ska punk vary, due to the fusion of contrasting genres. The more punk-influenced style often features faster tempos, guitar distortion, onbeat punk rock-style interludes (usually the chorus), and punk-style vocals. The more ska-influenced style of ska punk features a more developed instrumentation and a cleaner vocal and musical sound. The common instrumentation includes electric guitar, bass guitar, drums, brass instruments (such as trombones or trumpets), saxophones, and sometimes an organ; the genre was given birth by 80's ska-punk band Operation Ivy. Many bands were influenced by Operation Ivy and began paying the genre with their own twist. The more popular early Ska-Punk bands consisted of Less Than Jake, Rancid, The Mighty Mighty Bosstones, and Goldfinger)"}, "madsrdf:citationSource": "Ska punk music, via Last.fm website, Nov. 21, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n52808c198dba418f827a78080084757fb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Let's Face It is the fifth studio album by The Mighty Mighty Bosstones; genre: Ska punk; one of the greatest ska-punk albums to come out of the nineties)"}, "madsrdf:citationSource": "Wikipedia, Nov. 21, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n52808c198dba418f827a78080084757fb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ska punk (also spelled ska-punk) is a fusion genre that mixes ska music and punk rock music together. Ska-core (sometimes spelled skacore) is a subgenre of ska punk that mixes ska with hardcore punk. Early ska punk mixed both 2 Tone and ska with hardcore punk. Ska punk tends to feature brass instruments, especially horns such as saxophones, trombones and trumpets, making the genre distinct from other forms of punk rock. It is closely tied to third wave ska which reached its zenith in the mid 1990s)"}, "madsrdf:citationSource": "Wikipedia, Nov. 21, 2019", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026158"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026159", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSka-core (Music)", "identifiers:lccn": "gf2019026159", "madsrdf:adminMetadata": [{"@id": "_:n7301f7f3aa384597baeefc99773395e5b1"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ska-core (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7301f7f3aa384597baeefc99773395e5b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026850"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026158"}], "madsrdf:hasSource": [{"@id": "_:n7301f7f3aa384597baeefc99773395e5b5"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b6"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b7"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b8"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b9"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b10"}], "madsrdf:hasVariant": {"@id": "_:n7301f7f3aa384597baeefc99773395e5b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ska-core (Music)"}}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "( Ska-core is either hardcore/punk-influenced ska or ska-influenced hardcore music; Compared to traditional ska, ska-core is faster and harder. Voodoo Glow Skulls and Operation Ivy are commonly called ska-core bands. At some points, the Mighty Mighty Bosstones have claimed to play ska-core. Some claim that ska-core songs change rythmic structure from ska-like to hardcore-like within one song. This could be differentiated from ska-influenced punk. Others point out that ska-core bands may have a rock-like lineup, without horns)"}, "madsrdf:citationSource": "What is ska-core?, via stason.org website, Nov. 21, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mix of Ska and Hardcore punk, first seen on the Mighty Mighty Bosstones album \"Ska-core The Devil And More\". Bands from all over the world, most notably the US and UK, have contributed to the genre. Skacore is a much more aggressive version of Ska-Punk with thrashcore and metal trimmings. . Some of the earliest pioneers of the genre include Against All Authority, Voodoo Glow Skulls, and Link 80)"}, "madsrdf:citationSource": "Skacore music, via Last.fm website, Nov. 21, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "The Mighty Mighty Bosstones (often credited as one of the progenitors of the genre of ska punk and the creators of its subgenre ska-core, which mixes elements of ska with punk rock and hardcore) Ska-Core, the Devil, and More (an EP by The Mighty Mighty Bosstones first released in 1993; genre: Ska-core, 2 Tone, hardcore)"}, "madsrdf:citationSource": "Wikipedia, Nov. 21, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ska punk (Ska-core (sometimes spelled skacore) is a subgenre of ska punk that mixes ska with hardcore punk)"}, "madsrdf:citationSource": "Wikipedia, Nov. 21, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a ska-core album)"}, "madsrdf:citationSource": "Work cat.: Mighty Mighty Bosstones (Musical group). Ska-core, the devil and more, \u21171993", "madsrdf:citationStatus": "found"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "( the Boston band's contribution to musical history: Ska-core; Skacore)"}, "madsrdf:citationSource": "Burnsilver, G. How Mighty Mighty Bosstones created ska-core, in Phoenix new times, Dec. 16, 2014, viewed online Nov. 21, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7301f7f3aa384597baeefc99773395e5b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Skacore (Music)"}}, {"@id": "_:n7301f7f3aa384597baeefc99773395e5b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skacore (Music)"}}], "@id": "/authorities/genreForms/gf2019026159"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026160", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDrames \u00e0 clef (Television programs)", "identifiers:lccn": "gf2019026160", "madsrdf:adminMetadata": [{"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b1"}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Drames \u00e0 clef (Television programs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b3"}]}, "madsrdf:exampleNote": "Note under [Biographical television programs]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026252"}, "madsrdf:hasSource": [{"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b5"}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b6"}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b7"}], "madsrdf:hasVariant": [{"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b8"}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b11"}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional television programs in which real persons, places, or events are depicted under invented names. For television programs that depict the lives of real people see [Biographical television programs.]"}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-25T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drames \u00e0 clef (Television programs)"}}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Roman \u00e0 Clef: A fictional account of Real Life events, loaded with Captain Ersatzes of real people. These are often autobiographical or Ripped from the Headlines. These differ from Inspired by... and Very Loosely Based on a True Story in that the story is not dramatized, merely retold with different proper nouns; Television examples: Entourage is based on Mark Wahlberg's meteoric rise to fame and notoriety; The characters of Ron and Mark on Parks and Recreation are loosely based on real people whom the creators met while researching the show; The BBC adaptation of novelist/university lecturer Malcolm Bradbury's The History Man; The Empress of China covers Tang Taizong's expedition to Goguryeo using this method, by changing the names of the Korean places and persons involved)"}, "madsrdf:citationSource": "TV tropes website, Nov. 25, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 75 (Peter Flannery's 1990s political epic Our Friends in the North; drew much of its authority from a close shadowing of documented events, most notably the local government housing scandals in the north-east during the 1960s involving the politician T. Dan Smith, the architect John Poulson and the Tory cabinet minister Reginald Maudling. With these and several other characters modelled on real-life figures ... this was a saga partly readable as the televisual equivalent of a political roman a clef.)"}, "madsrdf:citationSource": "Frames and fictions on television, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A television drame \u00e0 clef about a woman who started a comedy club (\"yose\") in late Meije-era. Based on the true story of Yoshimoto Sei, the founder of Yoshimoto K\u014dgy\u014d; Originally broadcast on NHK as a television mini-series from October, 2017 to March, 2018)"}, "madsrdf:citationSource": "Work cat.: Warotenka, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television drames \u00e0 clef"}}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television drames \u00e0 clef"}}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romans \u00e0 clef (Television programs)"}}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romans \u00e0 clef (Television programs)"}}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television romans \u00e0 clef"}}, {"@id": "_:n0f7a2901f047413a92c59eda1357b0d0b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television romans \u00e0 clef"}}], "@id": "/authorities/genreForms/gf2019026160"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026162", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aQueer comics", "identifiers:lccn": "gf2019026162", "madsrdf:adminMetadata": [{"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b1"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Queer comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026010"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026011"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026062"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026063"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026102"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026041"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026004"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026070"}], "madsrdf:hasSource": [{"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b5"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b6"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b7"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b8"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b9"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b10"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b11"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b12"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b13"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b14"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b15"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b16"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b17"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b18"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b19"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b20"}], "madsrdf:hasVariant": [{"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b21"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b24"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics featuring queer characters or addressing queer themes."}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Queer comics"}}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Prism comics : your LGBT guide to comics, [2007]", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "foreword (\"queer comics\" which \"explore, ponder, dissect, critique, and celebrate queer lives from an insider's perspective\"; collection includes \"LGBTQ comics\")"}, "madsrdf:citationSource": "Work cat: Qu33r : new comics from 33 creators, [2014]", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Little rainbow comics follow the adventures of three gay kids. Stan, Denisha and Zack are your average first graders making their way through life out and proud\")"}, "madsrdf:citationSource": "Robert Paul. Little rainbow comics : small book with a big message, [2013]", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p.[1] (\"the world of LGB comics and graphic novels\")"}, "madsrdf:citationSource": "Flights of fancy : report of the 7th LGBT History and Archives Conference at the London Metropolitan Archives December 6th 2009-12-06", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Being true : LGBTQ+ comics from the Boston Comics Roundtable, [2018]", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "editor's note (\"queer comics\"; comics \"that deal with LGBTQ themes\"; \"it remains the job of mainstream comics to assimilate LGBTQ characters, while it falls to queer comics to dissect queer identities and examine in more profound ways the queer experience\"; \"complex history and diversity of LGBTQ comics\")"}, "madsrdf:citationSource": "No straight lines : four decades of queer comics, [2013]", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 53-68 (\"comics that tackle questions of identity formation for their queer heroines\"; includes comics that \"problematize ... at least one of the following categories: lesbian, dyke, queer, butch, femme, bisexual\")"}, "madsrdf:citationSource": "Stanley, M. Drawn out : identity politics and the queer comics of Leanne Franson and Ariel Schrag, in Canadian literature v.205 (2010)", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"LGBTQIA+ comics\")"}, "madsrdf:citationSource": "MacDonald, H. The inaugural Prism Award winners announced for the best in queer-themed comics, Jul. 9, 2017, via ComicsBeat website, viewed Nov. 27, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Website designed to facilitate access to comics that contain queer representation\"; \"representation from across the LGBTQIA spectrum, as well as intersectional representation. Focus is on the content of the work, rather than on the creators\")"}, "madsrdf:citationSource": "Queer comics database : discover your next queer read, [2018]:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"GLBT comics\")"}, "madsrdf:citationSource": "Earle, T. No straight lines : four decades of queer comics, via Rainbow Round Table Book and Media Reviews site, viewed Nov. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"sexual minority comics\")"}, "madsrdf:citationSource": "Q&A with Dale Lazarov, a gay Puerto Rican comic book writer and poetry, 10 Apr. 2019, via PGH Lesbian Correspondents website, viewed 26 Nov. 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Reading Alphabet will plunge you into the welcoming rainbow of LGBTQAIU comics\")"}, "madsrdf:citationSource": "\"Alphabet\" edited by Jon Macy and Tara Madison Avery : review, via Lambda Literary website, viewed Dec. 5, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp.197-459 (summary: \"how comics represent and reconceptualize queer sexuality, desire, intimacy, and eroticism\"; examines a range of comics production including \"independent LGBTQ comics\")"}, "madsrdf:citationSource": "Queer about comics, in American literature v.90, no.2 (June 2018)", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp.130-134 (\"current teen\u2010oriented graphic novels with gay, lesbian, bisexual, transgender, queer, and questioning of sexual orientation (GLBTQ) content\")"}, "madsrdf:citationSource": "GLBTQ content in comics/graphic novels for teens, in Collection building v.26, n.4 (Oct. 2007)", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b19", "@type": "madsrdf:Source", "madsrdf:citationSource": "LGBTQIAP+ comics you should read part I, Jun. 7, 2018, via The Writing Hufflepost blog, viewed Dec. 4, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Adding LGBTQIA+ comics to your classroom or library\")"}, "madsrdf:citationSource": "Comic Book Legal Defense Fund website, viewed Nov. 27, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "GLBTQ+ comics"}}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "GLBTQ+ comics"}}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sexual minority comics"}}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sexual minority comics"}}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "LGBTQ+ comics"}}, {"@id": "_:nb4efb244fe9a41adbfab7d67fcaefb01b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "LGBTQ+ comics"}}], "@id": "/authorities/genreForms/gf2019026162"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026163", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKantrum (Music)", "identifiers:lccn": "gf2019026163", "madsrdf:adminMetadata": [{"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b1"}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kantrum (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, "madsrdf:hasSource": [{"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b5"}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b6"}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b7"}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b8"}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kantrum (Music)"}}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kantrum [in Thai script: kantr\u01b0m] is a type of folk music played by the Khmer in Isan, Thailand, living near the border with Cambodia. It is a fast, traditional dance music. In its purest form, cho-kantrum, singers, percussion and fiddles dominate the sound. A more modern form using electric instrumentation arose in the mid-1980s. As the Khmer native to Thailand are bilingual, kantrum songs can be sung in Thai (Isan dialect), Northern Khmer or a combination of the two)"}, "madsrdf:citationSource": "Wikipedia, Nov. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (Kantrum folk music is played in three southern provinces of northeastern Thailand, along the border with Cambodia) accompanying audio disc (contains kantrum songs)"}, "madsrdf:citationSource": "Work cat.: Bussakorn Sumrongthong. Kantr\u01b0m, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(There are three major genres of Thai folk music: luk thung, mor lam, and kantrum; Kantrum is a type of folk music that is played by the ethnic Khmer in Thailand. It's a traditional dance music that is upbeat and fast. It's played using the cho-kantrum, percussion, fiddles and a vocalist. What is most interesting about kantrum is that because the Khmer in Thailand are bilingual, the songs are often song with verses alternating languages, but sometimes will even switch languages in the same verse, which adds to the variety of words and tones that can be used)"}, "madsrdf:citationSource": "Bedenis, C. 3 kinds of folk music in Thailand, via Christine Bedenis website, posted May 2, 2014, viewed on Nov. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Thailand, Kingdom of (The lower part [of Northeast Thailand] includes three provinces next to the Cambodian border, which are Khmer influenced and where music of the kantrum ensemble is prominent. It is named after the pair of double-headed drums played in the ensemble)"}, "madsrdf:citationSource": "Grove music online, Nov. 26, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ea83c2be4754bcf9d42b6b97156f543b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 4, p. 210 (The main kind of Khmer-Thai music is kantr\u00fcm) v. 4, p. 213 (Kantr\u00fcm, the most famous and most widespread ensemble, gets its name from the sound of the dominant drums in the ensemble. The number of instruments depends on the occasion and how many people and instruments are available. It is played for many occasions, but not funerals) v. 4, p. 214 (Kantr\u00fcm music, a genre of compositions sometimes played apart from the ensemble of the same name, is the best known Thai-Khmer music)"}, "madsrdf:citationSource": "The Garland encyclopedia of world music, 1988:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026163"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026164", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLuk thung (Music)", "identifiers:lccn": "gf2019026164", "madsrdf:adminMetadata": [{"@id": "_:n289a8d352f6e4467b8033c375ae1a220b1"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Luk thung (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n289a8d352f6e4467b8033c375ae1a220b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n289a8d352f6e4467b8033c375ae1a220b5"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b6"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b7"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b8"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b9"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b10"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b11"}], "madsrdf:hasVariant": [{"@id": "_:n289a8d352f6e4467b8033c375ae1a220b12"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b15"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Luk thung (Music)"}}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (L\u016bk thung [parallel title in Thai]) liner notes (Luk thung is known to many as Thailand's \"country music\"; it's a vibrant and syncretic genre of pop song which aims to give voice to a disenfranchised rural population)"}, "madsrdf:citationSource": "Work cat.: Luk thung : classic & obscure 78s from the Thai countryside, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Thailand, Kingdom of (The earliest indigenous popular song developed after World War II from the melodic singing style of classical music. The singer was accompanied by a Thai string ensemble, to which were added Western instruments such as organ and violin. Songs were performed as preludes and interludes in modern theatrical presentations. The two main styles of popular song were the polished urban l\u016bk krung and the rural l\u016bk thung, which contained more elements of folk music) under Laos (With the rise of the Isan-derived luk thung popular song since the 1960s, Isan's popular culture has come to appeal to Thai people of all regions and has penetrated Laos through the Thai media)"}, "madsrdf:citationSource": "Grove music online, Dec. 2, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 4, p. 96-97 (Luk thung (luk 'offspring,' thung 'field') appeared in the 1940s and remains one of the most vital and commercially viable musics in Thailand. It has changed considerably since its appearance, but its style remains recognizable, and as a genre, it speaks to the rural and urban working class. It is closely related to the traditional rural musics of the ethnic Lao from northeastern Thailand. In addition to distinctly Thai or Lao characteristics, early luk thung songs often used a backup band of Western trumpets, saxophones, trap set, and other spinoffs from big band instrumentation)"}, "madsrdf:citationSource": "The Garland encyclopedia of world music, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 24 (Lukthung, often referred to in English as \"Thai country music,\" has long been associated with the Thai village environment and the lives of its inhabitants, whose concerns have comprised the subject matter of lukthung songs since the music's inception during the 1960s; Contemporary lukthung also incorporates many Western and global musical trends, such as salsa, funk, rap, and techno, into its music, as well as incorporating many English loan words into its lyrics)"}, "madsrdf:citationSource": "Asian music, winter-spring 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Luk thung, or Phleng luk thung [in Thai script: L\u016bk thung or Phl\u0113ng l\u016bk thung, meaning 'child of the field song'], often known as Thai country music, is an acculturated song genre that emerged after World War II in the central region of Thailand. The genre was derived from phleng Thai sakon, and developed in the early-20th century. Suphan Buri in particular became the center of luk thung music, producing many major artists, including Suraphol Sombatcharoen and Pumpuang Duangjan. The genre has been prominently popularized in the northeastern region, having from its beginnings drawn upon northeastern mor lam musical traditions and the northeastern Isan language)"}, "madsrdf:citationSource": "Wikipedia, Dec. 2, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(There are three major genres of Thai folk music: luk thung, mor lam, and kantrum; The term luk thung roughly translates to \"song of a child of the fields,\" since it generally refers to the everyday lives of the rural poor in Thailand. Luk thung developed in the early 20th century and gained popularity in the 1960s. Luk thung tends to be slower with the vocalists using a lot of vibrato and could be compared to American country music, from which it draws a lot of influence, as well as Latin American, Japanese, Indonesian and Malaysian music. The early luk thung stars came from Suphan Buri, which is why there is a room dedicated to this kind of music in the museum there. Recently luk thung has been electrified and made dance ready. Additionally it has been mixed with Thai string music and mor lam)"}, "madsrdf:citationSource": "Bedenis, C. 3 kinds of folk music in Thailand, via Christine Bedenis website, posted May 2, 2014, viewed on Dec. 2, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Luk Thung (Thai: L\u016bk thung) refers to the most popular form of a style of music found in Thailand. The term is short for pleng luk thung (Thai: Phl\u0113ng l\u016bk thung). Luk Thung songs typically reflect the hardship of everyday life among the rural poor. Tempos tend to be slow, and singers use an expressive singing style with a lot of vibrato. Comparisons are sometimes made with country music of the United States)"}, "madsrdf:citationSource": "Luk thung music, via last.fm website, Dec. 5, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n289a8d352f6e4467b8033c375ae1a220b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lukthung (Music)"}}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lukthung (Music)"}}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n289a8d352f6e4467b8033c375ae1a220b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Phleng luk thung (Music)"}}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Phleng luk thung (Music)"}}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n289a8d352f6e4467b8033c375ae1a220b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pleng luk thung (Music)"}}, {"@id": "_:n289a8d352f6e4467b8033c375ae1a220b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pleng luk thung (Music)"}}], "@id": "/authorities/genreForms/gf2019026164"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026165", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProtest songs", "identifiers:lccn": "gf2019026165", "madsrdf:adminMetadata": [{"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db1"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Protest songs"}, "madsrdf:elementList": {"@list": [{"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": [{"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db5"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db6"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db7"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db8"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db9"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db10"}], "madsrdf:hasVariant": {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Protest songs"}}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Protest song: many protest songs are of unknown authorship, passed on by oral tradition, and altered to fit new times and contemporary problems; most protest songs are topical, made for a particular time and place; although protest songs did not become part of American mass culture until the activist 1960s, they have always been a part of American musical culture; to resonate with later musical generations, protest songs must reflect universal concerns or commonly shared problems. As these features are rare, there exists no canon of American protest song; told simple stories and expressed simple emotions; under Political music: among the most common types of political music are campaign songs and music of political protest, including labor, populist, suffragist, and abolitionist songs; under Ortega, Sergio: El pueblo unido jam\u00e1s ser\u00e1 vencido (\"The People United will Never be Defeated\"), written in May 1973 in protest against the growing right-wing movement in Chile. Political protest is also central to many of his operatic and vocal works)"}, "madsrdf:citationSource": "Grove music online, Dec. 2, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"\u00a1El pueblo unido, jam\u00e1s ser\u00e1 vencido!\" (English: \"The people united will never be defeated\") is one of the most internationally renowned songs of the Nueva cancion chilena (New Chilean Song) movement. The music of the song was composed by Sergio Ortega and the text written by Quilapay\u00fan; initially composed as an anthem for the popular unity government, reflecting the spirit behind the mass mobilization of working-class people who in 1970 had elected Salvador Allende for the socialist transformation of Chile; After the U.S.-backed September 11, 1973 Chilean coup the song became the anthem of the Chilean resistance against the Pinochet regime, both within Chile and among the community of Chilean exiles and their political allies abroad; the song has been used in various protests around the world)"}, "madsrdf:citationSource": "Wikipedia, Dec. 2, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(protest song: a song that expresses disapproval, usually about a political subject)"}, "madsrdf:citationSource": "Cambridge dictionary online, Dec. 2, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(includes: El pueblo unido jamas sera vencido! : excerpt from a live concert in Buenos Aires, c. 1975; performed by Quilapayun)"}, "madsrdf:citationSource": "Work cat.: Rzewski, F. The people united will never be defeated!, \u21171994", "madsrdf:citationStatus": "found"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In the United States, the tradition of protest songs dates to pre-Revolutionary War and flourished during the war; \"People get Ready\" by The Impressions and \"The times they Are a'Changin\" written by Bob Dylan are just two of the many protest songs which became popular hits on the musical charts; carrying the message and ideas of protest across the nation and the world)"}, "madsrdf:citationSource": "Hayward, N. Brief overview of protest songs, via National Women's History Museum website, Dec. 2, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Protest songs. BT Political ballads and songs; Songs; Topical songs. RT Radicalism--Songs and music)"}, "madsrdf:citationSource": "LCSH, Dec. 2, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Political protest songs"}}, {"@id": "_:naf2a252bde594acb8a1fb1e7bef2b86db12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Political protest songs"}}], "@id": "/authorities/genreForms/gf2019026165"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026166", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMolam (Music)", "identifiers:lccn": "gf2019026166", "madsrdf:adminMetadata": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b1"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Molam (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b5"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b6"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b7"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b8"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b9"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b10"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b11"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b12"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b13"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b14"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b15"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b16"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b17"}], "madsrdf:hasVariant": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b18"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b21"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b24"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b27"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b30"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b33"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b36"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b39"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b42"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b45"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b48"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-03T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-04-09T12:54:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Molam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(47,900 results for \"mor lam\"; 390,000 results for \"morlam\"; 940,000 results for \"molam\"; 27,600 results for \"mawlam\")"}, "madsrdf:citationSource": "Google search, Dec. 5, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Laos (Lam. Southern Lao and north-eastern Thai term for vocal music (the central and northern Lao equivalent is khap), used particularly to designate melodies that are generated from the speech tones of the text; Lao vocal genres predominantly consist of male-female repartee in a ritualized derivative of courtship)"}, "madsrdf:citationSource": "Grove music online, Dec. 5, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 11, Cultural and artistic index (mawlam (music))"}, "madsrdf:citationSource": "World and its peoples : Eastern and southern Asia, 2008, via Google books, Dec. 5, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 4, p. 320 (Among Lao-speakers in the northeast [of Thailand], the primary kind of music is vocal, called lam; term refers to singing in which a flexible melody is coordinated with the lexical tones of the poetry; term has come to denote singing or a genre of singing; the latter usage may be shortened simply to lam)"}, "madsrdf:citationSource": "The Garland encyclopedia of world music, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(molam; molam music; traditional folk music of Thailand's Northeast; folk genre has been gaining popularity in Bangkok ever since a blossoming of interest in molam in the West)"}, "madsrdf:citationSource": "Rojanaphruk, P. Remixing molam for a new generation of listeners, via Khaosod English website, posted July 8, 2019, viewed Dec. 5, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Thailand, Kingdom of (North-eastern Thailand is divided into two parts. The upper part includes the main area of this region, which is Lao-influenced and which features kh\u01e3n (bamboo mouth organ) and mo\u0327\u0304lam (repartee genre) performance; Mo\u0327\u0304lam is a vocal repartee style sung in local dialect by male and female singers and accompanied by the kh\u01e3n; Lam includes courtship, didactic and narrative songs; during the last decade of the 20th century a modern style of mo\u0327\u0304lam (mo\u0327\u0304lam sing) was developed, incorporating drum kit and electric guitar)"}, "madsrdf:citationSource": "Grove music online, Dec. 5, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mor lam [in Thai script: Mo\u031c\u0304lam]; traditional Lao form of song in Laos and Isan [Northeastern Thailand]. Other romanizations used include mor lum, maw lam, maw lum, moh lam and mhor lum. In Laos, the music is known simply as lam; mor lam refers to the singer)"}, "madsrdf:citationSource": "Wikipedia, Dec. 5, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Southeast Asian folk music > Molam (Molam. Also known as: Mo\u031c\u0304lam [in Thai script], Lam [in Lao script], Mor Lam, Maw Lam, Maw Lum, Moh Lam, Mhor Lum. A style of traditional folk music from Laos and the Isaan. Traditionally a singer is accompanied by khaen, a bamboo mouth organ, nowadays most often with electrified instruments)"}, "madsrdf:citationSource": "rateyourmusic.com website, Dec. 5, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (Mo\u031c\u0304lam is a popular form of music and performance of northeast Thailand) accompanying audio disc (contains mawlam songs)"}, "madsrdf:citationSource": "Work cat.: Butsako\u031c\u0304n Binthasan. Mo\u031c\u0304lam, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(morlam music; morlam; also referred to as mor-lam, moh-lam, moh-lum, and similar spellings, as the English transliteration from Thai and Lao is inexact)"}, "madsrdf:citationSource": "Morlam music : an Isaan pastiche of city and country, via WoWasis TravelBlog, posted Apr. 23, 2010, viewed Dec. 5, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Thailand's Molam music; Molam is country music that's been played in the Thai and Laotian hinterlands since the 17th century. Its Thai home is in Isaan, a region in the Northeast of the country where many working class people live; a traditional Molam act features only a singer and a khaen player, which is a bamboo mouth organ played vertically in bass tones designed to support a singer's voice. Beyond that, the most common additions to a Molam band are phin, a small lute with strings, drums, and bass; underwent a major shift in the 70s; molam players absorbed psychedelic, rock, soul, and funk music; with its psychedelic riffs and country jams, the genre is experiencing a new life worldwide)"}, "madsrdf:citationSource": "Tuohy, L. Thailand's forgotten country-psychedelic music Is having a global renaissance, via Vice website, posted Mar. 6 2016, viewed Dec. 5, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(three major genres of Thai folk music: luk thung, mor lam, and kantrum. Mor lam is the dominant folk music in Isaan; started as a singer interpreting poems and being accompanied by a khaen, or a mouth organ. Traditionally the melodies were flexible and fit to the tones of the words in the poem being performed. Now, mor lam ensembles include the khaen but also other electric instruments)"}, "madsrdf:citationSource": "Bedenis, C. 3 kinds of folk music in Thailand, via Christine Bedenis website, posted May 2, 2014, viewed on Dec. 5, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mor lam (Thai/Isan: mo\u031c\u0304lam); other romanisations used include mo lam, maw lam, maw lum, moh lam and mhor lum)"}, "madsrdf:citationSource": "last.fm website, Dec. 5, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Maw lum (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maw lum (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mhor lum (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mhor lum (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Khap (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Khap (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mawlam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mawlam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mor lam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mor lam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mor lum (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mor lum (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Moh lam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Moh lam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b42", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b43"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Morlam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b43", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Morlam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b45", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b46"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mo lam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b46", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mo lam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b48", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b49"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Maw lam (Music)"}}, {"@id": "_:na63614d0d3a54b329340f9425eb9e4c2b49", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maw lam (Music)"}}], "@id": "/authorities/genreForms/gf2019026166"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026167", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNoise pop (Music)", "identifiers:lccn": "gf2019026167", "madsrdf:adminMetadata": [{"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b1"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Noise pop (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026632"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026967"}], "madsrdf:hasSource": [{"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b5"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b6"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b7"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b8"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b9"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b10"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b11"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b12"}], "madsrdf:hasVariant": {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b13"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noise pop (Music)"}}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(noise pop album originally released in 1985)"}, "madsrdf:citationSource": "Work cat.: Jesus & Mary Chain (Musical group). Psychocandy, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Pop/Rock > Alternative/Indie Rock > Noise Pop (A subgenre of alternative/indie rock, noise pop is just what it says -- pop music wrapped in barbed-wire kisses of feedback, dissonance, and abrasion. It occupies the halfway point between bubblegum and the avant-garde, a collision between conventional pop songcraft and the sonic assault of white noise. Noise pop often has a hazy, narcotic feel, as melodies drift through the swirling guitar textures. But it can also be bright and lively, or angular and challenging. The first proper noise pop band was the Jesus & Mary Chain, whose groundbreaking 1986 debut Psychocandy pretty much birthed the style. Yo La Tengo, perhaps the most prolific and long-lived noise-pop band, debuted around the same time. In the late '80s, noise pop was the chief inspiration for the British shoegazing movement, which made the lyrics more introspective and the melodies more fragile. All through the '90s, noise pop continued to enjoy an important and influential presence on the indie rock scene)"}, "madsrdf:citationSource": "AllMusic website, Dec. 9, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Minneapolis and St Paul: Husker Du, a Minneapolis power trio, merged punk and pop into a post-punk noise pop that also laid the groundwork for much of the alternative rock of the 1990s)"}, "madsrdf:citationSource": "Grove music online, Dec. 9, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Although there is not one defining trait of a Noise Pop performer, most acts do share thematic similarities: crashing guitars, delectable dissonance, insatiable melodies. Whereas feedback and distortion can be rather disconcerting when they fall into the wrong hands, the typical Noise Pop artist has learned how to twist them into a subtle blend of melodic mayhem; roots of the Noise Pop genre can be traced to bands such as Husker Du, the Replacements, Dinosaur Jr. and the Flaming Lips)"}, "madsrdf:citationSource": "Kurland, J. Snap, crackle and noise pop, via SFGate website, posted Feb. 26, 1997, viewed Dec. 9, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Rock > Alternative rock > Noise pop (Noise pop is a style of Alternative Rock that arose in the mid-1980s as some British Jangle Pop, Twee Pop, and Post-Punk groups started to use more distortion. An early landmark album for the genre was The Jesus and Mary Chain's 1985 album Psychocandy, defining the style's blend of poppier Rock songwriting and melodies with the crisp, noisy timbres of overdriven guitars and occasional use of guitar feedback. Noise pop's combination of sunny, simple, often Girl Group-esque melodies (hence the 'pop') with waves of distortion sets it apart from the rawer, less melodic, often haphazard sounds of Noise Rock. The vocals in noise pop also tend to be hazier, dreamier and altogether more melodic and harmonic than in noise rock. The sound would be one influence on the rise of Shoegaze a few years later)"}, "madsrdf:citationSource": "rateyourmusic.com website, Dec. 9, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Noise pop music; Noise pop; a strain of alternative rock that fuses punk rock's attitude and anger with the atonal noise, feedback, and free song structures of noise music, presented in a decidedly pop context. Typically it employs standard rock instrumentations such as electric guitar, bass guitar, drum kit, and occasionally keyboards, and uses a number of effects usually not present in more mainstream forms of music such as fuzz, feedback, and drones. Song structures generally follow a standard pop/rock formula. Most noise pop bands feature sung, melodic vocals, and harmonies are not altogether uncommon in the genre; Early noise pop bands include Sonic Youth, Dinosaur Jr., and Yo La Tengo. The Jesus and Mary Chain is the band most widely cited as being the first noise pop band. Noise pop was the chief inspiration for the British shoegaze movement)"}, "madsrdf:citationSource": "Noise pop music, via last.fm website, Dec. 9, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Psychocandy - The Jesus and Mary Chain (Genre: Pop/Rock. Styles: Alternative Pop/Rock, College Rock, Noise Pop)"}, "madsrdf:citationSource": "AllMusic website, Dec. 9, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Oxford dictionary of music, 2012", "madsrdf:citationStatus": "notfound"}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pop, Noise (Music)"}}, {"@id": "_:na2445055f98d40db8bdd9a84d0a1be40b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pop, Noise (Music)"}}], "@id": "/authorities/genreForms/gf2019026167"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026168", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNoise rock (Music)", "identifiers:lccn": "gf2019026168", "madsrdf:adminMetadata": [{"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b1"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Noise rock (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026967"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}], "madsrdf:hasSource": [{"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b5"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b6"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b7"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b8"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b9"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b10"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b11"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b12"}], "madsrdf:hasVariant": [{"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b13"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noise rock (Music)"}}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Pop/Rock subgenres and styles > Art-Rock / Experimental > Noise-Rock (Noise-Rock is an outgrowth of punk rock, specifically the sort of punk that expressed youthful angst and exuberance through the glorious racket of amateurishly played electric guitars. Noise-rock, like its forerunner no wave, aims to be more abrasive, sometimes for comic effect and sometimes to make a statement, but always concentrating on the sheer power of the sound. While most noise-rock bands concentrate on the ear-shattering sounds that can be produced by distorted electric guitars, some also use electronic instrumentation, whether as percussion or to add to the overall cacophony. Some groups are more concerned than others about integrating their sonic explorations into song structures; pioneers Sonic Youth helped bring noise-rock to a wider alternative-rock audience when they began to incorporate melody into their droning sheets of sound.)"}, "madsrdf:citationSource": "AllMusic website, Dec. 9, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Experimental > Noise (Noise is an Experimental genre that strays away from conventional music structure, tonality, and composition and - as the name implies - consists predominantly of noise. Such music can be created or generated with virtually anything, including acoustic and traditional instruments, non-musical objects and machinery, extreme vocal techniques, and electronic equipment. Noise is often cacophonous, improvised in its composition, dissonant, loud, and abrasive. These noisy techniques are commonly created with feedback, distortion, manipulation, computer generation, etc. ... While avant-garde classical compositions and Electronic experiments of the early 1960s were steadily utilising noise more frequently, popular music was also starting to catch on to the style. In 1966, The Velvet Underground's John Cale recorded Loop, another track which honed in on audio feedback and Drone sounds. ... Since its inception, noise has evolved into and influenced a wide spectrum of genres and styles, across all levels of intensity. While some took it to their harsh extremities, such as the Harsh Noise Wall style of often-unchanging walls of static noise, other styles like Noise Rock and Noise Pop used noise in a more accessible way, retaining traditional rock song tropes.)"}, "madsrdf:citationSource": "rateyourmusic.com website, Dec. 9, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dirty - Sonic Youth. Genre: Pop/Rock. Styles: Alternative Pop/Rock, Alternative/Indie Rock, Experimental, Experimental Rock, Indie Rock, Noise-Rock, Grunge)"}, "madsrdf:citationSource": "AllMusic website, Dec. 9, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Noise rock (sometimes called noise punk) is a noise-oriented style of experimental rock that spun off from punk rock in the 1980s. Drawing on movements such as minimalism, industrial music, and New York hardcore, artists indulge in extreme levels of distortion through the use of electric guitars and, less frequently, electronic instrumentation, either to provide percussive sounds or to contribute to the overall arrangement; oise rock fuses rock to noise, usually with recognizable \"rock\" instrumentation, but with greater use of distortion and electronic effects, varying degrees of atonality, improvisation, and white noise. One notable band of this genre is Sonic Youth)"}, "madsrdf:citationSource": "Wikipedia, Dec. 9, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Rock > Noise Rock (Noise rock is a genre that encompasses a wide range of bands and artists that favour dissonance, wild feedback, and extreme distortion in the context of Rock music. Unlike Noise, noise rock usually retains the song structures and coherence of conventional rock music; noise rock came to its own in the 1980s; pioneering bands include Sonic Youth, The Birthday Party, The Butthole Surfers, Flipper and Swans)"}, "madsrdf:citationSource": "rateyourmusic.com website, Dec. 9, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(noise rock album)"}, "madsrdf:citationSource": "Work cat.: Sonic Youth (Musical group). Dirty, \u21171992", "madsrdf:citationStatus": "found"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dirty (Sonic Youth album); the seventh studio album by American rock band Sonic Youth; genre: Noise rock; alternative rock; experimental rock; grunge)"}, "madsrdf:citationSource": "Wikipedia, Dec. 9, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Avant-Garde > Sound Art > Noise (Sludgy, abrasive, and punishing, Noise is everything its name promises, expanding on the music's capacity for sonic assault while almost entirely rejecting the role of melody and songcraft. From the ear-splitting, teeth-rattling attack of Japan's Merzbow to the thick, grinding intensity of Amphetamine Reptile-label bands like Tar and Vertigo, it's dark, brutal music that pushes rock to its furthest extremes. By the end of the '90s, a resurgence in the use of sine waves -- originally explored by musique concr\u00e8te artists in the '50s -- became increasingly frequent among noise artists such as Otomo Yoshihide)"}, "madsrdf:citationSource": "AllMusic website, Dec. 9, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Punk, Noise (Music)"}}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Punk, Noise (Music)"}}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Noise punk (Music)"}}, {"@id": "_:ncada9e59dbad4dfea4b7ead1603ecb37b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noise punk (Music)"}}], "@id": "/authorities/genreForms/gf2019026168"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026169", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAcid jazz", "identifiers:lccn": "gf2019026169", "madsrdf:adminMetadata": [{"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb1"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Acid jazz"}, "madsrdf:elementList": {"@list": [{"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026879"}, "madsrdf:hasSource": [{"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb5"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb6"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb7"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb8"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb9"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb10"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb11"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb12"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb13"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb14"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb15"}], "madsrdf:hasVariant": {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb16"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Acid jazz"}}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(acid jazz: a style of popular dance music that is a mix of funk, soul, and jazz)"}, "madsrdf:citationSource": "Cambridge dictionary online, Dec. 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acid jazz. Hybrid genre with origins in London's acid house scene of the late 1980s; denotes a durable transatlantic jazz subculture with links to hip hop, rave and club music. Notable bands include the Brand New Heavies, Jamiroquai, Galliano, and Us3 in the UK and Digable Planets, Groove Collective, and Brooklyn Funk Essentials in the USA. During the music's heyday in the 1990s, groups fused improvised live jazz with soul-jazz beats and elements of hip hop, including lyrics by established rappers like Guru and MC Solaar. The dance-oriented music tapped into the era's fascination with jazz history, DJ culture, and retro kitsch)"}, "madsrdf:citationSource": "Grove music online, Dec. 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(acid jazz album)"}, "madsrdf:citationSource": "Jazzhole (Musical group). Blackburst, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "The best of acid jazz, 2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acid jazz (also known as club jazz) is a musical genre that combines elements of soul music, funk, disco, particularly looping beats and modal harmony. It first developed in America in a simplistic form from artists such as Sonny Stitt who infused funk, gospel, jazz, and other popular genres with a recurring backbeat. In the UK it developed over the 1980s and 1990s and could be seen as tacking the sound of jazz-funk onto electronic dance/pop music for the UK. While acid jazz often contains various types of electronic composition (sometimes including sampling or live DJ cutting and scratching), it is just as likely to be played live by musicians, who often showcase jazz interpretation as part of their performance)"}, "madsrdf:citationSource": "Acid jazz music, via last.fm website, Dec. 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(acid jazz: a type of music that mixes various styles such as funk, disco, and latin, and combines electronic production with acoustic instruments and sometimes singing)"}, "madsrdf:citationSource": "Macmillan dictionary online, Dec. 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acid jazz, also known as club jazz; music genre that combines elements of jazz, soul, funk, and disco; originated in the London club scene of the mid-1980s in the rare groove movement and spread to the US, Japan, Eastern Europe, and Brazil. Major acts included the Brand New Heavies, Incognito, Us3, and Jamiroquai from the UK and Buckshot LeFonque and Digable Planets from the US; Acid jazz consisted of two related movements. The first was based on records released by DJs and producers that included rare jazz tracks, particularly from the 1960s and 1970s, often mixing them with percussion tracks and electronic dance beats. The second were groups influenced by these recordings and who emphasised a groove-based approach to music; uses elements of jazz, funk and hip-hop; the style is characterized by danceable grooves and long, repetitive compositions. Typical ensembles include horns, a full rhythm section (often with a drum set and additional percussion), a vocalist that may sing and rap and often a DJ)"}, "madsrdf:citationSource": "Wikipedia, Dec. 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Jazz > Acid jazz (Acid jazz is a genre that uses elements of Jazz, Funk, Hip Hop and to a lesser degree Soul and House. It was a movement in the UK, in the early 90s. Some of the major players in this genre are Ronny Jordan, Jamiroquai and Incognito)"}, "madsrdf:citationSource": "rateyourmusic.com website, Dec. 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(acid jazz: a type of music, popular in the 1980s and 1990s, that combines jazz with genres such as funk, hip-hop, and electronic dance music)"}, "madsrdf:citationSource": "Collins English dictionary online, Dec. 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Jazzhole (acid jazz duo) Electronic subgenres and styles > Jungle/Drum'n'Bass > Acid Jazz (Acid Jazz used elements of jazz as well as funk and hip-hop; its existence as a percussion-heavy, primarily live music placed it closer to jazz and Afro-Cuban than any other dance style, but its insistence on keeping the groove allied it with funk, hip-hop, and dance music; variety of acid jazz artists emerged during the late '80s and early '90s, including either primarily live bands such as Stereo MC's, James Taylor Quartet, the Brand New Heavies, Groove Collective, Galliano, and Jamiroquai or studio projects like Palm Skin Productions, Mondo Grosso, Outside, and United Future Organization)"}, "madsrdf:citationSource": "AllMusic website, Dec. 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acid Jazz music tends to be generally upbeat, \"jazzy\" pop-funk dance music played by traditional bands, and sometimes by artists who make heavy use of sampling. Often, acid jazz songs consist largely of funky basslines and upbeat hip-hop breaks, with the only improvised element being a melodic solo performance by a single instrument or vocalist)"}, "madsrdf:citationSource": "Acid jazz music, via Discogs website, Dec. 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Club jazz"}}, {"@id": "_:n24be90f9e5e74620b24bda5ee4c4fb4bb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Club jazz"}}], "@id": "/authorities/genreForms/gf2019026169"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026170", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJangle pop (Music)", "identifiers:lccn": "gf2019026170", "madsrdf:adminMetadata": [{"@id": "_:n208216edce0b49f3a203f2656d54e47eb1"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jangle pop (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n208216edce0b49f3a203f2656d54e47eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n208216edce0b49f3a203f2656d54e47eb5"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb6"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb7"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb8"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb9"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb10"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb11"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb12"}], "madsrdf:hasVariant": [{"@id": "_:n208216edce0b49f3a203f2656d54e47eb13"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jangle pop (Music)"}}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Pop/Rock > Alternative/Indie Rock > Jangle Pop (Jangle Pop was an American post-punk movement of the mid-'80s that marked a return to the chiming guitars and pop melodies of the '60s. Sparked by the arrival of R.E.M., jangle pop also had some folk-rock overtones, but it was essentially a pop-based format. Jangle pop wasn't mainstream music -- the bands' lyrics were often deliberately cryptic and their sound was raw and amateurish, bearing all the signs of do-it-yourself productions. Jangle pop was a major force between 1984 and 1987 -- not only were there Southern-pop bands like R.E.M. and Let's Active, there were the Paisley Underground bands on the West Coast who were more psychedelic, and there were numerous bands scattered throughout the Midwest)"}, "madsrdf:citationSource": "AllMusic website, Dec. 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(R.E.M. - Reckoning. Genre: Pop/Rock. Styles: Alternative Pop/Rock; Alternative/Indie Rock; American Underground; College Rock; Jangle Pop)"}, "madsrdf:citationSource": "AllMusic website, Dec. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(R.E.M.; American alternative rock group; Musically, they revived the jangly folk- and country-influenced sound of the Byrds and mixed it with aspects of post-punk rock)"}, "madsrdf:citationSource": "Grove music online, Dec. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Originating during the early '80s within the burgeoning college rock scene, jangle pop is a pop/rock style that has probably been around in some form (without the name) since the days of the Beatles and the Byrds. Much of the form's definition stems from the colorful word that serves as its primary descriptor: known mostly for its chiming, melodic electric guitars, the music jingles and jangles in pleasant but offbeat ways that kept it from finding a place on the pop charts; the most obvious unofficial prototype for jangle pop emerged from the fruitful Athens, Ga. scene in the form of eventual superstars R.E.M.; guitar-heavy sound and contemplative, murky lyrical musings; jangle pop exerted quite an influence on underground, alternative guitar rock on an international level)"}, "madsrdf:citationSource": "Peake, S. Profile of '80s underground genre jangle pop, via LiveAbout website, posted Mar. 8, 2017, viewed on Dec. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(jangle pop album)"}, "madsrdf:citationSource": "Work cat.: R.E.M. (Musical group). Reckoning, \u21171984", "madsrdf:citationStatus": "found"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Reckoning (R.E.M. album); genre: Alternative rock; folk rock; jangle pop)"}, "madsrdf:citationSource": "Wikipedia, Dec. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Rock > Alternative rock > Jangle pop (Jangle Pop is a Rock music sub-genre with roots in the Post-Punk explosion of the late 1970s and early 1980s. Influenced by 1960s Folk Rock artists like The Byrds as well as the Power Pop of groups like Big Star, Jangle Pop is characterized for merging the sound of chiming, \"jangly\" guitars and Pop-oriented melodies with a somewhat rawer musical approach and production values. The genre found its greatest critical and mainstream popularity in the mid-1980s, with bands like The Smiths, R.E.M. and Felt)"}, "madsrdf:citationSource": "Rate your music website, Dec. 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Jangle (Jangle or jingle-jangle is a sound characterized by undistorted, treble-heavy electric guitars (particularly 12-strings) played in a droning chordal style (by strumming or arpeggiating). The sound has featured mainly in pop music and is often associated with 1960s guitar bands, folk rock, and 1980s indie music. It is sometimes classed as its own music subgenre, jangle pop; in the 1980s, the most prominent bands of early indie rock were jangle groups such as R.E.M. and the Smiths; music subgenre which is characterized by trebly, ringing guitars (usually 12-string electrics) and 1960s-style pop melodies)"}, "madsrdf:citationSource": "Wikipedia, Dec. 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n208216edce0b49f3a203f2656d54e47eb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jangle (Music)"}}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jangle (Music)"}}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n208216edce0b49f3a203f2656d54e47eb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jingle-jangle (Music)"}}, {"@id": "_:n208216edce0b49f3a203f2656d54e47eb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jingle-jangle (Music)"}}], "@id": "/authorities/genreForms/gf2019026170"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026171", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPsychobilly music", "identifiers:lccn": "gf2019026171", "madsrdf:adminMetadata": [{"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb1"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Psychobilly music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027025"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027055"}], "madsrdf:hasSource": [{"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb5"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb6"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb7"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb8"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb9"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb10"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb11"}], "madsrdf:hasVariant": [{"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb12"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb15"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb18"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psychobilly music"}}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Psychobilly reared its ugly head during the early '80s, as the rockabilly revival was hitting its stride. Since the rockabilly revival was an underground movement, it wasn't surprising that some bands wedded rockabilly to another, bigger underground movement -- punk. Psychobilly took the basic form of rockabilly and played it with punk energy, adding in all manners of kitschy, tacky lyrical references.)"}, "madsrdf:citationSource": "Psychobilly music genre overview, via AllMusic website, Dec. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 14 (Psycho) p. 22 (Psycho-Rockabilly) p. 39 (termed 'Psychobilly' in Europe and 'Psycho-Rockabilly', 'Neo-Rockabilly' or even 'Punkabilly' in America)"}, "madsrdf:citationSource": "Wilson, Alan. Deathrow : the chronicles of psychobilly : the very best of Britain's essential psycho fanzine issues 1-38, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(psychobilly: A style of popular music blending characteristics of rockabilly with the raw, aggressive performance style of punk rock, and typically having humorous or grotesque lyrics)"}, "madsrdf:citationSource": "Lexico dictionary website, Dec. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Smoke 'Em If You Got 'Em (The Reverend Horton Heat album) (Smoke 'Em If You Got 'Em is the first album by psychobilly trio The Reverend Horton Heat; genre: Psychobilly)"}, "madsrdf:citationSource": "Wikipedia, Dec. 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(psychobilly: music that blends punk rock and rockabilly)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Dec. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(psychobilly music album)"}, "madsrdf:citationSource": "Work cat.: Heat, Horton. Smoke 'em if you got 'em, 1990", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (a history of psychobilly) p. 8 (Psychobilly has been consistently ignored by the mainstream music press; the Psychobilly genre) pp. 12-15 (roots in rockabilly, garage punk, glam rock) p. 23 (Psychobilly music)"}, "madsrdf:citationSource": "Brackenridge, Craig. Hell's bent on rockin', 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psycho (Music)"}}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psycho (Music)"}}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Neo-rockabilly music"}}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Neo-rockabilly music"}}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psycho-rockabilly music"}}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psycho-rockabilly music"}}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Punkabilly music"}}, {"@id": "_:nd0df53bc1d0f46c4a708d2e103ab1f5cb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Punkabilly music"}}], "@id": "/authorities/genreForms/gf2019026171"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026172", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMicroblogs", "identifiers:lccn": "gf2019026172", "madsrdf:adminMetadata": [{"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb1"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Microblogs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026051"}, "madsrdf:hasSource": [{"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb5"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb6"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb7"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb8"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb9"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb10"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb11"}], "madsrdf:hasVariant": {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:20:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Microblogs"}}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tweet (social media): a short remark or piece of information published on Twitter)"}, "madsrdf:citationSource": "Cambridge dictionary online, Dec. 13, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tweet 2: a post made on the Twitter online message service)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Dec. 13, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Microblogs. UF Microblogging; Tumblelogging; Tumblelogs; Tweeting (Microblogs); Tweets (Microblogs). BT Blogs. RT Instant messaging; Social networks)"}, "madsrdf:citationSource": "LCSH, Dec. 13, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "2017, t.p. (a historical archive of President Trump's tweets)"}, "madsrdf:citationSource": "Work cat.: Trump, D. President Trump's tweets, 2019?- :", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tweet 2. Digital Technology. a message posted on the Twitter social media service and website: the message may include text, links, photos, or videos)"}, "madsrdf:citationSource": "Dictionary.com, Dec. 13, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tweet 2. a short message sent using the microblogging and social networking service Twitter)"}, "madsrdf:citationSource": "Macmillan dictionary online, Dec. 13, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tweet 5. a short message posted on the Twitter website)"}, "madsrdf:citationSource": "Collins English dictionary online, Dec. 13, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tweets (Microblogs)"}}, {"@id": "_:n7a3727872a2640efb8f00cd8499b8fbfb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tweets (Microblogs)"}}], "@id": "/authorities/genreForms/gf2019026172"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026174", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHora (Music)", "identifiers:lccn": "gf2019026174", "madsrdf:adminMetadata": [{"@id": "_:n77fd71ad13f74436a30d7458bc92162cb1"}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hora (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n77fd71ad13f74436a30d7458bc92162cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}], "madsrdf:hasSource": [{"@id": "_:n77fd71ad13f74436a30d7458bc92162cb5"}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb6"}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb7"}], "madsrdf:hasVariant": [{"@id": "_:n77fd71ad13f74436a30d7458bc92162cb8"}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb11"}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-04-16T14:33:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hora (Music)"}}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Rice, Timothy. Bulgaria, page 891 (\"The typical Bulgarian dance form, generically called horo, consists of an open or closed circle of dancers holding hands\") page 897 (\"Bulgarian villagers distinguish at least four types of movement ... Horo is the generic name for line dances arranged commonly in an open circle with a leader, but indoors in a closed circle, and sometimes in a straight or curving line. ... In the past, dancing to women's singing ... was common, two pairs of two singers leading the line and singing antiphonally. In the socialist period, instrumental accompaniment became the rule.\""}, "madsrdf:citationSource": "The Garland encyclopedia of world music. V. 8, Europe:", "madsrdf:citationStatus": "found"}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (in Cyrillic: Ta\u012dnata na b\u016dlgarskite praznit\ufe20s\ufe21i v khorata na Diko Iliev) back of container (English title: The secret of Bulgarian feasts in the horos of Diko Iliev)"}, "madsrdf:citationSource": "Work cat: Iliev, Diko. Ta\u012dnata na b\u016dlgarskite praznit\ufe20s\ufe21i v khorata na Diko Iliev:", "madsrdf:citationStatus": "found"}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Buchanan, Donna A. Bulgaria II. Traditional music. (ii) Seasonal musics (describes the dancing of \"ring, line, or chain dances (khora, sing. khoro) to the accompaniment of their own energetic khorovodni pesni ('dance songs'), or instrumental tunes) (iv) The khoro (\"Few festive events were complete without communal dancing. In addition to sedenki or tlaki, weddings, and calendrical rites, villagers performed a wide variety of khora at community dances held every Sunday afternoon (except during Lent) on the village square or green\"; enumerates additional contexts; \"Most khora were performed to khorovodni pesni ('dance-songs') sung by the dancers themselves ... Customarily these dance-songs were sung antiphonally by two pairs of women located near the front of the line, but could include larger groups of singers. ... A single instrument, often a gayda or gadulka, also commonly accompanied dancing. ... Under the influence of emerging urban ensembles in the 19th and early 20th centuries, two or three svirachi began playing khora together in unison ...\")"}, "madsrdf:citationSource": "Grove music online, December 27, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77fd71ad13f74436a30d7458bc92162cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Horos (Music)"}}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horos (Music)"}}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77fd71ad13f74436a30d7458bc92162cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Khoros (Music)"}}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Khoros (Music)"}}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77fd71ad13f74436a30d7458bc92162cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Khora (Music)"}}, {"@id": "_:n77fd71ad13f74436a30d7458bc92162cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Khora (Music)"}}], "@id": "/authorities/genreForms/gf2019026174"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026001", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGrime (Music)", "identifiers:lccn": "gf2020026001", "madsrdf:adminMetadata": [{"@id": "_:na998508af36d4b3caaed81f63343e624b1"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Grime (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na998508af36d4b3caaed81f63343e624b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027037"}, "madsrdf:hasSource": [{"@id": "_:na998508af36d4b3caaed81f63343e624b5"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b6"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b7"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b8"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b9"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b10"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b11"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na998508af36d4b3caaed81f63343e624b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-04-16T14:33:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Grime (Music)"}}, {"@id": "_:na998508af36d4b3caaed81f63343e624b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Grime (music genre) (Grime is a genre of electronic dance music that emerged in London in the early 2000s. It developed out of earlier UK electronic music styles, including UK garage and jungle, and draws influence from dancehall, ragga, and hip hop. The style is typified by rapid, syncopated breakbeats, generally around 140 bpm, and often features an aggressive or jagged electronic sound. Rapping is a significant element of the style, and lyrics often revolve around gritty depictions of urban life; grime is typified by complex 2-step, 4/4 breakbeats, generally around 140 beats per minute, or sometimes structured around a double-time rhythm, and constructed from different synth, string and electronic sounds)"}, "madsrdf:citationSource": "Wikipedia, Jan. 7, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Grime is a genre of urban music that first emerged in Bow, East London, England in the early 2000s, primarily a development of UK garage, and dancehall; Like other garage variants or mutations, pirate radio stations were essential to the evolution of the genre. Upon its emergence, terms including \"sublow\" (a reference to the very low bassline frequencies, often around 40 Hz), and \"eskibeat\" (a term coined initially by Wiley and his collaborators) were associated with the genre; 2008 to 2010 saw the exposure of grime and grime artists to the mainstream media. Artists such as Dizzee Rascal, Tinie Tempah and Tinchy Stryder enjoyed continued success in the UK singles chart signifying the beginning of a more electropop-orientated direction for the genre)"}, "madsrdf:citationSource": "Grime music, via last.fm website, Jan. 7, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Against All Oddz (Lethal Bizzle album) (Against All Oddz is the first solo album by grime artist Lethal Bizzle)"}, "madsrdf:citationSource": "Wikipedia, Jan. 7, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(During the early 2000s, garage rap grew as an unavoidable mutation of 2-step garage, with the role of the MC elevated from support to star. Groups like So Solid Crew, Pay as U Go Cartel, Dem Lott and Nasty Crew (molded in part in the image of rap crews in the U.S.) surfaced as the popularity of the relatively R&B-based garage scene waned in popularity, but one-man-group the Streets was the style's biggest star. Grime, garage rap's younger sibling, was relatively jagged and aggressive - it's where the legacies of hardcore rap and hardcore techno collide -- and is sometimes downright punishing)"}, "madsrdf:citationSource": "Garage rap/grime music genre overview, via AllMusic website, Jan. 7, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Electronic Dance Music: In the 21st century, genres such as grime and Dubstep have attracted audiences in the UK as well as the United States and abroad)"}, "madsrdf:citationSource": "Grove music online, Jan. 7, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Grime originally came about in London in the early noughties. It emerged from other styles including garage, jungle, and hip hop. Some specific features of grime, however, include a rapid breakbeat of around 130bpm, rapping, and an electronic sound in places)"}, "madsrdf:citationSource": "Lindsay, J. What is grime music?, via Metro website, posted 22 Feb. 2018, viewed on Jan. 7, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(grime music album)"}, "madsrdf:citationSource": "Work cat.: Lethal Bizzle. Against all oddz, \u21172005", "madsrdf:citationStatus": "found"}, {"@id": "_:na998508af36d4b3caaed81f63343e624b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Grime originated in East London, and was created by young people who were inspired by hip-hop's cold swagger and the hyperactivity of dance music but were beholden to neither. Instead, they made music that sounded fresh and bizarre, as if they were tiptoeing through an alien invasion--a raucous collision of exasperated, rapid-fire raps, all-levelling bass lines, and twitchy video-game bleep; grime was a reaction to how posh the world of dance music had become by the late nineties)"}, "madsrdf:citationSource": "Hsu, H. The surprising survival of grime, in The New Yorker, Oct. 1, 2018, viewed online Jan. 7, 2020", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2020026001"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026002", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIntersex fiction", "identifiers:lccn": "gf2020026002", "madsrdf:adminMetadata": [{"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b1"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Intersex fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026063"}, "madsrdf:hasSource": [{"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b5"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b6"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b7"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b8"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b9"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b10"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b11"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b12"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b13"}], "madsrdf:hasVariant": {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b14"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction featuring intersex characters or addressing intersex themes."}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ic"}, "ri:recordStatus": "revised"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intersex fiction"}}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (intersex novels)"}, "madsrdf:citationSource": "Cornwall, S. Reading the writing in the margins, 2018, viewed online Jan. 10, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(juvenile fiction about an intersex child)"}, "madsrdf:citationSource": "Rosen, U. Jill ist anders : ein Kinderbuch zur Intersexualit\u00e4t, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novels where the main or underlying theme is intersexuality)"}, "madsrdf:citationSource": "LGBTQIA: Intersex - Fiction, via Los Angeles Public Library website, Jan. 10, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 37 ([Jeffrey] Eugenides's intersex novel) p. 127 (writers of intersex novels come under heavy scrutiny for signs of \"authenticity\" (perhaps more than writers of cis-gender characters))"}, "madsrdf:citationSource": "Rose, E.A.L. Translating trans identity, 2018, viewed online Jan. 10, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xi (lesbian, gay, bisexual, transgender, and intersex fiction)"}, "madsrdf:citationSource": "Cart, M. Young adult literature, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novel about a teenage girl who discovers she's intersex and what happens when her secret is revealed to the entire school)"}, "madsrdf:citationSource": "Work cat.: Gregorio, I. W. None of the above, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Fifteen-year-old Alyx Atlas starts school in a new state with a new identity--as a girl--but a bully on the basketball court threatens to reveal that Alyx is an intersex person, which could disqualify Alyx and the team from playing in the state championship game)"}, "madsrdf:citationSource": "Birdsall, B. Double exposure, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 271 (trans* and intersex fiction)"}, "madsrdf:citationSource": "Transgender and intersex, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(these characters all provide much-needed representation of people whose bodies don't fit the male/female binary expected in modern society)"}, "madsrdf:citationSource": "Speculative fiction with intersex characters, via Cuil Press website, Jan. 10, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Intersexual fiction"}}, {"@id": "_:nef62d28e5fbd4003ba9cfde8216cd150b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intersexual fiction"}}], "@id": "/authorities/genreForms/gf2020026002"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026003", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlphabet books", "identifiers:lccn": "gf2020026003", "madsrdf:adminMetadata": [{"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb1"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Alphabet books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026096"}, "madsrdf:hasSource": [{"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb5"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb6"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb7"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb8"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb9"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb10"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb11"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb12"}], "madsrdf:hasVariant": [{"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb13"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb16"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb19"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-04-16T14:33:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alphabet books"}}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(alphabet book. SN book used in learning how to read. BT textbook)"}, "madsrdf:citationSource": "European education thesaurus, via WWW, Jan. 15, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ABC books may be rhyming, or feature other sound properties such as alliteration; be illustrative, showing multiple pictures for one letter; involve visual puzzles that require a solution; be based upon popular characters familiar to children; be artistic, where the illustrator or photographer has taken liberties with the shape and form of the letters; or be contextual, providing information about a particular subject; By definition, an alphabet book in the English language is a picture book that shows the sequence of the letters A to Z; concise, rarely exceeding 60 pages and have a consistent organizational pattern, i.e., they almost always go from A to Z. In a few instances, they may go from Z to A, but they are predictable in either instance. Alphabet books are usually focused around a specific concept or theme. The illustrations in alphabet books normally play a major role in the book. In fact, the text and the illustrations must work together in order for the child to gain any benefit; some more advanced alphabet books expand on the sounds of letters and introduce alliteration, onomatopoeia, rhyming, and other sound properties)"}, "madsrdf:citationSource": "Sommer, J. Understanding ABC books : forms of alphabet books and their benefits for children, via WWW, viewed Jan. 15, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ABC book (See: abecedary and alphabet book) abecedary (A book containing the letters of the alphabet and basic rules of spelling and grammar, used in Europe as a primer before the invention of the printing press. Early printed examples (sometimes in the form of a broadsheet) displayed the alphabet in uppercase and lowercase letters in both roman and gothic type, with separate lists of vowels, dipthongs, and consonants. By 1700, some ABC books included children's rhymes. Synonymous with abecedarium (plural: abecedarii). See also: horn book) alphabet book (A picture book for preschool children with illustrations designed to teach the letters and sequence of the alphabet by showing on each page, or double spread, one or more objects, animals, etc., belonging to a class whose name begins with the letter displayed (a for apple, etc.). See also: abecedary and horn book)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS: online dictionary for library and information science, viewed Jan. 15, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(alphabet book: a book for teaching the alphabet; abecedarium, plural abecedaria: alphabet book, primer; abecedary, plural -es: 1 : abecedarium. 2 : abecedarian)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Jan. 15, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alphabet books. SN Use for both alphabet books meant as primers for teaching the alphabet and those intended as vehicles for an illustrator's art. UF Abecedaria; Alphabets (Primers). BT Illustrated works; Textbooks; Wordbooks. NT Alphabet rhymes)"}, "madsrdf:citationSource": "RBMS controlled vocabularies: genre terms, via WWW, Jan. 15, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(alphabet books. SN Books designed to display the letters of the alphabet, often with accompanying illustrations; may be used to teach the alphabet or as vehicles for an illustrator's art. UF ABC books; abecedaria; alphabet-books; alphabets (primers). BT document genres; children's literature; books)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Jan. 15, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(An alphabet book which relates the legend of Cadmus)"}, "madsrdf:citationSource": "Work cat.: Rumford, J. There's a monster in the alphabet, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "ERIC thesaurus online, Jan. 15, 2020;American Folklore Society ethnographic thesaurus, via id.loc.gov, Jan. 15, 2020", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "ABC books"}}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "ABC books"}}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, ABC"}}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, ABC"}}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Abecedaries (Alphabet books)"}}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Abecedaries (Alphabet books)"}}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Alphabet"}}, {"@id": "_:n2fcb553bbb4d4d0299f140b13385519eb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Alphabet"}}], "@id": "/authorities/genreForms/gf2020026003"}
