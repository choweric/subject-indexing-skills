}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-22T15:58:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-10-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Classifications"}}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 111 (The molluscan literature : geographic and taxonomic works; This literature includes works in systematics, taxonomy, biogeographic studies, ecology, aquaculture, anatomy, physiology, and paleontology, just to name a few)"}, "madsrdf:citationSource": "The mollusks : a guide to their study, collection, and preservation, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(classification: 2 a. systematic arrangement in groups or categories according to established criteria, specifically : taxonomy. b. class, category; taxonomy: classification, especially : orderly classification of plants and animals according to their presumed natural relationships)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Oct. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)641080"}, "madsrdf:citationSource": "Z'graggen, J. A. Classificatory and typological studies in languages of the Madang District, 1971.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)25375642"}, "madsrdf:citationSource": "Soil series of the United States, including Puerto Rico and the U.S. Virgin Islands : their taxonomic classification, 1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "jkt. (In this book, Colin Groves proposes a complete taxonomy of living primates, reviewing the history and practice of their classification and providing an up-to-date synthesis of recent molecular and phylogenetic research) contents (includes: Taxonomy of Primates above the family level -- A classification of Primates to family level)"}, "madsrdf:citationSource": "Groves, Colin P. Primate taxonomy, \u00a92001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(taxonomy, noun, plural taxonomies. 1. the science or technique of classification. 2. a classification into ordered categories. 3. Biology. the science dealing with the description, identification, naming, and classification of organisms)"}, "madsrdf:citationSource": "Dictionary.com, Oct. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (The Chiliotrichum Group sensu lato (Compositae: Astereae) comprises 11 genera and 31 species distributed from Colombia to Tierra del Fuego, and it is composed of four main clades: the Chiliotrichum clade (composed of Aylacophora, Chiliophyllum, Chiliotrichum, and Lepidophyllum), the Haroldia clade (composed of Haroldia), the Llerasia clade (composed of Llerasia and Ocyroe), and the Nardophyllum clade (composed of Cabreraea, Chiliotrichiopsis, Katinasia, and Nardophyllum). A taxonomic revision is presented for Chiliotrichum, Haroldia, and Nardophyllum clades, which are referred to here as Chiliotrichum Group sensu stricto) p. 16 (taxonomic treatment) (OCoLC)919930443"}, "madsrdf:citationSource": "Work cat.: Bonifacino, Jos\u00e9 M. Taxonomic revision of the Chiliotrichum group sensu stricto (Compositae: Astereae), 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A taxonomy (or taxonomical classification) is a scheme of classification, especially a hierarchical classification, in which things are organized into groups or types)"}, "madsrdf:citationSource": "Wikipedia, Oct. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)896435468"}, "madsrdf:citationSource": "Hlava, Marjorie M. K. Principles and practices of building taxonomies, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)42746572"}, "madsrdf:citationSource": "Capo, Hounkpati B. C. A classification of the languages of Benin, \u00a91998.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)422876297"}, "madsrdf:citationSource": "Gaya, Ester. Taxonomical revision of the Caloplaca saxicola group (Teloschistaceae, lichen-forming Ascomycota), 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (handbook grouping the crops, timber, and common ornamental plants found in East Africa into 26 classes. The plants are discussed under two broad categories, namely usage and commercial classifications) (OCoLC)933516520"}, "madsrdf:citationSource": "Kokwaro, J. O. Classification of East African crops, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivision --Classification. Use as a form subdivision under classes of persons and topical headings for works that consist of a systematic breakdown of a subject into its constituent categories or subtopics.)"}, "madsrdf:citationSource": "LCSH, Oct. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Taxonomies"}}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Taxonomies"}}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Taxonomical works"}}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Taxonomical works"}}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Classificatory works"}}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Classificatory works"}}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Taxonomic works"}}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Taxonomic works"}}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Taxonomic classifications"}}, {"@id": "_:n9794dc9c93e547b88c90f13700f58ca0b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Taxonomic classifications"}}], "@id": "/authorities/genreForms/gf2022026085"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026086", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSoftware", "identifiers:lccn": "gf2022026086", "madsrdf:adminMetadata": [{"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb1"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Software"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb5"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb6"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb7"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb8"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb9"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb10"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb11"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb12"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb13"}], "madsrdf:hasVariant": [{"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb14"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb17"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb20"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb23"}], "madsrdf:historyNote": "[Established March 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Computer system programs, procedures, and associated documentation that are tools to perform tasks, for example, systems software, utilities, or applications programs."}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-08T09:05:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-10-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Software"}}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (RootsMagic is the award-winning genealogy software white makes researching, organizing, and sharing your family history easy)"}, "madsrdf:citationSource": "RootsMagic 7 : genealogy & family tree software, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Software. Software, in its most general sense, is a set of instructions or programs instructing a computer to do specific tasks. Software is a generic term used to describe computer programs that run on PCs, mobile phones, tablets, or other smart devices. Software is often used to describe all the functional aspects of a computer that do not refer to its physical components (hardware). Scripts, applications, programs and a set of instructions are all terms often used to describe software. Everything that \"runs\" on a computer, from an operating system, to a diagnostic tool, video game, or app can be defined as software. Four categories of software: Programming software; System software; Application software; Malicious software (malware); Application software is intended to perform certain tasks. Examples of application software include office suites, gaming applications, database systems and educational software. Application software can be a single program or a collection of small programs. This type of software is what consumers most typically think of as \"software\")"}, "madsrdf:citationSource": "Techopedia, Oct. 13, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(software. Computer system programs, procedures, and associated documentation concerned with the operation of data processing systems, and which require hardware for use to be made of them. For individual collections or sequences of code provided by a user to perform a particular task, use \"programs.\" For programs that serve a particular purpose and that may be packaged and sold by a manufacturer use \"applications.\" BT electronic documents. Hierarchical position: information forms (objects) > document genres > documents by form > electronic documents)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Oct. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Software. SN Sequential operating programs and data which instruct the functioning of a digital computer. UF Computer Applications Software; Computer Programs; Computer Programs and Programming; Computer Software; Computer Software Applications; Open Source Software; Software Engineering; Software Tools)"}, "madsrdf:citationSource": "MeSH browser, Oct. 13, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(software, instructions that tell a computer what to do. Software comprises the entire set of programs, procedures, and routines associated with the operation of a computer system. The term was coined to differentiate these instructions from hardware--i.e., the physical components of a computer system. A set of instructions that directs a computer's hardware to perform a task is called a program, or software program. The two main types of software are system software and application software. System software controls a computer's internal functioning, chiefly through an operating system, and also controls such peripherals as monitors, printers, and storage devices. Application software, by contrast, directs the computer to execute commands given by the user and may be said to include any program that processes data for a user. Application software thus includes word processors, spreadsheets, database management, inventory and payroll programs, and many other \"applications.\" A third software category is that of network software, which coordinates communication between the computers linked in a network.)"}, "madsrdf:citationSource": "Britannica online, Oct. 13, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivision --Software. Use as a form subdivision under topical headings for computer programs that are tools to perform tasks, for example, systems software, utilities, or applications programs; topical heading Computer software. UF Software, Computer. BT Computer systems. SN Here are entered general works on computer programs accompanied by documentation such as manuals, diagrams and operating instructions, etc. Works limited to computer programs are entered under Computer programs)"}, "madsrdf:citationSource": "LCSH, Oct. 13, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(series statement: On-track software; subj. hdgs.: Multiplication--Software; Division--Software)"}, "madsrdf:citationSource": "Multiplication, division : grades 3-4, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(publisher: Archer Software; subj. hdg.: Names, Personal--Great Britain--Maps--Software.) \"System requirements\" screen (\"The program runs in a fixed size window of 1000 x 700 pixels, regardless of screen resolution. The physical size of this window will depend on your screen resolution, e.g. it will appear smaller if you use 1600 x 1200 etc.\")"}, "madsrdf:citationSource": "The British nineteenth century surname atlas, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(software: 1. (Computers). the programs used to direct the operation of a computer, as well as documentation giving instructions on how to use them.)"}, "madsrdf:citationSource": "Dictionary.com, Oct. 13, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Applications software"}}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Applications software"}}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Computer applications software"}}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Computer applications software"}}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Computer software"}}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Computer software"}}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Application software"}}, {"@id": "_:nf25b066e9f0c46ae86e26676b8c4002bb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Application software"}}], "@id": "/authorities/genreForms/gf2022026086"}
