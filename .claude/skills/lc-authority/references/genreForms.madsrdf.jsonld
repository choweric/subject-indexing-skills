{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026782", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEcossaises (Music)", "identifiers:lccn": "gf2014026782", "madsrdf:adminMetadata": [{"@id": "_:n9e36e778bb73405b961d87436580cd3db1"}, {"@id": "_:n9e36e778bb73405b961d87436580cd3db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ecossaises (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9e36e778bb73405b961d87436580cd3db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026737"}, "madsrdf:hasSource": [{"@id": "_:n9e36e778bb73405b961d87436580cd3db5"}, {"@id": "_:n9e36e778bb73405b961d87436580cd3db6"}, {"@id": "_:n9e36e778bb73405b961d87436580cd3db7"}, {"@id": "_:n9e36e778bb73405b961d87436580cd3db8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9e36e778bb73405b961d87436580cd3db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n9e36e778bb73405b961d87436580cd3db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9e36e778bb73405b961d87436580cd3db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ecossaises (Music)"}}, {"@id": "_:n9e36e778bb73405b961d87436580cd3db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\u00e9cossaise; history obscure; may or may not have been of Scottish origin)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e36e778bb73405b961d87436580cd3db6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Schubert, F. Ecossaise D. 145/8, c1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e36e778bb73405b961d87436580cd3db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ecossaise)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e36e778bb73405b961d87436580cd3db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\u00e9cossaise; a type of contredanse popular in France in the late 18th cent.; also cultivated esp. in Vienna in the early 19th cent.)"}, "madsrdf:citationSource": "New Harvard dict. of music", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026782"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026783", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aElectronica (Music)", "identifiers:lccn": "gf2014026783", "madsrdf:adminMetadata": [{"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b1"}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Electronica (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026971"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027122"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027185"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026006"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026046"}], "madsrdf:hasSource": [{"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b5"}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b6"}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b7"}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b8"}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Electronica (Music)"}}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Electronica; electronic dance music geared to listening instead of strictly dancing; later appropriated by the American press as an easy catch-all for practically any young artist using electronic equipment and/or instruments, but electronica serves to describe techno-based music that can be used for home listening as well as on the dance floor)"}, "madsrdf:citationSource": "Allmusic WWW site, May 20, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 150 (electronica; refers to all popular/non-academic electronic music)"}, "madsrdf:citationSource": "Living through pop, 1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 634 (Electronica; refers primarily to artists drawing heavily on dance music styles in ways not simply derivative of the dancefloor; composed, listener-oriented songs)"}, "madsrdf:citationSource": "All music guide to electronica, c2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Encyc. of pop. mus., 2006", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n396e5249ba9d4b2c96a3a5e9b1d25df4b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP galley (electronica; refers to popular music created exclusively by synthesizers or other electronic means)"}, "madsrdf:citationSource": "Work cat.: 2010019842: Kraftwerk, 2010:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026783"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026784", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEmo (Music)", "identifiers:lccn": "gf2014026784", "madsrdf:adminMetadata": [{"@id": "_:n33e2c5e5a6de4594a46bef770854186eb1"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Emo (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n33e2c5e5a6de4594a46bef770854186eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026850"}, "madsrdf:hasSource": [{"@id": "_:n33e2c5e5a6de4594a46bef770854186eb5"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb6"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb7"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb8"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb9"}], "madsrdf:hasVariant": [{"@id": "_:n33e2c5e5a6de4594a46bef770854186eb10"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Emo (Music)"}}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Emo (music): Emo is a subgenre of hardcore punk music; \"emocore\" is short for \"emotional hardcore\")"}, "madsrdf:citationSource": "Wikipedia WWW site, Nov. 21, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Emo is a broad title that covers a lot of different styles of emotionally-charged punk rock, with little agreement as to its beginnings. One school subscribes to its having started in Washington, D.C. in the mid-'80s, moving from hardcore punk bands toward a distinctive distorted guitar sound. Recordings tend to be analog only, and most records are put out on small home-run, or private, labels)"}, "madsrdf:citationSource": "What the heck is Emo anyway? WWW site, Aug. 1, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Shuker, R. Key concepts in popular music, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP, p. 7 (Emo is short for emotional; originally short for Emocore)"}, "madsrdf:citationSource": "Work cat.: 2003058543: Greenwald, A. Nothing feels good : punk rock, teenagers, and EMO, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(One of the more popular underground rock styles at the turn of the millenium; some emo leans toward the progressive side, full of complex guitar work, unorthodox song structure, arty noise, and extreme dynamic shifts; some emo is much closer to punk-pop. Lyrics are deeply personal and can be prone to excess; groundwork for emo was laid by H\u00fcsker D\u00fc in 1984 with its Zen arcade); Nov. 21, 2006 (emo: originally an arty outgrowth of hardcore punk))"}, "madsrdf:citationSource": "All music guide WWW site, Aug. 1, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n33e2c5e5a6de4594a46bef770854186eb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Emocore (Music)"}}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Emocore (Music)"}}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n33e2c5e5a6de4594a46bef770854186eb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Emotional hardcore (Music)"}}, {"@id": "_:n33e2c5e5a6de4594a46bef770854186eb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Emotional hardcore (Music)"}}], "@id": "/authorities/genreForms/gf2014026784"}
