ew"}, {"@id": "_:n20974689b1a741d39022112ac74da596b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Music videos"}}, {"@id": "_:n20974689b1a741d39022112ac74da596b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 68 (Music videos: use for short video pieces which have as a primary purpose the recording of a popular music performance, usually rock music, and usually accompanied by elaborate visuals)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n20974689b1a741d39022112ac74da596b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Music videos: generally short works that feature a song, performer, or musical group, sometimes structured narratively and accompanied by highly stylized visuals or a series of images to convey a mood)"}, "madsrdf:citationSource": "Moving image genre-form guide online, January 7, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026413"}
