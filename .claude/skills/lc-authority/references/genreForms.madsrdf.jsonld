Value": {"@language": "en", "@value": "Kyriales"}}, {"@id": "_:na34fa79600db4bf4ba9e1dd432995afeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(kyriale; kyrial)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:na34fa79600db4bf4ba9e1dd432995afeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Liturgical books: a modern book ... with the chants of the Ordinary)"}, "madsrdf:citationSource": "New Harvard dict. of music", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026901"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026902", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aL\u00e4ndler (Music)", "identifiers:lccn": "gf2014026902", "madsrdf:adminMetadata": [{"@id": "_:n99e472d1816349dd9b46f483847c7561b1"}, {"@id": "_:n99e472d1816349dd9b46f483847c7561b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "L\u00e4ndler (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n99e472d1816349dd9b46f483847c7561b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n99e472d1816349dd9b46f483847c7561b5"}, {"@id": "_:n99e472d1816349dd9b46f483847c7561b6"}], "madsrdf:hasVariant": {"@id": "_:n99e472d1816349dd9b46f483847c7561b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n99e472d1816349dd9b46f483847c7561b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-09-15T11:04:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n99e472d1816349dd9b46f483847c7561b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n99e472d1816349dd9b46f483847c7561b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "L\u00e4ndler (Music)"}}, {"@id": "_:n99e472d1816349dd9b46f483847c7561b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A folkdance in 3/4 time of varying speed: generally fast in the west (Switzerland and the Tyrol) and slow in the east (Styria, Upper and Lower Austria). Before the dissemination of the waltz, mazurka and polka in the 19th century, the l\u00e4ndler was the most common folkdance in Austria, south Germany and German Switzerland. It also existed in Bohemia, Moravia, Slovenia and northern Italy, and in some areas it is still popular today.)"}, "madsrdf:citationSource": "Grove music online, viewed Aug. 12, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n99e472d1816349dd9b46f483847c7561b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(... Composers such as J.H. Schmelzer wrote ballet suites containing l\u00e4ndlers ...)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Aug. 1, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n99e472d1816349dd9b46f483847c7561b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n99e472d1816349dd9b46f483847c7561b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "L\u00e4ndlers (Music)"}}, {"@id": "_:n99e472d1816349dd9b46f483847c7561b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "L\u00e4ndlers (Music)"}}], "@id": "/authorities/genreForms/gf2014026902"}
