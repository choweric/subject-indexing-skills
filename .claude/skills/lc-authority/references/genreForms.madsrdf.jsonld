8ffc0e2336d69b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Western plays"}}, {"@id": "_:nd611d20eccb34323a9b8ffc0e2336d69b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Finch, R. Nine western plays, 1949.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd611d20eccb34323a9b8ffc0e2336d69b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Dumont, F. The half-breed : a western drama in three acts, 1914.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd611d20eccb34323a9b8ffc0e2336d69b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(listed under Category: Western (genre) plays: Arizona (play); Green Grow the Lilacs (play); Oklahoma!; The Squaw Man (play); Tombstone's Main Event: A Tragedy at the O.K. Corral)"}, "madsrdf:citationSource": "Wikipedia, Mar. 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd611d20eccb34323a9b8ffc0e2336d69b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd611d20eccb34323a9b8ffc0e2336d69b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Western drama"}}, {"@id": "_:nd611d20eccb34323a9b8ffc0e2336d69b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Western drama"}}, {"@id": "_:nd611d20eccb34323a9b8ffc0e2336d69b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd611d20eccb34323a9b8ffc0e2336d69b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Westerns (Drama)"}}, {"@id": "_:nd611d20eccb34323a9b8ffc0e2336d69b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Westerns (Drama)"}}], "@id": "/authorities/genreForms/gf2014026595"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026596", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aXiang sheng", "identifiers:lccn": "gf2014026596", "madsrdf:adminMetadata": [{"@id": "_:n679677ab32a444d49a5bc19ac234792cb1"}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Xiang sheng"}, "madsrdf:elementList": {"@list": [{"@id": "_:n679677ab32a444d49a5bc19ac234792cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, "madsrdf:hasSource": [{"@id": "_:n679677ab32a444d49a5bc19ac234792cb5"}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb6"}], "madsrdf:hasVariant": [{"@id": "_:n679677ab32a444d49a5bc19ac234792cb7"}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb10"}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Chinese comedic performances that usually consist of a dialogue between two performers."}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:12:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Xiang sheng"}}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Xiangsheng (pinyin: xi\u00e0ngsheng; literally \"mutual voice\"), sometimes translated as cross-talks, is a traditional Chinese comedic performance in the form of a dialogue between two performers, or, much less often, a solo monologue or, even less frequently, a multi-player talk show. The language, rich in puns and allusions, is delivered in a rapid, bantering style. Xiangsheng is one of China's foremost and most popular performing arts, and is typically performed in the Tianjin dialect (or in Standard Chinese with a strong Northern Chinese accent). Xiangsheng rose as a performing act during the Ming Dynasty. From the Qing Dynasty to the 1920s, xiangsheng gradually developed to become a style of comedic monologue. Later xiangsheng came to be performed as a dialogue and sometimes even in groups of three or more.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(xiangsheng, hsiang sheng. A form of storytelling (quyi) which developed in the mid-19th C in Beijing and is popular today throughout China; often translated as comedy act, comic duo, comic dialogue, or cross-talk. Most performances are in Beijing dialect, although a regional dialect is sometimes used. There are three main styles of performance: one in which a single comedian tells jokes (dankou or tan k\u02bcou), one in which a comedian plays off a straight man (duikou or tui k\u02bcou), and one which features three or more performers (qunkou or ch\u00fcn kou). Performances in many respects resemble those of clown role (chou) actors in Beijing opera (jingju) and many other forms of music-drama (xiqu))"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n679677ab32a444d49a5bc19ac234792cb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hsiang sheng"}}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hsiang sheng"}}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n679677ab32a444d49a5bc19ac234792cb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cross-talks"}}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cross-talks"}}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n679677ab32a444d49a5bc19ac234792cb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Xiangsheng"}}, {"@id": "_:n679677ab32a444d49a5bc19ac234792cb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Xiangsheng"}}], "@id": "/authorities/genreForms/gf2014026596"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026597", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aYue fu", "identifiers:lccn": "gf2014026597", "madsrdf:adminMetadata": [{"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b1"}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Yue fu"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b5"}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b6"}], "madsrdf:hasVariant": [{"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b7"}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Chinese poems derived from folk songs."}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:11:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yue fu"}}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ancient poems : yuefu songs, 2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(yuefu, Wade-Giles romanization y\u00fceh-fu, form of Chinese poetry derived from the folk-ballad tradition. The yuefu takes its name from the Yuefu (\"Music Bureau\") created in 120 bc by Wudi of Han for the purpose of collecting songs and their musical scores for ceremonial occasions at court. The music for these songs was later lost, but the words remained, forming a collection of Han dynasty (206 bc-ad 220) folk poetry that served as the basis of the yuefu form. These poems were significant because they consisted of lines of varying lengths, some having a regular form of five syllables per line rather than the then-standard four-syllable line. The yuefu thus broke ground for the later classic gushi (\"ancient-style poetry\"), with its broader use of rhyme and fewer metrical restrictions. Many later writers, including the great Li Bai (701-762) and Bai Juyi (772-846), continued to create poems derived from the yuefu tradition.)"}, "madsrdf:citationSource": "Britannica online, Aug. 13, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yuefu"}}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yuefu"}}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Y\u00fceh fu"}}, {"@id": "_:ne1e4fc3e548b46bda1cc64585cd8c327b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Y\u00fceh fu"}}], "@id": "/authorities/genreForms/gf2014026597"}
