df:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays in which the audience is kept on tenterhooks by plots that feature a build-up of suspense, tension, uncertainty, menace, and anxiety."}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:24:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thriller plays"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hooke, N.W. Deadly record : a suspense play in three acts, \u00a91965.", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Reach, J. Bear witness : a suspense drama in two acts, \u00a91970.", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Manchester, J. Run, thief, run! : a suspense play in one act, \u00a91964.", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Brady, M.J. Hunchback House : a thriller-drama in one act, 1946?", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hide and Seek, Lezley Havard. Full Length, Thriller. Set in a long abandoned farmhouse, which is being refurbished by its new owners, this suspense-filled and gripping play blends present terror with past mysteries as it probes into the chilling secrets which the old house yields only at great peril to the present occupants. \"...cleverly contrived to keep audiences gasping as the unexpected ceaselessly unfolds.\" --Variety. \"Any broadway season is better off with a new suspense thriller...\" --NY Post. \"Broadway's newest and finest fist clenching, scrunching in your seat, richly complex, beautifully acted thriller.\" --CBS-TV)"}, "madsrdf:citationSource": "Dramatists Play Service web page for Hide and seek, viewed Mar. 7, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Post, D. Murder in Green Meadows : a psychological thriller for the stage, \u00a91996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Slade, B. Fatal attraction : a thriller in two acts, \u00a91986.", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ludlam, C. The artificial jungle : a suspense thriller, \u00a91987.", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Oberon modern plays)"}, "madsrdf:citationSource": "Mortimer-Smith, R. Guilty secret : a thriller in two acts, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kelly, T.J. The zombie : a stage thriller in three acts, \u00a91983.", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Category: Plays by genre: Thriller plays)"}, "madsrdf:citationSource": "Wikipedia, Mar. 9, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a paranormal thriller play)"}, "madsrdf:citationSource": "Work cat.: Havard, L. Hide and seek, \u00a91980", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Thrillers/Horrors: Lonely Birds and Shadow Figures - Psycho Thriller script; You do love me, don't you? A Scary Psycho Thriller in One Act; Scream - one act suspense thriller)"}, "madsrdf:citationSource": "Off the Wall Plays website, Mar. 9, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (A thriller in two acts)"}, "madsrdf:citationSource": "Darby, B. Three-quarter moon : a thriller, \u00a92009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb19", "@type": "madsrdf:Source", "madsrdf:citationSource": "Best mystery and suspense plays of the modern theatre, 1971.", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb20", "@type": "madsrdf:Source", "madsrdf:citationSource": "McGullion, B. Murdermind : a psychological thriller in two acts, \u00a91994.", "madsrdf:citationStatus": "found"}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951ea36953aa4830abf63f41f023fe5bb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suspense thrillers (Drama)"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suspense thrillers (Drama)"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951ea36953aa4830abf63f41f023fe5bb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stage thrillers"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stage thrillers"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951ea36953aa4830abf63f41f023fe5bb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psychological thrillers (Drama)"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psychological thrillers (Drama)"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951ea36953aa4830abf63f41f023fe5bb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suspense plays"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suspense plays"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951ea36953aa4830abf63f41f023fe5bb34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Thriller drama"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thriller drama"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951ea36953aa4830abf63f41f023fe5bb37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suspense drama"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suspense drama"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951ea36953aa4830abf63f41f023fe5bb40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psycho thrillers (Drama)"}}, {"@id": "_:n951ea36953aa4830abf63f41f023fe5bb40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psycho thrillers (Drama)"}}], "@id": "/authorities/genreForms/gf2017026045"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026046", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSuperhero plays", "identifiers:lccn": "gf2017026046", "madsrdf:adminMetadata": [{"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b1"}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Superhero plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b5"}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b6"}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b7"}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b8"}], "madsrdf:hasVariant": [{"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b9"}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:24:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Superhero plays"}}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Summary: A group of inept amateur superheroes must try to save the day when a supervillain threatens to destroy a major superhero and the city. Screenplay for the motion picture The mystery men)"}, "madsrdf:citationSource": "Cuthbert, N. The mystery men, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (Oberon modern plays) p. 4 of cover (Sam McTannan is just a typical 15-year-old, with one exception. Sam is a Superhero! He can literally turn See-Thru when it suits him, only today something is wrong. In Superhero comics they would call it a blip. Sam's powers are failing him and the people he doesn't want to see him start paying a little bit too much attention. The story of an ordinary boy with an extraordinary life. A heartbreaking, life-affirming comedy about life, love and being a total loser)"}, "madsrdf:citationSource": "Work cat.: McKnight, J. The incredible adventures of See Thru Sam, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Summary: A superhero noir comedy about the dangers of love. The city's heart beats with fear: Doctor X is sneaking into apartments and injecting lovers with a lethal poison. Lisa's heart beats with hope: Now that she's joined the elite Crimefighters, maybe she can live a life with meaning. And every beat of Peter's wounded heart brings him closer to death, but he's designing an artificial replacement that will never break. Can the Crimefighters stop Doctor X? Do Peter and Lisa have a chance at love? And who is the girl with a face like a plate?)"}, "madsrdf:citationSource": "Szymkowicz, A. Hearts like fists, c2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Summary: Over the years, Megamind, has tried to conquer Metro City in every imaginable way. Each attempt, a colossal failure thanks to the caped superhero known as 'Metro Man,' until the day Megamind actually defeats him in the throes of one of his botched evil plans. Suddenly, the fate of Metro City is threatened when a new villain arrives and chaos runs rampant, leaving everyone to wonder if the world's biggest 'mind' can actually be the one to save the day?)"}, "madsrdf:citationSource": "Schoolcraft, A. Megamind : [screenplay], 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supervillain plays"}}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supervillain plays"}}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Superhero drama"}}, {"@id": "_:n2052ce4bd2bc4f2db7d8e0f6403e9e32b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Superhero drama"}}], "@id": "/authorities/genreForms/gf2017026046"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026047", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNoir plays", "identifiers:lccn": "gf2017026047", "madsrdf:adminMetadata": [{"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b1"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Noir plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026281"}, "madsrdf:hasSource": [{"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b5"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b6"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b7"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b8"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b9"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b10"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b11"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b12"}], "madsrdf:hasVariant": [{"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b13"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b16"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b19"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays about crime and detection that feature violence, treachery, and a lack of distinction between criminals and heroes."}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:24:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noir plays"}}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Overtime Theater presents The Hard Bargain, a \"stage noir\" detective story written by Scott McDowell and directed by Andrew Thornton. \"The Hard Bargain\" brings back gritty detectives Blake and Winters from a previous film noir play called \"The Good Samaritan\"; playwright Tracy Letts, who won a Tony Award for the complex, powerful family drama, \"August: Osage County,\" and developed an off-Broadway cult following for his noir plays, \"Bug\" and \"Killer Joe\")"}, "madsrdf:citationSource": "ProQuest database search, Mar. 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "prelim. p. (David Landau is an award-winning screenwriter and mystery playwright ... His noir play Deep Six Holiday, inspired by the work of James Cain, won several theater awards)"}, "madsrdf:citationSource": "Landau, D. Film noir production, 2017, via Google books, viewed Mar. 8, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Author: Dewan Demmer. Genre: Film Noir + Comedy + Crime. Meet Ralph Spade, trying to make a living as a Private Eye in his cheap downtown office. When Sam Malone comes to Ralph, to investigate the disappearance of his girlfriend, Ralph takes the case. Ralph, the detective is a colourful character whose brain is a sharp as a knife, but has also been muddled by years of alcohol. When it turns out that the parrot is also dead in this tongue in cheek film noir play, things take a bizarre twist in this off the wall Monty Python meets Film Noir style comedy)"}, "madsrdf:citationSource": "Ralph : a funny film noir play, via Off the Wall Plays website, viewed Mar. 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 78-82 (theater noir; plays that attempt to stage noir style on mainstream (Broadway or off-Broadway) stages include Eric Overmyer's Dark Rapture (1996); the musical City of Angels (1992) with music by Cy Coleman and book by Larry Gelbert; and Adrift in Macao (2007), a musical by Christopher Durang; In addition to City of Angels, Adrift in Macao, and Dark Rapture, noir theater has frequently appeared on regional and even international stage; In January 2007, Stolen Chair Theatre Company in New York presented Kill Me Like You Mean It, a new noir play by Kiran Rikhye; mainstream noir plays evoke the genre nostalgically and affectionately; contemporary noir theater; mainstream stagings of noir style; the noir musical: City of Angels and Adrift in Macao; City of Angels adapts of the noir genre to the theater by using film techniques to stage a film within a play) pp. 108-109 (noir plays such as Zoot Suit, Water and Power, and Chavez Ravine; noir plays such as Dark Rapture) p. 121 (Plays that choose to adapt the noir style to the stage draw on conventions of the genre to create a sense of opposition to powerful and oppressive outside forces that threaten the individual)"}, "madsrdf:citationSource": "Eschen, N.M. Performing the past, 2008, via ProQuest, viewed Mar. 8, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Hard Bargain, playwright Scott McDowell's sequel to his noir drama The Good Samaritan, premieres Friday at the Overtime Theater. This time out, the hard-boiled detectives' attempt to get to the bottom of a murder sends them into the world of smoky jazz clubs and femme fatales galore) Jan. 10, 2010 (\"The Hard Bargain.\" Overtime Theater. Detectives Blake and Winters from \"The Good Samaritan\" return to another noir play to solve a seemingly impossible murder)"}, "madsrdf:citationSource": "San Antonio express-news, Jan. 7, 2010, via NewsBank, viewed Mar. 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Summary: A superhero noir comedy about the dangers of love. The city's heart beats with fear: Doctor X is sneaking into apartments and injecting lovers with a lethal poison. Lisa's heart beats with hope: Now that she's joined the elite Crimefighters, maybe she can live a life with meaning. And every beat of Peter's wounded heart brings him closer to death, but he's designing an artificial replacement that will never break. Can the Crimefighters stop Doctor X? Do Peter and Lisa have a chance at love? And who is the girl with a face like a plate?)"}, "madsrdf:citationSource": "Work cat.: Szymkowicz, A. Hearts like fists, c2013", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Take a trip back to Hollywood's Golden Age with seven short plays of comedy and drama that revel in all things noir -- and are all set right here in the City of Angels. Returning to the Actors Workout Studio for a fifth year, Play Noir teems with hard-boiled private detectives, double-crossing femme fatales, unscrupulous villains and plenty of intrigue. This year's thrilling show features John Conroy's The Rotten State, April Littlejohn's Nobody's Whore, Bill Doncaster's Dumb Muscle, Stephen Baily's For You, Julius, Cherry by Scott Lumer, Jeff Carter's Just Business and Rabbi Noir by Chris Karmiol)"}, "madsrdf:citationSource": "Play noir : seven short noir plays set in L.A., via WWW, viewed Mar. 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Author: David Schmidt Genre: Whodunit, Crime. It is the 1940's - the era of hard boiled detectives and gangsters. Nick Holliday, PI and his girl Friday Dora Chase are hired by a grieving widow to find the murderer of her husband, an art gallery owner named Peter DeLucci. But as Nick and Dora soon find out there is nothing routine about this case, as they run afoul of a Numbers Racketeer and a shadowy underworld figure calling themselves the Sicilian all leading to an ending that is sure to surprise)"}, "madsrdf:citationSource": "Parlor City noir - whodunit scripts, via Off the Wall Plays website, viewed Mar. 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Film noir plays"}}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film noir plays"}}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Noir drama"}}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noir drama"}}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stage noir"}}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stage noir"}}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crime noir plays"}}, {"@id": "_:ne6da0f8595554a2d8cdc6989c80cf196b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crime noir plays"}}], "@id": "/authorities/genreForms/gf2017026047"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026048", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBoard games", "identifiers:lccn": "gf2017026048", "madsrdf:adminMetadata": [{"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b1"}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Board games"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, "madsrdf:hasSource": [{"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b5"}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b6"}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b7"}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b8"}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/mwalb"}, "ri:recordStatus": "new"}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:34:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Board games"}}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Board games; BT Games; NT Backgammon; Checkers; Chess; Mah jong)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Mar. 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Board game; a game of strategy (as checkers, chess, or backgammon) played by moving pieces on a board)"}, "madsrdf:citationSource": "Merriam-Webster online, Mar. 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "back of box (Cranium is the hip, new, outrageously fun board game that brings friends together...)"}, "madsrdf:citationSource": "Work cat.: Cranium, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(board games (game sets). Game sets for activities that involve the moving of game pieces across a gameboard; BT card, table and board game sets)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Mar. 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dd587137dfb4cdcaa71a00e57d2acc2b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "ERIC thesaurus ;Genre terms : a thesaurus for use in rare book and special collections cataloging", "madsrdf:citationStatus": "notfound"}], "@id": "/authorities/genreForms/gf2017026048"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026049", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEcopoetry", "identifiers:lccn": "gf2017026049", "madsrdf:adminMetadata": [{"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b1"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ecopoetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026111"}, "madsrdf:hasSource": [{"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b5"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b6"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b7"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b8"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b9"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b10"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b11"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b12"}], "madsrdf:hasVariant": [{"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b13"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b16"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b19"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Nature poetry that focuses on environmental and ecological themes and often portrays nature as threatened by human activities."}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:24:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ecopoetry"}}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Environment and poetry (Environmental poetry, or ecopoetry, is related to the broader genre of nature poetry but can be distinguished from it by its portrayal of nature as threatened by human activities (see Nature). Scattered examples of such concerns appear throughout the hist. of poetry, but clusters of poems about the natural world endangered by humans are apparent above all in Eur. romanticism and in poetry connected to the rise of the mod. environmentalist movement since the 1960s. The emergence of environmentally oriented literary and cultural crit.--or ecocriticism, for short--since the early 1990s has substantially contributed not only to the study of such poetry but also to a new look at nature poetry more broadly conceived)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xvii (nature writing as a category has expanded to include environmental poetry, variously labeled nature poetry or ecopoetry)"}, "madsrdf:citationSource": "Twentieth-century American nature writers : prose, c2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (In contrast to nature poets of the past who tended more toward the bucolic and pastoral, many contemporary nature poets are taking up radical environmental and ecological themes) pref. (poets writing from an environmental perspective; contemporary nature poetry, much of which has come to be called \"ecopoetry\"; Although the term \"ecopoetry\" seems to be acquiring a certain amount of critical momentum, a definitive name for the current environmentally aware version of nature poetry has not been clearly established; Recent critics in particular, however, have attempted to define the new brand of nature poetry. Gifford assigns the term \"green poetry\" to \"those recent nature poems which engage directly with environmental issues\". And Scigaj writes that we \"might define ecopoetry as poetry that persistently stresses human cooperation with nature conceived as a dynamic, interrelated series of cyclic feedback systems\". He distinguishes ecopoetry from what he calls \"environmental poetry,\" which \"reveres nature and often focuses on particular environmental issues, but without the ecopoet's particular concentration on nature as an interrelated series of cyclic feedback systems\"; ecopoetry is a mode that, while adhering to certain conventions of traditional nature poetry, advances beyond that tradition and takes on distinctly contemporary problems and issues, thus becoming generally marked by three primary characteristics: an ecological and biocentric perspective recognizing the interdependent nature of the world; a deep humility with regard to our relationships with human and nonhuman nature; and an intense skepticism toward hyperrationality, a skepticism that usually leads to condemnation of an overtechnologized modern world and a warning concerning the very real potential for ecological catastrophe. These attributes characterize ecopoetry as a mode that both connects with and diverges from earlier versions of nature poetry. While ecopoems are indeed simply the latest in a long line of nature poetry, they also are in some ways a new type of poem; ecopoets are aiming at a poetics that presents the world community as just that, a community, rather than a world of creatures and natural beings with whom the privileged human self interacts)"}, "madsrdf:citationSource": "Bryson, J.S. The west side of any mountain : place, space, and ecopoetry, \u00a92005, via Project Muse online, viewed Mar. 8, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Earth songs : a Resurgance anthology of contemporary eco-poetry, 2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: The ecopoetry anthology, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an ecopoem needs to be environmental and it needs to be environmentalist. By environmental, I mean first that an ecopoem needs to be about the nonhuman natural world--wholly or partly, in some way or other, but really and not just figuratively. In other words, an ecopoem is a kind of nature poem. But an ecopoem needs more than the vocabulary of nature; ecopoets cannot be naive about matters of perception and poetic representation, which are biologically and culturally specific (a bee's world is not a human's); the second way in which an ecopoem is environmental is that it is ecocentric, not anthropocentric. Human interests cannot be the be-all and end-all of an ecopoem; environmental poetry; An ecopoem must be not only environmental but environmentalist. First, the environment of an ecopoem is, implicitly or explicitly, impacted by humans. As Ursula K. Heise puts it, ecopoetry is \"related to the broader genre of nature poetry but can be distinguished from it by its portrayal of nature as threatened by human activities\"; An ecopoem is environmentalist not only thematically, in that it represents environmental damage or risk, but rhetorically: it is urgent, it aims to unsettle)"}, "madsrdf:citationSource": "Shoptaw, J. Why ecopoetry?, via Poetry magazine website, viewed Mar. 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 51 (American ecopoetry - a new subgenre of traditional nature poetry; American ecological poetry is a relatively recent literary phenomenon that has marked its existence within the tradition of nature poetry. It is represented by such poets as Robinson Jeffers, Gary Snyder, Archie R. Ammons, Denise Levertov, Mary Oliver and Wendell Berry. The major feature that distinguishes ecopoetry from traditional nature poetry is its distinct biocentrism that is manifested in the attitude of humility towards the world of nature and a critical approach to technological civilization posing danger to Earth's eco-community. On the level of the ecological consciousness that it promotes, ecopoetry is inspired by such ecosophies as Benedict Spinoza's monistic pantheism, Aldo Leopold's earth ethics, Arne Naess's deep ecology and James Lovelock's concept of Gaia)"}, "madsrdf:citationSource": "Przestrzenie teorii, nr 16 (2011), viewed online Dec. 22, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xix (By the late 1990s, scholarly attention to contemporary nature poetry (or what was coming to be called \"environmental poetry\" or \"ecopoetry\") began to proliferate) p. xx (poets who have explored the relationship between humanity and nonhuman nature)"}, "madsrdf:citationSource": "Twentieth-century American nature poets, c2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Eco-poetry"}}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Eco-poetry"}}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ecological poetry"}}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ecological poetry"}}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Environmental poetry"}}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Environmental poetry"}}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Green poetry"}}, {"@id": "_:n515c64aed6d54e4caa0d19b2291b39d6b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Green poetry"}}], "@id": "/authorities/genreForms/gf2017026049"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026050", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFilk music", "identifiers:lccn": "gf2017026050", "madsrdf:adminMetadata": [{"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b1"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Filk music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, "madsrdf:hasSource": [{"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b5"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b6"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b7"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b8"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b9"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b10"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/upb"}, "ri:recordStatus": "new"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-07-13T14:02:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filk music"}}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Horsetamer - Julia Ecklar. ... This is Julia Ecklar - and filk - as you've never heard before\")"}, "madsrdf:citationSource": "Prometheus Music, via WWW, March 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Filk: Music practice associated with the science fiction and fantasy fan community; most commonly practiced at fan conventions; preference is given to songs written by members of the community. The topics of filk songs are varied, tending to focus on science fiction and fantasy topics or on outside interests common to many fans, such as science, history, or the environment. The musical styles employed in filk are likewise unprescribed. While the practice began as a fan offshoot of the mid-20th century American contemporary folk movement, and predominantly features music for solo voice and guitar, singers and instrumentalists of all musical persuasions have been encouraged to participate. This has resulted in many song styles--including rock, jazz, heavy metal, and rap--and has initiated the formation of a variety of filk performance groups)"}, "madsrdf:citationSource": "Oxford Music Online, June 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(All things considered, program broadcast February 9, 2010, titled \"Science-Fiction Music: Monsters, Aliens In 'Filk'\"; science fiction fans began sharing songs with one another that had science fiction or fantasy themes; a 1950s article about these unusual songs misspelled folk as filk and gave a name to a movement)"}, "madsrdf:citationSource": "National Public Radio, via WWW, March 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(filk music; genre of folk music is composed and performed by science-fiction fans that features sci-fi and fantasy themes)"}, "madsrdf:citationSource": "Gale literature resource center (online), March 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(organization dedicated to promoting the sharing of filk music; \"Filksongs and filksinging are the folk music of a time and a community, just as, say, Celtic ballads, or new England sea chanteys are, except the time is today (or tomorrow) and the community is science fiction and fantasy fandom ... stylistically, filk is [a type of] folk music\")"}, "madsrdf:citationSource": "Interfilk.org, March 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(filk, noun, probably orig. a typographical error for \"folk\" in an unpublished essay titled \"The Influence of Science Fiction on Modern American Filk Music\" by Lee Jacobs, submitted for publication to the Spectator Amateur Press Society a type of music, originally in the folk style but now of any style, with content relating to science fiction, fantasy, science fiction fandom, or other topics of interest to SF fans; a song of this type. Often attrib. in filk song, -singer, -singing, etc.)"}, "madsrdf:citationSource": "Brave new words: the Oxford dictionary of science fiction (online), March 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9e8b9f14cbe440db32fc6b7203c51c4b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(term not given)"}, "madsrdf:citationSource": "Work cat.: Ecklar, J. Horsetamer, 2013", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026050"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026051", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCard games", "identifiers:lccn": "gf2017026051", "madsrdf:adminMetadata": [{"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb1"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Card games"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, "madsrdf:hasSource": [{"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb5"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb6"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb7"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb8"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb9"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb10"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Games that are played exclusively or primarily with cards."}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/mwalb"}, "ri:recordStatus": "new"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-03T13:39:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Card games"}}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "front of box (The card game with ever-changing rules!)"}, "madsrdf:citationSource": "Fluxx, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(card games (game sets). Sets composed of playing cards plus other items designed to be used together in games in which the primary activity during a round of play involves the use of the playing cards; BT: card, table and board game sets)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Mar. 9, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Card game; Card Games often use cards as its sole or central component. There are stand-alone card games, in which all the cards necessary for gameplay are purchased at once. There are also Collectible Card Games (CCGs), where players purchase starter and \"booster\" packs in an effort to compile a more and more powerful deck of cards to compete with)"}, "madsrdf:citationSource": "Boardgamegeek.com, Mar. 9, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "front of box (Card game) back of box (Uno card game is #1 for Family Fun)"}, "madsrdf:citationSource": "Work cat: Uno, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "ERIC thesaurus;Genre terms : a thesaurus for use in rare book and special collections cataloging", "madsrdf:citationStatus": "notfound"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Card games; UF: Card playing; BT: Games; NT: Bridge (Game), Poker; RT: Card tricks, Gambling)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Mar. 9, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne03bc7ee279646c1b22f5c9f47b19fcbb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Card game; a game that uses a deck of cards)"}, "madsrdf:citationSource": "Merriam-Webster online, Mar. 9, 2017", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026051"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026052", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDomestic drama (Motion pictures)", "identifiers:lccn": "gf2017026052", "madsrdf:adminMetadata": [{"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb1"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Domestic drama (Motion pictures)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026250"}, "madsrdf:hasSource": [{"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb5"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb6"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb7"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb8"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb9"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb10"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb11"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb12"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb13"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional films that feature home and family life."}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-14T08:18:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Domestic drama (Motion pictures)"}}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A century after the Civil War abolished slavery, laws enforcing racial segregation criminalized marriage, and sometimes also sex, between members of different races. Sixteen states had such bans until the 1967 Supreme Court decision on Loving v. Virginia declared those laws unconstitutional. Jeff Nichols turns that history into an intimate domestic drama in \"Loving\")"}, "madsrdf:citationSource": "Covert, C. Movie review: \"Loving\" turns history into intimate domestic drama, in Knoxville news sentinel, Nov. 24, 2016, viewed online Mar. 14, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 156 (Genre: Melodrama. Defining criteria: Subject matter. Differentiating criteria: Domestic drama and heterosexual romance) p. 347 (silent and sound film versions of the domestic dramas John Galsworthy)"}, "madsrdf:citationSource": "An introduction to film studies, 2003, via Google books, viewed Mar. 14, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Domestic drama about the effect a visiting storyteller/trickster has on various members of a black Los Angeles family)"}, "madsrdf:citationSource": "Work cat.: To sleep with anger, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(To Sleep with Anger (1990). Genre: Drama, Sub-Genre: Family Drama)"}, "madsrdf:citationSource": "AllMovie website, Mar. 14, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Melodrama: Domestic Melodramas (Family Melodramas, Small Town Melodramas): They deal with emotional situations involving several individuals, members of the same family, or groups of people interacting with other members of the same community. Examples: Kings Row (1941); In This Our Life (1942); Madame Bovary (1949); All I Desire (1953); Magnificent Obsession (1954); The Man in the Gray Flannel Suit (1956); Written on the Wind (1956); The Long Hot Summer (1958); Home from the Hill (1960); Splender in the Grass (1961))"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Making Love (1982). One of the first Hollywood movies to take a positive look at homosexuality, this domestic drama of a man's \"coming out\" presented a non-stereotypical view of same-sex desire)"}, "madsrdf:citationSource": "Davies, S.P. Out at the movies : a history of gay cinema, 2008, via Google books, viewed Mar. 14, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Introduction - Genre and art: Japanese film in the 1990s and beyond (Japanese domestic drama) IEKI Miyogi (Though he has never acquired a reputation abroad, Ieki was a distinguished exponent of domestic drama whose films deserve admiration for their intelligence and humanity.) NAGASAKI, Shun'ichi (he achieved a major critical success with A Tender Place, a domestic epic recounting the attempts of a woman to come to terms with the disappearance of her 5-year-old daughter)"}, "madsrdf:citationSource": "Jacoby, A. A critical handbook of Japanese film directors, \u00a92008, via Google books, viewed Mar. 14, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(To Sleep with Anger (1990). The life of a middle-class black family in Los Angeles is disrupted by the arrival of an old friend from back South in this layered drama. Initially a charming reminder of their past, the visitor soon comes to seems increasingly sinister as the strained household heads towards an inevitable conflict. Rating: PG. Genre: Drama)"}, "madsrdf:citationSource": "Rotten tomatoes website, Mar. 14, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 11 (The Battle of the Sexes is labeled a \"domestic drama\" in the American Film Institute catalog of movies from 1920 to 1930) pp. 141-142 (From This Day Forward ... keeps its drama small, tied directly to the marriage of an average couple. Identified in the American Film Institute's catalog as a \"domestic drama\")"}, "madsrdf:citationSource": "Basinger, J. I do and I don't : a history of marriage in the movies, 2012, via Google books, viewed Mar. 14, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5fada26c4b4bf69e530e39144599ffb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 159 (Anybody who thought James Cameron's Titanic went overboard in the romance department needs to take a look at this 1953 version, which is interesting enough and very well shot and produced for its day, but it plays more like a domestic drama than a disaster movie)"}, "madsrdf:citationSource": "Kay, G. Disaster movies, \u00a92006, via Google books, viewed Mar. 14, 2017:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026052"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026053", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTalent shows (Television programs)", "identifiers:lccn": "gf2017026053", "madsrdf:adminMetadata": [{"@id": "_:n916998195d5341afb663df72897c91a1b1"}, {"@id": "_:n916998195d5341afb663df72897c91a1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Talent shows (Television programs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n916998195d5341afb663df72897c91a1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026425"}, "madsrdf:hasSource": [{"@id": "_:n916998195d5341afb663df72897c91a1b5"}, {"@id": "_:n916998195d5341afb663df72897c91a1b6"}, {"@id": "_:n916998195d5341afb663df72897c91a1b7"}, {"@id": "_:n916998195d5341afb663df72897c91a1b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n916998195d5341afb663df72897c91a1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n916998195d5341afb663df72897c91a1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n916998195d5341afb663df72897c91a1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Talent shows (Television programs)"}}, {"@id": "_:n916998195d5341afb663df72897c91a1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Summary (The Eurovision Song Contest is one of the longest running television shows in the world.)"}, "madsrdf:citationSource": "Work cat: Work cat: Eurovision Song Contest Stockholm 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n916998195d5341afb663df72897c91a1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subject heading: Talent show television programs)"}, "madsrdf:citationSource": "Reader's guide full text mega (H.W. Wilson), searched March 17, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n916998195d5341afb663df72897c91a1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "talent show (a show consisting of a series of individual performances (as singing) by amateurs who may be selected for special recognition as performing talent)"}, "madsrdf:citationSource": "Merriam-Webster online, March 17, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n916998195d5341afb663df72897c91a1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Talent shows (Television was an excellent medium of talent shows; more possible than on radio; dancers, acrobats, and other performers whose act was visual; Star Search in the United States grouped contestants into a number of categories: singing, dancing, acting, comedy, models and spokespersons; some music video channels (e.g., MTV) have their own version of a talent show; they offer a prize to the best video by an up-and-coming band; a recent program (Popstars on ITV) has fed off the fashion for reality television for its premise: contestants audition for a place in a five-member band)"}, "madsrdf:citationSource": "Continuum encyclopedia of popular music of the world, 2003, via Google Books, March 17, 2017:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026053"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026054", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSoil surveys", "identifiers:lccn": "gf2017026054", "madsrdf:adminMetadata": [{"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b1"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Soil surveys"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b5"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b6"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b7"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b8"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b9"}], "madsrdf:hasVariant": {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-14T12:45:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soil surveys"}}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Soil surveys. BT Natural resources surveys)"}, "madsrdf:citationSource": "LCSH, Mar. 17, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xv (information from the survey can be used to make predictions about soil behavior for selected land uses. The information highlights soil limitations, improvements needed to overcome the limitations, and the impact of selected land uses on the environment; this publication includes climate tables, taxonomic unit descriptions, detailed map unit descriptions, a description of how the survey was made, and a description of the formation of the soils; Soil surveys provide information for many different users. Farmers, ranchers, foresters, and agronomists can use the information to evaluate the potential of the soil and the management needed for maximum food and fiber production. Planners, community officials, engineers, developers, builders, and home buyers can use the surveys to plan land use, select sites for construction, and identify special practices needed to ensure proper performance. Conservationists, teachers, students, and specialists in recreation, wildlife management, waste disposal, and pollution control can use the surveys to help them understand, protect, and enhance the environment)"}, "madsrdf:citationSource": "Work cat.: Harrington, K.W. Soil survey of Okanogan National Forest area, Washington, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(soil survey: (i) The systematic examination, description, classification, and mapping of soils in an area. Soil surveys are classified according to the kind and intensity of field examination. (ii) The program of the National Cooperative Soil Survey that includes developing and implementing standards for describing, classifying, mapping, writing, and publishing information about soils of a specific area)"}, "madsrdf:citationSource": "What is soil survey?, via USDA Natural Resources Conservation Service website, Mar. 17, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (Web Soil Survey (WSS) provides soil data and information produced by the National Cooperative Soil Survey; Soil surveys can be used for general farm, local, and wider area planning)"}, "madsrdf:citationSource": "Web soil survey website, Mar. 17, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(soil survey: a systematic study of the soil of an area including classification and mapping of the properties, crop adaptations, and distribution of various soil types)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Mar. 17, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surveys, Soil"}}, {"@id": "_:nfba4933f15644780bc9f2da8e9d7bee3b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surveys, Soil"}}], "@id": "/authorities/genreForms/gf2017026054"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026055", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMythological poetry", "identifiers:lccn": "gf2017026055", "madsrdf:adminMetadata": [{"@id": "_:na199ac3dd422439892e27f835ecc481cb1"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mythological poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:na199ac3dd422439892e27f835ecc481cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:na199ac3dd422439892e27f835ecc481cb5"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb6"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb7"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb8"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb9"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb10"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb11"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb12"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb13"}], "madsrdf:hasVariant": {"@id": "_:na199ac3dd422439892e27f835ecc481cb14"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:24:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mythological poetry"}}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Adkins, B.J.V. A critical analysis of the erotic, mythological narrative poem, 1589-1598, 1974.", "madsrdf:citationStatus": "found"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Porter, Peter: poet; Australian-born Londoner; Porter's friendship with the artist Arthur Boyd led to four collaborative volumes on figures of myth and their significance: Jonah (1973), The Lady and the Unicorn (1975), Narcissus (1984), and Mars (1988))"}, "madsrdf:citationSource": "The Oxford encyclopedia of British literature, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Myth: myth in poetry; Artistic and revisionary re-creations of myths, esp. in poetry, from Herder's time on, likewise react to the Enlightenment view; artful mythological allusions have often been indistinguishable from the very substance of a lyric poem, as in Petrarch's sonnets depending on his protracted reference to Laura worshipped as Apollo's sacred tree. R. M. Rilke's sequence Sonnets to Orpheus locates the title character's Sagenkreis in the aesthetic, perceptive, and sensual receptivities that survive, reembody, and hallow Orpheus's existence in the poet's own psyche, despite his living in the age of machines)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012", "madsrdf:citationStatus": "found"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Stahl, E.L. H\u00f6lderlin's 'Friedensfeier' and the structure of mythic poetry, 1967.", "madsrdf:citationStatus": "found"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Taylor, A.B. The Ovidian mythological love poem, 1976.", "madsrdf:citationStatus": "found"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Caption title: A list of poems illustrating Greek mythology in the English poetry of the nineteenth century)"}, "madsrdf:citationSource": "Guild, E.C. Greek mythology in English poetry, 1891", "madsrdf:citationStatus": "found"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Winter, J. The ballad of Bladud : being a true history in verse of the mythological primordial founder of the city of Bath, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(poetry on the Roman god of war Mars)"}, "madsrdf:citationSource": "Work cat.: Boyd, Arthur and Porter, Peter. Mars, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Myth: the older mythic stories have become materials to be embellished, recontextualized, and often reinterpreted by the poet's conscious art; Aeschylus' Oresteia, Virgil's Aeneid, Dante's Commedia, Shakespeare's A Midsummer Night's Dream and The Tempest, and Milton's Paradise Lost, represent in differ\u00adent perspectives the zenith of literary exploita\u00adtion of mythology; m. in poetry is not to be conceived merely as a narrative structure, but should enter into the very life-blood of the poem--that is, into its very mode of envisaging and formulating its materials; Rilke's reenvisagement of the Christian mythos (\"Every angel is ringed with terror\"), Yeats's gradual construc\u00adtion of a highly individual but nonetheless powerfully expressive mythology out of the marriage of Ir. folklore with gnostic theosophy, and Eliot's synthesis of anthropology, Christian mysticism, and Gr. and Hindu metaphysics are further outstanding examples of the poetic revitalization of m. and the fresh exploration of the philosophical and religious possibilities of mythic experience through the medium of poetry in our time)"}, "madsrdf:citationSource": "Princeton encyclopedia of poetry and poetics, 1972", "madsrdf:citationStatus": "found"}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na199ac3dd422439892e27f835ecc481cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mythic poetry"}}, {"@id": "_:na199ac3dd422439892e27f835ecc481cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mythic poetry"}}], "@id": "/authorities/genreForms/gf2017026055"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026056", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRock operas", "identifiers:lccn": "gf2017026056", "madsrdf:adminMetadata": [{"@id": "_:n1dafd30538b34e6b9799860f614f5612b1"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rock operas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1dafd30538b34e6b9799860f614f5612b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}, "madsrdf:hasSource": [{"@id": "_:n1dafd30538b34e6b9799860f614f5612b5"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b6"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b7"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b8"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b9"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b10"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b11"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b12"}], "madsrdf:hasVariant": {"@id": "_:n1dafd30538b34e6b9799860f614f5612b13"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Rock albums that are conceived as a series of songs that together present a unified narrative."}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:24:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock operas"}}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rock opera: an album that tells a story through the songs it contains)"}, "madsrdf:citationSource": "Collins English dictionary online, Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Tommy (album) (Tommy is the fourth studio album by the English rock band The Who, a double album first released in May 1969. The album was mostly composed by guitarist Pete Townshend as a rock opera that tells the story about a deaf, dumb and blind boy, including his experiences with life and his relationship with his family)"}, "madsrdf:citationSource": "Wikipedia, Mar. 30, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rock opera: A work of rock music consisting of a series of songs that form a unified narrative; (also) a film or theatrical play in which rock songs provide the main narrative; a rock musical)"}, "madsrdf:citationSource": "Oxford dictionaries website, Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Rock opera (A rock opera is a collection of rock music songs with lyrics that relate to a common story. Rock operas typically are released as concept albums and are not scripted for acting, which distinguishes them from operas, although several have been adapted as rock musicals. The use of various character roles within the song lyrics is a common storytelling device. The success of the rock opera genre has inspired similar works in other musical styles, such as rap opera; Colin Fleming of The Atlantic has identified The Story of Simon Simopath (1967) by British psychedelic band Nirvana as the first recorded rock opera; Neil Strauss of The New York Times wrote that S.F. Sorrow (1968) by The Pretty Things is \"generally acknowledged as the first rock opera.\" Although Pete Townshend denied taking any influence from S.F. Sorrow, critics have compared The Who's Tommy to it. Scott Mervis of the Pittsburgh Post-Gazette wrote that, although Tommy was not the first rock opera, it was the first album to be billed as such; Other notable rock operas include The Who's Quadrophenia in 1973 and Pink Floyd's The Wall in 1979)"}, "madsrdf:citationSource": "Wikipedia, Mar. 30, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rock opera. An operatic work in which the musical idiom is rock and roll. Such works have little direct connection to the opera as traditionally understood. They do not use operatically trained singers; the sound is amplified; some of the more interesting examples were never intended for live performance; 'rock operas' are part of the far larger alternative tradition of music-theatre works stemming from non-Western and vernacular musical cultures; 'Rock operas' grew out of 'concept albums', LPs with a theme, in the mid-1960s, and hence are really closer to the song cycles of classical tradition than to opera)"}, "madsrdf:citationSource": "Grove music online, Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "About > What is rock opera? (a rock opera is a work of rock music that presents a dramatic story told over multiple songs in the traditional manner of opera. The songs are usually presented in the form of a record album unified by a common theme or narrative. Many rock operas have never been staged as theatrical works, and exist only as audio musical works. For this reason, rock operas are often considered a subset of the concept album, and although many concept albums do not follow a specific story line, the ones that do follow a narrative blur the lines between rock opera and concept album even more)"}, "madsrdf:citationSource": "Los Angeles Rock Opera Company website, Mar. 30, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Who (Musical group). Tommy, 1993, \u21171973.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rock opera. An operatic work or stage show using songs written in the idiom of rock music. In 1967 (the year in which the Beatles' Sgt. Pepper's Lonely Hearts Club Band, considered by many to be the earliest concept album, came out) The Who released Tommy, the first rock opera, and Hair was staged on Broadway. Subsequently the term has come to be applied to a range of musical shows, including the early works of Andrew Lloyd Webber, especially Jesus Christ Superstar and Evita)"}, "madsrdf:citationSource": "The Oxford companion to music, via Oxford music online, Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1dafd30538b34e6b9799860f614f5612b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Operas, Rock"}}, {"@id": "_:n1dafd30538b34e6b9799860f614f5612b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Operas, Rock"}}], "@id": "/authorities/genreForms/gf2017026056"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026057", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHanukkah music", "identifiers:lccn": "gf2017026057", "madsrdf:adminMetadata": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb1"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hanukkah music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, "madsrdf:hasSource": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb5"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb6"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb7"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb8"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb9"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb10"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb11"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb12"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb13"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb14"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb15"}], "madsrdf:hasVariant": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb16"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb19"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb22"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb25"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb28"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb31"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb34"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb37"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb40"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music that is traditionally associated with Hanukkah."}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:24:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hanukkah music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sargon, S.A. Feast of Lights : three traditional Chanukah songs, c1987.", "madsrdf:citationStatus": "found"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Songs of Chanukah, c1992.", "madsrdf:citationStatus": "found"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Jewish music: King David's authorship and authority endowed the Psalms with special sanctity. ... Special selections are sung during the Holy Days; thus, the hallel praise (Psalms cxiii-cxviii) is chanted at the Three Pilgrimage Festivals (Pesa\u1e25, Shavu'ot, Sukkot), \u1e24anukkah and New Moons; The 'seasonal melodies' are tunes of certain liturgical or paraliturgical piyyu\u1e6dim sung during the three Pilgrimage Festivals (Pesa\u1e25, Shavu'ot, Sukkot), or at \u1e24anukkah, Purim and Tish'ah be-av. Melodies, such as those for the \u1e24anukkah anthem Ma'oz \u1e63ur, the Pesa\u1e25 hagadah song Adir hu and the Tish'ah be-av lamentation Eli Zion, were strongly associated with the particular Festivals on which they were sung, and thus each became the musical symbol of its season; Klezmorim performed their Jewish repertory principally at Jewish weddings, and at Holy Days such as Sim\u1e25at Torah, \u1e24anukkah, Purim, sometimes Sukkot, Pesa\u1e25 and Rosh-hodesh and at the end of the Sabbath)"}, "madsrdf:citationSource": "Grove music online, Mar. 10, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "My favorite Chanuka piano book, 2003.", "madsrdf:citationStatus": "found"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hanukah songs for singing, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hanukkah, also spelled \u1e24anukka, Chanukah, or Chanukkah, also called Feast of Dedication, Feast of Lights, or Feast of the Maccabees; The celebration of Hanukkah includes a variety of religious and nonreligious customs. The most important of all is the lighting of the menorah, a candelabra with eight branches plus a holder for the shammash (\"servant\") candle that is used to light the other eight candles; In contemporary Israel, Hanukkah is a national holiday, and students present plays, sing holiday songs, and have parties; The Hanukkah observance is also characterized by the daily reading of Scripture, recitation of some of the Psalms, almsgiving, and singing of a special hymn)"}, "madsrdf:citationSource": "Britannica online, Mar. 10, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "World's greatest Hanukkah music, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "15 traditional Chanukkah favorites, c1988.", "madsrdf:citationStatus": "found"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hanukkah, a transliteration also romanized as Chanukah or \u1e24anukah) is a Jewish holiday commemorating the rededication of the Holy Temple (the Second Temple) in Jerusalem at the time of the Maccabean Revolt against the Seleucid Empire; also known as the Festival of Lights and the Feast of Dedication; In the Ashkenazi tradition, each night after the lighting of the candles, the hymn Ma'oz Tzur is sung. The song contains six stanzas; singing other Hanukkah songs is customary in many Jewish homes; A large number of songs have been written on Hanukkah themes, perhaps more so than for any other Jewish holiday. Some of the best known are \"Ma'oz Tzur\" (Rock of Ages), \"Latke'le Latke'le\" (Yiddish song about cooking Latkes), \"Hanukkiah Li Yesh\" (\"I Have a Hanukkah Menorah\"), \"Ocho Kandelikas\" (\"Eight Little Candles\"), \"Kad Katan\" (\"A Small Jug\"), \"S'vivon Sov Sov Sov\" (\"Dreidel, Spin and Spin\"), Haneirot Halolu\" (\"These Candles which we light\"), \"Mi Yimalel\" (\"Who can Retell\") and \"Ner Li, Ner Li\" (\"I have a Candle\"). The most well known in English-speaking countries include \"Dreidel, Dreidel, Dreidel\" and \"Oh Chanukah\"; Penina Moise's Hannukah Hymn published in the 1842 Hymns Written for the Use of Hebrew Congregations was instrumental in the beginning of Americanization of Hanukkah)"}, "madsrdf:citationSource": "Wikipedia, Mar. 10, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Festival of Lights Hanukkah music, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (\"Traditional songs and original settings\")"}, "madsrdf:citationSource": "Work cat.: A Hanukka celebration, \u21172003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Festival of Lights music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Festival of Lights music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Feast of Lights music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Feast of Lights music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hanukah music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hanukah music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chanukkah music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chanukkah music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chanukah music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chanukah music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Feast of Dedication music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Feast of Dedication music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hanukka music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hanukka music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chanuka music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chanuka music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb40", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb41"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Feast of the Maccabees music"}}, {"@id": "_:n96ecbe01e5b24e53ac8cf742436a283bb41", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Feast of the Maccabees music"}}], "@id": "/authorities/genreForms/gf2017026057"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026058", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVisual albums", "identifiers:lccn": "gf2017026058", "madsrdf:adminMetadata": [{"@id": "_:nb1a00838bd14479d8b06f59c25911a18b1"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Visual albums"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb1a00838bd14479d8b06f59c25911a18b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026413"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026414"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}], "madsrdf:hasSource": [{"@id": "_:nb1a00838bd14479d8b06f59c25911a18b5"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b6"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b7"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b8"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b9"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b10"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b11"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b12"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b13"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b14"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b15"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b16"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b17"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music albums that feature narratively or stylistically cohesive longform music videos."}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:24:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Visual albums"}}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lemonade by no means invented the \"visual album\" genre; \"Visual albums\" have been around for a long time; not a compilation of music videos; what Lemonade isn't: not a collection of music videos; not a feature film with a cohesive cast of characters who develop; not an entirely abstract or abrasive collection of visuals; not a documentary; not a concert film)"}, "madsrdf:citationSource": "Watching the albums we love: a look at different \"visual albums\" & what that means, via Indie shuffle website, Apr. 29, 2016, viewed Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online, Mar. 30, 2017", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Lemonade,\" her sixth solo album, had its premiere in April as an artsy and provocative hourlong film on HBO, raising the bar set by \"Beyonc\u00e9,\" the surprise \"visual album\" that came with videos for every track in 2013; As the value of digital music continues to hover near free for many consumers, some brand-name acts are following Beyonc\u00e9's blueprint with high-concept mini-movies that can add artistic heft to projects competing for attention in an infinite pile of content. These extended videos, with their headline-grabbing cameos and high production values, have also become the latest theater in the music streaming war as services like Tidal and Apple Music function not just as platforms but as creative partners (and sometimes financial backers) with artists, in exchange for exclusivity; Frank Ocean's \"Endless,\" a 45-minute \"visual album\" and musing on the artistic process that was also exclusive to Apple)"}, "madsrdf:citationSource": "Coscarelli, J. Beyonc\u00e9 raised the bar with 'Lemonade.' Now others are leaping, too, in New York times, Sept. 28, 2016, viewed online Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Lemonade (Beyonc\u00e9 album) (Lemonade is the sixth studio album by American singer Beyonc\u00e9. It was released on April 23, 2016; the record is Beyonc\u00e9's second \"visual album\"; The album was accompanied by the release of a 60-minute film of the same name, which premiered on HBO on April 23, 2016)"}, "madsrdf:citationSource": "Wikipedia, Mar. 30, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "See the far-reaching impact of Beyonc\u00e9's Lemonade (the high-concept visual album leads this Sunday's Grammy Awards with nine nominations, including Album of the Year)"}, "madsrdf:citationSource": "Time magazine, via WWW, Mar. 30, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(From the Beatles to Beyonc\u00e9, longform music videos provide a powerful canvas; visual albums as the natural successor to music videos. Long regarded as a gimmicky afterthought not unlike director's commentary on DVD releases, visual albums have always existed on the periphery of the music industry; Beyonc\u00e9 changed the conversation by making her latest album a must-watch event, not a must-listen; visual albums have existed conceptually for the past half-century; Animal Collective were the first to coin the term \"visual album\" with their 53 minute film that doubled as the only way fans could access the soundtrack; Beyonc\u00e9's Lemonade is without a doubt, the new standard for visual albums and a realization of the true potential of the format)"}, "madsrdf:citationSource": "Vogler, D. See the music: the evolution of visual albums, via Cuepoint website, July 29, 2016, viewed Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beyonce's politically charged visual album Lemonade is the music critics' favourite album of the year)"}, "madsrdf:citationSource": "Savage, M. Beyonce's Lemonade is critics' top album of 2016, via BBC News website, Dec. 22, 2016, viewed Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In the past few years a new music/video hybrid has become increasingly prevalent. The \"visual album\" (as coined by Animal Collective) continues to emerge as a means of creative visual expression and (often) as a form of cross-promotion for an album. Unlike music videos, visual albums stage, sometimes with interruptions, the majority of a musician or band's LP; visual albums can occasionally be too long, interconnected, and narratively or stylistically cohesive to be parsed out as standalone shorts or individuated music videos, but aren't long enough to be feature films; often directed by the musician or band rather than a 'proper filmmaker'; \"visual album\" is a convenient umbrella term for these otherwise hard-to-define not-quite-feature musical films; visual albums are (potentially) not at all films, music videos, or promotional materials, but something else entirely)"}, "madsrdf:citationSource": "Palmer, L. How visual albums are changing the way we think of movies and music videos, via Film school rejects website, Aug. 21, 2012, viewed Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Late Thursday night, Frank Ocean surreptitiously dropped his followup album to 2012's Channel Orange. After four years of waiting impatiently for the damn thing, it just all of a sudden materialized from the Upside Down in Apple Music. Except, it's not really an album, but a \"visual album\" -- a short film that spans 45 minutes and 51 seconds and showcases 18 tracks; in April, Beyonc\u00e9 broke the Internet when she dropped her own visual album on HBO, which she followed up by premiering the actual music on Tidal shortly after. She did something similar years before with her 2013 eponymous album, only that one was broken out into individual music videos rather than one full-length film)"}, "madsrdf:citationSource": "Roffman, M. Five more visual albums we'd like to see, via Consequence of sound website, Aug. 19, 2016, viewed Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The visual album isn't new: Over the past half-decade or so, bands from Animal Collective to TV on the Radio have experimented with the genre, an elaboration on MTV-era music videos combining elements of feature filmmaking and provocative high-art collaborations; a form of transmedia--part video, part film, part art installation)"}, "madsrdf:citationSource": "Hornaday, A. How Beyonc\u00e9 perfected the 'visual album' with 'Lemonade', in The Washington post, Apr. 26, 2016, viewed online Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beyonc\u00e9's Lemonade; a jaw-dropping audiovisual work; On this second sumptuously produced visual album, in which 12 songs are stitched together in a filmic tableau modelled on the K\u00fcbler-Ross model of grief, Beyonc\u00e9 once again pulled the rug out from under the idea of what a pop R&B record could be)"}, "madsrdf:citationSource": "Best albums of 2016: No 1 Lemonade by Beyonc\u00e9, via The guardian online, Dec. 16, 2016, viewed Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The release of Beyonc\u00e9's Lemonade has ushered in an era when we talk about \"watching\" an album, but it's been a long time coming. Artists have tinkered with the form of the visual album, or music film, since the dawn of pop music; to be considered a visual album, a film must feature at least two songs (therefore excluding epic music videos like \"Thriller\"), link them with a bridging story (knocking out video collections like Daft Punk's D.A.F.T.), and have been developed or released within a year of the corresponding album (making Tommy and Mamma Mia ineligible); Beyonc\u00e9 christened the genre \"visual album\" with 2013's self-titled effort, which appeared without warning and with a corresponding video alongside each track)"}, "madsrdf:citationSource": "Sommers, K. The rise of the visual album: how 'Lemonade' stacks up, via BBC America Anglophenia website, viewed Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Although visual albums were a thing way back in the 60's (The Beatles' A Hard Day's Night), it seems like it wasn't until today that they became more and more normal; Both audio and visual have been long-running duos. Regular music videos were extremely popular from the 80's well into the early 2000's. Since then, however, music videos have been wavering back and forth, showing subtle declines in interest; visual albums are beginning to make a splash, garnering the attention of many and becoming a new way for artists to differentiate themselves from the rest; visual music videos promote an emotional outlet for artists to create and have fun with releasing their new songs. It's a way for artists to connect to their audiences directly. These artists are allowing their audiences to view their music the way they want us to. It makes it that much more personal, making it one of the main reasons why listeners are aware and interested in the concept of visual albums. Think of it as an evolving technique from your standard music video and these artists have turned something fleeting into something fantastically permanent. With their ability to thread their music into short films and narratives, these artists have come out on top by showing the world their personal projects, reflecting on issues that lie in themselves and society; visual albums have always been existing conceptually with other artists such as Kanye West, Animal Collective, and even going further back with the Beatles)"}, "madsrdf:citationSource": "How visual albums became the new norm in 2016, via Baeble music website, Dec. 8, 2016, viewed Mar. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1a00838bd14479d8b06f59c25911a18b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "accompanying DVD (A visual album by Beyonc\u00e9)"}, "madsrdf:citationSource": "Work cat.: Beyonc\u00e9. Lemonade, 2016:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026058"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026059", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aActivity books", "identifiers:lccn": "gf2017026059", "madsrdf:adminMetadata": [{"@id": "_:n338daf473a4840b999022f1088350559b1"}, {"@id": "_:n338daf473a4840b999022f1088350559b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Activity books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n338daf473a4840b999022f1088350559b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026164"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026082"}, "madsrdf:hasSource": [{"@id": "_:n338daf473a4840b999022f1088350559b5"}, {"@id": "_:n338daf473a4840b999022f1088350559b6"}, {"@id": "_:n338daf473a4840b999022f1088350559b7"}, {"@id": "_:n338daf473a4840b999022f1088350559b8"}, {"@id": "_:n338daf473a4840b999022f1088350559b9"}], "madsrdf:hasVariant": {"@id": "_:n338daf473a4840b999022f1088350559b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that consist wholly or chiefly of puzzles, word games, coloring pages, instructions for simple science or craft projects, etc."}, {"@id": "_:n338daf473a4840b999022f1088350559b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-07-13T14:02:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n338daf473a4840b999022f1088350559b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-03T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dgpo"}, "ri:recordStatus": "new"}, {"@id": "_:n338daf473a4840b999022f1088350559b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Activity books"}}, {"@id": "_:n338daf473a4840b999022f1088350559b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(menu selection: Departments -- Books & Audible -- Children's books -- Activities, crafts & games -- Activity books)"}, "madsrdf:citationSource": "Amazon website, Apr. 3, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n338daf473a4840b999022f1088350559b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(activity book: A book designed to engage the user in a pursuit other than (or in addition to) reading, for example, an instruction manual for science or craft projects, or a volume containing puzzles or word games)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Apr. 3, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n338daf473a4840b999022f1088350559b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Apr. 3, 2017.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n338daf473a4840b999022f1088350559b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "The web of life activity booklet, [1994].", "madsrdf:citationStatus": "found"}, {"@id": "_:n338daf473a4840b999022f1088350559b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: C&O Canal Junior Ranger activity book, [2010?].", "madsrdf:citationStatus": "found"}, {"@id": "_:n338daf473a4840b999022f1088350559b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n338daf473a4840b999022f1088350559b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Activity booklets"}}, {"@id": "_:n338daf473a4840b999022f1088350559b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Activity booklets"}}], "@id": "/authorities/genreForms/gf2017026059"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026061", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMusical settings", "identifiers:lccn": "gf2017026061", "madsrdf:adminMetadata": [{"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb1"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Musical settings"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, "madsrdf:hasSource": [{"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb5"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb6"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb7"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb8"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb9"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb10"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb11"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb12"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb13"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb14"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb15"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb16"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb17"}], "madsrdf:hasVariant": {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb18"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Vocal or choral musical compositions that consist of pre-existing literary texts that have been set to music."}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-03T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:24:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musical settings"}}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(setting 3. A piece of vocal or choral music composed for particular words. \"a setting of Yevtushenko's bleak poem\"; \"The new piece is a musical setting - without words - of McKellar's poem, Sangsters, in three verses\"; \"It has attracted numerous polyphonic settings, by such composers as Victoria, Palestrina, and Mozart\")"}, "madsrdf:citationSource": "Oxford dictionaries website, Apr. 3, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(word-setting see text-setting; text-setting: The process of composing music for a text, and the musical expression of its words. At different times in the history of music, various concerns about text-setting have been paramount. In musical genres where it is especially important to convey the words clearly (e.g. operatic recitative, much liturgical music), the metre and structure of the text are often followed closely by a simple, syllabic melody with little ornamentation. In other forms, usually where the emphasis lies on the emotional expression of the words, the setting may be more florid, with large leaps, extended melismas on a single syllable, rhythmic distortion, and other devices that might obscure the communication of the text. In some present-day music the individual syllables of words are used primarily for their sound quality and seem disconnected from the rest of the text)"}, "madsrdf:citationSource": "The Oxford companion to music, via Oxford music online, Apr. 3, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under J.2.2 Derivative Work Relationships, hierarchically under \"derivative (work)\": \"set to music as (work)\": A non-dramatic musical work, other than an oratorio, that uses the text of a source work. Reciprocal relationship: \"musical setting of (work)\")"}, "madsrdf:citationSource": "RDA toolkit, Apr. 3, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Musical setting (A musical setting is a musical composition that is written on the basis of a literary work. The literary work is said to be set, or adapted, to music. Musical settings include choral music and other vocal music. A musical setting is made to particular words, such as poems)"}, "madsrdf:citationSource": "Wikipedia, Apr. 3, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Harper's monologue from Angels in America; for soprano and piano; words by Tony Kushner) p. 2 (I set Harper's final monologue to music)"}, "madsrdf:citationSource": "Work cat.: Gordon, Ricky Ian. Night flight to San Francisco, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "93706319: Powell, L.J. Jesus the true vine : a musical setting of the biblical text, John 15:1-10, \u00a91989.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Harper's Act III monologue from Angels in America; for soprano and piano; words by Tony Kushner)"}, "madsrdf:citationSource": "Gordon, Ricky Ian. Antarctica, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Text-setting [setting]. The composition of vocal music to a given text. Music with one note per syllable is known as 'syllabic setting' and that with many notes per syllable as 'melismatic setting'; text-setting in which new syllables are enunciated at regular intervals (regardless of the number of notes per syllable) is referred to as 'isochronic'; Strictly speaking, the term 'text-setting' applies only to those cases where music is supplied for a pre-existing verbal text, as in Beethoven's setting of Schiller's An die Freude. Closely analogous interpretative issues are raised, however, in scenarios where words and music are conceived simultaneously as part of the same creative act (as in the works of Wagner, and some works by Schoenberg and Stravinsky), where words and music originate from a collaboration between composer and poet (or 'lyricist', as in the songs of George and Ira Gershwin), where words are supplied for pre-existing music (as in all contrafacta, for example, Samuel Barber's Agnus Dei, set to music from his own String Quartet, or in Michael Flanders's song 'Ill Wind', in which the text is set to music by Mozart), or where it is impossible to tell (as in early repertories). In this broader sense, indeed, text-setting is a central concern of virtually all vocal music)"}, "madsrdf:citationSource": "Grove music online, Apr. 3, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(form subdivision Musical settings. UF form subdivision Settings, Musical. SN Use as a form subdivision under names of individual persons for musical scores or sound recordings in which writings or words of the person have been set to music. Also use under individual literatures for musical scores or sound recordings in which those literary texts have been set to music)"}, "madsrdf:citationSource": "LCSH, Apr. 3, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(setting noun 4: the music composed for a text (as a poem))"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Apr. 3, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Beahan, J.F. \"A lo Sonoro\" : a musical setting of poems by Pablo Neruda for soprano, B-flat clarinet, violin, 2 violoncellos, contrabass and percussion, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb16", "@type": "madsrdf:Source", "madsrdf:citationSource": "Miller, E.J. Mists and waters : a musical setting of five poems by Denise Levertov : for soprano and chamber orchestra, \u00a91984.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb17", "@type": "madsrdf:Source", "madsrdf:citationSource": "Baron, M. Ode to democracy : a musical setting of Lincoln's Gettysburg address for baritone solo with mixed chorus and orchestra, 1949.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Settings, Musical"}}, {"@id": "_:nb3a2b194ec6149b88bb67cf8cf2f6bdfb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Settings, Musical"}}], "@id": "/authorities/genreForms/gf2017026061"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026062", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIndustrial dance music", "identifiers:lccn": "gf2017026062", "madsrdf:adminMetadata": [{"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab1"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Industrial dance music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026874"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026065"}, "madsrdf:hasSource": [{"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab5"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab6"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab7"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab8"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab9"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab10"}], "madsrdf:hasVariant": [{"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab11"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-03T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-11T08:30:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Industrial dance music"}}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "booklet cover (EBM : electronic body music) booklet p. 1 (Front 242 - one of the most defining and famous groups from the EBM-genre) back insert (tracks by Front 242; Container 90; Rummelsnuff; A Split Second; Spetsnaz; DAF; Dupont; Vomito Negro; Le\u00e6ther Strip; The Klinik; Cabaret Voltaire; J\u00e4ger 90; Pankow; NordarR; Pouppee Fabrikk; Signal Aout 42; Turnbull AC's)"}, "madsrdf:citationSource": "Work cat.: EBM, \u21172010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Front 242 (One of the most consistent industrial bands of the 1980s, even though they regularly pursued a more electronic variant of the sound that swept into vogue during the '90s, Front 242 were the premier exponent of European electronic body music) Pop/Rock > Alternative/Indie Rock > Industrial Dance (During the 1980s, industrial music progressed from being an obscure, experimentalist style to a position where it was quite popular and straight-ahead for a growing audience unenthused by limp-wristed alternative music as well as cock rock and heavy metal. Early distinguished by the term \"electronic body music,\" several artists, such as Front 242, Nitzer Ebb, Skinny Puppy, and Ministry gained significant airplay in clubs. By the 1990s, industrial had split along a guitar/electronics divide, with the latter usually carrying on the tradition of electronic body music. America's Cleopatra Records featured the most Industrial Dance acts, including Le\u00e6therstrip, Spahn Ranch, and Die Krupps)"}, "madsrdf:citationSource": "AllMusic website, Apr. 3, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Electronic body music (Electronic body music (EBM) is a music genre that combines elements of post-industrial music and electropunk. It first came to prominence in Belgium and was considered a part of the European new wave movement. Original, or original-styled electronic body music is sometimes referred to as old-school EBM and should not be confused with aggrotech, dark electro or industrial music. The term electronic body music was coined by Ralf H\u00fctter of the German electronic band Kraftwerk in 1978 to explain the more physical sound of their album The Man-Machine. In 1980/1981, DAF from Germany used the term \"K\u00f6rpermusik\" (body music) to describe their danceable electronic punk sound. The term was later used by Belgian band Front 242 in 1984 to describe the music of their EP of that year, No Comment; The style has been characterized by hard and often danceable electronic beats, clear undistorted or slightly electronically distorted vocals, shouts or growls with reverberation and echo effects, and repetitive sequencer lines. At the time the genre arose, important synthesizers were the Korg MS-20, Emulator II, Oberheim Matrix and Yamaha DX7. Typical EBM rhythms are based on 4/4 beats, mainly with some minor syncopation to suggest a rock music rhythm structure. Samples, e.g. metal rod, machine and alert sounds, are often used to create a \"factory ambiance\". Other samples include political speeches and excerpts from science fiction movies; Industrial dance is a North American alternative term for electronic body music and electro-industrial music) Industrial dance music (Industrial dance music is a North American alternative term for electronic body music and electro-industrial music; characterized by its electronic beats, symphonic keyboard lines, pile-driver rhythms, angst-ridden or sampled vocals, and cyberpunk imagery)"}, "madsrdf:citationSource": "Wikipedia, Apr. 3, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under DJ Hell (Hell's 2002 mix compilation Electronicbody-Housemusic seemed to be a deliberate reaction to the electroclash scene he had become associated with, eschewing such electro pop in favour of electronic house from the Kompakt and Playhouse labels as well as brutal electronic body music from the likes of Nitzer Ebb, Front 242 and Terrence Fixmer) under Express (b. Simon Francis, c.1967, England. A bright new hip-hop talent from Northampton, England, Express has been rapping since 1981. However, his musical path took a different slant when he joined a local industrial dance unit) under MC 900ft Jesus (b. Mark Griffin ... Griffin explored a wide variety of styles including jazz and industrial dance as well as hip-hop)"}, "madsrdf:citationSource": "Encyclopedia of popular music, via Oxford music online, Apr. 3, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "industrial-dance (a sub-genre of industrial music that typically is 140bpm and is played at gothic dance clubs. This sub-genre is also the choice style for Rivetheads) EBM (EBM A phrase coined by the techno-industrial band Front 242. In fact before the term was commonly used by club-kids and rivet heads it was being printed on many Front 242 music albums near the tracklisting. EBM transformed from heavy drummed post-industrial to sounding something more like synthpop. To those not in the 'scene' it could be described synthcore: something in between industrial and synthpop electronic dance music)"}, "madsrdf:citationSource": "Urban dictionary website, Apr. 3, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Category: Industrial Dance/EBM (Industrial Dance/EBM. Industrial with a beat; you can dance to it)"}, "madsrdf:citationSource": "Klein, Ed. Music database, via WWW, Apr. 3, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "EBM (Electronic body music)"}}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "EBM (Electronic body music)"}}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Electronic body music"}}, {"@id": "_:n3cf87b9cb08f485c9aa124abf564dc0ab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Electronic body music"}}], "@id": "/authorities/genreForms/gf2017026062"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026068", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFormularies (Medicine)", "identifiers:lccn": "gf2017026068", "madsrdf:adminMetadata": [{"@id": "_:nb8ad7e52a3734883855ada85fa990d72b1"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Formularies (Medicine)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb8ad7e52a3734883855ada85fa990d72b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasSource": [{"@id": "_:nb8ad7e52a3734883855ada85fa990d72b5"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b6"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b7"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b8"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b9"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b10"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b11"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b12"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b13"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b14"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b15"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b16"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b17"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b18"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b19"}], "madsrdf:hasVariant": [{"@id": "_:nb8ad7e52a3734883855ada85fa990d72b20"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b23"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b26"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b29"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b32"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b35"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b38"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b41"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b44"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-07-13T14:02:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Formularies (Medicine)"}}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "NFI : National formulary of India, 2016, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(formulary plural formularies 1 : a collection of prescribed forms (as oaths or prayers). 2 : formula def. 1. 3 : a book listing medicinal substances and formulas; formula def. 1 : a : a set form of words for use in a ceremony or ritual; b : a conventionalized statement intended to express some fundamental truth or principle especially as a basis for negotiation or action)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Apr. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: The national formulary, 1975.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(drug formulary: A list of approved prescription medications that the plan will cover and that will be distributed from affiliated pharmacies)"}, "madsrdf:citationSource": "BusinessDictionary.com, Apr. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Formulary: A list of prescription drugs covered by a prescription drug plan or another insurance plan offering prescription drug benefits. Also called a drug list)"}, "madsrdf:citationSource": "HealthCare.gov Glossary, viewed online Apr. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Uniform Medical Plan prescription drug formulary, Jan. 1, 2003.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Myanmar national formulary, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(in titles: drug formularies; hospital drug formularies; managed care drug formularies; neonatal drug formulary; Medicaid drug formulary; pediatric drug formulary; prescription drug formulary; primary care drug formulary; State Medicaid drug formularies; VA drug formulary; veterinary drug formulary)"}, "madsrdf:citationSource": "OCLC, Apr. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Nova Scotia. Health Services and Insurance Commission. Prescription drug formulary, 1982.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Formularies are lists that have the insurance carriers preferred drugs. You can normally find both generic and brand name drugs in the formularies; formulary drug lists)"}, "madsrdf:citationSource": "Formulary versus non-formulary prescription drugs, via Buettner Insurance Agency website, Apr. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "South African medicines formulary, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Formularies. UF Drug Formularies; Essential Medicines List; Formularies, Drug; Preferred Drug List. SN Works that consist of lists of drugs or collections of recipes, formulas, and prescriptions for the compounding of medicinal preparations. Annotation: This heading is used as a Publication Type)"}, "madsrdf:citationSource": "MeSH browser, Apr. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(formulary: Originally, a collection of formulas for the compounding and testing of medications. Today, a list of prescription drugs covered by a given pharmaceutical benefit plan. A national formulary is a list of medicines approved for prescription in a specific country, providing information about their chemical composition, description, selection, prescription, dispensing, and administration, and indicating which products are interchangeable. Compare with pharmacopoeia)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Apr. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b18", "@type": "madsrdf:Source", "madsrdf:citationSource": "British Columbia formulary for the use and guidance of physicians, hospitals and pharmacists, 1947.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dentistry--Formulae, receipts, prescriptions. UF Dental formularies, Dental prescriptions; Medicine--Formulae, receipts, prescriptions. UF Formularies, Medical; Medical formularies; Prescriptions. Also has unrelated heading: Formularies (Diplomatics). BT Diplomatics, Forms (Law))"}, "madsrdf:citationSource": "LCSH, Apr. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb8ad7e52a3734883855ada85fa990d72b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Preferred drug lists"}}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Preferred drug lists"}}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb8ad7e52a3734883855ada85fa990d72b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prescription drug formularies"}}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prescription drug formularies"}}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb8ad7e52a3734883855ada85fa990d72b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lists of essential medicines"}}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lists of essential medicines"}}, {"@id": "_:nb8ad7