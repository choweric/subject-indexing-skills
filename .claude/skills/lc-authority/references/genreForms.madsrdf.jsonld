{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026320", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aErotic fiction", "identifiers:lccn": "gf2014026320", "madsrdf:adminMetadata": [{"@id": "_:n747609bfaad641289d48ab082228794fb1"}, {"@id": "_:n747609bfaad641289d48ab082228794fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Erotic fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n747609bfaad641289d48ab082228794fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:n747609bfaad641289d48ab082228794fb5"}, {"@id": "_:n747609bfaad641289d48ab082228794fb8"}], "madsrdf:hasReciprocalAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026139"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026152"}], "madsrdf:hasSource": [{"@id": "_:n747609bfaad641289d48ab082228794fb11"}, {"@id": "_:n747609bfaad641289d48ab082228794fb12"}, {"@id": "_:n747609bfaad641289d48ab082228794fb13"}, {"@id": "_:n747609bfaad641289d48ab082228794fb14"}, {"@id": "_:n747609bfaad641289d48ab082228794fb15"}, {"@id": "_:n747609bfaad641289d48ab082228794fb16"}], "madsrdf:hasVariant": [{"@id": "_:n747609bfaad641289d48ab082228794fb17"}, {"@id": "_:n747609bfaad641289d48ab082228794fb20"}, {"@id": "_:n747609bfaad641289d48ab082228794fb23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026352"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026409"}]}, {"@id": "_:n747609bfaad641289d48ab082228794fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n747609bfaad641289d48ab082228794fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-07-19T15:02:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n747609bfaad641289d48ab082228794fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Erotic fiction"}}, {"@id": "_:n747609bfaad641289d48ab082228794fb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n747609bfaad641289d48ab082228794fb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lesbian erotic fiction"}}, {"@id": "_:n747609bfaad641289d48ab082228794fb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lesbian erotic fiction"}}, {"@id": "_:n747609bfaad641289d48ab082228794fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n747609bfaad641289d48ab082228794fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay erotic fiction"}}, {"@id": "_:n747609bfaad641289d48ab082228794fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay erotic fiction"}}, {"@id": "_:n747609bfaad641289d48ab082228794fb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "The leading edge : an anthology of lesbian sexual fiction, c1987.", "madsrdf:citationStatus": "found"}, {"@id": "_:n747609bfaad641289d48ab082228794fb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Erotica: the collective term for materials of an erotic nature, and particularly for prose or verse narratives of sexual fantasy ranging from explicitly pornographic novels to jocular poems on sexual subjects, whether or not these are illustrated pictorially. Since the 1960s, written texts have been not only less subject to sexual censorship but increasingly marginal to the image-dominated pornography industry proper: so that fiction that would once have counted as pornographic is now called erotica, and more than ever marketed in anthologies addressed to lesbians and heterosexual women as well as to men.)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n747609bfaad641289d48ab082228794fb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Heat wave : sizzling sex stories, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n747609bfaad641289d48ab082228794fb14", "@type": "madsrdf:Source", "madsrdf:citationSource": "The pleasure garden : erotic tales of carnal desire, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n747609bfaad641289d48ab082228794fb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Erotic fiction: Use for works that are characterized by treatment of sexual love in more or less explicit detail. The sexual element is made a portion of the aesthetic, thematic, or moral aspect of the work; that is, it exists as a contributing part to some other objective than titillation or sexual arousal.UF Adult fiction, Erotic novels, Erotic stories. RT Love stories.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n747609bfaad641289d48ab082228794fb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Erotica (Erotica, literary or artistic works having an erotic theme; especially, books treating of sexual love in a sensuous or voluptuous manner. The word erotica typically applies to works in which the sexual element is regarded as part of the larger aesthetic aspect. It is usually distinguished from pornography, which can also have literary merit but which is usually understood to have sexual arousal as its main purpose) Pornography (Pornography, representation of sexual behaviour in books, pictures, statues, motion pictures, and other media that is intended to cause sexual excitement. The distinction between pornography (illicit and condemned material) and erotica (which is broadly tolerated) is largely subjective and reflects changing community standards)"}, "madsrdf:citationSource": "Britannica online, Oct. 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n747609bfaad641289d48ab082228794fb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n747609bfaad641289d48ab082228794fb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lesbian erotic fiction"}}, {"@id": "_:n747609bfaad641289d48ab082228794fb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lesbian erotic fiction"}}, {"@id": "_:n747609bfaad641289d48ab082228794fb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n747609bfaad641289d48ab082228794fb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay erotic fiction"}}, {"@id": "_:n747609bfaad641289d48ab082228794fb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay erotic fiction"}}, {"@id": "_:n747609bfaad641289d48ab082228794fb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n747609bfaad641289d48ab082228794fb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Adult fiction"}}, {"@id": "_:n747609bfaad641289d48ab082228794fb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Adult fiction"}}], "@id": "/authorities/genreForms/gf2014026320"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026321", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aErotic poetry", "identifiers:lccn": "gf2014026321", "madsrdf:adminMetadata": [{"@id": "_:n773b1cba0a2048299d537cd52a03c007b1"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Erotic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n773b1cba0a2048299d537cd52a03c007b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:n773b1cba0a2048299d537cd52a03c007b5"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b8"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026238"}, "madsrdf:hasSource": [{"@id": "_:n773b1cba0a2048299d537cd52a03c007b11"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b12"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b13"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b14"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b15"}], "madsrdf:hasVariant": [{"@id": "_:n773b1cba0a2048299d537cd52a03c007b16"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026353"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026410"}]}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-16T09:48:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Erotic poetry"}}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n773b1cba0a2048299d537cd52a03c007b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay erotic poetry"}}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay erotic poetry"}}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n773b1cba0a2048299d537cd52a03c007b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lesbian erotic poetry"}}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lesbian erotic poetry"}}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Erotic poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Erotica: The collective term for materials of an erotic nature, and particularly for prose or verse narratives of sexual fantasy ranging from explicitly pornographic novels to jocular poems on sexual subjects, whether or not these are illustrated pictorially. Within this broad category are works of genuine literary distinction categorized as erotic poetry, including some of the poems of Catullus and Ovid, Marlow's narrative poem Hero and Leander (completed by George Chapman, 1598), Shakespeare's narrative poem Venus and Adonis (1593), and several French lyrics by Paul Verlaine.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Erotic poetry: It is necessary to distinguish between erotic poetry and love poetry. Erotic poetry is about sex and sexual love; love poetry tends to avoid sexual details, though there are exceptions, like some of Donne's love poems. Erotic poetry tends to concentrate on the more physical aspects of love and passion; while love poetry dwells more on the nobler manifestations of love, the 'higher' feelings.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "The best American erotic poems, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Erotic films, Erotic television programs)"}, "madsrdf:citationSource": "LCGFT", "madsrdf:citationStatus": "found"}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n773b1cba0a2048299d537cd52a03c007b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay erotic poetry"}}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay erotic poetry"}}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n773b1cba0a2048299d537cd52a03c007b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lesbian erotic poetry"}}, {"@id": "_:n773b1cba0a2048299d537cd52a03c007b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lesbian erotic poetry"}}], "@id": "/authorities/genreForms/gf2014026321"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026322", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEvangelism plays", "identifiers:lccn": "gf2014026322", "madsrdf:adminMetadata": [{"@id": "_:na401cd71f3454246964fcea94d622214b1"}, {"@id": "_:na401cd71f3454246964fcea94d622214b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Evangelism plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:na401cd71f3454246964fcea94d622214b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026501"}, "madsrdf:hasSource": [{"@id": "_:na401cd71f3454246964fcea94d622214b5"}, {"@id": "_:na401cd71f3454246964fcea94d622214b6"}, {"@id": "_:na401cd71f3454246964fcea94d622214b7"}, {"@id": "_:na401cd71f3454246964fcea94d622214b8"}, {"@id": "_:na401cd71f3454246964fcea94d622214b9"}], "madsrdf:hasVariant": [{"@id": "_:na401cd71f3454246964fcea94d622214b10"}, {"@id": "_:na401cd71f3454246964fcea94d622214b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that preach or espouse religious beliefs with the objective of conversion, generally to Christianity."}, {"@id": "_:na401cd71f3454246964fcea94d622214b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na401cd71f3454246964fcea94d622214b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:08:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na401cd71f3454246964fcea94d622214b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Evangelism plays"}}, {"@id": "_:na401cd71f3454246964fcea94d622214b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Coleman, L. Winifred. Missions through evangelism theatre, 2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:na401cd71f3454246964fcea94d622214b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Potts, J.L. Drama as an evangelical tool, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:na401cd71f3454246964fcea94d622214b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Evangelism plays)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na401cd71f3454246964fcea94d622214b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (What is drama evangelism? From evangelism day site it was stated that \"drama evangelism is an under-used yet essential means of communicating gospel truths, both to Christians and non-Christians.\" This means that it is something yet to be discovered both for the church and for public evangelism.)"}, "madsrdf:citationSource": "Kalu, Emmanuel A. Drama evangelism, via WWW, Jan. 30, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:na401cd71f3454246964fcea94d622214b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Evangelism is the preaching of the Christian Gospel or the practice of relaying information about a particular set of beliefs to others with the object of conversion.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na401cd71f3454246964fcea94d622214b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na401cd71f3454246964fcea94d622214b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Evangelism drama"}}, {"@id": "_:na401cd71f3454246964fcea94d622214b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Evangelism drama"}}, {"@id": "_:na401cd71f3454246964fcea94d622214b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na401cd71f3454246964fcea94d622214b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Evangelical drama"}}, {"@id": "_:na401cd71f3454246964fcea94d622214b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Evangelical drama"}}], "@id": "/authorities/genreForms/gf2014026322"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026323", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExempla", "identifiers:lccn": "gf2014026323", "madsrdf:adminMetadata": [{"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb1"}, {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Exempla"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026327"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026467"}], "madsrdf:hasSource": [{"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb5"}, {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb6"}, {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb7"}], "madsrdf:hasVariant": {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short narratives intended to illustrate a moral point and that are generally found within a sermon or other didactic work."}, {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-08T16:21:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Exempla"}}, {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Exemplum: A brief tale or anecdote told to illustrate a biblical text or to teach a lesson or moral, especially common in sermons during the Middle Ages. Collections of these moralized tales, or exempla, often classified by subject for the use by preachers, took their stories from folklore, legend, and history. Because of their human interest and concreteness, exempla were adapted by lay writers and had great influence on medieval literature.)"}, "madsrdf:citationSource": "Morner, K. NTC's dictionary of literary terms, c1991", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Exempla)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Exemplum: A short narrative used to illustrate a moral. The term applies primarily to the stories used in medieval sermons. Occasionally the exemplum found its way into literature. Two good examples in Chaucer are The pardoner's tale and The nun's priest's tale (late 14 c.).)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Exemplums"}}, {"@id": "_:nf9abb6f925b9442c9820b0d22f004a0fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Exemplums"}}], "@id": "/authorities/genreForms/gf2014026323"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026324", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExperimental drama", "identifiers:lccn": "gf2014026324", "madsrdf:adminMetadata": [{"@id": "_:n9d830f12192b4c02b0b70930372e38bcb1"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Experimental drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9d830f12192b4c02b0b70930372e38bcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n9d830f12192b4c02b0b70930372e38bcb5"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb6"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb7"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb8"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb9"}], "madsrdf:hasVariant": {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that emphasize innovative or unconventional technique at the time they were created."}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-25T15:55:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Experimental drama"}}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Experimental drama. UF Avant-garde drama)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(experimentalism. The commitment to exploring new concepts and representations of the world through methods that go beyond the established conventions of literary tradition. Experimentalism was an important characteristic of 20th-century literature and art, in which successive avant-garde movements arose in continual reaction against what they regarded as decayed or ossified forms of expression. For examples, see Dada, expressionism, futurism, modernism, nouveau roman, surrealism, vorticism.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xxvii (the avant-garde drama of today)"}, "madsrdf:citationSource": "Modern French theatre : the avant-garde, Dada, and surrealism : an anthology of plays, 1966:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Experimental theatre is a general term for various movements in Western theatre that began in the late 19th century with Alfred Jarry and his Ubu plays as a rejection of both the age in particular and, in general, the dominant ways of writing and producing plays. The term has shifted over time as the mainstream theatre world has adopted many forms that were once considered radical. It is used more or less interchangeably with the term avant-garde theatre. Experimental theatre is what it is, namely trying something new.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 15, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "chapter 33, summary (The following chapter focuses on experimental drama in the United States during the 1980s and 1990s, with occasional references to previous decades when it is important to show the legacy influencing an artist or work. By 'experimental,' I am trying to cover a wide variety of dramatists working outside the aesthetic of psychological realism, its familiar settings of home and work, and its predominantly linear forms of narrative and dialogue)"}, "madsrdf:citationSource": "A companion to twentieth-century American drama, 2005, via WWW, Nov. 15, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9d830f12192b4c02b0b70930372e38bcb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Avant-garde drama"}}, {"@id": "_:n9d830f12192b4c02b0b70930372e38bcb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Avant-garde drama"}}], "@id": "/authorities/genreForms/gf2014026324"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026325", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExperimental fiction", "identifiers:lccn": "gf2014026325", "madsrdf:adminMetadata": [{"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab1"}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Experimental fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026223"}, "madsrdf:hasSource": [{"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab5"}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab6"}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab7"}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab8"}], "madsrdf:hasVariant": {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that emphasizes innovative or unconventional technique at the time they were created."}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-25T15:55:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Experimental fiction"}}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Avant-garde: The French military and political term for the vanguard of any army or political movement, extended since the late 19th century to that body of artist and writers who are dedicated to the idea of art as experiment and revolt against tradition. Ezra Pound's view that \"Artists are the antennae of the race,\" is a distinctly modern one, implying a duty to stay ahead of one's time through constant innovation in forms and subjects.)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Experimental literature refers to written work--usually fiction or poetry--that emphasizes innovation, most especially in technique.)"}, "madsrdf:citationSource": "Wikipedia, October 31, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Experimental fiction. UF Avant-garde fiction. BT Fiction)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Avant-garde fiction (experimental fiction) : writing that stands out from the prevailing style of its era in form, style or subject matter--in a way, needless to say, that does not seem obsolete or archaic.)"}, "madsrdf:citationSource": "Henry, L. The fiction dictionary, c1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Avant-garde fiction"}}, {"@id": "_:n77425013c9e4440ebf6a38dcd2ce253ab10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Avant-garde fiction"}}], "@id": "/authorities/genreForms/gf2014026325"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026326", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExperimental poetry", "identifiers:lccn": "gf2014026326", "madsrdf:adminMetadata": [{"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb1"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Experimental poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026269"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026270"}], "madsrdf:hasSource": [{"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb5"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb6"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb7"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb8"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb9"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb10"}], "madsrdf:hasVariant": {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that emphasize innovative or unconventional technique at the time they were created."}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-25T15:56:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Experimental poetry"}}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sound poetry: the practice of sound poetry has fairly distinct origins in an extensive, international network of avant-garde poets from the late 19th c. into the 1930s, and it has been extended and theorized by neo-avant-garde poets from the 1940s to the present. In Europe, nearly all the historical avant-garde movements practiced a version of sound poetry)"}, "madsrdf:citationSource": "New Princeton encyclopedia of poetry and poetics, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Experimental poetry/The avant-garde: Experimental poetry attempts to reveal order within the writer's working materials, allowing language to reveal its own meanings and patterns rather than imposing the writer's meaning onto the words)"}, "madsrdf:citationSource": "Encyclopedia of American poetry, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(concrete poetry: An experimental form of poetry, flourishing in the 1960s, which concentrated on isolated and particular aspects of visual, phonetic or kinetic structure, abandoning normal forms of meaning for those disclosed at or below the level of the single word)"}, "madsrdf:citationSource": "Cambridge guide to literature in English, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Primer of experimental poetry, 1971-", "madsrdf:citationStatus": "found"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Experimental poetry. UF Avant-garde poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Experimental literature refers to written work--usually fiction or poetry--that emphasizes innovation, most especially in technique.)"}, "madsrdf:citationSource": "Wikipedia, Jan. 14, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Avant-garde poetry"}}, {"@id": "_:na53f7ed49dc14ffb98ac5f37ed42c73fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Avant-garde poetry"}}], "@id": "/authorities/genreForms/gf2014026326"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026327", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFables", "identifiers:lccn": "gf2014026327", "madsrdf:adminMetadata": [{"@id": "_:nfbc70557af5044dca3c0148721924b90b1"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fables"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfbc70557af5044dca3c0148721924b90b3"}]}, "madsrdf:exampleNote": "Note under [Parables]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026323"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026344"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026143"}, "madsrdf:hasSource": [{"@id": "_:nfbc70557af5044dca3c0148721924b90b5"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b6"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b7"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b8"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b9"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b10"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b11"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b12"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b13"}], "madsrdf:hasVariant": [{"@id": "_:nfbc70557af5044dca3c0148721924b90b14"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b17"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b20"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b23"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Stories intended to teach moral lessons, and whose main characters are generally animals or inanimate objects that speak and act like human beings. For short, simple stories that convey a moral lesson, and whose main characters are generally humans, see [Parables.]"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-02-21T10:29:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fables"}}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fabular: of, relating to, or having the form of a fable; fable: a fictitious narrative or statement: such as a) a legendary story of supernatural happenings b) a narration intended to enforce a useful truth, especially : one in which animals speak and act like human beings c) falsehood, lie)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Nov. 14, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fables. UF Cautionary tales and verse, Moral and philosophical stories, Morality tales.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 204 (fabular tales of high school life)"}, "madsrdf:citationSource": "Looking with Robert Gardner, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 299 (fabular tales of sacrifice and loss among friends)"}, "madsrdf:citationSource": "Historicizing emotions, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fable. A narration intended to enforce a useful truth; especially, one in which animals or inanimate objects speak and act like human beings. The Fable differs from the ordinary folktale in that it has a moral that is woven into the story and often explicitly formulated at the end.)"}, "madsrdf:citationSource": "Merriam Webster's encyclopedia of literature, 1995", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A fable is also a brief story illustrating a moral. Unlike the parables, fables often include talking animals or animated objects as the principal characters. The interaction of these animals or inanimate things reveals general truths about human nature, i.e., a person can learn practical lessons from the fictional antics in a fable. However, the lesson learned is not allegorical. Each animal is not necessarily a symbol for something else. Instead, the reader learns the lesson as an exemplum--an example of what one should or should not do.)"}, "madsrdf:citationSource": "Wheeler, K. Parables and fables : from symbolism to allegory?, via WWW, Apr. 4, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fable: A short narrative in prose or verse in which the action of the characters, usually animals, conveys a moral lesson.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fable: A brief tale in verse or prose that conveys a moral lesson, usually by giving human speech and manners to animals and inanimate things. Fables often conclude with a moral, delivered on the form of an epigram. A very old form of story related to folklore and proverbs, the fable in Europe descends from tales attributed to Aesop)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fables. BT Exempla; Fiction)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfbc70557af5044dca3c0148721924b90b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Philosophical and moral tales"}}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Philosophical and moral tales"}}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfbc70557af5044dca3c0148721924b90b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Morality tales"}}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Morality tales"}}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfbc70557af5044dca3c0148721924b90b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fabular tales"}}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fabular tales"}}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfbc70557af5044dca3c0148721924b90b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cautionary tales"}}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cautionary tales"}}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfbc70557af5044dca3c0148721924b90b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Moral and philosophical tales"}}, {"@id": "_:nfbc70557af5044dca3c0148721924b90b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Moral and philosophical tales"}}], "@id": "/authorities/genreForms/gf2014026327"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026328", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFabliaux", "identifiers:lccn": "gf2014026328", "madsrdf:adminMetadata": [{"@id": "_:n84499a7ceb634c62a9852081f8d960d0b1"}, {"@id": "_:n84499a7ceb634c62a9852081f8d960d0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fabliaux"}, "madsrdf:elementList": {"@list": [{"@id": "_:n84499a7ceb634c62a9852081f8d960d0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379"}, "madsrdf:hasSource": [{"@id": "_:n84499a7ceb634c62a9852081f8d960d0b5"}, {"@id": "_:n84499a7ceb634c62a9852081f8d960d0b6"}, {"@id": "_:n84499a7ceb634c62a9852081f8d960d0b7"}, {"@id": "_:n84499a7ceb634c62a9852081f8d960d0b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Bawdily humorous medieval tales that were generally written in eight-syllable verse."}, {"@id": "_:n84499a7ceb634c62a9852081f8d960d0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n84499a7ceb634c62a9852081f8d960d0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-05T15:10:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n84499a7ceb634c62a9852081f8d960d0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fabliaux"}}, {"@id": "_:n84499a7ceb634c62a9852081f8d960d0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fabliaux. Use for bawdily humorous metrical tales of a type found chiefly in 12th and 13th century French poetry.)"}, "madsrdf:citationSource": "Genre terms: a thesaurus for use in rare book and special collections cataloging, via the Rare Books and Manuscripts Section website, Dec. 14, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n84499a7ceb634c62a9852081f8d960d0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fabliau: A medieval tale in eight-syllable verse. Humorous, often bawdy, fabliaux frequently satirized women and the clergy. Adaptations of the fabliau appear in several of Geoffrey Chaucer's tales, including those of the Miller, the Reeve, the Friar, the Summoner, and the Merchant)"}, "madsrdf:citationSource": "Morner, K. NTC's dictionary of literary terms, c1991", "madsrdf:citationStatus": "found"}, {"@id": "_:n84499a7ceb634c62a9852081f8d960d0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fabliau: A short narrative octosyllabic verse, usually of 300 to 400 lines. The genre flourished in France between 1150 and 1400 A.D. About 150 are extant. The earliest known is Richeut (1159), but it seems likely that they existed because disapproval of them was expressed in Egbert's Poenitentiale of the 8 c. Fabliaux tended to be ribaldly comic tales. They were satirical, in a rough and ready fashion, often at the expense of the clergy. Their caustic attitude towards women may have been a reaction against courtly love. The form is primarily French, but there are examples in English literature, like Chaucer's Miller's Tale and Reeve's Tale (late 14th c.))"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms, 1982", "madsrdf:citationStatus": "found"}, {"@id": "_:n84499a7ceb634c62a9852081f8d960d0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fabliau (plural, Fabliaux): A humorous tale popular in medieval France. The conventional verse form of the fabliau was the eight-syllable couplet. Fabliaux were stories of various types, but one point was uppermost--humorous, sly satire. Although fabliaux may have ostensible \"morals\" appended, they lack the serious intention of the fable, and they differ from the fable too in always having human characters and in always maintaining a realistic tone and manner)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2006", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026328"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026329", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFairy tales", "identifiers:lccn": "gf2014026329", "madsrdf:adminMetadata": [{"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb1"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fairy tales"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026344"}, "madsrdf:hasSource": [{"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb5"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb6"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb7"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb8"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb9"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb10"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb11"}], "madsrdf:hasVariant": [{"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb12"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb15"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb18"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb21"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb24"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short simple folk narratives that feature fantastic forces and magical beings and are usually intended for children."}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-15T09:13:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fairy tales"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fairy tales. UF Fairytales)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fairy tales. Use for short simple narratives often of folk origin and usually intended for children, involving fantastic forces and magical beings such as dragons, elves, fairies, goblins, witches and wizards.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(M\u00e4rchen, plural M\u00e4rchen, folktale characterized by elements of magic or the supernatural, such as the endowment of a mortal character with magical powers or special knowledge; variations expose the hero to supernatural beings or objects. The German term M\u00e4rchen, used universally by folklorists, also embraces tall tales and humorous anecdotes; although it is often translated as \"fairy tale,\" the fairy is not a requisite motif. M\u00e4rchen usually begin with a formula such as \"once upon a time,\" setting the story in an indefinite time and place)"}, "madsrdf:citationSource": "Encylop\u00e6dia Britannica online, July 11, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(M\u00e4rchen n. pl. M\u00e4rchen. A folktale or fairy story.)"}, "madsrdf:citationSource": "The American heritage dictionary of the English language, \u00a92000, via TheFreeDictionary.com, viewed on May 16, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Magic tale. A lengthy folktale containing elements of fantasy, such as animals endowed with speech, magical objects, monsters and witches, or marvelous helpers and partners. The term magic tale (Aarne's Zauberm\u00e4rchen) corresponds to the term fairy tale. Certain folklorists and literary critics have suggested the use of the term magic tale in order to distinguish oral folktales from literary tales of fantasy. Because oral and literary traditions have intermingled repeatedly in European tales during the past few centuries, favoring the term magic tale over the more widely known fairy tale is simply a matter of taste.)"}, "madsrdf:citationSource": "Folklore : an encyclopedia of beliefs, customs, tales, music, and art, c1997", "madsrdf:citationStatus": "found"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fairy tale: A story about the adventures of fairies and similar supernatural beings, especially for children.)"}, "madsrdf:citationSource": "Ruse, C. The Cassell dictionary of literary and language terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fairy tale. Fairy tales may be distinguished from other folk narratives such as legends (which generally involve belief in the veracity of the events described) and explicitly moral tales, including beast fables. Some folklorists prefer to use the German term M\u00e4rchen or \"wonder tale\" to refer to the genre over fairy tale)"}, "madsrdf:citationSource": "Wikipedia, May 16, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magic tales"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magic tales"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fairy stories"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fairy stories"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wonder tales"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wonder tales"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "M\u00e4rchen"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "M\u00e4rchen"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fairytales"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fairytales"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories, Fairy"}}, {"@id": "_:nc78e47e72fd14ca78e6e21a3095bf6ecb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories, Fairy"}}], "@id": "/authorities/genreForms/gf2014026329"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026330", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFan fiction", "identifiers:lccn": "gf2014026330", "madsrdf:adminMetadata": [{"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b1"}, {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fan fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b5"}, {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b6"}, {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b7"}], "madsrdf:hasVariant": {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that incorporates characters and/or settings of books, television programs, etc., of which the authors are fans."}, {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:17:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fan fiction"}}, {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 44 (Fan fiction--non-profitable, non-commercial texts based on other fictional texts (series, movies, and books) and written by their fans--has boomed with the development of the internet, to which it has moved from privately printed fanzines) p. 46 (initially, fans' activities were based in usenet and then yahoo message groups; then they were largely relocated to the forums, and nowadays towards blogs; fan fiction's set of internal genres includes \"missing scenes\" fanfiction, \"Alternative Universe\" fan fiction (AU) where the whole canon may be completely changed, and \"crossovers\" combining different sources in one story)"}, "madsrdf:citationSource": "Internet fictions, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fan fiction: fiction, usually fantasy or science fiction, written by a fan rather than a professional author, esp. that based on already-existing characters from a television series, book, film, etc.; (also) a piece of such writing; also fanfic or fan fic)"}, "madsrdf:citationSource": "Oxford English dict. online, Apr. 4, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(web fiction is original fiction written for and published to the web; unlike fan fiction, web fiction is published on blogs or blog-like websites, and its writers typically have more serious aspirations and write in story arcs)"}, "madsrdf:citationSource": "James, E. Web literature : publishing on the social web, via WWW, Dec. 7, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fanfic"}}, {"@id": "_:nc324fa66bd724fdf8bd8edccf533a267b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fanfic"}}], "@id": "/authorities/genreForms/gf2014026330"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026331", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFantasy comics", "identifiers:lccn": "gf2014026331", "madsrdf:adminMetadata": [{"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b1"}, {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fantasy comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026025"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026122"}], "madsrdf:hasSource": [{"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b5"}, {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b6"}, {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b7"}], "madsrdf:hasVariant": {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics in which magic and extraordinary characters are integral to the story."}, {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:17:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantasy comics"}}, {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Science fiction comic books, strips, etc.; Science fiction. For works that deal with non-existent, incredible, or unreal worlds, characters, and physical principles, use Fantasy fiction)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 157 (Fantasy Graphic Novels)"}, "madsrdf:citationSource": "Fletcher-Spear, K. Library collections for teens : manga and graphic novels, c2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy comic books, strips, etc.)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fantastic comics"}}, {"@id": "_:n6ee94cd1ee2b4abba21e98cc1c26c774b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantastic comics"}}], "@id": "/authorities/genreForms/gf2014026331"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026332", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFantasy drama", "identifiers:lccn": "gf2014026332", "madsrdf:adminMetadata": [{"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b1"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fantasy drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026081"}, "madsrdf:hasSource": [{"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b5"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b6"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b7"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b8"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b9"}], "madsrdf:hasVariant": {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays in which magic and extraordinary characters are integral to the story."}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:18:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantasy drama"}}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 265-267 (Fantasy: Fantasy exists in a world that most people believe never could be, while Science Fiction worlds are those we accept as possible, even if improbable. Science Fiction generally offers something radically new and different, but Fantasy frequently takes a familiar story, legend, or myth and adds a twist, a new way of looking at things that brings it to life again. The key to Fantasy, however, is the presence of magic. If there is no magic, the story may fit in the Horror, Science Fiction, Romance, Historical Fiction, or Adventure genres. When magic is integral to the story, it must be Fantasy.)"}, "madsrdf:citationSource": "Saricks, J. Readers' advisory guide to genre fiction, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Moore, S. Three fantasy plays for a carnival theater, 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy: usually designates a conscious breaking free from reality. The term is applied to a work that takes place in a nonexistent and unreal world, such as fairyland, or concerns incredible and unreal characters)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy drama)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "McGowan, M.A. An analysis of the fantasy plays of James M. Barrie utilizing Vladimir Propp's structural model of the fairy tale, 1983.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fantastic drama"}}, {"@id": "_:n4e204b63cd0a4dfa8d528c2c5efed1e2b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantastic drama"}}], "@id": "/authorities/genreForms/gf2014026332"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026333", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFantasy fiction", "identifiers:lccn": "gf2014026333", "madsrdf:adminMetadata": [{"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb1"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fantasy fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026073"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026057"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026123"}], "madsrdf:hasSource": [{"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb5"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb6"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb7"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb8"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb9"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb10"}], "madsrdf:hasVariant": [{"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb11"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction in which magic and extraordinary characters are integral to the story."}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:19:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantasy fiction"}}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (a fantasy is: a fiction evoking wonder and containing a substantial and irreducible element of the supernatural with which the mortal characters in the story or the readers become on at least partly familiar terms) p. 7 (wonder is of course generated by fantasy purely from the presence of the supernatural or impossible, and from the element of mystery and lack of explanation that goes with it. The science fiction writer throws a rope of the conceivable (how remotely so does not matter) from our world to his: the fantasy writer does not) p. 8 (Fantasy often draws spiritual nourishment from the past, particularly from a medieval and/or Christian world order; whereas science fiction is usually concerned with the future and the way we may develop) p. 9 (the supernatural or impossible in fantasy is not simply strange and wonderful; the reader becomes partially familiar with or at home in the marvellous worlds presented, and the mortal characters establish relationships with beings or objects from the 'beyond'; it is this, more than anything else, that distinguishes fantasy from the ghost and horror story. In the latter the supernatural is left entirely alien, for the point is the shock)"}, "madsrdf:citationSource": "Manlove, C. Modern fantasy, 1975:", "madsrdf:citationStatus": "found"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy fiction. Use for works that feature imaginary worlds, extraordinary creatures, sorcerers, epic quests or magic)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 265-267 (Fantasy: Fantasy exists in a world that most people believe never could be, while Science Fiction worlds are those we accept as possible, even if improbable. Science Fiction generally offers something radically new and different, but Fantasy frequently takes a familiar story, legend, or myth and adds a twist, a new way of looking at things that brings it to life again. The key to Fantasy, however, is the presence of magic. If there is no magic, the story may fit in the Horror, Science Fiction, Romance, Historical Fiction, or Adventure genres. When magic is integral to the story, it must be Fantasy. The presence of magic or enchantment is the element that most clearly distinguishes Fantasy from other genres. Magic may manifest itself in the existence of a magical sword or magical powers; there may be creatures that readers know can exist in none but a magical world; or there may be a feeling of otherness, a sense of enchantment that grows throughout the story)"}, "madsrdf:citationSource": "Saricks, J. Readers' advisory guide to genre fiction, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy fiction. UF Fantastic fiction; Heroic fantasy (Fiction))"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy: any piece of writing that extends the imagination beyond what seems possible; often inventing imaginary worlds set in the past and future)"}, "madsrdf:citationSource": "Ruse, C. The Cassell dict. of lit. and lang., 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fantasy novel: Any novel that is removed from reality--especially those novels set in nonexistent worlds, such as an elvish kingdom, on the moon, in Pellucidar (the hollow center of the earth), or in alternative versions of the historical world--such as a version of London where vampires or sorcerers have seized control of parliament. The characters are often something other than humans, or human characters may interact with nonhuman characters such as trolls, dragons, munchkins, kelpies, etc. Examples include J. R. R. Tolkien's The Hobbit, Ursula LeGuin's A Wizard of Earthsea, Michael Moorcock's The Dreaming City, or T. H. White's The Once and Future King)"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fantastic fiction"}}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantastic fiction"}}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Heroic fantasy fiction"}}, {"@id": "_:neb16efdbd5e44a20b28d96f8af4f536bb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heroic fantasy fiction"}}], "@id": "/authorities/genreForms/gf2014026333"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026334", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFantasy poetry", "identifiers:lccn": "gf2014026334", "madsrdf:adminMetadata": [{"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b1"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fantasy poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b5"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b6"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b7"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b8"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b9"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b10"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b11"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b12"}], "madsrdf:hasVariant": {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b13"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems in which magic and extraordinary characters are integral to the story."}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:19:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantasy poetry"}}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy poetry: Used for poetry that features imaginary worlds, extraordinary creatures, sorcerers, epic quests, or magic.)"}, "madsrdf:citationSource": "Genre terms for the Children's book & play review viewed via the website of the Harold B. Lee Library, Brigham Young University, Jan. 14, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hidden places, secret words : an anthology of fantasy poetry, c1980.", "madsrdf:citationStatus": "found"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy: A form of literature characterized by highly imaginative or supernatural events.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy poetry--whose core concepts are based on magic rather than technology, or derived from myths or fairy tales)"}, "madsrdf:citationSource": "Bergmann, F.J. What is this thing called genre poetry, in Verse Wisconsin online, issue 102, viewed on Jan. 14, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xii (Fantastic poems range in the material they treat from the strange but explainable to the utterly fanciful, from horror to wonder, and from the rigidly verisimilitudinous to the purely surrealist. They may utilize traditional prosody or may avail themselves of the discontinuities and fragmentation of modernist free verse. They may use as setting the primary world, a secondary word, or a combination of the two.)"}, "madsrdf:citationSource": "The poetic fantastic, 1989:", "madsrdf:citationStatus": "found"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 265-267 (Fantasy: Fantasy exists in a world that most people believe never could be, while Science Fiction worlds are those we accept as possible, even if improbable. Science Fiction generally offers something radically new and different, but Fantasy frequently takes a familiar story, legend, or myth and adds a twist, a new way of looking at things that brings it to life again. The key to Fantasy, however, is the presence of magic)"}, "madsrdf:citationSource": "Saricks, J. Readers' advisory guide to genre fiction, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy poetry)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fantastic poetry"}}, {"@id": "_:n65a05af9992c4e9ebae4cb61cc43b620b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantastic poetry"}}], "@id": "/authorities/genreForms/gf2014026334"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026335", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFarces", "identifiers:lccn": "gf2014026335", "madsrdf:adminMetadata": [{"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b1"}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Farces"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026222"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026228"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026300"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026044"}], "madsrdf:hasSource": [{"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b5"}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b6"}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b7"}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b8"}], "madsrdf:hasVariant": {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comedy plays characterized by improbable situations, physical antics, fast-moving action, and stock characters."}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:26:18"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Farces"}}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (Farce: One of the major genres of drama, sometimes regarded as a subclass of comedy. It aims to entertain and to provoke laughter, and its humor is a result primarily of physical activity and visual effects.)"}, "madsrdf:citationSource": "Wilson, E. The theater experience, c2004, via McGraw-Hill Higher Education online learning center, Nov. 14, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(farce. A kind of comedy that inspires hilarity mixed with panic and cruelty in its audience through an increasingly rapid and improbable series of ludicrous confusions, physical disasters, and sexual innuendos among its stock characters. Farcical episodes of buffoonery can be found in European drama of all periods since Aristophanes; as a distinct form of full-length comedy farce dates from the 19th century; a writer of farces is sometimes called a farceur)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(farce. A type of dramatic comedy characterized by broad, visual effects, fast moving action, and stock characters, whose escapades lead them to, but never beyond, the brink of disaster.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Farces)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Farcical drama"}}, {"@id": "_:n1c2e0f45c26944a085ef5f99781908a3b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Farcical drama"}}], "@id": "/authorities/genreForms/gf2014026335"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026336", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFastnachtsspiele", "identifiers:lccn": "gf2014026336", "madsrdf:adminMetadata": [{"@id": "_:n2cd288b74ed341418d8eb05193c084a4b1"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fastnachtsspiele"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2cd288b74ed341418d8eb05193c084a4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n2cd288b74ed341418d8eb05193c084a4b5"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b6"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b7"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b8"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b9"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b10"}], "madsrdf:hasVariant": [{"@id": "_:n2cd288b74ed341418d8eb05193c084a4b11"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b14"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b17"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Amateur one-act plays that were usually performed at Shrove Tuesday festivals in 15th-16th century Germany."}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:19:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fastnachtsspiele"}}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fastnachtspiel (plural -spiele). A kind of short popular drama performed by townsfolk in Germany during the Shrove Tuesday (Fastnacht) festivals in the 16th century. Most surviving examples are from Nuremberg, where Hans Sachs (1494-1576) was the foremost author of such plays.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fastnachtsspiel, Das; nominative plural: Die Fastnachtsspiele)"}, "madsrdf:citationSource": "Duden online, Feb. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fastnachtspiel ('Shrove Tuesday play'). A dramatic genre whose origins are to found in the 15th c. Shrovetide masquerades. They were mostly short--not much more than 'playlets'--and were presented and performed by townspeople. They might, in fact, be considered as early instances of community theatre)"}, "madsrdf:citationSource": "Cuddon, J.A. A dict. of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Carnival play, see Fastnachsspiel; Fastnachtsspiel, the German Carnival or Shrovetide play of the 15th century, in one act, performed mainly in Nuremberg by students and artisans. It shows, in somewhat crude couplets, a mingling of religious and popular elements interesting in the light of later developments in German drama. In its earliest form it had no plot but developed, independently of religious drama, from a sequence of narrated episodes in which each character endeavoured to outdo the others in absurdity or obscenity)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fastnachtsspiel (German: carnival play). In medieval Germany, a type of one-act play that developed separately from the liturgical drama during the 15th century and was usually performed on Shrove Tuesday by craftsmen or students in the open air. The plays were crude comedies and ribald farces featuring as their main character a fool known as the Narr. Favourite subjects included the relationships between churchmen and their female parishioners, and doctors and their patients. The genre sometimes contained elements of the morality play. Many Fastnachtsspiele were written by Meistersinger, such as Hans Sachs and Hans Rosenpl\u00fct.)"}, "madsrdf:citationSource": "DictionaryCentral.com, Nov. 14, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Carnival plays. UF Fastnachtspiele, Fastnachtsspiele, Shrove Tuesday plays, Shrovetide plays. BT Drama)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2cd288b74ed341418d8eb05193c084a4b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shrove Tuesday plays"}}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shrove Tuesday plays"}}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2cd288b74ed341418d8eb05193c084a4b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fastnachtspiele"}}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fastnachtspiele"}}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2cd288b74ed341418d8eb05193c084a4b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shrovetide plays"}}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shrovetide plays"}}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2cd288b74ed341418d8eb05193c084a4b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Carnival plays"}}, {"@id": "_:n2cd288b74ed341418d8eb05193c084a4b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Carnival plays"}}], "@id": "/authorities/genreForms/gf2014026336"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026337", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFatras", "identifiers:lccn": "gf2014026337", "madsrdf:adminMetadata": [{"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b1"}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fatras"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026455"}, "madsrdf:hasSource": [{"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b5"}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b6"}], "madsrdf:hasVariant": [{"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b7"}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b10"}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Medieval French nonsense verse composed in one or more stanzas of eleven lines."}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:19:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fatras"}}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fatras (also called fatrasie, fratrasie, resverie). An irrational and deliberately obscure piece of verse that, originating in the Middle Ages, constituted a mode of licensed regression into unreason, absurdity, and nonsense in which pleasure is taken in the creative and willful defiance of sense that the verse form celebrates. It is generally lively and joyous in style, full of word play, ridiculous associations of ideas, and deliberate nonsense. Qua genre, however, it is not the incoherence of content that constitutes the fatras but its special form: a strophe of 11 lines, the first and last of which form a distich placed at the beginning as the theme of the composition. This is known as the fatras simple. The fatras double is formed from this by \"restating the initial [distich] in reverse order, and adding a second strophe of ten lines ending with an 11th, a restatement of line one of the [distich]\" Porter distinguishes between the fratrasie and the fatras, a later development. The former is invariably composed of a single strophe of 11 lines, and its content is always irrational; in the fatras, the opening distich introduces the next 11 lines, serving as their first and last line and imparting a uniform rhythm to the whole poem.)"}, "madsrdf:citationSource": "The Princeton encyc. of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Fatras, fatrasie, fratrasie, resverie, could be described as the ravings of a happy lunatic. The verse is joyously irrational with no clear direction and yet it has a unique defined structure. Originating in Europe in the Middle Ages it is upbeat, \"full of wordplay, ridiculous associations, and intentional nonsense.\" The Fatras is: 1. a poem in 11 lines. 2. composed in a way that the 1st and last lines form a distich, a poem in 2 lines, that holds the entire theme of the larger poem. This is known as the fatras simple. 3. unmetered. 4. unrhymed. 5. written with clever wordplay and disconnected nonsense which set the tone. The fatras possible allows for some coherent text, the fatras impossible make no sense at all. 6. a fatras double when 2 eleven line stanzas are formed, with the lines of the distich reversed in the 2nd stanza. The last line is a restatement of L1 of the poem)"}, "madsrdf:citationSource": "Poetry magnum opus website, Oct. 22, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fatrasies"}}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fatrasies"}}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Resveries"}}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Resveries"}}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fratrasies"}}, {"@id": "_:nd7f7f4f235dc43c6b5088f6d79b6e6a3b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fratrasies"}}], "@id": "/authorities/genreForms/gf2014026337"}
