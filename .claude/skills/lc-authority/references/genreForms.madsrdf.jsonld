{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026976", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOperas", "identifiers:lccn": "gf2014026976", "madsrdf:adminMetadata": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b1"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Operas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b5"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b8"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b11"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b14"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027032"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027133"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027141"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026090"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026104"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026067"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026068"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026005"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026006"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026009"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026107"}], "madsrdf:hasSource": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b17"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b18"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b19"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b20"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b21"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b22"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b23"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b24"}], "madsrdf:hasVariant": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b25"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b28"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b31"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b34"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b37"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b40"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b43"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b46"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b49"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b52"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b55"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b58"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b61"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b64"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Staged dramatic works in which the actors sing most or all of their parts, and other types of musico-dramatic works that have significant portions of spoken text and have historically been regarded as forming part of the operatic repertory.", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026273"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026274"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026645"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026043"}]}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-11-23T12:02:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Operas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed operettas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed operettas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed operas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed operas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised operas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised operas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Opera adaptations"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Opera adaptations"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"A guide to 167 European comic operas, light operas, operettas, op\u00e9ra-comiques, op\u00e9ra-bouffes, and opera buffas ...\")"}, "madsrdf:citationSource": "Ewen, D. Book of European light opera, 1977", "madsrdf:citationStatus": "found"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Singspiel (musico-dramatic work with a German text, especially a work written in the 18th or early 19th century in which spoken dialogue alternates with songs and sometimes with ensembles, choruses, or more extended musical pieces)"}, "madsrdf:citationSource": "New Harvard dict. of mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Operetta (in the 17th and 18 centuries, an operatic work of small scale and pretensions that could equally well be classified as intermezzo, opera buffa, op\u00e9ra comique, or Singspiel)"}, "madsrdf:citationSource": "New Harvard dict. of mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Intermezzo (term applied during the 18th century in place of the earlier Intermedio to a miniature comic opera in Italian (the French counterpart is the interm\u00e8de) performed in segments between the acts of a larger work, usually an opera seria; flourished during the first half of the 18th century, then gradually disappeared, giving way to the fully-fledged comic opera)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, May 8, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b21", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Op\u00e9ra comique (opera on a French text with musical numbers separated by spoken dialogue)"}, "madsrdf:citationSource": "New Harvard dict. of mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b22", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Comic opera (opera with humorous or lighthearted subject matter)"}, "madsrdf:citationSource": "New Harvard dict. of mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b23", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Burletta (A type of English operatic comedy that flourished in the late 18th and early 19th centuries. The term was one of several used for Italian comic operas of the light intermezzo variety; early burlettas, in verse throughout and all-sung, satirized the mythological and historical conventions of opera seria, though the music rarely participated in the joke)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Jul. 8, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b24", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Opera seria 2 (Opera serias as a group)"}, "madsrdf:citationSource": "Encarta.msn.com dictionary WWW site, May 8, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Intermezzos (Operas)"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intermezzos (Operas)"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Singspiels"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Singspiels"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Puppet operas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puppet operas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Light operas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Light operas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed operettas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed operettas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b40", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b41"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Operettas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b41", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Operettas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b43", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b44"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Opera adaptations"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b44", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Opera adaptations"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b46", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b47"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Burlettas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b47", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Burlettas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b49", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b50"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Opera buffas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b50", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Opera buffas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b52", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b53"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comic operas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b53", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comic operas"}}, {"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b55", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ecb7d7bcac410a96d14eafad46c126b56"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed operas"}}, {"@id": "_: