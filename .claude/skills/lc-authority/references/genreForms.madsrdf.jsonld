{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026657", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBawdy songs", "identifiers:lccn": "gf2014026657", "madsrdf:adminMetadata": [{"@id": "_:n163770c696204052bfe3542b3aab55f1b1"}, {"@id": "_:n163770c696204052bfe3542b3aab55f1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bawdy songs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n163770c696204052bfe3542b3aab55f1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026870"}, "madsrdf:hasSource": [{"@id": "_:n163770c696204052bfe3542b3aab55f1b5"}, {"@id": "_:n163770c696204052bfe3542b3aab55f1b6"}], "madsrdf:hasVariant": {"@id": "_:n163770c696204052bfe3542b3aab55f1b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n163770c696204052bfe3542b3aab55f1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n163770c696204052bfe3542b3aab55f1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n163770c696204052bfe3542b3aab55f1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bawdy songs"}}, {"@id": "_:n163770c696204052bfe3542b3aab55f1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ribaldry (a bawdy song is a humorous song which emphasizes sexual themes and is often rich with innuendo)"}, "madsrdf:citationSource": "Wikipedia, viewed August 14, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n163770c696204052bfe3542b3aab55f1b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "The art of the bawdy song, p1992.", "madsrdf:citationStatus": "found"}, {"@id": "_:n163770c696204052bfe3542b3aab55f1b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n163770c696204052bfe3542b3aab55f1b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ribald songs"}}, {"@id": "_:n163770c696204052bfe3542b3aab55f1b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ribald songs"}}], "@id": "/authorities/genreForms/gf2014026657"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026658", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBeatboxing", "identifiers:lccn": "gf2014026658", "madsrdf:adminMetadata": [{"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b1"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Beatboxing"}, "madsrdf:elementList": {"@list": [{"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b5"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b6"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b7"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b8"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b9"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b10"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b11"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b12"}], "madsrdf:hasVariant": [{"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b13"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b16"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b19"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-28T13:05:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "revised"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Beatboxing"}}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(beatboxing: a musical style and technique based on the solo unaccompanied vocal imitation of percussion and turntabling sounds)"}, "madsrdf:citationSource": "Merriam-Webster online, Jan. 21, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Hip hop (Beatboxing (the art of producing drum-like sounds using one's mouth and body; descended from the practice of \"patting Juba\")) under Freestyle rap (...beatboxing (that is, emulating a hip-hop beat with their mouth))"}, "madsrdf:citationSource": "Grove music online, Jul. 8, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "History of beatboxing (beatboxing, as we know it, has its roots in the beginning of modern hip-hop, on street corners in placed like Chicago, the Bronx, and LA, and this is quite right. However, vocal percussion - the art form from which beatboxing spawns - has been part of the music and urban scene for a lot longer than people think; Beatboxing is the art of urban vocal percussion. i.e., imitating drum sounds and beat patterns using your lips, tongue, mouth, throat, and voice; the artist emulates the sounds of a 'beat box' or drum machine)"}, "madsrdf:citationSource": "Humanbeatbox.com, Jan. 21, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert (Chacera beatboxera: for beatboxer, clarinet, violin, percussion, piano; Massive: for beatboxer, clarinet, violin percussion, piano)"}, "madsrdf:citationSource": "Work cat: Warsaw Autumn 2008. CD no. 5, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beatboxing; beatboxer; beatbox; beatboxing is making music with the mouth. Rhythm, beats, and melody are achieved with the mouth and throat alone, simulating anything from musical instruments to turntable scratching and creating a wide range of sound effects.)"}, "madsrdf:citationSource": "Encyclopedia of rap and hip hop culture, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beatboxing; a form of vocal percussion primarily involving the art of producing drum beats, rhythm, and musical sounds using one's mouth, lips, tongue, and voice. It may also involve singing, vocal imitation of turntablism, and the simulation of horns, strings, and other musical instruments. Beatboxing today is connected with hip-hop culture, being one of \"the elements\", although it is not limited to hip-hop music... The term \"beatboxing\" is derived from the mimicry of the first generation of drum machines, then known as beatboxes.)"}, "madsrdf:citationSource": "Wikipedia, June 17, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(beatboxing: a musical style or technique, especially in hip-hop, in which the sounds and rhythms of percussion instruments or a drum machine are simulated by using the mouth and voice)"}, "madsrdf:citationSource": "Dictionary.com, Jan. 21, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 218 (beat boxing)"}, "madsrdf:citationSource": "Olison, K.D. Music in worship, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "B-box"}}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "B-box"}}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Human beatboxing"}}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Human beatboxing"}}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Beat boxing"}}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Beat boxing"}}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Beatbox"}}, {"@id": "_:n48c505ebc76b4139b6aade72f9ff0a96b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Beatbox"}}], "@id": "/authorities/genreForms/gf2014026658"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026659", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBeguines (Music)", "identifiers:lccn": "gf2014026659", "madsrdf:adminMetadata": [{"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb1"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Beguines (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb5"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb6"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb7"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb8"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb9"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb10"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb11"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb12"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb13"}], "madsrdf:hasVariant": [{"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb14"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Beguines (Music)"}}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 915 (in identifying an authentically Martinican musical genre, discourse on musical tradition singles out the beguine (biguine, bigin) because of its early origins and frequent use; the beguine--music and dance--can be distinguished by a binary rhythmic pattern)"}, "madsrdf:citationSource": "Garland encyc. world mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(beguine: ballroom dance similar to the rumba, based on a dance of Martinique and St. Lucia; the music for this dance)"}, "madsrdf:citationSource": "Amer. heritage dict., 3rd ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(beguine: vigorous popular dance of the islands of Saint Lucia and Martinique somewhat like the rumba)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(beguine: Latin American dance in a lively syncopated rhythm)"}, "madsrdf:citationSource": "Slonimsky, N. Baker's dict. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under French Antilles: biguine, beguine: very popular dance and song from Martinique and St. Lucia)"}, "madsrdf:citationSource": "White, D. Dict. pop. mus. styles of the world", "madsrdf:citationStatus": "found"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(beguine: Latin-American dance rhythm, which became a staple of many jazz bands in the 1930s and 1940s; the biguine, danced to a slow but sensuous rhythm, was a traditional dance from Martinique)"}, "madsrdf:citationSource": "Pickering, D. Cassell comp. to 20th-cent. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Martinique and Guadeloupe, Commercial music: biguine: best-known of the styles of musique cr\u00e9ole outside the French Antilles, having been performed in Paris by emigrant musicians as early as the 1920s; somewhat more associated with Guadeloupe)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Feb. 13, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(b\u00e9guine: social dance popular in Europe and America from the 1930s, with a rhythm similar to that of the bolero)"}, "madsrdf:citationSource": "New Harvard dict. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(beguine developed from musical tradition of Martinique and St. Lucia; became a fashionable dance known as the rumba-bolero in the 1930s)"}, "madsrdf:citationSource": "Work cat.: 99479698: Schmitt, M. Bakoua, c1996", "madsrdf:citationStatus": "found"}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bigins (Music)"}}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bigins (Music)"}}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biguines (Music)"}}, {"@id": "_:n57fa1e9f778a4a24bcf27d46b07d9bbcb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biguines (Music)"}}], "@id": "/authorities/genreForms/gf2014026659"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026660", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBhangra (Music)", "identifiers:lccn": "gf2014026660", "madsrdf:adminMetadata": [{"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b1"}, {"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bhangra (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b5"}, {"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b6"}, {"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b7"}, {"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Popular music that combines traditional bhangra drumming with modern Western instruments and rhythms."}, {"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T09:58:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bhangra (Music)"}}, {"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bhangra is the music of Britain's growing Asian population ... For decades bhangra was exclusively the province of the Punjabis, but by the late '70s it had emerged as the music of choice of second- and third-generation British Asians as well)"}, "madsrdf:citationSource": "All music guide, via WWW, Jan. 16, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (the most exciting bhangra album by Waaris Group)"}, "madsrdf:citationSource": "Work cat.: Maahiya [SR] p1992:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(What is bhangra? Bhangra is a generic term that has been adopted to describe modern Asian pop music. However, it is actually the correct term for the traditional agricultural folk music originating from the Punjab ... Modern bhangra began in the UK about twenty years ago and has its roots firmly in the traditional folk songs of the Punjab)"}, "madsrdf:citationSource": "Imperial College Sikh Society (Univ. of London) homepage, via WWW, Jan. 16, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nf65ee9abe63246eb95dfe6a726132a62b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bhangra: 1. a Punjabi dance music traditionally performed during harvest festivals and weddings, characterized by the beating of a large, two-headed drum 2. A popular style of music combining traditional bhangra drumming with modern Western instruments and rhythms)"}, "madsrdf:citationSource": "American Heritage Dictionary, via WWW, Jan. 16, 2003", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026660"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026661", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBh\u0101w\u0101iy\u0101", "identifiers:lccn": "gf2014026661", "madsrdf:adminMetadata": [{"@id": "_:n89ea95d5e7654733896007bceadc51abb1"}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bh\u0101w\u0101iy\u0101"}, "madsrdf:elementList": {"@list": [{"@id": "_:n89ea95d5e7654733896007bceadc51abb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, "madsrdf:hasSource": [{"@id": "_:n89ea95d5e7654733896007bceadc51abb5"}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb6"}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb7"}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb8"}], "madsrdf:hasVariant": [{"@id": "_:n89ea95d5e7654733896007bceadc51abb9"}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bh\u0101w\u0101iy\u0101"}}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bengali music. III, Local traditions. 2. Occupational songs: Bhawaiya denotes diverse genres originating in the high and dry land of Rangpur in Bangladesh and Coochbihar in West Bengal. One of these is a vocal genre associated with bullock-cart drivers. Bhaowaiya have a characteristic \"voice break,\" when the singer momentarily interrupts the melody with a plosive sound)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Jan. 4, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 5, p. 860, under Bengali folk music (Bh\u0101w\u0101iy\u0101; generic name referring to various song forms of the high, dry lands of Rangpur in Bangladesh and Koch Bihar in West Bengal; each form has a distinct name and possesses its own characteristic \"voice-breaking\" features, whereby the voice momentarily stops the melody with a discordant sound; covers a wide range of themes, from light to serious)"}, "madsrdf:citationSource": "Garland encyc. of world music:", "madsrdf:citationStatus": "found"}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Sachteil, v. 4, col. 727 (bh\u0101w\u0101iya; folk song of northern districts of Bengal)"}, "madsrdf:citationSource": "MGG, 2nd ed.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bhawaiya [in rom.])"}, "madsrdf:citationSource": "Work cat.: 99940879: Barm\u0101, S. Bh\u0101o\u1e8f\u0101i\u1e8f\u0101, 1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n89ea95d5e7654733896007bceadc51abb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bh\u0101o\u1e8f\u0101i\u1e8f\u0101"}}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bh\u0101o\u1e8f\u0101i\u1e8f\u0101"}}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n89ea95d5e7654733896007bceadc51abb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bhaowaiya"}}, {"@id": "_:n89ea95d5e7654733896007bceadc51abb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bhaowaiya"}}], "@id": "/authorities/genreForms/gf2014026661"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026662", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBikutsi", "identifiers:lccn": "gf2014026662", "madsrdf:adminMetadata": [{"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b1"}, {"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bikutsi"}, "madsrdf:elementList": {"@list": [{"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b5"}, {"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b6"}, {"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bikutsi"}}, {"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "T\u00eates Brul\u00e9es. Bikutsi fever [SR] p2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bikutsi is a rhythmic style which originated with the Beti people of present day Cameroon)"}, "madsrdf:citationSource": "All Music Guide, via WWW, Aug. 1, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n96dade1c47ce4b009e00e6ba89b6fc36b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert (The genre I perform is Bikutsi Pop music. Bikutsi is a genre coming from the south province of Cameroon, and means \"the hit of the floor,\" the dance of Bantu fighters)"}, "madsrdf:citationSource": "Work cat.: Forest, S. Bikutsi pop [SR] : the songs of So' Forest, p2002:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026662"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026663", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBlack metal (Music)", "identifiers:lccn": "gf2014026663", "madsrdf:adminMetadata": [{"@id": "_:nb14d4ea36edb42058729d1c94d010f94b1"}, {"@id": "_:nb14d4ea36edb42058729d1c94d010f94b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Black metal (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb14d4ea36edb42058729d1c94d010f94b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026854"}, "madsrdf:hasSource": [{"@id": "_:nb14d4ea36edb42058729d1c94d010f94b5"}, {"@id": "_:nb14d4ea36edb42058729d1c94d010f94b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb14d4ea36edb42058729d1c94d010f94b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb14d4ea36edb42058729d1c94d010f94b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb14d4ea36edb42058729d1c94d010f94b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Black metal (Music)"}}, {"@id": "_:nb14d4ea36edb42058729d1c94d010f94b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Black metal; extreme subgenre of heavy metal music; common traits include fast tempos, shrieked vocals, highly distorted guitars played with tremolo picking, blast beat drumming, raw recording, and unconventional song structures; first wave in 1980s; second wave in early 1990s; many artists express extreme anti-Christian and misanthropic views)"}, "madsrdf:citationSource": "Wikipedia, viewed August 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14d4ea36edb42058729d1c94d010f94b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (subtitle: the bloody rise of the Satanic metal underground) preamble (\"Black metal adopts the basic framework of the hardest strain of heavy metal, ripping it down to a poisoned, jagged splinter of aural hate.\" The genre originated in Norway and the most \"infamous\" black metal musician is the Norwegian Varg Vikernes. Musicians and fans are influenced by Satanism and pre-Christian Germanic religion and tradition. They are typically anti-Christian, fascist, and racist. Some take direct action through church burning, suicide, and murder.) p. 87 (An illustration from the Norwegian press indicates that the English words \"black metal\" are used in a non-English context) chapters 11-12 (detail the spread of black metal to Germany, Sweden, France, England, Eastern Europe, and the United States)"}, "madsrdf:citationSource": "Work cat.: 98-168794: Moynihan, M. Lords of chaos, 1998:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026663"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026664", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBluegrass music", "identifiers:lccn": "gf2014026664", "madsrdf:adminMetadata": [{"@id": "_:n97705d297b8f44d8931f51471afe9f2fb1"}, {"@id": "_:n97705d297b8f44d8931f51471afe9f2fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bluegrass music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n97705d297b8f44d8931f51471afe9f2fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026739"}, "madsrdf:hasSource": {"@id": "_:n97705d297b8f44d8931f51471afe9f2fb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n97705d297b8f44d8931f51471afe9f2fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n97705d297b8f44d8931f51471afe9f2fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n97705d297b8f44d8931f51471afe9f2fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bluegrass music"}}, {"@id": "_:n97705d297b8f44d8931f51471afe9f2fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bluegrass. Part of the American country music traditions, with its heyday in the 1940s. Its characteristics are a quick tempo, with fiddle, banjo, and mandolin prominent)"}, "madsrdf:citationSource": "The Oxford companion to music, viewed July 14, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026664"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026665", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBlues (Music)", "identifiers:lccn": "gf2014026665", "madsrdf:adminMetadata": [{"@id": "_:ne18156589b66402593892f6e94170e65b1"}, {"@id": "_:ne18156589b66402593892f6e94170e65b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Blues (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne18156589b66402593892f6e94170e65b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026666"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026669"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027055"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026135"}], "madsrdf:hasSource": {"@id": "_:ne18156589b66402593892f6e94170e65b5"}, "madsrdf:hasVariant": {"@id": "_:ne18156589b66402593892f6e94170e65b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne18156589b66402593892f6e94170e65b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne18156589b66402593892f6e94170e65b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne18156589b66402593892f6e94170e65b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blues (Music)"}}, {"@id": "_:ne18156589b66402593892f6e94170e65b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "secular black-American folk music of the 20th century, which has a history and evolution separate from, but sometimes related to, that of jazz; until the end of World War II blues recordings had been classified and marketed as race records--this segregation contributed to the development of postwar rhythm-and-blues, a term free of racial connotations"}, "madsrdf:citationSource": "New Grove dict. of Amer. mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne18156589b66402593892f6e94170e65b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne18156589b66402593892f6e94170e65b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jive"}}, {"@id": "_:ne18156589b66402593892f6e94170e65b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jive"}}], "@id": "/authorities/genreForms/gf2014026665"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026666", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBlues-rock music", "identifiers:lccn": "gf2014026666", "madsrdf:adminMetadata": [{"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb1"}, {"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Blues-rock music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026665"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}], "madsrdf:hasSource": [{"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb5"}, {"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb6"}, {"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb7"}, {"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blues-rock music"}}, {"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under United States: Blues rock: electrified blues and rock fusion music)"}, "madsrdf:citationSource": "White, D. Dict. pop. mus. styles world", "madsrdf:citationStatus": "found"}, {"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Blues-rock: style of popular music that flourished during the 1960s; originated in and is particularly associated with Britain; attempted to counter the banality of the hit-parade material and of rock and roll by retrieving what was felt to be emotionally more \"authentic\" blues material; by the mid-1960s, some white U.S. musicians, of a slightly younger generation, were making much use of similar blues material)"}, "madsrdf:citationSource": "Grovemusic.com WWW site, Oct. 31, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Blues-rock: Though much early rock & roll was based in the blues, blues-rock didn't fully develop into a subgenre until the late '60s; in the early '70s, the lines between blues-rock and hard rock were barely visible; however, blues-rock soon backed away from hard rock, and there was a set number of acts that continued to play (and rewrite) blues standards as well as write their own songs in the same idiom; in the '80s and '90s, blues-rock was more roots-oriented than in the '60s and '70s)"}, "madsrdf:citationSource": "All music guide WWW site, Oct. 31, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n8616b6cc1aa44eb5a3d321779fe3a6ccb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 00104616: Blues-rock explosion, c2001.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026666"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026667", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBoleros (Music)", "identifiers:lccn": "gf2014026667", "madsrdf:adminMetadata": [{"@id": "_:nbe4372af935d46c580b8845429679205b1"}, {"@id": "_:nbe4372af935d46c580b8845429679205b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Boleros (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbe4372af935d46c580b8845429679205b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:nbe4372af935d46c580b8845429679205b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbe4372af935d46c580b8845429679205b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbe4372af935d46c580b8845429679205b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbe4372af935d46c580b8845429679205b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Boleros (Music)"}}, {"@id": "_:nbe4372af935d46c580b8845429679205b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bolero. A Spanish popular dance or song. The bolero is in moderate tempo and triple metre... Musically the Spanish bolero is usually in AAB form. The entry of the voice is preceded by at least one bar of sharply marked rhythm, and short instrumental interludes separate the sung couplets. The earliest rhythms took on characteristics closely related to traditional polonaise rhythm. Varying interpretations of the dance are found in Mexico, Cuba and other Latin American countries, especially Colombia and Venezuela. The Cuban bolero is a duple-metre dance that exhibits closer relationships with the habanera and Afro-Cuban musical styles than with its Spanish counterpart. It is a binary song form that developed from such 19th-century forms as the conga, danz\u00f3n and contradanza. Its often sentimental quatrains, sometimes as many as 20, are presented in two contrasting musical periods characterized by long, flowing melodies. Rhythm is characteristically complex and includes the use of the cinquillo and tresillo in the melody as well as in the accompaniment, which is for bongo, conga drum and claves.)"}, "madsrdf:citationSource": "Grove music online, viewed August 9, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026667"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026668", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBoogaloos (Music)", "identifiers:lccn": "gf2014026668", "madsrdf:adminMetadata": [{"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b1"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Boogaloos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b5"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b6"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b7"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b8"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b9"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b10"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b11"}], "madsrdf:hasVariant": [{"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b12"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b15"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b18"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b21"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Boogaloos (Music)"}}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Boogaloo, boo-ga-loo)"}, "madsrdf:citationSource": "LC database, May 8, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Boogaloo (shing-a-ling, popcorn music) is a genre of Latin music and dance that was very popular in the United States in the late 1960s. Boogaloo originated in New York City among teenage Cubans and Puerto Ricans. The style was a fusion of popular African American R&B, rock and roll and soul with mambo and son montuno. Boogaloo entered the mainstream through the American Bandstand television program)"}, "madsrdf:citationSource": "Wikipedia, Mar. 20, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "SalsaRoots.com Web site, June 7, 2006 (Boogalu (a.k.a. Boogaloo))", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Black Renaissance/Renaissance Noire July 31, 1999 v.2, no.2 p.22, \"Cha Cha with A Backbeat\" : Songs and Stories of Latin Boogaloo: \"Between the mambo and salsa, in the brief period spanning the years 1966-1968, the boogaloo was all the rage in the New York Latin community and beyond. It was both a bridge and a break, for with all the continuities and influences in terms of musical style, the boogaloo diverged from the prevailing models of Latin music in significant ways)"}, "madsrdf:citationSource": "BuscaSalsa.com, Mar. 20, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert (Boogaloo was one of Latin music's shortest-lived trends: it flared into life in the early 1960s and, within a decade ... [was] overtaken by what became known as salsa ... With hindsight, boogaloo was inevitable. Around 1960, the mambo obsession was cooling, and the ... cha-cha-cha was taking its place. New York bandleader Johnny Pacheco ... created a wilder, modern, very New York version called pachanga ... Pachanga was just a kick away from the crossbreed boogaloo -- or Latin soul as it was also known)"}, "madsrdf:citationSource": "Work cat.: The rough guide to boogaloo [SR] p2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Genre: Boogaloo: The sound of Latin teenagers in and around New York during the mid- to late-'60s, Boogaloo was an Anglicized form of Latin music incorporating R&B, mambo, and rock & roll, among other forms. Often known as popcorn music or shing-a-ling, the style is also quite similar to Latin soul)"}, "madsrdf:citationSource": "All Music Guide web page, Mar. 20, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Random House dict. (bugaloo, a fast dance of Afro-American origin...)", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Boo-ga-loos (Music)"}}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Boo-ga-loos (Music)"}}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bugaloos (Music)"}}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bugaloos (Music)"}}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Boogalus (Music)"}}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Boogalus (Music)"}}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Popcorn music"}}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Popcorn music"}}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shing-a-lings (Music)"}}, {"@id": "_:ne2bddda6921b426f9027f8e02abc64a6b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shing-a-lings (Music)"}}], "@id": "/authorities/genreForms/gf2014026668"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026669", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBoogie woogie (Music)", "identifiers:lccn": "gf2014026669", "madsrdf:adminMetadata": [{"@id": "_:n6a519b05cdc44aafa06d8d0aace95f57b1"}, {"@id": "_:n6a519b05cdc44aafa06d8d0aace95f57b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Boogie woogie (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6a519b05cdc44aafa06d8d0aace95f57b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026665"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}], "madsrdf:hasSource": {"@id": "_:n6a519b05cdc44aafa06d8d0aace95f57b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6a519b05cdc44aafa06d8d0aace95f57b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6a519b05cdc44aafa06d8d0aace95f57b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6a519b05cdc44aafa06d8d0aace95f57b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Boogie woogie (Music)"}}, {"@id": "_:n6a519b05cdc44aafa06d8d0aace95f57b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a percussive style of piano blues; associated with swing in the 1930's and 1940's; some recordings ... despite their titles, bear little relation to the original idiom; foundation of much of the Chicago blues idiom)"}, "madsrdf:citationSource": "New Grove dict. jazz", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026669"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026670", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBop (Music)", "identifiers:lccn": "gf2014026670", "madsrdf:adminMetadata": [{"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b1"}, {"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bop (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026879"}, "madsrdf:hasSource": [{"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b5"}, {"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b6"}, {"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b7"}, {"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b8"}], "madsrdf:hasVariant": [{"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b9"}, {"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b12"}, {"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncb4f63fa1a6b4ce69f598703bbfb5611b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ncb4f63fa1a6b4ce69f59