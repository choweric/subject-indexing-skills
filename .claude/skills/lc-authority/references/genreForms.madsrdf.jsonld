": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Paso doble [Pasodoble]. A fast duple-meter march-like music and its corresponding two-step couple dance.)"}, "madsrdf:citationSource": "Grove music online, viewed August 27, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b7b65640606422a9f37ea3d92ae5d92b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Harvard dictionary of music, 4th ed. (Paso dobles. One of the most characteristic national social dances of Spain, in moderately fast duple meter with a somewhat marchlike character)", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b7b65640606422a9f37ea3d92ae5d92b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1b7b65640606422a9f37ea3d92ae5d92b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pasodobles (Music)"}}, {"@id": "_:n1b7b65640606422a9f37ea3d92ae5d92b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pasodobles (Music)"}}], "@id": "/authorities/genreForms/gf2014026988"}
