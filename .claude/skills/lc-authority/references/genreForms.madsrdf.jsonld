ary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-02-21T10:29:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television quiz shows"}}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(quiz show: A television or radio program in which the contestants' knowledge is tested by questioning, with some contestants winning money or prizes)"}, "madsrdf:citationSource": "The American heritage dictionary of the English language, \u00a92016, via YourDictionary.com, Oct. 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 104 (Quiz and game shows; quizzes; quiz shows) p. 106 (television quizzes and game shows)"}, "madsrdf:citationSource": "Understanding television, 1990:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 75 (quiz and game shows; the quiz/game show) p. 78 (quiz/game shows on radio and television)"}, "madsrdf:citationSource": "Holmes, S. Entertaining television, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 54 (quiz game shows)"}, "madsrdf:citationSource": "Pierson, J. Digital broadcasting, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 287 (in chapter titled The game show: as a genre of American television, game and quiz shows have a long but checkered history; quiz shows) p. 289 (quiz programs) p. 292 (summer of 1955 was a watershed for television game shows: \"[dollar symbol]64,000 Question\" first aired; 1955-56 season it became highest rated game show of all time; other high-stakes quiz shows followed) pp. 296-298 (in current daytime network schedules, mornings are back to being dominated by quiz fare because development and per episode costs of game shows are low compared to soap operas; composition of audiences has changed over the years, forcing changes in quiz-oriented game shows)"}, "madsrdf:citationSource": "TV genres, 1985:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 82 (Quiz shows: use for programs on which a group of people (e.g., experts, stars, or members of the audience) compete in answering questions)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "quiz show (an entertainment program (as on radio or television) in which contestants answer questions; called also quiz program) game show (game show: a television program on which contestants compete for prizes in a game (such as a quiz))"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Oct. 18, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 178 (the game/quiz show; quiz shows; quiz/game shows) p. 190 (television quizzes)"}, "madsrdf:citationSource": "ITV cultures, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quiz shows (Television programs)"}}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quiz shows (Television programs)"}}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quiz television programs"}}, {"@id": "_:nc51b682b88864750bd78a6ed7f0b48bfb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quiz television programs"}}], "@id": "/authorities/genreForms/gf2011026677"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026678", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision remakes", "identifiers:lccn": "gf2011026678", "madsrdf:adminMetadata": [{"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b1"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television remakes"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026084"}], "madsrdf:hasSource": [{"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b5"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b6"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b7"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b8"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b9"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b10"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b11"}], "madsrdf:hasVariant": [{"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b12"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b15"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b18"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025034"}}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T09:59:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television remakes"}}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "All in the Family (All in the Family; American situation comedy; broadcast on the CBS television network from Jan. 12, 1971 to Apr. 8, 1979; based on the British television series Till Death Us Do Part) Till Death Us Do Part (Till Death Us Do Part; British sitcom that aired on BBC1 from 1965 to 1975; was re-made in many countries, from the United States, to Brazil, Germany, and Hong Kong, with the most notable remake being the long-running 1970's American series All in the Family)"}, "madsrdf:citationSource": "Wikipedia, Mar. 1, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Taves, B. The moving image genre-form guide, Mar. 6, 2009", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Every so often, some television network will dip into the archives and, rather than create a new series, try to win over an audience by re-making a show that was popular in another decade; a re-made television sitcom)"}, "madsrdf:citationSource": "Helmer, S. TV series unlikely to be remade, via WWW, Mar. 1, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: All in the family. First season, c2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(television remakes; television re-makes; re-made television sitcom; remade television programs; remade television series; TV remakes; TV re-makes)"}, "madsrdf:citationSource": "Google search, Mar. 1, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Reimagining\" is the buzz word; Battlestar Galactica, The Bionic Woman, and Doctor Who are just a few of the old sci-fi shows that have been reimagined with varying degrees of success; \"reimagined\" television shows.)"}, "madsrdf:citationSource": "TV remakes : a reminder of things past, 2009, via WWW, Mar. 1, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Remakes occur less often on television than in film, but have happened from time to time. Examples include Battlestar Galactica (1978, 2003), He-Man and the Masters of the Universe (1983, 2002), and Teenage Mutant Ninja Turtles (1987, 2003); one area where television remakes are particularly common is trans-Atlantic ports, where US shows are remade for the UK or more frequently, UK shows are remade for a US market; recently, the term reimagining has become popular to describe remakes that do not closely follow the original. Reimaginings often contain tongue in cheek references to the original with characters and concepts of the same name, but significantly changed; examples of remakes that are most associated with the reimagining term include Ronald D. Moore's Battlestar Galactica)"}, "madsrdf:citationSource": "Wikipedia, Mar. 1, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Remakes, Television"}}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Remakes, Television"}}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Remade television programs"}}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Remade television programs"}}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reimagined television programs"}}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reimagined television programs"}}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television reimaginings"}}, {"@id": "_:n5ab66d84d54940cf9ffdd20c29d65376b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television reimaginings"}}], "@id": "/authorities/genreForms/gf2011026678"}
