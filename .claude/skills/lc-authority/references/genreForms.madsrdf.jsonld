{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026072", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFrottole (Music)", "identifiers:lccn": "gf2020026072", "madsrdf:adminMetadata": [{"@id": "_:na158a018f3804cdd928ad799296033e6b1"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Frottole (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na158a018f3804cdd928ad799296033e6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026984"}, "madsrdf:hasSource": [{"@id": "_:na158a018f3804cdd928ad799296033e6b5"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b6"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b7"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b8"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b9"}], "madsrdf:hasVariant": {"@id": "_:na158a018f3804cdd928ad799296033e6b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na158a018f3804cdd928ad799296033e6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-05-14T09:20:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-10-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Frottole (Music)"}}, {"@id": "_:na158a018f3804cdd928ad799296033e6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "frottola (A form of Italian popular song common esp. in the 15th and 16th centuries; plural: frottole)"}, "madsrdf:citationSource": "OED online, April 6, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Frottola (Italian popular secular song of the late fifteenth and early sixteenth century; plural form used is frottole)"}, "madsrdf:citationSource": "Wikipedia, October 19, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page v (contents include many frottolas)"}, "madsrdf:citationSource": "Work cat: Pesente, M. Complete works, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Frottola; a form of secular song popular in Italy in the late 15th and early 16th centuries, the most important forerunner of the madrigal. Frottalas set verse, often lighthearted love poetry, in many different forms and rhyme schemes. Frottolas are generally strophic, repeating the same music for successive stanzas, and may include repeated lines of verse and their accompanying music within each strophe, often in the form of a refrain. Settings are for three or four voices, mainly syllabic and homophonic, with the melody in the top voice)"}, "madsrdf:citationSource": "Grove music online, October 19, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "frottola (a secular part-song of Italy of the 15th and 16th centuries that is largely homophonic and has the music repeated with each verse; plural: frottole)"}, "madsrdf:citationSource": "Merriam Webster online, April 6, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:na158a018f3804cdd928ad799296033e6b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na158a018f3804cdd928ad799296033e6b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Frottolas (Music)"}}, {"@id": "_:na158a018f3804cdd928ad799296033e6b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Frottolas (Music)"}}], "@id": "/authorities/genreForms/gf2020026072"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026073", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAmbrosian chants", "identifiers:lccn": "gf2020026073", "madsrdf:adminMetadata": [{"@id": "_:nc516c4546de0495a98fd39c524524be0b1"}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ambrosian chants"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc516c4546de0495a98fd39c524524be0b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026707"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasSource": [{"@id": "_:nc516c4546de0495a98fd39c524524be0b5"}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b6"}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b7"}], "madsrdf:hasVariant": [{"@id": "_:nc516c4546de0495a98fd39c524524be0b8"}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b11"}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b14"}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b17"}], "madsrdf:historyNote": "[Established November 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-11-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ambrosian chants"}}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ambrosian chant (Milanese chant); a chant repertory associated with Milan and one of only two musical repertories of the Latin Church to have been transmitted integrally in pitch-accurate notation. All the others were supplanted by \"Gregorian\" chant before being adequately recorded) Ordinary chants (although there is no Ambrosian Mass chant corresponding to the Roman Kyrie--Christe--Kyrie eleison, a triple Kyrie (ter kyrie) was chanted chorally at three points in the Mass: after the Gloria, after the reading of the Gospel and after the distribution of communion)"}, "madsrdf:citationSource": "Grove music online, viewed April 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(DLC)2020618840"}, "madsrdf:citationSource": "Work cat: Ambrosian chant, 1995", "madsrdf:citationStatus": "found"}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ambrosian chant: The Latin liturgical chant of Milan. Some Mass chants are textually and musically related to pieces in the Gregorian and Old Roman traditions, but there are also important differences)"}, "madsrdf:citationSource": "New Harvard dict. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc516c4546de0495a98fd39c524524be0b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plainchants (Ambrosian chants)"}}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plainchants (Ambrosian chants)"}}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc516c4546de0495a98fd39c524524be0b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Milanese chants"}}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Milanese chants"}}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc516c4546de0495a98fd39c524524be0b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chants (Ambrosian chants)"}}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chants (Ambrosian chants)"}}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc516c4546de0495a98fd39c524524be0b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plainsong (Ambrosian chants)"}}, {"@id": "_:nc516c4546de0495a98fd39c524524be0b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plainsong (Ambrosian chants)"}}], "@id": "/authorities/genreForms/gf2020026073"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026074", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStandards (Reference works)", "identifiers:lccn": "gf2020026074", "madsrdf:adminMetadata": [{"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b1"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Standards (Reference works)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026054"}, "madsrdf:hasSource": [{"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b5"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b6"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b7"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b8"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b9"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b10"}], "madsrdf:hasVariant": [{"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b11"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-02-12T12:52:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-11-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Standards (Reference works)"}}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "standard (A standard is a generally agreed-upon technology, method or format for a given application. Official standards, also known as de jure standards, are overseen by one of a number of governing bodies that exist to promote their development and confirm their status. The IETF (Internet Engineering Task Force), for example, is a standards organization that defines Internet operating protocols such as TCP/IP. Standards that are endorsed by the IETF and similar organizations are known as de jure standards. De facto standards,on the other hand, gain prominence because they are widely used. Examples of de facto standards include Microsoft's Windows operating system and the QWERTY keyboard layout.)"}, "madsrdf:citationSource": "TechTarget WhatIs WWW site, Jan. 12, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "specifications (The instructions sent by a publisher to a printer with the typescript of a work concerning its characteristics as a prospective publication, including its dimensions, paper stock, typeface, quantity of illustration, extent of front and back matter, etc., from which the printer creates a specimen page to indicate the proposed style of typesetting. Cost of production is determined by specs and size of edition. In computing, a formal description containing details of the components built into a hardware device or software system. In a more general sense, detailed instructions concerning work to be done, products or services to be supplied, etc., especially when a contract is to be signed. Abbreviated specs) standard (standard An acceptable level or criterion according to which something is compared, measured, or judged. Also refers to an amount, extent, quality, pattern, criterion, etc., fixed by usage or convention or established as the norm by prevailing authority, as in the standard size of a catalog card used by libraries prior to the development of machine-readable cataloging. A standard may also be a specification that identifies model methods, materials, or practices. A standard approved by a formal ANSI-accredited standards body, such as NISO, is a de jure standard. A de facto standard is one that becomes generally accepted without the formal endorsement of a standard-setting organization. A community standard is a de facto standard developed and used within a particular user group. See also standards) standards (Criteria established by professional associations, accrediting bodies, or agencies of government for measuring and evaluating library services, collections, and programs. ... Also refers to any code of rules or procedures established by national and international library organizations to govern bibliographic control, such as the MARC record format, CIP, and the ISBN/ISSN adopted by the publishing industry. ... In a more general sense, any criteria established by law, agreement, or custom, according to which values, quantities, procedures, performance, etc., are measured or evaluated, and to which manufacturers, practitioners, researchers, etc., seek to conform in order to ensure quality and/or uniformity of results)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS: Online dictionary for library and information science, via WWW, Nov. 19, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Government of Canada Standard) p. 1 (\"This specification applies to different types of wheat-flour bread rolls, including hamburger and hot-dog rolls. It is mainly intended to be used by food services in procurement of food) (OCoLC)1005657228"}, "madsrdf:citationSource": "Work cat.: Bread rolls, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(specification: 1.1 (usually specifications) A detailed description of the design and materials used to make something. 1.2 A standard of workmanship, materials, etc., required to be met in a piece of work)"}, "madsrdf:citationSource": "Lexico website, Nov. 19, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "specification (a detailed description of how something should be done, made, etc.) standard (an official rule, unit of measurement, or way of operating that is used in a particular area of manufacturing or services: a common/a global/an international standard; an accountancy/industry/legal standard; safety standards; a federal/government/national standard)"}, "madsrdf:citationSource": "Cambridge dictionary online, Nov. 19, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Specification (technical standard) (A specification often refers to a set of documented requirements to be satisfied by a material, design, product, or service. A specification is often a type of technical standard. There are different types of technical or engineering specifications (specs), and the term is used differently in different technical contexts. They often refer to particular documents, and/or particular information within them. The word specification is broadly defined as \"to state explicitly or in detail\" or \"to be specific\") Technical standard (A technical standard is an established norm or requirement for a repeatable technical task. It is usually a formal document that establishes uniform engineering or technical criteria, methods, processes, and practices. In contrast, a custom, convention, company product, corporate standard, and so forth that becomes generally accepted and dominant is often called a de facto standard)"}, "madsrdf:citationSource": "Wikipedia, Nov. 19, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Specifications (Standards)"}}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Specifications (Standards)"}}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Technical standards"}}, {"@id": "_:nc9558e9f00964772827c9a0f8bd273f5b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Technical standards"}}], "@id": "/authorities/genreForms/gf2020026074"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026002", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAfricanfuturist fiction", "identifiers:lccn": "gf2021026002", "madsrdf:adminMetadata": [{"@id": "_:n1c1c0b1929fa4475af4fb318da41638db1"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Africanfuturist fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1c1c0b1929fa4475af4fb318da41638db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n1c1c0b1929fa4475af4fb318da41638db5"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db6"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db7"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db8"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db9"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db10"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db11"}], "madsrdf:hasVariant": [{"@id": "_:n1c1c0b1929fa4475af4fb318da41638db12"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db15"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db18"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction rooted in African culture, history, and mythology that depicts technology as a resource for African empowerment. For science fiction that features Black characters and concerns, and depicts technology as a resource for Black empowerment, see [Afrofuturist fiction.]"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-04-15T12:18:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-01-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Africanfuturist fiction"}}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "chapter 12 abstract (\"This chapter discusses the existence of 'Africanfuturism' in modern African fiction, based on examples from specific novels and stories by African writers that are arguably examples of science fiction or fantasy, to argue that 'Africanfuturism' does exist and is identifiable in works of fiction by first-generation African fiction writers and the succeeding generations that follow their trail\")"}, "madsrdf:citationSource": "Routledge handbook of minority discourses in African literature, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "introd. (\"Here are 8 original visions of Africanfuturism: science fiction stories by both emerging and seasoned African writers staking a claim to Africa's place in the future. These are powerful visions focused on the African experience and hopes and fears, exploring African sciences, philosophies, adaptations to technology and visions of the future both centred on and spiralling out of Africa ... Stories that capture the essence of what we talk about when we talk about Africanfuturism\") (OCoLC)1228917577"}, "madsrdf:citationSource": "Work cat.: Africanfuturism : an anthology, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Afrofuturism and Africanfuturism: Speculative Fiction of Africa and the African Diaspora. This panel seeks to examine Afrofuturist and African Futurist literature to highlight voices of black empowerment and to privilege black narratives in speculative fiction, science fiction, and fantasy from Africa and the African Diaspora)"}, "madsrdf:citationSource": [{"@id": "https://networks.h-net.org/node/73374/announcements/6397004/afrofuturism-and-africanfuturism-speculative-fiction-africa-and"}, "Announcement of Northeast Modern Language Association Conference session to be held March 14, 2021, via H-Net: Humanities & Social Sciences online website, viewed Jan. 7, 2021"], "madsrdf:citationStatus": "found"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"While Africanfuturism can be seen by some as a subset of certain expanded definitions of Afrofuturism, it is largely its own term. Africanfuturist stories going as far back as the history of the genre can (and should) now be clearly seen and read through a lens that centres them and their viewpoints, encouraging readers around the work to actively engage with African traditions of thought, of science, of philosophy, of history, of dreams, of being.\")"}, "madsrdf:citationSource": "Talabi, W. Africanfuturism : an anchor point for science fiction that centers Africa, via Brittle paper website, posted Oct. 10, 2020, viewed Jan. 15, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 94 (\"African futurism relies on features and trends that are traceable to the evolution of African-based fantasy writing and SF that has at its foundation in myths, folk tales and various supernatural elements in a spatial world that offers readers insight into characters choices and struggles\")"}, "madsrdf:citationSource": "The Black speculative arts movement : Black futurity, art+design, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (article by Jane Bryce entitled: African futurism: speculative fictions and \"rewriting the great book\"; This paper examines a number of African-authored narratives (novels and film) in the light of recent thinking about futurism and the role of speculative fiction as a means of envisioning the future) p. 8 (African futuristic films may be few and far between, but even so, recurrent themes and motifs sketch the gestalt of an emerging genre) p. 16 (novels [that] are the latest manifestations in the longue dur\u00e9e of African futurism; the rewriting of the Other, in all its many guises, is central to speculative fiction as it is being written in Africa; Through speculative fiction, Waberi and other writers stake their claim to Africa's future, resignifying \"Africa\" as a sign of liberation from and transformation of known realities)"}, "madsrdf:citationSource": "Research in African literatures, spring 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Okorafor defines Africanfuturism as 'a subcategory of science fiction' that is 'similar to 'Afrofuturism' but more deeply 'rooted in African culture, history, mythology and point-of-view as it then branches into the Black diaspora, and it does not privilege or center the West'\")"}, "madsrdf:citationSource": [{"@id": "https://lareviewofbooks.org/article/afrofuturism-africanfuturism-and-the-language-of-black-speculative-literature/"}, "Afrofuturism, Africanfuturism, and the language of Black speculative literature, 2020, via Los Angeles review of books website, viewed Jan. 7, 2021"], "madsrdf:citationStatus": "found"}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c1c0b1929fa4475af4fb318da41638db13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "African futurist fiction"}}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "African futurist fiction"}}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c1c0b1929fa4475af4fb318da41638db16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "African futuristic fiction"}}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "African futuristic fiction"}}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c1c0b1929fa4475af4fb318da41638db19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Africanfuturism fiction"}}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Africanfuturism fiction"}}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c1c0b1929fa4475af4fb318da41638db22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "African futurism fiction"}}, {"@id": "_:n1c1c0b1929fa4475af4fb318da41638db22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "African futurism fiction"}}], "@id": "/authorities/genreForms/gf2021026002"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026003", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPsychological films", "identifiers:lccn": "gf2021026003", "madsrdf:adminMetadata": [{"@id": "_:n1aa5e5e2a7b64572bf06731da1cd4eb7b1"}, {"@id": "_:n1aa5e5e2a7b64572bf06731da1cd4eb7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Psychological films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1aa5e5e2a7b64572bf06731da1cd4eb7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026692"}, "madsrdf:hasSource": [{"@id": "_:n1aa5e5e2a7b64572bf06731da1cd4eb7b5"}, {"@id": "_:n1aa5e5e2a7b64572bf06731da1cd4eb7b6"}, {"@id": "_:n1aa5e5e2a7b64572bf06731da1cd4eb7b7"}, {"@id": "_:n1aa5e5e2a7b64572bf06731da1cd4eb7b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films in which the thoughts, feelings, and motivations of the characters are of equal or greater interest than the external action of the narrative."}, {"@id": "_:n1aa5e5e2a7b64572bf06731da1cd4eb7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-01-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n1aa5e5e2a7b64572bf06731da1cd4eb7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-04-15T12:18:55"}, "ri:recordContentSource": {"@id": "http://id