8f13e49b5c86e6b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1d90447aaef24235a58f13e49b5c86e6b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Noh music"}}, {"@id": "_:n1d90447aaef24235a58f13e49b5c86e6b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noh music"}}], "@id": "/authorities/genreForms/gf2014026965"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026966", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNo wave (Music)", "identifiers:lccn": "gf2014026966", "madsrdf:adminMetadata": [{"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b1"}, {"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "No wave (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026632"}, "madsrdf:hasSource": [{"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b5"}, {"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b6"}, {"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "No wave (Music)"}}, {"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 9 (multi-band album \"No New York\" became the face of No Wave on its release in 1978; Contortions, Teenage Jesus and the Jerks, Mars and DNA) p. 14 (DNA was last original band left in 1982 when they broke up) p. 200 (No Wave took immediate influences of punk and new wave and generated energy of negation; primitive rock 'n' roll)"}, "madsrdf:citationSource": "Work cat.: No Wave, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "No Wave : post-punk, underground, New York, 1976-1980, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e28b49f3024491dbd6c2b1f5cde8a29b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(No Wave was a short-lived but influential art music and art scene that thrived briefly in New York City during the late 1970s and early 1980s alongside the punk subculture; No Wave is not a clearly definable musical genre with consistent features. Various groups drew on such disparate styles as funk, jazz, blues, punk rock, avant garde, and experimental. There are, however, some elements common to most No Wave music, such as abrasive atonal sounds, repetitive driving rhythms, and a tendency to emphasize musical texture over melody. No wave lyrics often focused on nihilism and confrontation)"}, "madsrdf:citationSource": "Wikipedia, Apr. 24, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026966"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026967", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNoise music", "identifiers:lccn": "gf2014026967", "madsrdf:adminMetadata": [{"@id": "_:necc96dc379c749fe850a2050482e2d1bb1"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Noise music"}, "madsrdf:elementList": {"@list": [{"@id": "_:necc96dc379c749fe850a2050482e2d1bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026167"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026168"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026070"}], "madsrdf:hasSource": [{"@id": "_:necc96dc379c749fe850a2050482e2d1bb5"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb6"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb7"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb8"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb9"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb10"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb11"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:21:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noise music"}}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Avant-Garde > Sound Art > Noise (Sludgy, abrasive, and punishing, Noise is everything its name promises, expanding on the music's capacity for sonic assault while almost entirely rejecting the role of melody and songcraft. From the ear-splitting, teeth-rattling attack of Japan's Merzbow to the thick, grinding intensity of Amphetamine Reptile-label bands like Tar and Vertigo, it's dark, brutal music that pushes rock to its furthest extremes. By the end of the '90s, a resurgence in the use of sine waves -- originally explored by musique concr\u00e8te artists in the '50s -- became increasingly frequent among noise artists such as Otomo Yoshihide)"}, "madsrdf:citationSource": "AllMusic website, Dec. 9, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xii (Brief style descriptions. Noise: Sludgy, abrasive, and punishing. \"Noise\" is everything its name promises, expanding on the music's capacity for sonic assault while almost entirely rejecting the rold of melody and songcraft. From the ear-splitting, teeth-rattling attack of Japan's Merzbow to the thick, grinding intensity of Amphetamine Reptile-label bands like Tar and Vertigo, it's dark, brutal music that pushes rock to its furthest extremes. By the end of the '90s, a resurgence in the use of sine waves--originally explored by musique concr\u00e8te artists in the '50s--became increasingly frequent among \"noise\" artists such as Otomo Yoshihide) p. 325, under Merzbow (guitar, effects, producer/noise, dark ambient, experimental ... one of the world's most prolific practitioners of eardrum-assaulting Japanese noise)"}, "madsrdf:citationSource": "All music guide to electronica, c2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "profile (The performances of Incapacitants ... are so wide-open that they explode the usual image of noise music. Along with Hijo Kaidan, Merzbow, C.C.C.C., and Solmania, Incapacitants is one of the most well known of the noise bands which started out in the early '80s)"}, "madsrdf:citationSource": "Incapacitants WWW site, July 9, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Incapacitants (Musical group). Incapacitants present No progress [SR] 199- .", "madsrdf:citationStatus": "found"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Shuker, R. Key concepts in popular music, 1998;The electronica primer WWW site, July 17, 2001", "madsrdf:citationStatus": "notfound"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Incapacitants: Toshiji Mikawa: electronics, voice; Fumio Kosakai: electronics, voice; noise music; from the beginning, while the attempt to achieve pure noise has been the most important aspect of their sound, they have also been famous for their stage performances, which are so wild they may remind people of pro wrestling matches. This aggressive, energetic style and the beauty of their noise are unrivaled)"}, "madsrdf:citationSource": "Improvised music from Japan website, Dec. 9, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Experimental > Noise (Noise is an Experimental genre that strays away from conventional music structure, tonality, and composition and - as the name implies - consists predominantly of noise. Such music can be created or generated with virtually anything, including acoustic and traditional instruments, non-musical objects and machinery, extreme vocal techniques, and electronic equipment. Noise is often cacophonous, improvised in its composition, dissonant, loud, and abrasive. These noisy techniques are commonly created with feedback, distortion, manipulation, computer generation, etc. ... While avant-garde classical compositions and Electronic experiments of the early 1960s were steadily utilising noise more frequently, popular music was also starting to catch on to the style. In 1966, The Velvet Underground's John Cale recorded Loop, another track which honed in on audio feedback and Drone sounds. ... Since its inception, noise has evolved into and influenced a wide spectrum of genres and styles, across all levels of intensity. While some took it to their harsh extremities, such as the Harsh Noise Wall style of often-unchanging walls of static noise, other styles like Noise Rock and Noise Pop used noise in a more accessible way, retaining traditional rock song tropes.)"}, "madsrdf:citationSource": "rateyourmusic.com website, Dec. 9, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:necc96dc379c749fe850a2050482e2d1bb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Noise music is a type of music that employs noise as a musical resource. It is generally created with nontraditional musical instruments such as static, feedback, electronics, circuit bent instruments, or any other noise source. The genre explores cacophony, repetitive sounds, atonal randomness, indeterminacy and dissonance. The earliest noise music was created by futurist composer Luigi Russolo in the early 1910s. ... In the mid 1970s, free improvisational music was becoming more and more extreme, and groups like Dedalus created music bordering on noise. In the late 1970s, industrial musicians like Boyd Rice (A.K.A. NON), SPK, and Maurizio Bianchi experimented with noise. ... The modern harsh noise genre is largely a creation of Japanoise musicians such as Hanatarash and Hijokaidan in the mid-1980s. Other noise subgenres include harsh wall noise (based on unchanging \"walls\" of noise) and power electronics (based on modified electronics and screamed & shouted vocals)"}, "madsrdf:citationSource": "Noise music, via last.fm website, Dec. 9, 2019", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026967"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026968", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNonsense songs", "identifiers:lccn": "gf2014026968", "madsrdf:adminMetadata": [{"@id": "_:n2976246fefa04471b16d4b251da27d40b1"}, {"@id": "_:n2976246fefa04471b16d4b251da27d40b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nonsense songs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2976246fefa04471b16d4b251da27d40b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026870"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2976246fefa04471b16d4b251da27d40b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2976246fefa04471b16d4b251da27d40b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2976246fefa04471b16d4b251da27d40b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonsense songs"}}], "@id": "/authorities/genreForms/gf2014026968"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026969", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNorte\u00f1o (Music)", "identifiers:lccn": "gf2014026969", "madsrdf:adminMetadata": [{"@id": "_:n4e095f036a364b6184063922aa36e529b1"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Norte\u00f1o (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4e095f036a364b6184063922aa36e529b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n4e095f036a364b6184063922aa36e529b5"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b6"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b7"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b8"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b9"}], "madsrdf:hasVariant": [{"@id": "_:n4e095f036a364b6184063922aa36e529b10"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4e095f036a364b6184063922aa36e529b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-03-13T17:09:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Norte\u00f1o (Music)"}}, {"@id": "_:n4e095f036a364b6184063922aa36e529b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 152 (under conjunto: a band which plays \"norte\u00f1a\" music; \"conjunto\" has also been used as a synonym for \"norte\u00f1a\" music)"}, "madsrdf:citationSource": "White, D. Dict. of pop. music styles of the world:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(conjunto music; Texas chicano dance music) (DLC)92764112"}, "madsrdf:citationSource": "Work cat.: Rosa, T. As\u00ed si baila en Tejas [SR] p1991", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under USA, II, 3(ii), Traditional music, Hispanic American, Contemporary traditional music, (a) Mexican American and Southwest (Regional norte\u00f1o styles developed during the latter part of the 19th century in northern Mexico. Central to that music was the regional ensemble (conjunto) with the diatonic button accordion as the chief melodic instrument and the bajo sexto (12-string bass guitar) and the double bass as harmonic and rhythmic instruments. Out of this ensemble developed, from the mid-1930s, the Texan Mexican conjunto tradition that came to be known generically as musica norte\u00f1a by Mexican Americans.)"}, "madsrdf:citationSource": "New Grove dict. mus., 2nd ed. WWW site, Aug. 14, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under m\u00fasica norte\u00f1a (one of the most unusual styles of m\u00fasica tejana to begin its development at that time is m\u00fasica norte\u00f1a (music of the north), or \"conjunto music,\" as it is often called. (Conjunto literally means \"a musical group.\") M\u00fasica norte\u00f1a embodied traits of Tejano music but also arose with the appearance of a relatively new instrument that was rapidly becoming popular among Tejanos on the farms and ranchos of South Texas. As a result, in the 1900s m\u00fasica norte\u00f1a has become identified with the sound of the German diatonic button accordion.)"}, "madsrdf:citationSource": "Handbook of Texas Online WWW site, Aug. 17, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 396 (Conjunto music)"}, "madsrdf:citationSource": "AmeriGrove:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e095f036a364b6184063922aa36e529b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4e095f036a364b6184063922aa36e529b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "M\u00fasica norte\u00f1a"}}, {"@id": "_:n4e095f036a364b6184063922aa36e529b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "M\u00fasica norte\u00f1a"}}, {"@id": "_:n4e095f036a364b6184063922aa36e529b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4e095f036a364b6184063922aa36e529b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Conjunto music"}}, {"@id": "_:n4e095f036a364b6184063922aa36e529b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Conjunto music"}}], "@id": "/authorities/genreForms/gf2014026969"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026970", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNovelty songs", "identifiers:lccn": "gf2014026970", "madsrdf:adminMetadata": [{"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb1"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Novelty songs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026870"}, "madsrdf:hasSource": [{"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb5"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb6"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb7"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb8"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb9"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novelty songs"}}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novelty songs; written most often with a humorous gesture; so named because they tell a brief story, sometimes complete and sometimes episodic, with light, lilting, memorable melodies)"}, "madsrdf:citationSource": "All-music guide WWW site, October 1, 1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under United States (novelty song)"}, "madsrdf:citationSource": "White, D. Dict. pop. mus. styles of the world, c1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novelty records)"}, "madsrdf:citationSource": "Encyc. of rock, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(genre peaked in popularity on the charts ca. 1956-1969; line between novelty and mainstream pop remains hazy)"}, "madsrdf:citationSource": "Work cat.: 99050263: Otfinoski, S. The golden age of novelty songs, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novelty songs [book primarily devoted to U.S. artists and songs, but at least one British hit is cited])"}, "madsrdf:citationSource": "Collins, A. Disco duck and other adventures in novelty music, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nbda33eb47da34a61abae0f701cefb9bcb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novelty record [cites examples of U.S. and British artists and hits])"}, "madsrdf:citationSource": "Pickering, D. Cassell companion to 20th-century music, 1998", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026970"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026971", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNu jazz", "identifiers:lccn": "gf2014026971", "madsrdf:adminMetadata": [{"@id": "_:nd1cd79d866a545fdbb93e62411989432b1"}, {"@id": "_:nd1cd79d866a545fdbb93e62411989432b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nu jazz"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd1cd79d866a545fdbb93e62411989432b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026783"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026879"}], "madsrdf:hasSource": [{"@id": "_:nd1cd79d866a545fdbb93e62411989432b5"}, {"@id": "_:nd1cd79d866a545fdbb93e62411989432b6"}, {"@id": "_:nd1cd79d866a545fdbb93e62411989432b7"}, {"@id": "_:nd1cd79d866a545fdbb93e62411989432b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd1cd79d866a545fdbb93e62411989432b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd1cd79d866a545fdbb93e62411989432b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd1cd79d866a545fdbb93e62411989432b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nu jazz"}}, {"@id": "_:nd1cd79d866a545fdbb93e62411989432b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nu jazz is an umbrella term coined in the late 1990s to refer to music that blends jazz elements with other musical styles, such as funk, soul, electronic dance music, and free improvisation)"}, "madsrdf:citationSource": "Wikipedia, viewed Jan. 25, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1cd79d866a545fdbb93e62411989432b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 362 (Nu jazz refers to jazz-influenced music since the mid-nineties that makes use of hip-hop grooves, trance grooves, electronica and house music)"}, "madsrdf:citationSource": "Martin. Jazz: the first 100 years, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1cd79d866a545fdbb93e62411989432b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 12welve funktions of nu' jazz, 200-.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1cd79d866a545fdbb93e62411989432b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Oxford Music online, Dec. 13, 2012", "madsrdf:citationStatus": "notfound"}], "@id": "/authorities/genreForms/gf2014026971"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026972", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOi music", "identifiers:lccn": "gf2014026972", "madsrdf:adminMetadata": [{"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb1"}, {"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Oi music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027025"}, "madsrdf:hasSource": [{"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb5"}, {"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb6"}, {"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oi music"}}, {"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 (Oi arose out of punk)"}, "madsrdf:citationSource": "The story of Oi, a view from the dead-end of the street, 198-:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Britannica online, June 9, 1999;Random House", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nb47792a0d75342ccbf9b1b5e936c54edb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Oi! is a hard and violent off-shoot of hardcore punk.)"}, "madsrdf:citationSource": "All music guide, June 9, 1999", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026972"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026973", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOffertories (Music)", "identifiers:lccn": "gf2014026973", "madsrdf:adminMetadata": [{"@id": "_:nab04a9a744ad4702b13468d154c2622ab1"}, {"@id": "_:nab04a9a744ad4702b13468d154c2622ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Offertories (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nab04a9a744ad4702b13468d154c2622ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027020"}, "madsrdf:hasSource": {"@id": "_:nab04a9a744ad4702b13468d154c2622ab5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nab04a9a744ad4702b13468d154c2622ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nab04a9a744ad4702b13468d154c2622ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-05-06T09:00:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nab04a9a744ad4702b13468d154c2622ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Offertories (Music)"}}, {"@id": "_:nab04a9a744ad4702b13468d154c2622ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Offertory [offertorium, offerenda]; A chant of the Western Mass rites sung while bread and wine are prepared for eucharistic consecration. It is also the post-medieval name for the complex of priestly prayers and ritual actions (mixing of wine and water, incensation, washing of the hands) that took place during this part of the Mass. In its full medieval form the offertory chant consisted of a choral refrain in richly neumatic style with two or three neumatic--melismatic verses sung by a soloist. The latter part of the refrain (known as the repetendum) was repeated after each verse. Related to the offertory of the Roman Mass are the Ambrosian offerenda, the Mozarabic sacrificium and the Gallican sonus)"}, "madsrdf:citationSource": "Grove music online, viewed May 28, 2014 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026973"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026974", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOld-time music", "identifiers:lccn": "gf2014026974", "madsrdf:adminMetadata": [{"@id": "_:n0578e3d3c2d44999b13495f001b46336b1"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Old-time music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0578e3d3c2d44999b13495f001b46336b3"}]}, "madsrdf:exampleNote": "Note under [Country music]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n0578e3d3c2d44999b13495f001b46336b5"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b6"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b7"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b8"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b9"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b10"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b11"}], "madsrdf:hasVariant": [{"@id": "_:n0578e3d3c2d44999b13495f001b46336b12"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b15"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b18"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b21"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Country music of the 1930s and earlier periods played and sung in the old-time styles, as well as music of later periods played in those styles. For country music of the 1940s and later periods see [Country music.]"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-03T08:29:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Old-time music"}}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (golden age of old time music (the 1920s and 30s); music that preceded bluegrass and modern country music and from which those later forms evolved in the 40s and 50s) insert (old time music evolved into bluegrass and country music)"}, "madsrdf:citationSource": "Work cat.: Where'd you come from, where'd you go?, p1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(usage: old time music; old timey ...; old time country music)"}, "madsrdf:citationSource": "LC database, June 19, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(country music, variously known in the past as folk music, old-time music, hillbilly, C & W (country & western), etc.)"}, "madsrdf:citationSource": "Penguin encyc. of popular music, 1990", "madsrdf:citationStatus": "found"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(usage: old-time (old time) music (1600 hits); old-time country music (1600); old timey music (1100); old timey country music (33); old time mountain music (361); mountain music (24,100))"}, "madsrdf:citationSource": "Google WWW search engine, July 10, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Country music (discusses the style but does not name it)"}, "madsrdf:citationSource": "New Grove, 2nd ed.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(most old time musicians were white rural agrarian Southerners; singing was unschooled; musicianship expressed primarily through strings; song repertoire divided broadly between secular and sacred and further subdivided into categories of traditional, commercial, and original songs; developed in rural and isolated areas of the Southern Appalachian and other regions; two main strains of the music come from the banjo and the fiddle which were played separately and together, particularly for square dancing; songs and ballads, many imported from the British Isles and many written in American, are also an important part of old-time music)"}, "madsrdf:citationSource": "Old-time music WWW home page, May 14, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(old-time music is generally used to refer to the styles and repertoires that dominated commercial country music's first decade, roughly from 1924-1935. The term seemed to originate with the record companies and publishers of the time who did not have a clear idea of what to call the music during its early days. Styles include: string band music either in bands or fiddle-guitar duets; group harmony singing; a form of white blues and related yodeling; a solo singing tradition in which artists adapted traditional material to various instrumental accompaniment)"}, "madsrdf:citationSource": "Encyc. of country music, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0578e3d3c2d44999b13495f001b46336b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Old-time country music"}}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Old-time country music"}}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0578e3d3c2d44999b13495f001b46336b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mountain music"}}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mountain music"}}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0578e3d3c2d44999b13495f001b46336b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Old-time mountain music"}}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Old-time mountain music"}}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0578e3d3c2d44999b13495f001b46336b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Old timey music"}}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Old timey music"}}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0578e3d3c2d44999b13495f001b46336b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hillbilly music"}}, {"@id": "_:n0578e3d3c2d44999b13495f001b46336b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hillbilly music"}}], "@id": "/authorities/genreForms/gf2014026974"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026975", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOpen form music", "identifiers:lccn": "gf2014026975", "madsrdf:adminMetadata": [{"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b1"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Open form music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026624"}, "madsrdf:hasSource": [{"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b5"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b6"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b7"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b8"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b9"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b10"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b11"}], "madsrdf:hasVariant": {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions in which the sections are played in an order that is determined by the performers."}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:50:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Open form music"}}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Boulez, P. Sonatas, piano, no. 3.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Stockhausen, K. Stucke, piano, no. 11.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Open form)"}, "madsrdf:citationSource": "Vinton. Dict. of contemp. music", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 561 (open forms, see Aleatory music) under Aleatory music (a no. of segments which have to be \"assembled\" by the players ... terms open form and mobile form have since been applied to works of this type)"}, "madsrdf:citationSource": "New Harvard dict. of music, 1986:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Brown, E. Twenty-five pages.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Feldman, M. Intermission, no. 6.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n2f25dcbc997d478aa6b77152b178fc03b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2f2