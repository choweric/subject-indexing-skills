.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T15:07:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Swashbuckler films"}}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Zorro films"}}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zorro films"}}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Swashbuckling films; Sword-fight films: the main characteristic of the swashbuckler is its swordplay, performed by heroes and villians alike; includes pirate films)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Swashbucklers: def. 2: a novel, play or esp. movie dealing with the adventures of a swashbuckling hero, having a setting in a romantic past era or exotic locale)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Swashbucklers; use for fictional genre films in which the protagonist, in period costume, fights, usually with his sword, for a noble cause: UF: Swordplay films and programs)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Swashbuckling films"}}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Swashbuckling films"}}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Zorro films"}}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zorro films"}}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Swordplay films"}}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Swordplay films"}}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sword-fight films"}}, {"@id": "_:n63c48fff7e9d4602af071a1bc02ca003b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@