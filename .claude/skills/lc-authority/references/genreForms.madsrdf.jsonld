age": "en", "@value": "Jump the rope jingles"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b44", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b45"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Skipping rhymes (Jump rope rhymes)"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b45", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skipping rhymes (Jump rope rhymes)"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b47", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b48"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jingles, Jump rope"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b48", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jingles, Jump rope"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b50", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b51"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Songs, Skipping (Jump rope rhymes)"}}, {"@id": "_:n9fd8ab8ce49c436d861e32de92126bf6b51", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Songs, Skipping (Jump rope rhymes)"}}], "@id": "/authorities/genreForms/gf2016026092"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026094", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlexandrines", "identifiers:lccn": "gf2016026094", "madsrdf:adminMetadata": [{"@id": "_:n665d10d097ca4187866d31450c6eb63ab1"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Alexandrines"}, "madsrdf:elementList": {"@list": [{"@id": "_:n665d10d097ca4187866d31450c6eb63ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026383"}, "madsrdf:hasSource": [{"@id": "_:n665d10d097ca4187866d31450c6eb63ab5"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab6"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab7"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab8"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab9"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab10"}], "madsrdf:hasVariant": [{"@id": "_:n665d10d097ca4187866d31450c6eb63ab11"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab14"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alexandrines"}}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alexandrine verse)"}, "madsrdf:citationSource": "LCSH, Sept. 23, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alexandrine. In English, a 12-syllable iambic line adapted from French heroic verse. The last line of each stanza in Thomas Hardy's \"The Convergence of the Twain\" and Percy Bysshe Shelley's \"To a Skylark\" is an alexandrine)"}, "madsrdf:citationSource": "Glossary of poetic terms, via Poetry Foundation website, Sept. 23, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Regrets (originally in French Les Regrets) is a collection of poetry by the French Renaissance poet Joachim du Bellay, published in 1558. The 191 sonnets that make up this work are written using alexandrines)"}, "madsrdf:citationSource": "Wikipedia, Sept. 26, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alexandrine. The grand line of Fr. poetry since the 16th c., the alexandrine is made of 12 countable vowels (or 13 vowels in a feminine verse line) and divided in two hemistichs (6-6); du Bellay wrote the Regrets in alexandrines because his book was meant to express an intimate and informal type of inspiration. Considered to be less noble than the more common ten-syllable line, the alexandrine was associated primarily with popular poetry; between the 16th and 17th cs., the alexandrine became not only the most widely used verse line in Fr. poetry but the preferred form of elevated and even \"noble\" genres such as epic and tragedy. Thus, a name that referred to the med. heroic poem was elevated to the status of national symbol and eventually came to typify Fr. poetry overall)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012", "madsrdf:citationStatus": "found"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alexandrine. Alternative Title: iambic hexameter. Alexandrine, verse form that is the leading measure in French poetry. It consists of a line of 12 syllables with major stresses on the 6th syllable (which precedes the medial caesura [pause]) and on the last syllable, and one secondary accent in each half line. Because six syllables is a normal breath group and the secondary stresses can be on any other syllables in the line, the alexandrine is a flexible form, adaptable to a wide range of subjects. Its structural metrical principle is stress according to sense; the form thus lends itself to the expression of simple or complex emotions, narrative description, or grandiose patriotic sentiment (it is known as the heroic line in French poetry); In English versification, the alexandrine, also called iambic hexameter, contains six primary accents rather than the two major and two secondary accents of the French. Though it was introduced to England in the 16th century and was adapted to German and Dutch poetry in the 17th century, its success outside France has been limited)"}, "madsrdf:citationSource": "Britannica online, Sept. 23, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xiii (In the Antiquities, du Bellay alternates between sonnets in lines of ten syllables and sonnets in lines of the twelve-syllable alexandrine that he and Ronsard made the standard meter for French verse, and he arranges the poems so that a decasyllabic sonnet is in the top half of each pager and one in alexandrines is in the bottom half) pp. 14-15 (Still more innovative and no less artful is the metrical line du Bellay chose for this poem and all the others in the Regrets, the twelve-syllable alexandrine that in the mid-1550s he and Ronsard retrieved from long neglect and made into what would remain the dominant long line of French poetry for the next three and a half centuries; In the Regrets, du Bellay brilliantly exploits both ends of this stylistic spectrum, making the alexandrine the perfect vehicle for the alienated but familiar heroic \"rhyme in prose\" these poems aim at)"}, "madsrdf:citationSource": "Work cat.: Du Bellay, J. The regrets, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n665d10d097ca4187866d31450c6eb63ab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hexameter, Iambic"}}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hexameter, Iambic"}}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n665d10d097ca4187866d31450c6eb63ab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alexandrine verse"}}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alexandrine verse"}}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n665d10d097ca4187866d31450c6eb63ab18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Iambic hexameter"}}, {"@id": "_:n665d10d097ca4187866d31450c6eb63ab18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Iambic hexameter"}}], "@id": "/authorities/genreForms/gf2016026094"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026095", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aForensic crime dramas (Television programs)", "identifiers:lccn": "gf2016026095", "madsrdf:adminMetadata": [{"@id": "_:nc4e96afd31104042a7f6054d72d82d99b1"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Forensic crime dramas (Television programs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc4e96afd31104042a7f6054d72d82d99b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026658"}, "madsrdf:hasSource": [{"@id": "_:nc4e96afd31104042a7f6054d72d82d99b5"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b6"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b7"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b8"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b9"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b10"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b11"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b12"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b13"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b14"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b15"}], "madsrdf:hasVariant": [{"@id": "_:nc4e96afd31104042a7f6054d72d82d99b16"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b19"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b22"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional television programs that feature the use of forensic evidence in the solving of crimes."}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:12:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Forensic crime dramas (Television programs)"}}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 93 (Forensics in fictional television provides an ideal subject by which to explore science's role in modern storytelling. Forensic based television dramas have been a popular genre for over ten years with no sign that that their popularity is waning; forensic police procedurals have come to dominate the television landscape over the last ten years) p. 94 (forensic based crime dramas)"}, "madsrdf:citationSource": "Studies in history and philosophy of biological and biomedical sciences, Mar. 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "TV genres, 1985;L\u00f3pez, D. Films by genre, c1993.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Dexter Morgan is a Miami police forensics expert who moonlights as a serial killer of criminals who he believes have escaped justice)"}, "madsrdf:citationSource": "Work cat.: Dexter (Television program). Season 1. Dexter. The first season, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(series listed include: Forensic Files; Forensic Investigators; Unusual Suspects; Motives & Murders: Cracking the Case; F2: Forensic Factor; Extreme Forensics; Blood, Lies and Alibis; Body of Evidence; CIA: Crime Investigation Australia; Forensics: You Decide; LA Forensics; Amanda Burton's Killer Forensics; Forensic Firsts)"}, "madsrdf:citationSource": "TV forensic and investigation shows, via IMDb website, last updated 14 Aug 2014, viewed on Sept. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 299 (Since the airing of the final episode of CSI: Crime Scene Investigation in 2015, reports of the end of forensic television have been widely circulating; television crime drama) p. 300 (forensic drama series like CSI) p. 301 (forensic focused shows; five key narrative and aesthetic modes of crime television: realist, surveillance, forensic, Gothic and action) p. 302 (forensic dramas)"}, "madsrdf:citationSource": "New review of film and television studies, v. 14, no. 3 (2016):", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hit counts: Forensic television shows: 2,870; Forensic crime dramas: 4,900; Forensic crime shows: 11,100 (but many of the hits seem to be for nonfiction); Forensic crime television shows: 528; Forensic dramas AND Television: 2,810; Forensics television shows: 2,100)"}, "madsrdf:citationSource": "Google, Nov. 7, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Forensic psychologist Dr. Samantha \"Sam\" Waters has an uncanny ability to use clues left at crime scenes to \"see\" what happened. She is one of the FBI's most valuable assets. She retreats into a self-imposed exile after the murder of her husband. Coaxed back to the Bureau by her mentor, Sam picks up where she left off to help unravel high-profile cases that stymie other investigators)"}, "madsrdf:citationSource": "Profiler (Television program). Season 1. Profiler. Season 1, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Forensic Drama. Most commonly this genre follows forensic pathologists--they're the ones that cut up the corpses--but will also include shows or characters that specialise in general forensic science (lifting fingerprints and the like), forensic psychology, and forensic toxicology, among a dozen other specializations. Basically, if you can put \"forensic\" on the front of it, there's probably a pilot episode in existence somewhere. As dull as this may seem, viewers do actually turn on in droves to see the adventures of a bunch of people who mostly spend their time sitting in laboratories or offices rather than chasing armed criminals. Some series get around this by always having the investigator to get caught up in the murderer's private life, or by bending the rules a bit to allow him or her to interview and arrest suspects. In real life, though, they're mostly just The Lab Rat. See also The Profiler)"}, "madsrdf:citationSource": "TV tropes website, Sept. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Dexter (TV series) (Dexter is an American television crime drama mystery series; centers on Dexter Morgan, a forensic technician specializing in blood spatter pattern analysis for the fictional Miami Metro Police Department) Profiler (TV series) (Profiler is an American crime drama ... Dr. Samantha \"Sam\" Waters (Ally Walker) is a forensic psychologist working for the FBI's Violent Crimes Task Force) CSI: Crime Scene Investigation (CSI: Crime Scene Investigation is an American police procedural drama television series ... follows a team of Crime Scene Investigators, employed by the Las Vegas Police Department, as they use physical evidence to solve murders. The team is originally led by Gil Grissom, a socially-awkward forensic entomologist and career criminalist ... Grissom's second-in-command, Catherine Willows ... was a stripper before being recruited into law enforcement and training as a blood spatter specialist) Most Evil (Most Evil is an American forensics television program on Investigation Discovery presented by forensic psychiatrist Michael Stone of Columbia University during seasons 1 and 2 and by forensic psychologist Dr. Kris Mohandie during Season 3) Battlefield Detectives (Battlefield Detectives is a forensic documentary television series that aired on the History Channel from 2003 to 2006)"}, "madsrdf:citationSource": "Wikipedia, Sept. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (forensic television shows; forensic crime dramas seen on television; forensic science television) p. 6 (forensic crime television shows) p. 7 (forensic crime shows) p. 9 (Forensic crime television: Television shows that contain elements of both criminal investigations and forensic evidence. Examples of these shows include: CSI, Law and Order: SVU, Forensic Files, NCIS, etc.)"}, "madsrdf:citationSource": "Kopacki, C.G. Examining the CSI effect and the influence of forensic crime television on future jurors, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Follows the investigations of the forensics team of the Las Vegas Police Department)"}, "madsrdf:citationSource": "CSI, crime scene investigation (Television program). Season 2. CSI, crime scene investigation. The complete second season, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc4e96afd31104042a7f6054d72d82d99b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Forensic crime shows"}}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Forensic crime shows"}}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc4e96afd31104042a7f6054d72d82d99b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Forensic dramas (Television programs)"}}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Forensic dramas (Television programs)"}}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc4e96afd31104042a7f6054d72d82d99b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Forensics television shows"}}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Forensics television shows"}}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc4e96afd31104042a7f6054d72d82d99b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Forensic television shows"}}, {"@id": "_:nc4e96afd31104042a7f6054d72d82d99b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Forensic television shows"}}], "@id": "/authorities/genreForms/gf2016026095"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026096", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPicture books", "identifiers:lccn": "gf2016026096", "madsrdf:adminMetadata": [{"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb1"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Picture books"}, "madsrdf:elementList": {"@list": [{"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026142"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026144"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026003"}], "madsrdf:hasSource": [{"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb5"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb6"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb7"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb8"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb9"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb10"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb11"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb12"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb13"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb14"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb15"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb16"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb17"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb18"}], "madsrdf:hasVariant": {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb19"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-18T14:24:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-10-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picture books"}}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Picture books, BT Books, BT Graphic arts; Picture books for children, UF Children's picture books, BT Illustrated children's books)"}, "madsrdf:citationSource": "LCSH, Oct. 4, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a picture book for children)"}, "madsrdf:citationSource": "Work cat.: Alexie, Sherman. Thunder Boy Jr., 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A \"picture book for children\" as distinguished from other books with illustrations, is one that essentially provides the child with a visual experience. A picture book has a collective unity of story-line, theme, or concept, developed through the series of pictures of which the book is comprised. A \"picture book for children\" is one for which children are an intended potential audience. The book displays respect for children's understandings, abilities, and appreciations. Children are defined as persons of ages up to and including fourteen and picture books for this entire age range are to be considered.\")"}, "madsrdf:citationSource": "Caldecott Medal - terms and criteria, via Association for Library Service to Children website, Oct. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picture book: a book for children that consists mainly of pictures with little or no writing)"}, "madsrdf:citationSource": "Macmillan dictionary website, Oct. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picture book: A children's book, consisting of illustrations and little or no text, such as an alphabet or counting book, generally intended for preschool children; picture storybook: A children's book consisting of a narrative and illustrations that are synchronized with the text, generally requiring a reading ability level of at least third grade and intended to be read by children)"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "bio (Sherman Alexie is a poet, short story writer, novelist, and performer. He has published 25 books including his first picture book, Thunder Boy Jr, and young adult novel, The Absolutely True Diary of a Part-Time Indian, both from Little, Brown Books for Young Readers)"}, "madsrdf:citationSource": "Sherman Alexie website, Oct. 4, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picture book: A book consisting mainly of visual content, with little or no text, intended mainly for children of preschool age but sometimes of interest to adults because of the artistic quality of the illustrations and/or originality of the text, often used by children's librarians in storytelling. Compare with picture storybook; picture storybook: A short book containing one or more simple narratives accompanied by illustrations coordinated with the text, intended for children of at least third-grade reading level. Compare with picture book and storybook; storybook: A book of stories for children, often an illustrated collection of well-known fables, fairy tales, nursery rhymes, and poems, sometimes devoted to a specific topic or theme (example: The Japanese Children's Storybook on the Bombing of Hiroshima by Toshi and Iri Maruki). The term is also seen in the titles of collections of Bible stories written for children. Compare with picture storybook)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS: online dictionary for library and information science, Oct. 4, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picture dictionary: a book, especially for young children, that has a lot of pictures and not many words)"}, "madsrdf:citationSource": "Cambridge dictionary website, Oct. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picture book: simple definition: a book that has many pictures and is usually for children; full definition: a book that consists wholly or chiefly of pictures)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Oct. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (wordless picturebooks)"}, "madsrdf:citationSource": "Children and libraries, summer 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 58 (review of Thunder Boy Jr.: \"An enchanting and humorous picture book about a little boy frustrated with his name. ... Highly recommended for all picture book collections.\")"}, "madsrdf:citationSource": "School library journal, Feb. 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picture book: a book consisting mainly or entirely of pictures, especially one for children who have not yet learned to read)"}, "madsrdf:citationSource": "Dictionary.com unabridged, Oct. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picture book: A book containing many illustrations, especially one for children)"}, "madsrdf:citationSource": "Oxford dictionaries website, Oct. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A picture book is a book, usually a children's book, in which the illustrations are as important as (or even more important than) the words in telling the story. Picture books have traditionally been 32 pages long, although Little Golden Books are 24 pages. In picture books, there are illustrations on every page or on one of every pair of facing pages. While most picture books are written for younger children, in recent years, a number of excellent picture books for upper elementary and middle school readers have been published. The definition of \"children's picture book\" and the categories of children's picture books have also expanded in recent years. The definition of children's picture book was greatly expanded when Brian Selznick won the 2008 Caldecott Medal for picture book illustration for his book The Invention of Hugo Cabret, a 525-page middle grade novel that told the story not only in words but in a series of sequential illustrations (more than 280 pages interspersed throughout the book in sequences of multiple pages). Common categories of children's picture books: picture book biographies; wordless picture books; classic picture books)"}, "madsrdf:citationSource": "Kennedy, E. What is a picture book? - the definition, via About.com website, Oct. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Picturebooks"}}, {"@id": "_:nac951565ea7b4db8a212ad08d5b2313fb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picturebooks"}}], "@id": "/authorities/genreForms/gf2016026096"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026097", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSports plays", "identifiers:lccn": "gf2016026097", "madsrdf:adminMetadata": [{"@id": "_:n5cecb3732b3249768873685d420a84ebb1"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sports plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5cecb3732b3249768873685d420a84ebb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n5cecb3732b3249768873685d420a84ebb5"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb6"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb7"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb8"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb9"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb10"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb11"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb12"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb13"}], "madsrdf:hasVariant": [{"@id": "_:n5cecb3732b3249768873685d420a84ebb14"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb17"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-10-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sports plays"}}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(one of the things [Eric] Simonson admits has allowed his sports plays to work is \"everyone knows what has happened already\"; The New Yorker recently published an article asking Why Can't Broadway Make A Good Sports Play?, in which Reeves Wiedeman pointed out that one of the problems is staging the sports themselves)"}, "madsrdf:citationSource": "Smart, L. When sports and theatre mix, via TCG Circle website, viewed Oct. 7, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Pettitt, H. An up-to-date sporting drama entitled The prodigal daughter, 1892.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bathurst, L.J. Alcestis up, or, Run amuck : a sporting drama in three acts, 1887.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 143 (Richard Fotheringham's Sport in Australian Drama, in which the author discusses the role that sport has played on the Australian stage from 1788 to 1990; the golden age of sports drama (1880-1910); the sporting play)"}, "madsrdf:citationSource": "Deardorff, D.L. Sports : a reference guide and critical commentary, 1980-1999, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. opp. p. 1 (The play is set in the changing room (locker room) of a Rugby League team in the North of England) bk. jkt. (This brilliant documentary drama from the world of sports is set in a locker room, before, during and after a Rugby League match in the North of England. Storey simply allows us to listen in on the earthy conversation of the working-class athletes who play the game on weekends to eke out their low wages)"}, "madsrdf:citationSource": "Storey, D. The changing room, \u00a91972:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 57 ([Andr\u00e9] Obey's sports drama)"}, "madsrdf:citationSource": "Krauss, K. The drama of fallen France, \u00a92004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 95 (Roy Williams' sports plays; several of Williams' plays use sporting contexts to examine societal relationships; his sports plays examine how racially coded expectations surround black men's ability as players of sports and illustrate how understanding sporting support as an index of national identity and belonging is made more complex by the presence of black players and fans)"}, "madsrdf:citationSource": "Goddard, L. Contemporary Black British playwrights, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (\"This dissertation examines a cross section of twentieth-century sports plays from the perspective that playwrights use sports on stage as a metaphor to illuminate various aspects of the human condition. Sports plays are loosely defined as plays that have either athletes or coaches as their central characters, or plays that have a sports event as the central circumstance of the conflict.\")"}, "madsrdf:citationSource": "Cutler, K.C. Sports on stage, 1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (by Mark Harris ; adapted for the stage by Eric Simonson) p. 7 (Characters: Henry \"Author Wiggen, left-handed pitcher for the New York Mammoths; Bruce Pearson, third-string catcher for the Mammoths; Jonah Brooks, a black catcher for the Mammoths; George Gonzalez, Cuban ballplayer for the Mammoths; Sid Goldman, Mammoth slugger and home run king; Robert \"Ugly\" Jones, infielder and captain for the Mammoths) p. 9 (The setting is a ball park locker room built in the 1890s, currently used by a major league baseball team)"}, "madsrdf:citationSource": "Work cat.: Simonson, E. Bang the drum slowly, \u00a91995:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5cecb3732b3249768873685d420a84ebb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sporting drama"}}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sporting drama"}}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5cecb3732b3249768873685d420a84ebb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sports drama"}}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sports drama"}}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5cecb3732b3249768873685d420a84ebb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sporting plays"}}, {"@id": "_:n5cecb3732b3249768873685d420a84ebb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sporting plays"}}], "@id": "/authorities/genreForms/gf2016026097"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026098", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMythological fiction", "identifiers:lccn": "gf2016026098", "madsrdf:adminMetadata": [{"@id": "_:ne6ff5d576da74e66a6187922861887acb1"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mythological fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne6ff5d576da74e66a6187922861887acb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:ne6ff5d576da74e66a6187922861887acb5"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb6"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb7"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb8"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb9"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb10"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-10-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mythological fiction"}}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xii (mythological fiction) p. xiii (the narrative using myth)"}, "madsrdf:citationSource": "Moddelmog, D. Readers and mythic signs : the Oedipus myth in twentieth-century fiction, \u00a91993, via Google books:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: When the goddess Artemis goes missing, she is believed to have been kidnapped. And now it's up to Percy and his friends to find out what happened. Who is powerful enough to kidnap a goddess? They must find Artemis before the winter solstice, when her influence on the Olympian Council could swing an important vote on the war with the titans. Not only that, but first Percy will have to solve the mystery of a rare monster that Artemis was hunting when she disappeared -- a monster rumored to be so powerful it could destroy Olympus forever; subj. hdgs. include: Artemis (Greek deity)--Juvenile fiction; Titans (Mythology)--Juvenile fiction; Animals, Mythical--Juvenile fiction)"}, "madsrdf:citationSource": "Work cat.: Riordan, R. The Titan's curse, \u00a92007", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 23 (mythological fiction) p. 30 (Thomas Mann's mythological fiction) pp. 51-54 (it may help to sub-divide such novels into four categories: 1. The complete renarration of a classical myth. 2. A juxtaposition of sections narrating a myth and others concerned with the contemporary world. 3. A novel, set in the modern world, which contains a pattern of references to mythology running through the work. 4. A novel in which a mythological motif prefigures a part of the narrative (a single event, a character or a limited group of people), but without running consistently through the whole narrative, as in Type 3)"}, "madsrdf:citationSource": "White, J.J. Mythology in the modern novel, 1971, via Google books:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 17 (mythological fiction was immensely popular among common readers and professional storytellers who spun tales to the illiterate populace; in 1953, the Chinese Communist government issued a directive against the reading of mythological fiction)"}, "madsrdf:citationSource": "Yang, C.K. Religion in Chinese society, \u00a91961, via Google books:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 62-63 (Homer is the name that governs literature as a whole in the Confessions. He is the synecdoche for all mythological fiction.)"}, "madsrdf:citationSource": "Leupin, A. Fiction and incarnation : rhetoric, theology, and literature in the Middle Ages, \u00a92003, via Google books:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 29 (Some myths survive in theatrical or literary formats as plays or novels. Books in the shenmo genre of vernacular fiction revolve around gods and monsters; mythological fiction)"}, "madsrdf:citationSource": "Bhagavatananda, Guru. A brief history of the immortals of non-Hindu civilizations, 2015, via Google books:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6ff5d576da74e66a6187922861887acb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Hermes, the messenger of Zeus, likes to return to Earth now and again. He chooses to do so in Paris at the time of Napoleon III, a time of great frivolity and instability. Here he decides to play the most explosive practical joke in the world's history; 1st subj. hdg.: Hermes (Greek deity)--Fiction)"}, "madsrdf:citationSource": "Vansittart, P. Hermes in Paris, 2000", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026098"}
