ecordStatus": "new"}, {"@id": "_:n44a85ab4807f4cedb60ccaede95d3ca7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Angel films"}}, {"@id": "_:n44a85ab4807f4cedb60ccaede95d3ca7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary note: Heavenly angels join the Pittsburgh Pirates on the field for a wild race to the World Series)"}, "madsrdf:citationSource": "Work cat.: Angels in the outfield [VR] 1994", "madsrdf:citationStatus": "found"}, {"@id": "_:n44a85ab4807f4cedb60ccaede95d3ca7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "genres/Fantasy films (Fantasy Films with Angels: Angels, not surprisingly, have been featured in many fantasy or supernatural films over the years. Hollywood has responded to the interest in the existence of heavenly beings with a long list of \"angel\" films)"}, "madsrdf:citationSource": "The greatest films Web site, Aug. 29, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n44a85ab4807f4cedb60ccaede95d3ca7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary note: A romantic fantasy about an angel who wishes he were mortal and is willing to fall from the sky if it means a chance to fall in love)"}, "madsrdf:citationSource": "Himmel \u00fcber Berlin (Motion picture). Wings of desire [VR] 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n44a85ab4807f4cedb60ccaede95d3ca7b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Taves, B. The moving image genre-form guide, via WWW, viewed Aug. 29, 2008;Konigsberg, I. The complete film dictionary, 1997", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n44a85ab4807f4cedb60ccaede95d3ca7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(angel movies: It's a Wonderful Life; Michael; Angel-A; Date With an Angel; Heaven Only Knows; A Guy Named Joe; Almost an Angel; City of Angels; I Married an Angel; Forever Darling; Wings of Desire; The Bishop's Wife)"}, "madsrdf:citationSource": "How to find angel movies, via eHow Web site, Aug. 29, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n44a85ab4807f4cedb60ccaede95d3ca7b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Fantasy film: \"Films dealing with the wonders of magic and magicians, with the doings of gods, demigods, angels, elves, sprites, fairies, gnomes, and similar creatures are better and properly classified as fantasy films.\")"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n44a85ab4807f4cedb60ccaede95d3ca7b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Fowkes, K.A. Giving up the ghost : spirits, ghosts, and angels in mainstream comedy films, c1998.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026045"}
