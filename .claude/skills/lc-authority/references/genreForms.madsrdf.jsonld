{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026017", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMicropoetry", "identifiers:lccn": "gf2022026017", "madsrdf:adminMetadata": [{"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db1"}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Micropoetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026346"}, "madsrdf:hasSource": [{"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db5"}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db6"}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db7"}], "madsrdf:hasVariant": [{"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db8"}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db11"}], "madsrdf:historyNote": "[Established July 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-03-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-07-08T14:37:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Micropoetry"}}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (micropoemas [= micropoems]) (DLC)2021357599"}, "madsrdf:citationSource": "Work cat: Cerrutti Carol, Nahuel, 1948- Cuarenta y nueve micropoemas, [2017]:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Micropoetry is very short poetic verse. The only rules are those consistent with the form of short poetry chosen (for example haiku, tanka, senryu and gogyohka) and the character length limitations set by the publication medium)"}, "madsrdf:citationSource": "Morehead Writing Project website, viewed March 14, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Micropoetry is a genre of poetic verse including tweetku (also known as twihaiku, twaiku, or twitter poetry) and captcha poetry; The novelist W. G. Sebald may have been the first to use the term \"micropoem\", in reference to the poems of about 20 words in length that made up his 2004 work, Unrecounted; The more recent popularity of \"micropoetry\" to describe poems of 140 characters in length or shorter appears to stem from a separate coinage, as a portmanteau of \"microblogging\" and \"poetry\"; Micropoetry often shares the quality of found poetry, where poetic style is discovered in text not intended to be poetic)"}, "madsrdf:citationSource": "Wikipedia, viewed March 14, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Flash poetry"}}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flash poetry"}}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Micro poetry"}}, {"@id": "_:nfeb3d4de0f7e4d00887c34e4beace37db12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Micro poetry"}}], "@id": "/authorities/genreForms/gf2022026017"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026019", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpace rock (Music)", "identifiers:lccn": "gf2022026019", "madsrdf:adminMetadata": [{"@id": "_:n468e4beab9f741749b39a8df5e6364f5b1"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Space rock (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n468e4beab9f741749b39a8df5e6364f5b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027018"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027024"}], "madsrdf:hasSource": [{"@id": "_:n468e4beab9f741749b39a8df5e6364f5b5"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b6"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b7"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b8"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b9"}], "madsrdf:hasVariant": [{"@id": "_:n468e4beab9f741749b39a8df5e6364f5b10"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b13"}], "madsrdf:historyNote": "[Established November 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-03-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Space rock (Music)"}}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Space rock (\"Space rock is a music genre characterized by loose and lengthy song structures centered on instrumental textures that typically produce a hypnotic, otherworldly sound. It may feature distorted and reverberation-laden guitars, minimal drumming, languid vocals, synthesizers and lyrical themes of outer space and science fiction. The genre emerged in late 1960s psychedelia and progressive rock bands such as Pink Floyd, Hawkwind and Gong who explored a \"cosmic\" sound. Later, the style was taken up in the mid-1980s by Spacemen 3, whose \"drone-heavy\" sound was avowedly inspired by and intended to accommodate drug use. By the 1990s, space rock developed into shoegazing and post-rock with bands such as Failure, Hum, Flying Saucer Attack, and Orange Goblin\")"}, "madsrdf:citationSource": "Wikipedia, searched March 21, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Space rock (\"The term space rock was originally coined back in the '70s to describe the cosmic flights of bands like Pink Floyd and Hawkwind. Today, however, space rock refers to a new generation of alternative/indie bands that draw from psychedelic rock, ambient music, and -- more often than not -- experimental and avant-garde influences. Space rock is nearly always slow, hypnotic, and otherworldly; it typically favors lengthy, mind-bending sonic explorations over conventional song structures, and vocals sometimes play second fiddle to the shimmering instrumental textures.\")"}, "madsrdf:citationSource": "All Music, searched March 21, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Psychedelic/Space rock (\"The late 1960's psychedelic rock scene also spawned the birth of the space rock genre. The pioneering acts of this genre assimilated krautrock elements like repetitive hypnotic beats and electronic/ambient soundscapes as they moved away from the common musical and compositional approach. The synthesizer with its bubbling tones and spacey patterns, provoking a gliding flow, is a typical instrument of this genre. Guitars are by preference played with glissando technique and delay/echo effects are heavily used, and elements originating from reggae/dub are fairly common. Several bands combine their live performances with trippy lightshows using random fractals. Albums in this genre will often include at least one long meandering jam based on a main theme, where loops and wavelike fluctuations provides slight variations to this structural foundation. Stories, images, song titles and album names referring to cosmic themes are fairly common features of the genre. HAWKWIND's live album 'Space Ritual' is said to be the ultimate space rock album due to the collaboration with sci-fi author Michael Moorcock. His lyrics are performed by a narrator and underlaid with synth elements. PINK FLOYD can be regarded as pioneers of spacey music during the band's early phase, as exemplified by certain tracks from 'The Piper At The Gates Of Dawn' or the stirring live performance of 'Careful With That Axe Eugene' from 'Ummagumma'. GROBSCHNITT provides another fine example of classic space rock with their epic effort 'Solar Music'. Other bands explored the space rock sound for a limited time period only. GONG released groundbreaking albums in the genre at the start of their career, while British hard rock band UFO released the extraordinary album 'Flying - One Hour Space Rock' as their sole contribution to the genre in 1971.\")"}, "madsrdf:citationSource": [{"@id": "http://www.progarchives.com/subgenre.asp?style=15"}, "Prog archives, searched March 21, 2022"], "madsrdf:citationStatus": "found"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Compilation of psychedelic and space rock tracks by the space rock band Hawkwind)"}, "madsrdf:citationSource": "Work cat: Hawkwind (Musical group). Acid daze. Volume 2, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n468e4beab9f741749b39a8df5e6364f5b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Progressive space rock (Music)"}}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Progressive space rock (Music)"}}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n468e4beab9f741749b39a8df5e6364f5b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psychedelic space rock (Music)"}}, {"@id": "_:n468e4beab9f741749b39a8df5e6364f5b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psychedelic space rock (Music)"}}], "@id": "/authorities/genreForms/gf2022026019"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026020", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDark ambient (Music)", "identifiers:lccn": "gf2022026020", "madsrdf:adminMetadata": [{"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b1"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dark ambient (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026874"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027185"}], "madsrdf:hasSource": [{"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b5"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b6"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b7"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b8"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b9"}], "madsrdf:hasVariant": {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b10"}, "madsrdf:historyNote": "[Established August 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-05T09:03:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-04-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dark ambient (Music)"}}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Dark ambient (\"Dark ambient (referred to as ambient industrial especially in the 1980s) is a genre of post-industrial music that features an ominous, dark droning and often gloomy, monumental or catacombal atmosphere, partially with discordant overtones. It shows similarities with ambient music, a genre that has been cited as a main influence by many dark ambient artists, both conceptually and compositionally... Projects like Lustmord, Nocturnal Emissions, and Zoviet France evolved out of industrial music during the 1980s, and were some of the earliest artists to create consistently dark ambient music. These artists make use of industrial principles such as noise and shock tactics, but wield these elements with more subtlety. Additionally, ambient industrial often has strong occultist tendencies with a particular leaning toward magick as expounded by Aleister Crowley, and chaos magic, often giving the music a ritualistic flavor\") Lustmord (Brian Williams, musician credited with creating the dark ambient genre as Lustmord)"}, "madsrdf:citationSource": "Wikipedia, searched April 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dark ambient album with contributions from major dark ambient artist Lustmord)"}, "madsrdf:citationSource": "Work cat: Lustmord vs. Metal Beast, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lustmord on field recordings, sound design and more : the dark ambient artist discusses his approach to sound)"}, "madsrdf:citationSource": [{"@id": "https://daily.redbullmusicacademy.com/2015/10/lustmord-feature"}, "Red Bull Music Academy WWW site, June 27, 2022"], "madsrdf:citationStatus": "found"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (a critical history of industrial music) page 23 (Brian Williams, the man behind ambient industrial act Lustmord)"}, "madsrdf:citationSource": "Assimilate, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ambient industrial music"}}, {"@id": "_:n38cc9682756c4bd2bc8a039f71f1aba0b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ambient industrial music"}}], "@id": "/authorities/genreForms/gf2022026020"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026021", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGatefold books", "identifiers:lccn": "gf2022026021", "madsrdf:adminMetadata": [{"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b1"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gatefold books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026197"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027220"}], "madsrdf:hasSource": [{"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b5"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b6"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b7"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b8"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b9"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b10"}], "madsrdf:hasVariant": [{"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b11"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b14"}], "madsrdf:historyNote": "[Established August 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Books with a spine on each side and an opening in the middle."}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-05T09:03:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-04-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gatefold books"}}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(gatefold book; summary: \"Gatefold pages and 35 lift-the-flaps to help with hands-on childhood developmental skills\")"}, "madsrdf:citationSource": "Work cat: Stark, K. Friends at the firehouse, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 109 (\"books with multiple-fold pages\" include \"gate-fold books\")"}, "madsrdf:citationSource": "Salamony, S. 1000 artists' books, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Gatefold books: books comprised of a foldout sheet or sheets that open to at least double the page size\")"}, "madsrdf:citationSource": "Artist' books at Massart, viewed Apr. 18, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(gatefold book; summary: \"Opening the book reveals two books inside: one that follows Belle in the city, and another that shows us Grandpa Jack in the snowy mountains. The beautifully illustrated stories can be read on their own as well as side-by-side.\")"}, "madsrdf:citationSource": "Menzies, L. We'll be together again, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 34 (\"Gatefold (also called French doors): Gatefold books have a spine on each side and an opening in the middle. Since this format shows two pages at once, it's excellent for compare-and-contrast books. It's also good for two intermeshing stories, or in a situation where two illustrations need to be shown at once\")"}, "madsrdf:citationSource": "LaPlantz, S. The art and craft of handmade books, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(gatefold: method of folding a sheet of paper into three sections in which the two ends are folded toward each other over the center, like a triptych)"}, "madsrdf:citationSource": "Reitz, J.M. Online dictionary for library and information science, viewed Apr. 18, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "French door books"}}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "French door books"}}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gate-fold books"}}, {"@id": "_:n901844601d6c4f0ca2d2d66363f432b3b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gate-fold books"}}], "@id": "/authorities/genreForms/gf2022026021"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026022", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChoose-your-own-story comics", "identifiers:lccn": "gf2022026022", "madsrdf:adminMetadata": [{"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b1"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Choose-your-own-story comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b5"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b6"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b7"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b8"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b9"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b10"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b11"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b12"}], "madsrdf:hasVariant": [{"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b13"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b16"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b19"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b22"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b25"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b28"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b31"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b34"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b37"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b40"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b43"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b46"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b49"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b52"}], "madsrdf:historyNote": "[Established August 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics in which the reader chooses from a number of possible options for developing the story."}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-04-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-08-05T09:03:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Choose-your-own-story comics"}}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (graphic novel series that lets you control the story) p. 4 of cover (Every Twisted Journeys graphic novel lets you control the action by choosing which path to follow) (OCoLC)77011594"}, "madsrdf:citationSource": "Work cat.: Fontes, J. Captured by pirates, \u00a92007:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Category list > Writing style : comic book (Some gamebooks use the comic book format, complete with illustrated panels and speech bubbles, to tell interactive stories)"}, "madsrdf:citationSource": "Demian's gamebook web page, Apr. 26, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(DC launched Batman: Arkham Origins, its first interactive comic in the previously announced Multiverse format. Designed exclusively for the iPad, the comic has a branching story that prompts the reader to choose different paths at \"bifurcation points.\" Some choices will lead to new adventures -- and more forks in the road -- while others lead to literal dead ends; multi-path stories; multiple-path comics)"}, "madsrdf:citationSource": "DC releases a choose your own adventure-style digital comic about Batman, via Wired website, Dec 19, 2013, viewed Apr. 26, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Oni-Lion Forge Publishing Group are teaming up with Chooseco for a line of graphic novels based on the company's line of Choose Your Own Adventure books, starting late next year)"}, "madsrdf:citationSource": "Chiu-Tabet, C. Oni-Lion Forge announces \"choose your own adventure\" comics, via Multiversity Comics website, Oct. 29, 2020, viewed Apr. 26, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jason Shiga, known for his multi-path comics; the experimental multipath comics of Daniel Merlin Goodbrey; Choose-your-own-story comic; original graphic novel take on a \"choose your own adventure\"; branching story comics; interactive comics and interactive graphic novels; multi-path graphical novel; choose your own adventure graphic novel; Branching-plot comics; branching plot comics; gamebook comics)"}, "madsrdf:citationSource": "Google search, Apr. 26, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(We present two unique and charming choose-your-own-path comics from writer/artist Jack Peacock)"}, "madsrdf:citationSource": "Choose your own path comics!, via Space Squid website, viewed Apr. 26, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A new line of Choose Your Own Adventure graphic novels based on Chooseco's classic line of Choose Your Own Adventure books will publish starting late next year)"}, "madsrdf:citationSource": "First look: choose your own adventure comics hit in 2021, via StoryFix Media website, viewed Apr. 26, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(An innovative cross between adventure games and comic books, our interactive comics allow you to decide how the story develops by choosing where the protagonists go, what they say, and what they do; we also occasionally develop interactive comicbooks for businesses and organisations for use as promotional or educational material)"}, "madsrdf:citationSource": "Interactive comics, via Gamechuck website, Apr. 26, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Branching-story comics"}}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Branching-story comics"}}, {"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc6b69c37ddfe4976bc2cd8faf1de4c55b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Branching-plot comics"}}, 