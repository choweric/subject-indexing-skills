{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026671", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision program clips", "identifiers:lccn": "gf2011026671", "madsrdf:adminMetadata": [{"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb1"}, {"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television program clips"}, "madsrdf:elementList": {"@list": [{"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb3"}]}, "madsrdf:exampleNote": "Note under [Television program excerpts]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026097"}], "madsrdf:hasSource": {"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb5"}, "madsrdf:hasVariant": [{"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb6"}, {"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short segments, usually incomplete scenes, of television programs. For parts, usually complete scenes or sequences, extracted from a complete television program see [Television program excerpts.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025627"}}, {"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-04T15:29:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television program clips"}}, {"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(clips: 1. Short parts or segments from a complete moving image work. Although the work from which the clip was taken may have been distributed, the clip itself has not usually been distributed in this form. 2. In editing, short sections removed from a picture shot, more often called cuts or trims. 3. Also used to describe short film inserts used in live television programming. Excerpts: Parts, normally complete scenes or sequences, taken from a complete moving image work. Although the work from which the excerpt was taken may have been distributed, the excerpt itself has not usually been distributed in this form. An excerpt is distinguished from a clip by the fact that an excerpt is usually longer and gives a more detailed sense of the complete work than a clip does.)"}, "madsrdf:citationSource": "Archival moving image materials online, June 13, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television clips"}}, {"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television clips"}}, {"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Clips, Television program"}}, {"@id": "_:naaf210a8dcb14cd6834d066a8538fe1cb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Clips, Television program"}}], "@id": "/authorities/genreForms/gf2011026671"}
