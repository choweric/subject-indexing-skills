al"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biographies"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Biographies. BT Historical works. NT Autobiographies; Campaign biographies)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 26 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(biographies (documents). UF biographical notes; biographical sketches. Written accounts of the lives of individuals.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 29 (biography 1 history of lives, 2 written life of a person)"}, "madsrdf:citationSource": "G\u00f6rlach, M. Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(biography: A carefully researched, relatively full narrative account of the life of a specific person or closely related group of people, written by another. The biographer selects the most interesting and important events with the intention of elucidating the character and personality of the biographee and placing the subject's life in social, cultural, and historical context. An authorized biography, written with the consent and sometimes the cooperation of its subject, may be less critical than an unauthorized biography)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n973d35e64b9448b990fbd3865fa44805b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biographical sketches"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biographical sketches"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n973d35e64b9448b990fbd3865fa44805b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biographical notes"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biographical notes"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n973d35e64b9448b990fbd3865fa44805b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Unauthorized biographies"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Unauthorized biographies"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n973d35e64b9448b990fbd3865fa44805b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Life histories"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Life histories"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n973d35e64b9448b990fbd3865fa44805b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Histories, Life"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Histories, Life"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n973d35e64b9448b990fbd3865fa44805b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Authorized biographies"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Authorized biographies"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n973d35e64b9448b990fbd3865fa44805b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sketches, Biographical"}}, {"@id": "_:n973d35e64b9448b990fbd3865fa44805b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sketches, Biographical"}}], "@id": "/authorities/genreForms/gf2014026049"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026050", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBlank forms", "identifiers:lccn": "gf2014026050", "madsrdf:adminMetadata": [{"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b1"}, {"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Blank forms"}, "madsrdf:elementList": {"@list": [{"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026354"}, "madsrdf:hasSource": [{"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b5"}, {"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b6"}], "madsrdf:hasVariant": {"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blank forms"}}, {"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(blank forms. Forms--which are formulary documents that arrange particular information in a prescribed sequence and format--that are created with blank spaces, lines, boxes, data entry fields, or other means to prompt users of the form to fill in the particular information. Blank forms may be handwritten, printed, typed, or online. When indexing, this term may be used for such forms whether or not they have been filled in by a user of the form.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Blank forms and similar works designed to record rather than to convey information are not protected by copyright.)"}, "madsrdf:citationSource": "Blank forms and other works not protected by copyright, 2012, via U.S. Copyright Office website, viewed Sept. 9, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Forms, Blank"}}, {"@id": "_:n798f4d2d1d13442393c7a4eb82671d96b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Forms, Blank"}}], "@id": "/authorities/genreForms/gf2014026050"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026051", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBlogs", "identifiers:lccn": "gf2014026051", "madsrdf:adminMetadata": [{"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b1"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Blogs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026172"}, "madsrdf:hasSource": [{"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b5"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b6"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b7"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b8"}], "madsrdf:hasVariant": [{"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b9"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b12"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b15"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blogs"}}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(blogs. Short for 'Web logs' or 'weblogs:' a Web site that functions as an online journal or diary, most often maintained by a single person, but also by groups with common interests. Commentary, images, sound, or video files are posted regularly with the most recent entry appearing first. Blogs may focus on a particular area of interest and contain links to content on external Web pages. Blogs usually have archives of all past entries, with links between similar items of interest. They originated in the United States in 1997 as a few online journals, and became popular ca. 2002, when software designed specifically for creating and maintaining blogs was introduced. For files storing detailed requests from Web servers use 'Web logs.')"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(blog See: Weblog; Weblog: A Web page that provides frequent continuing publication of Web links and/or comments on a specific topic or subject (broad or narrow in scope), often in the form of short entries arranged in reverse chronological order, the most recently added piece of information appearing first. Also spelled Web log)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A blog is a website where entries are written in chronological order and commonly displayed in reverse chronological order. A blog (a truncation of the expression weblog) is a discussion or informational site published on the World Wide Web and consisting of discrete entries (\"posts\") typically displayed in reverse chronological order (the most recent post appears first). Until 2009 blogs were usually the work of a single individual, occasionally of a small group, and often covered a single subject. More recently \"multi-author blogs\" (MABs) have developed, with posts written by large numbers of authors and professionally edited. MABs from newspapers, other media outlets, universities, think tanks, advocacy groups and similar institutions account for an increasing quantity of blog traffic.)"}, "madsrdf:citationSource": "Wikipedia, Sept. 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(blog: a Web site that contains online personal reflections, comments, and often hyperlinks provided by the writer; also : the contents of such a site; short for Weblog)"}, "madsrdf:citationSource": "Merriam-Webster online, Sept. 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Web logs"}}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Web logs"}}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "MABs (Multi-author blogs)"}}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "MABs (Multi-author blogs)"}}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Weblogs"}}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Weblogs"}}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Multi-author blogs"}}, {"@id": "_:n7f71768f29db476daa8808a0ae8b2b85b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Multi-author blogs"}}], "@id": "/authorities/genreForms/gf2014026051"}
