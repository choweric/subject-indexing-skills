c16b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Arranged in roughly chronological order, it brings together movie posters from around the world, starting with Charlie Chaplin film ads and the Russian Revolutionary movie posters of the 1910s, then spanning the century to show posters publicizing hits of the 1990s, including The Silence of the Lambs, Spike Lee films, and many more)"}, "madsrdf:citationSource": "King, E. A century of movie posters, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n639fd21cda674b3bab7330c5bbfb8c16b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "International cinema posters from Poland, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n639fd21cda674b3bab7330c5bbfb8c16b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Olson, J. The queer movie poster book, \u00a92004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n639fd21cda674b3bab7330c5bbfb8c16b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Skinner, Inc. Important motion picture posters, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n639fd21cda674b3bab7330c5bbfb8c16b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n639fd21cda674b3bab7330c5bbfb8c16b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cinema posters"}}, {"@id": "_:n639fd21cda674b3bab7330c5bbfb8c16b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cinema posters"}}, {"@id": "_:n639fd21cda674b3bab7330c5bbfb8c16b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n639fd21cda674b3bab7330c5bbfb8c16b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motion picture posters"}}, {"@id": "_:n639fd21cda674b3bab7330c5bbfb8c16b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion picture posters"}}, {"@id": "_:n639fd21cda