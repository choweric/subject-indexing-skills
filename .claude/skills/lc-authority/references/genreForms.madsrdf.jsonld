eDate": {"@type": "xsd:dateTime", "@value": "2022-11-14T11:33:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "revised"}, {"@id": "_:n8588485f25a6451982476dd7bfe52767b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Live sound recordings"}}, {"@id": "_:n8588485f25a6451982476dd7bfe52767b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg: Live sound recordings)"}, "madsrdf:citationSource": "LCSH, Mar. 17, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n8588485f25a6451982476dd7bfe52767b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(live recording; a recording made at an actual public performance rather than in the studio)"}, "madsrdf:citationSource": "Marco, G.A. Encyc. of recorded sound in the U.S., 1993", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026368"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026369", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLive television programs", "identifiers:lccn": "gf2011026369", "madsrdf:adminMetadata": [{"@id": "_:n75b3c47e438d4955b58447a187292a5eb1"}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Live television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n75b3c47e438d4955b58447a187292a5eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasSource": [{"@id": "_:n75b3c47e438d4955b58447a187292a5eb5"}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb6"}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb7"}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb8"}], "madsrdf:hasVariant": {"@id": "_:n75b3c47e438d4955b58447a187292a5eb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025297"}}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:30:33"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Live television programs"}}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Saturday night live.", "madsrdf:citationStatus": "found"}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 60 (Live shows: use for television programs that are filmed straight through with no time delay to allow for editing)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Live television: television broadcasted in real time or on a short time delay basis. Live television was more common ... in the early years of the medium, before technologies such as videotape recording appeared. Entertainment events such as professional sports games and awards programs continue to be generally broadcast live. Live television inherently has an extemporaneous, spontaneous, and urgent quality that often appears more suspenseful and exciting than recorded programming)"}, "madsrdf:citationSource": "Wikipedia website, July 30, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Live television programs)"}, "madsrdf:citationSource": "LCSH, July 30, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n75b3c47e438d4955b58447a187292a5eb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Live shows (Television programs)"}}, {"@id": "_:n75b3c47e438d4955b58447a187292a5eb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Live shows (Television programs)"}}], "@id": "/authorities/genreForms/gf2011026369"}
