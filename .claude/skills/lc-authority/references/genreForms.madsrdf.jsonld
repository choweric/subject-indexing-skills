01f987d1a03a42d9aa6f5e11e8906f04b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soul music"}}, {"@id": "_:n01f987d1a03a42d9aa6f5e11e8906f04b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Soul. A type of black American popular music that emerged in the mid=1960s. Typically, a single prominent element of musical spontaneity is combine with pervasive musical and extramusical control...)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:n01f987d1a03a42d9aa6f5e11e8906f04b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Soul music.)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027106"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027107", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSoundscapes (Music)", "identifiers:lccn": "gf2014027107", "madsrdf:adminMetadata": [{"@id": "_:n58752670d7764addafac6dacd4596b33b1"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Soundscapes (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n58752670d7764addafac6dacd4596b33b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026022"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2013025016"}, "madsrdf:hasSource": [{"@id": "_:n58752670d7764addafac6dacd4596b33b5"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b6"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b7"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b8"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b9"}], "madsrdf:hasVariant": {"@id": "_:n58752670d7764addafac6dacd4596b33b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions that consist of natural or synthetic sounds from specific locations that are sometimes manipulated electronically."}, {"@id": "_:n58752670d7764addafac6dacd4596b33b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-03T13:41:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "revised"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soundscapes (Music)"}}, {"@id": "_:n58752670d7764addafac6dacd4596b33b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove 2nd ed.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Soundscapes and acoustic ecology (Much of the current interest in soundscapes is an outgrowth of the work of the World Soundscape Project established in the early 1970s by the Canadian scholar, R. Murray Schafer; now a large world-wide community of artists, scholars and activists who are concerned with the sounds of our environment; awareness of sound as a part of everyday life, and creating artistic compositions which use sounds from various environments)"}, "madsrdf:citationSource": "http://arts.sunydutchess.edu/soundscapes/ June 27, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (Soundscape)"}, "madsrdf:citationSource": "Work cat.: Quin, D. Forests [SR] p1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Schafer, R. Murray ([undertook] research into acoustic ecology, a field that he virtually invented, combining such disciplines as acoustics, geography, psychology, urbanology and aesthetics; led to his book The Tuning of the World (Toronto, 1977) and the founding of the World Soundscape Project (now the World Forum for Acoustic Ecology))"}, "madsrdf:citationSource": "New Grove dict. of mus. online, June 18, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (Soundscape: the sonic environment; the term may refer to actual environments, or to abstract constructions such as musical compositions and tape montages, particularly when considered as an environment)"}, "madsrdf:citationSource": "Schafer, R.M. The tuning of the world, 1977:", "madsrdf:citationStatus": "found"}, {"@id": "_:n58752670d7764addafac6dacd4596b33b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n58752670d7764addafac6dacd4596b33b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Environmental sound compositions"}}, {"@id": "_:n58752670d7764addafac6dacd4596b33b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Environmental sound compositions"}}], "@id": "/authorities/genreForms/gf2014027107"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027108", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSousedsk\u00e1s (Music)", "identifiers:lccn": "gf2014027108", "madsrdf:adminMetadata": [{"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b1"}, {"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sousedsk\u00e1s (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b5"}, {"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b6"}, {"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-19T16:46:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sousedsk\u00e1s (Music)"}}, {"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 721 (\"In ... Bohemia and Moravia ... much of the music is based on dance forms, such as the triple-meter sousedsk\u00e1 (a couple's round dance))"}, "madsrdf:citationSource": "Garland encyclopedia of world music, v. 8 : Europe, 2000, s.v. Czech Republic and Slovakia:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"A slow Czech couple-dance in triple time ... believed to be of folk origin ... though it was soon taken into the town dance repertory. It is a type of slow l\u00e4ndler and is known also under a variety of more graphic names such as zdlouha ('slowly'), \u0161oupan\u00e1 and vl\u00e1\u010dn\u00e1 (both 'dragging'). Older types of the sousedsk\u00e1 had more in common with the minuet, serving the function of a ceremonial wedding dance. The dance is known to many different tunes and texts, including folk texts ... and was often extended by the insertion of a trio. Stylizations of the sousedsk\u00e1 occur relatively frequently in Czech art music\")"}, "madsrdf:citationSource": "Grove music online, Apr. 28, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n6c103ed5a73d44e496b18947df1a9c48b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Sousedsk\u00e1)"}, "madsrdf:citationSource": "Work cat.: A\u017e se navr\u00e1ti\u0161 (Columbia 57-F, matrix W106315), 1926:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027108"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027109", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpectral music", "identifiers:lccn": "gf2014027109", "madsrdf:adminMetadata": [{"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb1"}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Spectral music"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb5"}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb6"}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb7"}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb8"}], "madsrdf:hasVariant": {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music that uses the acoustic properties of sound itself (or sound spectra) as the basis for its compositional material."}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:59:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spectral music"}}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Grisey (so-called \"spectral music\")"}, "madsrdf:citationSource": "Oxf. comp. mus., 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2002499804: Siclari, A. Le utopie dell'autentico, c2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Harvard dict. mus.;Baker's dict. mus.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Spectral music: (Fr.: musique spectrale): A term referring to music composed mainly in Europe since the 1970s which uses the acoustic properties of sound itself (or sound spectra) as the basis of its compositional material. It has come to be associated particularly with the composers of the French Groupe de l'Itin\u00e9raire (especially Grisey and Murail), and the German Feedback group, with its principal members Fritsch, Maiguashca, E\u00f6tv\u00f6s, Vivier, and Barlow. The term \"spectral music,\" coined by Dufourt in an article of 1979, emphasizes the importance of the sound spectra themselves to the music and its techniques. However, the tendency has also had important ramifications in the fields of form and musical time)"}, "madsrdf:citationSource": "Grovemusic.com WWW site, Nov. 24, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Musique spectrale"}}, {"@id": "_:ndae791c8f68e4d50a1f0878b8f24d97eb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musique spectrale"}}], "@id": "/authorities/genreForms/gf2014027109"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027110", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpirituals (Songs)", "identifiers:lccn": "gf2014027110", "madsrdf:adminMetadata": [{"@id": "_:n29053f9fed5d45ad8aa841eb7ef4eb5db1"}, {"@id": "_:n29053f9fed5d45ad8aa841eb7ef4eb5db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Spirituals (Songs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n29053f9fed5d45ad8aa841eb7ef4eb5db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026872"}], "madsrdf:hasVariant": {"@id": "_:n29053f9fed5d45ad8aa841eb7ef4eb5db5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n29053f9fed5d45ad8aa841eb7ef4eb5db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n29053f9fed5d45ad8aa841eb7ef4eb5db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n29053f9fed5d45ad8aa841eb7ef4eb5db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spirituals (Songs)"}}, {"@id": "_:n29053f9fed5d45ad8aa841eb7ef4eb5db5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n29053f9fed5d45ad8aa841eb7ef4eb5db6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "African American spirituals"}}, {"@id": "_:n29053f9fed5d45ad8aa841eb7ef4eb5db6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "African American spirituals"}}], "@id": "/authorities/genreForms/gf2014027110"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027111", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSquare dance music", "identifiers:lccn": "gf2014027111", "madsrdf:adminMetadata": [{"@id": "_:ne4c1f72a8b0344f6908900b6d4d10974b1"}, {"@id": "_:ne4c1f72a8b0344f6908900b6d4d10974b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Square dance music"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne4c1f72a8b0344f6908900b6d4d10974b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}], "madsrdf:hasSource": {"@id": "_:ne4c1f72a8b0344f6908900b6d4d10974b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne4c1f72a8b0344f6908900b6d4d10974b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne4c1f72a8b0344f6908900b6d4d10974b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne4c1f72a8b0344f6908900b6d4d10974b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Square dance music"}}, {"@id": "_:ne4c1f72a8b0344f6908900b6d4d10974b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Square dance (A folk dance of the U.S. dance by groups of four couples forming a square... It employs music in moderately fast duple meter performed by a fiddle and or various other instruments...)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed. :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027111"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027112", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSteampunk music", "identifiers:lccn": "gf2014027112", "madsrdf:adminMetadata": [{"@id": "_:n42d77214590f4b7a9746c616dce338a1b1"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Steampunk music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n42d77214590f4b7a9746c616dce338a1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n42d77214590f4b7a9746c616dce338a1b5"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b6"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b7"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b8"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b9"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b10"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b11"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Steampunk music"}}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Abney Park (Musical group). \u00c6ther shanties [SR] 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Steampunk is a genre of fiction, art, design, and music which tends to draw from Victoriana and steam-based tech and industrialism with some gothic influences. Some bands, and solo artists like to attribute its aesthetics to their music, either through visual, musical, lyrical, or thematic influences; top artists: Abney Park; Vernian Process; Dr. Steel; Beats Antique; The Clockwork Dolls; The Cog is Dead; The Clockwork Quartet; Unextraordinary Gentlemen)"}, "madsrdf:citationSource": "Steampunk music, via last.fm website, Aug. 31, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "allmusic.com website, Aug. 31, 2011", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Abney Park; one of the most well-known bands in the Steampunk genre)"}, "madsrdf:citationSource": "Steampunk music, via listal website, Aug. 31, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"And, of course, where would any self-respecting subculture be without its own music? While there's been much debate on the issue, steampunk-related music usually has orchestral characteristics, \u00e0 la Rasputina, or it could also have a Tom Waits-esque metallic, gritty sound. A lot of steampunk bands offer amalgamations. Groups like the aptly named Vernian Process combine Victorian-themed lyrics with old-world instrumentation recreated on synthesizers to create old-world instrumentation while using Victorian-themed lyrics. 'I [chose the band's name] because of Jules Verne, father of the genre and the process,' the group's Joshua A. Pfeiffer said. 'Vernian Process is like the process of making steampunk music.' ... Abney Park are probably the most visually mainstream band in the genre. With beginnings as a goth act, Abney found their calling as steampunk 'airship pirates,' and are happy with the musical vagueness of that designation. 'You can't really pigeonhole all steampunk as a music genre,' bassist Daniel C. said. 'We can do a Victorian [acoustic] music set or we can do our live [electric] set; two completely different sounds, but the focus is considered steampunk.'\")"}, "madsrdf:citationSource": "Rowe, A.R. What is steampunk? A subculture infiltrating films, music, fashion, more, via MTV website, Aug. 31, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Without having come upon an actual definition of Steampunk music, I will attempt to give my take on it. Steampunk bands are a mixture of types of music, musical instruments and diverse sounds. The music usually has orchestral attributes with a metallic, gritty sound. The bands tend to be an amalgam of synthetic dream foundations with machinery rhythms and classical music. Steampunk has gothic, electronic and industrial influences along with a bit of worldwide adventurer elements. The music can be upbeat and silly, elegant and daring, romantic or clinical, hilarious or serious. The essentials of Steampunk have been around for a long time, however only recently has become part of mainstream culture.\")"}, "madsrdf:citationSource": "Steampunk music, via squidoo website, Aug. 31, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"There is no steampunk music ... Go listen to the musical tracks of steampunk bands out there: Abney Park, Dr. Steel, The Men that Will Not Be Blamed for Nothing, Rasputina, Voltaire, Beware the Other Head of Science, Long-Stride Lizzy, and plenty more. Can you honestly say the music is a new genre? Breaking new ground in tonality, rhythm, arrangement, instrumentation? No. Steampunk is about words, clothing and accessories. And that's why those bands are called steampunk. The lyrics are neo-Victorian, mad-scientist, or about gadgets and gizmos. The band members are dressed in uber-cool steampunky outfits, and their instruments are old-timey or doctored up to look old-timey ... The key to it all is the feeling. Regardless of the musical medium, the bands that call themselves Steampunk are fun and quirky and it reflects in their sound ... If Music is defined by the tonal and rhythmic quality of the sound, then there isn't anything to define the new genre of steampunk. But if Music is more than that, if it's the performance, the lyrics, the atmosphere, as well as the musicality...well, then there is something new going on.\")"}, "madsrdf:citationSource": "Angel, R. Steampunk music?, via GeekMom website, Aug. 31, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n42d77214590f4b7a9746c616dce338a1b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "\u00c6ther Shanties (\u00c6ther Shanties is the 10th album by steampunk band Abney Park. It is also their second steampunk themed album.) Steampunk (Steampunk music; range of steampunk musical styles can be heard in the work of various steampunk artists, from the industrial dance/world music of Abney Park, the inventor/singer-songwriter creations of Thomas Truax, the Carnatic influenced music of Sunday Driver, the \"industrial hip-hop opera\" of Doctor Steel, the darkwave and progressive rock sounds of Vernian Process, the Unextraordinary Gentlemen, the electronic sounds of The Wet-Glass RO, Darcy James Argue's 18-piece big band Secret Society and the musical storytelling of Escape the Clouds. The British-American composer David Bruce's 2010 octet 'Steampunk' was commissioned by Carnegie Hall.\") Category: Steampunk music (a subcategory under Science fiction music; lists the following entries: Abney Park (band); Robert Brown (musician); Chap hop; The Clockwork Cabaret; Doctor Steel; Johnny Hollow; The Men That Will Not Be Blamed for Nothing; Professor Elemental; Rasputina (band); Mr. B The Gentleman Rhymer; Sunday Driver (UK); Tankus the Henge; Unextraordinary Gentlemen; Vernian Process; Chris Vrenna)"}, "madsrdf:citationSource": "Wikipedia, Aug. 31, 2011:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027112"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027113", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStochastic music", "identifiers:lccn": "gf2014027113", "madsrdf:adminMetadata": [{"@id": "_:nacd54b01b57549608a274877765078bfb1"}, {"@id": "_:nacd54b01b57549608a274877765078bfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Stochastic music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nacd54b01b57549608a274877765078bfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions composed through the application of mathematical processes based on probability to various aspects of the music, such as timbre, pitch or dynamics, either to create a static composition or to improvise a performance."}, {"@id": "_:nacd54b01b57549608a274877765078bfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:59:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nacd54b01b57549608a274877765078bfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nacd54b01b57549608a274877765078bfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stochastic music"}}], "@id": "/authorities/genreForms/gf2014027113"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027114", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStrathspeys (Music)", "identifiers:lccn": "gf2014027114", "madsrdf:adminMetadata": [{"@id": "_:nbcdffe0e255e4f30ae46e5c4b76ab78bb1"}, {"@id": "_:nbcdffe0e255e4f30ae46e5c4b76ab78bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Strathspeys (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbcdffe0e255e4f30ae46e5c4b76ab78bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027043"}, "madsrdf:hasSource": {"@id": "_:nbcdffe0e255e4f30ae46e5c4b76ab78bb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbcdffe0e255e4f30ae46e5c4b76ab78bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbcdffe0e255e4f30ae46e5c4b76ab78bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbcdffe0e255e4f30ae46e5c4b76ab78bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Strathspeys (Music)"}}, {"@id": "_:nbcdffe0e255e4f30ae46e5c4b76ab78bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Strathspey. A type of Scottish reel, slower in tempo, in duple meter, and characterized by dotted rhythms, including the inverted dotting termed the Scotch snap...)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027114"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027115", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStudies (Music)", "identifiers:lccn": "gf2014027115", "madsrdf:adminMetadata": [{"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b1"}, {"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Studies (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b3"}]}, "madsrdf:exampleNote": "Note under [Concert etudes]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027207"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026723"}, "madsrdf:hasSource": {"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b5"}, "madsrdf:hasVariant": [{"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b6"}, {"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical works and exercises designed for practice with the aim of perfecting a facet of performing technique. For instrumental pieces designed for performance in order to exploit a facet of performing technique see [Concert etudes.]"}, {"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-19T14:18:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies (Music)"}}, {"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Study; Fr. \u00e9tude; Ger. Et\u00fcde, Studie; It. studio; an instrumental piece, usually of some difficulty and most often for a stringed keyboard instrument, designed primarily to exploit and perfect a chosen facet of performing technique, but the better for having some musical interest; although a study was at one time the same as an exercise (Fr. exercise; Ger. \u00dcbung; It. essercizio), the latter term now usually implies a short figure or passage to be repeated ad lib on different degrees of the scale or in various keys; before the 19th century both terms were used more loosely)."}, "madsrdf:citationSource": "Grove music online, viewed April 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Exercises (Music)"}}, {"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Exercises (Music)"}}, {"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Etudes (Studies)"}}, {"@id": "_:n015d59e87bdc4c20a2033bbaf395b3b8b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Etudes (Studies)"}}], "@id": "/authorities/genreForms/gf2014027115"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027116", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSuites", "identifiers:lccn": "gf2014027116", "madsrdf:adminMetadata": [{"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b1"}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Suites"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b5"}, "madsrdf:hasVariant": [{"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b6"}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b9"}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b12"}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b15"}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b18"}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b21"}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b24"}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suites"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Suite: in a general sense, any ordered set of instrumental pieces meant to be performed at a single sitting; during the Baroque period, an instrumental genre consisting of several movements in the same key, some or all of which were based on the forms and styles of dance music; then and later, a group of pieces extracted from a larger work, especially an opera or ballet; the term did not come into common use until the last quarter of the 17th century, but the kinds of set to which it was eventually applied had a long history, and pairing of dances may be found as early as the 14th century; in Vienna the transition from suite to sonata took place behind the screen of the various terms for entertainment music: divertimento, serenade, cassation, partita, and notturno; the term divertimento, which was the preferred one for any non-orchestral ensemble piece, light or serious, between 1750 and 1780, overlapped with partita, which was a similarly general designation up to about 1760; both could be used for keyboard music as well; \"divertimento\" carried no implication regarding the number or order of movements or the key-scheme. Divertimento: musical genre, prominent in the Classical period; its structure is normally cyclic; may comprise 1-9 movements, and occasionally as many as 13; its larger manifestations are thus suite-like in movement structure. Cassation: term used 1750-1775 in southern Germany, Austria, and Bohemia as a title of a composition or of a single movement; the soloistic cassation is stylistically related to the divertimento, the orchestral cassation to the serenade. Serenade: musical form, contemporary with and related to other mid-18th-century orchestral genres including the symphony and the orchestral partita; used in its Italian form, serenata, in the late 16th century as a title for vocal works, and in the 17th it was used for celebratory works for voices and instruments; by the end of the century it was applied to purely instrumental pieces, a usage accepted in the 18th century; it then came to stand, if loosely, for a work of a particular character, formal structure and instrumentation, of which Mozart's serenades are the chief examples; such works were composed mainly in Italy, Austria, Germany, and Bohemia; it was the practice to perform them at about 9 p.m.; the orchestral serenade of the 19th century resembles the symphony or suite in construction. Notturno: term used in the 18th century mainly for works performed outdoors, not in the evening but at night (generally around 11 p.m.); the form is related to the serenade; the later nocturne for solo piano had no direct connection with the notturno. Nachtmusik: German form of notturno; Mozart often preferred this term to the Italian one, particularly for works of relatively simple scoring.)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, July 18, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Divertimentos"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Divertimentos"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nachtmusik"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nachtmusik"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Serenades (Instrumental music)"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serenades (Instrumental music)"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Divertimenti"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Divertimenti"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Partitas"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Partitas"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Notturni"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Notturni"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cassations"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cassations"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Notturnos"}}, {"@id": "_:n3f5d55b122d34e2f95f3441d831e8962b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Notturnos"}}], "@id": "/authorities/genreForms/gf2014027116"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027117", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSurf music", "identifiers:lccn": "gf2014027117", "madsrdf:adminMetadata": [{"@id": "_:nd87b11dd66514f58b82032252b3356f6b1"}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Surf music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd87b11dd66514f58b82032252b3356f6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}, "madsrdf:hasSource": [{"@id": "_:nd87b11dd66514f58b82032252b3356f6b5"}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b6"}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b7"}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b8"}], "madsrdf:hasVariant": {"@id": "_:nd87b11dd66514f58b82032252b3356f6b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surf music"}}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 428, Surf music (A broad trend that dominated grassroots teenage music in America during the years 1962-5, surf music actually breaks down into four distinct phases. It started as early as 1961 with such transitional records as Mr Moto by the Belairs ... [et al.] which had what later would be called a surf sound, but no overt connection with surfing. The catalyst that turned these thousands of instrumental bands into surf bands was Dick Dale, whose Eastern-influenced, staccato guitar sound was designed to simulate the feel of being on a surfboard. The Beach Boys ... pioneered surf lyrics in songs that were about going to the beach, surfing, partying, etc. Late in 1963, the record industry decided that surfing was out, and hot rod music would be in. Cars and beaches were really part of the same culture and the same metaphor. This trend lasted a year or so, by which time the Beach Boys had evolved the music a stage further. Now it wasn't surf music or car music, but simply California music, or summer music. Summer means fun, California means summer, summer means beaches, beaches mean girls, girls mean cars, cars mean fun, etc., etc. Now fun was the key word. Though surf music as a commercial trend died in 1966, 1974 saw a brief revival as a reissue of Surfin' USA by the Beach Boys became a large hit and several other surfing records made the charts.)"}, "madsrdf:citationSource": "Encyclopedia of rock, 1987:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Surf rock was one of the most popular forms of American rock & roll of the early '60s. Distinguished by reverb-drenched guitar, rolling instrumentals that were designed to sound like crashing waves, and simple, three-chord songs, the music may sound similar on the surface, but it was revolutionary music for its time, exploring sonic territories previously unheard in rock music)"}, "madsrdf:citationSource": "All Music Guide, Feb. 18, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 292, Surf music (Surf music was the most guitar-oriented style of early rock 'n' roll, and had enormous influence on subsequent electric guitar playing styles ... Surf music experienced a revival in the 1980s, and continues to maintain a cult status associated with specialist labels; though now only rarely played, it has become an element of more contemporary genres, while its guitar sound continues to be influential)"}, "madsrdf:citationSource": "Shuker, R. Key concepts in popular music, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (Surf music)"}, "madsrdf:citationSource": "Work cat.: 2010560147: McParland, S. The big kahuna, c2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd87b11dd66514f58b82032252b3356f6b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surf rock"}}, {"@id": "_:nd87b11dd66514f58b82032252b3356f6b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surf rock"}}], "@id": "/authorities/genreForms/gf2014027117"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027118", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSwamp pop music", "identifiers:lccn": "gf2014027118", "madsrdf:adminMetadata": [{"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb1"}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Swamp pop music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb5"}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb6"}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb7"}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb8"}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-19T16:47:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Swamp pop music"}}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Amerigrove;Guinness encyl. of popular music;Web. 3", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(musical genre indigenous to the Acadiana region of south Louisiana and an adjoining section of southeast Texas. Created in the 1950s and early 1960s by teenaged Cajuns and black Creoles, it combines New Orleans-style rhythm and blues, country and western, and traditional French Louisian musical influences... sound is typified by highly emotional, lovelorn lyrics, tripleting honky-tonk pianos, undulating bass lintes, bellowing horn sections, and a strong rhythm and blues backbeat)"}, "madsrdf:citationSource": "Wikipedia, viewed November 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(swamp-pop)"}, "madsrdf:citationSource": "Encyl. of rock, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Swamp pop is a brand of rock & roll that emerged from Louisiana. It was a hybrid of rock & roll, pop, and Louisiana blue and R&B; gritty, funky feel)"}, "madsrdf:citationSource": "Allmusic, viewed November 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n508676da6c9b4505aca8d8da80e7f63cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(swamp pop; swamp pop music)"}, "madsrdf:citationSource": "Work cat.: 95-53231: Bernard, S.K. Swamp pop, 1996", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027118"}
