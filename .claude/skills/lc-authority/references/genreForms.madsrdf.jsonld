type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Contemporary Christian music"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Christian rock music; x-refs. from Contemporary Christian music; Jesus music; Rock music, Christian)"}, "madsrdf:citationSource": "Hennepin", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Contemporary Christian music; CCM; also called \"inspirational music\"; designates a genre that merges the gospel of Protestant evangelism with rock and roll)"}, "madsrdf:citationSource": "Grove music online, viewed August 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Christian contemporary music; \"Contemporary Christian is the music of the '80s\"; evangelical pop; a category of gospel music; musical styles vary from mellow pop and folk to rock)"}, "madsrdf:citationSource": "Time, 3/11/85: p.60", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Contemporary Christian music; CCM; earlier called Jesus music)"}, "madsrdf:citationSource": "Work cat.: Baker, P. Contemporary Christian music, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Top inspirational albums)"}, "madsrdf:citationSource": "Billboard, v. 98, no. 10, 3/8/86: p. 72", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Evangelical popular music"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Evangelical popular music"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jesus music"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jesus music"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "CCM (Contemporary Christian music)"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "CCM (Contemporary Christian music)"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Christian contemporary music"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Christian contemporary music"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Inspirational music (Contemporary Christian music)"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Inspirational music (Contemporary Christian music)"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Christian popular music"}}, {"@id": "_:n9b93400f7b4b4c4693e74e0d519bfd08b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Christian popular music"}}], "@id": "/authorities/genreForms/gf2014026728"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026729", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aContrafacta", "identifiers:lccn": "gf2014026729", "madsrdf:adminMetadata": [{"@id": "_:n40e907ae45074b55a193e84e83ddc985b1"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Contrafacta"}, "madsrdf:elementList": {"@list": [{"@id": "_:n40e907ae45074b55a193e84e83ddc985b3"}]}, "madsrdf:exampleNote": "Note under [Musical parodies; Song parodies]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026010"}, "madsrdf:hasSource": [{"@id": "_:n40e907ae45074b55a193e84e83ddc985b5"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b6"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b7"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b8"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b9"}], "madsrdf:hasVariant": [{"@id": "_:n40e907ae45074b55a193e84e83ddc985b10"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Vocal works from the Middle Ages or Renaissance in which a new text has been substituted for the original without a significant change to the music. For post-Renaissance songs in which a new text has been substituted for the original without a significant change to the music see [Song parodies.] For compositions that distort or exaggerate features of another composition or a composer's works in general for humorous or satirical ends see [Musical parodies.]"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-23T12:31:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "revised"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Contrafacta"}}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Contrafactum: A vocal work in which a new text has been substituted for the original one. The substitution of new texts in preexisting works was common through the 16th century, was restricted to fewer genres in the 17th and 18th centuries, and, in art music, largely disappeared in the 19th century.)"}, "madsrdf:citationSource": "New Harvard dict. of music, 4th ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 45-47 (the author apparently coins the procedural term \"contrafacture\")"}, "madsrdf:citationSource": "Work cat.: Tischler, H. Conductus and contrafacta, c2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Parody (2) (A work in which a new text has been substituted for the original, often without humorous intent. A work of this type from the Middle Ages or Renaissance is usually termed a contrafactum.)"}, "madsrdf:citationSource": "New Harvard dict. of music:", "madsrdf:citationStatus": "found"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(contrafact or contrafactum, pl. contrafacts or contrafacta: a 16th century musical setting of the mass or a chorale or hymn produced by replacing the text of a secular song with religious poetry)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Contrafactum: In vocal music, the substitution of one text for another without substantial change to the music. As the term is used in the modern sense, no precise limits have been observed in the designation of a song or composition as a contrafactum. Contrafacta are found in the secular monophonic repertory of the 12th and 13th centuries, in the plainchant repertory, in medieval polyphony, in exchanges between secular partsongs and the motet in the 15th and 16th centuries, in the Italian laude, in the Protestant chorale, and in other types. In the late 17th and 18th centuries, contrafacta tended to be called parody.)"}, "madsrdf:citationSource": "New Grove dict. of music, 2nd ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n40e907ae45074b55a193e84e83ddc985b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Parodies (Music)"}}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Parodies (Music)"}}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n40e907ae45074b55a193e84e83ddc985b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Contrafacts"}}, {"@id": "_:n40e907ae45074b55a193e84e83ddc985b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Contrafacts"}}], "@id": "/authorities/genreForms/gf2014026729"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026730", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCool jazz", "identifiers:lccn": "gf2014026730", "madsrdf:adminMetadata": [{"@id": "_:n07bb324b947a469d8e7818edfaf1e248b1"}, {"@id": "_:n07bb324b947a469d8e7818edfaf1e248b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cool jazz"}, "madsrdf:elementList": {"@list": [{"@id": "_:n07bb324b947a469d8e7818edfaf1e248b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026879"}, "madsrdf:hasSource": [{"@id": "_:n07bb324b947a469d8e7818edfaf1e248b5"}, {"@id": "_:n07bb324b947a469d8e7818edfaf1e248b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n07bb324b947a469d8e7818edfaf1e248b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n07bb324b947a469d8e7818edfaf1e248b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n07bb324b947a469d8e7818edfaf1e248b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cool jazz"}}, {"@id": "_:n07bb324b947a469d8e7818edfaf1e248b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Cool jazz (diverse styles of modern jazz variously perceived as subdued, understated, or emotionally cool; players themselves often voiced distaste for the label; most saxophonists were disciples of Lester Young; a number of trumpeters drew on the style of Miles Davis; cool drummers played more quietly and conservatively than other modern jazz drummers; no well-defined cool jazz piano style)"}, "madsrdf:citationSource": "New Grove jazz:", "madsrdf:citationStatus": "found"}, {"@id": "_:n07bb324b947a469d8e7818edfaf1e248b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2002070036: Bebop to cool, 2002.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026730"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026731", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCoplas (Music)", "identifiers:lccn": "gf2014026731", "madsrdf:adminMetadata": [{"@id": "_:n3e7727b933e04156b93f10d2a0be2872b1"}, {"@id": "_:n3e7727b933e04156b93f10d2a0be2872b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Coplas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3e7727b933e04156b93f10d2a0be2872b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, "madsrdf:hasSource": {"@id": "_:n3e7727b933e04156b93f10d2a0be2872b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3e7727b933e04156b93f10d2a0be2872b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3e7727b933e04156b93f10d2a0be2872b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n3e7727b933e04156b93f10d2a0be2872b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Coplas (Music)"}}, {"@id": "_:n3e7727b933e04156b93f10d2a0be2872b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Copla. A verse form of Hispanic origin, usually sung, consisting of four eight-, six- or five-syllable lines generally rhymed ABCB. Often improvised, coplas relate humorous incidents, amorous sentiments, current or historical events or merely comment on daily life or the natural environment of the singer. Witty use of slang expressions and double meanings add to their often erotic nature.)"}, "madsrdf:citationSource": "Grove music online, viewed June 12, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026731"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026732", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCoronation music", "identifiers:lccn": "gf2014026732", "madsrdf:adminMetadata": [{"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b1"}, {"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Coronation music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, "madsrdf:hasSource": [{"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b5"}, {"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b6"}], "madsrdf:hasVariant": {"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music written to celebrate the coronation of a monarch."}, {"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:20:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Coronation music"}}, {"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Coronation anthem (Music written to accompany the coronation of a monarch; best known were composed by Handel)"}, "madsrdf:citationSource": "Wikipedia, viewed August 29, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Coronation music for King James II (1685), 1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Coronation anthems"}}, {"@id": "_:n13c09e59813d4fc5a082f4dea5e5d4c4b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Coronation anthems"}}], "@id": "/authorities/genreForms/gf2014026732"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026733", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCorpus Christi Festival music", "identifiers:lccn": "gf2014026733", "madsrdf:adminMetadata": [{"@id": "_:n473408cd4485463fa33a0a1e7484b649b1"}, {"@id": "_:n473408cd4485463fa33a0a1e7484b649b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Corpus Christi Festival music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n473408cd4485463fa33a0a1e7484b649b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music that is traditionally associated with the Corpus Christi Festival."}, {"@id": "_:n473408cd4485463fa33a0a1e7484b649b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:01:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n473408cd4485463fa33a0a1e7484b649b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n473408cd4485463fa33a0a1e7484b649b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Corpus Christi Festival music"}}], "@id": "/authorities/genreForms/gf2014026733"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026734", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCorridos (Music)", "identifiers:lccn": "gf2014026734", "madsrdf:adminMetadata": [{"@id": "_:nd2c630db667e4dd693d16961e25eaf06b1"}, {"@id": "_:nd2c630db667e4dd693d16961e25eaf06b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Corridos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd2c630db667e4dd693d16961e25eaf06b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026648"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}], "madsrdf:hasSource": [{"@id": "_:nd2c630db667e4dd693d16961e25eaf06b5"}, {"@id": "_:nd2c630db667e4dd693d16961e25eaf06b6"}, {"@id": "_:nd2c630db667e4dd693d16961e25eaf06b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd2c630db667e4dd693d16961e25eaf06b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-07-15T14:52:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nd2c630db667e4dd693d16961e25eaf06b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd2c630db667e4dd693d16961e25eaf06b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Corridos (Music)"}}, {"@id": "_:nd2c630db667e4dd693d16961e25eaf06b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A narrative ballad genre which arose in association with the Mexican Revolution of 1910. It also refers to a Mexican dance genre of the Huastec region.)"}, "madsrdf:citationSource": "Grove music online, viewed August 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2c630db667e4dd693d16961e25eaf06b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Corridos are a form of narrative song or verse popular in Mexico and the southwestern United States. Related to the Spanish epic ballads known as romances, corridos have been variously defined. The classic corrido is a narrative ballad, generally consisting of regular verses of four octosyllabic lines, beginning with a verse setting the theme, then telling a story, and ending with a despedida (farewell). The Mexican corrido seems to have emerged as a distinct style in the early or mid-19th century and reached a peak of popularity during the Mexican Revolution (1910-1920), during which virtually every major figure and battle was commemorated in verse. A new wave of corridos emerged in the 1970s, often performed by commercial recording artists and commemorating drug traffickers (thus, the songs are generally known as narcocorridos) but also composed and performed by amateurs and semiprofessionals and dealing with local events and characters or broader issues such as political corruption and immigration to the United States; Traditionally, corridos were often recited rather than sung; when sung, they are typically performed a cappella or accompanied by stringed instruments, most commonly guitars)"}, "madsrdf:citationSource": "Wald, E. Corridos, 2014, via Oxford bibliographies website, viewed May 18, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2c630db667e4dd693d16961e25eaf06b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Corrido. See Chicana/o poetry; romance; under Romance: The romance is the simplest and most common \ufb01xed form in Spanish poetry. It is usually written in octosyllabic verse in which the even lines assonate alike and the odd-numbered are left free; One variation of the romance is the corrido (ballad with guitar accompaniment), esp. popular in Mexico)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026734"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026735", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCosaques (Music)", "identifiers:lccn": "gf2014026735", "madsrdf:adminMetadata": [{"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b1"}, {"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cosaques (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b5"}, "madsrdf:hasVariant": {"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cosaques (Music)"}}, {"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cosaque (Fr.); Cossack dance in simple duple time with continual accelerando)"}, "madsrdf:citationSource": "Oxford dictionary of music online, viewed July 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kozaki (Music)"}}, {"@id": "_:n8cb21549a8b84be48783ea7516ee5cd9b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kozaki (Music)"}}], "@id": "/authorities/genreForms/gf2014026735"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026736", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCotillions (Music)", "identifiers:lccn": "gf2014026736", "madsrdf:adminMetadata": [{"@id": "_:n163a649d04164a49bef07b226d68e926b1"}, {"@id": "_:n163a649d04164a49bef07b226d68e926b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cotillions (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n163a649d04164a49bef07b226d68e926b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:n163a649d04164a49bef07b226d68e926b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n163a649d04164a49bef07b226d68e926b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n163a649d04164a49bef07b226d68e926b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n163a649d04164a49bef07b226d68e926b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cotillions (Music)"}}, {"@id": "_:n163a649d04164a49bef07b226d68e926b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cotillion; social dance of 18th century French origin, popular in Europe and America throughout the 19th century... It was danced in squares, like the quadrille and country dances, involving geometric patterns and figures, and the tempo was similar to the that of the quadrille, a dance often described as a \"cotillion\" in the mid-19th century. It was structured in the two alternating parts of the \"change\" (the same for all cotillions) and the \"figure\" (unique to a particular cotillion). The music was generally arranged from existing tunes...)"}, "madsrdf:citationSource": "Grove music online, viewed July 14, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026736"}
