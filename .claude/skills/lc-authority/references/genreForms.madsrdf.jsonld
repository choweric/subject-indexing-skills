http://id.loc.gov/authorities/genreForms/gf2018026131"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026142"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026151"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026152"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026007"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026030"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026031"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026032"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026103"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026017"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026117"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026082"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2025026014"}], "madsrdf:hasSource": [{"@id": "_:n883a760e13374d22ab996dcc6bbe2481b5"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b6"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b7"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b8"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b9"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b10"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b11"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b12"}], "madsrdf:hasVariant": {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b13"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-01-27T10:29:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "revised"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Discursive works"}}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Discourse (redirected from Discursive practice): a generalization of the notion of a conversation to any form of communication. Discourse is a major topic in social theory, with work spanning fields such as sociology, anthropology, continental philosophy, and discourse analysis. Following work by Michel Foucault, these fields view discourse as a system of thought, knowledge, or communication that constructs our world experience)"}, "madsrdf:citationSource": [{"@id": "https://en.wikipedia.org/wiki/Discourse"}, "Wikipedia, viewed December 5, 2024"], "madsrdf:citationStatus": "found"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(discursive: 3. Relating to discourse or modes of discourse)"}, "madsrdf:citationSource": "Oxford English Dictionary online, viewed December 5, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Discourse is the use of language to share ideas, insights, and information.)"}, "madsrdf:citationSource": "Grammerly, viewed December 5, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Discourse: A specific form of language use shaped and determined by situational rules and context. Discourse can be thought of as the performance of language, but even this is too limiting because the concept is used in place of language precisely as a way of encompassing the extra-linguistic dimension of all forms of communication.)"}, "madsrdf:citationSource": "A dictionary of critical theory (2nd 2d.) via Oxford Reference, viewed December 12", "madsrdf:citationStatus": "found"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 40 (discourse: account, narrative; formal discussion, treatise, homily)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Discoursive works. Scope Note: Gathering term; do not use; index under a narrower term. BT Purpose of work (Gathering term; do not assign). NT Addresses; Dialogues; Interviews; Letters; Questions and answers)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 74 (\"Discursive\" is an adjective understood as pertaining to or involving discourse. (...) But what is discourse? (...) The first common and elemental conception of discourse deals with the notions of language and conversation -- communicative acts and exchanges) page 75 (Discourses are systems of thought or knowledge -- these are generally more situated, informed, and institutionalized than mere conversation (though they are certainly expressed through, and influence ways of conversing). Language is admittedly fundamental to the production, dissemination, and consumption of discourses, but understanding discourse as systems of thought or knowledge helps move them beyond language alone.) page 76 (Discourse is composed of ideas, values, attitudes, and beliefs that are manifest through various forms of writing, speaking, gesturing, and acting and through objects and technologies. (...) Discourses are incredibly powerful devices that constitute and are constituted by people--they are inescapable and crucial in navigating human (social) existence))"}, "madsrdf:citationSource": "Discursive Design, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(discursive practices: Foucault's term for communicative practices based on rules that define and construct their referents)"}, "madsrdf:citationSource": "A dictionary of media and communication (1 ed.) via Oxford Reference, viewed December 5, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n883a760e13374d22ab996dcc6bbe2481b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Discourses"}}, {"@id": "_:n883a760e13374d22ab996dcc6bbe2481b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Discourses"}}], "@id": "/authorities/genreForms/gf2014026089"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026090", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDouble-crostics", "identifiers:lccn": "gf2014026090", "madsrdf:adminMetadata": [{"@id": "_:nde2c04b176d84acfa54984897def8d01b1"}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Double-crostics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nde2c04b176d84acfa54984897def8d01b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026040"}, "madsrdf:hasSource": [{"@id": "_:nde2c04b176d84acfa54984897def8d01b5"}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b6"}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b7"}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b8"}], "madsrdf:hasVariant": [{"@id": "_:nde2c04b176d84acfa54984897def8d01b9"}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Double-crostics"}}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Double-Crostic (Trademark): a word game in which the player suits word definitions to numbered spaces to produce a quotation, the first letters of the definitions forming the name of the author and of the work from which the quote comes.)"}, "madsrdf:citationSource": "Random House unabridged dictionary, \u00a91997", "madsrdf:citationStatus": "found"}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Double acrostics are puzzles constructed so that not only the initial letters of the lines but in some cases also the middle or last letters form words. In the United States, the Double Crostic puzzle, devised by Elizabeth Kingsley for the Saturday Review in 1934, had an acrostic in the answers to the clues giving the author and title of a literary work; the letters, keyed by number to blanks like those of a crossword puzzle, spelled out a quotation)"}, "madsrdf:citationSource": "Britannica online, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(double-crostic: a puzzle whose object is to fill in with words guessed from definitions a column of numbered dashes and then copy each letter in the correspondingly numbered square of a diagram so that words in the diagram form a quotation and the initial letters of the words in the column spell the author and title from which the quotation is taken; formerly a U.S. registered trademark)"}, "madsrdf:citationSource": "Merriam-Webster online, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Double-crostics. BT Acrostics; Literary recreations; Puzzles)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde2c04b176d84acfa54984897def8d01b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Double acrostics"}}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Double acrostics"}}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde2c04b176d84acfa54984897def8d01b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Double acrostic puzzles"}}, {"@id": "_:nde2c04b176d84acfa54984897def8d01b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Double acrostic puzzles"}}], "@id": "/authorities/genreForms/gf2014026090"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026091", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEmblem books", "identifiers:lccn": "gf2014026091", "madsrdf:adminMetadata": [{"@id": "_:n701c7eef534d4657bd823b43d9216ca9b1"}, {"@id": "_:n701c7eef534d4657bd823b43d9216ca9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Emblem books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n701c7eef534d4657bd823b43d9216ca9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, "madsrdf:hasSource": [{"@id": "_:n701c7eef534d4657bd823b43d9216ca9b5"}, {"@id": "_:n701c7eef534d4657bd823b43d9216ca9b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Books containing illustrations with accompanying interpretations of their allegorical meaning."}, {"@id": "_:n701c7eef534d4657bd823b43d9216ca9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n701c7eef534d4657bd823b43d9216ca9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:24:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n701c7eef534d4657bd823b43d9216ca9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Emblem books"}}, {"@id": "_:n701c7eef534d4657bd823b43d9216ca9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Emblem books. Use for collections of emblems, i.e., mottoes or epigrams accompanied by a verse and sometimes a symbolic illustration, based upon a poetic conceit or moral statement, particularly popular in the 16th and 17th centuries. BT Illustrated works; Literary forms (Gathering term; do not assign))"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n701c7eef534d4657bd823b43d9216ca9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(emblem book: A type of illustrated book, popular from the early 16th century to about 1700, containing a collection of symbolic engravings or woodcuts called emblems, each expressing a moral adage or principle, accompanied by an epigram, motto, proverb, or brief explanatory text in prose or verse. Included in this category are books with the text arranged in symbolic designs, for example, crosses. The form was revived by the poet William Blake in Gates of Paradise.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 29, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026091"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026092", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEncyclopedias", "identifiers:lccn": "gf2014026092", "madsrdf:adminMetadata": [{"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b1"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Encyclopedias"}, "madsrdf:elementList": {"@list": [{"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasSource": [{"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b5"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b6"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b7"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b8"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b9"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b10"}], "madsrdf:hasVariant": [{"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b11"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b14"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b17"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Encyclopedias"}}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(encyclopedias. UF cyclopedias; encyclopaedias. Books, set of books, or disks, containing informational articles on subjects in every field of knowledge, or limited to a special field or subject, usually arranged in alphabetical order.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cyclopedia, cyclopaedia or cyclop\u00e6dia is an archaic term for encyclopedia; An encyclopedia (also spelled encyclopaedia or encyclop\u00e6dia) is a type of reference work or compendium holding a comprehensive summary of information from either all branches of knowledge or a particular branch of knowledge. Encyclopedias are divided into articles or entries, which are usually accessed alphabetically by article name. Encyclopedia entries are longer and more detailed than those in most dictionaries. Generally speaking, unlike dictionary entries, which focus on linguistic information about words, encyclopedia articles focus on factual information to cover the thing or concept for which the article name stands.)"}, "madsrdf:citationSource": "Wikipedia, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Encyclopedias. BT Wordbooks)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(encyclopedia (plural encyclopedias or encyclopediae or encyclopedi\u00e6); cyclopedia: Alternative spelling of cyclopaedia; cyclopaedia (plural cyclopaedias))"}, "madsrdf:citationSource": "Wiktionary, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 41 (encyclopedia: book containing information on all branches of knowledge, arranged alphabetically)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(encyclopedia: A book or numbered set of books containing authoritative summary information about a variety of topics in the form of short essays, usually arranged alphabetically by headword or classified in some manner. An entry may be signed or unsigned, with or without illustration or a list of references for further reading. Headwords and text are usually revised periodically for publication in a new edition. In a multivolume encyclopedia, any indexes are usually located at the end of the last volume. Encyclopedias may be general or specialized, usually by subject or discipline. Also spelled encyclopaedia. Synonymous with cyclopedia.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Encyclopaediae"}}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Encyclopaediae"}}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Encyclopaedias"}}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Encyclopaedias"}}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cyclopaedias"}}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cyclopaedias"}}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cyclopedias"}}, {"@id": "_:n70a82a5c3b1448eeb45f308799c6a555b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cyclopedias"}}], "@id": "/authorities/genreForms/gf2014026092"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEphemera", "identifiers:lccn": "gf2014026093", "madsrdf:adminMetadata": [{"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb1"}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ephemera"}, "madsrdf:elementList": {"@list": [{"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb3"}]}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026050"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026055"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026067"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026073"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026096"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026117"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026127"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026131"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026151"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026153"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026156"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026162"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026198"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026210"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026053"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026133"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027219"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027235"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027252"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027264"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026029"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026046"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026066"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026015"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026028"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026045"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026066"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026088"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026022"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026055"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026068"}], "madsrdf:hasSource": [{"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb5"}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb6"}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb7"}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb8"}], "madsrdf:hasVariant": [{"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb9"}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ephemera"}}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ephemera. Use for transient everyday items, usually printed on paper, that are produced for a specific limited use and then often thrown away. BT Conditions of publication (Gathering term; do not assign). NT Advertisements; Awards; Blank forms; Bookmarks; Broadsides; Certificates; Clippings; Invitations; Menus; Military orders; New Year addresses; Press releases; Proclamations; Programs; Schedules)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ephemera: From the Greek ephemeron, meaning \"something short-lived.\" The printed materials of everyday life, generally regarded as having little or no permanent value because they are produced in large quantities or in disposable formats for a specific limited use. The category includes ballots, baseball cards, bookmarks, broadsides, bumper stickers, comic books, coupons, decals, fliers, greeting cards, invitations, lapel buttons, leaflets, menus, pamphlets, paper toys, performance programs, playbills, postage stamps, postcards, tickets, visiting cards, etc. Ephemeral items are sometimes retained and exhibited for their graphic qualities or for their association with a specific person, event, or activity. Also refers to material of brief currency that has reference value or sufficient literary or historical importance to merit permanent archival storage, for example, academic course catalogs and schedules, newsletters, staff directories, etc.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 42 (ephemera: printed or written items produced for short-time use)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ephemera (general). Items created, manufactured, or used for a specific, limited use, and usually intended to be discarded thereafter; printed ephemera. Printed works that are created to meet an array of immediate needs, usually transitory in nature not intended to be saved. Examples cold be broadsides, posters, leaflets, pamphlets, programs, postcards, tradecards, labels, tickets, handbills, sale notices, and valentines.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ephemeral materials"}}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ephemeral materials"}}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ephemeral items"}}, {"@id": "_:n087a4b1fb82840249c9ae080a6ee3f1bb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ephemeral items"}}], "@id": "/authorities/genreForms/gf2014026093"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026094", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEssays", "identifiers:lccn": "gf2014026094", "madsrdf:adminMetadata": [{"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db1"}, {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Essays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026074"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db5"}, {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db6"}, {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db7"}], "madsrdf:hasVariant": {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Essays"}}, {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Essays. BT Literary forms (Gathering term; do not assign))"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(essay: A short literary composition written in expository prose addressed to the general reader, usually dealing thoughtfully and in some depth with a single theme, seen from the personal point of view of the essayist who does not necessarily attempt the systematic or comprehensive analysis one would expect in a dissertation or treatise. There are no limitations on style or content--essays can be formal or informal, descriptive, narrative, persuasive, humorous, satirical, historical, biographical, autobiographical, or critical.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 42 (essay: short prose composition; first draft; essayette: short essay)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Essayettes"}}, {"@id": "_:nab3cc17d588840bb8f396bdac58a8a3db9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Essayettes"}}], "@id": "/authorities/genreForms/gf2014026094"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026095", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEulogies", "identifiers:lccn": "gf2014026095", "madsrdf:adminMetadata": [{"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb1"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Eulogies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026064"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026113"}], "madsrdf:hasSource": [{"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb5"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb6"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb7"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb8"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb9"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb10"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb11"}], "madsrdf:hasVariant": [{"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb12"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb15"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb18"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb21"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb24"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb27"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb30"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb33"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-14T12:45:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Eulogies"}}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(eulogy: A written or spoken composition in praise of someone or something, especially a person who is deceased. Synonymous with encomium.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (funeral orations for Keroullarios, Leichoudes, and Xiphilinos) partial contents (Funeral oration for the most blessed patriarch Kyr Michael Keroullarios -- Funeral oration for the most holy patriarch Kyr Konstantinos Leichoudes -- Funeral oration for the most blessed patriarch Kyr Ioannes Xiphilinos)"}, "madsrdf:citationSource": "Work cat.: Psellus, M. Psellos and the patriarchs, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ziolkowski, J.E. Thucydides and the tradition of funeral speeches at Athens, 1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 43 (eulogy: speech, writing in praise of (dead) person)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Eulogies. UF Encomia. BT Commemorative works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(eulogies. Laudatory speeches or written tributes.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(eulogy (plural eulogies) 1. An oration to honor a deceased person, usually at a funeral. 2. Speaking highly of someone; the act of praising or commending someone. Synonyms: panegyric; panegyric (plural panegyrics): A formal speech or opus publicly praising someone or something. Alternate form: panegyrick (obsolete); encomium (plural encomiums or encomia))"}, "madsrdf:citationSource": "Wiktionary, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Encomia"}}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Encomia"}}, {"@id": "_:n022ef6cd68b147e6ab453827d38b3d8cb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n022ef6cd68b147e6ab453827d38