cordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ragga (Music)"}}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ragga, raggamuffin music, ragamuffin; \"ragamuffin\" raps; a combination of reggae and rap; ragga music is Jamaican rap)"}, "madsrdf:citationSource": "Newspaper abstracts", "madsrdf:citationStatus": "found"}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the best of reggae dancehall music)"}, "madsrdf:citationSource": "EPL's collection: UB40 present the dancehall album [SR] p1198; Dancehall crazy [SR] p1999; Dancehall explosion '98 [SR] p 1999; Jah Screw presents dancehall glamity [SR] p 1993; Dancehall hits [SR] p1999; Dancehall stylee [SR]", "madsrdf:citationStatus": "found"}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ragga, raggamuffin, ragamuffin)"}, "madsrdf:citationSource": "LC database, May 7, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Random House;Am. Heritage dict., c1992;Oxf. dict. of new words, 1991;BDNE;Amerigrove", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ragga, ragamuffin; ragamuffin hip hop, ragga hip hop)"}, "madsrdf:citationSource": "Periodical abstracts", "madsrdf:citationStatus": "found"}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(raggamuffin; also ragamuffin or ragga; an example of the influence of rap on Jamaican music; considered a particular style of reggae; developed in the 1980s and 1990s; characterized by the adoption of sound processing techniques, music, and texts of rap)"}, "madsrdf:citationSource": "Work cat.: 97119078: Plastino, G. Mappa delle voci, c1996", "madsrdf:citationStatus": "found"}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ragga)"}, "madsrdf:citationSource": "Readers' guide abstracts", "madsrdf:citationStatus": "found"}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dancehall developed in the '80s as \"ragamuffin\", a hybrid style featuring a DJ or \"sing-jay\" half-singing, half-rapping with often bawdy (\"slack\") themes. The musical structure is rooted in reggae though the rhythms, played by drum machines, are considerably faster. By the '90s, dancehall crossover was common, with many gangsta-rappers incorporating dancehall rhythms and its rapid-fire toasting. Major dancehall figures include Yellowman and Shabba Ranks.)"}, "madsrdf:citationSource": "All Music Guide, online, Mar. 29, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n73880e66f04248ed81cabcf6cb182044b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Raggamuffin (Music)"}}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Raggamuffin (Music)"}}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n73880e66f04248ed81cabcf6cb182044b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ragamuffin (Music)"}}, {"@id": "_:n73880e66f04248ed81cabcf6cb182044b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ragamuffin (Music)"}}], "@id": "/authorities/genreForms/gf2014027033"}
