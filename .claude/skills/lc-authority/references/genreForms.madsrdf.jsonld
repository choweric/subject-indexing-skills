"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b11"}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b14"}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b17"}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b20"}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b23"}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025004"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-09T08:52:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fiction films"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fictional film; UF dramatic-narrative film, fiction film, fictive film; the fictional film -- film drama, film play, screen drama, screenplay, or story film as it has sometimes been called -- is a film in which actors perform in front of a camera to create fictitious situations or tell an invented story with the purpose of showing it to an audience; hence the terms entertainment film, theatrical film, and feature film have also been used with analogous meaning; fictional film or fiction film stands in opposition to factual or documentary film)"}, "madsrdf:citationSource": "Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(narrative film. Any film that tells a story; also called a fiction film, a dramatic film, a theatrical film, and a feature film. Though a number of documentaries have a simple narrative line embedded within them and some seem to tell stories, the term \"narrative film\" applies to those works that emphasize the story line, are dramatic in nature, and are fictional.)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dictionary, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fiction: use for films and programs portraying imaginary characters and events)"}, "madsrdf:citationSource": "Yee, M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Entertainment films"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Entertainment films"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Film dramas"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film dramas"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramatic-narrative films"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramatic-narrative films"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fictive films"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fictive films"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Narrative films"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Narrative films"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fictional films"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fictional films"}}, {"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6fe2f9c70244ada9a2c7cce69c1a033b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramatic films"}}, {"@id": "_:nd6fe