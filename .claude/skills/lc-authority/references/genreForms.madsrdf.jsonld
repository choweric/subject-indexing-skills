ote": {"@language": "en", "@value": "(Dance--Reviews. Here are entered collections of dance reviews.)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n384f0ffbe5fb48a3b62f9422e94455c4b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Jowitt, D. The dance in mind : profiles and reviews 1976-83, 1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:n384f0ffbe5fb48a3b62f9422e94455c4b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Parker, H.T. Motion arrested : dance reviews of H.T. Parker, c1982.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026079"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026080", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aData dictionaries", "identifiers:lccn": "gf2014026080", "madsrdf:adminMetadata": [{"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b1"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Data dictionaries"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026109"}, "madsrdf:hasSource": [{"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b5"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b6"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b7"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b8"}], "madsrdf:hasVariant": [{"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b9"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b12"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Collections of metadata describing the contents, format, and structure of a database and the relationship between its elements."}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:23:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Data dictionaries"}}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(data dictionary: A repository of information about an organization's application programs, databases, logical data models, users, and authorizations; A grouping of logically related components of a particular syntax type, such as ROD dictionaries, EDI dictionaries, and XML dictionaries; A set of tables that keep track of the structure of both the database and the inventory of database objects.)"}, "madsrdf:citationSource": "IBM dictionary of computing, c1994", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A data dictionary is a collection of descriptions of the data objects or items in a data model for the benefit of programmers and others who need to refer to them.)"}, "madsrdf:citationSource": "TechTarget SearchSOA website, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(data dictionary. Also called: data directory. An index of data held in a database and used to assist in the access to data)"}, "madsrdf:citationSource": "Dictionary.com, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(data dictionary <database> A data structure that stores metadata, i.e. data about data. The term \"data dictionary\" has several uses. Most generally it is a set of data descriptions that can be shared by several applications. Usually it means a table in a database that stores the names, field types, length, and other characteristics of the fields in the database tables. An active data dictionary is automatically updated as changes occur in the database. A passive data dictionary must be manually updated. The data dictionary may maintain information on system hardware, software, documentation, users, and other aspects. Data dictionaries are also used to document the database design process itself and can accumulate metadata ready to feed into the system catalog.)"}, "madsrdf:citationSource": "FOLDOC : free on-line dictionary of computing, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Data directories"}}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Data directories"}}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dictionaries, Data"}}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dictionaries, Data"}}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Directories, Data"}}, {"@id": "_:n9a4bf84800704cf7a2b0e2a6d3984e71b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Directories, Data"}}], "@id": "/authorities/genreForms/gf2014026080"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026081", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDatabases", "identifiers:lccn": "gf2014026081", "madsrdf:adminMetadata": [{"@id": "_:ne315c64753e54d1f8705080c2db06c29b1"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Databases"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne315c64753e54d1f8705080c2db06c29b3"}]}, "madsrdf:exampleNote": "Note under [Data sets]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026293"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026015"}], "madsrdf:hasSource": [{"@id": "_:ne315c64753e54d1f8705080c2db06c29b5"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b6"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b7"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b8"}], "madsrdf:hasVariant": [{"@id": "_:ne315c64753e54d1f8705080c2db06c29b9"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b12"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Electronic systems that allow data to be easily accessed, manipulated, and updated. For collections of similar or related data that are usually assembled as a matter of record or for research see [Data sets.]"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-04-09T11:07:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Databases"}}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A database (DB), in the most general sense, is an organized collection of data. More specifically, a database is an electronic system that allows data to be easily accessed, manipulated and updated. In other words, a database is used by an organization as a method of storing, managing and retrieving information)"}, "madsrdf:citationSource": "Techopedia, viewed March 18, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(database: A large, regularly updated file of digitized information (bibliographic records, abstracts, full-text documents, directory entries, images, statistics, etc.) related to a specific subject or field, consisting of records of uniform format organized for ease and speed of search and retrieval and managed with the aid of database management system (DBMS) software. Compare with data bank; data bank: Sometimes used synonymously with database, the term applies more specifically to a collection of nonbibliographic data, usually numeric (example: Child Trends DataBank).)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(databases. UF data bases; databanks. Structured sets of data held in computer storage, especially those that incorporate software to make them accessible in a variety of ways. A database is used to store, query, and retrieve information, typically comprising a logical collection of interrelated information that is managed as a unit, stored in machine-readable form, and organized and structured as records that are presented in a standardized format in order to allow rapid search and retrieval by a computer.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 37 (databank: repository of data accessible by many users)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne315c64753e54d1f8705080c2db06c29b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Data banks"}}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Data banks"}}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne315c64753e54d1f8705080c2db06c29b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Data bases"}}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Data bases"}}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne315c64753e54d1f8705080c2db06c29b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Databanks"}}, {"@id": "_:ne315c64753e54d1f8705080c2db06c29b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Databanks"}}], "@id": "/authorities/genreForms/gf2014026081"}
