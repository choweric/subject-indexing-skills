{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026112", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aParanormal television programs", "identifiers:lccn": "gf2017026112", "madsrdf:adminMetadata": [{"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b1"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Paranormal television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026299"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026308"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026717"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026734"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026001"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026057"}], "madsrdf:hasSource": [{"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b5"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b6"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b7"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b8"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b9"}], "madsrdf:hasVariant": [{"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b10"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b13"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that feature human characters that are often involved with the occult, witchcraft, spiritualism, psychic phenomena, vodou, etc., and interact with supernatural beings."}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-09-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-05T13:53:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paranormal television programs"}}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "summary (the series is centered around Elena Michaels, the world's only female werewolf... in season two Elena and the Pack team up with a Coven of witches to fight against a mysterious foe determined to claim dominion over the Otherworld)"}, "madsrdf:citationSource": "Work cat.: 2017603318: Bitten, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 3 (Paranormal researcher Sharon Hill maintains a list of paranormal television shows and their premiere dates at her website. Of the 231 shows listed in 2015, 101 of them premiered since the first edition of this book in 2010)"}, "madsrdf:citationSource": "Bader, Christopher. Paranormal America, 2017 via Google books, viewed September 22, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 247 (As of 2015, paranormal television shows about ghosts have become so popular that they are the dominant type of this subgenre...Paranormal television series have been made for non-English speaking markets as well)"}, "madsrdf:citationSource": "Ghosts in popular culture and legend, 2016, via Google books, viewed September 22, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "A Person could develop occult, Oct. 14, 2007 (There must be a rational explanation for all the supernatural phenomena on television. ... so many shows this season prey on the paranormal ... Because there are, after all, an unnatural number of supernatural series at the moment)"}, "madsrdf:citationSource": "New York Times WWW site, viewed September 22, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(top 10 supernatural tv shows)"}, "madsrdf:citationSource": "Sundance WWW site, viewed September 22, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supernatural television programs"}}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supernatural television programs"}}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Occult television programs"}}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Occult television programs"}}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supernaturalist television programs"}}, {"@id": "_:n4c084e0bf13642e3a423dda9e91252b5b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supernaturalist television programs"}}], "@id": "/authorities/genreForms/gf2017026112"}
