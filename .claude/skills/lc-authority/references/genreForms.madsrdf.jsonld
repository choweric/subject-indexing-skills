{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026260", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFilm serials", "identifiers:lccn": "gf2011026260", "madsrdf:adminMetadata": [{"@id": "_:n6203d8e029664b25b96646423e21c3f6b1"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Film serials"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6203d8e029664b25b96646423e21c3f6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n6203d8e029664b25b96646423e21c3f6b5"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b6"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b7"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b8"}], "madsrdf:hasVariant": [{"@id": "_:n6203d8e029664b25b96646423e21c3f6b9"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b12"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b15"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b18"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that were shown in weekly installments and usually featured cliffhanger endings.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025625"}}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T13:59:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film serials"}}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(serial (chapterplay, cliffhanger, episode film): Serials are action-adventure pictures or melodramas made strictly for their entertainment value with scarce dialogue and plenty of action. They were ideally suited for children and the Saturday matin\u00e9e at the local movie house. They were meant to be shown in weekly installments or chapters)"}, "madsrdf:citationSource": "Films by genre, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(film serials: 16,400 hits; serial films: 9,500 hits)"}, "madsrdf:citationSource": "Google, June 13, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(serial: A multi-episode film chronicling the thrilling, action-filled exploits of characters, lasting a certain number of chapters, usually around fifteen episodes, of about twenty minutes duration apiece. Typically uses the \"cliffhanger\" ending to lure audiences to the next chapter of the work. Most often utilizes such genres as Western, Science fiction, Jungle, Adventure, Espionage, and Crime, and frequently loosely combines aspects of many formulas in a free- flowing manner endemic to the serial form)"}, "madsrdf:citationSource": "Moving image genre form guide via WWW, June 13, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(serials: use for a progrm or film in a number of episodes or parts which has a story line which continues from one episode or part to the next; UF Moving-picture serials; RT Made-for-TV movies, Mini-series, Sequels, Series)"}, "madsrdf:citationSource": "Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6203d8e029664b25b96646423e21c3f6b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cliffhanger films"}}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cliffhanger films"}}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6203d8e029664b25b96646423e21c3f6b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Episode films"}}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Episode films"}}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6203d8e029664b25b96646423e21c3f6b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Serials, Film"}}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serials, Film"}}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6203d8e029664b25b96646423e21c3f6b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chapterplay films"}}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chapterplay films"}}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6203d8e029664b25b96646423e21c3f6b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Serial films"}}, {"@id": "_:n6203d8e029664b25b96646423e21c3f6b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serial films"}}], "@id": "/authorities/genreForms/gf2011026260"}
