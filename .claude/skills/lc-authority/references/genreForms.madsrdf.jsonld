{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026004", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAbstract films", "identifiers:lccn": "gf2011026004", "madsrdf:adminMetadata": [{"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb1"}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Abstract films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026235"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026049"}, "madsrdf:hasSource": [{"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb5"}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb6"}], "madsrdf:hasVariant": [{"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb7"}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb10"}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb13"}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb16"}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Nonrepresentational films that avoid narrative and instead convey impressions and emotions by way of color, rhythm and movement.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025611"}}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T14:25:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Abstract films"}}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Abstract live action: work that fragments or otherwise presents live objects so they appear to be abstract; Abstract animation: type of animation without narrative, concentrating on abstract visuals)"}, "madsrdf:citationSource": "Moving image genre-form guide online, June 4, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (Abstract films; Concrete films; Nonobjective films: abstract films avoid narrative and instead convey sensitive impressions and emotions by way of color, rhythm and movement...They include animated films consisting of drawings, splashes of color, lines and shapes...computer films...abstraction [is] also achieved by working on the film itself by scratching, drawing, or painting on its surface. Abstract films are also made by photographing objects in the usual manner...also refers to any nonrepresentational film)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nonrepresentational films"}}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonrepresentational films"}}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Concrete films"}}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Concrete films"}}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Abstract live action films"}}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Abstract live action films"}}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Abstract animation films"}}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Abstract animation films"}}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nonobjective films"}}, {"@id": "_:n9314ad1e5cc7432ca700237a6be2f86fb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonobjective films"}}], "@id": "/authorities/genreForms/gf2011026004"}
