"_:nf8f65480eb964ee7b6afb16d181686e0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Raster data"}}, {"@id": "_:nf8f65480eb964ee7b6afb16d181686e0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "raster (The regular pattern of lines traced by a moving beam such as the beam of a cathode-ray rube (CRT) to provide substantially uniform coverage of a region on the screen. ... These are used principally by radars)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8f65480eb964ee7b6afb16d181686e0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Maps--Digital--Raster: Digital maps stored as pixel (picture-element) data in rows and columns)"}, "madsrdf:citationSource": "Form/genre for cartographic materials [draft of LC working group], 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8f65480eb964ee7b6afb16d181686e0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (raster data: Data that are based on a cellular grid structure composed of rows and columns (a raster). Each grid cell or pixel is referenced by an x, y coordinate and is stored as an identifier to which additional attributes may be attached. Groups of cells with the same value represent map features. see also Vector data)"}, "madsrdf:citationSource": "Cartographic materials, 2002, 2005 update via Cataloger's Desktop March 26, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8f65480eb964ee7b6afb16d181686e0b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf8f65480eb964ee7b6afb16d181686e0b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Raster maps"}}, {"@id": "_:nf8f65480eb964ee7b6afb16d181686e0b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Raster maps"}}], "@id": "/authorities/genreForms/gf2011026520"}
