{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026241", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFantasy comedies (Television programs)", "identifiers:lccn": "gf2011026241", "madsrdf:adminMetadata": [{"@id": "_:nb2c862bb5a664e71920b199e594d9860b1"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fantasy comedies (Television programs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb2c862bb5a664e71920b199e594d9860b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026244"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026654"}], "madsrdf:hasSource": [{"@id": "_:nb2c862bb5a664e71920b199e594d9860b5"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b6"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b7"}], "madsrdf:hasVariant": [{"@id": "_:nb2c862bb5a664e71920b199e594d9860b8"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b11"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b14"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b17"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that feature benevolent intervention by mythological or supernatural beings with comic results, or that feature incredible inventions or machines having a mind of their own.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025326"}}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T13:46:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantasy comedies (Television programs)"}}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy-comedy; Comedy fantasy; Fantastic comedy. These films usually show playful devils, ghosts (see Ghost comedies), angels, or God interfering with the absurd lives of mortals. Other fantasy comedies deal with incredible inventions or with machines having a mind of their own.)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Charmed. When bad Warlocks go good, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 48 (Fantasy comedies; use for fictional genre films and programs which depict benevolent supernatural intervention in the modern world by characters such as angels, benevolent ghosts or witches, or the Devil in his more amiable incarnations. UF: Comedy fantasy; Fantastic comedies; Ghost comedies and romances; Heavenly comedies)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2c862bb5a664e71920b199e594d9860b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "ma