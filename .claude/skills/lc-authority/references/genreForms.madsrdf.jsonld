{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026727", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVox pop radio programs", "identifiers:lccn": "gf2011026727", "madsrdf:adminMetadata": [{"@id": "_:n711ae3d4616a4b769b10b9e66150f132b1"}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Vox pop radio programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n711ae3d4616a4b769b10b9e66150f132b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b5"}, "madsrdf:hasSource": [{"@id": "_:n711ae3d4616a4b769b10b9e66150f132b8"}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b9"}], "madsrdf:hasVariant": [{"@id": "_:n711ae3d4616a4b769b10b9e66150f132b10"}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025631"}}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-19T07:40:07"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vox pop radio programs"}}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b5", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Radio interviews"}, "madsrdf:elementList": {"@list": [{"@id": "_:n711ae3d4616a4b769b10b9e66150f132b6"}]}}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio interviews"}}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Vox pop: SN Impromptu interviews with randomly chosen people in which opinions are elicited on a particular issue or event; usually conducted outside the studio; UF Man on the street interviews UF Vox populi)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Dec. 6, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Vox populi, a Latin phrase that literally means voice of the people, is a term often used in broadcasting for interviews fo members of the \"general public\" ... Usually the interviewees are shown in pubic places, and supposed to be giving spontaneous opinions in a chance encounter -- unrehearsed persons, not selected in any way. As such, broadcast journalists almost always refer to them as the abbreviated vox pop. In U.S. broadcast journalism it is often referred to as a man on the street interview)"}, "madsrdf:citationSource": "Wikipedia, via WWW, Dec. 6, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n711ae3d4616a4b769b10b9e66150f132b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Man-on-the-street interviews (Radio programs)"}}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Man-on-the-street interviews (Radio programs)"}}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n711ae3d4616a4b769b10b9e66150f132b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vox populi radio programs"}}, {"@id": "_:n711ae3d4616a4b769b10b9e66150f132b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vox populi radio programs"}}], "@id": "/authorities/genreForms/gf2011026727"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026728", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWall maps", "identifiers:lccn": "gf2011026728", "madsrdf:adminMetadata": [{"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb1"}, {"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Wall maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb5"}, {"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb6"}, {"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025044"}}, {"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-19T07:39:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wall maps"}}, {"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "wall map (a special-purpose map of a large area designed to be displayed on a wall)"}, "madsrdf:citationSource": "Glossary of mapping, charting,and geodetic terms, 1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Glossary of the mapping sciences, 1994", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n8d7184b8b681484a9167e1d1afbd9e1cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Maps--Wall (A map designed to be mounted or displayed on a wall, generally has devices on map to assist in hanging)"}, "madsrdf:citationSource": "Form/genre for cartographic materials [draft of LC working group], 1996:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026728"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026729", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWar films", "identifiers:lccn": "gf2011026729", "madsrdf:adminMetadata": [{"@id": "_:n106c6bb2b45e4469b6948569da999482b1"}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "War films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n106c6bb2b45e4469b6948569da999482b3"}]}, "madsrdf:exampleNote": "Note under [Military films]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n106c6bb2b45e4469b6948569da999482b5"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026620"}, "madsrdf:hasSource": [{"@id": "_:n106c6bb2b45e4469b6948569da999482b8"}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b9"}], "madsrdf:hasVariant": [{"@id": "_:n106c6bb2b45e4469b6948569da999482b10"}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b13"}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b16"}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature military conflicts. For films that feature the military lifestyle and loyalty to the armed forces and its codes and are generally set during peacetime see [Military films.]", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026053"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025374"}]}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-04T16:51:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "War films"}}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n106c6bb2b45e4469b6948569da999482b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anti-war films"}}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anti-war films"}}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(category under War Film: Pacifist Films (Antiwar Films). Fewer in number than the pro-war films, they nevertheless have been around since the beginning of the war movie. Examples: All Quiet on the Western Front (1930); Broken Lullaby (1932); The Road to Glory (1936); The Steel Helmet (1951); Paths of Glory (1957); Hell is for Heroes (1961))"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(war: 1. Fictional work portraying military conflicts ... Includes not only portrayals of combat, but stories set in POW camps, accounts of the homefront, and depictions of the difficulties of demobilization and the veteran returning to civilian life. The genre includes depictions of the primary fronts during the war, as well as the battles on the geographical margins of the conflict; stories taking place in the military milieu in peacetime go under Military; used for: combat; 2. Nonfiction work made to explain a war to servicemen and civilian viewers as well as retrospective documentaries on specific battles and other historical events of various wars)"}, "madsrdf:citationSource": "Moving image genre-form guide online, April 27, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n106c6bb2b45e4469b6948569da999482b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Combat films"}}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Combat films"}}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n106c6bb2b45e4469b6948569da999482b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anti-war films"}}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anti-war films"}}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n106c6bb2b45e4469b6948569da999482b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pacifist films"}}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pacifist films"}}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n106c6bb2b45e4469b6948569da999482b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Antiwar films"}}, {"@id": "_:n106c6bb2b45e4469b6948569da999482b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Antiwar films"}}], "@id": "/authorities/genreForms/gf2011026729"}
