nt"], "madsrdf:elementList": {"@list": [{"@id": "_:na8d0b2ba3aa240438bfa6e448f8d4fdbb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Homilies"}}, {"@id": "_:na8d0b2ba3aa240438bfa6e448f8d4fdbb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Homilies"}}, {"@id": "_:na8d0b2ba3aa240438bfa6e448f8d4fdbb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na8d0b2ba3aa240438bfa6e448f8d4fdbb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Postils"}}, {"@id": "_:na8d0b2ba3aa240438bfa6e448f8d4fdbb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Postils"}}], "@id": "/authorities/genreForms/gf2015026051"}
