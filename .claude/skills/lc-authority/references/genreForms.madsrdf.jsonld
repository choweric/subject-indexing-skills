age": "en", "@value": "Passepieds (Music)"}}, {"@id": "_:n6e2f3b4d236049f19729a980c9af566cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(also passe-pied, paspy, passe-pi\u00e9)"}, "madsrdf:citationSource": "New Grove dict. of mus. online, Jan. 24, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e2f3b4d236049f19729a980c9af566cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a lively, simple Baroque dance in triple meter (often 3/8), a fast type of minuet. It has an upbeat, regular two- or four-measure phrases, and homophonic texture.)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e2f3b4d236049f19729a980c9af566cb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6e2f3b4d236049f19729a980c9af566cb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Passe-pieds (Music)"}}, {"@id": "_:n6e2f3b4d236049f19729a980c9af566cb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Passe-pieds (Music)"}}, {"@id": "_:n6e2f3b4d236049f19729a980c9af566cb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6e2f3b4d236049f19729a980c9af566cb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Paspys (Music)"}}, {"@id": "_:n6e2f3b4d236049f19729a980c9af566cb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paspys (Music)"}}, {"@id": "_:n6e2f3b4d236049f19729a980c9af566cb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6e2f3b4d236049f19729a980c9af566cb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Passe-pi\u00e9s (Music)"}}, {"@id": "_:n6e2f3b4d236049f19729a980c9af566cb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Passe-pi\u00e9s (Music)"}}], "@id": "/authorities/genreForms/gf2014026991"}
