{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026951", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMouth music", "identifiers:lccn": "gf2014026951", "madsrdf:adminMetadata": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb1"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mouth music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, "madsrdf:hasSource": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb5"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb6"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb7"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb8"}], "madsrdf:hasVariant": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb9"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb12"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb15"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb18"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb21"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb24"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb27"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb30"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb33"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Vocal folk music in which the singing imitates an instrument, often using meaningless vocables or a mix of vocables and words."}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:50:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mouth music"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Celtic mouth music, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Oxford Companion to Music online, Oct. 13, 2009: (puirt-abeul (Gaelic), mouth music (term used in the folk music of the Scottish Highlands to denote vocal performance to accompany the many different types of Highland dance ... more often performed now as a vocal solo without dance ... mixes meaningless vocables with words ... may involve complex rhythmic patterns not otherwise found in dance); under diddling (Lowland Scottish practice practice similar to the Highland practice of puirt-a-beul)", "madsrdf:citationStatus": "found"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "http://www.rambles.net/va_mouthmusic.html [Rambles cultural arts magazine], Oct. 13, 2009: (Mouth music is known by many different names; cheek music, chin music, lilting, didling, gobbing, reel \u00e0 bouche, port-a-beul)", "madsrdf:citationStatus": "found"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Oct. 13, 2009: Under Scotland/Songs/Gaelic songs (Puirt-a-beul, or mouth music, instrumental dance music set to words). Under Russian Federation/Russian traditional music (pod yaz\u00efk (under the tongue) or rotivushki (from rot., mouth) are performed to a vocal accompaniment which imitates an instrument, similar to mouth-music in Scotland). Under Ireland/Traditional music/Songs and Singing (vocalized dance tunes ... also known as dydeling or in Irish as portaireacht bh\u00e9il, lilting is sometimes performed)", "madsrdf:citationStatus": "found"}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Diddling (Mouth music)"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Diddling (Mouth music)"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gobbing (Mouth music)"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gobbing (Mouth music)"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cheek music"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cheek music"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Port-a-beul"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Port-a-beul"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Puirt-abeul"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puirt-abeul"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chin music"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chin music"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reel \u00e0 bouche"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reel \u00e0 bouche"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n097c3fe414c844e280c3833c811736dfb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lilting (Mouth music)"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lilting (Mouth music)"}}, {"@id": "_:n097c3fe414c844e280c3833c811736dfb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id"