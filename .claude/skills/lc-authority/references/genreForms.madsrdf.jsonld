f:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Basketball television programs"}}, {"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Basketball television programs"}}, {"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb23", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 301 ([Doug] \"Ring's significant later career in Melbourne, as a cricket administrator and as a presenter on a commercial television sporting program\")"}, "madsrdf:citationSource": "Starck, Nigel. Writes of passage, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb24", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Trans World Sport (a sports-orientated television program produced by IMG Media in London, England; the world's longest running weekly international television sports program)"}, "madsrdf:citationSource": "Wikipedia, Aug. 16, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb25", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sports: fictional work concentrating on how an individual athlete or team, through strength, training, agility, and-or tactics, compete in the often corrupt world of sports. Sports (Nonfiction) Nonfiction work covering sporting events, such as a boxing match, wrestling, or a football game; the work may include the event itself, retrospective highlights, interviews with players, and commentary. Standard recurring events covered include the Olympics, Super Bowl, and World Series)"}, "madsrdf:citationSource": "Moving image genre-form guide online, Aug. 9, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb26", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Olympia, 1938.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb27", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 92-93 (Sports films and programs: use for fictional genre films and programs with focus on protagonists involved in competitive sports. Sports event coverage and commentary: use for nonfiction coverage of and/or commentary on sports events)"}, "madsrdf:citationSource": "Yee, Martha M. Moving image materials : genre terms, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb28", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Francisco Jos\u00e9 Carrasco; sports commentator for soccer; sporting television program about football, focused on current affairs of the main teams of the Spanish league)"}, "madsrdf:citationSource": "El Lobo Carrasco, who is known by this curious pseudonym?, via LaInformaci\u00f3n.com website, Aug. 16, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Golf television programs"}}, {"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Golf television programs"}}, {"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Basketball television programs"}}, {"@id": "_:nf09543fb6f07429fbb1d9a13a12be82eb33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Basketball television programs"}}, {"@id": "_:nf09543fb6f07429