{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026434", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOutline maps", "identifiers:lccn": "gf2011026434", "madsrdf:adminMetadata": [{"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b1"}, {"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Outline maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b5"}, {"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b6"}], "madsrdf:hasVariant": {"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025079"}}, {"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T13:23:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Outline maps"}}, {"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "outline map (A map showing just enough geographic information to permit the correct placement of additional details.  Outline maps correspond to what were at one time known as base maps; they usually show only cast lines, principal rivers, major civil boundaries, and large cities.  As much space as possible is left for placing the particular details or data desired.  An outline map presents less detail than what is now known as a base map) base map (1. A map on which information can be placed for comparison or geographic correlation. The term base map was at one time applied to a class of maps now known as outline maps. It may be applied to topographical maps which are used in the construction of many special types of maps by adding particular data; 2. A map from which other maps are prepared by adding information. In particular, a planimetric map used in preparing topographic maps)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Outline maps; subdivision --Maps, Outline and base)"}, "madsrdf:citationSource": "LCSH, Dec. 7, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Base maps"}}, {"@id": "_:ndaddb9aa0d914397a11044d3c145ccf8b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Base maps"}}], "@id": "/authorities/genreForms/gf2011026434"}
