{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2013025048", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEphemerides", "identifiers:lccn": "gf2013025048", "madsrdf:adminMetadata": [{"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb1"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ephemerides"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026113"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb5"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb6"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb7"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb8"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb9"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb10"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb11"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2013-06-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T11:33:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ephemerides"}}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Kendal, R. Ephemeris absoluta, or, A compleat diary of the c\u00e6lestial motions, 1700.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In astronomy and celestial navigation, an ephemeris (plural: ephemerides; from the Greek word eph\u0113meris \"diary\", \"journal\") gives the positions of astronomical objects in the sky at a given time or times. Historically, positions were given as printed tables of values, given at regular intervals of date and time. Modern ephemerides are often computed electronically from mathematical models of the motion of astronomical objects and the earth. Even though the calculation of these tables was one of the first applications of mechanical computers, printed ephemerides are still produced, as they are useful when computational devices are not available. The astronomical position calculated from an ephemeris is given in the spherical polar coordinate system of right ascension and declination. Some of the astronomical phenomena of interest to astronomers are eclipses, apparent retrograde motion/planetary stations, planetary ingresses, sidereal time, positions for the mean and true nodes of the moon, the phases of the Moon, and the position(s) of Chiron and other minor celestial bodies. Ephemerides are used in celestial navigation, astronomy and astrology. Astrologers typically have different needs than astronomers, for example, the calculation of astrological aspects, and may produce ephemerides specialized to their own field.)"}, "madsrdf:citationSource": "Wikipedia, June 20, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ephemeris plural ephemerides: a tabular statement of the assigned places of a celestial body for regular intervals. Table of the positions of celestial bodies at regular intervals, often with supplementary information. Constructed as early as the 4th century BC, ephemerides are still essential to astronomers and navigators. Modern ephemerides are calculated, with heavy computing and careful checking, after a mathematical description of a heavenly body's observed motion has been evolved. Various national ephemerides are published regularly; the U.S. ephemeris, first published in 1852, became the best and is now published jointly with the U.K. as The Astronomical Almanac.)"}, "madsrdf:citationSource": "Merriam-Webster online, June 20, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ephemeris noun (plural ephemerides) Astronomy & Astrology. a table or data file giving the calculated positions of a celestial object at regular intervals throughout a period. a book or set of such tables or files.)"}, "madsrdf:citationSource": "Oxford dictionaries website, June 20, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ephemeris noun, plural ephemerides. 1. a table showing the positions of a heavenly body on a number of dates in a regular sequence. 2. an astronomical almanac containing such tables. 3. Archaic. an almanac or calendar.)"}, "madsrdf:citationSource": "Dictionary.com, June 20, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Tanner, J. Angelus Britannicus: an ephemeris for the year of our redemption 1664, 1664.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Culpeper, N. An ephemeris for the year 1654, being the second after leap-year, 1654.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e61fe303eb94056a1f82b2ec72d9f2fb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lahiri's Indian ephemeris of planets' positions according to the 'Naryana' or Indian system for ... 1976.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2013025048"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2013025051", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFilmed baseball games", "identifiers:lccn": "gf2013025051", "madsrdf:adminMetadata": [{"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb1"}, {"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Filmed baseball games"}, "madsrdf:elementList": {"@list": [{"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026280"}, "madsrdf:hasSource": [{"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb5"}, {"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb6"}], "madsrdf:hasVariant": {"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-23T16:22:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2013-08-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed baseball games"}}, {"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 00563587: The ball game, 1898.", "madsrdf:citationStatus": "found"}, {"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "American Memory exhibit, America at Work, School, and Leisure, 1894-1915 (Work, school, and leisure activities in the United States from 1894 to 1915; includes films of the United States Postal Service from 1903, cattle breeding, fire fighters, ice manufacturing, logging, calisthenic and gymnastic exercises in schools, amusement parks, boxing, expositions, football, parades, swimming, and other sporting events)"}, "madsrdf:citationSource": "Library of Congress WWW site, viewed Aug. 28, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Baseball games, Filmed"}}, {"@id": "_:n00444ffb657a45d5871f3c992f0c9c5eb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Baseball games, Filmed"}}], "@id": "/authorities/genreForms/gf2013025051"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2013025052", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aResolutions (Law)", "identifiers:lccn": "gf2013025052", "madsrdf:adminMetadata": [{"@id": "_:n4b4a75a68e3c458799fa577985318a88b1"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Resolutions (Law)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4b4a75a68e3c458799fa577985318a88b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026351"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n4b4a75a68e3c458799fa577985318a88b5"}, "madsrdf:hasSource": [{"@id": "_:n4b4a75a68e3c458799fa577985318a88b8"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b9"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b10"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b11"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b12"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b13"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b14"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b15"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b16"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b17"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b18"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b19"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b20"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b21"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b22"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b23"}], "madsrdf:hasVariant": [{"@id": "_:n4b4a75a68e3c458799fa577985318a88b24"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b27"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b30"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b33"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2013-09-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T13:55:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Resolutions (Law)"}}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b4a75a68e3c458799fa577985318a88b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Resolutions (Law materials)"}}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Resolutions (Law materials)"}}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "United Nations resolution (A United Nations resolution (UN resolution) is a formal text adopted by a United Nations (UN) body. Although any UN body can issue resolutions, in practice most resolutions are issued by the Security Council or the General Assembly. Legal status: Most experts consider most General Assembly resolutions to be non-binding. Articles 10 and 14 of the UN Charter refer to General Assembly as \"recommendations\"; the recommendatory nature of General Assembly resolutions has repeatedly been stressed by the International Court of Justice. However, some General Assembly resolutions dealing with matters internal to the United Nations, such as budgetary decisions or instructions to lower-ranking organs, are clearly binding on their addressees. Under Article 25 of the Charter, UN member states are bound to carry out \"decisions of the Security Council in accordance with the present Charter\". Resolutions made under Chapter VII are considered binding, but resolutions under Chapter VI have no enforcement mechanisms and are generally considered to have no binding force under international law. In 1971, however, a majority of the then International Court of Justice (ICJ) members asserted in the non-binding Namibia advisory opinion that all UN Security Council resolutions are legally binding. This assertion by the ICJ has been countered by Erika De Wet and others. De Wet argues that Chapter VI resolutions cannot be binding. ... In practice, the Security Council does not consider its decisions outside Chapter VII to be binding. It has been proposed that a binding triad of conditions--a supermajority of the number of nations voting, whose populations and contributions in dues to the UN budget form a majority of the total--make a General Assembly resolution binding on all nations; the proposal has gone nowhere. Types: resolutions can be classified upon from which organ they originate, e.g.: United Nations General Assembly resolutions; United Nations Security Council resolutions)"}, "madsrdf:citationSource": "Wikipedia, Apr. 29, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(United Nations resolutions are formal expressions of the opinion or will of United Nations organs. They generally consist of two clearly defined sections: a preamble and an operative part. The preamble generally presents the considerations on the basis of which action is taken, an opinion expressed or a directive given. The operative part states the opinion of the organ or the action to be taken.)"}, "madsrdf:citationSource": "Security Council resolutions website, June 20, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ch\u014fng, In-s\u014fp. Korean questions in the United Nations : resolutions adopted at the principal organs of the United Nations with annotations, 1946-2001, c2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "United Nations. Security Council. Resolutions and decisions of the Security Council, 2009/2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, t.p. (Certified texts of the resolutions)"}, "madsrdf:citationSource": "Organization of American States. General Assembly. Regular Session (6th: 1976: Santiago, Chile). Proceedings, 1976:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "International Finance Corporation. Board of Governors. Resolutions, 1960-", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2001336539: Organization of American States. General Assembly. List of resolutions and declarations approved by the General Assembly in its regular and special sessions, 1970-1999, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Documents > Declarations and resolutions (separate links for General Assembly and Permanent Council declarations and resolutions)"}, "madsrdf:citationSource": "Organization of American States website, June 20, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Resolution (law) (A resolution is a written motion adopted by a deliberative body. The substance of the resolution can be anything that can normally be proposed as a motion. For long or important motions, though, it is often better to have them written out so that discussion is easier or so that it can be distributed outside of the body after its adoption. An alternate term for a resolution is a resolve. Resolutions are commonly used in corporations and houses of legislature. ... In corporations, a written resolution is especially useful in the case of the board of directors of a corporation, which usually needs to give its consent to real estate purchases or sales by the corporation. ... Houses of a legislature often adopt non-binding resolutions. However, a legislature also uses resolutions to exercise one of its binding powers that isn't a lawmaking power. For example, the United States Congress declares war or proposes constitutional amendments by adopting a joint resolution. A house of a legislature can also use a resolution to exercise its specific powers, as the British House of Commons does to elect its Speaker or as the United States House of Representatives does to impeach an officer of the government.)"}, "madsrdf:citationSource": "Wikipedia, Sept. 9, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Corporate resolution (A corporate resolution is a corporate action, sometimes in the form of a legal document, that will be voted on or has been voted on at a meeting of the board of directors for a corporation. The resolution could also be in the form of a \"corporate action\" which has the same binding effect as an action taken at a duly called meeting. For a corporate action, if allowed by state law and by the bylaws of the corporation, the board of directors may use a written document to waive formal notice of a meeting and unanimously consent to a resolution.)"}, "madsrdf:citationSource": "Wikipedia, Sept. 9, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b18", "@type": "madsrdf:Source", "madsrdf:citationSource": "Resolutions adopted by the United Nations General Assembly, the Economic and Social Council and the Economic Commission for Latin America, 1975.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b19", "@type": "madsrdf:Source", "madsrdf:citationSource": "Board of Trade Clearing Corporation (Wilmington, Del.). Charter, by-laws, and permanent resolutions of Board of Trade Clearing Corporation with amendments to June 1, 1933, 1933.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b20", "@type": "madsrdf:Source", "madsrdf:citationSource": "Salem Mill Dam Corporation. Report and resolutions of the directors of the Salem Mill-Dam Corporation presented Oct. 5, 1826, 1826?", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b21", "@type": "madsrdf:Source", "madsrdf:citationSource": "United Nations. General Assembly. Resolutions adopted by the General Assembly, 1950-1976.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b22", "@type": "madsrdf:Source", "madsrdf:citationSource": "Organization of American States. General Assembly. Resolutions adopted by the General Assembly at its twenty-seventh regular session, 1997?", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b23", "@type": "madsrdf:Source", "madsrdf:citationSource": "Drummond, I. Corporate resolutions, 1948.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b4a75a68e3c458799fa577985318a88b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Declarations (Law)"}}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Declarations (Law)"}}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b4a75a68e3c458799fa577985318a88b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Resolutions (Law materials)"}}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Resolutions (Law materials)"}}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b4a75a68e3c458799fa577985318a88b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Legislative resolutions"}}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legislative resolutions"}}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b4a75a68e3c458799fa577985318a88b34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Resolves (Law)"}}, {"@id": "_:n4b4a75a68e3c458799fa577985318a88b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Resolves (Law)"}}], "@id": "/authorities/genreForms/gf2013025052"}
