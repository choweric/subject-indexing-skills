", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n3924fbf6a0b64f3280c079f0ea841532b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vampire television programs"}}, {"@id": "_:n3924fbf6a0b64f3280c079f0ea841532b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3924fbf6a0b64f3280c079f0ea841532b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dracula television programs"}}, {"@id": "_:n3924fbf6a0b64f3280c079f0ea841532b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dracula television programs"}}, {"@id": "_:n3924fbf6a0b64f3280c079f0ea841532b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Buffy, the vampire slayer. Dead man's party, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3924fbf6a0b64f3280c079f0ea841532b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dracula in popular culture entry: More than 1,000 novels have been written about Dracula or vampires along with a plethora of cartoons, comics, and television programs)"}, "madsrdf:citationSource": "Wikipedia website, October 22, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n3924fbf6a0b64f3280c079f0ea841532b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 101 (Vampire films and programs: use for fictional genre films and programs which focus on vampires, i.e., the living dead, who subsist on human blood)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3924fbf6a0b64f3280c079f0ea841532b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3924fbf6a0b64f3280c079f0ea841532b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dracula television programs"}}, {"@id": "_:n3924fbf6a0b64f3280c079f0ea841532b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dracula television programs"}}], "@id": "/authorities/genreForms/gf2011026717"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026718", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVariety shows (Motion pictures)", "identifiers:lccn": "gf2011026718", "madsrdf:adminMetadata": [{"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db1"}, {"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Variety shows (Motion pictures)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026423"}, "madsrdf:hasSource": [{"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db5"}, {"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db6"}], "madsrdf:hasVariant": {"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025589"}}, {"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-01-04T11:57:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Variety shows (Motion pictures)"}}, {"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 101 (Use for works which consist of a number of different kinds of acts, including such things as stand-up comedians, comic skits, songs, dance numbers, etc.)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Variety: work that is generally hosted and consists of a number of different acts, sketches, and/or dance and musical performances, combined in a non-narrative manner. Although predominantly for television, some theatrical film variety work has also been produced)"}, "madsrdf:citationSource": "Moving image genre-form guide online, November 19, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Variety films"}}, {"@id": "_:n95db79f6f3874bd8aa8afb2161abb61db8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Variety films"}}], "@id": "/authorities/genreForms/gf2011026718"}
