d:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:46:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Albums (Books)"}}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scrapbooks"}}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scrapbooks"}}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(albums (books); NT alba amicorum; autograph albums; baby books; bridal books; letter books; photograph albums; postcard albums; presentation albums; scrapbooks; stamp albums; wedding albums; SN Books with blank pages used for assembling and presenting a collection, or any unpublished sets of pages that are bound or loose-leaf and have other materials affixed to them or writing or other images made on them. The volume may have been constructed with blank pages that were intended to have materials affixed, or it may have been assembled after having had materials affixed to separate pages)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, April 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Albums; UF Souvenir albums; NT Photograph albums; Presentation albums; Scrapbooks; Sketchbooks; RT Sample books; SN Bound or loose-leaf sets of pages. Includes handmade albums and published volumes of blank pages designed for the addition of images or keepsakes)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, April 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 75 (scrapbook: book with newspaper cuttings etc.)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Scrapbooks. BT Albums)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Albums; BT Commemorative works; NT Autograph albums; Libri amicorum; Scrapbooks; SN Use for bound volumes in which collections of materials such as stamps, photographs, or autographs may be assembled and displayed)"}, "madsrdf:citationSource": "RBMS Controlled vocabularies: Genre terms, April 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(scrapbooks. UF scrap albums; scrap-books. Blank books or albums designed so that a variety of items may be affixed to the pages, including photographs, clippings, and other memorabilia)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scrap albums"}}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scrap albums"}}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scrap books"}}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scrap books"}}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scrapbooks"}}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scrapbooks"}}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Souvenir albums"}}, {"@id": "_:ncc4ed89b12e140ad83f1127d1ee39934b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Souvenir albums"}}], "@id": "/authorities/genreForms/gf2014026173"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026174", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSerial publications", "identifiers:lccn": "gf2014026174", "madsrdf:adminMetadata": [{"@id": "_:na98f54f74ff649d8b45324bebeb14df3b1"}, {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Serial publications"}, "madsrdf:elementList": {"@list": [{"@id": "_:na98f54f74ff649d8b45324bebeb14df3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026042"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026046"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026131"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026132"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026139"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026208"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026053"}], "madsrdf:hasSource": [{"@id": "_:na98f54f74ff649d8b45324bebeb14df3b5"}, {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b6"}, {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b7"}], "madsrdf:hasVariant": {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Resources issued in successive parts, generally with no predetermined conclusion, usually bearing numerical and/or chronological designations."}, {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:40:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serial publications"}}, {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Serial: A resource issued in successive parts, usually having numbering, that has no predetermined conclusion (e.g., a periodical, a monographic series, a newspaper). Includes resources that exhibit characteristics of serials, such as successive issues, numbering, and frequency, but whose duration is limited (e.g., newsletters of events) and reproductions of serials.)"}, "madsrdf:citationSource": "RDA glossary, viewed July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Serial publications. UF Publications, Serial; Serials (Publications). BT Continuing resources (Publications))"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 75 (serial 1 serial or periodical publication, 1b radio or TV programme broadcast in episodes)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na98f54f74ff649d8b45324bebeb14df3b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Serials (Publications)"}}, {"@id": "_:na98f54f74ff649d8b45324bebeb14df3b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serials (Publications)"}}], "@id": "/authorities/genreForms/gf2014026174"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026175", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aShaggy dog stories", "identifiers:lccn": "gf2014026175", "madsrdf:adminMetadata": [{"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb1"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Shaggy dog stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, "madsrdf:hasSource": [{"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb5"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb6"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb7"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb8"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb9"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb10"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb11"}], "madsrdf:hasVariant": [{"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb12"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb15"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Lengthy, improbable, and ultimately pointless stories ending in an anti-climax, as well as for jokes in which a pun is finally achieved after a long (and ideally tedious) exposition."}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:40:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shaggy dog stories"}}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 76 (shaggy-dog story: lengthy tediously detailed story)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Shaggy dog story: A lengthy, improbable and ultimately pointless story, often told in an attempt at humour.)"}, "madsrdf:citationSource": "The phrase finder website, Nov. 19, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Shaggy dog story. In its original sense, a shaggy dog story is an extremely long-winded tale featuring extensive narration of typically irrelevant incidents, usually resulting in a pointless or absurd punchline based on a play on words in clich\u00e9 form. These stories are a special case of yarns, coming from the long tradition of campfire yarns. Shaggy dog stories play upon the audience's preconceptions of the art of joke telling. The audience listens to the story with certain expectations, which are either simply not met or met in some entirely unexpected manner. A lengthy shaggy dog story derives its humour from the fact that the joke-teller held the attention of the listeners for a long time (such jokes can take five minutes or more to tell) for no reason at all, as the story ends with a meaningless anticlimax. Shaggy dog story has come to also mean a joke where a pun is finally achieved after a long (and ideally tedious) exposition. This is also called a feghoot. The humor in the punch line may be due to the sudden, unexpected recognition of a familiar saying, since the story has nothing to do with the usual context in which the phrase is normally found, yet the listener is surprised to discover it makes sense in both situations. Therefore, if the audience is not already familiar with the phrase used in the punch line, or is not aware of the multiple meanings of the words in the phrase, the surprise ending of the joke cannot be recovered by explaining the joke to the audience.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 19, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(shaggy dog story. An improbable kind of yarn, often long and spun out, which, as a rule, does not have a witty or surprise ending; but comes, rather, to a deflating and quasi-humorous conclusion. Colloquially, 'a groaner'. See also tall story)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(shaggy-dog story: a kind of funny story that relies for its humor on its length and its sudden ridiculous ending)"}, "madsrdf:citationSource": "McGraw-Hill dictionary of American idioms and phrasal verbs, c2002, via TheFreeDictionary.com, Nov. 19, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (puns, shaggy dogs, groaners, and feghoots)"}, "madsrdf:citationSource": "Tarzan's tripes forever, and other feghoots : the Web's original shaggy dog story archive, viewed Nov. 19, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(shaggy dogs, feghoots, yarns, and groaners; we can quibble about the details of how a feghoot differs from a shaggy dog, but these are basically short stories with atrocious pun or really bad punchline (hence \"groaner\" - the listener invariably groan when they hear the ending!))"}, "madsrdf:citationSource": "Shaggy dog story archive, via Neatorama website, Nov. 19, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yarns (Shaggy dog stories)"}}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yarns (Shaggy dog stories)"}}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Groaners"}}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Groaners"}}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Feghoots"}}, {"@id": "_:n2b9e4647248d436ab7c23d7eb7c8b65bb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Feghoots"}}], "@id": "/authorities/genreForms/gf2014026175"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026176", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSlave narratives", "identifiers:lccn": "gf2014026176", "madsrdf:adminMetadata": [{"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab1"}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Slave narratives"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026047"}, "madsrdf:hasSource": [{"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab5"}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab6"}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab7"}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab8"}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Accounts of fugitive or former slaves, that are personally written or orally related by the slave."}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:41:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Slave narratives"}}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Slave Narratives: In the period between 1830 and 1860, as part of the abolition movement in America, a number of autobiographical accounts of slavery by escaped slaves were published. The best of these slave narratives was A Narrative of the Life of Frederick Douglass: An American Slave (1845))"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 51 (The slave narrative has a crucially important place in the history of American autobiography, although it was only in the mid- to late twentieth century, and partly due to the Civil Rights' movements of the 1960s, that the importance and value of slave narratives were widely recognized)"}, "madsrdf:citationSource": "McLennan, R. American autobiography, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Slave narrative: A narrative, often autobiographical in origin, about a slave's life, perhaps including his original capture, his punishments and daily labor, and his eventual escape to freedom.)"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Slave narratives. BT Narratives)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3b31db48ad6c4e6c8803c7f1f30dd8bab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(slave narrative: an account of the life, or a major portion of the life, of a fugitive or former slave, either written or orally related by the slave personally; slave narratives comprise one of the most influential traditions in American literature, shaping the form and themes of some of the most celebrated and controversial writing, both in fiction and in autobiography, in the history of the United States; the vast majority of American slave narratives were authored by African Americans; typically, the American slave narrative centers on the narrator's rite of passage from slavery in the South to freedom in the North; slavery is documented as a condition of extreme deprivation, necessitating increasingly forceful resistance; after a harrowing and suspenseful escape, the slave's attainment of freedom is signaled not simply by reaching the \"free states\" of the North but by taking a new name and dedication to antislavery activism)"}, "madsrdf:citationSource": "Britannica online academic edition, Nov. 14, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026176"}
