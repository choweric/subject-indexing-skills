{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026632", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTeen films", "identifiers:lccn": "gf2011026632", "madsrdf:adminMetadata": [{"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb1"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Teen films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026083"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026148"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026346"}], "madsrdf:hasSource": [{"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb5"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb6"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb7"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb8"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb9"}], "madsrdf:hasVariant": [{"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb10"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb13"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb16"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb19"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb22"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb25"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb28"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb31"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films produced especially for a teenage audience (i.e., the general age range of thirteen through eighteen years) and films with teenagers and teen issues as the primary subject.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025367"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T14:41:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Teen films"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (films about teenagers, not films targeted at teenagers; teen-targeted films)"}, "madsrdf:citationSource": "Lewis, J. The road to romance & ruin : teen films and youth culture, 1992:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (the 1980s produced a more codified approach to teen films, as Hollywood and independent studios systematically developed different youth subgenres to depict an increasingly diverse array of teen experiences) p. 3 (while the \"teen film\" would take some time to become a genre, its effects would be abundantly evident by the late 1930s) p. 7 (lack of an established teen cinema before the 1930s) p. 29 (teen film subgenres: in addition to hot-rod films, rock movies, beach movies, teen horror, and teen melodramas)"}, "madsrdf:citationSource": "Shary, T. Teen movies, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The teen film (also called teen movie or teenpic) is a film genre in which the plot is based upon the special interests of teenagers, such as the coming of age, first love, rebellion, and conflict with parents. Sexual themes are common, and in recent years the gross-out comedy has become a popular subgenre.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 16, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 331 (Teen movie (\"Juve\" movie, Teenage movie, Teenpic, Youth picture). Exploitation pictures addressed to youngsters in their teens ... some are genuine dramatic expositions of teen circles. Related entries: Exploitation film, juvenile delinquency film, motorcycle movie, Rock film, Youth film)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 97 (Teen drama. Fictional genre films and programs produced primarily for a teenaged audience. UF Beach party drama, Surfer drama, High school comedies. BT Fiction. NT Juvenile delinquency drama, rock and roll musicals. RT College drama, Horror drama, Motorcycle gang drama, Paukerfilme, Psychopath drama)"}, "madsrdf:citationSource": "Yee, M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Teenage films"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Teenage films"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Teen drama (Motion pictures)"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Teen drama (Motion pictures)"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Youth films"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Youth films"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Teenage movies"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Teenage movies"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Teen movies"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Teen movies"}}, {"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7e1d5a40e8e04342aba68a00ac6854bdb26"}]}, "madsrdf:variantLabel": {"@la