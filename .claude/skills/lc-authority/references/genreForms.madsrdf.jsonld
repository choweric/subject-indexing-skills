en", "@value": "Music radio programs, Folk"}}, {"@id": "_:nf22c6676a39a4e8ca5522866f9a988b2b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Music radio programs, Folk"}}], "@id": "/authorities/genreForms/gf2011026805"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026806", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aInternet radio programs", "identifiers:lccn": "gf2011026806", "madsrdf:adminMetadata": [{"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b1"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Internet radio programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026506"}, "madsrdf:hasSource": [{"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b5"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b6"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b7"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b8"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b9"}], "madsrdf:hasVariant": [{"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b10"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b13"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b16"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b19"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-02-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-04-25T06:54:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Internet radio programs"}}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Internet radio)"}, "madsrdf:citationSource": "Pandora home page, Nov. 10, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Internet radio (also web radio, net radio, streaming radio, e-radio webcasting) is an audio service transmitted via the Internet. Internet radio remains popular among expatriates and listeners with interests that are often not adequately served by local radio stations (such as eurodance, progressive rock, ambient music, folk music, classical music, and stand-up comedy). Internet radio services offer news, sports, talk, and various genres of music--every format that is available on traditional radio stations.) Webcast (A webcast is a media presentation distributed over the Internet using streaming media technology to distribute a single content source to many simultaneous listeners/viewers. A webcast may either be distributed live or on demand. The largest \"webcasters\" include existing radio and TV stations, who \"simulcast\" their output, as well as a multitude of Internet only \"stations\". The term webcasting usually refers to non-interactive linear streams or events.) Internet talk radio (Internet talk radio (also Internet radio show); notable shows: Talk of the Nation, is a talk radio program based in the United States, produced by National Public Radio; Free Speech Radio News, (or FSRN) is an independently produced half hour daily national and international radio news program; Tech Talk Radio is an independent technology talk radio program, produced weekly in Melbourne, Australia; Debi Daly Show, international caller-based talk radio program)"}, "madsrdf:citationSource": "Wikipedia, Nov. 10, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Internet radio, also known as Web radio; web radio programs)"}, "madsrdf:citationSource": "Gage, K. Web radio - a viable marketing strategy, via WWW, Nov. 10, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (Web radio) About Trumix (\"TruMix (www.Trumix.com) provides access to Internet Radio and podcasts from around the world. You can download or play the podcasts straight from the website. You can create your own account and store your favourite podcasts and Internet radio stations, and choose from packaged selections of podcasts and music.\")"}, "madsrdf:citationSource": "Work cat.: TruMix home page, Nov. 10, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Listen to Tsunami author interviewed on Web radio program \"Dialogue--Between the Lines\", via Tsunami Ridge Publishing website, Nov. 10, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Net radio programs"}}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Net radio programs"}}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Webcasts, Radio"}}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Webcasts, Radio"}}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Online radio programs"}}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Online radio programs"}}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Web radio programs"}}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Web radio programs"}}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio webcasts"}}, {"@id": "_:n06daafd90f9e4ffdbfab2242412ea773b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio webcasts"}}], "@id": "/authorities/genreForms/gf2011026806"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026808", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aApocalyptic films", "identifiers:lccn": "gf2011026808", "madsrdf:adminMetadata": [{"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b1"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Apocalyptic films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b3"}]}, "madsrdf:exampleNote": "Note under [Dystopian films]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026556"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026626"}], "madsrdf:hasSource": [{"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b5"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b6"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b7"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b8"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b9"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b10"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b11"}], "madsrdf:hasVariant": [{"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b12"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b15"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b18"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b21"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b24"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films set in a world or civilization after a catastrophic event (e.g., nuclear war, an alien invasion), sometimes also including the period immediately preceding the event. For films set in an uncertain future, in a society ruled by an ineffectual, corrupt, or oppressive regime or by aliens, robots, etc., see [Dystopian films.]"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-11-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:19:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Apocalyptic films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(in titles: apocalyptic films; the postapocalyptic film; American apocalyptic film)"}, "madsrdf:citationSource": "OCLC WorldCat, Dec. 2, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mitchell, C.P. A guide to apocalyptic cinema, 2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subcategory under Science Fiction Film: SF Disaster Films. The two main species of SF disaster movies are the end-of-the-world films involving some catastrophic upheaval due to natural, man-made, or extraterrestrial causes and films dealing with post-holocaust situations in which remnants of Earth's population strive to make a go of it; End-of-World Films (Doomsday Films); Post-Holocaust Films (Postnuclear Films))"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Apocalyptic and post-apocalyptic fiction (Apocalyptic fiction is a sub-genre of science fiction that is concerned with the end of civilization due to a catastrophic event such as nuclear war, pandemic, impact event, alien invasion, dysgenics, cybernetic revolt, economic collapse, supernatural phenomena, ecological disaster, resource depletion, or some other general disaster. Post-apocalyptic fiction is set in a world or civilization after such a disaster. The time frame may be immediately after the catastrophe, focusing on the travails or psychology of survivors, or considerably later, often including the theme that the existence of pre-catastrophe civilization has been forgotten 9or mythologized). Post-apocalyptic stories often take place in an agrarian, non-technological future world, or a world where only scattered elements of technology remain. There is a considerable degree of blurring between this form of science fiction and that which deals with false utopias or dystopic societies.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 2, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Post-Apocalyptic landscape is one of the staples of blockbuster sci-fi adventure films...In movies and TV, in particular, there's a growing sub-genre of pre-apocalyptic storytelling. Generally these are stories that give us glimpses of the results of worldwide devastation and then, through the wonders of time travel, give our heroes the opportunity to prevent the oncoming devastation. In film, The Terminator is probably the best example of the genre. Then 12 Monkeys.)"}, "madsrdf:citationSource": "Post-apocalyptic TV series and shows, via WWW, Dec. 2, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yee, M.M. Moving image materials: genre terms, 1988.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Category: Post-apocalyptic films (Post-Apocalyptic science fiction is a sub-genre of science fiction, also known as doomsday film, and is set in a world or civilization after nuclear war, plague, or some other general disaster. Subcategories: Living Dead films; Mas Max; Matrix series; Planet of the Apes films; Resident Evil films; Terminator films0. List of apocalyptic films (films within this list feature either the end of the world, a prelude to such an end, and/or a post-apocalyptic wasteland setting) The Road (film) (The Road is a 2009 post-apocalyptic drama film)"}, "madsrdf:citationSource": "Wikipeida, Dec. 2, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Post-apocalyptic films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Post-apocalyptic films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Post-apocalyptic science fiction films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Post-apocalyptic science fiction films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Doomsday films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Doomsday films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Postapocalyptic science fiction films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Postapocalyptic science fiction films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "End-of-the-world films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "End-of-the-world films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Postapocalyptic films"}}, {"@id": "_:n033c8bf9703945fb880c2c8069fdaa81b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Postapocalyptic films"}}], "@id": "/authorities/genreForms/gf2011026808"}
