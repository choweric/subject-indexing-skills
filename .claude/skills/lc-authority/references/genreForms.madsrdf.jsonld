 {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nb9f7b824e14946b0a26b4384ece69d15b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thumb Bibles"}}, {"@id": "_:nb9f7b824e14946b0a26b4384ece69d15b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bible--Thumb Bibles. UF Thumb Bibles. BT Bible--Abridgments; Children's Bibles; Miniature books. SN Here are entered works which consist of abridged texts of the Bible in miniature size written for children)"}, "madsrdf:citationSource": "LCSH, Nov. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9f7b824e14946b0a26b4384ece69d15b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a thumb Bible)"}, "madsrdf:citationSource": "Work cat.: Bible. Selections. Authorized. English. 1834. The child's Bible, 1834?", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9f7b824e14946b0a26b4384ece69d15b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Thumb bibles. SN Use for miniature volumes containing summaries or abridgments of biblical texts in verse or prose; typically illustrated and produced chiefly for use by children. UF Bibles, thumb. BT Juvenile literature; Religious works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Nov. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9f7b824e14946b0a26b4384ece69d15b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (collated and abridged by Thomas G. Fessenden)"}, "madsrdf:citationSource": "Miniature Bible, or, Abstract of sacred history : for the use of children, 1816:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9f7b824e14946b0a26b4384ece69d15b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(thumb bible: A category of miniature book, first printed in England the early 17th century, containing summaries, abridgments, or paraphrases of biblical texts in verse or prose, often illustrated, intended primarily for use by children)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, via WWW, Nov. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9f7b824e14946b0a26b4384ece69d15b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9f7b824e14946b0a26b4384ece69d15b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bibles, Thumb"}}, {"@id": "_:nb9f7b824e14946b0a26b4384ece69d15b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bibles, Thumb"}}], "@id": "/authorities/genreForms/gf2017026137"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026140", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCase studies", "identifiers:lccn": "gf2017026140", "madsrdf:adminMetadata": [{"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b1"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Case studies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b5"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b6"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b7"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b8"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b9"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b10"}], "madsrdf:hasVariant": [{"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b11"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b14"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b17"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b20"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-05T13:53:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Case studies"}}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Case Reports (Case Reports. UF Case Histories; Case Studies; Case Study. SN Clinical presentations that may be followed by evaluative studies that eventually lead to a diagnosis. This heading is used as a Publication Type) Organizational Case Studies (Organizational Case Studies. UF Management Case Studies. SN Descriptions and evaluations of specific health care organizations)"}, "madsrdf:citationSource": "MeSH browser, Nov. 8, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Case study (In the social sciences and life sciences, a case study is a research method involving an up-close, in-depth, and detailed examination of a subject of study (the case), as well as its related contextual conditions. Case studies can be produced by following a formal research method. These case studies are likely to appear in formal research venues, as journals and professional conferences, rather than popular works. The resulting body of 'case study research' has long had a prominent place in many disciplines and professions, ranging from psychology, anthropology, sociology, and political science to education, clinical science, social work, and administrative science. In doing case study research, the \"case\" being studied may be an individual, organization, event, or action, existing in a specific time and place)"}, "madsrdf:citationSource": "Wikipedia, Nov. 7, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "back cover (Volume highlights include: Compilation of real world case studies)"}, "madsrdf:citationSource": "Work cat.: Flood damage survey and assessment, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(--Case studies. Use as a form subdivision under names of individual corporate bodies and under classes of persons, ethnic groups, and topical headings for individual or collected case studies. UF Cases, clinical reports, statistics; Clinical reports)"}, "madsrdf:citationSource": "LCSH, Nov. 7, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "case study (In the social and medical sciences, analysis of the behavior of one individual in a population, or a single event in a series, based on close observation over a period of time, often to reveal principles underlying individual behavior or events in general. A case study may be published as an article in a journal, as an essay in a collection, or in book form. In bibliographic databases that permit the user to limit retrieval by type of publication, case studies may be one of the options (example: PsycINFO). Synonymous with case report. Compare with casebook) casebook (A book containing records or descriptions of actual cases that have occurred in a professional discipline (law, medicine, psychology, sociology, social work, counseling, etc.), selected to illustrate important principles and concepts, for the use of students as a textbook and practitioners for reference. Legal casebooks are typically plainly bound. Compare with case study)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Nov. 8, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(case study: an intensive analysis of an individual unit (such as a person or community) stressing developmental factors in relation to environment)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Nov. 7, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Case histories"}}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Case histories"}}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Studies, Case"}}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies, Case"}}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reports, Case"}}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reports, Case"}}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Case reports"}}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Case reports"}}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Histories, Case"}}, {"@id": "_:n0d9c2406ef9545e48f8a601173f38ce0b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Histories, Case"}}], "@id": "/authorities/genreForms/gf2017026140"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026141", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHunting fiction", "identifiers:lccn": "gf2017026141", "madsrdf:adminMetadata": [{"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b1"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hunting fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b5"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b6"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b7"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b8"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b9"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b10"}], "madsrdf:hasVariant": {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features hunting and hunters."}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-30T09:50:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hunting fiction"}}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. vii (a hunting writer) p. 35 (Rutledge created \"The Egret's Plumes,\" an engaging, allegorical narrative for the juvenile audiences he hoped to inspire) p. 36 (Rutledge describes the plight of a pair of snowy egrets that have journeyed to South Carolina's lowcountry swamps to escape the relentless plume hunters of their native Florida home; allegorical conflict between good and evil)"}, "madsrdf:citationSource": "Rutledge, Archibald. The egret's plumes, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hunting stories. UF Hunting--Fiction; Hunting--Juvenile fiction. BT Sports stories)"}, "madsrdf:citationSource": "LCSH, Nov. 17, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(short stories)"}, "madsrdf:citationSource": "Faulkner, William. Big woods : the hunting stories, 1994", "madsrdf:citationStatus": "found"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (\"The annotated bibliography consists of 101 hunting picture books and novels\") p. 1 (hunting stories) p. 51 (chapter books/novels that feature hunters or hunting)"}, "madsrdf:citationSource": "Seddon, L. 101 books for youth that feature hunters & hunting, 2013, via UNI ScholarWorks website, viewed Nov. 17, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. ix (the focus is on dogs and bird hunting) p. 27 (Frequently in Rutledge's work there is no clear dividing line between fact and fiction. He was in many ways a master of the twice-told tale, and any careful perusal of his books will find repeat encounters with majestic bucks or memorable turkeys. There is some of this tendency in his writings on dogs and bird hunting as well, as there are certain stories that are clearly fictional in nature)"}, "madsrdf:citationSource": "Work cat.: Rutledge, Archibald. Bird dog days, wingshooting ways : Archibald Rutledge's tales of upland hunting, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "publ. desc. (\"Readers can curl up with the best authentic hunting fiction and non-fiction\")"}, "madsrdf:citationSource": "The best hunting stories ever told, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hunting stories (Fiction)"}}, {"@id": "_:nd32b4ec6f56647b093f5c2446c11b223b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hunting stories (Fiction)"}}], "@id": "/authorities/genreForms/gf2017026141"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026142", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCryptologic fiction", "identifiers:lccn": "gf2017026142", "madsrdf:adminMetadata": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb1"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cryptologic fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb5"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb6"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb7"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb8"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb9"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb10"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb11"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb12"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb13"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb14"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb15"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb16"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb17"}], "madsrdf:hasVariant": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb18"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb21"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb24"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb27"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb30"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb33"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb36"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb39"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features codes, ciphers, and/or cryptograms."}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-30T09:50:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cryptologic fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 16 (A gem of cryptographic fiction is Poe's famous story The Gold Bug, also Conan Doyle's Adventure of the Dancing Men)"}, "madsrdf:citationSource": "The pentagon, fall 1952:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 90 (scraps of paper written in a secret code derived from a work of literature: Edgar Allan Poe's 1848 story \"The Gold Bug\") p. 92 (Devils in Daylight is a kind of translation of \"The Gold Bug.\" Tanizaki takes the bare outlines of the plot and the narrative frame from Poe, and changes the setting to the streets of Taish\u014d-period Tokyo; map with clues written in a secret code; code-cracking detective work)"}, "madsrdf:citationSource": "Work cat.: Tanizaki, Jun'ichir\u014d. Devils in daylight, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (\"stories and novels ... that contain elements of cryptology as significant plot elements. For the most part there are no childrens or juvenile stories in the list. I leave that sub-genre to others\"; \"books and stories I've found to date that contain cryptograms or significant references to codes or ciphers\"; crypto fiction)"}, "madsrdf:citationSource": "Dooley, J.F. Cryptology in fiction website, viewed Nov. 17, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(crypto novels; the leading light in the crypto novel scene has to be Cryptonomicon by Neal Stephenson; cryptology (the combined art of cracking codes and making codes))"}, "madsrdf:citationSource": "Crypto fiction, via Ian Grigg website, Nov. 17, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Twelve-year-old Alvin and his best friend Shoie use their knowledge of codes and ciphers to solve a dangerous mystery; LCSH assigned: Code and cipher stories)"}, "madsrdf:citationSource": "Hicks, Clifford B. Alvin's secret code, \u00a91963", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (fiction (short stories, novels, chapters in novels, etc.) that I've found over the past 15 years or so that contain cryptograms of one sort or another as part of the story line; most of these stories will fall in the categories of mysteries, detective stories, spy stories, or treasure hunts; crypto fiction; things mathematical and cryptographical) p. 34 (Henry E. Langen was a life-long fan of cryptography and had an extensive personal library of cryptographic titles, both fiction and non-fiction.)"}, "madsrdf:citationSource": "Dooley, J.F. Cryptology in fiction, via WWW, last updated Oct. 31, 2017, viewed Nov. 17, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Sly uses her detective skills to help her friends solve mysteries that all involve some kind of code; LCSH assigned: Code and cipher stories)"}, "madsrdf:citationSource": "Napoli, Donna Jo. Sly the sleuth and the code mysteries, \u00a92009", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Code and cipher stories. UF Cipher stories; Ciphers--Fiction; Ciphers--Juvenile fiction; Code stories; Cryptogram stories; Cryptography--Fiction; Cryptography--Juvenile fiction. BT Fiction)"}, "madsrdf:citationSource": "LCSH, Nov. 17, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Crypto-fiction classics, via Books to read website, Nov. 17, 2017 (crypto-fiction; cryptofiction; From its roots in cryptozoology, this genre features bizarre, fantastical, and often terrifying tales of mythical and legendary creatures)", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 76 (one of the finest writers of cryptographic fiction was Sir Arthur Conan Doyle)"}, "madsrdf:citationSource": "Singh, S. The code book, 2016, via Google books, viewed Nov. 17, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 269 (the area of military cryptology known as cryptography, or the writing of codes and ciphers) pp. 340-341 (\"when he came to the writing of 'The Gold Bug,' he [Poe] combined the two of his inventions, the detective story and literary cryptography, in a climax to his cryptographic writing which is perhaps not always fully appreciated as such\"; Poe's cryptological writings) p. 342 (Poe's cryptological fiction; Poe's most influential cryptographic story, \"The Gold Bug\")"}, "madsrdf:citationSource": "Veggian, H. Mercury of the waves : modern cryptology and U.S. literature, 2005, via WWW, Nov. 17, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 1-2 (Poe's cryptographic writing; work that makes direct or oblique use of codes and ciphers; the relatively few stories that, like \"The Gold-Bug\" or Robert Louis Stevenson's Treasure Island, explicitly include ciphers or codes) p. 4 (cipher-fictions) p. 6 (certain recent literary genres (detective fiction, science fiction, cryptographic adventure) have crytographic assumptions programmatically encoded into them) p. 13 (the three main types of cryptographic fiction: the cipher adventure, detective fiction, and science fiction) p. 104 (Poe's cryptographic fiction) glossary (Cipher: A text in which each letter of the plaintext is represented by a different symbol of combination of symbols; Code: The set of words, phrases, letters, or syllables used to replace the words or phrases of the plaintext message. In a cipher, by contrast, each letter or number in the plaintext is enciphered by its own figure (or set of figures); Cryptology: The science of codes, composed of two parts: cryptography, the art of making codes, and cryptanalysis, the art of breaking them. The term cryptograph, first used by Poe in \"The Gold-Bug,\" refers to any encoded or enciphered text; it is now more common than its synonym, cryptogram.)"}, "madsrdf:citationSource": "Rosenheim, S.J. The cryptographic imagination, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 180 (cryptologic fiction) Oct. 2005: pp. 290-292 (codes and ciphers in fiction; codes, ciphers, puzzles, and steganography have played major roles in many works of fiction; cryptology has played a key role in many works of mystery, suspense, and science fiction; using cryptography and especially cryptanalysis adds an extra flair to many stories; plots using codes and ciphers appear quite frequently in mystery and detective fiction. Edgar Allan Poe's The Gold-Bug is the seminal example in this genre. These stories use the solution of a cryptogram as a key to the solution of the mystery)"}, "madsrdf:citationSource": "Cryptologia, Apr. 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Code fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Code fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cryptofiction (Cryptologic fiction)"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cryptofiction (Cryptologic fiction)"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cryptological fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cryptological fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crypto fiction (Cryptologic fiction)"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crypto fiction (Cryptologic fiction)"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cryptographic fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cryptographic fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Code and cipher fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Code and cipher fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cipher fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cipher fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d41b2a0581046b69a675458115e4cccb40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cryptogram fiction"}}, {"@id": "_:n8d41b2a0581046b69a675458115e4cccb40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cryptogram fiction"}}], "@id": "/authorities/genreForms/gf2017026142"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026143", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVampire fiction", "identifiers:lccn": "gf2017026143", "madsrdf:adminMetadata": [{"@id": "_:ne149e6ed724541efbecb46689073e681b1"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Vampire fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne149e6ed724541efbecb46689073e681b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026469"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026127"}], "madsrdf:hasSource": [{"@id": "_:ne149e6ed724541efbecb46689073e681b5"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b6"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b7"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b8"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b9"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b10"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b11"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b12"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b13"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b14"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b15"}], "madsrdf:hasVariant": {"@id": "_:ne149e6ed724541efbecb46689073e681b16"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne149e6ed724541efbecb46689073e681b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:25:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vampire fiction"}}, {"@id": "_:ne149e6ed724541efbecb46689073e681b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (Perhaps because Stoker's Dracula evolved into such a mythic figure, subsequent writers of vampire fiction have failed to invent a character of comparable grandeur; there have been very few vampire novels of distinction published since 1897; of more than one hundred fifty, only a handful is of literary merit; in Suzy McKee Charnas's The Vampire Tapestry, the idea of the vampire transcends its usual limitations as an armature for a horror fiction) p. 2 (short story writers in this century have produced a rich array of vampire fiction, as the stories collected here demonstrate; vampire fiction has elements the genres murder mysteries, sword-and-sorcery fiction, so-called women's Gothic fiction, mainstream horror; vampire fiction has blood as its primary metaphor) p. 3 (In addition to the erotic implications of the blood exchange, vampire fiction has psychological and spiritual meanings as well) p. 4 (It was not, however, until the nineteenth century that The Vampyre, the first vampire novel in English, appeared)"}, "madsrdf:citationSource": "Wolf, L. Blood thirst : 100 years of vampire fiction, 1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Vampire Diaries is a young adult vampire horror series of novels created by L.J. Smith. The story centers on Elena Gilbert, a young high school girl who finds her heart eventually torn between two vampire brothers, Stefan and Damon Salvatore; volumes in series: The Awakening; The Struggle; The Fury; Dark Reunion)"}, "madsrdf:citationSource": "Wikipedia, Nov. 28, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. verso (The vampire diaries)"}, "madsrdf:citationSource": "Work cat.: Smith, L.J. Awakening. Vietnamese. Ng\u01b0\u1eddi kh\u00f4ng ng\u1ee7, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Vampire Chronicles reintroduced the ancient monster to a modern audience, banishing the cape-wearing fiend we thought we knew to the loneliest crypt in the graveyard ... If you're a vampire fiction fan looking for some new blood, consider giving these books a try: Fevre Dream, by George R.R. Martin; Fledgling, by Octavia Butler; Already Dead: A Novel, by Charlie Huston; The Vampire Tapestry, by Suzy McKee Charnas)"}, "madsrdf:citationSource": "Staggs, M. 4 works of vampire fiction off the beaten path, via Unbound worlds website, Nov. 28, 2016, viewed on Nov. 28, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. verso (The vampire diaries)"}, "madsrdf:citationSource": "Smith, L.J. Fury. Vietnamese. C\u01a1n th\u1ecbnh n\u1ed9, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(vampire fiction: 190,000 hits; vampire stories: 443,000 hits; vampiric fiction: 564 hits; vampiric stories, 4,420 hits; vampirish fiction: 4 hits; vampirish stories: 45 hits)"}, "madsrdf:citationSource": "Google, Jan. 8, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 13 (Kate Pullinger, known for her vampirish novel Where Does Kissing End?)"}, "madsrdf:citationSource": "Quill & quire, Jan. 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 24 (In \"Twilight,\" Stephenie Meyer emphasizes love and attraction rather than many of the themes associated with vampiric fiction - life and death, repressed or transgressive sexuality, modernity and tradition, faith and atheism, good and evil)"}, "madsrdf:citationSource": "St. Louis post-dispatch, Nov. 21, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 119 (vampiric fiction; vampire fiction) pp. 157-158 (vampire fiction finds its origins in the vampire hysteria that swept across Europe in the early part of the eighteenth century; \"The Vampyre\" was the first story of the undead \"successfully to fuse the disparate elements of vampirism into a coherent literary genre,\" according to Sir Christopher Frayling) p. 162 (Richard Matheson's I Am Legend (1954), a postapocalyptic zombie-vampire novel that is now considered a contemporary classic among horror fiction in general and vampire literature in particular) p. 261 (\"The Vampyre\" (1819) is considered the progenitor of vampiric fiction)"}, "madsrdf:citationSource": "Horror literature through history, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the vampire story; blood-sucking monster; \"The Vampyre\", by John Polidori, first published anonymously in 1819, was the first vampire story; previously, vampires had been creatures of folklore, featuring in many cultures around the world, and the anecdotes about them collected by obsessives like Dom Augustin Calmet and Montague Summers were mostly about smelly peasant revenants who seem more like our present idea of a zombie; the next significant vampire story, Joseph Sheridan Le Fanu's Carmilla (1871), in which the monster is a pale, passive-aggressive teenage girl, evokes \"The Vampyre\" as the title character latches onto successive well-off families like a cuckoo in the nest and drains the daughters. Le Fanu added the stake through the heart and other elements that have accrued to the genre; Bram Stoker's Dracula (1897) is the big beast of vampire fiction; Richard Matheson's I Am Legend (1953), recently anointed Best Vampire Novel of the Century by the Horror Writers Association)"}, "madsrdf:citationSource": "Newman, K. A brief history of vampire fiction, via Wired website, April 16, 2012, viewed on Nov. 28, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 6 (With \"The Vampyre,\" Polidori gave birth to the two main branches of vampiric fiction: the vampire as romantic hero, and the vampire as undead monster)"}, "madsrdf:citationSource": "International herald tribune, Aug. 1, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne149e6ed724541efbecb46689073e681b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne149e6ed724541efbecb46689073e681b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vampiric fiction"}}, {"@id": "_:ne149e6ed724541efbecb46689073e681b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vampiric fiction"}}], "@id": "/authorities/genreForms/gf2017026143"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026144", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNocturnes (Music)", "identifiers:lccn": "gf2017026144", "madsrdf:adminMetadata": [{"@id": "_:n74b580af583d4d9b810b606234013a47b1"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nocturnes (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n74b580af583d4d9b810b606234013a47b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n74b580af583d4d9b810b606234013a47b5"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b6"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b7"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b8"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b9"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b10"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b11"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n74b580af583d4d9b810b606234013a47b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-30T09:50:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nocturnes (Music)"}}, {"@id": "_:n74b580af583d4d9b810b606234013a47b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nocturne (Fr., 'pertaining to night'). A comp. which suggests a nocturnal atmosphere, e.g. Haydn's Notturnos for lira organizzata, Mozart's Serenata Notturna, but more specifically a short pf. piece of romantic character. First to use the title for this genre was John Field, followed by Chopin. An expressive melody in the right hand is accompanied in the left by broken chords)"}, "madsrdf:citationSource": "The Oxford dictionary of music, via Oxford music online, Nov. 29, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nocturne (Fr., 'of the night'; Ger.: Nachtst\u00fcck). A 19th-century, Romantic piano piece of a slow and dreamy nature in which a graceful, highly embellished melody in the right hand is accompanied by a broken-chord pattern in the left. The title was first used by John Field, and was taken up by Chopin, whose 21 examples are unsurpassed. In the 20th century the term was also applied to pieces that depicted musically the sounds of night; for example in the fourth movement of Bart\u00f3k's piano suite Out of Doors (1928), the noises made by insects, birds, and other night creatures are imitated.)"}, "madsrdf:citationSource": "The Oxford companion to music, via Oxford music online, Nov. 29, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A nocturne is a short gentle piece of music, often one written to be played on the piano)"}, "madsrdf:citationSource": "COBUILD advanced English dictionary, via Collins website, Nov. 29, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nocturne. Alternative Title: notturno. Nocturne (French: \"Nocturnal\"), in music, a composition inspired by, or evocative of, the night, and cultivated in the 19th century primarily as a character piece for piano. The form originated with the Irish composer John Field, who published the first set of nocturnes in 1814, and reached its zenith in the 19 examples of Fr\u00e9d\u00e9ric Chopin. In Germany the nocturne, or Nachtst\u00fcck, attracted composers from Robert Schumann to Paul Hindemith (Suite for Piano, 1922). At the turn of the century Claude Debussy most successfully transferred the genre to the orchestra with his three brilliant pieces so entitled; The late 18th-century Italian notturno, a collection of lightweight pieces for chamber ensemble, bore little relation to the lyrical 19th-century nocturne. Like the serenades and cassations of Haydn and Mozart, however, it was intended, at least originally, for nocturnal, usually outdoor, performance)"}, "madsrdf:citationSource": "Britannica online, Nov. 29, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nocturne: a work of art dealing with evening or night; especially : a dreamy pensive composition for the piano)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Nov. 29, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (Larchet: By the Waters of Moyle (Nocturne for Orchestra)) booklet p. 4 (smaller forms such as the nocturne for orchestra By the Waters of Moyle)"}, "madsrdf:citationSource": "Work cat.: RTE Sinfonietta. Romantic Ireland, \u21171996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nocturne (i) (Fr.; Ger. Nachtst\u00fcck). A piece suggesting night, usually quiet and meditative in character, but not invariably so. The Italian term Notturno occurs frequently as a title in 18th-century music, but the French form of the word was not used until John Field applied it to some lyrical piano pieces written between about 1812 and 1836; Although the emotional range of most of Field's nocturnes is not wide, and the phrase structure sometimes tediously predictable, the restrained elegance of his musical language and imaginative keyboard figuration made a great impression on subsequent Romantic composers, especially Chopin, who admired both Field's playing and his compositions. Nocturnes were composed by most pianist-composers of the time, including Liszt (whose famous Liebestr\u00e4ume song transcriptions were subtitled 'nocturnes'), Schumann (Nachtst\u00fccke op.23), J.B. Cramer, Czerny, Kalkbrenner, Thalberg, Henri Bertini and Theodor D\u00f6hler among them. Chopin's 21 nocturnes, however, hold a pre-eminent place in the history of the genre; Although the apogee of the pianistic nocturne was reached with Chopin, it continued to be a popular genre. French composers were particularly attracted to the form: Faur\u00e9 wrote 13 nocturnes, and Satie, d'Indy and Poulenc contributed to the repertory. Liszt's late works include the nocturne En r\u00eave (1885) and celebrated nocturnes were also composed by Glinka, Balakirev, Tchaikovsky (op.10 no.1 in F major and op.19 no.4 in C\u266f minor), Rimsky-Korsakov (Nocturne in D minor), Skryabin and Grieg (Notturno in C major op.54 no.4). Nocturnes were also written for orchestra; a well-known example is in Mendelssohn's incidental music for A Midsummer Night's Dream, where the tone-colour of the horn is used, as in the 18th-century notturno, to evoke the image of night)"}, "madsrdf:citationSource": "Grove music online, Nov. 29, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n74b580af583d4d9b810b606234013a47b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nocturne 1. Music. A short composition of a romantic nature, typically for piano. 2. Art. A picture of a night scene)"}, "madsrdf:citationSource": "Oxford dictionaries online, Nov. 29, 20107", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026144"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026145", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFolk song texts", "identifiers:lccn": "gf2017026145", "madsrdf:adminMetadata": [{"@id": "_:n378d384109d04b87a8623f824b3a3366b1"}, {"@id": "_:n378d384109d04b87a8623f824b3a3366b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Folk song texts"}, "madsrdf:elementList": {"@list": [{"@id": "_:n378d384109d04b87a8623f824b3a3366b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026005"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026069"}, "madsrdf:hasSource": [{"@id": "_:n378d384109d04b87a8623f824b3a3366b5"}, {"@id": "_:n378d384109d04b87a8623f824b3a3366b6"}, {"@id": "_:n378d384109d04b87a8623f824b3a3366b7"}, {"@id": "_:n378d384109d04b87a8623f824b3a3366b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n378d384109d04b87a8623f824b3a3366b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n378d384109d04b87a8623f824b3a3366b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-30T09:50:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n378d384109d04b87a8623f824b3a3366b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folk song texts"}}, {"@id": "_:n378d384109d04b87a8623f824b3a3366b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Spinner, L. Cantata on German folksong texts, \u00a91978.", "madsrdf:citationStatus": "found"}, {"@id": "_:n378d384109d04b87a8623f824b3a3366b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(texts of Cambodian folk songs in French)"}, "madsrdf:citationSource": "Work cat.: Chansons populaires, 1970", "madsrdf:citationStatus": "found"}, {"@id": "_:n378d384109d04b87a8623f824b3a3366b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Gordon, R.W. Manuscript collections of American folksong texts, 1978.", "madsrdf:citationStatus": "found"}, {"@id": "_:n378d384109d04b87a8623f824b3a3366b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "table of contents (Folk song texts as culture indicators)"}, "madsrdf:citationSource": "Lomax, A. Folk song style and culture, 1978:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026145"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026147", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSubterranean fiction", "identifiers:lccn": "gf2017026147", "madsrdf:adminMetadata": [{"@id": "_:n5d469e74534449cebb41b2051e65c721b1"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Subterranean fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5d469e74534449cebb41b2051e65c721b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026217"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026529"}], "madsrdf:hasSource": [{"@id": "_:n5d469e74534449cebb41b2051e65c721b5"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b6"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b7"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b8"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b9"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b10"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b11"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b12"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b13"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b14"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b15"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b16"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b17"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b18"}], "madsrdf:hasVariant": {"@id": "_:n5d469e74534449cebb41b2051e65c721b19"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-03-13T13:22:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Subterranean fiction"}}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Casanova, G. Casanova's \"Icosameron\", or, The story of Edward and Elizabeth : who spent eighty-one years in the land of the Megamicres, original inhabitants of Protocosmos in the interior of our globe, \u00a91986.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 69 (the genre of subterranean fiction dates back for centuries, traceable to even Dante's Inferno)"}, "madsrdf:citationSource": "Analog game studies, v. 1 (2016), via Google books, viewed Dec. 13, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 20 (subterranean fiction)"}, "madsrdf:citationSource": "Bould, M. The Routledge concise history of science fiction, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 39 ([Jules] Verne's legacy of aeronautic and subterranean fiction)"}, "madsrdf:citationSource": "Surrealism, science fiction and comics, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hypogeal (also hypogean): underground; subterranean)"}, "madsrdf:citationSource": "Oxford dictionaries online, Dec. 13, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "series t.p. (The Wesleyan early classics of science fiction series) pp. 6-10 (subterranean fiction; hollow-Earth fiction; the genre; two basic subsets of fictional hollow-Earth settings: depictions of the interior of the Earth in terms of a Swiss cheese, that is, as containing one or more immense caverns in its crust; in the second, the Earth is hollow; a third type depicts not a hollow Earth per se, but a subterranean passage; another type of voyage is the \"subterraneous\" or subterranean voyage; subterranean novels) p. 97 ([Adam Seaborn's] Symzonia appeared in 1820 ... This novel is the archetypal hollow-Earth fiction) publisher description (\"The bizarre idea that the Earth's interior is hollow and, perhaps, even populated has been put to effective literary use by writers ranging from Edgar Allen Poe and Jules Verne to Rudy Rucker and Edgar Rice Burroughs. ... The hollow Earth is one of the most important settings in the literature of the imagination that fed into early science fiction. Subterranean Worlds ... excerpts key passages from the major subterranean world fictions, some translated into English for the first time.\")"}, "madsrdf:citationSource": "Work cat.: Subterranean worlds : a critical anthology, \u00a92004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 422 (In 1864 Jules Verne wrote in A Journey to the Center of the Earth ... with this book Verne wrote the definitive story against which all other hollow-earth fiction would be judged; Using the hollow-earth theme, Edgar Rice Burroughs produced a seven-novel series that began in 1914 with At the Earth's Core)"}, "madsrdf:citationSource": "Encyclopedia of caves and karst science, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Subterranean voyages USE Voyages, Imaginary)"}, "madsrdf:citationSource": "Guidelines on subject access to individual works of fiction, drama, etc., 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sequel to: Tunnels) bk. jkt. (\"In Tunnels, boy archaeologist Will Burrows went in search of his missing father--and discovered a sinister subterranean world. Now, wandering the dark, burnt bowels beneath the Colony, Will stumbles across the Styx's diabolical plan to exterminate all Topsoilers\")"}, "madsrdf:citationSource": "Gordon, R. Deeper, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Subterranean fiction (Subterranean fiction is a subgenre of adventure fiction or science fiction which focuses on underground settings, sometimes at the center of the Earth or otherwise deep below the surface; The earliest works in the genre were Enlightenment-era philosophical or allegorical works, in which the underground setting was often largely incidental. In the late 19th century, however, more pseudoscientific or proto-science-fictional motifs gained prevalence; Tunnels (2005) is the first of a series of books by Roderick Gordon and Brian Williams, taking place in a hollow Earth with an interior sun, in which multiple civilisations exist within and beneath the crust; Giacomo Casanova's 1788 Icosam\u00e9ron is a 5-volume, 1,800-page story of a brother and sister who fall into the Earth and discover the subterranean utopia of the M\u00e9gamicres, a race of multicolored, hermaphroditic dwarfs; William R. Bradshaw's science fiction novel The Goddess of Atvatabar (1892) is a utopian fantasy set within the hollow Earth)"}, "madsrdf:citationSource": "Wikipedia, Dec. 12, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 306 (Edward Bulwer-Lytton's The Coming Race; a proto-science fiction story that belongs to the subgenre of hollow earth fiction)"}, "madsrdf:citationSource": "Teaching Victorian literature in the twenty-first century, 2017, via Google books, viewed Dec. 13, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b16", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bradshaw, W.R. The goddess of Atvatabar : being the history of the discovery of the interior world and conquest of Atvatabar, 1892.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 93 (hollow-earth fiction)"}, "madsrdf:citationSource": "Becker, A.R. The lost worlds romance, 1992, via Google books, viewed Dec. 13, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "index (Subterranean Worlds see Travel) p. 613 (under Travel: Underground utopia, like lunar utopia, has its own structures, themes, rhetorical devices and situations that make it clearly different from surface utopia. First of all, underground utopia often assumes the typical features of satire and upside-down world; in underground utopia a relevant role is played by the relationship between man and the hypogeal environment in its mythical-religious implications; hypogeal setting; typical topoi of the genre: immobility, measured and strictly confined space, abolished time; underground peregrinations, where the traveller passes from one adventure to another and has numberless encounters with different peoples and situations, rendering the depicted universe kaleidoscopic (for instance, Icosam\u00e9ron))"}, "madsrdf:citationSource": "Dictionary of literary utopias, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5d469e74534449cebb41b2051e65c721b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hollow-Earth fiction"}}, {"@id": "_:n5d469e74534449cebb41b2051e65c721b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hollow-Earth fiction"}}], "@id": "/authorities/genreForms/gf2017026147"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026149", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aItalo disco (Music)", "identifiers:lccn": "gf2017026149", "madsrdf:adminMetadata": [{"@id": "_:n9f4bca08b1fe401cb06142abca254b68b1"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Italo disco (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9f4bca08b1fe401cb06142abca254b68b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n9f4bca08b1fe401cb06142abca254b68b5"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b6"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b7"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b8"}], "madsrdf:hasVariant": [{"@id": "_:n9f4bca08b1fe401cb06142abca254b68b9"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b12"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b15"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b18"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-03-13T13:22:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Italo disco (Music)"}}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 11, p. 220 (Italo-disco or simply Italo) p. 237 (Italo disco was noteworthy as a subgenre [of Eurodisco] that also proved to have some lasting influence on the international development of dance music) p. 417 (Italo Disco. The term Italo disco, replacing the term spaghetti disco; As well as making an important contribution to the character of early house music, Italo disco also influenced early Detroit techno; Italo disco style: a rigid four-in-a-bar rhythmic pattern; a tendency to use repetitive bass riffs rather than the more inventive ones derived from soul music; the supremacy of catchy melodies with vocal parts up-front in the mix; and full access to state-of-the-art technologies; characteristic recognized by Anglophone listeners was a tendency to na\u00efve lyrics with non-native pronunciations; other labels have been and are used: Italo beat, Italo house and Italo dance)"}, "madsrdf:citationSource": "Continuum encyclopedia of popular music of the world, 2003- :", "madsrdf:citationStatus": "found"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Generally, Italo-Disco consists of English pop vocals (often sung a little weirdly by non-native English speakers) over mid-tempo, heavily synthetic disco or hybrid disco-electro rhythms, with emphasized lead synths. It was mostly produced by Italians in the mid-1980s; the term is sometimes used more broadly to describe dance music from outside of Italy and from different eras and in more diverse styles)"}, "madsrdf:citationSource": "Exploring Italo-disco, via Discogs website, Dec. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Disco Italia : essential Italo disco classics, 1977-1985, \u21172008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 20 (dance tracks, able to combine an easy melody, a catchy and repetitive sang [sic], a futuristic sound, sometimes spatial and airy with a regular rhythm and a strong propensity to the dance, embroidered with simple effects created with synthesizers, drum machines and vocoder of the first generation)"}, "madsrdf:citationSource": "Cataldo Verrina, F. The history of Italo disco, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9f4bca08b1fe401cb06142abca254b68b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Italo dance (Music)"}}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Italo dance (Music)"}}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9f4bca08b1fe401cb06142abca254b68b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Italo beat (Music)"}}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Italo beat (Music)"}}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9f4bca08b1fe401cb06142abca254b68b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spaghetti disco (Music)"}}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spaghetti disco (Music)"}}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9f4bca08b1fe401cb06142abca254b68b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Italo house (Music)"}}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Italo house (Music)"}}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9f4bca08b1fe401cb06142abca254b68b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Italo (Music)"}}, {"@id": "_:n9f4bca08b1fe401cb06142abca254b68b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Italo (Music)"}}], "@id": "/authorities/genreForms/gf2017026149"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026150", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnatomical models", "identifiers:lccn": "gf2017026150", "madsrdf:adminMetadata": [{"@id": "_:n4be60509e77e402c91aa1711d10a4edbb1"}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Anatomical models"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4be60509e77e402c91aa1711d10a4edbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027245"}, "madsrdf:hasSource": [{"@id": "_:n4be60509e77e402c91aa1711d10a4edbb5"}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb6"}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb7"}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb8"}], "madsrdf:hasVariant": [{"@id": "_:n4be60509e77e402c91aa1711d10a4edbb9"}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-03-13T13:22:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anatomical models"}}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Models, Anatomic; Three-dimensional representation to show anatomic structures. Models may be used in place of intact animals or organisms for teaching, practice, and study)"}, "madsrdf:citationSource": "MeSH 2018, via MeSH browser, Dec. 21, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a model)"}, "madsrdf:citationSource": "Work cat.: Larynx with tongue, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Allman's anatomical models, 189-?", "madsrdf:citationStatus": "found"}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Human anatomy models, 2005-", "madsrdf:citationStatus": "found"}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4be60509e77e402c91aa1711d10a4edbb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anatomic models"}}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anatomic models"}}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4be60509e77e402c91aa1711d10a4edbb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anatomy models"}}, {"@id": "_:n4be60509e77e402c91aa1711d10a4edbb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anatomy models"}}], "@id": "/authorities/genreForms/gf2017026150"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026151", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCantorial music", "identifiers:lccn": "gf2017026151", "madsrdf:adminMetadata": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b1"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cantorial music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026707"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026116"}], "madsrdf:hasSource": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b5"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b6"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b7"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b8"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b9"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b10"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b11"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b12"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b13"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b14"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b15"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b16"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b17"}], "madsrdf:hasVariant": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b18"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b21"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b24"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b27"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b30"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b33"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b36"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b39"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b42"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b45"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b48"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b51"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-03-13T13:22:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cantorial music"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 28 (\"I also became, in a private capacity, his expert on chazonim and chazones\")"}, "madsrdf:citationSource": "Weisgal, M.W. Meyer Weisgal ... so far, 1971:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The synagogal chant repertories are known as the collective noun, nusach. It serves today as the entire repertory for the lay precentor, but as the mere basis for the liturgical recitative of the professional cantor, whose liturgical art is called chazzanut)"}, "madsrdf:citationSource": "Sacred sound and social change : liturgical music in Jewish and Christian experience, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hazanout : chants liturgiques juifs, 1988.", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "People in music > Cantors > Elzam, Sylvain (Cantor Sylvain Elzam has released six CDs of music including Piyyutim, Selichos, with chazzanos for Sephardic and Ashkenazic nusach traditions)"}, "madsrdf:citationSource": "Jewish music WebCenter website, Dec. 22, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 5 (By definition, cantorial music is a specific genre of Jewish music that is reserved for the synagogue.) p. 19 (The Cantor's Assembly is the professional organization affiliated with the Conservative movement of Judaism; publishes a large assortment of printed cantorial music; the universe of cantorial music is quite vast)"}, "madsrdf:citationSource": "So you want to sing sacred music, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 103 (Cantorial music is first of all music in the service of the liturgical word) p. 81 (hazzanut) p. 48 (chazanut)"}, "madsrdf:citationSource": "Quotations on Jewish sacred music, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hazanuth; variants: or hazanut or hazzanuth or hazzanut or chazanuth or chazanut or chazzanuth or chazzanut; plural -s : cantorial singing or chanting : synagogal melodies)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Dec. 22, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\u1e24azzanut. Originally, as in the Siddur of Saadia Gaon, the term was applied to the piyyu\u1e6dim which it was the function of the official then called \"\u1e25azzan\" to recite. But as the duties of this official spread to the intonation of the whole of the service, the term came to be applied to the traditional form of melodious intonation)"}, "madsrdf:citationSource": "JewishEncyclopedia.com, Dec. 22, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. xxxix (Chazzanoet = Chazzanut (Hazzanut); art of the cantor, chants of the synagogue)"}, "madsrdf:citationSource": "Amsterdams chazzanoet, 1990:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jewish chants performed by cantors Gerson Sirota, Joseph Rosenblatt, Sophie Kurtzer, Leib Glantz, Savel Kwartin, Pincos Borenstein, and David Roitman)"}, "madsrdf:citationSource": "Work cat.: Cantorial gems. Volume 3, 196-?", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Music: The term \u1e25azzanut, derived from the title \u1e25azzan designates, either the official post or, more often, the specific melodies and musical style of the solo singer; \u1e25azzanut implies the free evolution of a melodic line (without reference to any system of harmony). The tune therefore proceeds by seconds and other small steps, while leaping intervals are avoided. The melodic texture is dense: there are no empty intervals, no extended notes that are enlivened by dissolution into small steps; musical tradition in \u1e25azzanut means a melodic pattern to be followed, the choice of a specific tetrachord or other scale, which is representative of a certain mood, or a stock of motives to be arranged and rearranged in changing melodic structures. The most ancient heritage of synagogue music cannot be confined to bar lines or enclosed in a framework of symmetric phrases. Its rhythm is as free as that of the Hebrew poetry of the time; Among the special features of the East Ashkenazi \u1e25azzanut was its emotional power, which was stressed in particular by the early writers)"}, "madsrdf:citationSource": "Encyclopaedia Judaica, 2007, via Gale virtual reference library, Dec. 22, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ashkenazi liturgical music in Israel today (the Jewish cantorial art known as \u1e25azzanut or \u1e25azonis)"}, "madsrdf:citationSource": "The performance of Jewish and Arab music in Israel today, \u00a91997, via Google books, viewed Dec. 22, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jewish chants. UF Chants (Jewish); Chazzanoet; Chazzanut; \u1e24azanut; \u1e24azones\u0300; Hazzanut. BT Chants; Jews--Music; Judaism--Liturgy--Texts; Synagogue music)"}, "madsrdf:citationSource": "LCSH, Dec. 22, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "\u1e24azonis"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "\u1e24azonis"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chazzanoet"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chazzanoet"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chazzanuth"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chazzanuth"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chazanuth"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chazanuth"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hazzanut"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hazzanut"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chazzanos"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chazzanos"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hazzanuth"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hazzanuth"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chazzanut"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chazzanut"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b42", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b43"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chazanut"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b43", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chazanut"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b45", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b46"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chazones"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b46", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chazones"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b48", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b49"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hazanut"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b49", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hazanut"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b51", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n96bd0130c212496886ad4ea34131a8d7b52"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hazanuth"}}, {"@id": "_:n96bd0130c212496886ad4ea34131a8d7b52", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hazanuth"}}], "@id": "/authorities/genreForms/gf2017026151"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026152", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLocal histories", "identifiers:lccn": "gf2017026152", "madsrdf:adminMetadata": [{"@id": "_:n8cde34003beb46378c58c553add9e5dab1"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Local histories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8cde34003beb46378c58c553add9e5dab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n8cde34003beb46378c58c553add9e5dab5"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab6"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab7"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab8"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab9"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab10"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab11"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab12"}], "madsrdf:hasVariant": {"@id": "_:n8cde34003beb46378c58c553add9e5dab13"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-03-13T13:22:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Local histories"}}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(local histories. SN Histories that are distinctly localized in subject matter or source materials, focusing on specific neighborhoods, communities, counties, or other specific subdivisions of larger geopolitical bodies. UF local history (document genre). BT histories (literature genre))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Dec. 22, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(local history: Materials of historical interest concerning the people and events in a small geographic area, such as a city, county, or town, including newspaper clippings, maps, photographs, posters, diaries, personal papers, community records, etc. Some libraries and historical societies are digitizing their local history collections)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and infromation science, Dec. 22, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (compiled by the Kitsap County Historical Society Book Committee)"}, "madsrdf:citationSource": "Kitsap County : a history , \u00a92012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subj. hdg.: Fall City (Wash.)--History)"}, "madsrdf:citationSource": "Kelley, Jack E. Jack's history of Fall City, King County, Washington, \u00a92006", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(local history 1. A written history focusing on a particular town, district, or other limited area. 2. Originally British the branch of history that deals with the social, economic, and cultural development of particular localities, often using local records and resources)"}, "madsrdf:citationSource": "Oxford dictionaries website, Dec. 22, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(local history: the history of a particular area)"}, "madsrdf:citationSource": "Longman dictionary of contemporary English online, Dec. 22, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (researched and written by Jacilee Wray, anthropologist, Olympic National Park ; with assistance from many, many Queets descendants) p. xi (This research extensively examines an array of sources to document the history of the Queets River valley, including important family accounts and Olympic National Park administrative records)"}, "madsrdf:citationSource": "Wray, J. River near the sea : an ethnohistory of the Queets River Valley, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subj. hdg.: Fairhaven (Bellingham, Wash.)--History)"}, "madsrdf:citationSource": "Work cat.: Griffin, B.L. Fairhaven : a history, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8cde34003beb46378c58c553add9e5dab14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Histories, Local"}}, {"@id": "_:n8cde34003beb46378c58c553add9e5dab14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Histories, Local"}}], "@id": "/authorities/genreForms/gf2017026152"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026156", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHip-hop (Music)", "identifiers:lccn": "gf2017026156", "madsrdf:adminMetadata": [{"@id": "_:n1c2c6c61be484a44866f33231193c475b1"}, {"@id": "_:n1c2c6c61be484a44866f33231193c475b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hip-hop (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1c2c6c61be484a44866f33231193c475b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027146"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026044"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026044"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027037"}, "madsrdf:hasSource": [{"@id": "_:n1c2c6c61be484a44866f33231193c475b5"}, {"@id": "_:n1c2c6c61be484a44866f33231193c475b6"}, {"@id": "_:n1c2c6c61be484a44866f33231193c475b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "For hip-hop lyrics that appear without a musical setting see [Hip-hop lyrics.]"}, {"@id": "_:n1c2c6c61be484a44866f33231193c475b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-05-26T14:29:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "revised"}, {"@id": "_:n1c2c6c61be484a44866f33231193c475b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n1c2c6c61be484a44866f33231193c475b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hip-hop (Music)"}}, {"@id": "_:n1c2c6c61be484a44866f33231193c475b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Hip-hop (\"Initially a cultural movement that arose among African Americans in the poor urban neighborhoods of New York in the late 1970s, and defined by the politics of exclusion, hip-hop music consists of one or more rappers who chant semiautobiographical tales in an intensely rhythmic lyrical form, making use of such rhetorical techniques as assonance, alliteration, and rhyme. The rapper is accompanied by an instrumental track . . . performed by a disc jockey (DJ), a record producer, or one or more instrumentalists\") Rap (\"Rap is a form of rhyming lyrics spoken rhythmically over musical instruments that typically uses a musical backdrop of sampling, scratching, and mixing by disc jockeys. Rapping is one of the elements of hip-hop\")"}, "madsrdf:citationSource": "Abjorensen, Norman. Historical dictionary of popular music, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c2c6c61be484a44866f33231193c475b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 10 (\"Many people do not have a clear understanding of the meanings of 'hip-hop' and 'rap,' and there is some disagreement about whether the terms are interchangeable . . . The most commonly held view, however, is that hip-hop is a cultural movement that emerged in the South Bronx in New York City during the 1970s, and MCing (or rapping; MC = master of ceremonies, also mic controller) is one of its four primary elements . . . Rap music has become by far the most celebrated expression of hip-hop culture, largely as a result of its being the easiest to market to a mass audience\")"}, "madsrdf:citationSource": "Music Library Association. Notes, September 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c2c6c61be484a44866f33231193c475b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Rap [disambiguation] (\"Rap, a genre of music, now widely considered to be a subgenre of Hip hop music, in which a performer speaks syncopated rhyming lyrics, often, but not always, over a musical rhythm and/or melody accompaniment (typically drums or electronic)\")"}, "madsrdf:citationSource": "Wikipedia, June 6, 2017:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026156"}
