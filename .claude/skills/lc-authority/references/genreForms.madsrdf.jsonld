{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026235", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExperimental films", "identifiers:lccn": "gf2011026235", "madsrdf:adminMetadata": [{"@id": "_:nf52fceceb11049c28323904f8166611db1"}, {"@id": "_:nf52fceceb11049c28323904f8166611db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Experimental films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf52fceceb11049c28323904f8166611db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026004"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026378"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026618"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026625"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026775"}], "madsrdf:hasSource": {"@id": "_:nf52fceceb11049c28323904f8166611db5"}, "madsrdf:hasVariant": [{"@id": "_:nf52fceceb11049c28323904f8166611db6"}, {"@id": "_:nf52fceceb11049c28323904f8166611db9"}, {"@id": "_:nf52fceceb11049c28323904f8166611db12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025206"}}, {"@id": "_:nf52fceceb11049c28323904f8166611db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nf52fceceb11049c28323904f8166611db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-23T16:19:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf52fceceb11049c28323904f8166611db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Experimental films"}}, {"@id": "_:nf52fceceb11049c28323904f8166611db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(experimental: work that seeks to expand traditional form, structure, and content, usually subjective in approach. Largely non-commercial, experimental work is often made by a single filmmaker or a small group; UF Avant-garde)"}, "madsrdf:citationSource": "Moving image genre-form guide online, July 2, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nf52fceceb11049c28323904f8166611db6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf52fceceb11049c28323904f8166611db7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Underground films"}}, {"@id": "_:nf52fceceb11049c28323904f8166611db7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Underground films"}}, {"@id": "_:nf52fceceb11049c28323904f8166611db9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf52fceceb11049c28323904f8166611db10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Personal films"}}, {"@id": "_:nf52fceceb11049c28323904f8166611db10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Personal films"}}, {"@id": "_:nf52fceceb11049c28323904f8166611db12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf52fceceb11049c28323904f8166611db13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Avant-garde films"}}, {"@id": "_:nf52fceceb11049c28323904f8166611db13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Avant-garde films"}}], "@id": "/authorities/genreForms/gf2011026235"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026236", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExploitation films", "identifiers:lccn": "gf2011026236", "madsrdf:adminMetadata": [{"@id": "_:n1c1e94590a124219ab3a07f59b383413b1"}, {"@id": "_:n1c1e94590a124219ab3a07f59b383413b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Exploitation films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1c1e94590a124219ab3a07f59b383413b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026585"}, "madsrdf:hasSource": [{"@id": "_:n1c1e94590a124219ab3a07f59b383413b5"}, {"@id": "_:n1c1e94590a124219ab3a07f59b383413b6"}, {"@id": "_:n1c1e94590a124219ab3a07f59b383413b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films of a sensational nature, usually offering subject matter taboo in mainstream cinema, usually produced on a low budget and often presented in the guise of preachy expos\u00e9s or pseudo-documentaries.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025324"}}, {"@id": "_:n1c1e94590a124219ab3a07f59b383413b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T13:45:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1c1e94590a124219ab3a07f59b383413b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n1c1e94590a124219ab3a07f59b383413b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Exploitation films"}}, {"@id": "_:n1c1e94590a124219ab3a07f59b383413b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Exploitation: Fictional or loosely nonfictional work which offered subject matter that was taboo in mainstream cinema. Such work was frequently presented under the guise of preachy expos\u00e9s, sex education, morality plays, and pseudo-documentaries. Standard topics included the dangers of premarital sex, the vice racket, nudist cults, or the dangers of narcotics. The work was made to exploit a subject for quick profit, and usually produced on a low budget by a small company. By pandering to an audience's curiosity or prurient interest, such work is on the borderline of censorship restrictions and recognizable for its emphasis on sensational aspects with little interest in artistic or social merit. Related terms, Erotic, Pornography)"}, "madsrdf:citationSource": "Moving image genre-form guide", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c1e94590a124219ab3a07f59b383413b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Exploitation film: a term used to describe low-budget movies of a sensational kind that either focus on some headline-making social phenomenon or attempt to cash in on a current box-office success. Sex, horror and fantasy are the predominant subject matters)"}, "madsrdf:citationSource": "Halliwell's filmgoer's & videoviewer's companion, c1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c1e94590a124219ab3a07f59b383413b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Exploitation works, use Erotica)"}, "madsrdf:citationSource": "Moving image materials : genre terms, 1988", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026236"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026238", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFan films", "identifiers:lccn": "gf2011026238", "madsrdf:adminMetadata": [{"@id": "_:nff95c0b487f6425e9bb7ac881a39423bb1"}, {"@id": "_:nff95c0b487f6425e9bb7ac881a39423bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fan films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nff95c0b487f6425e9bb7ac881a39423bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026038"}, "madsrdf:hasSource": {"@id": "_:nff95c0b487f6425e9bb7ac881a39423bb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Amateur films created by fans of a film, television program, comic book, etc.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025610"}}, {"@id": "_:nff95c0b487f6425e9bb7ac881a39423bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T13:46:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nff95c0b487f6425e9bb7ac881a39423bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nff95c0b487f6425e9bb7ac881a39423bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fan films"}}, {"@id": "_:nff95c0b487f6425e9bb7ac881a39423bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A fan film is a film or video inspired by a film, television program, comic book or a similar source, created by fans rather than the source's copyright holders or creators)"}, "madsrdf:citationSource": "Wikipedia, May 30, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026238"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026240", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFantasy comedies (Motion pictures)", "identifiers:lccn": "gf2011026240", "madsrdf:adminMetadata": [{"@id": "_:n05ed621fefef4663b2237444b34d936eb1"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fantasy comedies (Motion pictures)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n05ed621fefef4663b2237444b34d936eb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026147"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026242"}], "madsrdf:hasSource": [{"@id": "_:n05ed621fefef4663b2237444b34d936eb5"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb6"}], "madsrdf:hasVariant": [{"@id": "_:n05ed621fefef4663b2237444b34d936eb7"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb10"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb13"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb16"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb19"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb22"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature benevolent intervention by mythological or supernatural beings with comic results, or that feature incredible inventions or machines having a mind of their own.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025325"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-13T09:54:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantasy comedies (Motion pictures)"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 48 (Fantasy comedies; use for fictional genre films and programs which depict benevolent suprenatural intervention in the modern world by characters such as angels, benevolent ghosts or wiches, or the Devil in his more amiable incarnations. UF: Comedy fantasy; Fantastic comedies; Ghost comedies and romances; Heavenly comedies)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy-comedy; Comedy fantasy; Fantastic comedy. These films usually show playful devils, ghosts (see Ghost comedies), angels, or God interfering with the absurd lives of mortals. Other fantasy comedies deal with incredible inventions or with machines having a mind of their own)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n05ed621fefef4663b2237444b34d936eb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Films blanc"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Films blanc"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n05ed621fefef4663b2237444b34d936eb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ghost comedies (Motion pictures)"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghost comedies (Motion pictures)"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n05ed621fefef4663b2237444b34d936eb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comedy fantasy films"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedy fantasy films"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n05ed621fefef4663b2237444b34d936eb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fantasy comedy films"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantasy comedy films"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n05ed621fefef4663b2237444b34d936eb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Heavenly comedies (Motion pictures)"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heavenly comedies (Motion pictures)"}}, {"@id": "_:n05ed621fefef4663b2237444b34d936eb22", "@type": ["mads