{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026085", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRosh ha-Shanah sermons", "identifiers:lccn": "gf2019026085", "madsrdf:adminMetadata": [{"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b1"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rosh ha-Shanah sermons"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026107"}, "madsrdf:hasSource": [{"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b5"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b6"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b7"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b8"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b9"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b10"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b11"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b12"}], "madsrdf:hasVariant": [{"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b13"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b16"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b19"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b22"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b25"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b28"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b31"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b34"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b37"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b40"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b43"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b46"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T08:45:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rosh ha-Shanah sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rosh ha-Shanah. UF Jewish New Year; New Year, Jewish; Rosh Hashanah. BT High Holidays)"}, "madsrdf:citationSource": "LCSH, Jan. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rosh Hashanah: the Jewish New Year observed on the first day and by Orthodox and Conservative Jews also on the second day of Tishri)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Jan. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rosh ha-Shanah sermons. BT Jewish festival-day sermons)"}, "madsrdf:citationSource": "LCSH, Jan. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Rosh Hashanah; Jewish New Year, fall holiday, taking place at the beginning of the month of Tishrei; also known as Yom Hadin or the Day of Judgment, on which God opens the Books of Life and Death, which are then sealed on Yom Kippur)"}, "madsrdf:citationSource": "Rosh Hashanah 101, via My Jewish learning website, Jan. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rosh Hashana. Alternative names: Day of Judgment, Day of Remembrance, Rosh Ha-shanah, Rosh Hashanah, Yom Ha-Zikkaron, Yom Teruah. Rosh Hashana (Hebrew: \"Beginning of the Yea\"), Hashana also spelled Hashanah or Ha-shanah, also called Day of Judgment or Day of Remembrance, a major Jewish observance now accepted as inaugurating the religious New Year on Tishri 1 (September or October). Because the New Year ushers in a 10-day period of self-examination and penitence, Rosh Hashana is also called the annual Day of Judgment; during this period each Jew reviews his relationship with God, the Supreme Judge: also known as the Day of Remembrance, for on this day Jews commemorate the creation of the world, and the Jewish nation recalls its responsibilities as God's chosen people)"}, "madsrdf:citationSource": "Britannica online, Jan. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(most common name for this holiday is Rosh Hashanah; the Torah refers to this day as Yom Teruah (Day of Shofar Blowing); in our prayers, we often call it Yom Hazikaron (Day of Remembrance) and Yom Hadin (Day of Judgement) since this is the day when G-d recalls all of His creations and determines their fate for the year ahead; together with Yom Kippur (which always follows 10 days later), it is part of the Yamin Nora'im (Days of Awe, or High Holidays))"}, "madsrdf:citationSource": "What is Rosh Hashanah?, via Chabad.org website, Jan. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Yom HaDin (Alternate spelling: Yom Ha-Din, Yom ha-Din. \"Day of Judgement\"; alternate name for Rosh HaShanah) Yom T'ruah (\"Day of Shofar Blowing\"; alternate name for Rosh HaShana)"}, "madsrdf:citationSource": "Jewish glossary, via ReformJudaism.org website, Jan. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (a Rosh Hashanah sermon in commemoration of the bicentennial of American independence, 1975)"}, "madsrdf:citationSource": "Work cat: Cohon, B.D. Judaism in freedom, 1975:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Day of Judgment sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Day of Judgment sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rosh Hashana sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rosh Hashana sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yom Hazikaron sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yom Hazikaron sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Day of Judgement sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Day of Judgement sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yom Ha-Zikkaron sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yom Ha-Zikkaron sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jewish New Year sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jewish New Year sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yom Teruah sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yom Teruah sermons"}}, {"@id": "_:n2ed30e98ddf44ae38e3f36962022e663b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@l