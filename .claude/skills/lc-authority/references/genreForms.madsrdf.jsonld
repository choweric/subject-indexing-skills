{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026082", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAccordion fold books", "identifiers:lccn": "gf2022026082", "madsrdf:adminMetadata": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b1"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Accordion fold books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026197"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026080"}, "madsrdf:hasSource": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b5"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b6"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b7"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b8"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b9"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b10"}], "madsrdf:hasVariant": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b11"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b14"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b17"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b20"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b23"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b26"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b29"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b32"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b35"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b38"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b41"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b44"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b47"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b50"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b53"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b56"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b59"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b62"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b65"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b68"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b71"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b74"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b77"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b80"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b83"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b86"}], "madsrdf:historyNote": "[Established February 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-22T15:58:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Accordion fold books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an accordion book; limited edition of 50 copies, signed and numbered by the artist) (OCoLC)1066135829"}, "madsrdf:citationSource": "Work cat.: Chen, J. 1/2 century, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCSH, Sept. 29, 2022", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The accordion structure comprises a large group of books and variations, including orihon, sempuyo, nobiru gajo and nori-ire gajo; orihon book; The book artist may find the orihon indispensable for two or three of its characteristics: while it is possible to read each page or pair of pages individually, it is also possible to view all the pages at once, or in non-contiguous groups; the applications for both nobiru gajo and nori-ire gajo are the same as for orihon books; The sempuyo is also known as the \"flutter book\" because, although the pages are constrained at the back they are not attached, and if the book is read outdoors all the pages may flutter out of the covers in the breeze, causing some embarrassment to the reader and amusement to onlookers)"}, "madsrdf:citationSource": [{"@id": "https://userpages.umbc.edu/~custen/ArtistBooks/PDFs/Accordion%20styles.pdf"}, "Custen, C. Accordion-style books, 2000, via Art of the book website, Sept. 29, 2022"], "madsrdf:citationStatus": "found"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(accordion books. SN Folded books comprising a series of accordion or concertina style pleats and attached at one or both ends to stiff covers. The name leporello most likely comes from the manservant Leporello in Mozart's opera Don Giovanni, a famed rogue who keeps a tally of his conquests on a long accordion style list. In the late 19th century, leporello were common travel souvenirs consisting of depicted scenes or photographs of a region's tourist attractions. In Japan the accordion book is known as an orihon. UF concertina fold books; zig zag fold books; orihon; leporello books. BT folded books)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Sept. 29, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Accordion fold format. UF Double leaf format; Orihon format. BT Text block)"}, "madsrdf:citationSource": "RBMS Controlled vocabularies binding terms, via WWW, Sept. 29, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(orihon book; orihon format book; sempuyo book; nori-ire gajo books; nobiru gajo book construction)"}, "madsrdf:citationSource": "Google search, Sept. 29, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Accordion books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Accordion books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fold books, Zig zag"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fold books, Zig zag"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Flutter"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Flutter"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Concertina fold"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Concertina fold"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Nori-ire gajo"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Nori-ire gajo"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Zig zag fold books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zig zag fold books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Orihon format books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Orihon format books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Orihon books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Orihon books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Accordion-style books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Accordion-style books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b38", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b39"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Leporello books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b39", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Leporello books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b41", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b42"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Concertina fold books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b42", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Concertina fold books"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b44", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bbd4a97e8384df493585d355af8a733b45"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Accordion-style"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b45", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Accordion-style"}}, {"@id": "_:n0bbd4a97e8384df493585d355af8a733b47", "@type": ["madsrdf:Gen