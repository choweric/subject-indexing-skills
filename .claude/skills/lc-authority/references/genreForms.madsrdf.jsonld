ote": {"@language": "en", "@value": "(Cheering; the uttering or making sounds encouraging, stimulating or exciting to action, indicating approval or acclaiming or welcoming persons, announcements of events and the like)"}, "madsrdf:citationSource": "Wikipedia, viewed August 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n055abb896cc24a2996f792378e51a8e4b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n055abb896cc24a2996f792378e51a8e4b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "College cheers"}}, {"@id": "_:n055abb896cc24a2996f792378e51a8e4b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "College cheers"}}, {"@id": "_:n055abb896cc24a2996f792378e51a8e4b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n055abb896cc24a2996f792378e51a8e4b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yells"}}, {"@id": "_:n055abb896cc24a2996f792378e51a8e4b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yells"}}], "@id": "/authorities/genreForms/gf2014026710"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026711", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChicha", "identifiers:lccn": "gf2014026711", "madsrdf:adminMetadata": [{"@id": "_:n726a30129c5f441da7f66b6698b8f60db1"}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Chicha"}, "madsrdf:elementList": {"@list": [{"@id": "_:n726a30129c5f441da7f66b6698b8f60db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n726a30129c5f441da7f66b6698b8f60db5"}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db6"}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db7"}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db8"}], "madsrdf:hasVariant": {"@id": "_:n726a30129c5f441da7f66b6698b8f60db9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chicha"}}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (m\u00fasica popular peruana?)"}, "madsrdf:citationSource": "Huayno, vals, chicha, rock, 1986:", "madsrdf:citationStatus": "found"}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "volume 2, pages 484-485 (Andean migrant music; appeared in the early 1960s; chicha or cumbia andina; blended musical elements from the huayno with the cumbia)"}, "madsrdf:citationSource": "Garland encyclopedia of world music, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (m\u00fasica de los nuevos migrantes) p. 1-53 (chicha, m\u00fasica chicha, canciones chicha, chichero/chicheros; the form \"chichas\" not found)"}, "madsrdf:citationSource": "Work cat.: 96-120387: Chicha peruana, 1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db8", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove dict.;New Harvard dict. of music", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n726a30129c5f441da7f66b6698b8f60db10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cumbia andina"}}, {"@id": "_:n726a30129c5f441da7f66b6698b8f60db10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cumbia andina"}}], "@id": "/authorities/genreForms/gf2014026711"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026712", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChorale preludes", "identifiers:lccn": "gf2014026712", "madsrdf:adminMetadata": [{"@id": "_:n8da8748b8fcb4fd5a67b7e2bdfa64346b1"}, {"@id": "_:n8da8748b8fcb4fd5a67b7e2bdfa64346b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Chorale preludes"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8da8748b8fcb4fd5a67b7e2bdfa64346b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasSource": {"@id": "_:n8da8748b8fcb4fd5a67b7e2bdfa64346b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8da8748b8fcb4fd5a67b7e2bdfa64346b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8da8748b8fcb4fd5a67b7e2bdfa64346b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8da8748b8fcb4fd5a67b7e2bdfa64346b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chorale preludes"}}, {"@id": "_:n8da8748b8fcb4fd5a67b7e2bdfa64346b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Chorale prelude (Ger. Choralvorspiel); a relatively short setting for organ of a single chorale strophe intended to introduce the hymn tune to be sung by the congregation. The chorale prelude as an autonomous genre was developed by the north German composers of the mid- and later 17th century, notably Buxtehude. The chorale melody, often decorated with expressive ornaments, is usually presented over a mildly polyphonic accompaniment without any interludes separating the individual chorale phrases.)"}, "madsrdf:citationSource": "Grove music online, July 7, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026712"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026713", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChorales", "identifiers:lccn": "gf2014026713", "madsrdf:adminMetadata": [{"@id": "_:n0219be830c204b5281a848aac73f69dfb1"}, {"@id": "_:n0219be830c204b5281a848aac73f69dfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Chorales"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0219be830c204b5281a848aac73f69dfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026872"}, "madsrdf:hasSource": {"@id": "_:n0219be830c204b5281a848aac73f69dfb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0219be830c204b5281a848aac73f69dfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0219be830c204b5281a848aac73f69dfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0219be830c204b5281a848aac73f69dfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chorales"}}, {"@id": "_:n0219be830c204b5281a848aac73f69dfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The congregational hymn of the German Protestant church service. Typically, it possesses certain formal and stylistic traits appropriate to its lay purposes: simple language, rhymed metrical verse, a strophic musical and textual form and an easily singable melody.)"}, "madsrdf:citationSource": "Grove music online, viewed May 29, 2014 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026713"}
