b51b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television programs for the hearing impaired"}}, {"@id": "_:nf72feedd5914462e8e5e80b54bf8ab51b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(captioned film: a film with superimposed titles to help the hearing impaired persons to follow the dialogue and lyrics or for everyone to translate dialectical or foreign language films into the local language)"}, "madsrdf:citationSource": "Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nf72feedd5914462e8e5e80b54bf8ab51b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf72feedd5914462e8e5e80b54bf8ab51b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Closed captioned television programs"}}, {"@id": "_:nf72feedd5914462e8e5e80b54bf8ab51b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Closed captioned television programs"}}, {"@id": "_:nf72feedd5914462e8e5e80b54bf8ab51b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf72feedd5914462e8e5e80b54bf8ab51b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Captioned television programs"}}, {"@id": "_:nf72feedd5914462e8e5e80b54bf8ab51b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Captioned television programs"}}, {"@id": "_:nf72feedd5914462e8e5e80b54bf8ab51b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf72feedd5914462e8e5e80b54bf8ab51b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television programs for the deaf"}}, {"@id": "_:nf72feedd5914462e8e5e80b54bf8ab51b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television programs for the deaf"}}], "@id": "/authorities/genreForms/gf2011026675"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026676", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision public service announcements", "identifiers:lccn": "gf2011026676", "madsrdf:adminMetadata": [{"@id": "_:ne2824b04747345088dadd25b41a1ac30b1"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television public service announcements"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne2824b04747345088dadd25b41a1ac30b3"}]}, "madsrdf:exampleNote": "Note under [Public service television programs]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026038"}], "madsrdf:hasSource": [{"@id": "_:ne2824b04747345088dadd25b41a1ac30b5"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b6"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b7"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b8"}], "madsrdf:hasVariant": [{"@id": "_:ne2824b04747345088dadd25b41a1ac30b9"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b12"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b15"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b18"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b21"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television announcements aired by or on behalf of nonprofit or governmental organizations to persuade the audience to take some specific action or adopt a favorable view toward a service, institution, or cause. For television programs aired by or on behalf of nonprofit or governmental organizations to promote the common well-being or general welfare of society see [Public service television programs.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025639"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-02-17T09:41:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television public service announcements"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(television public service announcements: 32,200 hits)"}, "madsrdf:citationSource": "Google, Aug. 20, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Public service announcement: work which promotes certain charitable causes or types of behavior, such as promoting contributions to the American Cancer Society, encouraging girls to join the Girl Scouts, urging people on the behalf of The U.S. Treasury Department to purchase savings bonds, or encouraging people on behalf of the American Dairy Association to drink milk)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 5, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 81 (Public service: use for a short film or videorecording presented by, or on behalf of, a nonprofit organization which attempts to persuade the audience to take some specific action or adopt a favorable view toward some service, institution or cause)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A public service announcement (PSA) or community service announcement (CSA) is a non-commercial advertisement typically on radio or television, ostensibly broadcast for the public good. The main concept is to modify public attitudes by raising awareness about specific issues)"}, "madsrdf:citationSource": "Wikipedia, December 5, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2824b04747345088dadd25b41a1ac30b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "CSAs, Television"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "CSAs, Television"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2824b04747345088dadd25b41a1ac30b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Public service announcements, Television"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Public service announcements, Television"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2824b04747345088dadd25b41a1ac30b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television CSAs"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television CSAs"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2824b04747345088dadd25b41a1ac30b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television PSAs"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television PSAs"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2824b04747345088dadd25b41a1ac30b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "PSAs, Television"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "PSAs, Television"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2824b04747345088dadd25b41a1ac30b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television community service announcements"}}, {"@id": "_:ne2824b04747345088dadd25b41a1ac30b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television community service announcements"}}], "@id": "/authorities/genreForms/gf2011026676"}
