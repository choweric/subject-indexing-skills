{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026796", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExtreme metal (Music)", "identifiers:lccn": "gf2014026796", "madsrdf:adminMetadata": [{"@id": "_:na3ac797cb25e40b9aeb0ce1652b7f042b1"}, {"@id": "_:na3ac797cb25e40b9aeb0ce1652b7f042b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Extreme metal (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na3ac797cb25e40b9aeb0ce1652b7f042b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026854"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026136"}, "madsrdf:hasSource": [{"@id": "_:na3ac797cb25e40b9aeb0ce1652b7f042b5"}, {"@id": "_:na3ac797cb25e40b9aeb0ce1652b7f042b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na3ac797cb25e40b9aeb0ce1652b7f042b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na3ac797cb25e40b9aeb0ce1652b7f042b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na3ac797cb25e40b9aeb0ce1652b7f042b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Extreme metal (Music)"}}, {"@id": "_:na3ac797cb25e40b9aeb0ce1652b7f042b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ECIP data view (one step beyond heavy metal; consists of dangerous themes such as death, war, and the occult, sometimes embracing violence, neo-fascism, and Satanism)"}, "madsrdf:citationSource": "Work cat.: 2006027931: Kahn-Harris, Keith. Extreme metal, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:na3ac797cb25e40b9aeb0ce1652b7f042b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Extreme metal is a broad term for metal subgenres of a more aggressive style than traditional heavy metal; vocals are performed in a growl, scream, or both)"}, "madsrdf:citationSource": "Wikipedia, Aug. 24, 2006", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026796"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026797", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFados", "identifiers:lccn": "gf2014026797", "madsrdf:adminMetadata": [{"@id": "_:n39769915bda34ecea4a57ce0cf43692ab1"}, {"@id": "_:n39769915bda34ecea4a57ce0cf43692ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fados"}, "madsrdf:elementList": {"@list": [{"@id": "_:n39769915bda34ecea4a57ce0cf43692ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, "madsrdf:hasSource": {"@id": "_:n39769915bda34ecea4a57ce0cf43692ab5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n39769915bda34ecea4a57ce0cf43692ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n39769915bda34ecea4a57ce0cf43692ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n39769915bda34ecea4a57ce0cf43692ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fados"}}, {"@id": "_:n39769915bda34ecea4a57ce0cf43692ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fado. Portuguese vocal and dance genre; performances involve a solo vocalist as central figure, instrumental accompanists and audiences in a communicative process using verbal, musical, facial and bodily expression. Live fado performances are complex events in which fado performers construct narratives, express ideas and emotions through the skilful interplay between words, melodies and their variation, vocal quality, gestures, facial expression and instrumental dialogue)"}, "madsrdf:citationSource": "Grove music online, viewed August 24, 2013", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026797"}
