ecordStatus": "revised"}, {"@id": "_:n914d546bd478439ea63daac33bcdc8edb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Silhouette animation films"}}, {"@id": "_:n914d546bd478439ea63daac33bcdc8edb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Silhouette animation: type of animation using intricately cut-out paper figures silhouetted with backlighting. Variations of the technique use backlit sand or other materials. UF: Sand animation)"}, "madsrdf:citationSource": "Moving image genre-form guide online, June 4, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n914d546bd478439ea63daac33bcdc8edb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 88 (Silhouette animation: use for animation of silhouettes, which are cut out, projected, or formed in some other manner, and then photographed with single frame exposures. UF: Flat-figure animation; Semi-object animation)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n914d546bd478439ea63daac33bcdc8edb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Silhouette animation: animation in which the characters are only visible as black silhouettes. The medium was invented through a combination of shadow play and silhouette cutting by the German animator Lotte Reiniger)"}, "madsrdf:citationSource": "Wikipedia website, April 14, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n914d546bd478439ea63daac33bcdc8edb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n914d546bd478439ea63daac33bcdc8edb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Flat-figure animation films"}}, {"@id": "_:n914d546bd478439ea63daac33bcdc8edb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flat-figure animation films"}}, {"@id": "_:n914d546bd478439ea63daac33bcdc8edb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n914d546bd478439ea63daac33bcdc8edb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Semi-object animation films"}}, {"@id": "_:n914d546bd478439ea63daac33bcdc8edb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Semi-object animation films"}}, {"@id": "_:n914d546bd478439ea63daac33bcdc8edb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n914d546bd478439ea63daac33bcdc8edb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sand animation films"}}, {"@id": "_:n914d546bd478439ea63daac33bcdc8edb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sand animation films"}}], "@id": "/authorities/genreForms/gf2011026576"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026577", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSinging cowboy films", "identifiers:lccn": "gf2011026577", "madsrdf:adminMetadata": [{"@id": "_:n9745a6eb02bb4baf9fbc9d4d7ae92b88b1"}, {"@id": "_:n9745a6eb02bb4baf9fbc9d4d7ae92b88b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Singing cowboy films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9745a6eb02bb4baf9fbc9d4d7ae92b88b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026735"}, "madsrdf:hasSource": {"@id": "_:n9745a6eb02bb4baf9fbc9d4d7ae92b88b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature a non-violent, singing cowboy hero.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025622"}}, {"@id": "_:n9745a6eb02bb4baf9fbc9d4d7ae92b88b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:09:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9745a6eb02bb4baf9fbc9d4d7ae92b88b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9745a6eb02bb4baf9fbc9d4d7ae92b88b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Singing cowboy films"}}, {"@id": "_:n9745a6eb02bb4baf9fbc9d4d7ae92b88b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Singing cowboy: fictional Western, usually lasting from sixty to eighty minutes, in which the standard formula is carried out in a more light-hearted, sometimes perfunctory way. The concentration is usually on ranch life, and the setting is often in the present or in an ambiguous time, rather than the more typical Western period of the late 19th century. The hero is a non-violent cowboy who is pure of heart, and behaves and dresses in a more elegant manner than most non-singing cowboys. The distinguishing aspect of the Singing cowboy from the Western is that the hero's vocal and musical skills are as important as his gunslinging. The two elements are fully integrated, and the plot periodically pauses, in the manner of a musical, to allow interludes for songs and production numbers, usually five to ten in each film. Music and action are blended in a manner to broaden the potential audience beyond western fans. Since the stars often play themselves, the films frequently contain a large measure of reflexivity, mixing their involvement in the entertainment industry and western exploits. The genre was most popular from the mid 1930s, with the emergence of Gene Autry and Roy Rogers, into the early 1950s. Note: Do not use for westerns that merely contain a few songs, sung by a secondary character. For a musical of a different nature with a western background, use Musical in conjunction with Western)"}, "madsrdf:citationSource": "Moving image genre-form guide online, Dec. 5, 2007:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026577"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026578", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSinging cowboy television programs", "identifiers:lccn": "gf2011026578", "madsrdf:adminMetadata": [{"@id": "_:n605171a06aaf407983d4db39ede1724eb1"}, {"@id": "_:n605171a06aaf407983d4db39ede1724eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Singing cowboy television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n605171a06aaf407983d4db39ede1724eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026737"}, "madsrdf:hasSource": {"@id": "_:n605171a06aaf407983d4db39ede1724eb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that feature a non-violent, singing cowboy hero.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025623"}}, {"@id": "_:n605171a06aaf407983d4db39ede1724eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:09:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n605171a06aaf407983d4db39ede1724eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n605171a06aaf407983d4db39ede1724eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Singing cowboy television programs"}}, {"@id": "_:n605171a06aaf407983d4db39ede1724eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Singing cowboy: fictional Western, usually lasting from sixty to eighty minutes, in which the standard formula is carried out in a more light-hearted, sometimes perfunctory way. The concentration is usually on ranch life, and the setting is often in the present or in an ambiguous time, rather than the more typical Western period of the late 19th century. The hero is a non-violent cowboy who is pure of heart, and behaves and dresses in a more elegant manner than most non-singing cowboys. The distinguishing aspect of the Singing cowboy from the Western is that the hero's vocal and musical skills are as important as his gunslinging. The two elements are fully integrated, and the plot periodically pauses, in the manner of a musical, to allow interludes for songs and production numbers, usually five to ten in each film. Music and action are blended in a manner to broaden the potential audience beyond western fans. Since the stars often play themselves, the films frequently contain a large measure of reflexivity, mixing their involvement in the entertainment industry and western exploits. The genre was most popular from the mid 1930s, with the emergence of Gene Autry and Roy Rogers, into the early 1950s. Note: Do not use for westerns that merely contain a few songs, sung by a secondary character. For a musical of a different nature with a western background, use Musical in conjunction with Western)"}, "madsrdf:citationSource": "Moving image genre-form guide online, Dec. 5, 2007:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026578"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026579", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSituation comedies (Television programs)", "identifiers:lccn": "gf2011026579", "madsrdf:adminMetadata": [{"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb1"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Situation comedies (Television programs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026654"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026211"}, "madsrdf:hasSource": [{"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb5"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb6"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb7"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb8"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb9"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb10"}], "madsrdf:hasVariant": [{"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb11"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb14"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025378"}}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:11:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Situation comedies (Television programs)"}}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mills, B. Television sitcom, 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Situation comedy: Fictional work for television, normally running a half hour in length, which creates humor around the lives of a cast of recurring characters and the \"situations\" in which they find themselves. Generally, regardless of what happens in any given episode, the characters remain in the same relationships and position as they were before, and much of the humor derives from this predictability. The characters seldom change, and react in an expected manner to whatever challenges them, and generally the overall tenor of the shows is upbeat, expecting a happy, satisfying resolution. Everyday life is often an important element, and as a result, although the setting could be almost anywhere, most situation comedies are set in the home or workplace)"}, "madsrdf:citationSource": "Moving image genre/form guide via WWW, Oct. 31, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "table of contents (Television sitcoms)"}, "madsrdf:citationSource": "Comedy : geographic and historical guide, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Situation comedies: use for a comic series or serial in which the same characters involved in the same setting and circumstances (\"situation\") are used in episode after episode; UF Sitcoms; BT: Comedies)"}, "madsrdf:citationSource": "Moving image materials, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hamamoto, D.Y. Nervous laughter : television situation comedy and liberal democratic ideology, 1989.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Situation comedy (Sitcom): Essentially a television form, situation comedy or sitcom (usually designed to fill up a half-hour slot); same characters reappearing with each installment; characters behave predictably; most located in the home, others where the characters work; typical is the insertion of a laugh-track)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sitcoms (Television programs)"}}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sitcoms (Television programs)"}}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television situation comedies"}}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television situation comedies"}}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television sitcoms"}}, {"@id": "_:n2a1b330ddc7c4d04a397c3c09470525cb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television sitcoms"}}], "@id": "/authorities/genreForms/gf2011026579"}
