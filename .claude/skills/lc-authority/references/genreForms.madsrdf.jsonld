, "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cajun music"}}, {"@id": "_:n458c6536140e4bd4b9a23255433d15d2b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Swampland jewels : Cajun music from the Louisiana bayous [SR] p1991.", "madsrdf:citationStatus": "found"}, {"@id": "_:n458c6536140e4bd4b9a23255433d15d2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Zydeco: The closely related music as performed by white musicians is usually termed Cajun.)"}, "madsrdf:citationSource": "New Harvard dict. of music", "madsrdf:citationStatus": "found"}, {"@id": "_:n458c6536140e4bd4b9a23255433d15d2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Musical genre indigenous to Louisiana among descendants of French colonialists ...)"}, "madsrdf:citationSource": "Penguin encyc. of popular music", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026679"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026680", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCalypso (Music)", "identifiers:lccn": "gf2014026680", "madsrdf:adminMetadata": [{"@id": "_:nd247cf6624784eca8414f9bfc7ca368fb1"}, {"@id": "_:nd247cf6624784eca8414f9bfc7ca368fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Calypso (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd247cf6624784eca8414f9bfc7ca368fb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026694"}, "madsrdf:hasSource": [{"@id": "_:nd247cf6624784eca8414f9bfc7ca368fb5"}, {"@id": "_:nd247cf6624784eca8414f9bfc7ca368fb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd247cf6624784eca8414f9bfc7ca368fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd247cf6624784eca8414f9bfc7ca368fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd247cf6624784eca8414f9bfc7ca368fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Calypso (Music)"}}, {"@id": "_:nd247cf6624784eca8414f9bfc7ca368fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a kind of West Indian music or song in syncopated African rhythm, typically with words improvised on a topical theme...Calypso has earned its place in history as the national folk song of Trinidad and Tobago and the music of the Caribbean after the emancipation of the slaves.)"}, "madsrdf:citationSource": "Trinidad and Tobago National Library and Information System Authority (NALIS) WWW site, Jan. 31, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd247cf6624784eca8414f9bfc7ca368fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A style of music, dance and song of the southern and eastern Caribbean. Its main development has been in Trinidad alongside the evolution of Carnival celebrations there.)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Jan. 31, 2012:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026680"}
