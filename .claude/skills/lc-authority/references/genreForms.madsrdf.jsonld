{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026132", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTopographical poetry", "identifiers:lccn": "gf2018026132", "madsrdf:adminMetadata": [{"@id": "_:na18d562d63e446e396be8a2309f9de20b1"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Topographical poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:na18d562d63e446e396be8a2309f9de20b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026040"}, "madsrdf:hasSource": [{"@id": "_:na18d562d63e446e396be8a2309f9de20b5"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b6"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b7"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b8"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b9"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b10"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b11"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b12"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b13"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b14"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b15"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b16"}], "madsrdf:hasVariant": [{"@id": "_:na18d562d63e446e396be8a2309f9de20b17"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b20"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b23"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b26"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b29"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry about specific geographic locations."}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:23:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topographical poetry"}}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(topographical poetry; Cooper's Hill (1642) by Denham is an early example of a genre that flourished principally in the 18th cent. Many topographical poems are also \"prospect poems\", i.e. written from a high point, surveying a large view, and many were written in praise of particular parks, estates, and gardens, evidently in the hope of patronage. The genre had a renewed vogue in the late 20th cent., when the emphasis has been less on the country estate, more on the vanishing rural scene)"}, "madsrdf:citationSource": "The concise Oxford companion to English literature, 2007, via ProQuest Literature online, Oct. 2, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(topographical poetry; aims chiefly at describing specifically named actual localities; it re-creates a landscape or a generalized prospect, which is why C.V. Deane called it \"prospect poetry\"; the archaic term chorography (from the Greek: \"writing about countries\") is used interchangeably with topographical poetry)"}, "madsrdf:citationSource": "Hirsch, E. The essential poet's glossary, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 115 (chorography; well-established tradition of chorographical poetry in antiquity. Ausonius's fourth-century poem, 'Mosella,' offers a description of a journey down the Moselle river; poems emphasize the geographical and topographical features of the landscapes) p. 119 (chorographical verse; chorographic poetry in English)"}, "madsrdf:citationSource": "Galbraith, D.I. Architectonics of imitation in Spenser, Daniel, and Drayton, \u00a92000:", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bethell, J. Llangunnor Hill : a loco-descriptive poem, 1794.", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(31 volume set edited by Henry Wadsworth Longfellow; contents: [v. 1-4] England and Wales -- [v. 5] Ireland -- [v. 6-8] Scotland, Denmark, Iceland, Norway, and Sweden -- [v. 9-10] France and Savoy -- [v. 11-13] Italy -- [v. 14-15] Spain, Portugal, Belgium, and Holland -- [v. 16] Switzerland -- [v. 17-18] Germany -- [v. 19] Greece and Turkey in Europe -- [v. 20] Russia -- [v. 21-23] Asia -- [v. 24] Africa -- [v. 25-30] America -- [v. 31] Oceanica)"}, "madsrdf:citationSource": "Poems of places, 1876-1879", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(contents: Girl, England -- How English can you get -- Welsh words song -- Aberystwyth -- Van Gogh's room -- Landschaft -- In Gordon's studio, Rome -- On the train through Bulgaria -- Couchette -- Albania -- Hotel Ediz -- In Naga land, Nepal)"}, "madsrdf:citationSource": "Work cat.: Waldman, A. Countries : poems, 1980", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Aubin, R.A. Topographical poetry in XVIII-century England, 1936.", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetry of places. UF Topographical poetry. BT Local color in literature. BT Poetry. RT Cities and towns in literature. SN Here are entered collections of poetry about several places in various parts of the world. Poetry about individual places is entered under the name of the place with subdivision Poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 2, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetry of places. Scope Note: Use for collections of poetry about several places in various parts of the world. Used For: Topographical poetry. Broader Term: Poems)"}, "madsrdf:citationSource": "RBMS controlled vocabularies: genre terms, viewed Oct. 2, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Here and there : 100 poems about places, 1967.", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (topographic poetry: Verse which portrays a particular place, whether city, town or landscape. Topographic poetry generally also includes meditative sections in which the poet describes his or her reaction to the topography)"}, "madsrdf:citationSource": "Strachan, J. Poetry : an introduction, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(topographical poetry: Poetry devoted to the description of specific places, usually with additional meditative passages. Following John Denham's poem 'Cooper's Hill' (1642), topographical poetry became a significant genre of English verse throughout the 18th century, culminating in the poems of Wordsworth, notably his 'Lines Composed a few miles above Tintern Abbey, on revisiting the banks of the Wye during a tour. July 13, 1798' (usually called 'Tintern Abbey'). This kind of poetry is sometimes called loco-descriptive verse)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, 2008, via ProQuest Literature online, Oct. 2, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na18d562d63e446e396be8a2309f9de20b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poetry of places"}}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poetry of places"}}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na18d562d63e446e396be8a2309f9de20b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chorographical poetry"}}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chorographical poetry"}}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na18d562d63e446e396be8a2309f9de20b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chorographic poetry"}}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chorographic poetry"}}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na18d562d63e446e396be8a2309f9de20b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poems of places"}}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poems of places"}}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na18d562d63e446e396be8a2309f9de20b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Topographic poetry"}}, {"@id": "_:na18d562d63e446e396be8a2309f9de20b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topographic poetry"}}], "@id": "/authorities/genreForms/gf2018026132"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026133", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aImprovisations (Music)", "identifiers:lccn": "gf2018026133", "madsrdf:adminMetadata": [{"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb1"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Improvisations (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026075"}, "madsrdf:hasSource": [{"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb5"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb6"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb7"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb8"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb9"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb10"}], "madsrdf:hasVariant": {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical performances or transcriptions of musical performances that consist wholly or primarily of improvised musical content."}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:23:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Improvisations (Music)"}}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(disc includes narrated tour of the stops of the organ along with improvisations demonstrating each stop)"}, "madsrdf:citationSource": "Daniel Roth plays the Cavaill\u00e9-Coll at Saint-Ouen in Rouen, France, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(score contains transcriptions of improvised solos from J.J. Johnson's recordings)"}, "madsrdf:citationSource": "Johnson, J.J. Solos, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Jarrett, Keith (\"In 1972 Jarrett began performing solo concerts which consisted simply of two extended improvisations, each usually 30 to 45 minutes in length. The music spanned a rich variety of traditions ... illuminating Jarrett's reference to his work as universal folk music\")"}, "madsrdf:citationSource": "New Grove dictionary of jazz, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "improvisation (\"The creation of a musical work, or the final form of a musical work, as it is being performed. It may involve the work's immediate composition by its performers, or the elaboration or adjustment of an existing framework, or anything in between. To some extent every performance involves elements of improvisation, although its degree varies according to period and place, and to some extent every improvisation rests on a series of conventions or implicit rules. The term 'extemporization' is used more or less interchangeably with 'improvisation'\")"}, "madsrdf:citationSource": "Grove music online, August 24, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (\"This album is a set of structured improvisations ... Our goal was to explore the sonic possibilities of bassoon, guitar, and percussion as a trio\")"}, "madsrdf:citationSource": "Ex Mus Ensemble. Album no. 1, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(recorded performances include completely improvised sequences (taq\u0101s\u012bm) which conform to traditions of improvisation in Arabic music)"}, "madsrdf:citationSource": "A\u1e63\u012bl Ensemble. A\u1e63\u012bl, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Extemporizations (Music)"}}, {"@id": "_:n3fd2e1f1878443a8b9723a62eefb9a5cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Extemporizations (Music)"}}], "@id": "/authorities/genreForms/gf2018026133"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026134", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCarolina beach music", "identifiers:lccn": "gf2018026134", "madsrdf:adminMetadata": [{"@id": "_:n3f7776148ce5489fa0116936194507dcb1"}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Carolina beach music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3f7776148ce5489fa0116936194507dcb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027052"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027106"}], "madsrdf:hasSource": [{"@id": "_:n3f7776148ce5489fa0116936194507dcb5"}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb6"}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb7"}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb8"}], "madsrdf:hasVariant": {"@id": "_:n3f7776148ce5489fa0116936194507dcb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-12-15T13:37:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Carolina beach music"}}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p.12-15 (music derived from 1950s and 60s rhythm and blues and soul music played in juke joints on the North and South Carolina coast; the name beach music began to be used to describe the music in the 1960s and 70s; often accompanies shag dancing)"}, "madsrdf:citationSource": "Simmons, R. Carolina beach music: the classic years, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beach Music is uptempo, good-time pop-soul--in other words, it's party music. Appropriately, it received its name through its constant presence at parties on the Eastern coast)"}, "madsrdf:citationSource": "AllMusic WWW site, September 7, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Simmons, R. Carolina beach music encyclopedia, 2018.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "subtitle on container (20 great Carolina beach music and R&B classics)"}, "madsrdf:citationSource": "Work cat: Walk that walk!, 1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3f7776148ce5489fa0116936194507dcb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Beach music"}}, {"@id": "_:n3f7776148ce5489fa0116936194507dcb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Beach music"}}], "@id": "/authorities/genreForms/gf2018026134"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026135", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJump blues (Music)", "identifiers:lccn": "gf2018026135", "madsrdf:adminMetadata": [{"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb1"}, {"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jump blues (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026665"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027119"}], "madsrdf:hasSource": [{"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb5"}, {"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb6"}, {"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb7"}, {"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-03T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-02-21T10:27:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jump blues (Music)"}}, {"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (jump blues)"}, "madsrdf:citationSource": "Work cat: Eight O'Five Jive (Musical group). Too many men, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Eight O'Five Jive - Too Many Men Album Review (music is jump or swing blues, \"which mixes high-tempo beats with traditional blues rhythms and melodies\")"}, "madsrdf:citationSource": "Blues Blast magazine WWW site, Aug. 22, 2018):", "madsrdf:citationStatus": "found"}, {"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert (\"Marked by a front line of horns (heavy on the saxophones), backed by a powerful rhythm section and propelled by a strong 'back beat' on the drums, the jump combos were long on danceability and short on subtlety. Most of the songs followed either the 12-bar blues pattern or used the 'I Got Rhythm' chord changes favored by the beboppers\")"}, "madsrdf:citationSource": "Specialty legends of jump blues, volume 1, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n42a56704f9d64077acb8de8bb69a30ccb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p.xi (\"Jump Blues refers to an uptempo, jazz-tinged style of blues that first came to prominence in the mid- to late-40s. Usually featuring a vocalist in front of a large, horn-driven orchestra or medium sized combo with multiple horns, the style is earmarked by a driving rhythm, intensely shouted vocals, and honking tenor saxophone solors - all of those very elements a precusor to rock and roll\")"}, "madsrdf:citationSource": "Bogandov, Vladimir et all, eds. All Music guide to blues, 2003", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026135"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026136", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCrust (Music)", "identifiers:lccn": "gf2018026136", "madsrdf:adminMetadata": [{"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b1"}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Crust (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026796"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026850"}], "madsrdf:hasSource": [{"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b5"}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b6"}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b7"}], "madsrdf:hasVariant": [{"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b8"}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b11"}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-02-21T10:27:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-03T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crust (Music)"}}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(genre not given)"}, "madsrdf:citationSource": "Work cat: His Hero Is Gone (Musical group). Fifteen counts of arson, 1996", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Crust punk (also known as crustcore, stenchcore, or crust; \"a form of music influenced by English punk rock and extreme metal\")"}, "madsrdf:citationSource": "Wikipedia, November 6, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under His Hero Is Gone - Fifteen Counts of Arson (style: Hardcore, Punk, Crust) ; under Crust (\"Crust (or crust punk) is a form of music influenced by hardcore punk and extreme metal. The style, which evolved in the mid-1980s in England, often has songs with dark and pessimistic lyrics that linger on political and social ills. The term \"crust\" was coined by Hellbastard on their 1986 Ripper Crust demo. Crust is partly defined by its \"bassy\" and \"dirty\" sound. It is often played at a fast tempo with occasional slow sections. Vocals are usually guttural and may be grunted, growled or screamed\")"}, "madsrdf:citationSource": "Discogs WWW site, November 6, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stenchcore (Music)"}}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stenchcore (Music)"}}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crust punk (Music)"}}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crust punk (Music)"}}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crustcore (Music)"}}, {"@id": "_:nd0cb0a9f48434b48a1d8d574f5a0aee8b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crustcore (Music)"}}], "@id": "/authorities/genreForms/gf2018026136"}
