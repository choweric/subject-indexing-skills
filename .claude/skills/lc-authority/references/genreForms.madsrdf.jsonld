{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026065", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHagiographical films", "identifiers:lccn": "gf2016026065", "madsrdf:adminMetadata": [{"@id": "_:n9ac500282aab4851b20409fc106bfd51b1"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hagiographical films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9ac500282aab4851b20409fc106bfd51b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026089"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026526"}], "madsrdf:hasSource": [{"@id": "_:n9ac500282aab4851b20409fc106bfd51b5"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b6"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b7"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b8"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b9"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b10"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b11"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b12"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b13"}], "madsrdf:hasVariant": [{"@id": "_:n9ac500282aab4851b20409fc106bfd51b14"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b17"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-05-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-08-11T17:27:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hagiographical films"}}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Il vangelo secondo Matteo, c2003.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "La passion de Jeanne d'Arc = Passion of Joan of Arc, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Joan of Arc (1948 film) (Joan of Arc is a 1948 American hagiographic epic film directed by Victor Fleming, and starring Ingrid Bergman as the French religious icon and war heroine) Brahmashri Vishwamitra (Brahmashri Vishwamitra is a 1991 Telugu hagiographical film produced & directed by N. T. Rama Rao. The story is based on the life of Vishvamitra who is one of the most venerated sages of ancient times in India) Sri Shirdi Saibaba Mahathyam (Sri Shirdi Saibaba Mahathyam is a 1986 Telugu hagiographical film directed by K. Vasu. The film is based on the life of Shirdi Sai Baba, who has preached and practiced religious humanism)"}, "madsrdf:citationSource": "Wikipedia, May 17, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Francesco, giullare di Dio = The flowers of St. Francis, c2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 1-2 (films that represent the life, or part of the life, of a recognized religious hero; a genre which I call the hagiopic--the \"holy\" or \"saint\" picture; the hagiopic is closely related to the biopic--the biographical film--but there are significant differences. Unlike the biopic, the hagiopic is concerned with its hero's relationship to the divine; and the world the hagiopic portrays is a place found in no other genre of films, a place where miracles occur, celestial beings speak to humans, and events are controlled by a benevolent God, who lives somewhere beyond the clouds; the term \"hagiopic\" also suggests hagiography, a significant feature of the genre; hagiopics can be about heroes in any religious tradition) p. 3 (In a far more direct way than any other film genre, the hagiopic deals with basic questions about suffering, injustice, a sense of meaninglessness, and a longing for something beyond the world we know)"}, "madsrdf:citationSource": "Grace, P. The religious film : Christianity and the hagiopic, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 37-38 (three categories of religiously themed movies: (1) films that are basically \"amplified versions on the Stations of the Cross\" or overly ornamental \"catechism-in-pictures\"; (2) priest or nun stories, like The Bells of St. Mary's (1945); an (3) hagiographic films, which not only confer a priori sainthood on their characters, but exploit supernatural elements, including \"popular belief in miracles\". A film like Augusto Genina's Heaven Over the Marshes (1949), on the other hand, breaks the hagiographical mold.)"}, "madsrdf:citationSource": "Nayar, S.J. The sacred and the cinema : reconfiguring the \"genuinely\" religious film, \u00a92012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 170 (hagiographic films)"}, "madsrdf:citationSource": "Lindvall, T. Celluloid sermons : the emergence of the Christian film industry, 1930-1986, \u00a92011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 91 (hagiographical films featuring Krishna and Rama)"}, "madsrdf:citationSource": "From sacred text to Internet, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subcategory under Religious Film: Hagiographies. Hagiographies are works about the life of historical religious figures. They include films about Christ, the Virgin Mary, saints and prophets. Examples: Jeanne d'Arc (1898); Jeanne d'Arc (1900); La passion de Jeanne d'Arc (1927); The song of Bernadette (1943); La virgen Morena (1943); Monsieur Vincent (1947) Joan of Arc (1948); Cielo sulla palude (1949); Francesco, giullare di Dio (1950); Il suffit d'aimer (1960); Fratello Sole, sorella Luna (1972); Th\u00e9r\u00e8se (1986); Bernadette (1987); Romero (1989))"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9ac500282aab4851b20409fc106bfd51b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hagiopics"}}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hagiopics"}}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9ac500282aab4851b20409fc106bfd51b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hagiographic films"}}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hagiographic films"}}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9ac500282aab4851b20409fc106bfd51b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hagiographies (Motion pictures)"}}, {"@id": "_:n9ac500282aab4851b20409fc106bfd51b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hagiographies (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2016026065"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026066", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aComputer and video game music", "identifiers:lccn": "gf2016026066", "madsrdf:adminMetadata": [{"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb1"}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Computer and video game music"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026046"}, "madsrdf:hasSource": [{"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb5"}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb6"}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb7"}], "madsrdf:hasVariant": [{"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb8"}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb11"}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-05-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-04-07T08:58:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Computer and video game music"}}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Video game music (\"Video game music is the soundtrack or background music accompanying video games. Originally limited to simple melodies by early sound synthesizer technology, video game music has grown to include the same breadth and complexity associated with television and movie soundtracks...In the early 1980s, and by the mid-1980s, the PC-8801 and FM-7 had built-in FM sound. Some computers had built in FM sound. This allowed computer game music to have greater complexity than the simplistic beeps from internal speakers.\"; the term \"computer game music\" redirects to the article on Video game music)"}, "madsrdf:citationSource": "Wikipedia, viewed August 25, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Heart of darkness bears the distinction of being the first orchestral score ever produced for a CD-ROM game)"}, "madsrdf:citationSource": "Work cat: Broughton, B. Heart of darkness [SR] p1999", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "The greatest video game music, 2016, p2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Computer game music"}}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Computer game music"}}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Video and computer game music"}}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Video and computer game music"}}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Video game music"}}, {"@id": "_:ndb4b4548e392499b96b8d752558b9ddcb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Video game music"}}], "@id": "/authorities/genreForms/gf2016026066"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026067", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEcofiction", "identifiers:lccn": "gf2016026067", "madsrdf:adminMetadata": [{"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb1"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ecofiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb3"}]}, "madsrdf:exampleNote": "Note under [Nature fiction]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026095"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026022"}, "madsrdf:hasSource": [{"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb5"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb6"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb7"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb8"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb9"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb10"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb11"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb12"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb13"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb14"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb15"}], "madsrdf:hasVariant": [{"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb16"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb19"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb22"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that depicts the interconnectedness of the human and natural worlds, and especially the impact of human activities on nature. For fiction that depicts the natural world and its phenomena see [Nature fiction.]"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-05-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:34:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ecofiction"}}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Eco-fiction is ecologically oriented fiction, which may be nature-oriented (non-human oriented) or environmental-oriented (human impacts on nature). Eco-fiction is an older term from the 1970s. It became popular with environmental movements then, and opened up a whole new world of the study connecting humanities and nature; Eco-fiction is a broad term describing ecological fiction)"}, "madsrdf:citationSource": "What is eco-fiction?, via Eco-fiction.com website, May 27, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ecofiction. UF Eco-fiction. UF Environmental fiction. UF Green fiction. UF Nature fiction. BT Fiction)"}, "madsrdf:citationSource": "LCSH, May 27, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1122 (Ecofiction is an elastic term, capacious enough to accommodate a variety of fictional works that address the relationship between natural settings and the human communities that dwell within them. The term emerged soon after ecology took hold as a popular scientific paradigm and a broad cultural attitude in the 1960s and 1970s) p. 1123 (contemporary ecofiction can be divided into three broad categories: wilderness narratives; stewardship narratives that weave together the linked fates of human communities and the land; and postnatural narratives that reject both wilderness and the land as dominant tropes or structural frameworks, turning instead to urban, suburban, and other postmodern landscapes to explore the complex and ambiguous ecological contexts of contemporary life) p. 1133 (promise of a better future is fairly constant in American ecofiction, though it is typically grounded in the return to relatively pristine places and the traditions that encouraged either the preservation of untamed wilderness or the stewardship of land respectfully adapted to human use)"}, "madsrdf:citationSource": "The Cambridge history of the American novel, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Wild Robot, by Peter Brown; \"Can a robot survive in the wilderness? When robot Roz opens her eyes for the first time, she discovers that she is alone on a remote, wild island. She has no idea how she got there or what her purpose is--but she knows she needs to survive. After battling a fierce storm and escaping a vicious bear attack, she realizes that her only hope for survival is to adapt to her surroundings and learn from the island's unwelcoming animal inhabitants. As Roz slowly befriends the animals, the island starts to feel like home ... a heartwarming and action-packed novel about what happens when nature and technology collide\")"}, "madsrdf:citationSource": "LB Kids website, May 27, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 77 (ecofiction; novels whose theme is the interconnectedness between humans and the natural world and the attendant dangers we face should that connection be severed through the continued degradation or destruction of the environment and our natural resources; defining fictional work in this field is Edward Abbey's The Monkey Wrench Gang)"}, "madsrdf:citationSource": "Pearl, N. Book lust, c2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sivils, M.W. American environmental fiction, 1782-1847, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. vii (fiction emanating from the environmental movement; new term emerged: ecofiction; ecologically oriented fiction had existed over a century previously, and it can be considered an important precursor to contemporary ecofiction) p. viii (1. The nonhuman environment is present not merely as a framing device but as a presence that begins to suggest that human history is implicated in natural history. 2. The human interest is not understood to be the only legitimate interest. 3. Human accountability to the environment is part of the text's ethical orientation. 4. Some sense of the environment as a process rather than as a constant or a given is at least implicit in the text; environmental concerns have become ever more common in the broad genres of romance, western Americana, speculative fiction, and mysteries) p. 3 (It is usually spelled as one word, but sometimes hyphenated or split into two words: \"eco-fiction\" and \"eco fiction.\" The terms \"environmental fiction,\" \"green fiction,\" and \"nature-oriented fiction\" are sometimes used interchangeably with \"ecofiction,\" but might better be considered as categories of ecofiction. Ecofiction is a composite subgenre made up of many styles and can be found in many genres, primarily mainstream, westerns, mystery, romance, and speculative fiction)"}, "madsrdf:citationSource": "Dwyer, Jim. Where the wild books are : a field guide to ecofiction, \u00a92010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Environmental Novel. Like the feminist novel, the environmental novel is both an entity and a perception or way of reading; Environmentalists may now be considered stock characters; plots involving environmental activism; environmentally motivated plots; reflect an ecological awareness and contribute to a rethinking of the idea of nature and of the human being's place in it; informed by ecological principles)"}, "madsrdf:citationSource": "Encyclopedia of the novel, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Brown, P. The wild robot, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 177 (ecological narrative--prose (usually fiction) that does not necessarily foreground its ecological concerns but contains and reveals them nonetheless) p. 178 (Nature writing is most often based on observation and rumination, offering the reader a view of a place and/or species that includes both research and personal response. ... Ecological narrative, on the other hand, is less apparently driven by activist or scientific concerns, even by particularly ecological ones. The reader finds and emphasizes the influence of the nonhuman world on all aspects of the text)"}, "madsrdf:citationSource": "A companion to American fiction 1865-1914, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Environment and poetry (Environmental poetry, or ecopoetry, is related to the broader genre of nature poetry but can be distinguished from it by its portrayal of nature as threatened by human activities)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Environmental fiction"}}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Environmental fiction"}}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Eco-fiction"}}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Eco-fiction"}}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Green fiction"}}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Green fiction"}}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ecological fiction"}}, {"@id": "_:n89847e8b6e5c4c5794023203ab4d490eb26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ecological fiction"}}], "@id": "/authorities/genreForms/gf2016026067"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026068", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRomances (Music)", "identifiers:lccn": "gf2016026068", "madsrdf:adminMetadata": [{"@id": "_:ne86a8ce909d24beebc7673b928d7f12bb1"}, {"@id": "_:ne86a8ce909d24beebc7673b928d7f12bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Romances (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne86a8ce909d24beebc7673b928d7f12bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:ne86a8ce909d24beebc7673b928d7f12bb5"}, {"@id": "_:ne86a8ce909d24beebc7673b928d7f12bb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne86a8ce909d24beebc7673b928d7f12bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ien"}, "ri:recordStatus": "new"}, {"@id": "_:ne86a8ce909d24beebc7673b928d7f12bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-16T09:47:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne86a8ce909d24beebc7673b928d7f12bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romances (Music)"}}, {"@id": "_:ne86a8ce909d24beebc7673b928d7f12bb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Ichmouratov, Airat. Three romances, op. 22 for viola, strings and harp, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne86a8ce909d24beebc7673b928d7f12bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Romance (Fr. and Sp.; It. romanza; Ger. Romanze); \"From the 15th century, romance in Spain and romanza in Italy have nearly always signified a ballad; the narrative romance was, next to the villancico, the most popular song type in Spanish-speaking countries. In France and Germany the term came to indicate an extravagant, sentimental or 'romantic' tale in either prose or strophic verse. Since the 18th century vocal and instrumental settings entitled 'romance' have continued to express these 'romantic' and lyrical qualities (in this sense, the appropriate Spanish word is 'romanza'\")"}, "madsrdf:citationSource": "Grove music online, viewed June 8, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026068"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026069", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMilitary calls", "identifiers:lccn": "gf2016026069", "madsrdf:adminMetadata": [{"@id": "_:n1a7f9a101be74d14ab0ba39aee97a604b1"}, {"@id": "_:n1a7f9a101be74d14ab0ba39aee97a604b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Military calls"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1a7f9a101be74d14ab0ba39aee97a604b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026936"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026070"}, "madsrdf:hasSource": {"@id": "_:n1a7f9a101be74d14ab0ba39aee97a604b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1a7f9a101be74d14ab0ba39aee97a604b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n1a7f9a101be74d14ab0ba39aee97a604b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-08-11T17:27:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1a7f9a101be74d14ab0ba39aee97a604b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Military calls"}}, {"@id": "_:n1a7f9a101be74d14ab0ba39aee97a604b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(military calls: signals intended to transmit information, commands or encouragement to an army during battle or in camp, to a navy during engagement or on voyage, and to royal and noble households at court and on tour, and also employed to embellish ceremonial occasions; played on various musical instruments, including trumpets, bugles, flutes, drums and kettledrums, and are usually, but not exclusively, performed monophonically)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, June 27, 2001", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026069"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026070", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBattle-cries", "identifiers:lccn": "gf2016026070", "madsrdf:adminMetadata": [{"@id": "_:n6bde7721bde34f519a771d904fd021eeb1"}, {"@id": "_:n6bde7721bde34f519a771d904fd021eeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Battle-cries"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6bde7721bde34f519a771d904fd021eeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027182"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026069"}, "madsrdf:hasSource": [{"@id": "_:n6bde7721bde34f519a771d904fd021eeb5"}, {"@id": "_:n6bde7721bde34f519a771d904fd021eeb6"}], "madsrdf:hasVariant": {"@id": "_:n6bde7721bde34f519a771d904fd021eeb7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6bde7721bde34f519a771d904fd021eeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-08-11T17:27:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6bde7721bde34f519a771d904fd021eeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6bde7721bde34f519a771d904fd021eeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Battle-cries"}}, {"@id": "_:n6bde7721bde34f519a771d904fd021eeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A battle cry is a yell or chant taken up in battle, usually by members of the same military unit. Battle cries are not necessarily articulate, although they often aim to invoke patriotic or religious sentiment. Their purpose is a combination of arousing aggression and esprit de corps on one's own side and causing intimidation on the hostile side.)"}, "madsrdf:citationSource": "Wikipedia, viewed August 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6bde7721bde34f519a771d904fd021eeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(battle cry; a war-cry, slogan)"}, "madsrdf:citationSource": "OED online, viewed August 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6bde7721bde34f519a771d904fd021eeb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6bde7721bde34f519a771d904fd021eeb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "War-cries"}}, {"@id": "_:n6bde7721bde34f519a771d904fd021eeb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "War-cries"}}], "@id": "/authorities/genreForms/gf2016026070"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026071", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHaibun", "identifiers:lccn": "gf2016026071", "madsrdf:adminMetadata": [{"@id": "_:na5ad0a96656a44d1b33970567eeec723b1"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Haibun"}, "madsrdf:elementList": {"@list": [{"@id": "_:na5ad0a96656a44d1b33970567eeec723b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026488"}, "madsrdf:hasSource": [{"@id": "_:na5ad0a96656a44d1b33970567eeec723b5"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b6"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b7"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b8"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b9"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b10"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b11"}], "madsrdf:hasVariant": {"@id": "_:na5ad0a96656a44d1b33970567eeec723b12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:12:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Haibun"}}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (a quarterly journal of contemporary English language haibun) haibun definitions (Contemporary haibun is a combination of prose and haiku poetry, sometimes described as 'a narrative of epiphany'. Like English haiku, English haibun is evolving as it becomes more widely practiced in the English speaking world; Paul Conneally, Haibun Director of the World Haiku Club, defines current English haibun as: \"Prose that has many of the characteristics associated with haiku--present tense (and shifts of tense though predominant voice 'present'), imagistic, shortened or interesting syntax, joining words such as 'and' limited maybe, a sense of 'being there', descriptions of places people met and above all 'brevity'. The haiku ... should link to the prose but is not a direct carry on from the prose telling some of what has already been said - no - it should lead us on - let our mind want for more, start traveling\")"}, "madsrdf:citationSource": "Contemporary haibun online, viewed June 20, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haibun. A literary form developed in Japan that employs a combination of prose and haiku. A haibun may be as brief as a single terse paragraph followed by a single haiku or an extended work involving an alternation of prose and verse. Accordingly, the haikus may occur singly, in groups, or in linked series, between prose passages. The prose and verse sections of a haibun are intended to function discretely as self-contained texts; however, in combination, they enact a kind of dialogue between them, a compounding of points of view on the same situation or topic. While the form was developed by Bash\u014d out of the haikai trad. of linked verses employing commonplace diction and a light-hearted tone, it has been used for a range of tones and themes; however, personal themes predominate. As with haiku, haibun has been adapted into many langs. and cultures)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, 2012, via Project MUSE, viewed June 20, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haibun combines a prose poem with a haiku. The haiku usually ends the poem as a sort of whispery and insightful postscript to the prose of the beginning of the poem. Another way of looking at the form is thinking of haibun as highly focused testimony or recollection of a journey composed of a prose poem and ending with a meaningful murmur of sorts: a haiku. The result is a very elegant block of text with the haiku serving as a tiny bowl or stand for the prose poem)"}, "madsrdf:citationSource": "Nezhukumatathil, A. More than the birds, bees, and trees : a closer look at writing haibun, via poets.org website, posted Feb. 20, 2014, viewed June 20, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Haibun (Haibun (literally, haikai writings) is a prosimetric literary form originating in Japan, combining prose and haiku. The range of haibun is broad and frequently includes autobiography, diary, essay, prose poem, short story and travel journal; Haibun is no longer confined to Japan, and has established itself as a genre in world literature)"}, "madsrdf:citationSource": "Wikipedia, June 20, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haibun. UF Hai prose; Haibun, Japanese. BT Japanese prose literature; also established: Haibun, American; Haibun, Canadian; Haibun, French-Canadian; Haibun, Romanian)"}, "madsrdf:citationSource": "LCSH, June 20, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haibun: A haibun is a terse, relatively short prose poem in the haikai style, usually including both lightly humorous and more serious elements. A haibun usually ends with a haiku. Most haibun range from well under 100 words to 200 or 300. Some longer haibun may contain a few haiku interspersed between sections of prose. In haibun the connections between the prose and any included haiku may not be immediately obvious, or the haiku may deepen the tone, or take the work in a new direction, recasting the meaning of the foregoing prose, much as a stanza in a linked-verse poem revises the meaning of the previous verse. Japanese haibun apparently developed from brief prefatory notes occasionally written to introduce individual haiku, but soon grew into a distinct genre. The word \"haibun\" is sometimes applied to longer works, such as the memoirs, diaries, or travel writings of haiku poets, though technically they are parts of the separate and much older genres of journal and travel literature (nikki and kik\u00f4bun))"}, "madsrdf:citationSource": "Official definitions of haiku and related terms, via Haiku Society of America website, viewed June 20, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(haibun in Macedonian)"}, "madsrdf:citationSource": "Work cat.: Gajtanoski, I.V. Skrieni trepeti : haibuni, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na5ad0a96656a44d1b33970567eeec723b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hai prose"}}, {"@id": "_:na5ad0a96656a44d1b33970567eeec723b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hai prose"}}], "@id": "/authorities/genreForms/gf2016026071"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026072", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAmpelographies", "identifiers:lccn": "gf2016026072", "madsrdf:adminMetadata": [{"@id": "_:ndca0a91ad140461896e45e553b9bb465b1"}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ampelographies"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndca0a91ad140461896e45e553b9bb465b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasSource": [{"@id": "_:ndca0a91ad140461896e45e553b9bb465b5"}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b6"}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b7"}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b8"}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cua"}, "ri:recordStatus": "new"}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-09T08:51:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ampelographies"}}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 122 (Ampelographies describe the morphology, viticultural, wine, growing and market values of new vine varities and clones)"}, "madsrdf:citationSource": "Andrew G. Reynolds. Grapevine breeding programs for the wine industry, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ampelography, the identification and classification of the cultivated varieties of grape used in winemaking; the enumeration and description of the grape varieties of a particular country, region, etc.; an instance of this)"}, "madsrdf:citationSource": "Oxford English dictionary, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 31 (ampelography, document containing a description of the morphological characteristics of a vine)"}, "madsrdf:citationSource": "Lexique de la vigne et du vin, 1963:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 11 (a practical ampelography, an authoritative, up-to-date, scientific description of grapevines, in a compact form that a grape grower can use to identify each variety that grows in his vineyard)"}, "madsrdf:citationSource": "Pierre Galet. A practical ampelography, 1979:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndca0a91ad140461896e45e553b9bb465b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Pierre Galet. A practical ampelography, 1979.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026072"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026073", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMythological comics", "identifiers:lccn": "gf2016026073", "madsrdf:adminMetadata": [{"@id": "_:n93e902a73c5144578058e98faec0f07ab1"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mythological comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n93e902a73c5144578058e98faec0f07ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n93e902a73c5144578058e98faec0f07ab5"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab6"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab7"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab8"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab9"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-07-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-30T15:46:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mythological comics"}}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 36 (Creators in India differ from American alternative comics creators, in that the mainstream against which they must often define their work is grounded in book publishing and mythological comics rather than superheroes.)"}, "madsrdf:citationSource": "Cultures of comics work, 2016, via Google books, viewed Dec. 27, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Series: Graphic myths and legends; A retelling, in graphic novel form, of the myth of king Osiris and his wife Isis's efforts to keep Osiris's brother from taking his place on the Egyptian throne)"}, "madsrdf:citationSource": "Limke, Jeff. Isis and Osiris, \u00a92007", "madsrdf:citationStatus": "found"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 165 (Indigenous comics in India have been around for fewer than 30 years ... The first comics were based on historical and mythological themes; they were factual, carefully researched retellings of ancient and contemporary history) p. 171 (In the historical and mythological comics, the female victim is imbued with nobility)"}, "madsrdf:citationSource": "Themes and issues in Asian cartooning, \u00a91999, via Google books, viewed Dec. 27, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel; summary note: Introduces Hera, Zeus's wife and goddess of air, sky, and the heavens, and the only thing Zeus fears)"}, "madsrdf:citationSource": "Work cat.: O'Connor, George. Hera : the goddess and her glory, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel; summary note: Tells the story of the great God of the Underworld and one of the most famous of all Greek myths: Hades' abduction of Persephone and her mother's revenge. Be prepared to see a new side of Persephone in this dynamic adaptation of the story of the creation of the seasons)"}, "madsrdf:citationSource": "O'Connor, George. Hades : lord of the dead, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n93e902a73c5144578058e98faec0f07ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 71 (Dreamland Publications was a New Delhi-based publisher of children's books that began its own series of mythological comics in the early 1980s in an effort to compete for the market)"}, "madsrdf:citationSource": "Pop culture in Asia and Oceania, 2016, via Google books, viewed Dec. 27, 2016:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026073"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026076", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEnvironmental impact statements", "identifiers:lccn": "gf2016026076", "madsrdf:adminMetadata": [{"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb1"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Environmental impact statements"}, "madsrdf:elementList": {"@list": [{"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026093"}, "madsrdf:hasSource": [{"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb5"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb6"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb7"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb8"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb9"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb10"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb11"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb12"}], "madsrdf:hasVariant": [{"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb13"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:46:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Environmental impact statements"}}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Meydenbauer Bay Park and Land Use Plan : draft environmental impact statement (EIS), 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "University of Washington. Capital Projects Office. Draft supplemental environmental impact statement for the University of Washington Molecular Engineering Facility Project, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(An Environmental Impact Statement (EIS) is a document prepared to describe the effects for proposed activities on the environment. \"Environment,\" in this case, is defined as the natural and physical environment and the relationship of people with that environment. This means that the \"environment\" considered in an EIS includes land, water, air, structures, living organisms, environmental values at the site, and the social, cultural, and economic aspects. An \"impact\" is a change in consequence that results from an activity. Impacts can be positive or negative or both. An EIS describes impacts, as well as ways to \"mitigate\" impacts. To \"mitigate\" means to lessen or remove negative impacts. Therefore, an Environmental Impact Statement, or EIS, is a document that describes the impacts on the environment as a result of a proposed action. It also describes impacts of alternatives as well as plans to mitigate the impacts)"}, "madsrdf:citationSource": "What is an environmental impact statement (EIS)?, via Depleted UF6 Management Information Network website, Sept. 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(An Environmental Impact Statement (EIS) concisely describes and analyzes a proposed action which may have a significant impact on the environment. The EIS is available to the public for information and comment. An EIS must include: 1. description of the action, including its need and benefits; 2. description of the environmental setting and areas to be affected; 3. an analysis of all environmental impacts related to the action; 4. an analysis of reasonable alternatives to the action; 5. identification of ways to reduce or avoid adverse environmental impacts)"}, "madsrdf:citationSource": "What is an environmental impact statement?, via New York State Department of Environmental Conservation website, Sept. 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(running title: U District urban design final EIS)"}, "madsrdf:citationSource": "Work cat.: Seattle (Wash.). Department of Planning and Development. Final environmental impact statement for the U District urban design alternatives, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The process of EIS filing includes: receiving and recording of the EIS into EPA's EIS database; for draft and final EISs, establishing the beginning and ending dates for comment and review periods; publishing the comment and review dates in a weekly Notice of Availability in the Federal Register)"}, "madsrdf:citationSource": "Environmental impact statement filing guidance, via US Environmental Protection Agency website, Sept. 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(environmental impact statement, abbreviation EIS: in the US, a report to the government on the possible effects on the environment of a large project, such as a road or industrial development)"}, "madsrdf:citationSource": "Cambridge dictionary website, Sept. 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "applicants > enviro. review > EIS documents (Draft Environmental Impact Statement (DEIS); Final Environmental Impact Statement (FEIS))"}, "madsrdf:citationSource": "New York City Department of City Planning website, Sept. 1, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Impact statements, Environmental"}}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Impact statements, Environmental"}}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Statements, Environmental impact"}}, {"@id": "_:n05fce05d16ee46e4ae35fb61c9a275cdb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Statements, Environmental impact"}}], "@id": "/authorities/genreForms/gf2016026076"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026080", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFlip charts", "identifiers:lccn": "gf2016026080", "madsrdf:adminMetadata": [{"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b1"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Flip charts"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b5"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b6"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b7"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b8"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b9"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b10"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b11"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b12"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b13"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b14"}], "madsrdf:hasVariant": {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b15"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:12:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flip charts"}}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a standing flip chart)"}, "madsrdf:citationSource": "Work cat.: Diversifying your workforce, 2008?", "madsrdf:citationStatus": "found"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "About cannabis : an information flipchart for Aboriginal communities, 2000?", "madsrdf:citationStatus": "found"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(flipchart: A carrier type consisting of a hinging device holding two or more sheets designed for use on an easel)"}, "madsrdf:citationSource": "RDA glossary, via RDA toolkit, Sept. 2, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(flip chart: A pad of paper of very large size designed to be mounted on an easel to display information, often in graphic or tabular format, to accompany an oral presentation. As the session proceeds, pages can either be torn off or turned over the top. Unlike slide projection or presentation software, a flip chart allows the presenter to manipulate information content manually as it is presented, sometimes in response to feedback from the audience. Overhead transparencies are visible to a larger audience but require projection equipment. Also spelled flipchart)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Sept. 2, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(flipchart: another name for flip chart; flip chart or flipchart: a pad, containing large sheets of paper that can be easily turned over, mounted on a stand and used to present reports, data, etc)"}, "madsrdf:citationSource": "Collins English dictionary online, Sept. 2, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Break free from fat : a photo flipchart designed to visually illustrate the fat content in foods, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a flip chart)"}, "madsrdf:citationSource": "Safety in the elementary science classroom, \u00a92003", "madsrdf:citationStatus": "found"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(flip chart: a chart that consists of a series of large pieces of paper which are attached at the top and which are used to present information to an audience by turning over one piece of paper at a time)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Sept. 2, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Sept. 2, 2016;Art & architecture thesaurus online, Sept. 2, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ford, K. Communicable disease flip-chart, 2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Flipcharts"}}, {"@id": "_:ne772ceb98eee4fc79fc82bdc5570f2b0b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flipcharts"}}], "@id": "/authorities/genreForms/gf2016026080"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026081", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCremation volumes", "identifiers:lccn": "gf2016026081", "madsrdf:adminMetadata": [{"@id": "_:nc505a1d3949c413e9d52e786f223e568b1"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cremation volumes"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc505a1d3949c413e9d52e786f223e568b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026064"}, "madsrdf:hasSource": [{"@id": "_:nc505a1d3949c413e9d52e786f223e568b5"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b6"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b7"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b8"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b9"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b10"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b11"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b12"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b13"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-11-09T15:31:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cremation volumes"}}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 29 (Although Thailand has long been Buddhist, the first printed cremation volumes only appeared a little over a century ago. A form of publication unique to Thailand, they are distributed as gifts at Buddhist cremation ceremonies; generally include a biography of the deceased person, eulogies and writings on other topics relevant to the deceased. Most early examples dealt with Buddhism, which has remained their major focus to the present day. Other topics are as varied as history, folklore, language, literature, travel, medicine and cooking; length and quality vary greatly, depending largely on status and wealth. Some are carefully edited, elaborately bound and contain many colour photographs. Others are short and plain; important sources for scholars as they often contain valuable historical or literary documents otherwise unavailable)"}, "madsrdf:citationSource": "Gosling, A. Asian treasures, 2011, via Google books, viewed Sept. 6, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Sept. 6, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cremation volumes. BT Festschriften)"}, "madsrdf:citationSource": "LCSH, Sept. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a cremation volume for Phr\u0101nb\u016bn, also known as \u010ch\u016bang\u010dhan \u010chankhan\u0101, a Thai songwriter; contains his biography and condolences)"}, "madsrdf:citationSource": "Work cat.: \u02bbAnuso\u031c\u0304n Phr\u0101nb\u016bn, 1976", "madsrdf:citationStatus": "found"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cremation Volumes: Nangsu Anuson Ngansop; published and distributed as gifts on the occasion of cremation ceremonies; the free distribution of cremation volumes is an extension of a cultural practice of giving gifts to people to celebrate a special, meritorious occasion (nai ngan kuson))"}, "madsrdf:citationSource": "Thai cremation volumes, via National Library of Australia website, Sept. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 280 (The cremation volume, or nangs\u00fc anuson ng\u0101nsop, is a genre of literature unique to Thailand. These volumes, published and distributed as gifts on the occasion of cremation ceremonies, are an important cultural artifact of Thai society, providing a rich source of literary, historical, cultural, and folk information. The origin of cremation-volume literature can be traded to missionary influence and the influx of printing technology into Thailand) p. 284 (Almost all recent examples of cremation volumes are composed of a short biography of the deceased, eulogies from friends and relatives, and selected essays or pieces of prose and literature. The volumes often contain works that had been personal favorites of the deceased or the family. By republishing long-out-of-print material many were intended as a contribution to the preservation of Thai literature. Most of the first wave of cremation volumes dealt with the Buddhist religion) p. 285 (It was not until the 1950s and 1960s that the subject matter of cremation volumes spread very far beyond the realms of religion, history, and archeology. Suphat Songsaengchan has pointed out that there were essentially two kinds of cremation volumes: those that printed the selected and edited writings of the deceased, and those that printed manuscripts from other sources)"}, "madsrdf:citationSource": "Olson, G.A. Thai cremation volumes : a brief history of a unique genre of literature, in Asian folklore studies, v. 51, no. 2 (Oct. 1992):", "madsrdf:citationStatus": "found"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(on the history of Chinese people in Thailand during the reign of King Chulalongkorn; published as a cremation volume for Khun M\u01e3 Kimh\u016bai Khunnawat)"}, "madsrdf:citationSource": "Phonlak\u016bn \u02bbAngkinan. Botb\u0101t Ch\u0101o \u010ch\u012bn nai Prath\u0113t Thai nai ratchasamai Phrab\u0101t Somdet Phra \u010chunlac\u0304ho\u031c\u0304mklao \u010chaoy\u016bh\u016ba, 1972", "madsrdf:citationStatus": "found"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(cremation volume for Pin R\u016baith\u0101w\u01ednkit"}, "madsrdf:citationSource": "Nangs\u01b0\u0304 \u02bbanuso\u031c\u0304n ng\u0101n sop kho\u031c\u0304ng p\u0101 Pin R\u016baith\u0101w\u01ednkit 4 Kumph\u0101phan 2549, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a catalog of cremation volumes, the Thai term for which is \"nangs\u01b0\u0304 \u02bbanuso\u031c\u0304n ng\u0101n sop\" per ALA transliteration rules)"}, "madsrdf:citationSource": "Nangs\u01b0\u0304 \u02bbanuso\u031c\u0304n ng\u0101n sop, 1972", "madsrdf:citationStatus": "found"}, {"@id": "_:nc505a1d3949c413e9d52e786f223e568b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "89928547: Ky\u014dto Daigaku. T\u014dnan Ajia Kenky\u016b Sent\u0101. Library. Catalog of Thai cremation volumes in the Charas collection, the Center for Southeast Asian Studies Library, Kyoto University, 1989.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026081"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026082", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFestschriften", "identifiers:lccn": "gf2016026082", "madsrdf:adminMetadata": [{"@id": "_:n79e759a1283c4183bbb895763d361b43b1"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Festschriften"}, "madsrdf:elementList": {"@list": [{"@id": "_:n79e759a1283c4183bbb895763d361b43b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026064"}, "madsrdf:hasSource": [{"@id": "_:n79e759a1283c4183bbb895763d361b43b5"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b6"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b7"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b8"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b9"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b10"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b11"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b12"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b13"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b14"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b15"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b16"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b17"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b18"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b19"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b20"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b21"}], "madsrdf:hasVariant": [{"@id": "_:n79e759a1283c4183bbb895763d361b43b22"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b25"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b28"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b31"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-11-09T15:31:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Festschriften"}}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "liber amicorum (A liber amicorum (plural: libri amicorum; the Latin phrase means 'book of friends') is sometimes also called an album amicorum and is a type of album that flourished especially in the sixteenth and seventeenth centuries, originally in Protestant northern Germany, although the fashion spread widely on the continent. Libri amicorum were compiled by gentlemen (noblemen, students, lawyers, diplomats, etc.), often young men, who encouraged their friends, hosts, or honourable guests or visitors to write verses, inscriptions, or drawings in them, as well as their signatures, as souvenirs or mementos. In some respects they were forerunners of the autograph album, although libri amicorum could sometimes be very much grander productions: written, for instance, on vellum, as well as paper, of varying size, of sometimes considerable length (200 pages or more), leather-bound, and highly decorated or illuminated, with elaborate pen-and-ink or painted illustrations, such as portraits of the contributors and their coats of arms. Famous English people who inscribed libri amicorum either on their own travels or for visitors bringing their own albums with them include Charles I (as Prince in 1613, for Sir Thomas Cuming of Scotland); Ben Jonson and Sir Walter Ralegh (for Captain Francis Segar); Jonson again (for the theosopher Joachim Morsius on 1 January 1619/20); Lancelot Andrewes (for Johannes Opsimathes of Moravia in 1616); and John Milton (for Camillus Cardoinus of Naples on 10 June 1639; for Christoph Arnold of Nuremberg on 19/29 November 1651; and, when blind, for Johannes Zollikofer on 26 September 1656).)"}, "madsrdf:citationSource": "Beal, P. A dictionary of English manuscript terminology, 1450 to 2000, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In academia, a Festschrift (plural, Festschriften) is a book honoring a respected person, especially an academic, and presented during his or her lifetime. The term, borrowed from German, could be translated as celebration publication or celebratory (piece of) writing (literally 'party-writing'; cognate with 'feast-script'). A comparable book presented posthumously is called a Gedenkschrift (memorial publication). Sometimes, the Latin term liber amicorum (literally: \"book of friends\") is used for a Festschrift; A Festschrift contains original contributions by the honored academic's close colleagues, often including his or her former doctoral students. It is typically published on the occasion of the honoree's retirement, sixtieth or sixty-fifth birthday, or other notable career anniversary. A Festschrift can be anything from a slim volume to a work in several volumes)"}, "madsrdf:citationSource": "Wikipedia, Sept. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Telling tales and crafting books : essays in honor of Thomas H. Ohlgren, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xiii (The essays published in this volume in honor of Robert Somerville reflect the admiration, gratitude, and friendship of his former students and of scholars some of whom have known him since his days as a graduate student in the manuscript room of the Biblioteca Apostolica Vaticana. They mirror Somerville's influence and his eminent status in the fields of medieval canon law, theology, and political history)"}, "madsrdf:citationSource": "Canon law, religion, and politics : liber amicorum Robert Somerville, \u00a92012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(festschrift: A complimentary or memorial publication in the form of a collection of essays, addresses, or biographical, bibliographical, scientific, or other contributions, often embodying the results of research, issued in honor of a person, an institution, or a society, usually on the occasion of an anniversary celebration)"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Liber amicorum : Festschriften for music scholars and nonmusicians, 1840-1966, \u00a92009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cognitive modeling in perception and memory : a festschrift for Richard M. Shiffrin, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Handel studies : a Gedenkschrift for Howard Serwer, \u00a92009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Alleluia! : a Gedenkschrift in thanksgiving for the life of Walter R. Bouman (1929-2005), 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "008 - Books (Festschrift. Defined as a complimentary or memorial publication usually in the form of a collection of essays, addresses, or biographical, bibliographic, scientific, or other contributions. It often embodies the results of research, issued in honor of a person, an institution, or a society, as a rule, on the occasion of an anniversary celebration. A true festschrift generally mentions the person, institution, or society it commemorates on the chief source of information (i.e., title page). The title of the work may or may not use the word festschrift. Other indications that an item is a festschrift include phrases such as: papers in honor of, in memory of, commemorating, and their equivalents in foreign languages.)"}, "madsrdf:citationSource": "MARC 21 format for bibliographic data, via WWW, Sept. 6, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(festschrift plural -schriften or -schrifts: a collection of essays or learned papers contributed by a number of people to honour an eminent scholar, esp a colleague)"}, "madsrdf:citationSource": "Collins English dictionary online, Sept. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Festschrift. A memorial or complimentary volume usually consisting of a number of contributions by distinguished persons, often students and colleagues of a person and issued in his honour. The subject matter of the various contributions is usually concerned with the subject in which the individual distinguished himself. It may also honour an institution or society especially on the occasion of an anniversary. Also called \"Memorial volume\")"}, "madsrdf:citationSource": "Harrod, L.M. The librarians' glossary of terms used in librarianship and the book crafts and reference book, 1971", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Festschrift: A memorial publication, usually in the form of a collection of essays or speeches by distinguished persons, issued in honor of a scholarly person or society, sometimes on the occasion of an anniversary, birthday, or retirement celebration. The subject or theme encompassing the collected works is usually related to the field in which the person (or organization) achieved distinction. The contributors are often friends, colleagues, and former students of the person (or entity) honored. Plural: Festschriften)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Sept. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Festschrift plural Festschriften or Festschrifts: a volume of writings by different authors presented as a tribute or memorial especially to a scholar)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Sept. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Festschrift (plural Festschriften or Festschrifts): A collection of writings published in honor of a scholar)"}, "madsrdf:citationSource": "Oxford dictionaries online, Sept. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. ix (The purpose of this volume is to pay tribute to the intellectual ideas and scholarly contributions of Randy Hodson) p. xi (We hope that this volume will honor Randy's many contributions and encourage readers to look further into his work. We also hope that the volume will provide a lasting record and reminder of the significance of Randy's work for academics as well as for his friends and family, particularly his wife, Susan, and their daughters, Debbie and Susie) p. xiii (this volume of Research in the Sociology of Work devoted to the impact and work of Randy Hodson)"}, "madsrdf:citationSource": "A Gedenkschrift to Randy Hodson, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b21", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cross-linguistic interaction: translation, contrastive and cognitive studies : liber amicorum in honour of prof. Bistra Alexieva, published on the occasion of her eightieth birthday, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n79e759a1283c4183bbb895763d361b43b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Festschrifts"}}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Festschrifts"}}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n79e759a1283c4183bbb895763d361b43b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Memorial volumes (Festschriften)"}}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Memorial volumes (Festschriften)"}}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n79e759a1283c4183bbb895763d361b43b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gedenkschrifts"}}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gedenkschrifts"}}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n79e759a1283c4183bbb895763d361b43b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gedenkschriften"}}, {"@id": "_:n79e759a1283c4183bbb895763d361b43b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gedenkschriften"}}], "@id": "/authorities/genreForms/gf2016026082"}
