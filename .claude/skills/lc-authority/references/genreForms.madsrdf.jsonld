 press conferences"}}, {"@id": "_:nc00758a1348b4b8ab102c8b257ce0c1eb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television press conferences"}}], "@id": "/authorities/genreForms/gf2018026152"}
