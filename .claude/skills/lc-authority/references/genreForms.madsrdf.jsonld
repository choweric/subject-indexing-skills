adsrdf:elementValue": {"@language": "en", "@value": "Ska (Music)"}}, {"@id": "_:n980fc31cb2d44886b2fbc364f53ac1b5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ska (bluebeat); under Reggae: ska known in England as bluebeat)"}, "madsrdf:citationSource": "New Grove dict. of mus. online, May 10, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n980fc31cb2d44886b2fbc364f53ac1b5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ska. A style of urban popular music and dance, originating in Jamaica in the late 1950s; dominant there until middle 1960s, largely then supplanted by \"rock steady\" which later became Reggae.)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n980fc31cb2d44886b2fbc364f53ac1b5b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 96703679: Ska spectacular, p1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:n980fc31cb2d44886b2fbc364f53ac1b5b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n980fc31cb2d44886b2fbc364f53ac1b5b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bluebeat"}}, {"@id": "_:n980fc31cb2d44886b2fbc364f53ac1b5b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bluebeat"}}], "@id": "/authorities/genreForms/gf2014027095"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027096", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSkiffle", "identifiers:lccn": "gf2014027096", "madsrdf:adminMetadata": [{"@id": "_:ne059d1c8befe47249cf2c6fc24155f74b1"}, {"@id": "_:ne059d1c8befe47249cf2c6fc24155f74b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Skiffle"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne059d1c8befe47249cf2c6fc24155f74b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:ne059d1c8befe47249cf2c6fc24155f74b5"}, {"@id": "_:ne059d1c8befe47249cf2c6fc24155f74b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Popular music developed in England during the 1950s that is based on hillbilly music and rock and roll, and that is played by bands of standard and improvised instruments."}, {"@id": "_:ne059d1c8befe47249cf2c6fc24155f74b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:58:33"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne059d1c8befe47249cf2c6fc24155f74b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne059d1c8befe47249cf2c6fc24155f74b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skiffle"}}, {"@id": "_:ne059d1c8befe47249cf2c6fc24155f74b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "McDevitt, C. Skiffle, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne059d1c8befe47249cf2c6fc24155f74b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Skiffle)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027096"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027097", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSludge metal (Music)", "identifiers:lccn": "gf2014027097", "madsrdf:adminMetadata": [{"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb1"}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sludge metal (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026854"}, "madsrdf:hasSource": [{"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb5"}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb6"}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb7"}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb8"}], "madsrdf:hasVariant": {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sludge metal (Music)"}}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Sludge metal, or just sludge, is a subgenre of heavy metal that melds elements of doom metal, hardcore punk (or some other form of punk, such as crust punk), and sometimes Southern rock. Sludge metal is typically abrasive; often featuring shouted vocals, heavily distorted instruments and sharply contrasting tempos. While the style was anticipated by the Melvins from Washington, many of its earliest pioneers were from the state of Louisiana.) Under Southern rock: Most notable sludge metal bands hail from the Southern United States.\")"}, "madsrdf:citationSource": "Wikipedia, Sept. 30, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(refers to All the waters of the earth turn to blood as sludge metal music)"}, "madsrdf:citationSource": "Heavymetal.about.com www home page, Oct. 20, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Body (Musical group : Rhode Island). All the waters of the earth turn to blood [SR] [2010]", "madsrdf:citationStatus": "found"}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Doom metal (\"The '90s also birthed a unique doom metal scene centered in New Orleans; the sound of bands like Crowbar and Eyehategod was often described as \"sludge metal\" because of their heavy debt to early Seattle grunge bands like the Melvins and Soundgarden.\")"}, "madsrdf:citationSource": "All music guide WWW site, Sept. 30, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sludge (Music)"}}, {"@id": "_:n3df6a53ce7014d3da4f22c4f08ba7d7fb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sludge (Music)"}}], "@id": "/authorities/genreForms/gf2014027097"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027098", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSoca (Music)", "identifiers:lccn": "gf2014027098", "madsrdf:adminMetadata": [{"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b1"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Soca (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027106"}], "madsrdf:hasSource": [{"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b5"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b6"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b7"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b8"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b9"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b10"}], "madsrdf:hasVariant": [{"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b11"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-19T16:45:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soca (Music)"}}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(soca: song and dance genre directly related to calypso; in the 1970s, at a time of new oil wealth and modernizing tendencies on Trinidad, technological and musical influence from North American soul and dance musics inspired a new form of calypso; singer Lord Shorty's \"Soul Calypso\" gave its abbreviated name \"So-Ca\" to the new sound which mixed elements of soul and disco drum features with funk, mid-tempo ska, and traditional calypso; while the satire, metaphor, and political comment of calypso did not disappear entirely, the emphasis shifted from song lyrics to the rhythms of dance and the culture of partying)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Feb. 12, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(soca: descendant of calypso; in the early 1970s, electric guitar and bass were added to the traditional calypso ensemble, and by the 1980s most groups were using synthesizers as well; increasing sophistication of recording technology and continued competition between groups directed the music toward a more complicated and thought-out musical style that focused increasingly on the musical sound rather than the texts; suitability of the music for dancing, rather than listening, also became an important factor; around 1970, the term \"soca,\" meaning \"soul-calypso,\" was coined to refer to the new, energetic, and disco-influenced party music)"}, "madsrdf:citationSource": "All music guide WWW site, Feb. 12, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(soca is a very fast piece of dance music combining calypso with soul music; created in the late 70s)"}, "madsrdf:citationSource": "Work cat.: 99481697: Sponsel, J. The soca drum duet, c1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 993 (soca: modern, danceable Trinidadian calypso form, short for soul calypso)"}, "madsrdf:citationSource": "Garland encyc. of world music:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Trinidad & Tobago: soca: modern style of calypso music; derived from \"soul-calypso,\" it is very popular throughout the West Indies; listed also under Antigua & Barbuda, Barbados, Belize (as \"soka\"), French Guiana (as \"soka\"), Grenada, Guyana, Montserrat, Netherlands Antilles (as \"soka\"), St. Kitts & Nevis, St. Lucia, St. Vincent, Turks & Caicos, and Virgin Islands)"}, "madsrdf:citationSource": "Dict. pop. mus. styles of the world", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(soca: style of music, originating in the West Indies, that is a blend of soul and calypso)"}, "madsrdf:citationSource": "Amer. heritage dict., 3rd ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Soka (Music)"}}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soka (Music)"}}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "So-ca (Music)"}}, {"@id": "_:n4e03fad254684333a114f3dc4cbc5c49b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "So-ca (Music)"}}], "@id": "/authorities/genreForms/gf2014027098"}
