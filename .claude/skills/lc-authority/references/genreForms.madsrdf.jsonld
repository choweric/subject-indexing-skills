{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026294", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGeographic information systems", "identifiers:lccn": "gf2011026294", "madsrdf:adminMetadata": [{"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb1"}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Geographic information systems"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026113"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026293"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026297"}], "madsrdf:hasSource": [{"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb5"}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb6"}], "madsrdf:hasVariant": [{"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb7"}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025022"}}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T11:33:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographic information systems"}}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (geographic information system: An organized collection of computer hardware, software, geographic data, and personnel designed to capture, store, update, manipulate, analyze, and display all forms of geographically referenced information efficiently)"}, "madsrdf:citationSource": "Cartographic materials, 2002, 2005 update via Cataloger's desktop March 23, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (A geographic information system (GIS), as defined by the National Science Foundation, is a computerized database management system used for the capture, storage, retrieval, analysis, and display of spatial (e.g. locationally defined) data.)"}, "madsrdf:citationSource": "Walker, T.C. Geographic information systems, 1990:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographical information systems"}}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographical information systems"}}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "GISs (Information systems)"}}, {"@id": "_:nc7d479d1e9cd486a85c7cc024dc1662bb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "GISs (Information systems)"}}], "@id": "/authorities/genreForms/gf2011026294"}
