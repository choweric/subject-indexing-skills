{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026109", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHandbooks and manuals", "identifiers:lccn": "gf2014026109", "madsrdf:adminMetadata": [{"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b1"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Handbooks and manuals"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026080"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026120"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026183"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026188"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026039"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026099"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026066"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026089"}], "madsrdf:hasSource": [{"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b5"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b6"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b7"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b8"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b9"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b10"}], "madsrdf:hasVariant": [{"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b11"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b14"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b17"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b20"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b23"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Handbooks and manuals"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(enchiridion (plural enchiridions or enchiridia): A handbook or manual; handbook (plural handbooks): A topically organized book of reference on a certain field of knowledge, disregarding the size of it; manual (plural manuals) 1. A handbook)"}, "madsrdf:citationSource": "Wiktionary, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Manuals (Handbooks). UF Handbooks. BT Instructional works (Gathering term; do not assign). NT Drawing books; Emigrant guides; Merchant manuals; Military manuals; Pilot guides; Writing books)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(handbook: A single-volume reference book of compact size that provides concise factual information on a specific subject, organized systematically for quick and easy access. Synonymous with vade mecum. See also: companion and manual; vade mecum: A Latin phrase meaning \"goes with me.\" A small book such as a guidebook, handbook, or manual meant to be carried about, used during the Middle Ages by physicians, astrologers, and tradesmen for quick reference and computation. In a more general sense, any item regularly carried by a person. Also spelled vade-mecum. Plural: vade mecums; companion: A handbook intended to be used in connection with the study of a particular subject or field (examples: The Cambridge Companion to Ralph Ellison and The Oxford Companion to Philosophy). This type of reference work is often an edited collection of essays; manual: A book of compact size, especially one describing in considerable detail the government of a state or the structure and functions of a government agency (example: The United States Government Manual published annually by the U.S. Government Printing Office). Also refers to a book or pamphlet containing practical instructions, rules, or steps for performing a task or operation, assembling a manufactured object, or using a system or piece of equipment (example: Manual of Archival Description published by Gower). Used synonymously with handbook)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Enchiridion is a Late Latin term referring to a small manual or handbook; enchiridions)"}, "madsrdf:citationSource": "Wikipedia, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(handbooks. Portable books, treatises, or compendiums, covering one or more subjects, arranged for quick location of information and of a size such as may conveniently be held in the hand. Examples are instructional manuals and guides to museums' collections; manuals (instructional materials). Books or treatises, often compendious, containing rules or instructions needed to perform tasks, operations, processes, occupations, arts, or studies, and intended to be used as reference while the task or study is performed.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(enchiridion, plural enchiridia: handbook, manual)"}, "madsrdf:citationSource": "Merriam-Webster online, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Enchiridia"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Enchiridia"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Companions (Handbooks)"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Companions (Handbooks)"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Enchiridions"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Enchiridions"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Manuals"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Manuals"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vade-mecums"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vade-mecums"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pocket companions"}}, {"@id": "_:n6ad6d0ae5d6d440bb213ffcedfa4c278b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pocket companions"}}], "@id": "/authorities/genreForms/gf2014026109"}
