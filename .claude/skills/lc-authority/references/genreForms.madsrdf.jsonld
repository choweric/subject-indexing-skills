r the prosecution or as a defense lawyer)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n544cab3e8b7347ce93577d8b03065f93b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n544cab3e8b7347ce93577d8b03065f93b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lawyer films"}}, {"@id": "_:n544cab3e8b7347ce93577d8b03065f93b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lawyer films"}}, {"@id": "_:n544cab3e8b7347ce93577d8b03065f93b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n544cab3e8b7347ce93577d8b03065f93b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trial films"}}, {"@id": "_:n544cab3e8b7347ce93577d8b03065f93b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trial films"}}, {"@id": "_:n544cab3e8b7347ce93577d8b03065f93b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n544cab3e8b7347ce93577d8b03065f93b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Law films"}}, {"@id": "_:n544cab3e8b7347ce93577d8b03065f93b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Law films"}}, {"@id": "_:n544cab3e8b7347ce93577d8b03065f93b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n544cab3e8b7347ce93577d8b03065f93b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Courtroom films"}}, {"@id": "_:n544cab3e8b7347ce93577d8b03065f93b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Courtroom films"}}], "@id": "/authorities/genreForms/gf2011026353"}
