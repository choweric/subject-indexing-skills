ns/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc2460a579aa64b30bfc3a5a853591651b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Webisodes"}}, {"@id": "_:nc2460a579aa64b30bfc3a5a853591651b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "webisode (an episode especially of a TV show that may or may not have been telecast but can be viewed at a Web site)"}, "madsrdf:citationSource": "Merriam-Webster online dictionary, Nov. 10, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc2460a579aa64b30bfc3a5a853591651b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "webisode (short episode which airs initially as Internet television, either download or stream as opposed to first airing on broadcast or cable television; simply a web episode -- collectively it is part of a web series, a form of new medium called web television that characteristically features a dramatic, serial storyline, where the primary method of viewership is streaming online over the Internet; portmanteau of \"web\" and \"episode\")"}, "madsrdf:citationSource": "Wikipedia, Nov. 10, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc2460a579aa64b30bfc3a5a853591651b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(web episode: 227,000 hits; webisode: 1,420,000 hits)"}, "madsrdf:citationSource": "Google, Nov. 10, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc2460a579aa64b30bfc3a5a853591651b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc2460a579aa64b30bfc3a5a853591651b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Episodes, Web"}}, {"@id": "_:nc2460a579aa64b30bfc3a5a853591651b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Episodes, Web"}}, {"@id": "_:nc2460a579aa64b30bfc3a5a853591651b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc2460a579aa64b30bfc3a5a853591651b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Web episodes"}}, {"@id": "_:nc2460a579aa64b30bfc3a5a853591651b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Web episodes"}}], "@id": "/authorities/genreForms/gf2011026732"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026733", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWerewolf films", "identifiers:lccn": "gf2011026733", "madsrdf:adminMetadata": [{"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b1"}, {"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Werewolf films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026402"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026056"}], "madsrdf:hasSource": [{"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b5"}, {"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b6"}, {"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025222"}}, {"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Werewolf films"}}, {"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Werewolf drama: use for fictional genre films and programs which feature humans who change into wolves; BT Monster drama)"}, "madsrdf:citationSource": "Yee, M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Paranormal films. Films about the paranormal, purported phenomena described in popular culture, folk, and other non-scientific bodies of knowledge, whose existence within these contexts is described as beyond normal experience or scientific explanation; paranormal phenomena include extrasensory perception (ESP), telekinesis, ghosts, poltergeists, life after death, reincarnation, faith healing, human auras, and so forth)"}, "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nef13cdfe87f8420ea31889a54f055bb0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Werewolf Movie. The werewolf is another great in the pantheon of famous monsters)"}, "madsrdf:citationSource": "L\u00f3pez, Daniel. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026733"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026734", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWerewolf television programs", "identifiers:lccn": "gf2011026734", "madsrdf:adminMetadata": [{"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb1"}, {"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Werewolf television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026403"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026112"}], "madsrdf:hasSource": [{"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb5"}, {"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb6"}, {"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025521"}}, {"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Werewolf television programs"}}, {"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Television about werewolves. Television programs featuring werewolves. Examples: Buffy the Vampire Slayer; Big Wolf on Campus; Monster Squad; Paranormal Witness; She-Wolf of London; True Blood; Werewolf; Wolf Lake)"}, "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Werewolf. Amazing grace, 1988.", "madsrdf:citationStatus": "found"}, {"@id": "_:n44496cdddeee43f786bb7fbe65c8460bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 102 (Werewolf films and programs: use for fictional genre films and programs which feature humans who change into wolves)"}, "madsrdf:citationSource": "Yee, Martha M. Moving image materials : genre terms, 1988:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026734"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026735", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWestern films", "identifiers:lccn": "gf2011026735", "madsrdf:adminMetadata": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb1"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Western films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb5"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb8"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb11"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026577"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026595"}], "madsrdf:hasSource": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb14"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb15"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb16"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb17"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb18"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb19"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb20"}], "madsrdf:hasVariant": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb21"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb24"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb27"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb30"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb33"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb36"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb39"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb42"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb45"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb48"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb51"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb54"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature the American West during the period of westward expansion.", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026135"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026371"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026750"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025276"}]}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:04:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Western films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lone Ranger films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lone Ranger films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Zorro films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zorro films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cisco Kid films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cisco Kid films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(western: Fictional work set in the period of American westward expansion. In the name of civilization, the wilderness is conquered and nature subordinated. Key thematic oppositions are between civilization and nature, law and anarchy, settler and nomad, and the new arrivals and the Native American. The hero is a person of integrity and principle, who tames the land, stands alone, faces danger, and is the fastest draw)"}, "madsrdf:citationSource": "Moving image genre-form guide via WWW, July 19, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Western; a film genre since earliest days of motion pictures that derives from the history and legends of the western part of this country, especially during the last half of the nineteenth century; horse opera, horse pic: Slang for a Western)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dictionary, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. lxi, v. 3 (cowboy and Indian films)"}, "madsrdf:citationSource": "A history of early film, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Western (Cowboy Film, Western Film). Westerns are an amalgam of myth, history and legend--fantasy and reality intertwine. Set on the North American continent (movies set in Latin America, Australia, South Africa, or other lands are not authentic Westerns), they are based on tradition and a solid historical heritage. Many western heroes existed in real life ... and some of the Western sagas describe real historical episodes of the conquest of the American West; peopled by a profusion of colorful and familiar types--cowboys, Indians, U.S. marshalls, rangers, bounty hunters, Mexicans, half-breeds, saloon girls, homesteaders, carpetbaggers and John Wayne who appeared in 153 movies; fall under seven basic plot types; the terms oater, oats opera, horse opera or horse opry are synonymous with Western; they also have a derogatory meaning indicating a cheaply made film about cowboys--a B-Western. A sagebrusher is another slang term for a Western)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sagebrush saga: Nickname for a Western movie. Also called a sagebrusher. Entertainment trade paper use.)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dictionary, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Western (genre). The Western is a genre of various visual arts, such as film, television, radio, literature, painting and others. Westerns are devoted to telling stories set primarily in the latter half of the 19th century in the American Old West). Some Westerns are set as early as the Battle of the Alamo in 1836. There are also a number of films about Western-type characters in contemporary settings, such as Junior Bonner set in the 1970s and The Three Burials of Melquiades Estrada in the 21st century. The American Film Institute defines western films as those \"set in the American West that embod[y] the spirit, the struggle and the demise of the new frontier.\")"}, "madsrdf:citationSource": "Wikipedia, Oct. 4, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Western. A descriptive label for a type of motion picture that is characteristically American in its mythic origins. Generally, westerns are set on the American frontier during the latter part of the 19th century.)"}, "madsrdf:citationSource": "Beaver, F.E. Dictionary of film terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cisco Kid films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cisco Kid films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cowboy and Indian films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cowboy and Indian films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Horse opries (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horse opries (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oaters (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oaters (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lone Ranger films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lone Ranger films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cowboy films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cowboy films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Westerns (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Westerns (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb42", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb43"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sagebrushers (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb43", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sagebrushers (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb45", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb46"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oats operas (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb46", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oats operas (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb48", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb49"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Horse operas (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb49", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horse operas (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb51", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb52"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Zorro films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb52", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zorro films"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb54", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb55"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Horse pics (Motion pictures)"}}, {"@id": "_:ne333852ee1a24dbbbfefa3fdd511b0eeb55", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horse pics (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2011026735"}
