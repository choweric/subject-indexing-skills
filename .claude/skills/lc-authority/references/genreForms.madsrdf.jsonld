01b427f58569f8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-31T10:15:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmographies"}}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(filmographies. Selective or complete lists of motion pictures, typically by one director, actor, or on a specific subject. BT lists (document genres))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Jan. 18, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Burton, Alan. The British co-operative movement film catalogue, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(filmography, plural filmographies: a list of motion pictures featuring the work of a prominent film figure or relating to a particular topic)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Jan. 18, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kalat, D. A critical history and filmography of Toho's Godzilla series, \u00a92010.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Prassel, I. Filmografija slovenskega animiranega filma 1952-2012 = Filmography of Slovenian animated film 1952-2012, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Drug abuse prevention films : a multicultural film catalog, 1978.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(filmography: a list of the films of a particular actor, director, genre, etc.)"}, "madsrdf:citationSource": "Webster's New World college dictionary, \u00a92010, via Collins English dictionary website, Jan. 18, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(filmography: A list of motion pictures, usually limited to works by a specific director or performer, in a particular genre, of a specific time period or country, or on a given subject, usually listed alphabetically by title or chronologically by release date. The entries in a filmography include some or all of the following elements of description: producer, distributor, director, cast, release date, running time, language, color or black and white, etc. Compare with discography)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Jan. 18, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Filmographies. Scope Note: Lists of films, sometimes including other media and/or commentary. UF Film lists. BT Reference Materials. RT Bibliographies; Film Libraries; Film Study; Films; Indexes)"}, "madsrdf:citationSource": "ERIC thesaurus online, Jan. 18, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1b9716da76a443eeaf01b427f58569f8b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Film lists"}}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film lists"}}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1b9716da76a443eeaf01b427f58569f8b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Film catalogs"}}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film catalogs"}}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1b9716da76a443eeaf01b427f58569f8b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motion picture lists"}}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion picture lists"}}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1b9716da76a443eeaf01b427f58569f8b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lists of films"}}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lists of films"}}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1b9716da76a443eeaf01b427f58569f8b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lists of motion pictures"}}, {"@id": "_:n1b9716da76a443eeaf01b427f58569f8b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lists of motion pictures"}}], "@id": "/authorities/genreForms/gf2019026014"}
