{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026011", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPirate captivity narratives", "identifiers:lccn": "gf2015026011", "madsrdf:adminMetadata": [{"@id": "_:nb14eecd1e474491580d0819fd2e70609b1"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pirate captivity narratives"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb14eecd1e474491580d0819fd2e70609b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026047"}, "madsrdf:hasSource": [{"@id": "_:nb14eecd1e474491580d0819fd2e70609b5"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b6"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b7"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b8"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b9"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b10"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b11"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b12"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b13"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b14"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b15"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b16"}], "madsrdf:hasVariant": [{"@id": "_:nb14eecd1e474491580d0819fd2e70609b17"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b20"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-11-09T15:31:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pirate captivity narratives"}}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Brown, E. Cochin China and my experiences in it : a seaman's narrative of his adventures and sufferings during a captivity among Chinese pirates on the coast of Cochin China ... 1861.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 391 (Barbary captivity narratives; pirate captivity narratives)"}, "madsrdf:citationSource": "Early American literature, v. 41, no. 2 (2006), viewed online Sept. 2, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Barbary captivity narratives (Much of the outrage surrounding Barbary piracy stemmed from their practice of enslaving Christian captives. Muslim privateers would sell captured crew members and passengers to private slaveholders who in turn would demand ransom for the prisoners' release or force them into hard labor. A handful of these captives, upon returning to America or England, wrote books describing and dramatizing their time as prisoners in North Africa. Much like Indian captivity narratives, the authors often sensationalized their experiences and focused on the exotic aspects of their captors' society. Though these narratives should not be relied on as strictly factual accounts, they provide insights into daily life in Ottoman North Africa, and are expressions of how one culture viewed another. Some captives, such as William Ray (Horrors of Slavery), used their experiences as a Barbary slave to criticize slavery in America. Barbary slaves suffered heavy labor, poor diets, and demeaning circumstances, much like their African counterparts in the United States. However, white captives could often escape slavery by converting to Islam and adopting North Africa as their home.)"}, "madsrdf:citationSource": "The Barbary Wars at the Clements, via University of Michigan Clements Library website, viewed Sept. 2, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Smith, A. The atrocities of the pirates : being a faithful narrative of the unparalleled sufferings endured by the author during his captivity among the pirates of the island of Cuba, 1824.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Captivity narrative: Barbary captivity narratives, accounts of English people captured and held by Barbary pirates, were popular in England in the 16th and 17th centuries. The first Barbary captivity narrative by a resident of North America was that of Abraham Browne (1655). The most popular was that of Captain James Riley, entitled An Authentic Narrative of the Loss of the Brig Commerce (1817))"}, "madsrdf:citationSource": "Wikipedia, Sept. 2, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Loviot, F. Pirates chinois. English. A lady's captivity among Chinese pirates in the Chinese seas, 1858.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "White slaves, African masters : an anthology of American Barbary captivity narratives, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: The narrative of Mr. John Soren : a native of the United States of America, piratically captured on the high seas, in requital for an act of humanity, in saving a British transport, with near 300 troops on board, from sinking, 1800, via Eighteenth century collections online, viewed on Sept. 2, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sufferings of John Turner, chief mate of the country ship, Tay, bound for China, under the command of William Greig, including the seizure of him and six Lascars in the cutter, and their captivity and danger amongst the Ladrones, with a description of the strength, discipline, manners, &c. of these pirates, their depradations and conduct towards their prisoners, 1809?", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Piracy, slavery, and redemption : Barbary captivity narratives from early modern England, \u00a92001.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 8 (pirate captivity narratives)"}, "madsrdf:citationSource": "Journal of Middle East women's studies, v. 10, no. 3 (fall 2014), viewed online Sept. 2, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b16", "@type": "madsrdf:Source", "madsrdf:citationSource": "Moseley, I. A narration of the captivity of John Fillmore and his escape from the pirates, 1790.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb14eecd1e474491580d0819fd2e70609b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Captivity narratives, Barbary"}}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Captivity narratives, Barbary"}}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb14eecd1e474491580d0819fd2e70609b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Barbary captivity narratives"}}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Barbary captivity narratives"}}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb14eecd1e474491580d0819fd2e70609b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Captivity narratives, Pirate"}}, {"@id": "_:nb14eecd1e474491580d0819fd2e70609b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Captivity narratives, Pirate"}}], "@id": "/authorities/genreForms/gf2015026011"}
