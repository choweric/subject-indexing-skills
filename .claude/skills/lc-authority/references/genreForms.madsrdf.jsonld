, "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd55e11034563482b98d67850939e4bbab57"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Manga-influenced comics"}}, {"@id": "_:nd55e11034563482b98d67850939e4bbab57", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Manga-influenced comics"}}, {"@id": "_:nd55e11034563482b98d67850939e4bbab59", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd55e11034563482b98d67850939e4bbab60"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "World manga"}}, {"@id": "_:nd55e11034563482b98d67850939e4bbab60", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "World manga"}}], "@id": "/authorities/genreForms/gf2022026036"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026037", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aQueer poetry", "identifiers:lccn": "gf2022026037", "madsrdf:adminMetadata": [{"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb1"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Queer poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026002"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026003"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026054"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026002"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026003"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026007"}], "madsrdf:hasSource": [{"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb5"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb6"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb7"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb8"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb9"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb10"}], "madsrdf:hasVariant": [{"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb11"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb14"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb17"}], "madsrdf:historyNote": "[Established September 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry featuring queer characters or addressing queer themes."}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/nmw"}, "ri:recordStatus": "revised"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-05-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Queer poetry"}}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Queer poetry. BT LGBTQ+ poetry)"}, "madsrdf:citationSource": "Homosaurus, May 27, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1163632135"}, "madsrdf:citationSource": "Super stoked : an anthology of queer poetry from the Capturing Fire Slam & Summit, 2018.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: A comprehensive anthology of poetry by American gays, lesbians, bisexuals and transgender persons. It includes representative poems from more than 100 writers from pre-colonial times to the end of the Second World War) (OCoLC)52622011"}, "madsrdf:citationSource": "Masquerade : queer poetry in America to the end of World War II, \u00a92004", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Queering the Green brings together 31 of the most distinctive Irish poets to emerge since 2000 and, taken together, these writers represent the multiplicity and vibrancy of the queer experience in 21st century Ireland) (OCoLC)1309489195"}, "madsrdf:citationSource": "Work cat.: Queering the green : post-2000 queer Irish poetry, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LGBTQ poetry; has narrow synonym: LGBT poetry; has related synonym: queer poetry; subclass of: poetry; narrower terms: bisexual poetry; gay male poetry; lesbian poetry; transgender poetry)"}, "madsrdf:citationSource": "GSSO - the Gender, Sex, and Sexual Orientation ontology, May 27, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1183421258"}, "madsrdf:citationSource": "The world that belongs to us : an anthology of queer poetry from South Asia, 2020.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sexual minority poetry"}}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sexual minority poetry"}}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "LGBTQ+ poetry"}}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "LGBTQ+ poetry"}}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "GLBTQ+ poetry"}}, {"@id": "_:n1fba4aacc0b7473aa02edccd3c83d9cdb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "GLBTQ+ poetry"}}], "@id": "/authorities/genreForms/gf2022026037"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026038", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBisexual films", "identifiers:lccn": "gf2022026038", "madsrdf:adminMetadata": [{"@id": "_:ne7dc9d02d75643c28204a0056f483944b1"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bisexual films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne7dc9d02d75643c28204a0056f483944b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026039"}, "madsrdf:hasSource": [{"@id": "_:ne7dc9d02d75643c28204a0056f483944b5"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b6"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b7"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b8"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b9"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b10"}], "madsrdf:hasVariant": {"@id": "_:ne7dc9d02d75643c28204a0056f483944b11"}, "madsrdf:historyNote": "[Established September 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films featuring bisexual characters or addressing bisexual themes."}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-05-31T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "revised"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bisexual films"}}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Homosaurus, viewed May 30, 2022", "madsrdf:citationStatus": "notfound"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "summary note (LGBT Studies in Video is a cinematic survey of the lives of lesbian, gay, bisexual, and transgender people as well as the cultural and political evolution of the LGBT community. It features award-winning documentaries, interviews, archival footage, and select feature films exploring LGBT history, gay culture and subcultures, civil rights, marriage equality, LGBT families, AIDS, transgender issues, religious perspectives on homosexuality, global comparative experiences, and other topics. A primary partner for this collection is Frameline, a nonprofit media organization that produces the San Francisco International LGBT Film Festival, the oldest film festival devoted to lesbian, gay, bisexual, and transgender programming currently in existence.) (OCoLC)815671104"}, "madsrdf:citationSource": "Work cat.: LGBT studies in video, accessed May 30, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "summary note (The film follows Ben, a young bisexual man, as he comes out to the world and develops an intense relationship with Sam, a closeted man struggling with deep wounds of his own. As the summer progresses and their intimacy grows, their pasts begin to crawl to the surface) (OCoLC)1289638503"}, "madsrdf:citationSource": "Cicada, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "summary note (Set in a working-class apartment building in Rome, the lives of a bisexual former body builder, his wife, his male lover, and a pair of ambitions criminals intersect against a backdrop of crime, confused sexual feelings, and tainted relationships) (OCoLC)1045072406"}, "madsrdf:citationSource": "Tainted souls, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bisexuality-related film. SN Film pertaining especially to bisexual persons and/or culture. Alternate name: bisexuality-related films. Has synonym: bisexual-related film. Subclass of: LGBTQ-related film; bisexuality-related media)"}, "madsrdf:citationSource": "GSSO - the Gender, Sex, and Sexual Orientation ontology, viewed May 30, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "summary note (Joe, a bisexual hustler, takes to the streets and meets an artist with elaborate and hilarious theories of body worship, a couple of transvestites, a dumb ex-girlfriend, and a friend whose armpits have been burned by a flamethrower) (OCoLC)46349232"}, "madsrdf:citationSource": "Flesh (Motion picture : 1968). Flesh, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7dc9d02d75643c28204a0056f483944b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bi films"}}, {"@id": "_:ne7dc9d02d75643c28204a0056f483944b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bi films"}}], "@id": "/authorities/genreForms/gf2022026038"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026039", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aQueer films", "identifiers:lccn": "gf2022026039", "madsrdf:adminMetadata": [{"@id": "_:nfc60cf0190554dd891e750c717a47cdab1"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Queer films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfc60cf0190554dd891e750c717a47cdab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026030"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026031"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026079"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026005"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026038"}], "madsrdf:hasSource": [{"@id": "_:nfc60cf0190554dd891e750c717a47cdab5"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab6"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab7"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab8"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab9"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab10"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab11"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab12"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab13"}], "madsrdf:hasVariant": [{"@id": "_:nfc60cf0190554dd891e750c717a47cdab14"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab17"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab20"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab23"}], "madsrdf:historyNote": "[Established September 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films featuring queer characters or addressing queer themes."}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "revised"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-06-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Queer films"}}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)917362564"}, "madsrdf:citationSource": "Perriam, C. French and Spanish queer film, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the legendary and revolutionary queer movie Hedwig and the Angry Inch; raw, powerful story of identity and self-acceptance ... opening a new chapter in the legacy of queer narratives on screen; until that point, there weren't many mainstream films that put an LGBTQIA+ person in the central narrative)"}, "madsrdf:citationSource": "Bona\u010di\u0107, D. Hedwig and the Angry Inch--the people behind the cult queer film, via WePresent website, posted Sep 23, 2021, viewed June 1, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(classic queer film; a queer fairy tale--the rare entry in the LGBTQ canon that was not a documentary, or a gay manifesto, or a trans statement, though some have interpreted it as falling into one of those categories; genderqueer heroine)"}, "madsrdf:citationSource": "Azzopardi, C. Why Hedwig and the Angry Inch still sings--and blows Bohemian Rhapsody away, via Vanity fair website, posted June 25, 2019, viewed June 1, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1289634425"}, "madsrdf:citationSource": "Ebner, C. Love in the time of cinema : a queer feminist analysis of reviews of four mainstream queer films, 2021.", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LGBTQ+ films; no BT)"}, "madsrdf:citationSource": "Homosaurus, viewed June 1, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(queer film featuring a genderqueer protagonist) (OCoLC)1100115904"}, "madsrdf:citationSource": "Work cat.: Hedwig and the Angry Inch (Motion picture). Hedwig and the Angry Inch, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hedwig and the Angry Inch (2001); traces the ups and downs in the life of a genderqueer East Berliner who, following a botched sex change operation, moves to America and becomes a glam-rock diva)"}, "madsrdf:citationSource": "Fear, D. 50 essential LGBTQ movies, via Rolling stone website, posted June 25, 2020, viewed June 1, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LGBTQ-related film. Alternate name: LGBTQ-related films. Has narrow synonym: LGBT film. Has synonym: LGBTQ film. Short name: LGBT-related film. Subclass of: subculture film)"}, "madsrdf:citationSource": "GSSO - the Gender, Sex, and Sexual Orientation ontology, via WWW, June 1, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1247834558"}, "madsrdf:citationSource": "The Oxford handbook of queer cinema, 2021.", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfc60cf0190554dd891e750c717a47cdab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sexual minority films"}}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sexual minority films"}}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfc60cf0190554dd891e750c717a47cdab18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "LGBTQ+ films"}}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "LGBTQ+ films"}}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfc60cf0190554dd891e750c717a47cdab21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "LGBT films"}}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "LGBT films"}}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfc60cf0190554dd891e750c717a47cdab24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "GLBTQ+ films"}}, {"@id": "_:nfc60cf0190554dd891e750c717a47cdab24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "GLBTQ+ films"}}], "@id": "/authorities/genreForms/gf2022026039"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026041", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChristian metal (Music)", "identifiers:lccn": "gf2022026041", "madsrdf:adminMetadata": [{"@id": "_:na9c7934af7544fc0a464eaf2254cde09b1"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Christian metal (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na9c7934af7544fc0a464eaf2254cde09b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026854"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026048"}], "madsrdf:hasSource": [{"@id": "_:na9c7934af7544fc0a464eaf2254cde09b5"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b6"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b7"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b8"}], "madsrdf:hasVariant": [{"@id": "_:na9c7934af7544fc0a464eaf2254cde09b9"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b12"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b15"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b18"}], "madsrdf:historyNote": "[Established September 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-06-03T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-07T10:18:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Christian metal (Music)"}}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(widely considered to be a landmark album of the Christian metal movement; a concept album describing the New Testament and the life of Christ)"}, "madsrdf:citationSource": "Work cat: Exhumed of the earth, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstract (The significance of Christian heavy metal music lies not in commercial success or in the originality of its form but rather in what it reveals about American evangelicals' relationship to the dominant culture and music of the decade between 1984 and 1994. Because the heavy metal genre was surrounded by negative publicity in both religious and secular circles, it was generally agreed that metal represented the extreme of the music world. Thus, by engaging with secular metal, Christian musicians demonstrated that, in the \"war of position\" over American youth, evangelicals would not cede even the farthest reaches of the music world to either secular or satanic control)"}, "madsrdf:citationSource": "Luhr, E. Metal Missionaries to the Nation: Christian Heavy Metal Music, \"Family Values,\" and Youth Culture, 1984-1994, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Christian metal (\"Christian metal, also known as white metal, Jesus metal or heavenly metal, is heavy metal music distinguished by its Christian themed song lyrics and the dedication of the band members to Christianity. Christian metal is typically performed by professed Christians, principally for Christians and is often produced and distributed through various Christian networks. Christian metal bands exist in most of the subgenres of heavy metal music, and the only common link among most Christian metal bands are the lyrics. The Christian themes are often melded with the subjects of the genre the band is rooted in, regularly providing a Christian take on the subject matter. It has been argued that the marginal yet transnational Christian metal subculture provides its core members with an alternative religious expression and Christian identity, and that the music serves the purpose of offering a positive message through lyrical content. This may not necessarily show a direct connection or reference to the Christian faith but often it does. Christian metal emerged in the late 1970s as a means of evangelization to the wider heavy metal music scene and was pioneered by the American Resurrection Band and Barnabas, the Swedish Jerusalem, and Canadian Daniel Band. Los Angeles' Stryper achieved wide success in the 1980s. In the mid to late 1980s, extreme metal genres were popularized by bands such as Vengeance Rising, Deliverance, Believer and Tourniquet. Another Christian metal band that was successful during the 80s was American band Stryper, whose album, To Hell with the Devil, sold over two million copies. In the early 1990s, the Australian death metal band Mortification rose to prominence within its country's underground metal scene.At the turn of the 21st century, the nu metal band P.O.D, with two platinum-selling albums, achieved a mainstream commercial success rivaling that of Stryper. The metalcore groups Underoath, Demon Hunter, As I Lay Dying and Norma Jean (dubbed \"The Holy Alliance\" by Revolver Magazine) also brought some mainstream attention to the movement in the first decade of the 2000s, achieving ranks in the Billboard 200. Between the 2000s and 2020s, the Christian metal band Skillet had two albums receiving Grammy nominations, two albums certified platinum and double platinum, and various singles certified platinum and gold\")"}, "madsrdf:citationSource": "Wikipedia, viewed June 3, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music", "madsrdf:citationStatus": "notfound"}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9c7934af7544fc0a464eaf2254cde09b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Christian heavy metal (Music)"}}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Christian heavy metal (Music)"}}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9c7934af7544fc0a464eaf2254cde09b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jesus metal (Music)"}}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jesus metal (Music)"}}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9c7934af7544fc0a464eaf2254cde09b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "White metal (Music)"}}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "White metal (Music)"}}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9c7934af7544fc0a464eaf2254cde09b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Heavenly metal (Music)"}}, {"@id": "_:na9c7934af7544fc0a464eaf2254cde09b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heavenly metal (Music)"}}], "@id": "/authorities/genreForms/gf2022026041"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026043", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLongitudinal studies", "identifiers:lccn": "gf2022026043", "madsrdf:adminMetadata": [{"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb1"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Longitudinal studies"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb5"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb6"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb7"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb8"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb9"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb10"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb11"}], "madsrdf:hasVariant": [{"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb12"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb15"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb18"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb21"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb24"}], "madsrdf:historyNote": "[Established September 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-07T10:19:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-06-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Longitudinal studies"}}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(longitudinal study: A research methodology in which the same phenomenon is observed continuously or at intervals over an extended period of time, usually to discern temporal patterns or identify changes that occur in response to altered conditions)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, June 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivision --Longitudinal studies. SN Use as a form subdivision under classes of persons, ethnic groups, and topical headings for works that report the results of longitudinal studies on those groups or topics. BT --Case studies)"}, "madsrdf:citationSource": "LCSH, June 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Longitudinal studies. BT Case studies; FAST concept scheme: FormGenre)"}, "madsrdf:citationSource": "FAST, June 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Both the cross-sectional and the longitudinal studies are observational studies. This means that researchers record information about their subjects without manipulating the study environment; in a longitudinal study, researchers conduct several observations of the same subjects over a period of time, sometimes lasting many years. The benefit of a longitudinal study is that researchers are able to detect developments or changes in the characteristics of the target population at both the group and the individual level. The key here is that longitudinal studies extend beyond a single moment in time. As a result, they can establish sequences of events)"}, "madsrdf:citationSource": "Cross-sectional vs. longitudinal studies, 2015, via Institute for Work & Health website, viewed June 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In a longitudinal study, researchers repeatedly examine the same individuals to detect any changes that might occur over a period of time. Longitudinal studies are a type of correlational research in which researchers observe and collect data on a number of variables without trying to influence those variables. While they are most commonly used in medicine, economics, and epidemiology, longitudinal studies can also be found in the other social or medical sciences; No set amount of time is required for a longitudinal study, so long as the participants are repeatedly observed. They can range from as short as a few weeks to as long as several decades. However, they usually last at least a year, oftentimes several; The opposite of a longitudinal study is a cross-sectional study. While longitudinal studies repeatedly observe the same participants over a period of time, cross-sectional studies examine different samples (or a \"cross-section\") of the population at one point in time. They can be used to provide a snapshot of a group or society at a specific moment)"}, "madsrdf:citationSource": "Thomas, L. Longitudinal study : definition, approaches & examples, 2020, via Scribbr website, viewed June 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (Fifteen women who received a computer science bachelor's degree from a major research university in the Pacific Northwest were longitudinally studied using a qualitative study format. The study design consisted of a series of interviews and observations during the women's senior year of college and a career interview four to five years later. ... The results indicate that sponsorship had a significant positive impact on the women's initial matriculation in the computer science major and that stereotype threat was prevalent but not a deterrent to the women's study of computer science, at times even acting as a motivating force) (OCoLC)897843637"}, "madsrdf:citationSource": "Work cat.: O'Connor, A. Women's persistence in computer science : a longitudinal qualitative study, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(longitudinal: 2. in research, referring to the time dimension--that is, running over an extended period; longitudinal data: information obtained through multiple measurements of the same individuals over a period of time. For example, a researcher investigating the use of coping strategies in college students may evaluate stress levels at the beginning, middle, and end of the fall and spring semesters; longitudinal design: longitudinal design: the study of a variable or group of variables in the same cases or participants over a period of time, sometimes several years. An example of a longitudinal design is a multiyear comparative study of the same children in an urban and a suburban school to record their cognitive development in depth. A longitudinal study that evaluates a group of randomly chosen individuals is referred to as a panel study, whereas a longitudinal study that evaluates a group of individuals possessing some common characteristic (usually age) is referred to as a cohort study. Also called longitudinal research; longitudinal study. Compare cross-sectional design)"}, "madsrdf:citationSource": "APA dictionary of psychology, via American Psychological Association website, June 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Panel studies"}}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Panel studies"}}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Studies, Longitudinal"}}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies, Longitudinal"}}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Studies, Panel"}}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies, Panel"}}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Studies, Cohort"}}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies, Cohort"}}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cohort studies"}}, {"@id": "_:nb63d3debfb3c4277aebb1815b4a14d6fb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cohort studies"}}], "@id": "/authorities/genreForms/gf2022026043"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026044", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCross-cultural studies", "identifiers:lccn": "gf2022026044", "madsrdf:adminMetadata": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb1"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cross-cultural studies"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb5"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb6"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb7"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb8"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb9"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb10"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb11"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb12"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb13"}], "madsrdf:hasVariant": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb14"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb17"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb20"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb23"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb26"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb29"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb32"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb35"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb38"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb41"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb44"}], "madsrdf:historyNote": "[Established September 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-06-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-07T10:19:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cross-cultural studies"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)4667022"}, "madsrdf:citationSource": "Jordan, Brigitte. Birth in four cultures : a crosscultural investigation of childbirth in Yucatan, Holland, Sweden, and the United States, 1978.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivision --Cross-cultural studies. SN Use as a form subdivision under topical headings for works that report the results of cross-cultural studies on those topics; topical subject heading Cross-cultural studies. UF Inter-cultural studies; Intercultural studies; Trans-cultural studies; Transcultural studies)"}, "madsrdf:citationSource": "LCSH, June 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1111699141"}, "madsrdf:citationSource": "Work cat.: A cross-cultural consideration of teacher leaders' narratives of power, agency, and school culture : England, Jamaica and the United States, 2020.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)43190536"}, "madsrdf:citationSource": "Nanda, Serena. Gender diversity : crosscultural variations, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cross-cultural studies involve persons from different countries and/or ethnic groups)"}, "madsrdf:citationSource": "Cross cultural studies - an overview, via ScienceDirect website, June 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(cross-cultural research: the systematic study of human psychological processes and behavior across multiple cultures, involving the observation of similarities and differences in values, practices, and so forth between different societies. Cross-cultural research offers many potential advantages, informing theories that accommodate both individual and social sources of variation, but also involves numerous risks, notable among them the production of cultural knowledge that is incorrect because of flawed methodology. Indeed, there are a host of methodological concerns that go beyond monocultural studies, including issues concerning translation, measurement, equivalence, sampling, data analytic techniques, and data reporting. Also called cross-cultural method; cross-cultural study)"}, "madsrdf:citationSource": "APA dictionary of psychology, via American Psychological Association website, June 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cross-cultural studies; FAST concept scheme: FormGenre)"}, "madsrdf:citationSource": "FAST, June 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 52 (Cross-cultural studies are those that use standard forms of measurement, such as Likert scales, to compare people from different cultures and identify their differences. Cross-cultural studies serve as backbone of cross-cultural research in psychology but methodological issues can have an impact on research quality)"}, "madsrdf:citationSource": "Worthy, L.D. Culture and psychology, 2019?, open access textbook viewed online June 9, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(cross-cultural studies. UF cross cultural studies. BT comparative studies)"}, "madsrdf:citationSource": "American Folklore Society ethnographic thesaurus, via LC Linked Data Service, June 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Studies, Intercultural"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies, Intercultural"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Studies, Cross-cultural"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies, Cross-cultural"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Intercultural studies"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intercultural studies"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Studies, Trans-cultural"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies, Trans-cultural"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Studies, Crosscultural"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies, Crosscultural"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Studies, Inter-cultural"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies, Inter-cultural"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Inter-cultural studies"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Inter-cultural studies"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trans-cultural studies"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trans-cultural studies"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb38", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb39"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Transcultural studies"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb39", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transcultural studies"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb41", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb42"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crosscultural studies"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb42", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crosscultural studies"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb44", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndffa2eec1f614044846d85d802b9b97bb45"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Studies, Transcultural"}}, {"@id": "_:ndffa2eec1f614044846d85d802b9b97bb45", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies, Transcultural"}}], "@id": "/authoritie