rmons"}}, {"@id": "_:n5f5ffe2576a84241841e721276facae9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Passover sermons. BT Jewish festival-day sermons)"}, "madsrdf:citationSource": "LCSH, Jan. 17, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n5f5ffe2576a84241841e721276facae9b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Freehof, S.B. The eternal miracle : a Passover sermon, 1928.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5f5ffe2576a84241841e721276facae9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LCSH assigned: Passover sermons; Jewish sermons, Hebrew)"}, "madsrdf:citationSource": "2015477944: \u1e6cal, S. \u1e6cal \u1e25ayim (Pesa\u1e25). Sefer \u1e6cal \u1e25ayim, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n5f5ffe2576a84241841e721276facae9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LCSH assigned includes: Passover sermons; Jewish sermons, American)"}, "madsrdf:citationSource": "Work cat.: 2001390147: The Carlebach Haggadah, \u00a92001", "madsrdf:citationStatus": "found"}, {"@id": "_:n5f5ffe2576a84241841e721276facae9b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hertz, J.H. In ancient Egypt and present-day Germany : a Passover sermon, 1933.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026012"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026013", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHaggadot (Liturgical books)", "identifiers:lccn": "gf2019026013", "madsrdf:adminMetadata": [{"@id": "_:n0244a92e6ea24401aae15c561357cd2ab1"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Haggadot (Liturgical books)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0244a92e6ea24401aae15c561357cd2ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026039"}, "madsrdf:hasSource": [{"@id": "_:n0244a92e6ea24401aae15c561357cd2ab5"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab6"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab7"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab8"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab9"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab10"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab11"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab12"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab13"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab14"}], "madsrdf:hasVariant": [{"@id": "_:n0244a92e6ea24401aae15c561357cd2ab15"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab18"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab21"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab24"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab27"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab30"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab33"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab36"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab39"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-14T08:16:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Haggadot (Liturgical books)"}}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a written guide to the Passover seder, which commemorates the Israelites' Exodus from Egypt. The Haggadah includes various prayers, blessings, rituals, fables, songs and information for how the seder should be performed; modern Haggadot (the plural of Haggadah) can vary widely; Haggadot vary widely in length and outlook. While some Haggadot are printed only in Hebrew and do not stray from the original text, many newer Haggadot explore alternative meanings for common seder symbols or encourage seder participants to reflect on the larger themes of emancipation and redemption and to explore their own personal feelings of persecution and freedom; while traditional Haggadot focus on the ancient story of the Exodus from Egypt, some Haggadot suggest we can understand the enslavement and freedom of our ancestors only by reflecting on present-day political situations; In 1969, the political activist and rabbi Arthur Waskow published the \"Freedom Seder\" Haggadah, which drew comparisons between the slavery and liberation of the ancient Jews to contemporary struggles such as the civil rights movement and women's movement. The Stonewall Seder is an LGBTQ Haggadah; a number of social justice Haggadot or supplements speak to various communities and causes that might lie outside the Jewish community like the Black Lives Matter movement, hunger, and labor justice issues)"}, "madsrdf:citationSource": "The Haggadah, via My Jewish learning website, Jan. 17, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haggada, also spelled Haggadah, in Judaism, the special book containing the story of the biblical Exodus as it must be retold at the beginning of the seder dinner on Passover (Pesa\u1e25). The book's commentaries on the story of the Exodus provide a religious philosophy of Jewish history, and the book supplies answers to the traditional questions asked by children at the beginning of the seder)"}, "madsrdf:citationSource": "Britannica online, Jan. 17, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hagadah shel Pesa\u1e25 Mi-shi\u02bbabud li-ge\u02bculah = From bondage to freedom Passover Haggadah, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haggadot. UF Hagadot; Haggadoth. BT Seder--Liturgy)"}, "madsrdf:citationSource": "LCSH, Jan. 17, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haggadah (also Aggadah): 1. The text recited at the Seder on the first two nights of the Jewish Passover, including a narrative of the Exodus. 2. A legend, parable, or anecdote used to illustrate a point of the Law in the Talmud)"}, "madsrdf:citationSource": "Oxford English dictionaries website, Jan. 17, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab10", "@type": "madsrdf:Source", "madsrdf:citationSource": "81470174: Waskow, A.O. The freedom seder : a new Haggadah for Passover, \u00a91969.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haggadah or Haggodoh (plural -dahs, -das or -doth): 1. a. a book containing the order of service of the traditional Passover meal b. the narrative of the Exodus from Egypt that constitutes the main part of that service 2. another word for Aggadah; Aggadah (plural Aggadoth): 1. a. a homiletic passage of the Talmud b. collectively, the homiletic part of traditional Jewish literature, as contrasted with Halacha, consisting of elaborations on the biblical narratives or tales from the lives of the ancient Rabbis 2. any traditional homiletic interpretation of scripture. Also called: Aggada, Aggadatah, Haggadah)"}, "madsrdf:citationSource": "Collins English dictionary online, Jan. 17, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Haggadah or less commonly Haggada; plural Haggadahs or Haggadot also Haggadas or Haggadoth. 1 : Aggadah 2 : the book of readings for the seder service; Aggadah, plural Aggadot: ancient Jewish lore forming especially the nonlegal part of the Talmud)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Jan. 17, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Nesi\u02bbah le-\u1e25erut = A journey toward freedom : a liberation haggadah for lesbian, gay, & bisexual Jews and their loved ones, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 (Haggados)"}, "madsrdf:citationSource": "Work cat.: 2001390147: The Carlebach Haggadah, \u00a92001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0244a92e6ea24401aae15c561357cd2ab16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Haggados (Liturgical books)"}}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Haggados (Liturgical books)"}}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0244a92e6ea24401aae15c561357cd2ab19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Haggadas (Liturgical books)"}}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Haggadas (Liturgical books)"}}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0244a92e6ea24401aae15c561357cd2ab22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Aggadas (Liturgical books)"}}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aggadas (Liturgical books)"}}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0244a92e6ea24401aae15c561357cd2ab25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Aggadahs (Liturgical books)"}}, {"@id": "_:n0244a92e6ea24401aae15c561357cd2ab25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aggadahs (Liturgical books)"}}, {"@id": 