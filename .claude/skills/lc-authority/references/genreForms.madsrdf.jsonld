izations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8921941eb715441ebcfd96d33ba65f3db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reverse dictionaries"}}, {"@id": "_:n8921941eb715441ebcfd96d33ba65f3db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(reverse dictionary: A dictionary organized in a non-standard way, for example, alphabetically by word endings or by concept, phrase, or definition, rather than by headword)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8921941eb715441ebcfd96d33ba65f3db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 72 (reverse dictionary: 1 dictionary with entries arranged alphabetically from the end of words, 2 onomasiological dictionary giving terms for concepts or definitions)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8921941eb715441ebcfd96d33ba65f3db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Reverse indexes. UF Reverse dictionaries. BT Indexes)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n8921941eb715441ebcfd96d33ba65f3db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Reverse dictionaries. BT Dictionaries)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8921941eb715441ebcfd96d33ba65f3db9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8921941eb715441ebcfd96d33ba65f3db10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value":