/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc93927a931f840b08a2fb185e2c3b0e9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Interstitial television programs"}}, {"@id": "_:nc93927a931f840b08a2fb185e2c3b0e9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Interstitial program; short television programming which is often shown between movies or other events)"}, "madsrdf:citationSource": "Answers.com WWW site, viewed February 21, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nc93927a931f840b08a2fb185e2c3b0e9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(interstitial programming; the placement of short programs between full-length programs. For example, Home Box Office (HBO) and other movie channels schedule programs of about 2 to 25 minutes between the full-length movies)"}, "madsrdf:citationSource": "Webster's New World dictionary of media and communications, c1996", "madsrdf:citationStatus": "found"}, {"@id": "_:nc93927a931f840b08a2fb185e2c3b0e9b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nc93927a931f840b08a2fb185e2c3b0e9b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2013601143: Friends for change games. Week 4, 2011-07-17.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc93927a931f840b08a2fb185e2c3b0e9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(interstitial program; in television programming an interstitial program, or wraparound program or wraparound segment, refers to a short program which is often shown between movies or other events, e.g. a cast interview(s) after movies on premium channels. The term can also refer to a narrative bridge between segments within a program, such as Leopold Stokowski's segments in the Disney film Disney's Fantasia or the Simpson family's interludes between segments during their annual Treehouse of Horror Halloween specials)"}, "madsrdf:citationSource": "Wikipedia WWW site, viewed February 21, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nc93927a931f840b08a2fb185e2c3b0e9b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc93927a931f840b08a2fb185e2c3b0e9b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wraparound television programs"}}, {"@id": "_:nc93927a931f840b08a2fb185e2c3b0e9b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wraparound television programs"}}], "@id": "/authorities/genreForms/gf2013025009"}
