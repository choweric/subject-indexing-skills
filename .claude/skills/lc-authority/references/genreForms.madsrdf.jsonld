{"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "new"}, {"@id": "_:n68fbe937166447eba4071cb4ec3dd8e1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dances without music"}}, {"@id": "_:n68fbe937166447eba4071cb4ec3dd8e1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "streaming video file information (Mikhail Baryshnikov performs Dana Reitz's \"Unspoken Territory,\" [a dance work without music]. The footage was recorded by NBC News for use in the \"Today Show.\")"}, "madsrdf:citationSource": "Unspoken Territory, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68fbe937166447eba4071cb4ec3dd8e1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 293 (entry Silent score, A: In a musicless dance work, the (silent) music that develops from the three dimensional phrasing of the rhythm and energy of the movement, kinetic music that can be felt and hummed by the performer) page 462 (entry: Dance without music: Dance without music is an ideal, a though ideal)"}, "madsrdf:citationSource": "Dance words, 1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68fbe937166447eba4071cb4ec3dd8e1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(no entries for dance without music or musicless dance; expression dance without music used in three entries; term musicless dance does not appear in any entries)"}, "madsrdf:citationSource": "The international encyclopedia of dance via Oxford Reference online, viewed July 23, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n68fbe937166447eba4071cb4ec3dd8e1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A Quiet Evening of Dance by Choreographer William Forsythe, a musicless dance)"}, "madsrdf:citationSource": [{"@id": "https://www.theshed.org/program/66-william-forsythe-a-quiet-evening-of-dance?feed_item=168"}, "The Shed website, viewed July 23, 2024"], "madsrdf:citationStatus": "found"}, {"@id": "_:n68fbe937166447eba4071cb4ec3dd8e1b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(most common term: dance without music; less frequent term: musicless dance)"}, "madsrdf:citationSource": "Ngram, viewed July 23, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n68fbe937166447eba4071cb4ec3dd8e1b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "section Radio, page 28 (Martha Graham gives dance without music, her first adventure of the kind seen in Repertory Theatre program; \"Project in Movement for a Divine Comedy,\" marks Miss Graham's first adventure in the field of dancing without music)"}, "madsrdf:citationSource": "The New York times, January 9, 1930:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68fbe937166447eba4071cb4ec3dd8e1b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Solos with music and without, Flynn Center, 1996-04-29) (OCoLC)897132644"}, "madsrdf:citationSource": "Work cat: White Oak Dance Project, 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68fbe937166447eba4071cb4ec3dd8e1b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n68fbe937166447eba4071cb4ec3dd8e1b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Musicless dances"}}, {"@id": "_:n68fbe937166447eba4071cb4ec3dd8e1b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musicless dances"}}], "@id": "/authorities/genreForms/gf2024026067"}
