ate": {"@type": "xsd:dateTime", "@value": "2018-03-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay films"}}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay pornographic films"}}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay pornographic films"}}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay erotic films"}}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay erotic films"}}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Gay film (aka Homosexual film; these films seek to explore, present and illustrate the way of life of the homosexual; picture of the gay community is not always accurate)"}, "madsrdf:citationSource": "Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay pornographic films"}}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay pornographic films"}}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Homosexual films"}}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Homosexual films"}}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay erotic films"}}, {"@id": "_:n6f3eadbaba394e35af94f737e4206d1cb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay erotic films"}}], "@id": "/authorities/genreForms/gf2018026031"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026032", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPrison fiction", "identifiers:lccn": "gf2018026032", "madsrdf:adminMetadata": [{"@id": "_:nc747f48d57a34118863a49fd4f163a4eb1"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Prison fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc747f48d57a34118863a49fd4f163a4eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:nc747f48d57a34118863a49fd4f163a4eb5"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb6"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb7"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb8"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb9"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb10"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features prisons and prison life."}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-03-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-15T14:49:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prison fiction"}}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Writers of fiction have used prisons as settings for centuries; In novels, the prison itself is usually one of several locations, and, in films, generally the setting that the characters leave behind. When inmates don't, or can't, escape, the prison is the site of an inmate's unlikely heroics or redemption; Novels unfolding primarily in prisons are less common than films, but they tend to provide more realistic, stark details about a prison life. Almost a sub-genre of crime fiction, prison fiction, particularly by American novelists, uses the physical buildings almost as characters--and certainly as metaphors for crime and guilt; prison fiction often shows that the differentiation between being \"inside\" or \"outside\" is less distinct than we may believe)"}, "madsrdf:citationSource": "Kennedy, Sarah. Some prison fiction (Pearce, Highsmith, Greer, Bathanti), in Shenandoah, v. 66, no. 1 (2016), viewed online Mar. 16, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Werner, David R. Joint images : an annotated bibliography of prison fiction, 1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a prison novel)"}, "madsrdf:citationSource": "Work cat.: Cheever, John. Falconer, 1977", "madsrdf:citationStatus": "found"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Falconer (novel) (Falconer is a 1977 novel by American short story writer and novelist John Cheever. It tells the story of Ezekiel Farragut, a university professor and drug addict who is serving time in Falconer State Prison for the murder of his brother. Farragut struggles to retain his humanity in the prison environment, and begins an affair with a fellow prisoner.)"}, "madsrdf:citationSource": "Wikipedia, Mar. 16, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "B\u00fcssing, Sabine. Of captive queens and holy panthers : prison fiction and male homoerotic experience, \u00a91990.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Massey, Dennis. The modern American prison novel, 1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc747f48d57a34118863a49fd4f163a4eb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ghar\u0101yibah, H\u0101shim. The cat who taught me how to fly : an Arab prison novel, 2017.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026032"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026033", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGlam metal (Music)", "identifiers:lccn": "gf2018026033", "madsrdf:adminMetadata": [{"@id": "_:na763c9c00b0540d7855e84e19adf05d0b1"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Glam metal (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na763c9c00b0540d7855e84e19adf05d0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026854"}, "madsrdf:hasSource": [{"@id": "_:na763c9c00b0540d7855e84e19adf05d0b5"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b6"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b7"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b8"}], "madsrdf:hasVariant": [{"@id": "_:na763c9c00b0540d7855e84e19adf05d0b9"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b12"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-09-11T08:02:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-03-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Glam metal (Music)"}}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hair Metal; derisive term applied to the slick, pretty, and pop-oriented heavy metal and hard-rock bands of the late '80s. These bands expanded the approach of the loud but safe arena-rock bands, only they had a more distinctive visual image because they were living in the post-MTV era. Wearing flashy clothing, heavy makeup, and large, teased hair, the bands had an appearance that was more distinctive than their music, though both their look and their sound became a curse in the early '90s. After Nirvana brought grunge and alternative music to the top of the charts in 1991, hair metal bands quickly died, losing all of their popular support)"}, "madsrdf:citationSource": "Hair metal overview, via AllMusic website, Mar. 16, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Open Up and Say... Ahh! (second studio album by American glam metal band Poison)"}, "madsrdf:citationSource": "Wikipedia, Mar. 16, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(glam metal music)"}, "madsrdf:citationSource": "Work cat.: Poison (Musical group). Open up and say-- ahh!, \u21171988", "madsrdf:citationStatus": "found"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glam metal (pop metal; hair metal; lite metal). Subgenre of hard rock and heavy metal. Also called pop metal and, somewhat pejoratively, hair metal or lite metal; developed in the 1980s and flourished until the rise of grunge in the early 1990s; sound of glam metal is typically more melodic and less bottom heavy than that of hardcore metal, its vocals are characteristically sweeter, and its lyrical concerns derive more from the blues than from heavy metal mythologizing. The \"glam\" aspect of the subgenre is found in the (usually male) performers' preference for extravagant, colorful outfits and make-up over heavy metal black leather, and their excessively bouffant hairstyles)"}, "madsrdf:citationSource": "Grove music online, via Oxford music online, Mar. 16, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na763c9c00b0540d7855e84e19adf05d0b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lite metal (Music)"}}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lite metal (Music)"}}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na763c9c00b0540d7855e84e19adf05d0b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pop metal (Music)"}}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pop metal (Music)"}}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na763c9c00b0540d7855e84e19adf05d0b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hair metal (Music)"}}, {"@id": "_:na763c9c00b0540d7855e84e19adf05d0b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hair metal (Music)"}}], "@id": "/authorities/genreForms/gf2018026033"}
