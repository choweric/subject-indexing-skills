GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Newsletters"}}, {"@id": "_:n2fc86cd531f2453d9dae959c07f65859b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 58 (newsletter: informal printed report issued to members)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2fc86cd531f2453d9dae959c07f65859b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(newsletter: A serial publication consisting of no more than a few pages, devoted to news, announcements, and current information of interest primarily to a specialized group of subscribers or members of an association or organization who receive it as part of their membership.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary of library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2fc86cd531f2453d9dae959c07f65859b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(newsletters. UF newssheets. Letters, reports, or other brief written communications that communicate news, particularly those written by societies or buisiness organizations. Historically referred to serial publications consisting of one or a few printed sheets containing news and information of interest to the general public or to a special group.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2fc86cd531f2453d9dae959c07f65859b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Newsletters. BT Periodicals)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 26 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2fc86cd531f2453d9dae959c07f65859b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2fc86cd531f2453d9dae959c07f65859b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Newssheets"}}, {"@id": "_:n2fc86cd531f2453d9dae959c07f65859b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Newssheets"}}], "@id": "/authorities/genreForms/gf2014026131"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026132", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNewspapers", "identifiers:lccn": "gf2014026132", "madsrdf:adminMetadata": [{"@id": "_:n804f39f8e09c48e08f620dcf12abd64db1"}, {"@id": "_:n804f39f8e09c48e08f620dcf12abd64db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Newspapers"}, "madsrdf:elementList": {"@list": [{"@id": "_:n804f39f8e09c48e08f620dcf12abd64db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026174"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026150"}, "madsrdf:hasSource": [{"@id": "_:n804f39f8e09c48e08f620dcf12abd64db5"}, {"@id": "_:n804f39f8e09c48e08f620dcf12abd64db6"}, {"@id": "_:n804f39f8e09c48e08f620dcf12abd64db7"}, {"@id": "_:n804f39f8e09c48e08f620dcf12abd64db8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n804f39f8e09c48e08f620dcf12abd64db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n804f39f8e09c48e08f620dcf12abd64db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n804f39f8e09c48e08f620dcf12abd64db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Newspapers"}}, {"@id": "_:n804f39f8e09c48e08f620dcf12abd64db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Newspapers. Use for publications containing chiefly current or timely topical material, usually intended to appear at regular intervals, weekly or more frequently, not usually designed for ease and permanence of storage. BT Periodicals)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 26 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n804f39f8e09c48e08f620dcf12abd64db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(newspaper: A serial publication, usually printed on newsprint and issued daily, on certain days of the week, or weekly, containing news, editorial comment, regular columns, letters to the editor, cartoons, advertising, and other items of current and often local interest to a general readership.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary of library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n804f39f8e09c48e08f620dcf12abd64db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 58 (newspaper: daily or weekly printed publication)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n804f39f8e09c48e08f620dcf12abd64db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(newspapers. Serials published at stated, frequent intervals, such as daily or weekly, and containing news, editorials, features, advertisements, and other items of current interest.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026132"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026133", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNotebooks", "identifiers:lccn": "gf2014026133", "madsrdf:adminMetadata": [{"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b1"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Notebooks"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b3"}]}, "madsrdf:exampleNote": "Note under [Sketchbooks]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026163"}, "madsrdf:hasSource": [{"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b5"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b6"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b7"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b8"}], "madsrdf:hasVariant": [{"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b9"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b12"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Books produced with blank pages that are used for taking notes. For books with blank pages on which artists draw informal or rough preliminary studies see [Sketchbooks.]"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:46:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Notebooks"}}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(notebook: In modern usage, a loose-leaf or spiral binder with flexible or inflexible board or plastic covers, usually filled with blank leaves (ruled or unruled) for making notes. Some notebooks have a pocket folded across the lower edge inside the front and/or back cover for holding loose papers. Historically, blankbooks or loose sheets were often used for making notes. In ancient Rome, small parchment notebooks, probably developed from wooden tablets, were extensively used in keeping accounts. In some cases, a notebook published as the work of an important historical figure is actually a collection of papers assembled after the person's death)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary of library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 58 (note-book: small book for memoranda)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Notebooks. BT Record-keeping works. NT Commonplace books; Field notes; Laboratory notes; Lecture notes)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 26 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(notebooks. Books of blank pages, usually ruled, used for taking notes, especially by pupils and students for taking class notes or writing or drawing exercises)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Blank books"}}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blank books"}}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Note-books"}}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Note-books"}}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Blankbooks"}}, {"@id": "_:n7960a1a617f64ca5a326ce2ca4844df1b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blankbooks"}}], "@id": "/authorities/genreForms/gf2014026133"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026134", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aObituaries", "identifiers:lccn": "gf2014026134", "madsrdf:adminMetadata": [{"@id": "_:n54fba9812ec94cd682711a8cda495f9fb1"}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Obituaries"}, "madsrdf:elementList": {"@list": [{"@id": "_:n54fba9812ec94cd682711a8cda495f9fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026064"}, "madsrdf:hasSource": [{"@id": "_:n54fba9812ec94cd682711a8cda495f9fb5"}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb6"}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb7"}], "madsrdf:hasVariant": [{"@id": "_:n54fba9812ec94cd682711a8cda495f9fb8"}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb11"}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Obituaries"}}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 59 (obituary 1 register of deaths, 2 record or announcement of a death, esp. in a newspaper)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(obituary: A notice of a person's death, usually published in a newspaper or magazine, which may include a brief biographical sketch of the main events in the life of the deceased. Obituaries of well-known public figures may be researched and written long before death and kept on file in the morgue of a newspaper office, to be ready for printing on short notice. Abbreviated obit. Synonymous with death notice.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary of library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Obituaries. BT Commemorative works. RT Epitaphs. RT Memorials (Commemorative))"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 26 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n54fba9812ec94cd682711a8cda495f9fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Obits"}}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Obits"}}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n54fba9812ec94cd682711a8cda495f9fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Death notices"}}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Death notices"}}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n54fba9812ec94cd682711a8cda495f9fb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Necrologies"}}, {"@id": "_:n54fba9812ec94cd682711a8cda495f9fb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Necrologies"}}], "@id": "/authorities/genreForms/gf2014026134"}
