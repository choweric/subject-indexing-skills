": "2015-12-02T13:44:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1ec032331a1d480893d281d4817873e6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnic radio programs"}}, {"@id": "_:n1ec032331a1d480893d281d4817873e6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. C2 (ethnic radio programs)"}, "madsrdf:citationSource": "Seattle post-intelligencer, Aug. 23, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ec032331a1d480893d281d4817873e6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 48 (ethnic broadcasts) p. 69 (ethnic programs)"}, "madsrdf:citationSource": "Grame, T.C. Ethnic broadcasting in the United States, 1980:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ec032331a1d480893d281d4817873e6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ethnic: Programming designed to appeal to one specific racial or ethic audience)"}, "madsrdf:citationSource": "StreamingRadioGuide.com, Dec. 7, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ec032331a1d480893d281d4817873e6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ethnic programs: Fictional or nonfictional programs dealing with specific ethnic experiences and/or intended for a specific ethnic or cultural audience. Examples: Ukrainian Catholic hour, Breakfast in bed (Scottish audience), Portugual de hoja)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Dec. 7, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ec032331a1d480893d281d4817873e6b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ec032331a1d480893d281d4817873e6b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ethnic broadcasts (Radio programs)"}}, {"@id": "_:n