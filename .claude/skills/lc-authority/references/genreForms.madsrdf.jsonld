{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027026", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aQuadrilles (Music)", "identifiers:lccn": "gf2014027026", "madsrdf:adminMetadata": [{"@id": "_:nd0c842d931044176b063e6fdf1ac51efb1"}, {"@id": "_:nd0c842d931044176b063e6fdf1ac51efb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Quadrilles (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd0c842d931044176b063e6fdf1ac51efb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:nd0c842d931044176b063e6fdf1ac51efb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd0c842d931044176b063e6fdf1ac51efb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd0c842d931044176b063e6fdf1ac51efb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd0c842d931044176b063e6fdf1ac51efb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quadrilles (Music)"}}, {"@id": "_:nd0c842d931044176b063e6fdf1ac51efb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "((1) A dance for four or more couples, popular in the 19th century and consisting of five sections in either 2/4 or 6/8)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027026"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027027", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aQuicksteps (Marches)", "identifiers:lccn": "gf2014027027", "madsrdf:adminMetadata": [{"@id": "_:n8737cc53ab9040388f6b13bd3e48883db1"}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Quicksteps (Marches)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8737cc53ab9040388f6b13bd3e48883db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026922"}], "madsrdf:hasSource": [{"@id": "_:n8737cc53ab9040388f6b13bd3e48883db5"}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db6"}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db7"}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db8"}], "madsrdf:hasVariant": {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quicksteps (Marches)"}}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "March (American march music of the 19th century was influenced most strongly by the quickstep, a march genre which had developed from the musical accompaniment to the military cadenced step of the late 18th century. Music for the cadenced step (faster than the ceremonial march that preceded it) had a marked beat in either simple or compound duple meter and varied rhythmic patterns often borrowed from popular dances.)"}, "madsrdf:citationSource": "New Grove dict. of Am. mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Quicksteps (a fast version of the foxtrot)"}, "madsrdf:citationSource": "New Grove dict. of mus. online:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Quicksteps (a type of march)"}, "madsrdf:citationSource": "New Grove dict. of Am. mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Quicksteps (1. since the 18th century, a fast military march; 2. a fast version of the foxtrot, introduced in London in 1923)"}, "madsrdf:citationSource": "New Harvard dict. of mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8737cc53ab9040388f6b13bd3e48883db10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quick-steps (Marches)"}}, {"@id": "_:n8737cc53ab9040388f6b13bd3e48883db10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quick-steps (Marches)"}}], "@id": "/authorities/genreForms/gf2014027027"}
