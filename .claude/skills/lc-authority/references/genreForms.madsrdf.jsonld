guage": "en", "@value": "Compiled legislation"}}, {"@id": "_:ne4e253eb760b4eb5bdcbb112e518baa0b57", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Compiled legislation"}}, {"@id": "_:ne4e253eb760b4eb5bdcbb112e518baa0b59", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne4e253eb760b4eb5bdcbb112e518baa0b60"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tribal ordinances"}}, {"@id": "_:ne4e253eb760b4eb5bdcbb112e518baa0b60", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tribal ordinances"}}, {"@id": "_:ne4e253eb760b4eb5bdcbb112e518baa0b62", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne4e253eb760b4eb5bdcbb112e518baa0b63"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Laws"}}, {"@id": "_:ne4e253eb760b4eb5bdcbb112e518baa0b63", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Laws"}}, {"@id": "_:ne4e253eb760b4eb5bdcbb112e518baa0b65", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne4e253eb760b4eb5bdcbb112e518baa0b66"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Legislative amendments"}}, {"@id": "_:ne4e253eb760b4eb5bdcbb112e518baa0b66", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legislative amendments"}}], "@id": "/authorities/genreForms/gf2011026611"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026612", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSteampunk films", "identifiers:lccn": "gf2011026612", "madsrdf:adminMetadata": [{"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b1"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Steampunk films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026242"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026556"}], "madsrdf:hasSource": [{"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b5"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b6"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b7"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b8"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b9"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b10"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025088"}}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-10-26T22:56:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Steampunk films"}}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "La cit\u00e9 des enfants perdus [VR] = The city of lost children, c1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Steampunk (the 1999 film remake of the television series The Wild Wild West was one of the first contemporary steampunk motion pictures; Karel Zeman's film The Fabulous World of Jules Verne from 1958 is a very early example of cinematic steampunk; other early examples of historical steampunk in cinema include Hayao Miyazaki's anime films such as Laputa: Castle in the Sky (1986)) List of steampunk works (steampunk cinema; In films: 1958, The Fabulous World of Jules Verne; 1979, Time After Time; 1984, Nausica\u00e4 of the Valley of the Wind; 1994, The City of Lost Children; 1999, Wild Wild West; 2001, Atlantis: The Lost Empire; 2003, The League of Extraordinary Gentlemen; 2004, Howl's Moving Castle, Steamboy, Van Helsing; 2005, The Mysterious Geographic Explorations of Jasper Morello)"}, "madsrdf:citationSource": "Wikipedia, Dec. 8, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 82 (\"Steampunk was an established subgenre by 1990 ... Ever since then, steampunk has been bubbling under: in role-playing games and anime, video games like Myst and Thief and comic books like Alan Moore's League of Extraordinary Gentlemen. Look at the dirigibles and clockwork mechanisms in Philp Pullman's alt-Victorian The Golden Compass. Recall the steam-driven, Kenneth Branagh-piloted arachnid colossus in Will Smith's Wild Wild West.\")"}, "madsrdf:citationSource": "Time, Dec. 14, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Vyn\u00e1lez zk\u00e1zy. English. The fabulous world of Jules Verne [VR], 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Once tucked into a science fiction corner; steampunk-friendly film and TV series; steampunk films)"}, "madsrdf:citationSource": "Ohanesian, L. Steampunk starter guide : top 5 film and TV series, via LA weekly website, viewed Dec. 8, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"While steampunk may still be a new emerging subculture, its blend of neo-Victorian science-fiction has been in the movies for years. ... Movies that employ wildly imagined inventions and anachronistic technology set in bygone eras can all fall under this name. 'The Prestige'--a period piece of illusion, invention and teleportation--and 'Wild Wild West'--which transcends a typical 1800s Western with its depiction of steam-powered tanks, a cyborg and mechanical spiders--are two of the most popular steampunk movies to date. Also high on the list is 'League of Extraordinary Gentlemen,' which is dense with allusions to the works and characters of H.G. Wells and Jules Verne, both steampunk literary heroes.\")"}, "madsrdf:citationSource": "Donahue, E. You've been a steampunk movie fan forever, whether you knew it or not, via MTV movies blog website, viewed Dec. 8, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nb5dfd458195b4ca29e6a670cc7f24044b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993.", "madsrdf:citationStatus": "notfound"}], "@id": "/authorities/genreForms/gf2011026612"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026613", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStick charts", "identifiers:lccn": "gf2011026613", "madsrdf:adminMetadata": [{"@id": "_:n3338078be009492a98237514c14d1e72b1"}, {"@id": "_:n3338078be009492a98237514c14d1e72b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Stick charts"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3338078be009492a98237514c14d1e72b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:n3338078be009492a98237514c14d1e72b5"}, {"@id": "_:n3338078be009492a98237514c14d1e72b6"}, {"@id": "_:n3338078be009492a98237514c14d1e72b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Charts made by Pacific Islanders that indicate the pattern of swells and wave masses caused by wind.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025045"}}, {"@id": "_:n3338078be009492a98237514c14d1e72b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T15:08:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3338078be009492a98237514c14d1e72b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n3338078be009492a98237514c14d1e72b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stick charts"}}, {"@id": "_:n3338078be009492a98237514c14d1e72b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Models (Cartograhphic)--Stick charts (Charts made by Pacific Islanders generally made of narrow strips of the center ribs of palm fronds lashed together with cord made from locally grown fiber plants. The arrangements of the sticks indicates the pattern of swells and wave masses caused by winds, rather than of currents. The positions of islands are marked approximately by shells or coral)"}, "madsrdf:citationSource": "Form/genre for cartographic materials [draft of LC working group], 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3338078be009492a98237514c14d1e72b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Glossary of the mapping sciences, 1994;Glossary of mapping, charting,and geodetic terms, 1973", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n3338078be009492a98237514c14d1e72b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"stick charts\" constructed with thin strips of pandanus wood and cowry shells show ocean patterns and islands or atolls)"}, "madsrdf:citationSource": "Marshall Islands Visitors Authority WWW site, April 28, 2010:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026613"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026614", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStock footage", "identifiers:lccn": "gf2011026614", "madsrdf:adminMetadata": [{"@id": "_:n723bdde0b3bf45649fe4935c321110ecb1"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Stock footage"}, "madsrdf:elementList": {"@list": [{"@id": "_:n723bdde0b3bf45649fe4935c321110ecb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026723"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026712"}, "madsrdf:hasSource": [{"@id": "_:n723bdde0b3bf45649fe4935c321110ecb5"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb6"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb7"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb8"}], "madsrdf:hasVariant": [{"@id": "_:n723bdde0b3bf45649fe4935c321110ecb9"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb12"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb15"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb18"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb21"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb24"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Pre-recorded footage used or collected and organized to be used in the production of films, television programs, and video recordings.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025363"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T15:08:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stock footage"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "intro. (By stock material is meant all those filmed materials divorced from their original use and gathered together in a film production library and broken down for possible inclusion in later complete productions) foreword (motion picture stock materials) p. 65 (stock footage) p. 66 (library film)"}, "madsrdf:citationSource": "World directory of stockshot and film production libraries, 1969:", "madsrdf:citationStatus": "found"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(unedited footage: NT Outtakes, Rushes, Stock shots)"}, "madsrdf:citationSource": "Yee, M. Moving image materials : genre terms, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. A-3 (According to current industry practice, \"stock footage\" refers to any piece of film or video photographed by an outside source that is licensed to a producer or director for use in a separate, secondary production. This includes contemporary life-style material, news events, and historical images.)"}, "madsrdf:citationSource": "Footage, c1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 155 (found footage: Any film scene that is used in [a] motion picture but has been shot for some other film or for some other purpose.) p. 213 (library shot: A shot or scene already available on film (e.g. stock footage of a parade of soldiers)) p. 392 (stock shot, stock footage: Standard shots of actions events, or settings previously photographed for newsreels, documentaries, or even for feature films and presently stored in a stock footage library or laboratory from which they can be purcheased or rented, frequently by the foot, for insertion in a present film for example, footage of a militery parade or hurricane. Such shots are employed to save on production costs. See found footage and library shot.)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dict., 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n723bdde0b3bf45649fe4935c321110ecb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stock shots (Motion pictures, television, etc.)"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stock shots (Motion pictures, television, etc.)"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n723bdde0b3bf45649fe4935c321110ecb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Library film"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Library film"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n723bdde0b3bf45649fe4935c321110ecb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stock materials (Motion pictures, television, etc.)"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stock materials (Motion pictures, television, etc.)"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n723bdde0b3bf45649fe4935c321110ecb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Found footage (Motion pictures, television, etc.)"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Found footage (Motion pictures, television, etc.)"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n723bdde0b3bf45649fe4935c321110ecb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Library shots (Motion pictures, television, etc.)"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Library shots (Motion pictures, television, etc.)"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n723bdde0b3bf45649fe4935c321110ecb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motion picture stock materials"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion picture stock materials"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n723bdde0b3bf45649fe4935c321110ecb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stockshot (Motion pictures, television, etc.)"}}, {"@id": "_:n723bdde0b3bf45649fe4935c321110ecb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stockshot (Motion pictures, television, etc.)"}}], "@id": "/authorities/genreForms/gf2011026614"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026615", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStop-motion animation films", "identifiers:lccn": "gf2011026615", "madsrdf:adminMetadata": [{"@id": "_:n0b2f606048b94879954d3c4d98a68f37b1"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Stop-motion animation films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0b2f606048b94879954d3c4d98a68f37b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026049"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026140"}, "madsrdf:hasSource": [{"@id": "_:n0b2f606048b94879954d3c4d98a68f37b5"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b6"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b7"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b8"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b9"}], "madsrdf:hasVariant": [{"@id": "_:n0b2f606048b94879954d3c4d98a68f37b10"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b13"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b16"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025006"}}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:14:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stop-motion animation films"}}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "The Nightmare Before Christmas (Tim Burton's The Nightmare Before Christmas is a 1993 stop motion fantasy film) stop motion (Stop-motion (also known as stop-action or frame-by-frame) is an animation technique to make a physically manipulated object appear to move on its own; the object is moved in small increments between individually photographed frames, creating the illusion of movement when the series of frames is played as a continuous sequence; stop-motion films) List of stop motion films (stop motion films; stop motion animated feature films; stop motion/live action features; short films with stop motion animation; stop motion shorts)"}, "madsrdf:citationSource": "Wikipedia, Feb. 8, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(stop-motion animation: Process of creating movement in drawings, wire or mechanically jointed figures or other objects by filming the subject one or more frames at a time, making a small change in the subject's position, then recording another one or more frames and so on. Also called stop-action animation)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dictionary, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(stop motion, stop-motion cinematography, stop-action, stop-action cinematography, single-frame cinematography)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dictionary, c1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Tim Burton's The nightmare before Christmas [VR] 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 15 (Object Animation Films; almost any object can be animated using the stop-motion technique; all sorts of objects have been used in animation: matchsticks, tin soldiers, pieces of furniture, skeletons. When using clay, the terms claymation and sculptmation are sometimes used for clay animation)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0b2f606048b94879954d3c4d98a68f37b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Object animation films"}}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Object animation films"}}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0b2f606048b94879954d3c4d98a68f37b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stop-motion animated films"}}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stop-motion animated films"}}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0b2f606048b94879954d3c4d98a68f37b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stop-action animation films"}}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stop-action animation films"}}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0b2f606048b94879954d3c4d98a68f37b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Frame-by-frame animation films"}}, {"@id": "_:n0b2f606048b94879954d3c4d98a68f37b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Frame-by-frame animation films"}}], "@id": "/authorities/genreForms/gf2011026615"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026616", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStreet films", "identifiers:lccn": "gf2011026616", "madsrdf:adminMetadata": [{"@id": "_:na1c730e211564861bf9669f10fcebc5db1"}, {"@id": "_:na1c730e211564861bf9669f10fcebc5db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Street films"}, "madsrdf:elementList": {"@list": [{"@id": "_:na1c730e211564861bf9669f10fcebc5db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:na1c730e211564861bf9669f10fcebc5db5"}, {"@id": "_:na1c730e211564861bf9669f10fcebc5db6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that represent the downtown street as a dangerous lure.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025270"}}, {"@id": "_:na1c730e211564861bf9669f10fcebc5db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na1c730e211564861bf9669f10fcebc5db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T15:08:07"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na1c730e211564861bf9669f10fcebc5db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Street films"}}, {"@id": "_:na1c730e211564861bf9669f10fcebc5db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Street films, a popular genre in German cinema of the 1920s; typically psychological melodramas in which the downtown street represented danger)"}, "madsrdf:citationSource": "Katz, E. The film encyclopedia, c1994", "madsrdf:citationStatus": "found"}, {"@id": "_:na1c730e211564861bf9669f10fcebc5db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Street film, a type of psychological melodrama current in the German cinema of the 1920s and early 1930s; main motif was the street to which the film's characters were fatalistically drawn)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026616"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026617", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStrip maps", "identifiers:lccn": "gf2011026617", "madsrdf:adminMetadata": [{"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b1"}, {"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Strip maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b5"}, {"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b6"}, {"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025019"}}, {"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T14:21:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Strip maps"}}, {"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Glossary of the mapping sciences, 1994", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Strip map: a long narrow map, showing the course of a line of road, and the places adjacent)"}, "madsrdf:citationSource": "OED online, Mar. 31, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nf7379da8f1ac43deb105b8b576949bc3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Strip map: a map (as for an aviator) showing only a narrow band of territory (as 500 miles long and ten miles wide))"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026617"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026618", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStructural films", "identifiers:lccn": "gf2011026618", "madsrdf:adminMetadata": [{"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb1"}, {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Structural films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026235"}, "madsrdf:hasSource": [{"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb5"}, {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb6"}, {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb7"}], "madsrdf:hasVariant": {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that use photographic techniques to investigate the nature of film as an aesthetic experience.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025609"}}, {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T15:08:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Structural films"}}, {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Structural: work that concentrates on form rather than content. The work may base its structure on an exaggerated aspect of motion picture technique (for example, a 40 minute slow zoom or an eight hour stationary shot of the Empire State Building), or on viewers' relationships with the cinematic apparatus)"}, "madsrdf:citationSource": "Moving image genre-form guide online, June 4, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 321 (Structural film: independent or avant-garde films...which investigate the nature of film itself...minimizing action and camera movement or by working on the film itself...may make use of repeated loops, extended zooms, flickering effects and other photographic techniques...to make film an aesthetic experience outside any symbolic association derived from more traditional forms of filmmaking)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 95 (Structuralist works: experimental films characterized by sustained or repeated views of filmed material. Editing is kept to a minimum, and frequently a single camera movement is used in a sustained fashion to explore the photographed materials)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Structuralist films"}}, {"@id": "_:n8abc9188d5b64c9197311b681a5eea3cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Structuralist films"}}], "@id": "/authorities/genreForms/gf2011026618"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026619", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSubculture films", "identifiers:lccn": "gf2011026619", "madsrdf:adminMetadata": [{"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb1"}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Subculture films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027199"}, "madsrdf:hasSource": [{"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb5"}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb6"}], "madsrdf:hasVariant": [{"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb7"}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb10"}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb13"}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025207"}}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:15:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Subculture films"}}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Cult Film: According to the audiences which patronize them, cult films may be divided into popular cult, clique or coterie and subculture cult films)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"The most commercially minded of the independent films of this time were the renegade subculture films, mostly made for AIP and other low-budget companies.\")"}, "madsrdf:citationSource": "American independent narrative cinema of the '60s, via WWW, May 25, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Subculture movies"}}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Subculture movies"}}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cult films, Subculture"}}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cult films, Subculture"}}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Subcultural films"}}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Subcultural films"}}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Subculture cult films"}}, {"@id": "_:ncdee5a30de204478bb6cbf3cfa1ff0fdb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Subculture cult films"}}], "@id": "/authorities/genreForms/gf2011026619"}
