{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026157", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPuns", "identifiers:lccn": "gf2014026157", "madsrdf:adminMetadata": [{"@id": "_:n1fca60d689d24932af11ed0788983c17b1"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Puns"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1fca60d689d24932af11ed0788983c17b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026119"}, "madsrdf:hasSource": [{"@id": "_:n1fca60d689d24932af11ed0788983c17b5"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b6"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b7"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b8"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b9"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b10"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b11"}], "madsrdf:hasVariant": [{"@id": "_:n1fca60d689d24932af11ed0788983c17b12"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b15"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b18"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b21"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b24"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puns"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(calembour: a pun; pun: 1. the humorous use of a word or phrase so as to emphasize or suggest its different meanings or applications, or the use of words that are alike or nearly alike in sound but different in meaning; a play on words. 2. the word or phrase used in this way; paronomasia 1. the use of a word in different senses or the use of words similar in sound to achieve a specific effect, as humor or a dual meaning; punning. 2. a pun)"}, "madsrdf:citationSource": "Dictionary.com, July 31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pun: A joke exploiting the different possible meanings of a word or the fact that there are words that sound alike but have different meanings)"}, "madsrdf:citationSource": "Oxford dictionaries website, July 31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The pun, also called paronomasia, is a form of word play that suggests two or more meanings, by exploiting multiple meanings of words, or of similar-sounding words, for an intended humorous or rhetorical effect)"}, "madsrdf:citationSource": "Wikipedia, July 31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pun: A figure of speech which involves a play upon words. The Greek term is paronomasia; other names are calembour, clinch, quibble and carwitchet. One of the earliest types of wordplay, the pun is widespread in many literatures and gives rise to a fairly universal form of humour. Puns are very often intended humorously but not always; paronomasia: A punning play on words which uses similar or identical phonemes for its effect (an 'assonant pun'); clench/clinch: A quibbling form of pun. Also a statement that settles an argument; one that clinches it.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pun: the usually humorous use of a word in such a way as to suggest two or more of its meanings or the meaning of another word similar in sound)"}, "madsrdf:citationSource": "Merriam-Webster online, July 31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 67 (pun: play on words)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pun. A play on words, usually for comic effect, but sometimes for a serious purpose. In modern times the pun has come to be seen as an important device for exhibiting irony, ambiguity, and the inherent instability of language. As a result the pun is a feature not only of modern literature, notably in the work of James Joyce, but also of contemporary theory and criticism.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1fca60d689d24932af11ed0788983c17b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Clinches (Puns)"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Clinches (Puns)"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1fca60d689d24932af11ed0788983c17b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quibbles (Puns)"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quibbles (Puns)"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1fca60d689d24932af11ed0788983c17b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Clenches (Puns)"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Clenches (Puns)"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1fca60d689d24932af11ed0788983c17b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Carwitchets"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Carwitchets"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1fca60d689d24932af11ed0788983c17b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Paronomasias"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paronomasias"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1fca60d689d24932af11ed0788983c17b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Calembours"}}, {"@id": "_:n1fca60d689d24932af11ed0788983c17b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Calembours"}}], "@id": "/authorities/genreForms/gf2014026157"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPuzzles and games", "identifiers:lccn": "gf2014026158", "madsrdf:adminMetadata": [{"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b1"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Puzzles and games"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026164"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026060"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026077"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026116"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026118"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026124"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026125"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026137"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026147"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026169"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026184"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026954"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026048"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026051"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026098"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026140"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026012"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026060"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026104"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026014"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026068"}, "madsrdf:hasSource": [{"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b5"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b6"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b7"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b8"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b9"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b10"}], "madsrdf:hasVariant": [{"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b11"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b14"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b17"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b20"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b23"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b26"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b29"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b32"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b35"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-11-14T09:15:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puzzles and games"}}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(game: A single physical item or set of materials designed for recreational or instructional play according to a prescribed or implicit set of rules, usually stored in a container to keep the pieces together. The category includes puzzles and simulations; puzzle: A mental exercise or physical object contrived to pose a problem likely to test the ingenuity and patience of anyone attempting to solve it, including items bearing an image that can disassembled into pieces and reassembled. Most puzzles are recreational devices.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 7, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(puzzles. Recreational artifacts designed as amusements or diversions by presenting constructional difficulties to be solved by ingenuity or patient effort; games. Forms of competitive play, usually involving an element of strategy, especially to interfere with an opponent's play; may or may not require physical skill.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 7, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Puzzles (Puzzles. BT Games) Games (Games. UF Business Games; Childrens Games; Management Games. BT Activities. NT Computer Games; Educational Games; Puzzles; Video Games)"}, "madsrdf:citationSource": "ERIC thesaurus, via WWW, Aug. 7, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Puzzles (Puzzles. Scope Note: Recreational devices that present difficulties to be solved. BT Ephemera; Game pieces. NT Jigsaw puzzles; Mazes; Picture puzzles. RT Rebuses) Games (Games. BT Play (Recreation). NT Billiards; Bingo; Blind man's bluff; Board games; Bobbing for apples; Card games; Carnival games; Croquet; Crossword puzzles; Darts; Dominoes; Fetch (Game); Gambling; Hopscotch; Loter\u00eda (Game); Marbles (Game); Pin-the-tail-on-the-donkey; Ring-around-a-rosy; Shell games; Shuffleboard; Singing games; Tug of war)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Aug. 7, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 67 (puzzle)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Puzzles (Puzzles. Scope Note: Use for toys, contrivances, questions or problems designed for testing ingenuity. BT Recreations. NT Acrostics; Anagrams; Charades; Ciphers; Mathematical recreations; Rebuses; Riddles; Scientific recreations) Games (Games. Scope Note: Use for materials designed for play, usually according to prescribed rules. BT Recreations)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Aug. 7, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scientific recreations"}}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scientific recreations"}}, {"@id": "_:ne95bd95a88b4401b97ef917a4602c3b4b14", "@typ