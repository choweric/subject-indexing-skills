{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026170", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSayings", "identifiers:lccn": "gf2014026170", "madsrdf:adminMetadata": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b1"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sayings"}, "madsrdf:elementList": {"@list": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026356"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026312"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026359"}], "madsrdf:hasSource": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b5"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b6"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b7"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b8"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b9"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b10"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b11"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b12"}], "madsrdf:hasVariant": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b13"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b16"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b19"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b22"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b25"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b28"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b31"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b34"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b37"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b40"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b43"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b46"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b49"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b52"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b55"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b58"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b61"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-11T08:48:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sayings"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Chreiai. UF Chreiai, Classical chreiai; Chriae; Classical chreiai. BT Classical literature; Classical wit and humor; Literature, Medieval; Wit and humor, Medieval)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(aphorism: A very concise sentence or statement (\"nugget\") that expresses, in a memorable and pointed way, a universally recognized truth or principle, for example, \"Well begun is half done.\" Aphorisms published in collections are usually shelved in the reference section of a library. Synonymous with maxim; proverb: A short memorable saying of unknown origin, but in common use, expressing in simple yet vivid language an obvious truth, familiar experience, or piece of sage advice, often metaphorical or alliterative (example: look before you leap). Proverbs are collected and published in dictionaries, usually shelved in the reference section of a library.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 7, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sayings. Refers to familiar expressions or sentiments. It is typically used in a more general sense than \"epigrams\" or \"aphorisms.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Maxims. BT Instructional works (Gathering term; do not assign); Proverbs. BT Instructional works (Gathering term; do not assign))"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Aug. 7, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 74 (saying: adage, proverb, maxim, quotation)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Chreia (The chreia or chria was, in antiquity and the Byzantine Empire, both a genre of literature and one of the progymnasmata. A chreia was a brief, useful anecdote about a particular character. That is, a chreia was shorter than a narration--often as short as a single sentence--but unlike a maxim, it was attributed to a character. Chreiai could be silly, or solemn, wise, or witty, or all of these. As a literary genre the chreia was a subject of collection. Scholars such as Plutarch or Seneca kept their own private collections of chreiai. Published collections were also available.)"}, "madsrdf:citationSource": "Wikipedia, Aug. 7, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 1-2 (During the time when Christians were writing, re-writing, and copying the documents we find in the NT and early Christian literature, rhetoricians and teachers used the term chreia to refer to a saying or act attributed to a specific person; plural chreiai)"}, "madsrdf:citationSource": "Greco-Roman literature and the New Testament, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "adage (an old and well-known saying that expresses a general truth. Synonyms: saying, aphorism, apothegm, byword, epigram, maxim, proverb, saw, sententia, word) ana (plural ana or anas. 1: a collection of the memorable sayings of a person. 2: a collection of anecdotes or interesting information about a person or a place) aphorism (1: a concise statement of a principle. 2: a terse formulation of a truth or sentiment : adage) apothegm (a short, pithy, and instructive saying or formulation : aphorism) apophthegm (chiefly British variant of apothegm) axiom (1: a maxim widely accepted on its intrinsic merit. 2: a statement accepted as true as the basis for argument or inference : postulate 1. 3: an established rule or principle or a self-evident truth) byword (1: a proverbial saying : roverb) maxim (1: a general truth, fundamental principle, or rule of conduct. 2: a proverbial saying) gnome (maxim, aphorism) proverb (1: a brief popular epigram or maxim : adage. 2: byword 4) saw (maxim, proverb) sententia (plural sententiae: aphorism --usually used in plural)"}, "madsrdf:citationSource": "Merriam-Webster online, Aug. 7, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anas"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anas"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Classical chreiai"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Classical chreiai"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Apophthegms"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Apophthegms"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Proverbs"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Proverbs"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ana"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ana"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bywords (Sayings)"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bywords (Sayings)"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gnomes (Sayings)"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gnomes (Sayings)"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Axioms"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Axioms"}}, {"@id": "_:n606b24d0232348258f3f7df03bdb8847b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n606b24d0232348258f3f7df03bdb8847b38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Saws (Sayings)"}}, {"@i