tus": "revised"}, {"@id": "_:n8ac7f5d4ffb4468daf2d336b7ee2c224b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8ac7f5d4ffb4468daf2d336b7ee2c224b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hindustani music"}}, {"@id": "_:n8ac7f5d4ffb4468daf2d336b7ee2c224b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "South Asia (... Hindustani and Carnatic systems. The former is prevalent in northern, Indo-Aryan-speaking areas of the subcontinent, including Pakistan, Bangladesh, and less significantly, Afghanistan and Nepal and among the Sinhalese inhabitants of Sri Lanka.)"}, "madsrdf:citationSource": "New Harvard dict. of mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ac7f5d4ffb4468daf2d336b7ee2c224b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 9, p. 73 (In South Asia there are two recognized dialects of classical music. Hindustani (or north Indian) ... for the region where Indo-Aryan languages are spoken (including Pakistan and Bangladesh), that is, the Indo-Gangeti plain with the north-western quadrant of the peninsula)"}, "madsrdf:citationSource": "New Grove dict. of mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ac7f5d4ffb4468daf2d336b7ee2c224b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The classical music of north India.)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Jan. 20, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ac7f5d4ffb4468daf2d336b7ee2c224b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8ac7f5d4ffb4468daf2d336b7ee2c224b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "North Indian classical music"}}, {"@id": "_:n8ac7f5d4ffb4468daf2d336b7ee2c224b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "North Indian classical music"}}, {"@id": "_:n8ac7f5d4ffb4468daf2d336b7ee2c224b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8ac7f5d4ffb4468daf2d336b7ee2c224b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hindustani classical music"}}, {"@id": "_:n8ac7f5d4ffb4468daf2d336b7ee2c224b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hindustani classical music"}}], "@id": "/authorities/genreForms/gf2014026859"}
