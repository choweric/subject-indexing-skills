{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026680", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision series", "identifiers:lccn": "gf2011026680", "madsrdf:adminMetadata": [{"@id": "_:n7d765b93a72f4324884092fd794eccafb1"}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television series"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7d765b93a72f4324884092fd794eccafb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026665"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026669"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026681"}], "madsrdf:hasSource": [{"@id": "_:n7d765b93a72f4324884092fd794eccafb5"}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb6"}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb7"}], "madsrdf:hasVariant": [{"@id": "_:n7d765b93a72f4324884092fd794eccafb8"}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb11"}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025541"}}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:23:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television series"}}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Glossary, p. 31 (Television series: a group of programs created or adapted for television broadcast with a common series title, usually related to one another in subject or another way. Often, television series appear once a week during a prescribed time slot; however, they may appear with more or less frequency. Television series are usually created to be open-ended, not with a predetermined number of episodes. In a fiction series, the programs typically share the same characters and basic themes)"}, "madsrdf:citationSource": "Archival moving image materials : a cataloging manual, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 87 (Series: used for a program or film in a number of episodes or parts which has a story line which continues from one episode or part to the next. RT: Anthologies; Made for TV movies; Mini-series; Serials; Specials)"}, "madsrdf:citationSource": "Yee, M. M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Television series: a multi-episode program originally conceived with an indefinite duration, shown on a regular schedule (daily, weekly, monthly) or irregular basis (such as TALKING WITH DAVID FROST or NATIONAL GEOGRAPHIC SOCIETY SPECIALS). Episodes of a television series are usually related by subject matter, hosts, or, in the case of fictional programs, continuing characters in a predictable milieu)"}, "madsrdf:citationSource": "Moving image genre-form guide online, February 25, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7d765b93a72f4324884092fd794eccafb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television serials"}}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television serials"}}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7d765b93a72f4324884092fd794eccafb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Series, Television"}}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Series, Television"}}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7d765b93a72f4324884092fd794eccafb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Serials, Television"}}, {"@id": "_:n7d765b93a72f4324884092fd794eccafb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serials, Television"}}], "@id": "/authorities/genreForms/gf2011026680"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026681", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision soap operas", "identifiers:lccn": "gf2011026681", "madsrdf:adminMetadata": [{"@id": "_:n06ce6ed320a140a09b40b9e620035029b1"}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television soap operas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n06ce6ed320a140a09b40b9e620035029b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026680"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026664"}, "madsrdf:hasSource": [{"@id": "_:n06ce6ed320a140a09b40b9e620035029b5"}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b6"}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b7"}], "madsrdf:hasVariant": [{"@id": "_:n06ce6ed320a140a09b40b9e620035029b8"}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025612"}}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:23:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television soap operas"}}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Soap opera: Fictional television series which focus on the events in the lives of a cast of recurring characters, presented in a serial fashion. Plots often center on romances between the characters, but can include adventure, intrigue, or the supernatural. The endings of each program are normally unresolved or only partially resolved, encouraging the viewer to anticipate what may happen in the next episode)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 3, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 89 (Soap operas: Use for fictional serials broadcast on television and usually dealing with domestic themes of a highly emotional nature)"}, "madsrdf:citationSource": "Yee, M. M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "2009042546: Telenovelas, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ce6ed320a140a09b40b9e620035029b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Telenovelas"}}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telenovelas"}}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n06ce6ed320a140a09b40b9e620035029b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Soap operas, Television"}}, {"@id": "_:n06ce6ed320a140a09b40b9e620035029b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soap operas, Television"}}], "@id": "/authorities/genreForms/gf2011026681"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026682", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision soundtracks", "identifiers:lccn": "gf2011026682", "madsrdf:adminMetadata": [{"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb1"}, {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television soundtracks"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, "madsrdf:hasSource": [{"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb5"}, {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb6"}, {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb7"}], "madsrdf:hasVariant": {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical and spoken-word sound recordings that contain the actual sound used in television productions, either as complete soundtracks or as portions of soundtracks.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025650"}}, {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:01:07"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television soundtracks"}}, {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg: Television soundtracks)"}, "madsrdf:citationSource": "LCSH, Dec. 14, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(television soundtracks; TV soundtrack archive; television sound without pictures)"}, "madsrdf:citationSource": "Archival Television Audio, Inc. web site, Dec. 14, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Television: The soundtrack from a television program (not necessarily broadcast))"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Dec. 14, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Soundtracks, Television"}}, {"@id": "_:n4bd3ea66d3b14cf7a9487e166a403cbeb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soundtracks, Television"}}], "@id": "/authorities/genreForms/gf2011026682"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026683", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision specials", "identifiers:lccn": "gf2011026683", "madsrdf:adminMetadata": [{"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b1"}, {"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television specials"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasSource": [{"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b5"}, {"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b6"}], "madsrdf:hasVariant": {"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025645"}}, {"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:23:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television specials"}}, {"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Television special: A single television program shown on a specific occasion, such as a Variety show; a pageant, contest, or award presentation; shown in conjunction with specific holidays; or shown on an annual or less than annual basis (such as a political convention); or to report on news, such as a royal wedding, an assassination, or a military event. Usually an entertainment special has a length of less than 90 minutes (and most typically 30 or 60 minutes), although news coverage can be of any length)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 10, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 91 (Specials: use for a program which is not part of a series, serial or mini-series (i.e., does not consist of a number of parts or episodes broadcast over time), and is not a fictional feature film shot for television)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Special television programs"}}, {"@id": "_:nf75f40d05c67490bb9d2d8b2bda763b7b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Special television programs"}}], "@id": "/authorities/genreForms/gf2011026683"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026684", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision talk shows", "identifiers:lccn": "gf2011026684", "madsrdf:adminMetadata": [{"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab1"}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television talk shows"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026425"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}], "madsrdf:hasSource": [{"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab5"}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab6"}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab7"}], "madsrdf:hasVariant": [{"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab8"}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab11"}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab14"}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab17"}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025590"}}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:35:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television talk shows"}}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Talk shows: use for programs which consist primarily of informal conversations between a host or hostess, and various celebrities. May include a few variety acts. For talk programs which allow the audience to phone in and give opinions on an issue, use Audience participation programs)"}, "madsrdf:citationSource": "Yee, M. M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(television talk shows; TV talk shows; television talk programs; talk television shows; talk television programs)"}, "madsrdf:citationSource": "Google search, November 19, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1293ad7d2b94bd98c90fff2c53e1edab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Talk: television work which features discussions that are aimed primarily at entertaining an audience, and which although they may sometimes relate to current events, do not qualify as Public affairs. The guests may be celebrities or other well-known individuals, or the work may be thematically focused, introducing otherwise ordinary people who have shared certain experiences. The work may contain questions from the host that are answered by the guests, but the structure is generally more informal than that of a straightforward interview)"}, "madsrdf:citationSource": "Moving image genre-form guide online, November 19, 2007:", "madsrdf