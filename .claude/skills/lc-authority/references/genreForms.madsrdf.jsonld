ype": "xsd:dateTime", "@value": "2018-01-30T09:50:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd487973581d145c9899e770dde7e9a58b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Account books"}}, {"@id": "_:nd487973581d145c9899e770dde7e9a58b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(account books: 1,110,000 hits; accounting ledgers: 120,000 hits; account ledgers: 42,200 hits; account journals: 5,980 hits; accounting journals: 152,000 hits; books of account: 571,000 hits)"}, "madsrdf:citationSource": "Google, Jan. 8, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd487973581d145c9899e770dde7e9a58b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(account book: A blankbook, ruled or unruled, in which the details of transactions, usually financial, are recorded, often in the form of a ledger with columns tallied at the end of each day, week, month, or year to show the profitability of the enterprise)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Nov. 1, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd487973581d145c9899e770dde7e9a58b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Account books. SN Use for books in which details of financial transactions are recorded. UF Journals (Financial records); Ledgers. BT Record-keeping works. NT Daybooks)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Nov. 1, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd487973581d145c9899e770dde7e9a58b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an account book)"}, "madsrdf:citationSource": "Work cat.: Entrata e uscita di contanti della Fattoria di Capalle, 1786", "madsrdf:citationStatus": "found"}, {"@id": "_:nd487973581d145c9899e770dde7e9a58b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Account books. UF Accounting--Books of account; Accounting ledgers; Books of account; Journals (Accounting); Ledgers (Accounting). RT Accounting--Forms; Blank-books; Business records)"}, "madsrdf:citationSource": "LCSH, Nov. 1, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd487973581d145c9899e770dde7e9a58b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ledger (Collection of an entire group of similar accounts in double-entry bookkeeping. Also called book of final entry, a ledger records classified and summarized financial information from journals (the 'books of first entry') as debits and credits, and shows their current balances) journal (Business diary in which all financial data (taken usually from a journal voucher) pertaining to the day to day business transactions of a firm is recorded using double-entry bookkeeping system) books of account (Journals, ledgers, and other classified records comprising a firm's set of accounts)"}, "madsrdf:citationSource": "Business dictionary online, Jan. 8, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd487973581d145c9899e770dde7e9a58b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd487973581d145c9899e770dde7e9a58b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Journals, Accounting"}}, {"@id": "_:nd487973581d145c9899e770dde7e9a58b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Journals, Accounting"}}, {"@id": "_:nd487973581d145c9899e770dde7e9a58b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd487973581d145c9899e770dde7e9a58b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books of account"}}, {"@id": "_:n