age": "en", "@value": "(Stationery; BT Ephemera; NT Billheads; Greeting cards; Letterheads; Postal stationery; RT Envelopes; Postcards; Stationery trade; SN: Materials on which letters and similar communications are typed or written.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, May 25, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n62a016ca169149d0b5e4f93eb5a32f6fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(stationery; BT correspondence artifacts; Note: Paper for writing letters, often having a letterhead or decorative design, and often accompanied by matching envelopes.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, May 25, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n62a016ca169149d0b5e4f93eb5a32f6fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Stationery; BT Paper products; NT Billheads; Business announcements; Envelopes (Stationery); Letterheads; Note pads; Postal stationery; Social stationery, Wedding stationery)"}, "madsrdf:citationSource": "LCSH, May 25, 2018", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026029"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026030", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPost-punk music", "identifiers:lccn": "gf2019026030", "madsrdf:adminMetadata": [{"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b1"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Post-punk music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027025"}, "madsrdf:hasSource": [{"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b5"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b6"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b7"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b8"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b9"}], "madsrdf:hasVariant": {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-20T08:02:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-02-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Post-punk music"}}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Post-Punk (Post-punk is a genre of music that got its start at the beginning of the 1980s when bands that were influenced by the 1960's and the 1970's forefathers of punk decided to carry on the torch. The term \"post\" was attached to the subgenre when, with the turn of the century, music was heading in the direction of alternative rock. This revivalist punk movement was spearheaded by bands such as Gang of Four, Talking Heads, The Fall, The Human League, Adam & the Ants, Aztec Camera, Cabaret Voltaire, Wire, Contortions, Joy Division, The Raincoats, Big Black, Killing Joke, Mission of Burma, and Orange Juice, all of which have in some way continued the punk tradition in the spirit of their music and shared the punk aesthetic of their idols. A post-punk revival occurred again in the 2000s when bands that honored punk bands started making music akin to that of acts such as the Ramones, The Clash, and the Sex Pistols. Post-punk artists, however, were more adept at (and forgiving of) creating radio-friendly tracks than their forefathers who may have considered such an act as crossing the line of \"selling out.\" Post-punk acts, on the other hand, released music they simply felt was more accessible to fans that respected the work of groundbreaking punk bands.)"}, "madsrdf:citationSource": "Smith, K.L. Encyclopedia of indie rock, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "About Normil Hawaiians (\"Normil Hawaiians had a transformative 1982. With two 7\" singles and a 12\" EP under their belts they suddenly found themselves disillusioned with the increasingly generic sounds surrounding them, so they forced the hand of change and began reaching out with that very hand. The band's true constant in Guy Smith soon found himself with a new crew of musicians, Simon Marchant, Noel Blanden and Mark Tyler. Normil Hawaiians' communal take on post punk quickly sprouted leaves from its mouth, and began carving out a new furrow\")"}, "madsrdf:citationSource": [{"@id": "http://www.upsettherhythm.co.uk/normil-hawaiians.shtml"}, "Upset! the Rhythm WWW site, February 13, 2019:"], "madsrdf:citationStatus": "found"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Heading (Post-punk music; work cat plus an additional 7 supporting 670s)"}, "madsrdf:citationSource": "LCCN sh2014100192:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (recorded in 1982-1983; members: Noel Blanden, Simon Marchant, Guy Smith, Mark Tyler) insert (\"1982: Guy Smith had grown disaffected with and apart from the contemporary music scene, with its ever-more manufactured output and generic-sounding bands. The music industry had finally closed the door on the punk era, bolted it and melted down the key. Guy wanted to find new ways of musical expression by abandoning the constraints of what was deemed current and acceptable, and so he reached out to other people he suspected felt the same way ...\")"}, "madsrdf:citationSource": "Work cat: Normil Hawaiians. More wealth than money, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Pop/Rock--Punk/New Wave--Post-Punk (\"After the punk revolution of 1977, a number of bands inspired by the d.i.y. spirit and raw sound of punk were formed. However, instead of replicating the sound of the Sex Pistols, many of these bands forged into more experimental territory, taking cues from a range of artists and styles, such as Roxy Music, David Bowie (especially Low, Heroes and Lodger), disco, dub and Krautrock. The result was Post-Punk, a more adventurous and arty form of punk, no less angry or political but often more musically complex and diverse. Many of these groups--like Joy Division or the Cure--created dark, synthesizer-oriented soundscapes while others--like Orange Juice or XTC--had a lighter guitar-based musical approach but their lyrics and music were off-kilter and often subverted traditional pop/rock song structures. Post-punk eventually developed into alternative pop/rock in the '80s\")"}, "madsrdf:citationSource": [{"@id": "https://www.allmusic.com/style/post-punk-ma0000004450"}, "AllMusic WWW site, July 8, 2019:"], "madsrdf:citationStatus": "found"}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Postpunk music"}}, {"@id": "_:n2b6ccb9f99924ea9ab35d726c4d406e7b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Postpunk music"}}], "@id": "/authorities/genreForms/gf2019026030"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026031", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFolk punk music", "identifiers:lccn": "gf2019026031", "madsrdf:adminMetadata": [{"@id": "_:nead395f06dba43018aa8325bb666460db1"}, {"@id": "_:nead395f06dba43018aa8325bb666460db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Folk punk music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nead395f06dba43018aa8325bb666460db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027025"}], "madsrdf:hasSource": [{"@id": "_:nead395f06dba43018aa8325bb666460db5"}, {"@id": "_:nead395f06dba43018aa8325bb666460db6"}, {"@id": "_:nead395f06dba43018aa8325bb666460db7"}, {"@id": "_:nead395f06dba43018aa8325bb666460db8"}, {"@id": "_:nead395f06dba43018aa8325bb666460db9"}, {"@id": "_:nead395f06dba43018aa8325bb666460db10"}, {"@id": "_:nead395f06dba43018aa8325bb666460db11"}, {"@id": "_:nead395f06dba43018aa8325bb666460db12"}, {"@id": "_:nead395f06dba43018aa8325bb666460db13"}], "madsrdf:hasVariant": [{"@id": "_:nead395f06dba43018aa8325bb666460db14"}, {"@id": "_:nead395f06dba43018aa8325bb666460db17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nead395f06dba43018aa8325bb666460db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-02-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nead395f06dba43018aa8325bb666460db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-14T08:16:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nead395f06dba43018aa8325bb666460db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folk punk music"}}, {"@id": "_:nead395f06dba43018aa8325bb666460db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk Punk describes Punk Rock with any kind of Folk influence. The most common influences are Celtic Folk Music (Celtic Punk), Romani Folk Music and Balkan Folk Music (Gypsy Punk); instrumentation of folk punk can either be as varied as its influences, ranging from traditional and acoustic instruments to a more typical punk rock set with electric guitars, bass, and drums; genre emerged in the early 1980s in the UK, most notably with the early releases of Billy Bragg and the Irish-British band The Pogues, who mixed traditional Irish songs with the aggressiveness of punk music; Another branch of folk punk developed in the 1980s in the US. Violent Femmes are commonly cited as a big influence on the development of this style. Unlike the Pogues in the UK, they did not base their sound on a fusion of traditional music with punk, instead creating a style that was closer to Contemporary Folk-influenced Folk Rock. This mix of acoustic instrumentation and punk rock was not much different from the Country-related genre of Cowpunk. The American style of folk punk continued to develop in the late 1990s and early 2000s)"}, "madsrdf:citationSource": "Folk punk, via rateyourmusic.com, Feb. 19, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nead395f06dba43018aa8325bb666460db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Violent Femmes (Post-punk, folk-punk band. Inspired by punk rock, the Violent Femmes incorporated elements of folk, jazz, bluegrass, country, and rockabilly music into their minimal and frequently acoustic sound)"}, "madsrdf:citationSource": "Grove music online, Feb. 19, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nead395f06dba43018aa8325bb666460db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(folk punk bands; folk punk groups; punk folk bands)"}, "madsrdf:citationSource": "The best folk punk bands, via Ranker website, Feb. 19, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nead395f06dba43018aa8325bb666460db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(folk punk music)"}, "madsrdf:citationSource": "Work cat.: Pogues (Musical group). Rum, sodomy & the lash, \u21171985", "madsrdf:citationStatus": "found"}, {"@id": "_:nead395f06dba43018aa8325bb666460db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk-punk music is a combination of folk music and punk rock music; The Violent Femmes gave folk punk its fame in America during the 1980s; Many folk punk artists perform their own arrangements. They often arrange in the style of punk rock, but use traditional folk instruments, such as mandolins, banjos, violins, and accordions. Other instruments typically used include drums, washboard, bass guitar, and electric guitar. Throughout time, synthesizers have become more common within the folk punk community)"}, "madsrdf:citationSource": "An introduction to folk-punk, via WWW, Feb. 19, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nead395f06dba43018aa8325bb666460db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk punk (known in its early days as rogue folk); fusion of folk music and punk rock; popularized in the early 1980s by The Pogues in Britain, and by Violent Femmes in the United States; musicians performing their own compositions in the style of punk rock, but using additional folk instruments, such as mandolins, accordions, banjos or violins; includes subgenres Celtic punk and Gypsy punk)"}, "madsrdf:citationSource": "Wikipedia, Feb. 19, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nead395f06dba43018aa8325bb666460db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(folk punk music)"}, "madsrdf:citationSource": "Violent Femmes (Musical group). The blind leading the naked, \u21171986", "madsrdf:citationStatus": "found"}, {"@id": "_:nead395f06dba43018aa8325bb666460db12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (folk punk music; folk punk performance, situated at the intersection of the folk and punk genres) p. 4 (folk punk combines elements offered by both folk and punk)"}, "madsrdf:citationSource": "Haas, B.D. Performing folk punk, 2013, via WWW, viewed Feb. 19, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nead395f06dba43018aa8325bb666460db13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Overview (Folk punk; genre (or set of genres) of music that combines elements of folk and punk rock music; in North American usage it describes fusion with American folk music; other blends of punk and folk/traditional genres may be described differently (e.g. Celtic punk), although the usage and delineation of such terms varies; usually focuses on political issues from the radical left and anarchist side of the spectrum, but often incorporates a personal perspective to these views; embraces a legacy of traditional folk music, typified by themes of working class solidarity and resistance in the face of the perceived problems of industrialization and modern capitalism. Some bands and artists play a style that is less folk-influenced, but use instruments not normally used in punk rock, like the violin, banjo, mandolin, or ukulele; The most famous British folk-punk band is the Pogues, who formed during the new wave of punk rock in the early 1980s and played a mix of traditional Irish folk songs, modern social commentary and songs of boozy hedonism)"}, "madsrdf:citationSource": "Folk punk music, via last.fm website, Feb. 19, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nead395f06dba43018aa8325bb666460db14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nead395f06dba43018aa8325bb666460db15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rogue folk music"}}, {"@id": "_:nead395f06dba43018aa8325bb666460db15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rogue folk music"}}, {"@id": "_:nead395f06dba43018aa8325bb666460db17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nead395f06dba43018aa8325bb666460db18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Punk folk music"}}, {"@id": "_:nead395f06dba43018aa8325bb666460db18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Punk folk music"}}], "@id": "/authorities/genreForms/gf2019026031"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026033", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aArabesques (Art music)", "identifiers:lccn": "gf2019026033", "madsrdf:adminMetadata": [{"@id": "_:n5857f86c28e24cafbae25af169b27c7fb1"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Arabesques (Art music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5857f86c28e24cafbae25af169b27c7fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n5857f86c28e24cafbae25af169b27c7fb5"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb6"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb7"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb8"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb9"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb10"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-14T08:16:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-02-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Arabesques (Art music)"}}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Delius, F. Songs of sunset ; An arabesque ; A mass of life, \u21171992.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Arabesque (Ger. Arabeske). A term, apparently introduced into Europe during the Moorish conquest of Spain, first applied to architecture and painting to describe an ornamental frieze or border, whose elaborations, foliate and curlicued, have their counterparts in music in ornamentation and complex figuration; the most typical examples of the form are Debussy's Deux arabesques (1888-91), whose charm and delicacy reflect perfectly the conception of the arabesque as a piece in which the composer aims at a decorative rather than emotional effect)"}, "madsrdf:citationSource": "Grove music online, Feb. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(arabesque 3. Music a. a light, whimsical composition with many delicately ornamental passages b. any ornamental passage typical of such a composition)"}, "madsrdf:citationSource": "Webster's new world college dictionary, \u00a92010, via Collins English dictionary website, Feb. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Arabesque (classical music) (The arabesque is a type of music which uses melodies to create the atmosphere of Arabic architecture; The most well-known are Claude Debussy's Deux Arabesques. Other composers who have written arabesques include: Marin Marais: L'arabesque; Robert Schumann: Arabeske in C; Adolf Schulz-Evler: Arabesques on \"An der sch\u00f6nen blauen Donau\"; Jean Sibelius: Arabesque; Bohuslav Martin\u016f: Seven Arabesques for cello and piano; Harold Budd: Arabesque 1, 2 & 3)"}, "madsrdf:citationSource": "Wikipedia, Feb. 20, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Medtner, N.K. Arabesques, piano, op. 7. Drei Arabesken = Trois arabesques = Three arabesques, 1925.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Debussy, C. Deux arabesques, \u00a91988.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5857f86c28e24cafbae25af169b27c7fb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(arabesque def. 3. a short, fanciful musical piece, typically for piano)"}, "madsrdf:citationSource": "Dictionary.com, Feb. 20, 2019", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026033"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026034", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWitch films", "identifiers:lccn": "gf2019026034", "madsrdf:adminMetadata": [{"@id": "_:n72856d8175a84b859898e659c6f553bbb1"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Witch films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n72856d8175a84b859898e659c6f553bbb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026250"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026056"}], "madsrdf:hasSource": [{"@id": "_:n72856d8175a84b859898e659c6f553bbb5"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb6"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb7"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb8"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb9"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb10"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb11"}], "madsrdf:hasVariant": [{"@id": "_:n72856d8175a84b859898e659c6f553bbb12"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature witches and/or warlocks and the practice of witchcraft."}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-02-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Witch films"}}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(H\u00e4xan (1922); The Wizard of Oz (1939); I Married a Witch (1942); Bell, Book and Candle (1958); Black Sunday (1960); Bedknobs and Broomsticks (1971); Suspiria (1977); The Witches of Eastwick (1987); The Witches (1990); Hocus Pocus (1993); The Craft (1996); The Covenant (2006); Suspiria (2018))"}, "madsrdf:citationSource": "Peitzman, L. 32 witch movies you have to see, via BuzzFeed news website, posted Nov. 2, 2018, viewed Feb. 22, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Witches and warlocks are often the subject of horror films, and even though most people think of evil when mentioned, sometimes these characters are the good guys. We've focused on films with magic elements; The Craft (1996); Black Sunday (1960); Haxan: Witchcraft Through the Ages (1922); The Conjuring (2013); Kiki's Delivery Service (1989); Suspiria (1977))"}, "madsrdf:citationSource": "The best witchcraft films, via Cinema Paradiso website, Feb. 22, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Paranormal films. Films about the paranormal, purported phenomena described in popular culture, folk, and other non-scientific bodies of knowledge, whose existence within these contexts is described as beyond normal experience or scientific explanation; paranormal phenomena include extrasensory perception (ESP), telekinesis, ghosts, poltergeists, life after death, reincarnation, faith healing, human auras, and so forth)"}, "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(witch movies; witch films; the on-screen genre)"}, "madsrdf:citationSource": "Sutton, S. They don't make witch movies like they did in the '90s, via Cosmopolitan website, posted Oct 22, 2018, viewed Feb. 22, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Witch Film (Witchcraft Film); witches and their magical powers; movies about witches, if not plentiful, are nevertheless a very distinct group; the witch film includes both horror and non-horror films. Examples: Maid of Salem (1937); City of the Dead (1960); El espejo de la bruja (1960); Witchcraft (1964); The Witches (1966); Curse of the Crimson Altar (1968); The Witchmaker (1968); The Devonsville Terror (1983); Necropolis (1986); The Witches of Eastwick (1987); The Witches (1990))"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Summary: This magical adventure tells the spine-tingling tale of 10-year-old Lewis, who goes to live with his uncle in a creaky old house with a mysterious tick-tocking heart. But his new town's sleepy fa\u00e7ade jolts to life with a secret world of warlocks and witches)"}, "madsrdf:citationSource": "Work cat.: The house with a clock in its walls, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"warlock films\")"}, "madsrdf:citationSource": "Ashgate encyclopedia of literary and cinematic monsters, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72856d8175a84b859898e659c6f553bbb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Witchcraft films"}}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Witchcraft films"}}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72856d8175a84b859898e659c6f553bbb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Warlock films"}}, {"@id": "_:n72856d8175a84b859898e659c6f553bbb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Warlock films"}}], "@id": "/authorities/genreForms/gf2019026034"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026036", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIntermezzos (Instrumental music)", "identifiers:lccn": "gf2019026036", "madsrdf:adminMetadata": [{"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db1"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Intermezzos (Instrumental music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db3"}]}, "madsrdf:exampleNote": "Note under [Interludes (Music)]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db5"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db6"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db7"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db8"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db9"}], "madsrdf:hasVariant": {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short, instrumental musical works that are performed independently of other works. For music performed between parts of other works, see [Interludes (Music).]"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T08:45:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-02-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intermezzos (Instrumental music)"}}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(intermezzo, plural intermezzi or intermezzos : a short independent instrumental composition)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Feb. 23, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Intermezzo (iii) (A term used since the early 19th century for movements or sections, generally within larger works; also for independent pieces, often for piano solo and predominantly lyrical in character. Burney was among the first to use the term to describe instrumental music; Brahms composed numerous independent intermezzos, and his last works include 14 pieces so called)"}, "madsrdf:citationSource": "Grove music online, Feb. 23, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(intermezzo, plural intermezzi or intermezzos: a short piece of music written to be played on its own or as part of a longer piece)"}, "madsrdf:citationSource": "Cambridge dictionary online, Feb. 23, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(includes: Three intermezzos, op. 117)"}, "madsrdf:citationSource": "Work cat.: Brahms, J. Brahms : late piano works, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Intermezzo, (Italian: \"interlude\")plural intermezzi or intermezzos, in music and theatre, an entertainment performed between the acts of a play; also a light instrumental composition)"}, "madsrdf:citationSource": "Britannica online, May 17, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Intermezzi (Instrumental music)"}}, {"@id": "_:neea7fb21ce3a4b1abc36046ba0f3de1db11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intermezzi (Instrumental music)"}}], "@id": "/authorities/genreForms/gf2019026036"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026040", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRelaxation music", "identifiers:lccn": "gf2019026040", "madsrdf:adminMetadata": [{"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb1"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Relaxation music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasSource": [{"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb5"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb6"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb7"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb8"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb9"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb10"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb11"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb12"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb13"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-04T13:40:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Relaxation music"}}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Listening to soothing music that relaxes your body and elevates your mind can significantly reduce how much stress you feel. Relaxation music helps you connect to your inner peace; to relax your body; calming music; relaxation music can be a big help for parents at naptimes and in the evenings before bed, with its soothing effect on infants and children; studies have shown that people who listen to soothing music have requested less pain medication after surgery and that relaxation music can also help them manage chronic pain)"}, "madsrdf:citationSource": "Gordon, D. 16 ways to benefit from relaxation music, via Sequoia Records website, July 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 40 (music for relaxation; relaxing music) p. 53 (relaxation music; Words and phrases frequently listed to de\u00adscribe music perceived as relaxing included: \"quiet,\" \"peaceful,\" \"soft,\" \"dreamy,\" \"soothing,\" \"serene,\" \"undramatic, \"low volume,\" \"slow speed (pace, tempo),\" \"regular rhythm,\" \"pleasant combina\u00adtion of instruments,\" \"strings (piano, clarinet) very relaxing\"; low bass sounds, slow tempi, small numbers of instruments, and few changes (in tempo, volume, or instrumentation) as elements that enhanced relaxation experience)"}, "madsrdf:citationSource": "Journal of music therapy, spring 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Music for relaxation. UF Relaxation music. BT Relaxation)"}, "madsrdf:citationSource": "LCSH, Mar. 4, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Llewellyn. Relaxation music for you & your dog, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(piano music for relaxing)"}, "madsrdf:citationSource": "Work cat.: Chamras Saewataporn. Morning : soft & easy for relaxing, healing, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (Music as a sound medium has been used as part of wellness programs in a variety of ways, including as a sonic background for relaxation experiences; music listening to positively affect neurophysiological and emotional responses related to relaxation) p. 135 (relaxing music) pp. 138-139 (listening to music may help facilitate a relaxation response in part because of the integrated ways that it is processed by the brain and body; music which is perceived to be soothing or relaxing; musical elements which are perceived by many listeners to be relaxing include a slow and stable tempo (pace or speed), low volume level and soft dynamics, consistent texture (combination of sounds and instruments), absence of percussive and accented rhythms, gentle timbre (sound or tone color), legato (connected) melodies, and simple harmonic or chord progressions; these elements are often found in music composed for relaxation, as well as music classified as new age and classical; any recordings produced speci\ufb01cally for relaxation purposes are 20-30 min long, which may be a good target length for a relaxation experience; Commercially produced relaxation recordings often have narrations which lead the listener through breathing and muscle relaxation exercises ollowed by pleasant imagery to help facilitate relaxation)"}, "madsrdf:citationSource": "Krout, R.E. Music listening to facilitate relaxation and promote wellness, in The arts in psychotherapy, Dec. 2007, viewed online July 16, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 177 (As designed relaxation music it isn't really meant to arrest the listener's attention or distinguish itself in the listener's mind. In the spa environment, for example, it seems primarily intended to \"blend in\" with other ambient factors--the colors, the lighting, the fragrances--to enhance the overall \"healing arts ambience\" of the place, whereas in the hospital environment it seems rather intended to neutralize noise and other ambient stress factors; no dynamics; minimal if any formal compositional structure; not much there to \"think about\" (that's by design, of course)) p. 180 (Music designed for therapeutic applications is by and large purely instrumental and without text (although it does sometimes come with associated visual imagery) ... If the objective is relaxation, the tempo of the music's pulse should be relatively slow, melodic movement should be gradual and minimal, volume should be low, and the dynamics relatively even)"}, "madsrdf:citationSource": "Rudinow, J. Soul music, \u00a92010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Llewellyn and Juliana (Musical group). Relaxation music for children, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 439 (This study investigated the effectiveness of a particular type of \"relaxation\" music that we call Meditative Binaural Music (MBM), which incorporates binaurally recorded sounds, binaural beats, a slow tempo, and gradual changes) p. 441 (Modern \"relaxation\" music regularly includes binaural beats) p. 442 (listening to music with embedded binaural beats was more effective than music without binaural beats in reducing anxiety in pre-operative hospital patients; binaurally recorded sounds and slowly unfolding musical patterns, intended for calming the mind and body) p. 445 (solo instruments perform simple melodic and rhythmic patterns in an even manner and at a calm pace)"}, "madsrdf:citationSource": "Journal of music therapy, winter 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf82f3109e467b89643277ecc8ebdfb14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Late night classics : relaxing music for two guitars, 2011.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026040"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026041", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMeditation music", "identifiers:lccn": "gf2019026041", "madsrdf:adminMetadata": [{"@id": "_:n63dd2b69227d416db3014513bcc56353b1"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Meditation music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n63dd2b69227d416db3014513bcc56353b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasSource": [{"@id": "_:n63dd2b69227d416db3014513bcc56353b5"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b6"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b7"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b8"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b9"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b10"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b11"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b12"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b13"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b14"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b15"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b16"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b17"}], "madsrdf:hasVariant": {"@id": "_:n63dd2b69227d416db3014513bcc56353b18"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-04T13:40:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Meditation music"}}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 99 (Many people use music as an aid to meditation; music that has a calming effect and facilitates entry into the meditation; the most common meditation music is instrumental, which features calming melodies and perhaps natural sounds)"}, "madsrdf:citationSource": "Bolls, U.D. Meditation for Aspies, 2013, via Google books, July 16, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (meditational music)"}, "madsrdf:citationSource": "Psychology of consciousness, Dec. 17, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Meditation : essential guide to meditation music, 2012?", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 27 (meditation music) p. 29 (Meditation music has sedative effects. Sounds are slow and rhythms few)"}, "madsrdf:citationSource": "International journal of critical illness and injury science, Jan.-Apr. 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Scott, Tony. Music for Zen meditation, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Magdala (Musical group). Solace : music for quiet meditation, \u21172006.", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 9 (music to facilitate meditation) p. 181 (meditation with music)"}, "madsrdf:citationSource": "Halpern, S. Sound health, \u00a91985:", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (\"For many years, His Holiness Sri Ganapati Sachchidananda Swamiji has given Healing and Meditation concerts with steady growing success in India and in western countries. Playing and singing his own compositions, He is accompanied by excellent musicians on classical Indian instruments. The chosen Ragas--supported by the manifold sounds of His synthesiser--are highly able to harmonise the body and the mind of the listener and many reports are known about healings by listening to Sri Swamiji's music\")"}, "madsrdf:citationSource": "Work cat.: Ganapati Sacchidaananda, Swami. Amba Bhavani : music for meditation and healing, 200-?:", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Music for meditation. UF Meditation music. BT Meditation)"}, "madsrdf:citationSource": "LCSH, Mar. 4, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Music genre > Meditation music: music played with or listened to during meditation)"}, "madsrdf:citationSource": "Sfetcu, N. The music sound, via Google books, July 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under China, People's Republic of: Buddhist or Daoist meditational music; under Romania: meditation music)"}, "madsrdf:citationSource": "Grove music online, Mar. 4, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Meditation music (Meditation music is music performed to aid in the practice of meditation. It can have a specific religious content, but also more recently has been associated with modern composers who use meditation techniques in their process of composition, or who compose such music with no particular religious group as a focus)"}, "madsrdf:citationSource": "Wikipedia, July 16, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 53 (meditation music)"}, "madsrdf:citationSource": "Nursing science quarterly, Jan. 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n63dd2b69227d416db3014513bcc56353b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Meditational music"}}, {"@id": "_:n63dd2b69227d416db3014513bcc56353b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Meditational music"}}], "@id": "/authorities/genreForms/gf2019026041"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026042", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:na38a535eeaef407bb0375969638205dbb1"}, {"@id": "_:na38a535eeaef407bb0375969638205dbb2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the genre/form term is covered by the genre/form terms {Filmed performances} (DLC)gf2011026276 and {Tangos (Dance0} (DLC) gp2023026113"}, "madsrdf:elementList": {"@list": [{"@id": "_:na38a535eeaef407bb0375969638205dbb3"}]}, "madsrdf:useInstead": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026276"}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed tangos"}}, {"@id": "_:na38a535eeaef407bb0375969638205dbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na38a535eeaef407bb0375969638205dbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-05-22T14:04:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "deprecated"}, {"@id": "_:na38a535eeaef407bb0375969638205dbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed tangos"}}], "@id": "/authorities/genreForms/gf2019026042"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026043", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExercise music", "identifiers:lccn": "gf2019026043", "madsrdf:adminMetadata": [{"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb1"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Exercise music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasSource": [{"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb5"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb6"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb7"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb8"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb9"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb10"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb11"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb12"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb13"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb14"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb15"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb16"}], "madsrdf:hasVariant": [{"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb17"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb20"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb23"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb26"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb29"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-04T13:40:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Exercise music"}}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Exercise music. UF Music for exercise; Music for workouts; Musico-callisthenics; Workout music. BT Music)"}, "madsrdf:citationSource": "LCSH, Mar. 7, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (positive effects of music on exercise; benefits of listening to music during exercise; dissociative effect of music resulting in reduced perceived exertion, accompanied by greater output, enhanced performance, improved skill and improved mood; the dissociative effect of music enhances exercise and achieves the potential benefits) p. 8 (Dissociation means that the one who is exercising is distracted by the music he or she is listening to and is able to exercise through small aches and pains, or how tired one is while exercising. In other words, it allows one to concentrate on the music and not on the exercise.)"}, "madsrdf:citationSource": "Corigliano, B. What are the ergogenic effects of music during exercise?, 2017, viewed online June 27, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(exercise music titles include: The aerobics mix; Cha cha slide-er-cize workout exercise music; Christian workout playlist; Get fit to jazz; Tony Little's fit trax. Cardio pop : workout music; Tony Little's fit trax. Cardio rock : workout music; Fitness rock & roll; Dancexercise; Jazzercise; Zumba fitness dance party)"}, "madsrdf:citationSource": "LC database, Mar. 7, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "World music for workout & dance, 2011?", "madsrdf:citationStatus": "found"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(streaming audio exercise music)"}, "madsrdf:citationSource": "Work cat.: Hooah! : music for fitness training, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online, Mar. 7, 2019", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wedvik, T. Pure workout music, \u21171989.", "madsrdf:citationStatus": "found"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Stores, D. Aerobic exercise music, 1984.", "madsrdf:citationStatus": "found"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ken Alan's aerobic beat : music for working out!, \u21171991.", "madsrdf:citationStatus": "found"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 (Exercise professionals realized in the late 1970s that if exercise for the masses could be coordinated with music, people would be far more likely to enjoy it and thus maintain a daily routine) p. 15 (Music is used in three main ways within sport and exercise: synchronous, asynchronous, and pre-task)"}, "madsrdf:citationSource": "Karageorghis, C.I. Applying music in exercise and sport, 2017, via WWW, viewed June 27, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(exercise music; four aspects of music impact its ability to motivate people to exercise. Listed in order of importance, these characteristics are rhythm response, musicality, cultural impact, and association; music you listen to while exercising should reflect your personal traits and preferences, exercise activities and surroundings, and goals for engaging in physical activity)"}, "madsrdf:citationSource": "Exercise music 101, via Pittsburgh Symphony Orchestra Music and wellness website, June 27, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Music increases motivation. Music increases performance; workout music)"}, "madsrdf:citationSource": "Aagaard, M. Fitness music, 2014, via Fitness wellness world website, June 27, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fitness training music"}}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fitness training music"}}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fitness music"}}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fitness music"}}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Workout exercise music"}}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Workout exercise music"}}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Aerobic exercise music"}}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aerobic exercise music"}}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Workout music"}}, {"@id": "_:n60f4c5f0d8c54ba7b37d2aead0c148edb30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Workout music"}}], "@id": "/authorities/genreForms/gf2019026043"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026044", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSlapstick comedy plays", "identifiers:lccn": "gf2019026044", "madsrdf:adminMetadata": [{"@id": "_:n01d6116250254853bdd2619415a1cb18b1"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Slapstick comedy plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n01d6116250254853bdd2619415a1cb18b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026335"}, "madsrdf:hasSource": [{"@id": "_:n01d6116250254853bdd2619415a1cb18b5"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b6"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b7"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b8"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b9"}], "madsrdf:hasVariant": [{"@id": "_:n01d6116250254853bdd2619415a1cb18b10"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b13"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T08:45:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Slapstick comedy plays"}}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(slapstick. Literally, two hinged wooden slats attached to a handle. When the device strikes a person, a loud smack is heard. Originally used by Harlequin in commedia lazzi. The term now refers to any comedy that features physical, often abusive, pranks.)"}, "madsrdf:citationSource": "Mobley, J.P. NTC's dictionary of theatre and drama terms, \u00a91992", "madsrdf:citationStatus": "found"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(slapstick: Originally, the bat wielded by Harlequin. The term is now used of any boisterous physical comedy.)"}, "madsrdf:citationSource": "The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Knockabout comedy (Farcical rough and tumble in which laughter is provoked by the infliction of physical misfortune. Custard pies, banana skins, black eyes, misplaced buckets of water and lumps on the cranium are standard ingredients) Slapstick (Originally the wand used by Harlequin in pantomime to beat his enemies. The term now means knockabout comedy)"}, "madsrdf:citationSource": "Hodgson, T. The drama dictionary, \u00a91988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"The Marx Brothers played havoc with the worlds of opera and horse racing. What if they'd had a crack at a ballet company? ... With physical gags, slapstick comedy, one-liners, puns, chases, beautiful girls, new musical numbers, and the craziest version of The Nutcracker you'll ever see! A Night at the Nutcracker is a musical Christmas farce that's fun for the whole family.\")"}, "madsrdf:citationSource": "Work cat.: Van Zandt, W. A night at The nutcracker, \u00a92008", "madsrdf:citationStatus": "found"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Knockabout farce (Type of farce in which the humour is based mainly upon physical misfortune, e.g. falling over or being hit by missiles such as custard pies) Slapstick (Very broad, knockabout farce, often involving messy routines with materials such as water, flour and custard pies)"}, "madsrdf:citationSource": "Winslow, C. The Oberon glossary of theatrical terms, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01d6116250254853bdd2619415a1cb18b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Knockabout farce plays"}}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Knockabout farce plays"}}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01d6116250254853bdd2619415a1cb18b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Slapstick plays"}}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Slapstick plays"}}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01d6116250254853bdd2619415a1cb18b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Knockabout comedy plays"}}, {"@id": "_:n01d6116250254853bdd2619415a1cb18b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Knockabout comedy plays"}}], "@id": "/authorities/genreForms/gf2019026044"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026045", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aField notes", "identifiers:lccn": "gf2019026045", "madsrdf:adminMetadata": [{"@id": "_:nf5d551be45154a58835413c7a5b29a78b1"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Field notes"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf5d551be45154a58835413c7a5b29a78b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026163"}, "madsrdf:hasSource": [{"@id": "_:nf5d551be45154a58835413c7a5b29a78b5"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b6"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b7"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b8"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b9"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b10"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b11"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b12"}], "madsrdf:hasVariant": [{"@id": "_:nf5d551be45154a58835413c7a5b29a78b13"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b16"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b19"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b22"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b25"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b28"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-11-20T08:03:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dsi"}, "ri:recordStatus": "revised"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Field notes"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Refers to notes created by the researcher during the act of qualitative fieldwork to remember and record the behaviors, activities, events, and other features of an observation. Field notes are intended to be read by the researcher as evidence to produce meaning and an understanding of the culture, social situation, or phenomenon being studied. The notes may constitute the whole data collected for a research study (e.g., an observational project) or contribute to it, such as when field notes supplement conventional interview data)"}, "madsrdf:citationSource": "Organizing your social sciences research paper: writing field notes, via USC Libraries research guides website, Mar. 12, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (field notes) table of contents (field notebooks; field books)"}, "madsrdf:citationSource": "Canfield, Michael. Field notes on science & nature, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fieldnotes. When observing a culture, setting, or social situation, field notes are created by the researcher to remember and record the behaviors, activities, events and other features of the setting being observed. Field notes are meant to be read by the researcher to produce meaning and an understanding of the culture, social situation or phenomenon being studied)"}, "madsrdf:citationSource": "Robert Wood Johnson Foundation Qualitative Research Guidelines Project website, Mar. 12, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Field notes, research evaluations, and recordings related to Claire Turner's linguistic research on the Sen\u0107oten (also known as Saanich) dialect)"}, "madsrdf:citationSource": "Work cat.: Turner, Claire. Claire Turner linguistic research on Sen\u0107oten, 2009-2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fieldnotes. Notes, often in books, kept by researchers or surveying parties while on site.)"}, "madsrdf:citationSource": "Basic genre terms for cultural heritage materials, via Library of Congress American memory website, Mar. 22, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(field note: an item in a systematic record of the measurements made by a surveyor or the observations of a researcher in the field; field book: a notebook used for keeping field notes in surveying)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Mar. 12, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(field notes. UF field books. SN Notes, often in books, kept by researchers or surveying parties while on site)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Mar. 12, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(field notes: Observations and experiences recorded on paper or electronically by scientists in the course of their work with the phenomena under study. Descriptive sciences such as ethnography, archaeology, geology, and biology have a long history of recorded fieldwork. Also spelled fieldnotes)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Mar. 12, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5d551be45154a58835413c7a5b29a78b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Field"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Field"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5d551be45154a58835413c7a5b29a78b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Field books"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Field books"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5d551be45154a58835413c7a5b29a78b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Field notebooks"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Field notebooks"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5d551be45154a58835413c7a5b29a78b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Notes, Field"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Notes, Field"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5d551be45154a58835413c7a5b29a78b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Notebooks, Field"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Notebooks, Field"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5d551be45154a58835413c7a5b29a78b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fieldnotes"}}, {"@id": "_:nf5d551be45154a58835413c7a5b29a78b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fieldnotes"}}], "@id": "/authorities/genreForms/gf2019026045"}
