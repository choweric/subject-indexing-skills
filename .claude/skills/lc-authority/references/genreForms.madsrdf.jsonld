{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026226", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEpic television programs", "identifiers:lccn": "gf2011026226", "madsrdf:adminMetadata": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb1"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Epic television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026252"}, "madsrdf:hasSource": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb5"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb6"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb7"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb8"}], "madsrdf:hasVariant": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb9"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb12"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb15"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb18"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb21"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb24"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb27"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb30"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that employ large casts and lavish sets to depict action on a grand scale.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025290"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T13:44:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epic television programs"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 42 (Epic; Spectacle; Costume picture; Heroic film; Monumental film: tells of the exploits of some mythic or legendary hero, or of national or collective will, as the people, united in a common national or ethnic goal...strive for survival as a nation or race; settle conquered land, fight enemies, or defend the fatherland...epics are usually set in the historical past, but they can also deal with contemporary or even future events) p. 64 (Costume Film (Costume Drama, Costumer, Costume Spectacle); costume pictures; Film epics, adventure movies set in the past, historical films, and fantasy films that rely to a large extent on panoply qualify as costume films.)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 18 (Monumentalism; narratives in the monumentalist tradition; films on a monumental or epic scale; epics. Key characteristics: big budgets; crowd scenes; historical subjects; large casts and sets; pageantry; wide vistas)"}, "madsrdf:citationSource": "Bergan, R. Film isms--, c2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epics; use for fictional works which employ \"a cast of thousands\" to depict action on a cosmic scale. UF: Costume spectacles, Sandal and spear epics, Spectaculars, Sword and sandal epics)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epic: A motion picture characterized by its extensive narrative form and heroic qualities; epic film generally covers a large expanse of time as it follows in an episodic manner the continuing adventures of a hero or set of heroes; the production of epic films usually involves elaborate settings, authentic period costumes, and a large cast of characters)"}, "madsrdf:citationSource": "Beaver, F.E. Dictionary of film terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television epics"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television epics"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epics, Television"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epics, Television"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spectaculars (Television programs)"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spectaculars (Television programs)"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Heroic television programs"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heroic television programs"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Costume spectacles (Television programs)"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Costume spectacles (Television programs)"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Monumentalist television programs"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monumentalist television programs"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spectacles (Television programs)"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spectacles (Television programs)"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Monumental television programs"}}, {"@id": "_:nd7ff6d2e5bd142efbdf8f98caa1d0efeb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monumental television programs"}}], "@id": "/authorities/genreForms/gf2011026226"}
