rdStatus": "revised"}, {"@id": "_:n86f271336be649378a5fad924cd75a89b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bumper stickers"}}, {"@id": "_:n86f271336be649378a5fad924cd75a89b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bumper stickers. UF bumper strips. SN Stickers intended to be placed on the bumpers of motor vehicles, usually bearing messages such as slogans, witticisms, or advertisements)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Mar. 12, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n86f271336be649378a5fad924cd75a89b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bumper sticker: A self-adhesive sticker, usually about 3 x 13 inches in size, bearing a printed and/or graphic message, intended for display on the bumper of an automobile, but often displayed in other places. Introduced in the mid-1900s, this form of ephemera is widely used in political campaigns, but has also become a means of communicating humor and satire)"}, "madsrdf:citationSource": "Reitz, J.M ODLIS : online dictionary for library and information science, Mar. 12, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n86f271336be649378a5fad924cd75a89b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bumper stickers. UF Bumper strips. BT Signs and signboards. BT Stickers)"}, "madsrdf:citationSource": "LCSH, Mar. 12, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n86f271336be649378a5fad924cd75a89b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bumper sticker: a strip of adhesive paper or plastic bearing a printed message and designed to be stuck on a vehicle's bumper)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Mar. 12, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n86f271336be649378a5fad924cd75a89b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection of twelve genuine crack-'n-peel bumper stickers designed and printed letterpress by Kyle Schlesinger with the assistance of Hannah King in two or three colors each)"}, "madsrdf:citationSource": "Work cat.: Schlesinger, K. Bumpers, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n86f271336be649378a5fad924cd75a89b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n86f271336be649378a5fad924cd75a89b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Strips, Bumper"}}, {"@id": "_:n86f271336be649378a5fad924cd75a89b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Strips, Bumper"}}, {"@id": "_:n86f271336be649378a5fad924cd75a89b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n86f271336be649378a5fad924cd75a89b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stickers, Bumper"}}, {"@id": "_:n86f271336be649378a5fad924cd75a89b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stickers, Bumper"}}, {"@id": "_:n86f271336be649378a5fad924cd75a89b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n86f271336be649378a5fad924cd75a89b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bumper strips"}}, {"@id": "_:n86f271336be649378a5fad924cd75a89b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bumper strips"}}], "@id": "/authorities/genreForms/gf2019026046"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026047", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTime-travel television programs", "identifiers:lccn": "gf2019026047", "madsrdf:adminMetadata": [{"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb1"}, {"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Time-travel television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026558"}, "madsrdf:hasSource": [{"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb5"}, {"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb6"}, {"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T08:45:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Time-travel television programs"}}, {"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Doctor Who, British science fiction television series produced by the British Broadcasting Corporation (BBC). The show's original run lasted 26 years, from 1963 to 1989. The series resumed to much acclaim in 2005; Doctor Who chronicled the adventures of an eccentric time-traveling scientist from the remote planet Gallifrey, home of the Time Lords. The Doctor, a Time Lord himself, traveled through time and space in his unique craft, the TARDIS, an acronym for Time and Relative Dimensions in Space)"}, "madsrdf:citationSource": "Britannica online, Mar. 14, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a time-travel television series)"}, "madsrdf:citationSource": "Work cat.: Doctor Who (Television program : 2005- ). Season 11. Doctor Who. The complete eleventh series, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nda8989ad2afa4f92a2e28b9deff99dedb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Television series about time travel; television series in which time travel (including the transfer of information through time) plays a major role; programs listed include: Doctor Who; Quantum Leap; Heroes; It's About Time; Russian Doll; Life on Mars; Torchwood; Dirk Gently; The Sarah Jane Adventures; Time Warp Trio)"}, "madsrdf:citationSource": "Wikipedia, Mar. 14, 2019", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026047"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026048", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPsychological comics", "identifiers:lccn": "gf2019026048", "madsrdf:adminMetadata": [{"@id": "_:ndafad5e620ae42aba20016c0417ff945b1"}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Psychological comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndafad5e620ae42aba20016c0417ff945b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:ndafad5e620ae42aba20016c0417ff945b5"}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b6"}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b7"}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b8"}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics in which the thoughts, feelings, and motivations of the characters are of equal or greater interest than the external action of the narrative."}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T08:45:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psychological comics"}}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Psychological (Psychological comics)"}, "madsrdf:citationSource": [{"@id": "https://imagecomics.com/comics/genres/psychological"}, "Image Comics website, viewed 26 Mar. 2019:"], "madsrdf:citationStatus": "found"}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"graphic novel Genesis ... handles deeply psychological and somewhat religious themes without providing any easy answers\"; \"Writer Nathan Edmondson and artist Alison Sampson ... made a bold push into the uncharted territories of psychological comics narratives\")"}, "madsrdf:citationSource": "Genesis is the changing face of Image Comics - the Bleeding Cool interview with Nathan Edmondson and Alison Sampson, via Bleeding Cool website, Apr. 14, 2014, viewed 26 Mar. 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover p. 4 (\"Valerie lives on her own and has, shall we say, a rich interior life ... explores relationships, memory, loneliness and obsession\")"}, "madsrdf:citationSource": "Gaffney, D. The three rooms in Valerie's head, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Jun learns to navigate the psychological trauma that she experienced in the war.\")"}, "madsrdf:citationSource": "Work cat.: Singelin, G. PTSD, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:ndafad5e620ae42aba20016c0417ff945b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 6 (psychological comics)"}, "madsrdf:citationSource": "Rhoades, S. A complete history of American comic books, 2008:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026048"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026049", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTravel comics", "identifiers:lccn": "gf2019026049", "madsrdf:adminMetadata": [{"@id": "_:n1948a83e61b944538180e48d8faab37ab1"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Travel comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1948a83e61b944538180e48d8faab37ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026453"}, "madsrdf:hasSource": [{"@id": "_:n1948a83e61b944538180e48d8faab37ab5"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab6"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab7"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab8"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab9"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab10"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab11"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab12"}], "madsrdf:hasVariant": [{"@id": "_:n1948a83e61b944538180e48d8faab37ab13"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab16"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab19"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab22"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Nonfiction comics about travel, often presented in narrative form or as memoirs, focusing either on specific destinations or on the journeys themselves."}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T08:45:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Travel comics"}}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 63 (Over the past twenty years a new hybrid has emerged within bookshops: the travel comic or graphic travelogue, combining two forms that have often individually provoked suspicion and denigration. Comics artists have journeyed across the globe reporting on their travels in increasing numbers; represent a new breed of travel writers combining the traditions of visual and literary arts) p. 66 (travel comics)"}, "madsrdf:citationSource": "Writing the dark side of travel, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 237-264 (exploration of travel comics; travel writing)"}, "madsrdf:citationSource": "Kahn, A. Pursuing paradise : Jewish travel comics as feminist spiritual quests, in Studies in comics, Dec. 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 69 (Joe Sacco and his comic book travels through the conflict zones of Bosnia and Palestine; travel writing comics)"}, "madsrdf:citationSource": "Walker, T. Graphic wounds : the comics journalism of Joe Sacco, in Journeys, Jun. 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 100 (travel comics)"}, "madsrdf:citationSource": "Representing multiculturalism in comics and graphic novels, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the comics travelogue, now a flourishing genre)"}, "madsrdf:citationSource": "Chute, H. A man alone in a comic book, via The New York review of books website, May 1, 2017, viewed Mar. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel) cover p. 4 (Craig Thompson traveled for three months through France, Barcelona, and the Alps, as well as Morocco, where he spent time researching his next graphic novel. This travelogue diary documents his adventures and quiet moments, creating an intimate portrait of countries, culture and wandering artist)"}, "madsrdf:citationSource": "Work cat.: Thompson, C. Carnet de voyage, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel; summary: Olivia had always heard stories about Algeria from her maternal grandmother, a Black Foot (a \"Pied-Noir,\" the French term for Christian and Jewish settlers of French Algeria who emigrated to France after the Algerian War of Independence). After her grandmother's death, Olivia found some of her grandmother's journals and letters describing her homeland. Now, ten years later, she resolves to travel to Algeria and experience the country for herself.)"}, "madsrdf:citationSource": "Burton, O. Algeria is beautiful like America, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel; summary: Born in Tokyo to a Japanese mother and an American father in 1997, Christine Mari Inzer spent her early years in Japan and relocated to the United States in 2003. The summer before she turned sixteen, she returned to Tokyo, making a solo journey to get reacquainted with her birthplace)"}, "madsrdf:citationSource": "Inzer, C.M. Diary of a Tokyo teen : a Japanese-American girl travels to the land of trendy fashion, high-tech toilets and maid cafes, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1948a83e61b944538180e48d8faab37ab14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Travelogues (Comics)"}}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Travelogues (Comics)"}}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1948a83e61b944538180e48d8faab37ab17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graphic travelogues (Comics)"}}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic travelogues (Comics)"}}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1948a83e61b944538180e48d8faab37ab20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comics travelogues"}}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comics travelogues"}}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1948a83e61b944538180e48d8faab37ab23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Travel writing comics"}}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Travel writing comics"}}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1948a83e61b944538180e48d8faab37ab26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Travelogs (Comics)"}}, {"@id": "_:n1948a83e61b944538180e48d8faab37ab26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Travelogs (Comics)"}}], "@id": "/authorities/genreForms/gf2019026049"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026050", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBerceuses", "identifiers:lccn": "gf2019026050", "madsrdf:adminMetadata": [{"@id": "_:na201452b1ff242c38e4922ca16332645b1"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Berceuses"}, "madsrdf:elementList": {"@list": [{"@id": "_:na201452b1ff242c38e4922ca16332645b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:na201452b1ff242c38e4922ca16332645b5"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b6"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b7"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b8"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b9"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b10"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b11"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b12"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b13"}], "madsrdf:hasVariant": {"@id": "_:na201452b1ff242c38e4922ca16332645b14"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na201452b1ff242c38e4922ca16332645b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T08:45:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Berceuses"}}, {"@id": "_:na201452b1ff242c38e4922ca16332645b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Berceuse, (French: \"lullaby\") musical composition, typically of the 19th century, having the character of a soothing refrain. While the word appears to imply no particular formal pattern, rocking rhythms in 6/8 time are common not only in the vocal prototype but also in its stylized instrumental counterparts, usually written for piano. A well-known example of the latter is Fr\u00e9d\u00e9ric Chopin's Berceuse in D-flat Major (1843-44), with its elaborate figurations above a static, repetitive pattern in the left hand. Prominent among subsequent composers of berceuses were Franz Liszt, Camille Saint-Sa\u00ebns, and Maurice Ravel.)"}, "madsrdf:citationSource": "Britannica online, Mar. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(for organ)"}, "madsrdf:citationSource": "Cochereau, Pierre. Berceuse \u00e0 la m\u00e9moire de Louis Vierne, \u00a91997", "madsrdf:citationStatus": "found"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(for piano)"}, "madsrdf:citationSource": "Work cat.: Chopin, Fr\u00e9d\u00e9ric. Berceuse Des-dur, opus 57 = Berceuse in D\u266d major, op. 57, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Berceuse (Fr.: 'cradle', 'lullaby'; Ger. Wiegenlied). A gentle song intended for lulling young children to sleep. In instrumental music the term usually refers to a character-piece for piano. The defining work of the genre is Chopin's Berceuse in D\u266d major op.57 (1843-4))"}, "madsrdf:citationSource": "Grove music online, Mar. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (for violin, violoncello and piano)"}, "madsrdf:citationSource": "Khachaturi\ufe20a\ufe21n, Aram. Berceuse f\u00fcr Violine, Violoncello und Klavier, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Corigliano, John. Lullaby for Natalie : for violin and piano, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Rorem, Ned. Lullaby for two violins and piano, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(berceuse, plural berceuses 1: a musical composition usually in 6/8 time that resembles a lullaby. 2: lullaby)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Mar. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(contents includes: Berceuse for violin and piano)"}, "madsrdf:citationSource": "Ireland, John. Piano trios, \u21172009", "madsrdf:citationStatus": "found"}, {"@id": "_:na201452b1ff242c38e4922ca16332645b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na201452b1ff242c38e4922ca16332645b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lullabies (Berceuses)"}}, {"@id": "_:na201452b1ff242c38e4922ca16332645b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lullabies (Berceuses)"}}], "@id": "/authorities/genreForms/gf2019026050"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026055", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n8377c05fa277452085ce73b2960a5d03b1"}, {"@id": "_:n8377c05fa277452085ce73b2960a5d03b2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is not a valid genre/form term."}, "madsrdf:elementList": {"@list": [{"@id": "_:n8377c05fa277452085ce73b2960a5d03b3"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Unfinished music"}}, {"@id": "_:n8377c05fa277452085ce73b2960a5d03b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-13T14:01:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n8377c05fa277452085ce73b2960a5d03b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-04-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8377c05fa277452085ce73b2960a5d03b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Unfinished music"}}], "@id": "/authorities/genreForms/gf2019026055"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026059", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCircus route books", "identifiers:lccn": "gf2019026059", "madsrdf:adminMetadata": [{"@id": "_:na90ed0c093224d898e3c0df30846a4ecb1"}, {"@id": "_:na90ed0c093224d898e3c0df30846a4ecb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Circus route books"}, "madsrdf:elementList": {"@list": [{"@id": "_:na90ed0c093224d898e3c0df30846a4ecb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026163"}, "madsrdf:hasSource": [{"@id": "_:na90ed0c093224d898e3c0df30846a4ecb5"}, {"@id": "_:na90ed0c093224d898e3c0df30846a4ecb6"}], "madsrdf:hasVariant": {"@id": "_:na90ed0c093224d898e3c0df30846a4ecb7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na90ed0c093224d898e3c0df30846a4ecb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-04-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na90ed0c093224d898e3c0df30846a4ecb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-14T08:16:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na90ed0c093224d898e3c0df30846a4ecb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Circus route books"}}, {"@id": "_:na90ed0c093224d898e3c0df30846a4ecb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Circus route books to be digitized with grant: The Ringling Archives received a grant from the Council on Library and Information Resources (CLIR) to digitize circus route books, dating from 1842-1969. Only 400 circus route books are known to exist. Published at the end of the show's season, route books listed personnel by department, the circus route (cities and towns played), and many times included photographs and statistics, such as miles traveled, number of cities visited, or meals served daily. In some, a daily diary of weather, ticket sales, and unusual events was included)"}, "madsrdf:citationSource": "Ringling.org web site, viewed Apr. 9, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na90ed0c093224d898e3c0df30846a4ecb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Ringling Bros. and Barnum & Bailey Combined Shows, Inc. : Route Book for 1946.", "madsrdf:citationStatus": "found"}, {"@id": "_:na90ed0c093224d898e3c0df30846a4ecb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na90ed0c093224d898e3c0df30846a4ecb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Route books, Circus"}}, {"@id": "_:na90ed0c093224d898e3c0df30846a4ecb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Route books, Circus"}}], "@id": "/authorities/genreForms/gf2019026059"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026060", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWeb archives", "identifiers:lccn": "gf2019026060", "madsrdf:adminMetadata": [{"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b1"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Web archives"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b5"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b6"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b7"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b8"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b9"}], "madsrdf:hasVariant": {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Here are entered archived single websites or collections of similar or related websites."}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-04-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "new"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-12T12:02:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Web archives"}}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(web archives are a new type of knowledge organization system which allows for the archiving and documentation of web materials considered worth preserving for the future)"}, "madsrdf:citationSource": "\"Web archive\" in Encyclopedia of knowledge organization, viewed April 18, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "about page (web archive or digital library of internet sites collected since 1996, providing over 20 years of web history)"}, "madsrdf:citationSource": [{"@id": "https://archive.org/about/"}, "Internet archive, viewed April 18, 2019:"], "madsrdf:citationStatus": "found"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection of websites created by non-profit organizations dedicated to researching, advocating for, supporting, and providing services to the LGBTQ communities in Japan)"}, "madsrdf:citationSource": [{"@id": "https://archive-it.org/collections/11854"}, "Queer Japan web archive, 2019-"], "madsrdf:citationStatus": "found"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(web archives are archived web collections which allow the user to see sites or articles that are no longer on the internet or have changed in design or content, and also allows for gathering data for analysis or detection of trends)"}, "madsrdf:citationSource": [{"@id": "https://siarchives.si.edu/blog/searching-and-using-web-archives"}, "\"Searching and using web archives\" via Smithsonian Institution Archives homepage, April 9, 2019"], "madsrdf:citationStatus": "found"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(web archives are created by collecting selected portions of the World Wide Web to preserve the information in a digital archive)"}, "madsrdf:citationSource": [{"@id": "https://en.wikipedia.org/wiki/Web_archiving"}, "\"Web archiving\" in Wikipedia, viewed April 18, 2019:"], "madsrdf:citationStatus": "found"}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Internet archives"}}, {"@id": "_:n0ef1d1717f244631a8bc5021f71c82b0b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Internet archives"}}], "@id": "/authorities/genreForms/gf2019026060"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026066", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCountry lyrics", "identifiers:lccn": "gf2019026066", "madsrdf:adminMetadata": [{"@id": "_:n08228469ecb9467681de07e7f7914629b1"}, {"@id": "_:n08228469ecb9467681de07e7f7914629b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Country lyrics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n08228469ecb9467681de07e7f7914629b3"}]}, "madsrdf:exampleNote": "Note under [Country music]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026003"}, "madsrdf:hasSource": [{"@id": "_:n08228469ecb9467681de07e7f7914629b5"}, {"@id": "_:n08228469ecb9467681de07e7f7914629b6"}], "madsrdf:hasVariant": {"@id": "_:n08228469ecb9467681de07e7f7914629b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n08228469ecb9467681de07e7f7914629b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-04-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n08228469ecb9467681de07e7f7914629b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-12T12:02:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n08228469ecb9467681de07e7f7914629b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Country lyrics"}}, {"@id": "_:n08228469ecb9467681de07e7f7914629b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 78 ([country] lyrics)"}, "madsrdf:citationSource": "Work cat: 2018564265: The weight of these wings, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n08228469ecb9467681de07e7f7914629b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Country music 3. (interpretations of country music have been based largely on the values expressed in the song lyrics)"}, "madsrdf:citationSource": "Grove music online, April 29, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n08228469ecb9467681de07e7f7914629b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n08228469ecb9467681de07e7f7914629b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Country music lyrics"}}, {"@id": "_:n08228469ecb9467681de07e7f7914629b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Country music lyrics"}}], "@id": "/authorities/genreForms/gf2019026066"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026069", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBizarro fiction", "identifiers:lccn": "gf2019026069", "madsrdf:adminMetadata": [{"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b1"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bizarro fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b5"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b6"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b7"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b8"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b9"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b10"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b11"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b12"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b13"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b14"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-09-12T13:45:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bizarro fiction"}}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 400 (bizarro fiction for children) p. 403 (The release of Carlton Mellick III's The Faggiest Vampire in 2009 marks the movement of Bizarro fiction into the realm of books for young readers and, in so doing, adds to the growing body of cult literature for this audience)"}, "madsrdf:citationSource": "Children's Literature Association quarterly, winter 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the Bizarro fiction genre; literary equivalent of the cult film; aims to satisfy the demands of readers who are looking for weird, in the same way other readers go looking for action or romance; the genre now has over a dozen small publishers, its own convention and an increasing cult status; Jeff Burk's Shatnerquake typifies the screwball exuberance of Bizarro fiction; Bizarro's fascination with the vulgar, smutty, distasteful and crude; \"Bizarro fiction is by turns stupid, repulsive and crude. But at its best, it is also intelligent, compelling and well-written. Any literary genre that can be both bad and good at the same time is worth watching\")"}, "madsrdf:citationSource": "Walter, D.G. Bizarro fiction: it's terribly good, in The guardian, 16 July 2010, viewed on May 6, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bizarro fiction is a contemporary literary genre, which often uses elements of absurdism, satire, and the grotesque, along with pop-surrealism and genre fiction staples, in order to create subversive, weird, and entertaining works; In general, bizarro has more in common with speculative fiction genres (such as science-fiction, fantasy, and horror) than with avant-garde movements (such as Dadaism and surrealism), which readers and critics often associate it with; the genre places an emphasis on the cult and outr\u00e9)"}, "madsrdf:citationSource": "Wikipedia, May 6, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bizarro Fiction; contemporary literary genre known for high weirdness; the print media equivalent of the cult film; strives to be not only strange but also thought-provoking and fun to read; takes place in a dreamlike alternate reality where the unexpected, unpredictable, unfathomable, or plain horrifying is commonplace. Traits: 1. Bizarro, simply put, is the genre of the weird. 2. Bizarro is literature's equivalent to the cult section at the video store. 3. Like cult movies, Bizarro is sometimes surreal, sometimes avant-garde, sometimes goofy, sometimes bloody, sometimes borderline pornographic, and almost always completely out there. 4. Bizarro strives not only to be strange, but fascinating, thought-provoking, and, above all, fun to read. 5. Bizarro often contains a certain cartoon logic that, when applied to the real world, creates an unstable universe where the bizarre becomes the norm and absurdities are made flesh)"}, "madsrdf:citationSource": "TV tropes website, May 6, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 40 (bizarro fiction such as Charles Mellick III's The Haunted Vagina or I Knocked Up Satan's Daughter)"}, "madsrdf:citationSource": "Teaching American literature, fall 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bizarro Fiction; characterised by its surreal, absurdist, grotesque and often comical stylistic and tonal excess; sub-genre (an off-shoot of weird fiction/fantasy) has its origins in the output of a number of small presses specialising in cult fiction; bizarro fiction thrives on pushing plots and themes to their most absurdist and outlandishly grotesque conclusions; there are now websites devoted to Bizarro Fiction (such as bizarrocentral.com), short story collections, fan events and magazines)"}, "madsrdf:citationSource": "Murphy, B.M. Key concepts in contemporary popular fiction, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "about the author p. (Carlton Mellick III is one of the leading authors of the bizarro fiction subgenre) p. 4 of cover (\"File under Bizarro Fiction\"; \"A bizarro book\"; \"A weird-as-hell gangster story set in a world where people drive giant mechanical dinosaurs instead of cars. Her name is Psycho June Howard, aka Armadillo Fists, a woman who replaced both of her hands with living armadillos\")"}, "madsrdf:citationSource": "Work cat.: Mellick, C. Armadillo fists, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 89 (Bizarro fiction) p. 93 (Eraserhead Press, a self-proclaimed \"renegade\" publisher that publishes Bizarro fiction)"}, "madsrdf:citationSource": "Publishing research quarterly, June 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(five tropes that pop up in bizarro fiction more than in any other lit genre: 1) Gross-outs. 2) Violated Taboos. 3) Stock creatures and character archetypes crossed-over from other genres: It's expected that dragons belong to fantasy, futuristic robots belong to sci-fi, and axe murderers belong to horror. In bizarro, the axe murderer has progressed to robot victims and is consuming their components so that he can become Giga-Gein, the cyborg poacher of dragons. Also, they are teenaged dragons at summer camp who seal their fate by telling ghost stories about Giga-Gein. 4) Surreal plot progression. 5) Bombastic Titles)"}, "madsrdf:citationSource": "Colell, E. Common bizarro components, via Bizarro central website, May 6, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(genre for people who look for books that are weird in the same way that some people seek out books that are scary or romantic; isn't horror, science-fiction, fantasy, or even experimental fiction. The only real way to describe it would be: weird; a genre of weirdness; the kind of fiction that is too weird to be categorized anywhere else; leans toward the humorous low brow side; Experimental fiction is weirdness of style. Bizarro fiction is weirdness of plot. Bizarro is not typically described as \"high art,\" whereas experimental fiction usually is or at least tries to be; bizarro isn't weird for the sake of being weird, it is weird for the sake of being interesting and/or entertaining)"}, "madsrdf:citationSource": "Henderson, R. Bizarro fiction 101: not just weird for weird's sake, via Fantasy magazine website, viewed May 6, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b4c5f41cd8d4d63adc391d2f7739de4b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "The best bizarro fiction of the decade, 2012.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026069"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026070", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGangster fiction", "identifiers:lccn": "gf2019026070", "madsrdf:adminMetadata": [{"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b1"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gangster fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b5"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b6"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b7"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b8"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b9"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b10"}], "madsrdf:hasVariant": {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-09-12T13:45:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gangster fiction"}}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(gangster fiction genre; gangster genre is a sub-genre of the crime genre and revolves around stories that focus on gangs and other organized criminals with support and resources that are complex--resources far beyond what a single criminal could ever achieve on their own; examples: The Godfather by Mario Puzo; She's Dating the Gangster by Bianca B. Bernardino; Rules of Attraction by Simone Elkeles; Wiseguy by Nicholas Pileggi; Donnie Brasco by Joseph D. Pistone; Billy Bathgate by E.L. Doctorow)"}, "madsrdf:citationSource": "The book genre dictionary, via WWW, May 6, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (\"A weird-as-hell gangster story ...\") p. 5 (\"my dinosaur horror book isn't even horror. It is closer to the gangster genre than horror, like one of those 'on the run from the mob' kind of stories\")"}, "madsrdf:citationSource": "Work cat.: Mellick, C. Armadillo Fists, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 210 (gangster fiction; a substantial amount of crime fiction features gangs and mobs; gangster fiction explores an otherwise hidden parallel world; genre label \"gangster\" crosses over from Hollywood. And this is entirely apposite given that many authors associated with organized crime literature have also had successful careers as screenwriters. The overlap between screen and print media in the case of gangster fiction is not coincidental, having everything to do with the way formal and thematic concerns of the first gangster novels informed the earliest period of \"talking pictures\" (the early 1930s)) p. 211 (The Great Gatsby might be considered the first recognizable major work of gangster fiction)"}, "madsrdf:citationSource": "A companion to crime fiction, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"In March of 1969 the literary world was changed forever by Mario Puzo's book 'The Godfather.' Gangster stories were not a completely new idea, but Puzo's take on the story offered a glimpse at life on the inside of a New York City crime family ... Many gangster novels like 'The Godfather' offer a romanticized view of the mob\")"}, "madsrdf:citationSource": "Beyond The godfather: gangster fiction at the library, via Daniel Boone Regional Library website, posted Mar. 20, 2017, viewed May 6, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "introd. (The crime, mystery & gangster fiction magazine index (or Crime fiction index in short); index to crime fiction magazines)"}, "madsrdf:citationSource": "The crime, mystery, & gangster fiction magazine index, via WWW, last updated Jan. 28, 2019, viewed on May 6, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Fraser, J. Portals and pulps : Orwell, Hoggart, \"America,\" and the uses of gangster fiction, in Transatlantica, 2012-1, viewed online May 6, 2019.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Organized crime fiction"}}, {"@id": "_:nf9746a08d3cf43dfb8b2b6b43b89b864b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Organized crime fiction"}}], "@id": "/authorities/genreForms/gf2019026070"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026071", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCozy mysteries", "identifiers:lccn": "gf2019026071", "madsrdf:adminMetadata": [{"@id": "_:n11c207c350504042a0922cb9b9a14251b1"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cozy mysteries"}, "madsrdf:elementList": {"@list": [{"@id": "_:n11c207c350504042a0922cb9b9a14251b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026280"}, "madsrdf:hasSource": [{"@id": "_:n11c207c350504042a0922cb9b9a14251b5"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b6"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b7"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b8"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b9"}], "madsrdf:hasVariant": {"@id": "_:n11c207c350504042a0922cb9b9a14251b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Mystery fiction that features amateur sleuths, socially intimate settings, and a light-hearted tone."}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/mssm"}, "ri:recordStatus": "new"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-12-20T11:01:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cozy mysteries"}}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a cozy mystery)"}, "madsrdf:citationSource": "James, Miranda. Twelve angry librarians : a cat in the stacks mystery, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a cozy mystery)"}, "madsrdf:citationSource": "Fluke, Joanna. Chocolate chip cookie murder, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cozy mysteries, also referred to as \"cozies\", are a subgenre of crime fiction in which sex and violence are downplayed or treated humorously, and the crime and detection take place in a small, socially intimate community)"}, "madsrdf:citationSource": "Wikipedia, May 7, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 97-98 (\"A term first used in a review in the Observer 25 May 1958, 'cozy' refers to a subgenre of the novel of detection defined by its light tone, element of fun, and closed world. A detective...investigates the eruption of violence in an apparently tranquil world; the cast of characters is limited, and suspects are known to each other. The plot is often intricate, the story told with a sense of humor, the setting one of material comfort, and the emphasis on verbal jousting rather than physical violence)"}, "madsrdf:citationSource": "Oxford companion to crime and mystery writing, 1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(An amateur sleuth, an unsuspecting victim, a quirky supporting cast, and trail of clues and red herrings are the main ingredients of a cozy mystery. The term \"cozy\" was coined in the late 20th century...In a cozy, the reader has the opportunity to solve the murder right along with the main character. As such, the readers believe they can solve the crime, too. The very best cozies are the ones in which the reader thinks she has solved the crime, finds out that she is wrong at the end of the book, but feels satisfied with the just conclusion because it is a surprise, but more importantly because the plot makes sense)"}, "madsrdf:citationSource": [{"@id": "https://www.publishersweekly.com/pw/by-topic/industry-news/tip-sheet/article/76834-the-enduring-appeal-of-the-cozy-mystery.html"}, "Flower, A. What exactly is a cozy mystery?, 2018 via Publishers weekly website, viewed May 7, 2019"], "madsrdf:citationStatus": "found"}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11c207c350504042a0922cb9b9a14251b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cozies (Cozy mysteries)"}}, {"@id": "_:n11c207c350504042a0922cb9b9a14251b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cozies (Cozy mysteries)"}}], "@id": "/authorities/genreForms/gf2019026071"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026072", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aComedy rock music", "identifiers:lccn": "gf2019026072", "madsrdf:adminMetadata": [{"@id": "_:nba8a5a998a094cd4b75bc4025a438542b1"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Comedy rock music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nba8a5a998a094cd4b75bc4025a438542b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026870"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}], "madsrdf:hasSource": [{"@id": "_:nba8a5a998a094cd4b75bc4025a438542b5"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b6"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b7"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b8"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b9"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-14T08:16:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedy rock music"}}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Comedy Rock is rock music that has designed to poke fun at rock traditions, as well as mainstream society. It is humorous both in its musical attack and in its lyrics. Sometimes comedy rock can be sophomoric -- its godfather, Frank Zappa, loved jokes about fecal matter and big boobs -- but at its best, it cleverly skewers clich\u00e9s and conventions. Artists: Weird Al Yankovic; Flight of the Conchords; Tenacious D; Monty Python; Dead Milkmen; Steel Panther; Ween; The Fugs; The Presidents of the United States of America; Spinal Tap; The Bobs; Nerf Herder; Dread Zeppelin, Elio e le Storie Tese)"}, "madsrdf:citationSource": "Comedy rok music genre overview, via AllMusic website, Feb. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Comedy Rock. Comedy Rock Fusing music with the art of parody and satire, comedy rock presents a humorous escape from the usual emotional confines of its other brother and sister genres.Comedy Rock has spawned many respected careers such as the cult classic band Spinal Tap created for the mockmentary of the same name, as well as the many ventures of Tenacious D, the video spoofs of \"Weird Al\" Yankovic, the zany TV show of Flight Of The Concords, along with the unashamedly hair metal show experience of Steel Panther)"}, "madsrdf:citationSource": "Franklin, C. The A-Z of rock: a beginner's guide to sub genres, 2015, via WWW, Feb. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Comedy rock is a term used to describe rock music that is mixed with satire or other forms of comedy; such as Frank Zappa, Tenacious D, and more recently, Flight of the Conchords create songs with amusing, witty, and/or over-the-top lyrics. Other acts such as Dread Zeppelin, Beatallica, and GWAR rely more on gimmicks such as outrageous costumes or mixing genres for comic effect)"}, "madsrdf:citationSource": "Comedy rock music, via last.fm website, Feb. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comedy rock songs)"}, "madsrdf:citationSource": "Work cat: Yankovic, A. Bad hair day \u21171994", "madsrdf:citationStatus": "found"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Comedy rock is rock music mixed with comedy, often satire and parody; With over 12 million albums sold, song parodist \"Weird Al\" Yankovic remains the highest-selling comedy act in history)"}, "madsrdf:citationSource": "Wikipedia, Feb. 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nba8a5a998a094cd4b75bc4025a438542b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online, Feb. 20, 2019", "madsrdf:citationStatus": "notfound"}], "@id": "/authorities/genreForms/gf2019026072"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026073", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEthnographic fiction", "identifiers:lccn": "gf2019026073", "madsrdf:adminMetadata": [{"@id": "_:n247048655d334fc4885c146d88f65d8ab1"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ethnographic fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n247048655d334fc4885c146d88f65d8ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n247048655d334fc4885c146d88f65d8ab5"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab6"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab7"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab8"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab9"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab10"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab11"}], "madsrdf:hasVariant": [{"@id": "_:n247048655d334fc4885c146d88f65d8ab12"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-09-12T13:45:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnographic fiction"}}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 190 (the author of ethnographic fiction weaves a \"likely\" story that relates events in an ethnographically informed account ... With ethnographic veracity satisfied, the author becomes a novelist ... ethnographic fiction is based on fieldwork. ... As fiction, the ethnographic novel must compete with the works of storytellers whose works are neither hampered nor enhanced by allegiance to accuracy)"}, "madsrdf:citationSource": "Wolcott, H.F. Ethnography, \u00a91999, via Google books, viewed May 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 81 (ethnographical fiction)"}, "madsrdf:citationSource": "In-between fiction and non-fiction, 2018, via Google books, viewed May 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. ix-x (Fiction's place in anthropology has a long but interrupted history ... Elsie Clues Parsons' edited volume of short stories by such luminaries as Franz Boas, Edward Sapir, Robert Lowie, and Paul Radin, published in 1922, is a landmark in anthropological fiction. In 1929, Oliver La Farge's novel Laughing Boy won a Pulitzer Prize. Anthropological fiction declined after the initial period of experimentation because scientism dominated American anthropology.)"}, "madsrdf:citationSource": "Isbell, B.J. Finding Cholita, \u00a92009, via Project MUSE, viewed May 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. vii (In his novel, White reveals the courtesy and chivalry, the manners and customs and the life of the old-time Maori in a way that only his intimate knowledge of his subject would permit)"}, "madsrdf:citationSource": "Work cat.: White, J. Revenge : a love tale of the Mount Eden tribe, 1940:", "madsrdf:citationStatus": "found"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 5 (the fieldwork experience is at the root of most anthropological fiction writing)"}, "madsrdf:citationSource": "American Anthropological Association. Annual Meeting (110th : 2011 : Montr\u00e9al, Qu\u00e9bec). The heroic anthropologist rides again : the depiction of the anthropologist in popular culture, 2012, via Google books, viewed May 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Contemporary ethnographic fiction, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 21 (ethnographic fiction)"}, "madsrdf:citationSource": "Evans, B. Before cultures : the ethnographic imagination in American literature, 1865-1920, \u00a92005, via Google books, viewed May 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n247048655d334fc4885c146d88f65d8ab13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ethnographical fiction"}}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnographical fiction"}}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n247048655d334fc4885c146d88f65d8ab16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anthropological fiction"}}, {"@id": "_:n247048655d334fc4885c146d88f65d8ab16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anthropological fiction"}}], "@id": "/authorities/genreForms/gf2019026073"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026074", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRoundels", "identifiers:lccn": "gf2019026074", "madsrdf:adminMetadata": [{"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b1"}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Roundels"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b5"}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b6"}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b7"}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b8"}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that generally consist of 11 lines arranged in three stanzas that employ two rhymes and a refrain in the fourth and eleventh line consisting of the opening words of the first line."}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-31T10:14:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Roundels"}}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(roundel 2a : rondel sense 2a; b : an English modified rondeau)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, May 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Roundel (poetry) (A roundel (not to be confused with the rondel) is a form of verse used in English language poetry devised by Algernon Charles Swinburne (1837-1909). It is the Anglo-Norman form corresponding to the French rondeau. It makes use of refrains, repeated according to a certain stylized pattern. A roundel consists of nine lines each having the same number of syllables, plus a refrain after the third line and after the last line. The refrain must be identical with the beginning of the first line: it may be a half-line, and rhymes with the second line. It has three stanzas and its rhyme scheme is as follows: A B A R ; B A B ; A B A R ; where R is the refrain)"}, "madsrdf:citationSource": "Wikipedia, May 20, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 3-17 (in section of Roundels: most of these poems consist of 11 lines total, broken into 4 and 7 lines; the 4th and 7th lines contain the same words that begin the first line)"}, "madsrdf:citationSource": "Work cat.: Richmond, M.E. Roundels, sonnets and other verses, 1898:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(roundel: 4. a. Archaic a rondeau b. an English variation of the rondeau, with eleven lines (three stanzas), the fourth and eleventh being the refrain)"}, "madsrdf:citationSource": "Collins English dictionary, via WWW, May 20, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1ac94bf7f104c4192c7f58a41ef1170b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Roundel. In the Middle Ages, this term was simply a synonym for the rondeau or the rondel--e.g., Chaucer, \"Knight's Tale\" (1529). But in its mod. sense, the term usually refers to the variant form introduced by A. C. Swinburne in his A Century of Roundels (1883). The Swinburne roundel is a three-stanza, two-rhyme poem of 11 lines on the pattern abaR bab abaR where R stands for the rentrement . The rentrement, as in the rondeau, is a shortened line--a word or phrase--that repeats in the manner of a refrain; in the Swinburne roundel, the rentrement normally rhymes with the b lines of the poem. The few other poets who have written Swinburne roundels include John Davidson, Ernest Dowson, and Sara Teasdale)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026074"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026075", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSensation fiction", "identifiers:lccn": "gf2019026075", "madsrdf:adminMetadata": [{"@id": "_:n058a204f660347ceb8f11e9cadd79dccb1"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sensation fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n058a204f660347ceb8f11e9cadd79dccb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n058a204f660347ceb8f11e9cadd79dccb5"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb6"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb7"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb8"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb9"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb10"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb11"}], "madsrdf:hasVariant": {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Victorian fiction that featured scandals, including crimes and social improprieties."}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-31T10:14:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sensation fiction"}}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 4-6 (stories of murder, divorce, seduction, or bigamy; a mystery and a secret; along with its popularity, the sensation mode appeared equally remarkable for its novelty, its recognizable status as an authentically new fictional form; brash, vulgar, and subversive)"}, "madsrdf:citationSource": "Hughes, W. The maniac in the cellar : sensation novels of the 1860s, \u00a91980:", "madsrdf:citationStatus": "found"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (the sensation novel; the sensation genre) p. 4 of cover (In 1860, Wilkie Collins's The Woman in White spearheaded the popular genre of sensation fiction--a genre that repeatedly portrayed women in the throes of crime and insanity)"}, "madsrdf:citationSource": "Mangham, A. Violent women and sensation fiction, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (sensation fiction) pp. 2-4 (the first sensation novel, The Woman in White, published in Dickens's All the Year Round from 1859 to 1860; sensation novels were named after the contemporary theatre's \"sensation drama\"; sensation fiction dominated the market in the 1860s)"}, "madsrdf:citationSource": "Rance, N. Wilkie Collins and other sensation novelists, 1991:", "madsrdf:citationStatus": "found"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Introduction to Margaret Bullock's Utu: a story of love, hate and revenge / by Vicki Hughes (Deceit, revenge, murder, incest, cannibalism and false identities, Margaret Bullock's Utu: A Story of Love, Hate and Revenge has it all. Bullock was asked by her publisher make the novel \"as sensational as possible\" and she certainly took that advice and followed it through. Sensationalist literature was at its peak during the 1860's in Victorian England, Bullock took a genre that was known for its mad women, \"bigamy, illegitimacy, drug abuse, murder, inheritance scandals, and adultery\" (Fantina and Harrison), added an historical element and then brought the novel \"down under\" for its dramatic conclusion; sensationalist novels)"}, "madsrdf:citationSource": "Work cat.: Tua-o-rangi. Utu, 1894, via New Zealand Electronic Text Collection, viewed May 20, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sensation, novel of: An enormously popular genre of fiction that flourished from c.1860 onwards. It relocated the terrors of the Newgate and Gothic novel to a recognizably modern, middle-class England. Its high-impact narrative style employed cliffhanging conclusions to chapters, which gave the genre a reputation for \"preaching to the nerves\". Its plots commonly involved guilty family secrets, bigamy, arson, adultery, insanity, forgery, and murder (especially poisoning), often taking inspiration from real criminal cases. This accounts for an intense interest in legal papers, telegrams, diary entries, and written testimony. Indeed, many of Wilkie Collins's sensation novels represent themselves as bundles of documents authored by witnesses in the case. The genre was also noted for its energetic--and frequently criminal--heroines, and for its enervated, hypersensitive heroes. The most influential works in the genre are Wilkie Collins's The Woman in White (1860) and The Moonstone (1868); Ellen Wood's East Lynne (1861); Mary Braddon's Lady Audley's Secret (1862); Charles Reade's Hard Cash (1863); and Sheridan Le Fanu's Uncle Silas (1864). The novels of Rhoda Broughton and Ouida are usually considered to be on the margins of the genre. Most mid-Victorian novelists show some traces of its influence, including Thomas Hardy, Charles Dickens, George Eliot, and Anthony Trollope. Detective fiction can trace its roots back to sensation fiction)"}, "madsrdf:citationSource": "The Oxford companion to English literature, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sensation novel: A kind of novel that flourished in Britain in the 1860s, exploiting the element of suspense in stories of crime and mystery. The most successful examples are Wilkie Collins's The Woman in White (1860), Mary Elizabeth Braddon's Lady Audley's Secret (1862), and J. Sheridan Le Fanu's Uncle Silas (1864). The sensation novel has been seen as an early kind of thriller in that it exposes dark secrets and conspiracies, but is distinguished from the classic detective story by its lack of a central detective figure.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. ix (sensation fiction was the literary rage in mid-nineteenth century Britain; often involving themes such as bigamy, illegitimacy, drug abuse, murder, inheritance scandals, and adultery; Victorian critics frequently viewed sensation fiction as an inherently scandalous genre. They decried the controversial content along with the physical and emotional sensations such content produced; sensation novels were frequently best sellers) p. xii (Works within the sensation genre have often been described as \"novels with a secret.\" Involving mysteries, murders, and social improprieties usually within the respectable middle class or aristocratic home, the novels capitalized on the Victorian public's appetite for scandal; narratives that questioned the sanctity of the family and the stability of middle-class mores; also frequently challenged the stability of individual identity; frequently described as being \"plot-driven\" as opposed to \"character-driven\")"}, "madsrdf:citationSource": "Victorian sensations : essays on a scandalous genre, \u00a92006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n058a204f660347ceb8f11e9cadd79dccb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sensationalist fiction"}}, {"@id": "_:n058a204f660347ceb8f11e9cadd79dccb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sensationalist fiction"}}], "@id": "/authorities/genreForms/gf2019026075"}
