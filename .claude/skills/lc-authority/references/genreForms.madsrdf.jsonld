lue": "Radio interviews"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio interviews"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Interviews (Sound recordings)"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Interviews (Sound recordings)"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(interviews. Statements, transcripts, or recordings of conversations in which one person obtains information from another such as for research purposes, publication, or broadcast.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 50 (interview: conversation between journalist and person; oral examination for employment)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(interview: A discussion between a reporter, host, panel, or audience and a newsmaker, author, or celebrity, recorded (edited or unedited) in print, on film or video, or as a sound recording.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Interviews. BT Discoursive works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio interviews"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio interviews"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Interview transcripts"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Interview transcripts"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television interviews"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television interviews"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed interviews"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed interviews"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Interviews (Sound recordings)"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Interviews (Sound recordings)"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Transcripts, Interview"}}, {"@id": "_:n817c577a9715457cbb7c4f48c8dd1509b37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transcripts, Interview"}}], "@id": "/authorities/genreForms/gf2014026115"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026116", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJigsaw puzzles", "identifiers:lccn": "gf2014026116", "madsrdf:adminMetadata": [{"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b1"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jigsaw puzzles"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027266"}], "madsrdf:hasSource": [{"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b5"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b6"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b7"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b8"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b9"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b10"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b11"}], "madsrdf:hasVariant": [{"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b12"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b15"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:46:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jigsaw puzzles"}}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jigsaw puzzles. UF Picture puzzles (Jigsaw puzzles). BT Puzzles)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(jigsaw puzzle: A type of puzzle introduced in 1739, originally called a \"dissected puzzle\" because its flat image-bearing surface is cut into pieces of various shapes that can be disassembled. Once the loose pieces have been mixed up, the challenge lies in reassembling them into the complete image. Jigsaw puzzles were originally made of wood, usually for children and in a limited number of pieces, but in 1934, when manufacturers began making them from die-cut cardboard, the number of pieces increased and the price dropped significantly, making them a common household pastime for children and adults)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(jigsaw puzzles. UF jig-saw puzzles; jigsaws (puzzles). Puzzles of irregularly shaped and tightly interlocking pieces of pasteboard or wood that when fitted together typically form pictures or designs; name derived in the 20th century from the type of saw used to create the intricate cutouts)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jigsaw Puzzle: A unit of extent of three-dimensional form consisting of a picture usually on pasteboard or wood, which has been cut into interlocking shapes intended to be re-assembled)"}, "madsrdf:citationSource": "RDA glossary, viewed July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jigsaw puzzles. BT Puzzles)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(jigsaw puzzle, any set of varied, irregularly shaped pieces that, when properly assembled, form a picture or map. The puzzle is so named because the picture, originally attached to wood and later to paperboard, was cut into its pieces with a jigsaw, which cuts intricate lines and curves)"}, "madsrdf:citationSource": "Britannica online, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(jigsaw puzzle: a puzzle consisting of small irregularly cut pieces that are to be fitted together to form a picture; picture puzzle: jigsaw puzzle)"}, "madsrdf:citationSource": "Merriam-Webster online, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Picture puzzles (Jigsaw puzzles)"}}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picture puzzles (Jigsaw puzzles)"}}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jigsaws (Puzzles)"}}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jigsaws (Puzzles)"}}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jig-saw puzzles"}}, {"@id": "_:nb0f7b920aca540c1a0c3c8cab2d33469b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jig-saw puzzles"}}], "@id": "/authorities/genreForms/gf2014026116"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026117", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJob descriptions", "identifiers:lccn": "gf2014026117", "madsrdf:adminMetadata": [{"@id": "_:n92a3d51a4ceb448488d56f47580b347bb1"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Job descriptions"}, "madsrdf:elementList": {"@list": [{"@id": "_:n92a3d51a4ceb448488d56f47580b347bb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:n92a3d51a4ceb448488d56f47580b347bb5"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb6"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb7"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb8"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb9"}], "madsrdf:hasVariant": [{"@id": "_:n92a3d51a4ceb448488d56f47580b347bb10"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb13"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Job descriptions"}}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Job description. A job description is a list that a person might use for general tasks, or functions, and responsibilities of a position. It may often include to whom the position reports, specifications such as the qualifications or skills needed by the person in the job, or a salary range. Job descriptions are usually narrative, but some may instead comprise a simple list of competencies; for instance, strategic human resource planning methodologies may be used to develop a competency architecture for an organization, from which job descriptions are built as a shortlist of competencies.)"}, "madsrdf:citationSource": "Wikipedia, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Chapter 3, Appendix 3C - What every supervisor should know about position descriptions (What is a Position Description? State statutes define a position as a \"group of duties and responsibilities...which require the services of an employee on a part-time or full-time basis.\" A position description (PD) is a structured document assigning work to a given position as it is expected to be performed after customary orientation and training. It will tell the reader what the worker is responsible for doing, how it is done, and how it relates to other positions within and outside the work unit. The PD should accurately and completely describe the permanent duties and responsibilities that are assigned and performed. Position descriptions are not intended to cover every kind of work assignment a position may have. Rather, they cover those work assignments which are predominant, permanent and recurring.)"}, "madsrdf:citationSource": "Policies and procedures for classified employees, via University of Wisconsin-Madison Office of Human Resources website, Aug. 5, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(job description: A detailed description of the duties and responsibilities associated with a specific position in an organization, used in training, performance evaluation, and the allocation of workload. Compare with position description; position description: A written statement providing a general description of the duties and responsibilities associated with a specific position in an organization, the minimum qualifications considered necessary for satisfactory performance, and the rank, compensation, and benefits that the prospective employer is prepared to offer, for use in hiring.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(When comparing job description vs. job specification, the former defines the duties, tasks, and responsibilities of a job and the latter lists the required skills, qualification, and experience required to do the job. Both are essential in hiring candidates that will make a good fit.)"}, "madsrdf:citationSource": "Nayab, N. Reviewing job particulars : specification vs. description, via WWW, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Job description includes basic job-related data that is useful to advertise a specific job and attract a pool of talent. It includes information such as job title, job location, reporting to and of employees, job summary, nature and objectives of a job, tasks and duties to be performed, working conditions, machines, tools and equipments to be used by a prospective worker and hazards involved in it. Job Specification: Also known as employee specifications, a job specification is a written statement of educational qualifications, specific qualities, level of experience, physical, emotional, technical and communication skills required to perform a job, responsibilities involved in a job and other unusual sensory demands. It also includes general health, mental health, intelligence, aptitude, memory, judgment, leadership skills, emotional ability, adaptability, flexibility, values and ethics, manners and creativity, etc.)"}, "madsrdf:citationSource": "Job description and job specification, via Management Study Guide website, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n92a3d51a4ceb448488d56f47580b347bb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Job specifications"}}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Job specifications"}}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n92a3d51a4ceb448488d56f47580b347bb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Occupational descriptions"}}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Occupational descriptions"}}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n92a3d51a4ceb448488d56f47580b347bb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Position descriptions"}}, {"@id": "_:n92a3d51a4ceb448488d56f47580b347bb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Position descriptions"}}], "@id": "/authorities/genreForms/gf2014026117"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026118", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKenKen puzzles", "identifiers:lccn": "gf2014026118", "madsrdf:adminMetadata": [{"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b1"}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "KenKen puzzles"}, "madsrdf:elementList": {"@list": [{"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, "madsrdf:hasSource": [{"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b5"}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b6"}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b7"}], "madsrdf:hasVariant": [{"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b8"}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b11"}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "KenKen puzzles"}}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(KenKen; math puzzles) about (it's a grid-based numerical puzzle that uses the basic math operations--addition, subtraction, multiplication, and division--while also challenging your logic and problem-solving skills. By altering the size of a KENKEN grid, from 3 x 3 up to 9 x 9, and employing different combinations of the math operations, five different difficulty levels can be generated, and a seemingly endless number of puzzles.)"}, "madsrdf:citationSource": "KenKen puzzle official site, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(KenKen and KenDoku are trademarked names for a style of arithmetic and logic puzzle invented in 2004 by Japanese math teacher Tetsuya Miyamoto, who intended the puzzles to be an instruction-free method of training the brain. The names Calcudoku and Mathdoku are sometimes used by those who don't have the rights to use the KenKen or KenDoku trademarks. As in sudoku, the goal of each puzzle is to fill a grid with digits--1 through 4 for a 4x4 grid, 1 through 5 for a 5x5, etc.--so that no digit appears more than once in any row or any column (a Latin square). Grids range in size from 3x3 to 9x9. Additionally, KenKen grids are divided into heavily outlined groups of cells--often called \"cages\"--and the numbers in the cells of each cage must produce a certain \"target\" number when combined using a specified mathematical operation (either addition, subtraction, multiplication or division).)"}, "madsrdf:citationSource": "Wikipedia, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(KENKEN\u00ae Puzzles)"}, "madsrdf:citationSource": "New York times crosswords & games website, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Calcudoku puzzles"}}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Calcudoku puzzles"}}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mathdoku puzzles"}}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mathdoku puzzles"}}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "KenDoku puzzles"}}, {"@id": "_:nad5f9b4f2cd548039eaf38678d5aba37b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "KenDoku puzzles"}}], "@id": "/authorities/genreForms/gf2014026118"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026119", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKnock-knock jokes", "identifiers:lccn": "gf2014026119", "madsrdf:adminMetadata": [{"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b1"}, {"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Knock-knock jokes"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026157"}, "madsrdf:hasSource": [{"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b5"}, {"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b6"}, {"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Knock-knock jokes"}}, {"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The knock-knock joke is a type of joke, probably the best-known format of the pun, and is a time-honored \"call and response\" exercise. It is a role-play exercise, with a punster and a recipient of wit. The standard format has five lines: The punster: Knock, knock! The recipient: Who's there? The punster: a variable response, sometimes involving a name (Doctor.) The recipient: a repetition of the response followed by who? (Doctor who?) The punster: the punch line, which typically involves a pun-based misusage of the word set up during the response (How did you know?))"}, "madsrdf:citationSource": "Wikipedia, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Unlike many jokes that are monologues told with care by the jokester, knock-knock jokes engage the jokester and the audience in a dialogue. There are many different jokes of this type, but there are some shared characteristics. Formula. All knock-knock jokes have five lines. The first two lines are always the same: Jokester: Knock-knock. Audience: Who's there? This exchange is followed by another pair of lines. In the third line, the jokester gives a partial answer which is a real English word and generally makes some sense. In the fourth line, the audience repeats the answer of the third line and adds the question, \"who?\" like this: Jokester: Sam and Janet. Audience: Sam and Janet who? In the final line, the jokester almost always makes a pun on the answer in the third line by adding a subsequent word or phrase that transforms the meaning because it sounds like something else. The closing line to the knock-knock joke we're using as an example is: Jokester: Sam and Janet evening.)"}, "madsrdf:citationSource": "What is a knock-knock joke?, via wiseGEEK website, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b0f2327bdd64cd6bcfae242152dc9e9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(knock-knock joke: a type of joke that depends on the way in which some words in English sound like other words. The person telling the joke says 'Knock-knock', someone answers 'Who's there?', and the first person says a name which isn't what it seems. A typical example might be: 'Knock-knock.' 'Who's there?' 'Lucy.' 'Lucy who?' 'Lucy Lastic (= loose elastic)')"}, "madsrdf:citationSource": "Oxford learner's dictionaries website, Aug. 5, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026119"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026120", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLaboratory manuals", "identifiers:lccn": "gf2014026120", "madsrdf:adminMetadata": [{"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab1"}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Laboratory manuals"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026109"}, "madsrdf:hasSource": [{"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab5"}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab6"}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab7"}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab8"}], "madsrdf:hasVariant": {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Laboratory manuals"}}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Laboratory Manuals. BT Guides; Instructional Materials)"}, "madsrdf:citationSource": "ERIC thesaurus, via WWW, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Laboratory Manuals [Publication Type]. Works containing concise background information and directions for activities, including conducting experiments or diagnostic tests in the laboratory.)"}, "madsrdf:citationSource": "MeSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lab manual: A book of exercises that includes instructions for laboratory experiments to be carried out, usually under the supervision of an instructor, by a student enrolled in a course in the sciences, often published in softcover in conjunction with a textbook.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Laboratory manuals USE subdivision Laboratory manuals under scientific and technical headings for workbooks containing concise background information and directions for performing work, including experiments, in the laboratory, e.g. Cancer--Diagnosis--Laboratory manuals; Radio--Laboratory manuals)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lab manuals"}}, {"@id": "_:nfbde53df82e14b70b4e3ea5f036a863ab10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lab manuals"}}], "@id": "/authorities/genreForms/gf2014026120"}
