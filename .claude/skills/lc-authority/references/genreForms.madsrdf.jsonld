{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026081", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aInfographics", "identifiers:lccn": "gf2023026081", "madsrdf:adminMetadata": [{"@id": "_:nf81e77bc72e24337b0cff4410de26909b1"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Infographics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf81e77bc72e24337b0cff4410de26909b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:nf81e77bc72e24337b0cff4410de26909b5"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b6"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b7"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b8"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b9"}], "madsrdf:hasVariant": {"@id": "_:nf81e77bc72e24337b0cff4410de26909b10"}, "madsrdf:historyNote": "[Established November 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/caoonl"}, "ri:recordStatus": "new"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Infographics"}}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 11-627-M Infographics (Every year, Statistics Canada collects data from hundreds of surveys. As the amount of data gathered increases, Statistics Canada has introduced infographics to help people, business owners, academics, and management at all levels, understand key information derived from the data. Infographics can be used to quickly communicate a message, to simplify the presentation of large amounts of data, to see data patterns and relationships, and to monitor changes in variables over time)"}, "madsrdf:citationSource": "Statistics Canada website, viewed August 11, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the resource is a one-pager featuring statistical, graphical, cartographic, and textual content) (OCLC)1381253147"}, "madsrdf:citationSource": "Work cat.: Preparing for weather-related emergencies in Canada, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(infographic: a visual image such as a chart or diagram used to represent information or data in an easily understandable form)"}, "madsrdf:citationSource": "Oxford English dictionary online, viewed August 11, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(infographics (information graphics): 1. Graphical representations of concepts, or of patterns in data or information. 2. In social media, graphical content effectively illustrating a concept relevant to a target audience, designed to attract attention, generate engagement, earn links, and improve search engine ranking)"}, "madsrdf:citationSource": "Chandler, D. A dictionary of media and communication, 3rd ed., viewed July 27, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Art & architecture thesaurus online, consulted August 11, 2023.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf81e77bc72e24337b0cff4410de26909b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Information graphics"}}, {"@id": "_:nf81e77bc72e24337b0cff4410de26909b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Information graphics"}}], "@id": "/authorities/genreForms/gf2023026081"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026088", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBroadsides", "identifiers:lccn": "gf2023026088", "madsrdf:adminMetadata": [{"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab1"}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Broadsides"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab5"}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab6"}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab7"}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab8"}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab9"}], "madsrdf:historyNote": "[Established November 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-25T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/uk"}, "ri:recordStatus": "new"}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Broadsides"}}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Rice, F. The thing is, 2020.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "publications list (Broadside: The thing is, a poem by Ellen Bass, drawing by Felicia Rice)"}, "madsrdf:citationSource": "Moving Parts Press website, viewed 25 August 2023 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstract (an annotated listing of all broadsides related to science held by the American Philosophical Society; Broadsides represent a largely untapped resource for historians of eighteenth- and nineteenth-century science, technology, and medicine; issued as handbills, circular letters, book and journal prospectuses, bills of mortality, meteorological tables, announcements of prizes, notices of lectures, membership and subscription lists, meeting notification cards, certificates of membership, tickets to lectures, etc.)"}, "madsrdf:citationSource": "American Philosophical Society broadsides collection: science broadsides website, viewed 25 August 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Broadside: originally, a large sheet of paper printed across one side only, intended to be read unfolded or posted bearing a royal proclamation or official notice, but later used to disseminate news or political views; the Declaration of Independence was first printed on July 4, 1776 by John Dunlap of Philadelphia in what has become known as the Dunlap Broadside; also used in 16th-century England to distribute ballads and other poems; in modern usage, a separately published item consisting of a large sheet printed on one or both sides, folded down the center for mailing and meant to be read unfolded; sometimes restricted to a sheet on which the text is printed from side to side across the fold; also refers to the substance of the matter printed in such a format)"}, "madsrdf:citationSource": "ODLIS - Online Dictionary for Library and Information Science, viewed 25 August 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e41e51186f6411a8ebadeff23ae2efab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "vocabularies, genre terms (Broadsides - use for separately published pieces of paper or other material, printed and intended to be read unfolded; usually intended to be posted, publicly distributed, or sold, e.g., proclamations, handbills, ballad sheets, newssheet)"}, "madsrdf:citationSource": "RBMS website, viewed 25 August 2023 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2023026088"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026089", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPublic health surveillance reports", "identifiers:lccn": "gf2023026089", "madsrdf:adminMetadata": [{"@id": "_:n152c989ed01f45da9aa2cc1666731778b1"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Public health surveillance reports"}, "madsrdf:elementList": {"@list": [{"@id": "_:n152c989ed01f45da9aa2cc1666731778b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n152c989ed01f45da9aa2cc1666731778b5"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b6"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b7"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b8"}], "madsrdf:hasVariant": [{"@id": "_:n152c989ed01f45da9aa2cc1666731778b9"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b12"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b15"}], "madsrdf:historyNote": "[Established November 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/clu"}, "ri:recordStatus": "new"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Public health surveillance reports"}}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Surveillance Reports, Listed below are existing surveillance reports developed by various programs... (https://www.cdc.gov/surveillancepractice/reports.html) About the CDC Surveillance Resource Center, The Surveillance Resource Center provides members of the public health surveillance community organized, easy access to guidance developed by CDC and its partners for improving the practice of surveillance. Public health surveillance refers to the collection, analysis, and use of data to target public health prevention. It is the foundation of public health practice. (https://www.cdc.gov/surveillancepractice/about.html)"}, "madsrdf:citationSource": "Centers for Disease Control and Prevention, online, August 14, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC) 879651620"}, "madsrdf:citationSource": "Work cat: San Francisco Department of Public Health, HIV semi-annual surveillance report.", "madsrdf:citationStatus": "found"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Periodic Publications and Surveillance Reports, APHC publishes several periodicals and surveillance reports on a regular schedule... (https://phc.amedd.army.mil/news/Pages/PeriodicPublications.aspx)"}, "madsrdf:citationSource": "Defense Centers for Public Health--Aberdeen, online, August 14, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Disease surveillance reports: ECDC collects, analyses and disseminates surveillance data on communicable diseases and related special health issues from all European Union Member States and two of the three remaining European Economic Area (EEA) countries (Iceland and Norway). Introduction to the Annual Epidemiological Report, All disease surveillance reports in the Annual Report series draw on data retrieved from TESSy. This disease surveillance report presents an overview of the epidemiological situation for communicable diseases and related health issues that are under European Union (EU) and European Economic Area (EEA) surveillance [2],[3],[4],[5]. (https://www.ecdc.europa.eu/en/surveillance-and-disease-data/annual-epidemiological-reports/introduction-annual)"}, "madsrdf:citationSource": "European Centre for Disease Prevention and Control, online, August 14, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n152c989ed01f45da9aa2cc1666731778b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surveillance reports, Public health"}}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surveillance reports, Public health"}}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n152c989ed01f45da9aa2cc1666731778b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Disease surveillance reports"}}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Disease surveillance reports"}}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n152c989ed01f45da9aa2cc1666731778b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epidemiological reports"}}, {"@id": "_:n152c989ed01f45da9aa2cc1666731778b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epidemiological reports"}}], "@id": "/authorities/genreForms/gf2023026089"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026091", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDance", "identifiers:lccn": "gf2023026091", "madsrdf:adminMetadata": [{"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b1"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dance"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b3"}]}, "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b5"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b8"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026113"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026114"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026118"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026127"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026131"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026132"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026134"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026137"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026008"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026067"}], "madsrdf:hasSource": [{"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b11"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b12"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b13"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b14"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b15"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b16"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b17"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b18"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b19"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b20"}], "madsrdf:hasVariant": [{"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b21"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b24"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b27"}], "madsrdf:historyNote": "[Established May 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": ["Dances from any tradition that are not of a more specific genre/form.", "Heading changed from Filmed dance and Televised dance to Dance in May 2024."]}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-05-22T14:04:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "new"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dance"}}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed dance"}}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed dance"}}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised dance"}}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised dance"}}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dance: UF Dances, Dancing [Former heading]; Dances, USE Balls (Parties), Dance, Dance parties)"}, "madsrdf:citationSource": "LCSH, viewed September 15, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dance; the movement of the body in a rhythmic way, usually to music and within a given space, for the purpose of expressing an idea or emotion, releasing energy, or simply taking delight in the movement itself)"}, "madsrdf:citationSource": "Britannica online, viewed August 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dance. Use for films or video used to record the performance of dance)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(preferred term: dance (performing arts genre); alternate descriptor: dancing (performing arts genre))"}, "madsrdf:citationSource": "AAT, viewed September 15, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Performances taped at the Meany Theatre, and the Meany Studio Theater, University of Washington)"}, "madsrdf:citationSource": "Chamber Dance Company archive [VR] / the Chamber Dance Company, University of Washington Dance Program, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dance. Nonfiction work primarily concerned with dance, dancers, and choreography, including types of dance such as ballet, jazz, modern, ballroom, tap, folk, ethnic, and vaudeville. Dance work may be biographical, ethnographic, educational, or instructional in nature)"}, "madsrdf:citationSource": "Moving image genre/form guide, via WWW, Oct. 8, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (being a collection of figure dances, of several numbers, compos'd by the most eminent masters; describ'd in characters after the newest manner of Monsieur Feuillet)"}, "madsrdf:citationSource": "An essay for the further improvement of dancing, 1711:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Originally aired on TVRI in the 1990s)"}, "madsrdf:citationSource": "Ratna Mangali Katundung [VR] 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (Mr. Isaac's new dance made for Her Majestys birth day; engraven in characters & figures for the use of masters)"}, "madsrdf:citationSource": "Work cat: The princess, 1710?:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dance: A rhythmical skipping and stepping, with regular turnings and movements of the limbs and body, usually to the accompaniment of music; either as an expression of joy, exultation, and the like, or as an amusement or entertainment; the action or an act or round of dancing; A definite succession or arrangement of steps and rhythmical movements constituting one particular form or method of dancing)"}, "madsrdf:citationSource": "Oxford English Dictionary online viewed September 15, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised dance"}}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised dance"}}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dances"}}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dances"}}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed dance"}}, {"@id": "_:n9e74b3592c6b440490a39fe1dc6c4f48b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed dance"}}], "@id": "/authorities/genreForms/gf2023026091"}
