 {"@id": "_:n67c7e56f942e4beaa82e7691998d5480b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stoner rock (Music)"}}, {"@id": "_:n67c7e56f942e4beaa82e7691998d5480b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(genre not given)"}, "madsrdf:citationSource": "Work cat: Highbinder (Musical group). ...All the way to hell, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:n67c7e56f942e4beaa82e7691998d5480b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Stoner metal (\"Stoner metal bands updated the long, mind-bending jams and ultra-heavy riffs of bands like Black Sabbath, Blue Cheer, Blue Oyster Cult, and Hawkwind by filtering their psychedelia-tinged metal and acid rock through the buzzing sound of early SubPop-style grunge\")"}, "madsrdf:citationSource": "AllMusic WWW site, June 7, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n67c7e56f942e4beaa82e7691998d5480b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Stoner rock (\"also known as stoner metal or stoner doom is a rock music fusion genre that combines elements of heavy metal music and/or doom metal with psychedelic rock and acid rock. The name references cannabis consumption\")"}, "madsrdf:citationSource": "Wikipedia, Nov. 8, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n67c7e56f942e4beaa82e7691998d5480b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Highbinder - ...All the way to hell (stoner rock)"}, "madsrdf:citationSource": "Discogs WWW site, June 7, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n67c7e56f942e4beaa82e7691998d5480b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n67c7e56f942e4beaa82e7691998d5480b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stoner doom (Music)"}}, {"@id": "_:n67c7e56f942e4beaa82e7691998d5480b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stoner doom (Music)"}}, {"@id": "_:n67c7e56f942e4beaa82e7691998d5480b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n67c7e56f942e4beaa82e7691998d5480b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stoner metal (Music)"}}, {"@id": "_:n67c7e56f942e4beaa82e7691998d5480b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stoner metal (Music)"}}], "@id": "/authorities/genreForms/gf2018026153"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026154", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTime-travel films", "identifiers:lccn": "gf2018026154", "madsrdf:adminMetadata": [{"@id": "_:n260aec678deb459aa0b8fd1e52250a0db1"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Time-travel films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n260aec678deb459aa0b8fd1e52250a0db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026556"}, "madsrdf:hasSource": [{"@id": "_:n260aec678deb459aa0b8fd1e52250a0db5"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db6"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db7"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db8"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db9"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db10"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db11"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db12"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db13"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db14"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db15"}], "madsrdf:hasVariant": {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db16"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-04-15T12:19:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Time-travel films"}}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Science Fiction Film: Time Travel Films. One of the pet subjects of science fiction is to be able to displace oneself in time in order to observe the past or the future; Examples: World Without End; The Time Machine; The Time Travellers; Time After Time; The Final Countdown; Terminator; Back to the Future; Star Trek IV: The Voyage Home; Time Trackers)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The power of a quality time loop movie is actually wanting to hit play on the film again once it ends, even though the plot revolves around the same event again and again)"}, "madsrdf:citationSource": "El-Mahmoud, S. 10 awesome time loop movies to watch after Palm Springs, via Cinema blend website, posted Jul. 14. 2020, viewed Feb. 8, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 115 (time travel-based science fiction films) p. 116 (Since 1979, there has been a proliferation of time travel films, including Time After Time (1979), Somewhere in Time (1980), The Final Countdown (1980), Time Bandits (1981), Timerider (1983), Twilight Zone: The Movie (1983), The Philadelphia Experiment (1984), The Terminator (1984), Trancers (1985), Back to the Future (1985), My Science Project (1985), the made-for-television movies The Blue Yonder (1986) and Outlaws (1986), and, most recently, Peggy Sue Got Married (1986), Flight of the Navigator (1986) and Star Trek IV (1987))"}, "madsrdf:citationSource": "Liquid metal : the science fiction film reader, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a film featuring time travel; summary: Soo-hyun comes across magical pills that allow him to go back and forth in time. 30 years earlier, a young Soo-hyun meets his future self and learns that his girlfriend will soon die because of him. In order to save her, the two Soo-hyuns try to change the past, but a completely new and unexpected past is formed, which leads to a new future.)"}, "madsrdf:citationSource": "Work cat.: Tangsin, k\u014fgi iss\u014f chullaeyo, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(drama that follows two strangers who meet at a Palm Springs wedding only to get stuck in a time loop) (OCoLC)1199383508"}, "madsrdf:citationSource": "Palm Springs, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the time loop has become a storytelling tool used by countless creators in the service of unique stories; Palm Springs is kind of a perfect time loop movie. The film puts a twist on the time loop formula by starting with Andy Samberg's character having already been stuck in the loop for a very, very long time. The day he's reliving over and over again is at a wedding in Palm Springs, and one night the bride's sister accidentally gets sucked into the time loop with him; Groundhog Day; Edge of Tomorrow; The Endless; Happy Death Day; The Incredible Shrinking Wknd; Run Lola Run)"}, "madsrdf:citationSource": "The best time loops of film, TV, and video games, via WWW, Feb. 8, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Here, you'll find a list of time loop movies if you're in the mood to see a character try to get things just right while repeating the same day. Movies where the same day repeats over and over again allow you to watch how characters recognize their mistakes and attempt to rectify them. In many ways, time loop movies provide the ultimate fantasy. Don't we all wish we could sometimes go back and undo past errors and indiscretions?\"; films that feature time loops or characters repeating the same events)"}, "madsrdf:citationSource": "The best time loop movies, via Ranker website, updated July 13, 2020, viewed Feb. 8, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 40 (Time travel films) p. 168 (cinema's most iconic time travel films, such as The Terminator (1984), Back to the Future (1985), and The Time Machine (1960))"}, "madsrdf:citationSource": "Time travel in popular media, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a movie that repeats itself every day; the time loop is less of a trope or device and more of a sub-genre)"}, "madsrdf:citationSource": "Aldredge, J. The ins and outs and ins and outs of creating a time loop film, via PremiumBeat website, Aug. 17, 2020, viewed Feb. 8, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 10 (time-travel films)"}, "madsrdf:citationSource": "A time travel dialogue, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(drama about a cynical television weatherman covering the annual Groundhog Day event in Punxsutawney, Pennsylvania, who becomes trapped in a time loop forcing him to relive February 2 repeatedly) (OCoLC)190702399"}, "madsrdf:citationSource": "Groundhog Day, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n260aec678deb459aa0b8fd1e52250a0db17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Time loop films"}}, {"@id": "_:n260aec678deb459aa0b8fd1e52250a0db17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Time loop films"}}], "@id": "/authorities/genreForms/gf2018026154"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026155", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMagic realist films", "identifiers:lccn": "gf2018026155", "madsrdf:adminMetadata": [{"@id": "_:n5652bd4728d74b03937989088fcd218ab1"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Magic realist films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5652bd4728d74b03937989088fcd218ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n5652bd4728d74b03937989088fcd218ab5"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab6"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab7"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab8"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab9"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab10"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab11"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab12"}], "madsrdf:hasVariant": [{"@id": "_:n5652bd4728d74b03937989088fcd218ab13"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab16"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films in which fantastic or mythical elements are included in a narrative that is otherwise realistic."}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-02-21T10:27:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magic realist films"}}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 107 (magical realist film) p. 255 (magic realist films) p. 277 (magical realist cinema)"}, "madsrdf:citationSource": "Gee, F.C. The critical roots of cinematic magic realism, 2013, via WWW, Nov. 13, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a magic realist film)"}, "madsrdf:citationSource": "Work cat.: Laberinto del fauno (Motion picture). El laberinto del fauno = Pan's labyrinth, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 107 (magical realist films)"}, "madsrdf:citationSource": "P\u00e9rez Melgosa, A. Cinema and inter-American relations, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (magic realism; combination of realism and fantasy) p. 7 (magic realism (or magical realism or marvelous realism)) p. 13 (magic realist movies) p. 18 (magic realism films)"}, "madsrdf:citationSource": "Hurley, J.S. Magic realism in cinema, 2013, via WWW, Nov. 13, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xv (Guillermo del Toro, who has successfully managed a Hollywood career with his Hellboy comic book character films (2004, 2008) and two magical realism films about the Spanish Civil War, The Devil's Backbone (2001) and Pan's Labyrinth (2006))"}, "madsrdf:citationSource": "Kolker, R.P. The altering eye, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xiii (magic realist films)"}, "madsrdf:citationSource": "Skrodzka, A. Magic realist cinema in East Central Europe, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab11", "@type": "madsrdf:Source", "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(magic realism; literary genre or style associated especially with Latin America that incorporates fantastic or mythical elements into otherwise realistic fiction; the genre has made its way into other art forms such as film; Magic realism--or magical realism--is most effective when it's blended so seamlessly into reality that viewers don't bother to try to figure what's behind the magic; films listed include: Pan's Labyrinth; Beasts of the Southern Wild; Big Fish; Trainspotting; Groundhog Day; The Life Aquatic with Steve Zissou; Donnie Darko; Pleasantville; Am\u00e9lie; Safety Not Guaranteed; Ruby Sparks; Jeff Who Lives at Home; Midnight in Paris; Scott Pilgrim vs. the World)"}, "madsrdf:citationSource": "V\u00e9lez, N. 20 great magical realism movies that are worth your time, via Taste of cinema website, 12 Feb. 2015, viewed on Nov. 13, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5652bd4728d74b03937989088fcd218ab14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magic realism films"}}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magic realism films"}}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5652bd4728d74b03937989088fcd218ab17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magical realist films"}}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magical realist films"}}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5652bd4728d74b03937989088fcd218ab20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magical realism films"}}, {"@id": "_:n5652bd4728d74b03937989088fcd218ab20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magical realism films"}}], "@id": "/authorities/genreForms/gf2018026155"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026157", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCapriccios (Music)", "identifiers:lccn": "gf2018026157", "madsrdf:adminMetadata": [{"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b1"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Capriccios (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b5"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b6"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b7"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b8"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b9"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b10"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b11"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b12"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b13"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b14"}], "madsrdf:hasVariant": [{"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b15"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b18"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b21"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-11-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-13T10:26:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Capriccios (Music)"}}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Capriccio/Caprice. In music, since the sixteenth century or so, capriccio has been used as a title for pieces that don't fit neatly in a category--lively pieces, usually, in which composers follow their imaginations, their whims, rather than strict rules)"}, "madsrdf:citationSource": "Hoffman, M. The NPR classical music companion, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "capriccio (1. Term applied to some 16th-cent. It. madrigals and, later, to a kind of free fugue for kbd instr, and later to any light quick comp. 2. In early 18th cent. sometimes used for 'cadenza'. 3. a capriccio means 'according to the fancy (caprice) of the performer', hence a comp. that has unexpected and orig. effects) caprice (see capriccio)"}, "madsrdf:citationSource": "The Oxford dictionary of music, 2013, via WWW, Nov. 26, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Goodman, J. Capricho goyesco : for B\u266d clarinet solo, \u00a91981.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Capriccietto (a short capriccio) Capriccio (s.), Capricci (pl.) (in the sixteenth century, a madrigal; in the early seventeenth century, a keyboard work often employing fugal imitation; in the late seventeenth and early eighteenth centuries, similar to a canzona, ricercar or toccata; from the nineteenth century, a quick, light, sometimes fanciful composition, a jeu d'esprit) Caprice (a quick, light, sometimes fanciful composition, capriccio) Capricho (caprice)"}, "madsrdf:citationSource": "Dolmetsch Music dictionary online, Nov. 26, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Clementi, M. Capriccios nos. 1 & 4, 2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Swisher, G.W. Caprichos : for guitar and piano, 1991.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(capriccio (It., 'whim', 'fancy'; Fr.: caprice 1. A term applied to a piece of music, vocal or instrumental, of a fantastical or capricious nature. Rousseau defined it in his dictionary (1768) as \"A kind of free music, in which the composer, without subjecting himself to any theme, gives loose rein to his genius, and submits himself to the fire of composition\"; capriccios; caprice: see capriccio)"}, "madsrdf:citationSource": "The Oxford companion to music, 2011, via WWW, Nov. 26, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Eckhardt-Gramatt\u00e9, S.C. 6 caprices for piano, \u00a91996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Zaimont, J.L. Capriccio for solo flute, \u00a92005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Capriccio(i) (It.: 'whim', 'fancy'; Fr. caprice). 'Capriccio' does not signify a specific musical technique or structure, but rather a general disposition towards the exceptional, the whimsical, the fantastic and the apparently arbitrary; capriccios; capricci; In 1834 Schumann defined the capriccio as \"a genre of music which is different from the 'low-comedy' burlesque in that it blends the sentimental with the witty. Often there is something \u00e9tude-like about it\")"}, "madsrdf:citationSource": "Grove music online, Nov. 26, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Caprichos (Music)"}}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Caprichos (Music)"}}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Caprices (Music)"}}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Caprices (Music)"}}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Capricciettos (Music)"}}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Capricciettos (Music)"}}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Capricci (Music)"}}, {"@id": "_:n0766f6aa498f4c85ba2402017baeeab8b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Capricci (Music)"}}], "@id": "/authorities/genreForms/gf2018026157"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026159", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNomenclatures", "identifiers:lccn": "gf2018026159", "madsrdf:adminMetadata": [{"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb1"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nomenclatures"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasSource": [{"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb5"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb6"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb7"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb8"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb9"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb10"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb11"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb12"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb13"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb14"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb15"}], "madsrdf:hasVariant": {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb16"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-14T14:15:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nomenclatures"}}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nomenclature: A nomenclature is a systematic naming of things or a system of names or terms for things. In classification, nomenclature involves a systemic naming of categories or items. The terms \"classification\" and \"nomenclature\" are often used interchangeably, despite the definition of a \"classification\" being broader than that of a \"nomenclature\". A nomenclature is essentially a convention for describing observations, whereas a classification structures and codifies the observations as well)"}, "madsrdf:citationSource": "OECD Glossary of statistical terms, via WWW, Dec. 4, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nomenclature: A systematic arrangement of the distinctive names employed in any science)"}, "madsrdf:citationSource": "McGraw-Hill dictionary of scientific and technical terms, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (399 available genus-group names in 69 families of Diptera are listed alphabetically, for each name giving author, year and page of original publication, originally included species, type species and method of fixation, current status of the name, family placement, and a list of any emendations of it that have been found in the literature)"}, "madsrdf:citationSource": "Evenhuis, N.L. Nomenclatural studies toward a World list of Diptera genus-group names. Part V, Pierre-Justin-Marie Macquart, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Scientific and standard English names of amphibians and reptiles of North America north of Mexico, with comments regarding confidence in our understanding, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Terminology. Annotation: This heading is used as a Publication Type. Scope Note: Work consisting of lists of the technical terms or expressions used in a specific field. These lists may or may not be formally adopted or sanctioned by usage. UF Nomenclature. SA Dictionary)"}, "madsrdf:citationSource": "MeSH, Dec. 4, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nomenclature 1. a set or system of names or terms, as those used in a particular science or art, by an individual or community, etc. 2. the names or terms comprising a set or system. Related forms: nomenclatural, nomenclatorial, nomenclative, adjective)"}, "madsrdf:citationSource": "Dictionary.com unabridged, Dec. 4, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Polymer Division. Compendium of polymer terminology and nomenclature, \u00a92009."}, "madsrdf:citationSource": "International Union of Pure and Applied Chemistry.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Tarjan, A.C. Nomenclatorial compilation of plant and soil nematodes, 1974.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nomenclature 1) name, designation. 2) the act or process or an instance of naming. 3 a) a system or set of terms or symbols especially in a particular science, discipline, or art b) an international system of standardized New Latin names used in biology for kinds and groups of kinds of animals and plants)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Dec. 4, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nomenclature: Set or system of official names, terms, or specialized vocabulary used in a particular area, discipline, or subject such as accounting, engineering, finance, law)"}, "madsrdf:citationSource": "BusinessDictionary.com, Dec. 4, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (family-group names of animals (superfamily, family, subfamily, supertribe, tribe and subtribe) are regulated by the International Code of Zoological Nomenclature; family names are particularly important because they are among the most widely used of all technical animal names; we list all of the family-group names found to date for Recent fishes)"}, "madsrdf:citationSource": "Laan, R.v.d. Family-group names of Recent fishes, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Terminologies"}}, {"@id": "_:nbf93c3edda8b42bfacfba9f0633a5dbcb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Terminologies"}}], "@id": "/authorities/genreForms/gf2018026159"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026161", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMasonic music", "identifiers:lccn": "gf2018026161", "madsrdf:adminMetadata": [{"@id": "_:ndb52a66c33464ed0ad516c85a7803072b1"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Masonic music"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndb52a66c33464ed0ad516c85a7803072b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasSource": [{"@id": "_:ndb52a66c33464ed0ad516c85a7803072b5"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b6"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b7"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b8"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b9"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b10"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b11"}], "madsrdf:hasVariant": [{"@id": "_:ndb52a66c33464ed0ad516c85a7803072b12"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music that is associated with the ritual and social functions of freemasonry."}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-14T14:15:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Masonic music"}}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Masonic music. Music used in connection with the ritual and social functions of freemasonry. A number of well-known composers ranging from William Boyce to late 20th-century figures have been freemasons, most notably Mozart, who made significant contributions to the repertory; To the uninitiated, music having masonic symbolism or implications, as well as music actually used in rituals, may be considered \"masonic\")"}, "madsrdf:citationSource": "Grove music online, Dec. 15, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Music for the ceremonies of the Masonic Order, 193-?", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Chard, G.W. A Masonic ode, 1817?", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Masonic music)"}, "madsrdf:citationSource": "LCSH, Dec. 15, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hart, A.F. Masonic music : containing music for Masonic ceremonies, 1930.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CD 20 (Freemason music)"}, "madsrdf:citationSource": "Mozart, W.A. Sacred works, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (\"Issued for Masonic use only\")"}, "madsrdf:citationSource": "Work cat.: Sibelius, J. Masonic ritual music, \u00a91950:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb52a66c33464ed0ad516c85a7803072b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Freemason music"}}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Freemason music"}}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb52a66c33464ed0ad516c85a7803072b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Masonic ritual music"}}, {"@id": "_:ndb52a66c33464ed0ad516c85a7803072b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Masonic ritual music"}}], "@id": "/authorities/genreForms/gf2018026161"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026162", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aObereks (Music)", "identifiers:lccn": "gf2018026162", "madsrdf:adminMetadata": [{"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb1"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Obereks (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb5"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb6"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb7"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb8"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb9"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb10"}], "madsrdf:hasVariant": [{"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb11"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-14T14:15:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Obereks (Music)"}}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Oberek (Oberek [plural given as obereks throughout], also known as obertas or ober; from the mazur family of Polish dances along with kujawiak and mazur; has also been called obertany, wyrwas, wykr\u0119tacz, drygant, zwijas, zwijacz, drobny, and okr\u0105g\u0142y)"}, "madsrdf:citationSource": "University of Southern California Polish Music Center WWW site, August 6, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "WSJP-Wielki s\u0142ownik j\u0119zyka polskiego online, December 18, 2018 (oberek, plural oberki; obertas, plural obertasy)", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (Royal flush - oberek; Dancing mood (Zachetny) - oberek; Give a kiss -- oberek; Frank's oberek; Duli-duli -- oberek)"}, "madsrdf:citationSource": "Work cat.: Koltowicz, Ted. Polkas, [date of publication not identified]:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "obertas (Polish round dance in quick triple meter and performed very vigorously, like a wild waltz; examples found in: Wieniawski's Mazurka Charact\u00e9ristique no. 1, Boito's Mefistofele Act 1, Chopin's Mazurka op. 56, no. 2 (in the style of an obertas), A. Tansman's Quatre Danses Polonaises for orchestra; name more commonly used today is oberek)"}, "madsrdf:citationSource": "Harvard Dictionary of Music, 2nd ed.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Oberek (Polish folk dance in triple time; rhythmic character similar to the Mazurka; term 'obertas' is first recorded by Adam Korczy\u0144ski; now preferred oberek)"}, "madsrdf:citationSource": "Grove Music Online, August 6, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Discotheque : Polish style. Vol. 2, 1965: disc label (\"Polkas, waltzes, obereks, Rheinlanders\")", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Obertasy (Music)"}}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Obertasy (Music)"}}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oberki (Music)"}}, {"@id": "_:n8d70cd14c7be40f0ab0ca6b831de22bbb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oberki (Music)"}}], "@id": "/authorities/genreForms/gf2018026162"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026163", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTientos (Art music)", "identifiers:lccn": "gf2018026163", "madsrdf:adminMetadata": [{"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b1"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tientos (Art music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b5"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b6"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b7"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b8"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b9"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b10"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b11"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-03-14T14:15:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tientos (Art music)"}}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(contents include: Tiento III / Antonio de Cabez\u00f3n; Tiento [16] de 4o tono / Francisco Correa de Arauxo; Tiento de 2o tono sobre la letan\u00eda de la Virgen / Pablo Bruna; Tiento [12] de falsas / Juan Cabanilles)"}, "madsrdf:citationSource": "Work cat.: Parkins, Robert. The Littlefield organ series, March 2, 2014, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tiento: (in 16th- and 17th-century Spanish music) a contrapuntal piece resembling a ricercar, originally for strings and later for organ)"}, "madsrdf:citationSource": "Oxford English dictionaries online, Dec. 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tiento plural -s: a 16th century Spanish pipe-organ composition having strict imitative counterpoint and resembling the ricercar)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Dec. 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tiento; term applied exclusively to instrumental music from the mid-15th century onwards, first in the Iberian peninsula and then in Latin America. Until the mid-16th century tientos were played on various instruments (ensembles, plucked strings, keyboard); from the end of the 16th century they were written chiefly for keyboard instruments, particularly the organ. 20th-century composers revived the form, writing tientos for ensembles or orchestras. The plural, tientos, also designates a flamenco genre for solo guitar)"}, "madsrdf:citationSource": "Grove music online, Dec. 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ohana, Maurice. Tiento : pour clavecin : original pour guitare, \u00a92000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cabanilles, Juan. Tiento 5th tono de falsas, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tiento; a musical genre originating in Spain in the mid-15th century. It is formally analogous to the fantasia (fantasy), found in England, Germany, and the Low Countries, and also the ricercare, first found in Italy. By the end of the 16th century the tiento was exclusively a keyboard form, especially of organ music. It continued to be the predominant form in the Spanish organ tradition through the time of Cabanilles, and developed many variants; formally extraordinarily diverse, more a set of guidelines than a rigid structural model such as fugue or rondo. Nearly all tientos are imitative to some degree, though not as complex or developed as the fugue; the earliest were stylistically quite close to the ricercare in their extended use of the strict, motet-style counterpoint. Later (especially in the works of Cabanilles), tientos would frequently alternate between the older style of strict counterpoint, and virtuosic, affective figuration typical of the toccata and some fantasias)"}, "madsrdf:citationSource": "Wikipedia, Dec. 18, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d49e5f0f8b84f2f999872e19bef94e5b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tiento: A Spanish Renaissance composition resembling the ricercare or the fantasia)"}, "madsrdf:citationSource": "OnMusic dictionary, via WWW, Dec. 18, 2018", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026163"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026002", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMachine plays", "identifiers:lccn": "gf2019026002", "madsrdf:adminMetadata": [{"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab1"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Machine plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab5"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab6"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab7"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab8"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab9"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab10"}], "madsrdf:hasVariant": [{"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab11"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "French plays of the 17th century that employed elaborate stage machinery and scene changes."}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-04-09T11:06:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-03T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Machine plays"}}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. iv-v (visual spectacle offered by elaborate costumes, machines and sets; the type of play which was gradually evolved to accommodate all these elements, the so-called \"pi\u00e8ce \u00e0 machines\"; plays whose primary interest is scenic) p. vi (type of drama which made extensive use of mechanical devices did not begin to develop on the public stage in France until after the early years of the XVIIth century; machine plays; the pi\u00e8ce \u00e0 machines one of the most popular dramatic forms in the period between 1660 and 1672) p. 1 (a genre like the machine play, whose primary appeal is largely dependent upon its exterior presentation) p. 308 (\"His [Corneille's] two machine plays had unquestionably been the most successful in the genre up to this time\")"}, "madsrdf:citationSource": "Langlois, W.G. The evolution of scenic spectacles in France (1600-1673) : national and Italian origins of the machine play, 1955, via ProQuest dissertations & theses global, viewed online Jan. 3, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "machine play (type of 17th-century French spectacle which made excessive use of the mechanical contrivances and scene-changes developed in connection with the evolution of opera, particularly by Torelli; subjects were usually taken from classical mythology; most machine plays were produced at the Th\u00e9\u00e2tre du Marais)"}, "madsrdf:citationSource": "Concise Oxford companion to the theatre, 1996, via Credo Reference, March 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(machine play: A form of spectacular dramatic entertainment presented in France during the 17th century, so called because it involved extensive use of elaborate stage machinery; plays belonging to the genre included Corneille's Androm\u00e8de (1650) and Moli\u00e8re's Amphitryon (1668))"}, "madsrdf:citationSource": "The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(machine play: A type of dramatic spectacle in 17th-century France that depended on new scene-changing equipment and other mechanical devices. Corneille pioneered the genre with his Androm\u00e8de. It was written in order to make full use of the elaborate Italian stage machinery introduced to France by Giacomo Torelli. The machine play peaked with Moli\u00e8re's Amphitryon (1668) and Psych\u00e9 (1671))"}, "madsrdf:citationSource": "The Methuen Drama dictionary of the theatre, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Moli\u00e8re. Amphitryon, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Corneille, P. Androm\u00e8de, 1974.", "madsrdf:citationStatus": "found"}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Machine drama"}}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Machine drama"}}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pi\u00e8ces \u00e0 machines"}}, {"@id": "_:n68f7da8aaaf94f0ba7db04930baa585ab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pi\u00e8ces \u00e0 machines"}}], "@id": "/authorities/genreForms/gf2019026002"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026005", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDomestic comics", "identifiers:lccn": "gf2019026005", "madsrdf:adminMetadata": [{"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb1"}, {"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Domestic comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb5"}, {"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb6"}, {"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb7"}, {"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that feature home and family life."}, {"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-14T08:16:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Domestic comics"}}, {"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "publisher's description (Matteo has returned home to the provincial country town where he was born and from which he had fled ... Despite trepidations about encountering his estranged father, he finds a place to crash with his extended family for a while. Settling into a house shared by his grandmother, three aunts, and his very pregnant cousin, he starts to rebuild his life and relationships and confronts a few truths about the other generations of his family, and about himself)"}, "madsrdf:citationSource": "Work cat.: Biondi, F. Generations, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 6, p. 324 (in running text: family and domestic comics)"}, "madsrdf:citationSource": "Encyclopedia of journalism, \u00a92009:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 113 (domestic comics which focus on family relations in a home setting; traditionally, the domestic comic strips have depicted white middle-class families)"}, "madsrdf:citationSource": "Brabant, S. The social construction of family life in the Sunday comics, in Journal of comparative family studies, winter 1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb2c2052e3744a3989f80e6c44ffc1ecb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "publisher's description (Teenagers Anne and Lewis cross paths and together refuse to succumb to the fate of the older generation as they discover the secrets of their hometown and their own families)"}, "madsrdf:citationSource": "Ryan, S. Bad houses, 2013:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026005"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026006", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLiturgical drama", "identifiers:lccn": "gf2019026006", "madsrdf:adminMetadata": [{"@id": "_:nffc547d43b72433aabe7b4d750bcce03b1"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Liturgical drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:nffc547d43b72433aabe7b4d750bcce03b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026501"}, "madsrdf:hasSource": [{"@id": "_:nffc547d43b72433aabe7b4d750bcce03b5"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b6"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b7"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b8"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b9"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b10"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b11"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b12"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b13"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b14"}], "madsrdf:hasVariant": {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b15"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Medieval musical dramas performed during Roman Catholic liturgies."}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-14T08:16:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Liturgical drama"}}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Medieval drama: medieval drama in Latin and the major European vernaculars comprises, essentially, two types of religious drama. In the first, traditionally called the 'liturgical drama', music is integral: the whole text of the play is sung monophonically and the language is Latin. In the second, vernacular drama, the main action is conducted in the spoken vernacular, with songs and instrumental music, plainchant and polyphony, introduced as appropriate; liturgical drama, starting in its simplest form as the Quem queritis dialogue, evolved over the centuries until it took on more realistic forms such as the mystery cycles of the later Middle Ages; musical study of the drama still lags behind the literary; scholars have continued to use the traditional term 'liturgical drama' to describe the corpus of sung religious dialogues, ceremonies and plays in Latin since it was first coined; many of the plays are paraliturgical rather than strictly a part of the liturgy; the plays are found for the most part in liturgical books, and they are animated by the spirit of the liturgy and not by that of the theatre)"}, "madsrdf:citationSource": "Grove music online, Jan. 15, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(liturgical drama (or ecclesiastical drama): earliest form of medieval religious drama, consisting of plays performed in church as part of the liturgy; developed during the 10th century from such tropes as the famous Quem quaeritis?, performed at Easter as part of the Mass. Later such episodes were expanded to tell various stories from the scriptures and were increasingly performed outside the church building. Those illustrating the Christmas story became known as Nativity plays, while those given at Easter were referred to as Passion plays; other performances linked to specific religious festivals included the Epiphany play. Ultimately, the plays became separated from the Church liturgy and were written in the vernacular; they also came to include a strong comic element, gradually evolving into the more sophisticated Mystery play)"}, "madsrdf:citationSource": "The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Contains 6 versions of the Easter drama Visitatio sepulchri and 4 other texts) pp. 123-156 (\"Musical transcriptions\" (unacc. melodies))"}, "madsrdf:citationSource": "Holy Week and Easter ceremonies and dramas from medieval Sweden, 1990", "madsrdf:citationStatus": "found"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(liturgical theatre. Plays based on some aspect of the Roman Catholic liturgy. Beginning in European monasteries in the ninth century as short plays in Latin, these dramas continued for three hundred years with only the clergy, and occasionally choirboys, taking part)"}, "madsrdf:citationSource": "Mobley, J.P. NTC's dictionary of theatre and drama terms, c1992", "madsrdf:citationStatus": "found"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (an acting-version of a thirteenth-century liturgical drama; edited, with the text translated into English, and the music transcribed into modern notation, by W.L. Smoldon)"}, "madsrdf:citationSource": "Work cat.: Ordo ad representandum Herodem. Herod : a medieval nativity play, \u00a91960:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Liturgical Drama, plays based on the life, death, and resurrection of Jesus Christ; part of celebration of the Mass, particularly at Easter and Christmas; the introduction of antiphonal singing, which may have owed something to the memory of the Greek chorus, paved the way for the use of dialogue. As church services became more elaborate, the vocal additions took on dialogue forms; important step forward in dramatic evolution was taken with the introduction of extraneous lyrics; As long as the play remained within the church it was part of the liturgy, and the actors were priests, choirboys, and perhaps, later on, nuns. The dialogue, entirely in Latin, was chanted, not spoken, and the musical interludes were sung by the choir alone, with no participation by the congregation. By the end of the 13th century the evolution of liturgical drama was complete, and in its final phase it was not necessarily connected with a church service. From it came the vernacular mystery play)"}, "madsrdf:citationSource": "The concise Oxford companion to the theatre, 1996, via Oxford reference online, Jan. 15, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "liturgical drama (earliest organized drama in medieval Europe, consisting of various types of play performed in church as part of the Christian liturgy; developed in French and German Benedictine monasteries in the 10th century; although other subjects were treated, the Easter story remained central; originally Latin plays; performers usually wore church vestments; from about 1200, however, the plays began to be performed outside; by the end of the 13th century the dramas had lost their liturgical function and were mainly written in the vernacular, although they were still sometimes performed in churches until at least the 15th century; liturgical drama developed into the more sophisticated mystery play) ecclesiastical drama (See liturgical drama)"}, "madsrdf:citationSource": "The Methuen Drama dictionary of the theatre, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Coussemaker, C.E.H.d. Drames liturgiques du moyen \u00e2ge (texte et musique), 1860.", "madsrdf:citationStatus": "found"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ordo ad representandum Herodem. The play of Herod : a twelfth-century musical drama, 1965.", "madsrdf:citationStatus": "found"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Medieval church music-dramas : a repertory of complete plays, 1976.", "madsrdf:citationStatus": "found"}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffc547d43b72433aabe7b4d750bcce03b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ecclesiastical drama"}}, {"@id": "_:nffc547d43b72433aabe7b4d750bcce03b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ecclesiastical drama"}}], "@id": "/authorities/genreForms/gf2019026006"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026008", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTime-travel comics", "identifiers:lccn": "gf2019026008", "madsrdf:adminMetadata": [{"@id": "_:n415f26e76489425c9218434974f45594b1"}, {"@id": "_:n415f26e76489425c9218434974f45594b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Time-travel comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n415f26e76489425c9218434974f45594b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026530"}, "madsrdf:hasSource": [{"@id": "_:n415f26e76489425c9218434974f45594b5"}, {"@id": "_:n415f26e76489425c9218434974f45594b6"}, {"@id": "_:n415f26e76489425c9218434974f45594b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n415f26e76489425c9218434974f45594b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-14T08:16:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n415f26e76489425c9218434974f45594b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n415f26e76489425c9218434974f45594b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Time-travel comics"}}, {"@id": "_:n415f26e76489425c9218434974f45594b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: David is stuck with the world's worst babysitter. But when she accidentally zaps herself back in time, his problems are far from over. If she's still missing when his parents get back, they'll freak out! David and his best friend, Ben, must blast into the past to save the stranded sitter)"}, "madsrdf:citationSource": "Nickel, S. Time blasters, back to the Ice Age, \u00a92008", "madsrdf:citationStatus": "found"}, {"@id": "_:n415f26e76489425c9218434974f45594b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel; A science-fiction love story about time travel, it describes the misadventures of a man, Jack, after he finds his pregnant wife, Patience, murdered in their apartment. Many years later, when grief has destroyed his life, chance leads him to discover a time machine, which he plans to use to save Patience)"}, "madsrdf:citationSource": "Work cat.: Clowes, D. Patience, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n415f26e76489425c9218434974f45594b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: A scientist hires an assassin to travel back in time and kill Adolf Hitler before he can rise to power, but the plan backfires when Hitler survives the attack and uses the time machine to travel to the twenty-first century, leaving the hired killer stranded in time)"}, "madsrdf:citationSource": "Jason. J'ai tu\u00e9 Adolf Hitler. English. I killed Adolf Hitler, 2007", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026008"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026009", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAsh Wednesday sermons", "identifiers:lccn": "gf2019026009", "madsrdf:adminMetadata": [{"@id": "_:nb914cc7c94324f6baf57c2e59868c856b1"}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ash Wednesday sermons"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb914cc7c94324f6baf57c2e59868c856b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026104"}, "madsrdf:hasSource": [{"@id": "_:nb914cc7c94324f6baf57c2e59868c856b5"}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b6"}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b7"}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b8"}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-04-09T11:06:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ash Wednesday sermons"}}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ash Wednesday (the first day of Lent) Lent (the 40 weekdays from Ash Wednesday to Easter observed by the Roman Catholic, Eastern, and some Protestant churches as a period of penitence and fasting)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Jan. 16, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ash Wednesday sermons. UF Ash Wednesday--Sermons. BT Lenten sermons)"}, "madsrdf:citationSource": "LCSH, Jan. 16, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Southgate, H. Practical directions on the observance of Lent : a homily for Ash Wednesday, 1857.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Dulany, E. A sermon preached before the King, in Christ-Church, Dublin, on Ash-Wednesday 1689, 1689.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb914cc7c94324f6baf57c2e59868c856b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Higgins, F. A sermon preach'd at the Royal Chappel at White-hall : on Ash-Wednesday, Feb. 26, 1706/07, 1707.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026009"}
