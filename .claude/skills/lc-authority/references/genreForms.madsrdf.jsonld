.loc.gov/authorities/subjects/sh2008025520"}]}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-23T16:16:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Detective and mystery television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd4644450ccfa4e578f4848f286045b82b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sherlock Holmes television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sherlock Holmes television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd4644450ccfa4e578f4848f286045b82b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scooby-Doo television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scooby-Doo television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd4644450ccfa4e578f4848f286045b82b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Commissario Montalbano television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Commissario Montalbano television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Detective and mystery television programs)"}, "madsrdf:citationSource": "LCSH, January 28, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mystery: fictional work in which a detective (sometimes merely an endangered individual forced to \"detect\" for his own self-protection) attempts to solve a crime, usually a murder or theft. The detective may be an amateur, a private investigator, or a plainclothes member of a police force, but whatever the identity, the mystery places the emphasis on the search for clues and rationative power of the detective, rather than the efforts of police or lawbreakers. In the mystery, suspense derives from the narrative's puzzle-like structure, with a group of suspects, whose testimony and motives must all be investigated until, in the surprising conclusion, the intelligent detective perceives the flawed alibi or other clue betraying the culprit's identity. RT: Caper, Crime, Film noir, Gangster, Police, and Thriller)"}, "madsrdf:citationSource": "Moving image genre-form guide online, January 28, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 69 (Mysteries: use for fictional genre films and programs which usually revolve around the solution of a murder and do not have as their central character a private eye or gentileman detective; includes films and programs about a victim being driven crazy by someone, and films in which a character accused of murder tracks down the real villain. RT: Detective films and programs; UF: Murder mysteries; Who-done-it's); p. 40 (Detective films and programs: use for fictional genre films and programs which focus on the investigations of a detective who is not with an official law enforcement agency. RT: Mysteries; Police films and programs; NT: Private eye films and programs))"}, "madsrdf:citationSource": "Yee, M. M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd4644450ccfa4e578f4848f286045b82b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mystery television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mystery television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd4644450ccfa4e578f4848f286045b82b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scooby-Doo television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scooby-Doo television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd4644450ccfa4e578f4848f286045b82b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Private eye television programs"}}, {"@id": "_:nd4644450ccfa4e578f4848f286045b82b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Private eye television programs"}}, {"@id": "_:nd4644450ccfa4e578f