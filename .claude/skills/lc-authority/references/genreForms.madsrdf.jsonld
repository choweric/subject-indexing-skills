entSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n62c4a404ca314ef6825b7121f114721fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magazine format radio programs"}}, {"@id": "_:n62c4a404ca314ef6825b7121f114721fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg: Magazine format radio programs)"}, "madsrdf:citationSource": "LCSH, Oct. 25, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n62c4a404ca314ef6825b7121f114721fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Magazines: nonfictional programs that take the form of a number of stories on items of current interest which are treated in a more in-depth and/or reflective way than they would be on news programs. Example: Rollins College magazine of the air)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Oct. 25, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n62c4a404ca314ef6825b7121f114721fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Newsmagazine, aka news magazine; usually a weekly magazine featuring articles or segments on current events. News magazines generally go more in-depth into stories; try to give the reader an understanding of the context surrounding important events, rather than just the facts; radio news magazines are similar to television news magazines; unlike radio newscasts, which are typcially about 5 minutes in length, radio news magazines run from 30 minutes up to three hours or more)"}, "madsrdf:citationSource": "Wikipedia, March 26, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n62c4a404ca314ef6825b7121f114721fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n62c4a404ca314ef6825b7121f114721fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "News magazines (Radio programs)"}}, {"@id": "_:n62c4a404ca314ef6825b7121f114721fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "News magazines (Radio programs)"}}, {"@id": "_:n62c4a404ca314ef6825b7121f114721fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n62c4a404ca314ef6825b7121f114721fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Newsmagazines (Radio programs)"}}, {"@id": "_:n62c4a404ca314ef6825b7121f114721fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Newsmagazines (Radio programs)"}}, {"@id": "_:n62c4a404ca314ef6825b7121f114721fb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n62c4a404ca314ef6825b7121f114721fb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magazine radio programs"}}, {"@id": "_:n62c4a404ca314ef6825b7121f114721fb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magazine radio programs"}}], "@id": "/authorities/genreForms/gf2011026382"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026383", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMagazine format television programs", "identifiers:lccn": "gf2011026383", "madsrdf:adminMetadata": [{"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b1"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Magazine format television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026425"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b5"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b6"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b7"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b8"}], "madsrdf:hasVariant": [{"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b9"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b12"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b15"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025298"}}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-05T15:47:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magazine format television programs"}}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Magazine: nonfiction work covering disparate but contemporary topics during its duration, often mixing news with weather, human interest, or gossip)"}, "madsrdf:citationSource": "Moving image genre-form guide online, August 14, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(newsmagazine: sometimes called news magazine, is usually a weekly magazine featuring articles or segments on current events. News magazines generally go more in-depth into stories than newspapers or television news, trying to give the reader an understanding of the context surrounding important events, rather than just the facts; Television news magazines provide a similar service to print news magazines, but their stories are presented as short television documentaries rather than written articles)"}, "madsrdf:citationSource": "Wikipedia, March 5, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 61 (Magazines: use for nonfiction films and programs which take the form of a number of stories on items of current interest which are treated in a more general, in-depth, and/or reflective way than they would be on a news program)"}, "madsrdf:citationSource": "Yee, M. M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(magazine format: a program made up of varied segments, long and short, on a variety of subjects ... originally usually news or public affairs programs ... late 70s adapted for straight entertainment ... became epidemic 1990s)"}, "madsrdf:citationSource": "Les Brown's encyc. of television, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magazines (Television programs)"}}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magazines (Television programs)"}}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magazine television programs"}}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magazine television programs"}}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "News magazines (Television programs)"}}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "News magazines (Television programs)"}}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Newsmagazines (Television programs)"}}, {"@id": "_:ne8f03ebba5944cc09fce784f68ed53e4b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Newsmagazines (Television programs)"}}], "@id": "/authorities/genreForms/gf2011026383"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026384", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMakeover television programs", "identifiers:lccn": "gf2011026384", "madsrdf:adminMetadata": [{"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b1"}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Makeover television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026522"}, "madsrdf:hasSource": [{"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b5"}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b6"}], "madsrdf:hasVariant": [{"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b7"}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b10"}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025287"}}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:32:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Makeover television programs"}}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Makeover reality television series are television series which focus on makeovers; a makeover is a term applied to changing one's appearance, usually through cosmetics, ranging from something as simple as a new haircut, to the extreme of cosmetic surgery; makeovers are often popular television subjects; long an element of daytime talk shows, they have recently moved into the limelight with shows such as Queer eye for the straight guy; other popular makeover shows include What not to wear, Extreme makeover, Ambush makeover, and Pimp my ride)"}, "madsrdf:citationSource": "Wikipedia website, July 30, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Makeover television programs)"}, "madsrdf:citationSource": "LCSH, July 30, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Makeover shows (Television programs)"}}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Makeover shows (Television programs)"}}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Makeover reality television programs"}}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Makeover reality television programs"}}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Makeover television shows"}}, {"@id": "_:n0daf2cd0607b48d88f09e60cc5af8875b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Makeover television shows"}}], "@id": "/authorities/genreForms/gf2011026384"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026385", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aManuscript maps", "identifiers:lccn": "gf2011026385", "madsrdf:adminMetadata": [{"@id": "_:n99958912888844588caee39c40c5ae1db1"}, {"@id": "_:n99958912888844588caee39c40c5ae1db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Manuscript maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:n99958912888844588caee39c40c5ae1db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:n99958912888844588caee39c40c5ae1db5"}, {"@id": "_:n99958912888844588caee39c40c5ae1db6"}, {"@id": "_:n99958912888844588caee39c40c5ae1db7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025071"}}, {"@id": "_:n99958912888844588caee39c40c5ae1db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n99958912888844588caee39c40c5ae1db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T13:10:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n99958912888844588caee39c40c5ae1db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Manuscript maps"}}, {"@id": "_:n99958912888844588caee39c40c5ae1db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "manuscript (the original drawing of a map as compiled or constructed from various data such as ground surveys and photographs)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n99958912888844588caee39c40c5ae1db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(manuscript: the original drawing of a map as compiled or constructed from various data, such as ground surveys and photographs)"}, "madsrdf:citationSource": "Glossary of mapping, charting, and geodetic terms, 1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:n99958912888844588caee39c40c5ae1db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Maps, Manuscript)"}, "madsrdf:citationSource": "LCSH, Dec. 1, 2009:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026385"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026386", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMappae mundi", "identifiers:lccn": "gf2011026386", "madsrdf:adminMetadata": [{"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb1"}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mappae mundi"}, "madsrdf:elementList": {"@list": [{"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb5"}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb6"}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb7"}], "madsrdf:hasVariant": [{"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb8"}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Early medieval world maps.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025087"}}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T07:06:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mappae mundi"}}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "mappa mundi (plural: mappae mundi: a general term used to describe Medieval European maps of the world. These maps ranged in size and complexity from simple schematic maps an inch or less across, to elaborate wall maps, the largest of which was 11 ft. (3.5 m.) in diameter. Approximately 1,100 mappae mundi are known to have survived from the Middle Ages)"}, "madsrdf:citationSource": "Wikipedia, Dec. 8, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Glossary of mapping, charting, and geodetic terms, 1973;Glossary of the mapping sciences, 1994.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Maps--Mappamundi (used for medieval (usually circular) world maps, made between the fall of the western Roman empire in the later years of the 5th century AD and the end of the 15th century)"}, "madsrdf:citationSource": "Form/genre for cartographic materials [draft of LC working group], 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mappa mundi"}}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mappa mundi"}}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mappamundi"}}, {"@id": "_:n59ca128b8e9e44e0b61d037f6b94f98eb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mappamundi"}}], "@id": "/authorities/genreForms/gf2011026386"}
