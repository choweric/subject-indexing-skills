ov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n376f2634a132444ebd733f53ca759100b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wall charts"}}, {"@id": "_:n376f2634a132444ebd733f53ca759100b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wallchart (also wall chart): a large printed drawing showing information in a simple way, that you stick or pin to a wall)"}, "madsrdf:citationSource": "Cambridge dictionaries online, Feb. 2, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n376f2634a132444ebd733f53ca759100b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Feb. 2, 2016;Thesaurus for graphic materials, via WWW, Feb. 2, 2016;Art & architecture thesaurus online, Feb. 2, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n376f2634a132444ebd733f53ca759100b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wall chart: A chart or poster designed for display on a wall as a teaching aid or source of information)"}, "madsrdf:citationSource": "Oxford dictionaries online, Feb. 2, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n376f2634a132444ebd733f53ca759100b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "recto (series: Wall chart ; no. 1; issued by: Occupational Outlook Service, United States Department of Labor, Bureau of Labor Statistics)"}, "madsrdf:citationSource": "Work cat.: Hotels offer employment opportunities in many different occupational fields, [1947]:", "madsrdf:citationStatus": "found"}, {"@id": "_:n376f2634a132444ebd733f53ca759100b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wallchart: a large piece of paper with information on it that is fastened to a wall)"}, "madsrdf:citationSource": "Longman dictionary of contemporary English online, Feb. 2, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n376f2634a132444ebd733f53ca759100b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wallchart: a large chart or poster that is displayed on a wall)"}, "madsrdf:citationSource": "Collins English dictionary online, Feb. 2, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n376f2634a132444ebd733f53ca759100b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wall chart: a large piece of paper that contains information on a particular subject and is fastened to a wall)"}, "madsrdf:citationSource": "Macmillan dictionary online, Feb. 2, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n376f2634a132444ebd733f53ca759100b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n376f2634a132444ebd733f53ca759100b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Charts, Wall"}}, {"@id": "_:n376f2634a132444ebd733f53ca759100b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Charts, Wall"}}, {"@id": "_:n376f2634a132444ebd733f53ca759100b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n376f2634a132444ebd733f53ca759100b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wallcharts"}}, {"@id": "_:n376f2634a132444ebd733f53ca759100b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wallcharts"}}], "@id": "/authorities/genreForms/gf2016026011"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026012", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFilms \u00e0 clef", "identifiers:lccn": "gf2016026012", "madsrdf:adminMetadata": [{"@id": "_:ndc87db22a98242f58fa63b35cc719172b1"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Films \u00e0 clef"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndc87db22a98242f58fa63b35cc719172b3"}]}, "madsrdf:exampleNote": "Note under [Biographical films]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026250"}, "madsrdf:hasSource": [{"@id": "_:ndc87db22a98242f58fa63b35cc719172b5"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b6"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b7"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b8"}], "madsrdf:hasVariant": [{"@id": "_:ndc87db22a98242f58fa63b35cc719172b9"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b12"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films in which real persons, places, or events are depicted under invented names. For films that depict the lives of real people see [Biographical films.]"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-05-10T11:56:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Films \u00e0 clef"}}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Film \u00e0 clef (A film \u00e0 clef or film \u00e0 cl\u00e9 (French for \"film with a key\"), is a film describing real life, behind a fa\u00e7ade of fiction. \"Key\" in this context means a table one can use to swap out the names. It is the film equivalent of the roman \u00e0 clef. Notable films \u00e0 clef: 8 1/2 is based on Federico Fellini's experience suffering from \"director's block\"; Annie Hall, believed to be a version of Woody Allen's own relationship with Diane Keaton (whose birth name is Diane Hall); Citizen Kane, a thinly disguised biographical film about William Randolph Hearst; Magnolia, is loosely inspired by Paul Thomas Anderson's experience in dealing with his father's death from cancer; Adaptation: while parts of the film are adapted from Susan Orlean's non-fiction book The Orchid Thief, most of the film is a heavily fictionalized account of Charlie Kaufman's difficulty in adapting the book into a screenplay; The Last Samurai, inspired by the 1876 Satsuma Rebellion and also on the story of Jules Brunet, a French army captain who fought in the Boshin War; Primary Colors is a thinly-veiled depiction of Bill Clinton's 1992 presidential campaign; Dreamgirls, the musical film based on the career of The Supremes; Last Days (2005), a barely concealed dramatization of Kurt Cobain's final days; The Devil Wears Prada is based on Vogue magazine editor Anna Wintour; Velvet Goldmine is largely based on the career of David Bowie)"}, "madsrdf:citationSource": "Wikipedia, Feb. 17, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Film \u00e0 clef, or film \u00e0 cl\u00e9, is a type of film based on real life but played out as fiction. The term is French for 'film with a key', with the 'key' referring to the process of swapping out real names with fictional ones. It is the film version of roman \u00e0 clef, which is the literary, and presumably original, equivalent. This type of film is different from biopics, whether they're based on a real person or not, as they're not played as fact; it's told solely as fiction. A common type of film \u00e0 clef is when a fiction film is based on the writer's personal experiences. There are countless examples of film \u00e0 clef, but some of the more notable ones include: Citizen Kane - Kane was based on American newspaper publisher William Randolph Hearst. Magnolia - apparently loosely inspired by director Paul Thomas Anderson's experience of dealing with the death of his father from cancer. Lost In Translation - Scarlett Johansson and Giovanni Ribisi's characters are believed to be based on writer/director Sofia Coppola and her ex-husband Spike Jonze. Saving Private Ryan - Loosely based on the story of the Niland brothers.)"}, "madsrdf:citationSource": "Malloy, T. What is... film \u00e0 clef?, via Terry Malloy's pigeon coop blog, Oct. 10, 2013, viewed on Feb. 17, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Film \u00e0 Clef (Cin\u00e9ma \u00e0 Clef, Movie \u00e0 Clef). A roman \u00e0 clef (\"key novel\") is a novel in which the main characters are based on real people, but whose identities, although easily recognized by well-informed readers, are nevertheless veiled to avoid any printing interdiction or legal prosecution. The same applies to movies which use similar techniques for concealing the character's (or characters') real-life identity. Most of these films are concealed biographies and deal with Hollywood personalities. They have been referred to as films \u00e0 clef. Examples: Citizen Kane; Caught; Sunset Boulevard; The Goddess; Imitation of Life; The Carpetbaggers; The Last Tycoon; Network; The Greek Tycoon; Ein Mann wie Eva)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Citizen Kane, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndc87db22a98242f58fa63b35cc719172b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cin\u00e9ma \u00e0 clef"}}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cin\u00e9ma \u00e0 clef"}}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndc87db22a98242f58fa63b35cc719172b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Movies \u00e0 clef"}}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Movies \u00e0 clef"}}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndc87db22a98242f58fa63b35cc719172b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Films \u00e0 cl\u00e9"}}, {"@id": "_:ndc87db22a98242f58fa63b35cc719172b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Films \u00e0 cl\u00e9"}}], "@id": "/authorities/genreForms/gf2016026012"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026013", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLo-fi (Rock music)", "identifiers:lccn": "gf2016026013", "madsrdf:adminMetadata": [{"@id": "_:nd1423fd0456044d9868c1411e05c3f92b1"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lo-fi (Rock music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd1423fd0456044d9868c1411e05c3f92b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026632"}, "madsrdf:hasSource": [{"@id": "_:nd1423fd0456044d9868c1411e05c3f92b5"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b6"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b7"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b8"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b9"}], "madsrdf:hasVariant": [{"@id": "_:nd1423fd0456044d9868c1411e05c3f92b10"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lo-fi (Rock music)"}}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Beat Happening (Musical group). Beat Happening, 199-?", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (lo-fi mavericks)"}, "madsrdf:citationSource": "Unterberger, R. Unknown legends of rock 'n' roll, \u00a91998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Blur (In 1997 the band effected a volte face and embraced the slow, grunge-influenced 'low-fi' American sound of such artists as Pavement and Beck)"}, "madsrdf:citationSource": "Oxford Music Online, viewed Jan. 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Pop/Rock > Alternative/Indie Rock > Lo-Fi (During the late '80s and early '90s, lo fidelity became not only a description of the recording quality of a particular album, but it also became a genre onto itself. Throughout rock & roll's history, recordings were made cheaply and quickly, often on substandard equipment. In that sense, the earliest rock & roll records, most of the garage rock of the '60s, and much of the punk rock of the late '70s could be tagged as Lo-Fi. However, the term came to refer to a breed of underground indie rockers that recorded their material at home on four-track machines. Most of this music grew out of the American underground of the '80s, including bands like R.E.M., as well as a handful of British post-punk bands and New Zealand bands like the Chills and the Clean. Often, these lo-fi bands fluctuated from simple pop and rock songs to free-form song structures to pure noise and arty experimentalism. Even when the groups kept the songs relatively straightforward, the thin quality of the recordings, the layers of tape distortion and hiss, as well as the tendency toward abstract, obtuse lyrics made the music sound different and left of center. Initially, lo-fi recordings were traded on homemade tapes, but several indie labels -- most notably K Records, which was run by Calvin Johnson, who led the lo-fi band Beat Happening -- released albums on vinyl. Several groups in the late '80s, like Pussy Galore, Beat Happening, and Royal Trux earned small cult followings within the American underground. By 1992, groups like Sebadoh and Pavement had become popular cult acts in America and Britain with their willfully noisy, chaotic recordings. A few years later, Liz Phair and Beck helped break the lo-fi aesthetic into the mainstream, albeit in a more streamlined fashion)"}, "madsrdf:citationSource": "AllMusic website, Aug. 25, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Lo-fi music (Lo-fi (from the term \"low fidelity\") is lower quality of sound recordings than the usual standard for modern music. The qualities of lo-fi are usually achieved by either degrading the quality of the recorded audio, or using certain equipment. Recent uses of the phrase have led to it becoming a genre, although it still remains as an aesthetic in music recording practice. The aesthetic of lo-fi music often contrasts that of mainstream pop by being somewhat flawed but at the same time embracing those flaws, claiming they give low-fi a more honest and unpretentious feeling)"}, "madsrdf:citationSource": "Wikipedia, Aug. 25, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd1423fd0456044d9868c1411e05c3f92b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Low fidelity music (Rock music)"}}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Low fidelity music (Rock music)"}}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd1423fd0456044d9868c1411e05c3f92b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Low-fi music (Rock music)"}}, {"@id": "_:nd1423fd0456044d9868c1411e05c3f92b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Low-fi music (Rock music)"}}], "@id": "/authorities/genreForms/gf2016026013"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026014", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aShoegaze (Music)", "identifiers:lccn": "gf2016026014", "madsrdf:adminMetadata": [{"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b1"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Shoegaze (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026632"}, "madsrdf:hasSource": [{"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b5"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b6"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b7"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b8"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b9"}], "madsrdf:hasVariant": [{"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b10"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-08-17T14:04:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shoegaze (Music)"}}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Shoegaze; genre of late '80s and early '90s British indie rock, named after the bands' motionless performing style, where they stood on stage and stared at the floor while they played; the sound of the music was overwhelmingly loud, with long, droning riffs, waves of distortion, and cascades of feedback. Vocals and melodies disappeared into the walls of guitars, creating a wash of sound where no instrument was distinguishable from the other; almost none of the shoegazers were dynamic performers or interesting interviews, which prevented them from breaking through into the crucial U.S. market. In 1992 -- after the groups had dominated the British music press and indie charts for about three years -- the shoegaze groups were swept aside by the twin tides of American grunge and Suede, the band to initiate the wave of Britpop that ruled British music during the mid-'90s)"}, "madsrdf:citationSource": "AllMusic website, Oct. 14, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Shoegazing (also known as shoegaze) is a subgenre of alternative rock that emerged from the United Kingdom in the late 1980s and reached peak popularity in the early 1990s; the shoegazing sound is typified by significant use of distortion, feedback, obscured vocals, and the blurring of component musical parts into indistinguishable \"walls of sound\". The term was often used contemporaneously with \"dream pop.\" The style is often affiliated with bands such as My Bloody Valentine, Lush, Slowdive, Chapterhouse, and Ride; common musical elements of shoegazing consist of distortion, droning riffs and a \"wall of sound\" from noisy guitars. Typically, two distorted rhythm guitars are played together to give an amorphous quality to the sound. Although lead guitar riffs were often present, they were not the central focus of most shoegazing songs. Vocals are typically subdued in volume and tone, but a strong sense of melody generally exists underneath the layers of guitars. However, lyrics are not emphasized, nor are vocals. While the genres that influenced shoegazing often used drum machines, shoegazing more often features live drumming)"}, "madsrdf:citationSource": "Wikipedia, Oct. 14, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 506 (shoegazing) index (\"shoegazing\" music)"}, "madsrdf:citationSource": "Stanley, B. Yeah! yeah! yeah! : the story of pop music from Bill Haley to Beyonc\u00e9, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Note: Lo-fi minimalistic shoegaze)"}, "madsrdf:citationSource": "Work cat: Birds of Passage (Musician). Highwaymen in midnight masks, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Shoegazing: Taking its name from the stance singer-songwriters took while performing it, this subgenre of indie rock emerged in England in the early 1990s. One album, however, is credited with capturing the essence of the signature \"shoegaze\" sound--1991's Loveless by the Irish/British rock quartet group My Bloody Valentine. Other bands that are often categorized under the shoegazing umbrella include Ride, Curve, Lush, and The Jesus and Mary Chain. The shoegazing sound incorporates a generous heaping of distortion, clouded by noisy guitars, detailed drum fills, and vocals and melody that were seamlessly mixed into this overwhelming wall of sound in which it was difficult to distinguish one sound or instrument from another; the subgenre's signature qualities--subdued or passive-sounding vocals, introspective lyrics, and fuzzy guitars; Several spin-offs of shoegazing have emerged within the indie rock spectrum--among them electrogazing (created by groups like Shockwave), emogazing (made popular by groups like Garbage) and even Viking Death Metal Shoegazing (which was reportedly created by ex-Cocteau Twin Elizabeth Frazer))"}, "madsrdf:citationSource": "Smith, K.L. Encyclopedia of indie rock, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dreampop (Music)"}}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dreampop (Music)"}}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shoegazing (Music)"}}, {"@id": "_:n69e79c3c54fe4e35ac0b069f7b677750b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shoegazing (Music)"}}], "@id": "/authorities/genreForms/gf2016026014"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026015", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSkate punk music", "identifiers:lccn": "gf2016026015", "madsrdf:adminMetadata": [{"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b1"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Skate punk music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027025"}, "madsrdf:hasSource": [{"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b5"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b6"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b7"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b8"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b9"}], "madsrdf:hasVariant": [{"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b10"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b13"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skate punk music"}}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Skate Punk is a subgenre of Punk Rock popular amongst skateboarders. It started in the 80's, from the Nardcore punk scene in Oxnard, California. Both the subgenres tend to feature fast and aggressive songs, but Skate Punk tends to have more melody and harmonious vocals. Many Skate Punk bands are skateboarders themselves. They make references to skateboarding (e.g., Millencolin, a Skate Punk band, its name deriving from \"Melancholy,\" an aerial skate trick). The musical subgenre of Skate Punk is also known to some as \"Skate Core\")"}, "madsrdf:citationSource": "Last.fm website, Aug. 26, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(series title: Skate punk 1980s, original formula)"}, "madsrdf:citationSource": "Jody Foster's Army (Musical group). We know you suck, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pop/Rock > Alternative/Indie Rock > Skatepunk. Skatepunk was originally a derivative of hardcore punk, so named because of its popularity among skateboarders. It can be difficult for outsiders to pin down exactly what makes a particular band skatepunk, but there are a few strong tendencies. Skatepunk tends to be especially high-energy, even for the genre it comes from; that usually means even faster tempos and thrashier guitars. Skatepunk also tends to have a sense of humor, mostly of the smartass variety -- because, after all, it's used as a soundtrack for fun. In keeping with the fiercely anti-corporate, anti-authoritarian attitudes of the fans, most skatepunk bands are signed to independent labels, and most prefer to keep it that way as a statement of principle. The exact sound of skatepunk has shifted over the years with punk itself, from hardcore in the '80s to revivalist punk-pop in the '90s; its manic energy also influenced a portion of the third-wave ska revival movement. The first true skatepunk band was Suicidal Tendencies, who helped pave the way for some skatepunk outfits to dabble in funk-metal as well)"}, "madsrdf:citationSource": "AllMusic website, Aug. 26, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Skate-punk rock music)"}, "madsrdf:citationSource": "Work cat.: RSI (Musical group). Reality Sets In, c2002", "madsrdf:citationStatus": "found"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Skate Punk. Also known as: Skatepunk, Skate Rock. Skate punk can refer to two distinct styles of Punk Rock. The contemporary use of the term skate punk describes a style which combines the speed of Melodic Hardcore with the catchiness of Pop Punk. The original bands of the early 1980s to be labeled as skate punk were Hardcore Punk and Crossover Thrash bands with a large skater following, such as Suicidal Tendencies, JFA, Big Boys, The Faction and Gang Green. While the popularly accepted definition of skate punk has changed, some modern crossover thrash bands, like Bones Brigade and Skate Korpse, are still referred to as skate punk. The modern incarnation of skate punk is strongly rooted in the style of melodic hardcore characteristic of Bad Religion. This interpretation of skate punk blends melodic hardcore with the catchiness and youthful fun of pop punk. The majority of skate punk bands have two guitar players to create a fuller sound. Skate punk songs are often characterized with guitar leads through out the whole song, ranging from octave progressions, complex muted riffs and guitar solos played in harmony. Tempos can reach speeds of up to 270bpm, mainly focusing on upbeat drums. Vocals can be clear or somewhat abrasive and are often sung in harmony. Bands like NOFX, The Offspring, Millencolin, Face to Face and Pennywise helped this style of punk rock develop and gain in popularity in the early to mid 1990s. Skate punk saw another, even larger boom in popularity around the turn of the millenium with the huge commercial success of acts like Blink-182 and Sum 41. Both styles of skate punk are often used in soundtracks of skateboard videos and are prominently featured in the Tony Hawk's Pro Skater video game series soundtracks)"}, "madsrdf:citationSource": "rateyourmusic.com website, Aug. 26, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Skate rock music"}}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skate rock music"}}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Skatepunk music"}}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skatepunk music"}}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Skate core (Music)"}}, {"@id": "_:nc075d737e1a446b2b918db03cc3f01b8b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Skate core (Music)"}}], "@id": "/authorities/genreForms/gf2016026015"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026016", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFreak folk (Music)", "identifiers:lccn": "gf2016026016", "madsrdf:adminMetadata": [{"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b1"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Freak folk (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b5"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b6"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b7"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b8"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b9"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b10"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b11"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b12"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b13"}], "madsrdf:hasVariant": [{"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b14"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b17"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:21:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Freak folk (Music)"}}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(freak-folk (also freak folk): a type of folk music that uses mainly acoustic (= non-electric) instruments but includes some unusual and very modern sounds and styles)"}, "madsrdf:citationSource": "Cambridge dictionary online website, Dec. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(freak folk music)"}, "madsrdf:citationSource": "R.E.M. (Musical group). Fables of the reconstruction, \u21171985", "madsrdf:citationStatus": "found"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 191 (freak folk) p. 193 (definitive of what came to be regarded as \"freak folk\", a lo-fi mix of songs and fragments) p. 215 (attributes range from vocal quirks to an uncomfortable intimacy by way of minimalism of production and musical arrangement, to album and track structures that challenge listeners' preconceptions of popular music. The \"freakishness\" extends to the anthropomorphic and pre-industrial ideas presented in the lyrics)"}, "madsrdf:citationSource": "Encarnacao, J. Punk aesthetics and new folk, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Like so many musical genres, the parameters of 'freak folk' are ill-defined. But the ties that bind don't always seem to have a lot to do with music. Largely about reviving '60s ideology--as enshrined on LPs like Vashti Bunyan's glorious Just Another Diamond Day, which was reviled in its time for its hippyish daydreaming--the freak-folkers were sold on the imagined mythology of the hippies. ... The defining elements are often as aesthetic as they are about pure sound. Acoustic sounds are a must, and stringed instruments always work best if finger-picked. Lyrically, evoking the mythical and the pastoral is stock-in-trade. And that romanticism for the land picks up on the hippy spirit, and what might be the genre's most defining quality: sounding out of time. Defining albums: Vashti Bunyan, Just Another Diamond Day (1970); Linda Perhacs, Parallelograms (1970); Devendra Banhart, Oh Me Oh My... The Way the Day Goes By the Sun Is Setting Dogs Are Dreaming Lovesongs of the Christmas Spirit (2003); Joanna Newsom, The Milk-Eyed Mender (2004); Various, Golden Apples of the Sun (2004); Animal Collective, Sung Tongs (2004); Espers, II (2006))"}, "madsrdf:citationSource": "Carew, A. Genre profile - freak-folk, via About.com website, Aug. 26, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk song compilation, predominantly freak-folk style, with some country-folk)"}, "madsrdf:citationSource": "Work cat.: Have moicy!, 1991?, p1976", "madsrdf:citationStatus": "found"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Freak folk is a genre of folk music which uses mainly acoustic instrumentation, but introduces elements of avant-garde music, baroque pop, and psychedelic folk, often featuring uncommon sounds, lyrical themes, and vocal styles. Notable artists: Akron/Family; Angels of Light; Animal Collective; Birdengine; Bob Wiseman; Bowerbirds; Brian Smith; Cerberus Shoal; CocoRosie; Comus; The Decemberists; Devendra Banhart; Diane Cluck; Dirty Projectors; The Dodos; EMA; Exuma; Faun Fables; Futurebirds; Greg Weeks; Grizzly Bear; Hop Along; Joanna Newsom; Larkin Grimm; Rio en Medio; Sibylle Baier; Sufjan Stevens; King Buzzo; Timber Timbre; Tune-Yards; Vashti Bunyan; White Magic; Woods)"}, "madsrdf:citationSource": "Wikipedia, Aug. 26, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Fables of the Reconstruction (Fables of the Reconstruction is creepy, rustic psychedelic folk, filled with eerie sonic textures) Rough Trade Shops - Psych Folk 2010 (Rough Trade Shops - Psych Folk 2010 collects twenty one, modern day troubadours doing their best to both honor and propel the genre that inspired them. Psych-folk, freak-folk, acid folk (whatever you want to call it) has enjoyed a mild renaissance over the last decade or so)"}, "madsrdf:citationSource": "AllMusic website, Dec. 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Psychedelic folk (Psychedelic folk (sometimes acid folk or freak folk) is a loosely defined form of psychedelia that originated in the 1960s. It retains the largely acoustic instrumentation of folk, but adds musical elements common to psychedelic music; Psychedelic folk generally favors acoustic instrumentation although it often incorporates other instrumentation. Chanting, early music and various non-Western folk music influences are often found in psych folk. Much like its rock counterpart, psychedelic folk is often known for a peculiar, trance-like, and atmospheric sound, often drawing on musical improvisation and Asian influences. Its lyrics are often concerned with such subjects as the natural world, love and beauty and try to evoke a state of mind associated with the effects of psychedelic drugs; Freak folk is a loosely defined synonym or subgenre of psychedelic folk which involves acoustic sounds, pastoral and delightful lyrics, and a neo-hippie aesthetic)"}, "madsrdf:citationSource": "Wikipedia, Dec. 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Freak Folk is a style that uses mainly acoustic instruments; mostly guitar (often in alternate tunings) and occasionally violin or flute, accompanied by percussion instruments such as bongos. Used correctly, it tends to refer to music with long instrumental/psychedelic passages (and that may utilize drones), or \"poppier\" folk music with elaborately baroque, psychedelic or oppressive atmospheres. It is a term associated with contemporary artists like Joanna Newsom, Cocorosie, Six Organs of Admittance, Akron/Family, Rio en Medio, Charalambides, and with '60s Acid Folk artists like the Holy Modal Rounders, The Incredible String Band, Tyrannosaurus Rex, The Godz and The Fugs.)"}, "madsrdf:citationSource": "Last.fm website, Aug. 26, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Acid folk (Music)"}}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Acid folk (Music)"}}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psych folk (Music)"}}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psych folk (Music)"}}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psychedelic folk (Music)"}}, {"@id": "_:n6564afb720e7411b8c569b2ed2f9a0f3b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psychedelic folk (Music)"}}], "@id": "/authorities/genreForms/gf2016026016"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026017", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aErasure poetry", "identifiers:lccn": "gf2016026017", "madsrdf:adminMetadata": [{"@id": "_:na301714a49a547778a8ce6d692514a44b1"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Erasure poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:na301714a49a547778a8ce6d692514a44b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026346"}, "madsrdf:hasSource": [{"@id": "_:na301714a49a547778a8ce6d692514a44b5"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b6"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b7"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b8"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b9"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b10"}], "madsrdf:hasVariant": {"@id": "_:na301714a49a547778a8ce6d692514a44b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na301714a49a547778a8ce6d692514a44b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:12:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Erasure poetry"}}, {"@id": "_:na301714a49a547778a8ce6d692514a44b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "colophon (Eighty copies of this erasure were printed)"}, "madsrdf:citationSource": "Work cat.: Ruifle, M. No woman in her senses, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Mary Ruefle on erasure (An erasure is the creation of a new text by disappearing the old text that surrounds it)"}, "madsrdf:citationSource": "Sue Rainsford's website, Mar. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (Erasure poetry is fast becoming a popular form of poetry) What is erasure poetry? (Erasure poetry is a form of found poetry created by erasing words from an existing text in prose or verse and framing the result on the page as a poem. The results can be allowed to stand in situ or they can be arranged into lines and/or stanzas.)"}, "madsrdf:citationSource": "Erasure poetry blog, viewed on Mar. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (Erasures; Erasure is a process by which you can take any text and from it, create a poem)"}, "madsrdf:citationSource": "Erasures website, Mar. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Erasure and blackout poems by Robert Lee Brewer (A blackout poem is when a poet takes a marker (usually black marker) to already established text--like in a newspaper--and starts redacting words until a poem is formed. The key thing with a blackout poem is that the text AND redacted text form a sort of visual poem. An erasure poem is any poem that sculpts itself out of another larger text. The blackout poem is an erasure poem. Some erasure poems work with or against the original text; some erasure poems look for completely new and unrelated meanings than the original text; and some erasure poems are just complete nonsense.)"}, "madsrdf:citationSource": "Writer's Digest website, Mar. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Erasure (artform) (Erasure is a form of found poetry or found art created by erasing words from an existing text in prose or verse and framing the result on the page as a poem. The results can be allowed to stand in situ or they can be arranged into lines and/or stanzas. Erasure is a way to give an existing piece of writing a new set of meanings, questions, or suggestions; erasure poems)"}, "madsrdf:citationSource": "Wikipedia, Mar. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:na301714a49a547778a8ce6d692514a44b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na301714a49a547778a8ce6d692514a44b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Blackout poetry"}}, {"@id": "_:na301714a49a547778a8ce6d692514a44b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blackout poetry"}}], "@id": "/authorities/genreForms/gf2016026017"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDance drama", "identifiers:lccn": "gf2016026018", "madsrdf:adminMetadata": [{"@id": "_:n91307a29c11945b4b8e0305b51ebce91b1"}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dance drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n91307a29c11945b4b8e0305b51ebce91b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026020"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026023"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026024"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026025"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026029"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026030"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026033"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026035"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026036"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026039"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026040"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026060"}], "madsrdf:hasSource": [{"@id": "_:n91307a29c11945b4b8e0305b51ebce91b5"}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b6"}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b7"}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b8"}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:12:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dance drama"}}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dance drama: a drama in which all the action is expressed by dancing)"}, "madsrdf:citationSource": "Oxford dictionaries website, Oct. 30, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dance drama. Some theatrical traditions incorporate dance to such an extent that they are typically termed \"dance-dramas.\" Of these traditions, the wayang wong and wayang topeng (masked theatre) of Java and Bali, as well as the Balinese plays recounting the tale of the witch Calonarang, are among the most widely known; India has evolved through its classical and folk traditions a type of dance drama that is a form of total theatre. The actor dances out the story through a complex gesture language, a form that, in its universal appeal, cuts across the multilanguage barrier of the subcontinent)"}, "madsrdf:citationSource": "Encyc. Britannica online, Oct. 30, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 943 (dance-drama; dance play)"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985:", "madsrdf:citationStatus": "found"}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dance drama: drama conveyed by dance movements sometimes accompanied by dialogue)"}, "madsrdf:citationSource": "Merriam-Webster online dictionary, Oct. 30, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n91307a29c11945b4b8e0305b51ebce91b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dance drama: drama performed through dance movements, frequently with dialogue)"}, "madsrdf:citationSource": "Dictionary.com, Oct. 30, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026018"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026019", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBurrakatha plays", "identifiers:lccn": "gf2016026019", "madsrdf:adminMetadata": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b1"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Burrakatha plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, "madsrdf:hasSource": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b5"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b6"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b7"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b8"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b9"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b10"}], "madsrdf:hasVariant": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b11"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b14"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b17"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b20"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b23"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b26"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b29"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b32"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Telugu folk plays that combine dances, recitations, and songs to relate the narrative."}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Burrakatha plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Burrakatha is the most popular form of narrative entertainment in the state of Andhra Pradesh. In this theatrical form, a storyteller accompanied by his partner gives recitals for two or three days. He sings dances and recites a story, before the people of a village under the patronage of a village elder. Performance begins in the evening with devotional songs in praise of various celestial beings. Then the performer introduces the main story by establishing the place, time and historical context of the action. During this the rajkiya and hasyam repeat the refrain of the narrative. When the introduction is concluded, the main plot begins in which all three perfomers take an active role assuming various characters in the incidents, as well as providing narrative bridges between incidents. Dance, recitation, song and enactment of scenes provide variation within a strong narrative line. Generally a story continues for two to three hours. A longer work may be serialized into several consecutive evenings. Burrakatha stories fall into three categories - mythological, historical and sociopolitical. Although the form was originally improvised, today popular stories have been written down and committed to memory by performers.)"}, "madsrdf:citationSource": "Nrityanjali Academy folk theatre website, May 13, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Burra katha, also spelled burrakatha or burrakathe; a narrative entertainment that consists of prayers, solo drama, dance, songs, poems and jokes. The topic will be either a Hindu mythological story or a contemporary social problem)"}, "madsrdf:citationSource": "Wikipedia, Apr. 23, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(entry: Burrakatha; narrative folk form from Andhra Pradesh featuring a burra (tambura) and gummetas (2 small one-sided earthen drums) to accompany the singing)"}, "madsrdf:citationSource": "The Oxford companion to Indian theatre, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Burrakatha, 200-?", "madsrdf:citationStatus": "found"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Burrakatha is a Telugu art of story telling. In the coastal Andhra region, burrakatha is called jangam katha. In Telangana, it is also known as tamboorakatha or saradakatha. In Rayalaseema, it is known as Tandana katha or suddulu. Usually, this art is practiced by a team of two or three people from the same family of certain castes/tribes like picchuguntla or jangalu. Burrakatha narrators are also known as Saradagallu. In this form of narration the main storyteller tells the story while playing a tambura (a stringed instrument) and dancing wearing andelu (anklets). One or two associates or sidekicks assist the narrator with small drums called gummeta or budike. Telangana narrators use budige tambura, while Rayalaseema and Andhra narrators use padige tambura with a hood. Some use brass drums and others use earthen drums. Telangana narrators consider their tambura as goddess Sarada and hence they are known as Saradagallu. Telangana narrators do the performance while sitting, where as Andhras tell stories while standing. In Rayalaseema the main narrator tells the story while holding a stick, while his associates play tambura and drums; During the independence movement (first half of 20th century) in the Indian continent, Burrakatha was brought into mainstream in Andhra Pradesh and was used for political purposes.)"}, "madsrdf:citationSource": "Burrakatha, via Vepachedu website, May 13, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The ancient art form of Burrakatha, practised for ages by travelling minstrels, popularly known as Jangams - a gypsy tribe; A popular art form in the coastal districts of Andhra Pradesh, Burrakatha was once used as a medium to awaken people, especially during the freedom struggle; The art form was widely used by the communist revolutionaries of Telangana to obtain converts to the movement with great success. Today, Burrakatha is a reflection of debasement and debauchery, actively influenced by the film industry. Raunchy and suggestive numbers have replaced the rustic folk songs of yore, much to the chagrin of connoisseurs; first start by choosing a theme from the Mahabharata and the Ramayana and then incorporate these numbers into the narration. The first ten minutes of the show and the rest of it that follows have nothing in common)"}, "madsrdf:citationSource": "Burrakatha loses sheen sans patronage, via The times of India website, May 13, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tandana katha plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tandana katha plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Burra katha plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Burra katha plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Burrakatha drama"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Burrakatha drama"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Burrakathe plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Burrakathe plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suddulu plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suddulu plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Saradakatha plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Saradakatha plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jangam katha plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jangam katha plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tamboorakatha plays"}}, {"@id": "_:na86179d36a4b48bc9f64b0d251c3ee95b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tamboorakatha plays"}}], "@id": "/authorities/genreForms/gf2016026019"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026020", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCalonarang plays", "identifiers:lccn": "gf2016026020", "madsrdf:adminMetadata": [{"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b1"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Calonarang plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018"}], "madsrdf:hasSource": [{"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b5"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b6"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b7"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b8"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b9"}], "madsrdf:hasVariant": [{"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b10"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b13"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b16"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Balinese dance dramas that feature a magically powerful widow whose black magic must be defeated."}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Calonarang plays"}}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Calonarang dance; drama of Calon Arang, the widow-witch of Girah; the story has many variations and no two Calon Arang plays are exactly the same)"}, "madsrdf:citationSource": "Balivision.com home page, Aug. 17, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Calonarang Dance refers to the struggle between Rangda (Calonarang) and the great king Airlangga. Calonarang was a widow of Girah who gave birth to a daughter in the jungle. Her daughter grew up to be the famed beauty Ratna Menggali. Calonarang wanted her daughter to marry a prince from Airlanggas palace. However, no prince came along. Infuriated by this, Calonarang learned the art of black magic and practiced it against the kingdom, causing many people to die. When the king Airlangga heard of the epidemic in Girah, he consulted his high priest, Mpu Bharadah. The priest then sent his son to propose Ratna Menggali. Calonarang was pleased, the curse ended, and the couple wed. Calonarang inscribed her black magic secret on a lontar (palmleaf book). One day, her son-in-law found it and gave it to his father. When Calonarang found out that Mpu Bharadah had learned her secrets, she was furious and declared war upon him. The priest had no choice but to fight and, in a deadly struggle, destroyed the widow by casting a spell. Before she died, Calonarang asked forgiveness. Mpu Bharadah forgave her and showed her the way to heaven. Before Calonarang Dance is performed by midnight, the audiences are gathered, listening to the Calonarang music, played by a full legong orchestra amplified with large bamboo flutes.)"}, "madsrdf:citationSource": "Calonarang dance, via Bali Sky Tour website, May 13, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Two mythical beings are ever-present in Bali. They can be seen in travel advertisements and postcards, and their colourful masks are sold everywhere as souvenirs. They are Barong, resembling a lion with its long mane, and the witch Rangda with matted hair and large tusks. ... The mythology of Barong and Rangda is complex and anything but unequivocal. They often have leading roles in village events and drama performances, of which the best known is the Calonarang, based on an East Javanese legend. ... The Calonarang is probably one of the best-known forms of drama, in which Barong and Rangda play central roles. It is an ancient East Javanese text in the Kawi language, and was originally influenced by Indian tantric teachings. It tells of a Javanese princess who controlled her spouse, a weak Balinese king, by means of black magic. In Bali the text was first converted into drama form in the 1890s, and it soon established its position as a central form of drama. According to Balinese custom, this new dance-drama employed existing histrionic conventions. The various scenes of the original Calonarang drama are performed in the village temple and in various parts of the village, at road crossings, and in the cemetery. For the Balinese, black magic--the central theme of the Calonarang drama--is living reality, and some communities on the island still practise it. The Calonarang is a form of theatre laden with magical meaning, and was originally meant to ward off an epidemic. The plot is constructed as follows: Calonarang, the widow of Girah (played by a male priest in trance), a practitioner of black magic possessing two very powerful books, is furious because no one dares to marry her daughter. To avenge this wrong, the widow intends to destroy the kingdom with an epidemic brought about by black magic. She directs her pupils in a magic ritual. Young maidens with flowing hair and white costumes perform a strange dance, a kind of negative version of Balinese classical dance. News of the widow's intentions has spread throughout the island, and the king decides to send his prime minister to fight the widow. The king instructs his minister, who then goes on with his retinue to meet the witch. The magical rite directed by the widow is approaching its climax when the prime minister arrives at the scene. The widow now appears in the shape of the furious Rangda, refusing to bow to the minister's demands. A battle is inevitable. Rangda falls into a trance and incites everyone to attack her. Calonarang includes long comic scenes, where clowns, speaking in the vernacular, comment on the proceedings, entertaining the audience with their obscene humour. The Akademi Seni Tari Indonesia has created a shortened version of the Calonarang, from which the ritual elements have been excluded.)"}, "madsrdf:citationSource": "Barong, Rangda, and Calonarang, via Asian traditional theatre & dance website, May 13, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCSH (Calonarang plays)", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Calonarang (Indonesia): A Balinese dance-drama, created c. 1890, that provides a dramatic frame for the appearance of a magically powerful widow (rangda). It is given in a special performance area (kalangan), prepared at a graveyard or a cross-roads where danger lurks. Also spelled chalonarang or tjalonarang. Cross reference to Wayang calonarang, which is the telling of the story with puppets instead of masked actors)"}, "madsrdf:citationSource": "An international dictionary of theater language, c1985", "madsrdf:citationStatus": "found"}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Calonarang drama"}}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Calonarang drama"}}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chalonarang plays"}}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chalonarang plays"}}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Calon Arang plays"}}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Calon Arang plays"}}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tjalonarang plays"}}, {"@id": "_:nd6a4ec8e7d2242a68ad98bcd73276566b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tjalonarang plays"}}], "@id": "/authorities/genreForms/gf2016026020"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026021", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJ\u014druri (Music)", "identifiers:lccn": "gf2016026021", "madsrdf:adminMetadata": [{"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b1"}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "J\u014druri (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasSource": [{"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b5"}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b6"}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b7"}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b8"}], "madsrdf:hasVariant": {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Japanese dramatic narratives chanted or sung to the accompaniment of a shamisen."}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "J\u014druri (Music)"}}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCSH (J\u014druri. UF Giday\u016b. BT Japanese drama. BT Monologue. BT Monologues with music (Shamisen))", "madsrdf:citationStatus": "found"}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(J\u014druri, in Japanese literature and music, a type of chanted recitative that came to be used as a script in bunraku puppet drama. Its name derives from the J\u014drurihime monogatari, a 15th-century romantic tale, the leading character of which is Lady J\u014druri. At first it was chanted to the accompaniment of the four-string biwa (Japanese lute); with the introduction of the three-stringed, plucked samisen (or shamisen) from the Ry\u016bky\u016b Islands in the 16th century, both the music and the scripts became more complex. When puppets were added at the end of the 16th century, the j\u014druri expanded to add a dramatic quality not present in the first simple recitatives. Themes of loyalty, vengeance, filial piety, love, and religious miracles were included; dialogue and descriptive commentary took an increasingly large role. The chanter was at first more important than the writer of the script, until the appearance of one of Japan's greatest playwrights, Chikamatsu Monzaemon, in the late 17th and early 18th centuries. A 30-year collaboration between Chikamatsu and the chanter Takemoto Giday\u016b (1651-1714) raised the puppet theatre to a high art. Giday\u016b himself became so famous that his style, giday\u016b-bushi (\"Giday\u016b music\"), became nearly synonymous with j\u014druri. J\u014druri are performed by one or more chanters (tay\u016b). One of the world's most highly developed forms of narrative music, j\u014druri is still popular as music, even when separated from the stage.)"}, "madsrdf:citationSource": "Encyclopedia Britannica online, Mar. 11, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(J\u014druri (music). J\u014druri is a form of traditional Japanese narrative music in which a tay\u016b sings to the accompaniment of a shamisen. As a form of storytelling, the emphasis is on the lyrics and narration rather than the music itself.)"}, "madsrdf:citationSource": "Wikipedia, Mar. 11, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(joruri (Japanese) 1. The generic term for a number of related musical styles of dramatic narrative accompanied by shamisen music. Included are gidayu in bunraku, and takemoto, tokiwazu, kiyomoto, and tomimoto in kabuki. 2. A puppet play accompanied by joruri style music. 3. A kabuki dance play that uses joruri music.)"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Giday\u016b (Music)"}}, {"@id": "_:n50e303ea7d3b422e91bb1b1c5df4cb48b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Giday\u016b (Music)"}}], "@id": "/authorities/genreForms/gf2016026021"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026022", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKamishibai plays", "identifiers:lccn": "gf2016026022", "madsrdf:adminMetadata": [{"@id": "_:na5adbbb9cf974f79892c8322bff31631b1"}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kamishibai plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:na5adbbb9cf974f79892c8322bff31631b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:na5adbbb9cf974f79892c8322bff31631b5"}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b6"}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b7"}], "madsrdf:hasVariant": [{"@id": "_:na5adbbb9cf974f79892c8322bff31631b8"}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Japanese stories told with cards that have pictures on one side for the audience, and the story and stage directions for the storyteller on the reverse side."}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-02T16:16:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kamishibai plays"}}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kamishibai plays. BT Children's plays)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kamishibai is Japanese for \"Paper Theaters.\" Kamishibai is an old traditional form of storytelling from Japan . One man I interviewed said he had many happy memories of the storyteller who rode a bicycle to a park every week. On the back of his bicycle was a box containing many different stories, each on a large card. There also was a \"stage\" to display the cards. He would announce his arrival by using wooden clappers. The storyteller would put the cards in the wooden framed \"stage\" and show them front card's picture. He would dramatically tell a story, revealing the next card by moving the front card to the back. This would continue until reaching the end of the story which was usually a cliff-hanger designed to ensure an audience the next week.)"}, "madsrdf:citationSource": "Kamishibai (Japanese card-stories), via Progress Elementary, Central Valley School District website, Nov. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Storycard Theater books are printed in Japanese kamishibai format--sturdy cards with colorful art on the front for the audience and dramatic text on the back for you. With kamishibai (literally \"paper theater\") you can read to a group of children while showing them the pictures. The kamishibai format is part of a long tradition of visual storytelling. As far back as the 12th century, Buddhist monks traveled Asia with picture scrolls to enhance their stories and lectures. The modern kamishibai format debuted in downtown Tokyo during the Great Depression, when thousands of people were suddenly looking for work. Between the 1930s and 1950s in Japan, it was common to see kamishibai storytellers in parks, fields, or on street corners--wherever children gathered. Riding up on bicycles with a small wooden stage mounted on the back, these enterprising men sold candies and snacks to the children, and then launched into a dramatic performance. It's estimated there were once 50,000 kamishibai storytellers in Japan. Unfortunately, as television began to lure children indoors, these storytellers gradually disappeared.)"}, "madsrdf:citationSource": "Storycard Theater website, Nov. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na5adbbb9cf974f79892c8322bff31631b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kamishibai drama"}}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kamishibai drama"}}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na5adbbb9cf974f79892c8322bff31631b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Paper drama"}}, {"@id": "_:na5adbbb9cf974f79892c8322bff31631b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paper drama"}}], "@id": "/authorities/genreForms/gf2016026022"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026023", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKamy\u014fn'g\u016dk plays", "identifiers:lccn": "gf2016026023", "madsrdf:adminMetadata": [{"@id": "_:nab938804b626485ea7832f39de3a4288b1"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kamy\u014fn'g\u016dk plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nab938804b626485ea7832f39de3a4288b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018"}], "madsrdf:hasSource": [{"@id": "_:nab938804b626485ea7832f39de3a4288b5"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b6"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b7"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b8"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b9"}], "madsrdf:hasVariant": [{"@id": "_:nab938804b626485ea7832f39de3a4288b10"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Traditional Korean masked dance dramas."}, {"@id": "_:nab938804b626485ea7832f39de3a4288b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kamy\u014fn'g\u016dk plays"}}, {"@id": "_:nab938804b626485ea7832f39de3a4288b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kamy\u014fn'g\u016dk plays)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kamy\u014fn'g\u016dk \u016di chonghapch\u014fk koch'al, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kamy\u014fng\u016dk. A term that covers all versions of masked dance-drama in Korea, the country's most pervasive form of traditional performance; can be classified into two main types: various masked dance styles, collectively known as sandaeg\u016dk (mountain play); and village-festival masked dance forms. Despite regional differences, performance elements common to all sandaeg\u016dk styles include masks, dance, song, music, pantomime, and dialogue. The plays are anonymous and transmitted orally, though since the 1960s performances have been recorded, transcribed, and published. In rural villages, masked dance-dramas are still performed at festivals at the New Year, Tano (5 May), and other special occasions of the lunar calendar.)"}, "madsrdf:citationSource": "The Oxford encyclopedia of theatre & performance, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ch\u014fn, K. Han'guk kamy\u014fn'g\u016dk. English. Korean mask dance dramas, 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nab938804b626485ea7832f39de3a4288b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab938804b626485ea7832f39de3a4288b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sandaeg\u016dk plays"}}, {"@id": "_:nab938804b626485ea7832f39de3a4288b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sandaeg\u016dk plays"}}, {"@id": "_:nab938804b626485ea7832f39de3a4288b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab938804b626485ea7832f39de3a4288b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kamy\u014fn'g\u016dk drama"}}, {"@id": "_:nab938804b626485ea7832f39de3a4288b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kamy\u014fn'g\u016dk drama"}}], "@id": "/authorities/genreForms/gf2016026023"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026024", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKh\u014dn plays", "identifiers:lccn": "gf2016026024", "madsrdf:adminMetadata": [{"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab1"}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kh\u014dn plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018"}, "madsrdf:hasSource": [{"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab5"}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab6"}], "madsrdf:hasVariant": [{"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab7"}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab10"}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab13"}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab16"}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Thai dance dramas that are traditionally performed in the royal court by men in masks who are accompanied by narrators and a traditional p\u012bph\u0101t ensemble."}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-07-13T14:04:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kh\u014dn plays"}}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kh\u014dn (Dance drama))"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(khon (Thai) Classical masked ballet primarily of Ramakien (Ramayana) episodes, danced by a male cast to chanted narrative and pi phat musical accompaniment. Khon originated in the 16th C or earlier. Khon luang (royal khon) was supported at the king's court in the 17th C. Khon klan klang plaeng (open-air khon) emphasizes battles and recitation (kampak). In khon rong nai ('inner' or palace khon) songs are drawn from lakon fai nai and actresses perform roles of women (for example, Sida/Sita) and refined men (for example, Rama). Khon na cho, khon na jaw (khon-before-a-screen) is a version in which the dancer-actors are silhouetted against a white cloth screen)"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kh\u014dn drama"}}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kh\u014dn drama"}}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Khon na cho, khon na jaw plays"}}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Khon na cho, khon na jaw plays"}}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Khon luang plays"}}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Khon luang plays"}}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Khon rong nai plays"}}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Khon rong nai plays"}}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Khon klan klang plaeng plays"}}, {"@id": "_:n35b616100ab54f288bcb4315a7ca5f9ab20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Khon klan klang plaeng plays"}}], "@id": "/authorities/genreForms/gf2016026024"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026025", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aK\u014dlam drama", "identifiers:lccn": "gf2016026025", "madsrdf:adminMetadata": [{"@id": "_:n7b792dac15c443e794ec7ace17b4405fb1"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "K\u014dlam drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7b792dac15c443e794ec7ace17b4405fb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018"}], "madsrdf:hasSource": [{"@id": "_:n7b792dac15c443e794ec7ace17b4405fb5"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb6"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb7"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb8"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb9"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Traditional masked dance dramas from southern Sri Lanka that are performed by male actors."}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "K\u014dlam drama"}}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 17, pp. 168-169 (k\u014dlam, one of the 4 folk-drama forms of Sri Lanka)"}, "madsrdf:citationSource": "Britannica Macro.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mask dancing or Kolam, a theatrical form as found in south Sri Lanka; a series of narratives dramatically enacted by various types of kinetic players who wear masks)"}, "madsrdf:citationSource": "Mahendra, S. Sinhala kolam tradition, via Daily news online edition, 6 Nov. 2001, viewed Mar. 11, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(K\u014dlam (Folk drama). BT Folk drama, Sinhalese)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kolam is a dance drama of rural Sri Lanka. Just like several other names for theatre traditions of south Asia, kolam refers to disguise and mimicry. The actors wear masks and costumes and perform with mime, dance and some dialogue. The characters are divided into several types: humans (for example, princes, the drummer and his wife, the European), animals and demons, and the performances move from the depiction of village scenes to stories involving spirits and fabulous creatures from Hindu mythology.)"}, "madsrdf:citationSource": "Kolam dancer's mask, via British Museum website, Mar. 11, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b792dac15c443e794ec7ace17b4405fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kolam is a kind of dramatic and colorful performance which was considered to be a very popular traditional dance drama in the Southern and South Western parts of Sri Lanka about three/four decades ago. According to historical evidence, Kolam drama has existed from the time of 5th century B.C. With regard to some legends, it is said that this genre of drama has a history spanning more than 2500 years; Kolam plays; The main distinguishing feature of the Kolam play is that the all performers wear masks, except for two of the characters: Kariyakarawanarala [Sabevidane] (the chief narrator) and Sabhapathi (actors who welcome the audience). Yet another notable factor is that all the characters in the plays, including the female roles, are performed by male actors. There are various kinds of masks that are compatible with the different types of character representations. The following is a list of the different types of masks used in the Kolam plays: Masks depicting: Gods; Human beings; Raksha; Demons; Animals; Mythological creatures and beings)"}, "madsrdf:citationSource": "Traditional kolam drama of Sri Lanka, via WWW, Mar. 11, 2013", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026025"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026026", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKot\u00e9ba plays", "identifiers:lccn": "gf2016026026", "madsrdf:adminMetadata": [{"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb1"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kot\u00e9ba plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}], "madsrdf:hasSource": [{"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb5"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb6"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb7"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb8"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb9"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb10"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb11"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb12"}], "madsrdf:hasVariant": {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb13"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Bambaran comic plays consisting of chants, dance, mime, burlesques, and satires."}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kot\u00e9ba plays"}}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 9 (Kot\u00e8ba; a traditional Malian form of theatrical expression)"}, "madsrdf:citationSource": "Bagayoko, A. Kolok\u00e8len, c1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(koteba (Bambara) In Senegal and Mali, farcical comedies traditionally performed by young men's societies.)"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 61 (Kot\u00e9ba of the Bambara)"}, "madsrdf:citationSource": "The Cambridge guide to African and Caribbean theatre, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Schubert J. Family planning uses traditional theater in Mali: While comical, the Koteba generally deals with social issues--it informs and entertains; Mali's traditional theater form)"}, "madsrdf:citationSource": "PubMed, Mar. 11, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 3, p. 103 (traditional Malian kot\u00e9ba; Bambara)"}, "madsrdf:citationSource": "The world encyc. of contemporary theatre, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kot\u00e9ba. BT Bambara drama)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Mali: the kot\u00e9ba of central and southern Mali; performed in public and at popular feasts, it presents satirical sketches on stereotyped subjects and characters; combines mime, dialogue, song and puppetry to produce what is widely agreed to be the most total art form of the Bambara people)"}, "madsrdf:citationSource": "Banham, M. The Cambridge guide to theatre, 2000, via Google books, viewed Mar. 11, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Koteba is a traditional form of theatrical expression in Mali. It is adapted to all kinds of stages but most particularly to the \"round stage.\" In Koteba theater, everybody can be simultaneously spectator and actor. In fact, it is a way to expose the defects and various conduct of the leaders.)"}, "madsrdf:citationSource": "[Interview of] Ma\u00efmouna H\u00e9l\u00e8ne Diarra, via Centre for the Study and Research of African Women in Cinema website, Mar. 11, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kot\u00e9ba drama"}}, {"@id": "_:nd52c3aa528d24a129a53637dd1eddadeb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kot\u00e9ba drama"}}], "@id": "/authorities/genreForms/gf2016026026"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026027", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aK\u014dwaka drama", "identifiers:lccn": "gf2016026027", "madsrdf:adminMetadata": [{"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b1"}, {"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "K\u014dwaka drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b5"}, {"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b6"}, {"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Japanese ballad-dramas of the 16th and 17th centuries that consist of epic material intended for a samurai audience."}, {"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "K\u014dwaka drama"}}, {"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(K\u014dwaka plays)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 545 (K\u00f4waka: ballad-dramas of Japan's Heroic Age. The k\u00f4waka is a composite performed art that was prized equally with the n\u00f4 drama by the warring samurai of the sixteenth century; recounted the pathos of the samurai of bygone eras; recited stirring tales that recount the heroics and tragedies of the epic struggle during the twelfth century between the Genji and the Heike. The librettos for k\u00f4waka were preserved for posterity in the Texts for K\u00f4waka Dances (Mai no hon), an anthology of thirty-six standard pieces originally compiled in the early seventeenth century and published as prose narratives. Only as a result of the reprinting of the Mai no hon in 1900 were most students of Japanese literature and drama made aware of the fact that such a form of art had existed. Judging from the fact that the names k\u00f4waka and kusemai were often used interchangeably, we can assume that the k\u00f4waka was related historically to the kusemai, an entertainment form which flourished as early as the fourteenth century. Historians who have attempted to clarify this relationship were primarily concerned with proving the mean social status of the performers or establishing the essentially plebeian nature of the k\u00f4waka, and they neglected to examine the actual content of the art. Some of them chose to regard k\u00f4waka as a variant name for kusemai, a form of art that was usually performed by women and boys for audiences which were attracted primarily by the sensual charm of the performers. Others decided that k\u00f4waka referred simply to a particular troupe of performers of the kusemai. In effect, they lumped together under a single generic label forms which catered to widely diverse levels of audiences and which aimed at quite different ends in esthetic expression; k\u00f4waka flourished in the sixteenth and seventeenth centuries; intended for a samurai audience; might best be described as a ballad-drama with librettos consisting of epic material)"}, "madsrdf:citationSource": "Journal of the American Oriental Society, Oct.-Dec. 1962:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbdb5c363f2cd44718908c3ca07cf66c1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(K\u014dwaka is one of the many traditional Japanese art forms combining story telling with music. It is often equated with kusemai, another early fourteenth century art form where singing of literary texts is combined with song and dance. All we know today of the music in kusemai is by means of the great Zeami (1363-1443) who wrote of the importance of a beat underlying a \"melody that progresses lightly on the beat\". Regretfully, that tells us very little about how kusemai or k\u014dwaka actually sounded. Zeami's father, Kannami (1333-1384) however, was so impressed by the lyrics of the kusemai, that he incorporated them into the still well-known n\u014d theatre. Momonoi Naoaki (ca 1395-1470), better known as Kowakamaru, is credited with the creation of k\u014dwaka. Although in essence an oral art, the librettos for k\u014dwaka were preserved for posterity in the Texts for K\u014dwaka Dances (Mai no hon), an anthology of thirty-six standard pieces originally compiled in the early seventeenth century. Most of these stories were historical and tell of great deeds in battle and are taken from the Tale of the Heike (Heike Monogatari), Japan's endless source of epic heroism.)"}, "madsrdf:citationSource": "K\u014dwaka, via Things Japanese website, Nov. 16, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026027"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026028", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKuai shu", "identifiers:lccn": "gf2016026028", "madsrdf:adminMetadata": [{"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab1"}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kuai shu"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab5"}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab6"}], "madsrdf:hasVariant": [{"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab7"}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab10"}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab13"}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab16"}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab19"}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kuai shu"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kuaiban or kuai ban (literally \"fast boards\" or \"Bamboo Talk\" in Chinese), pronounced kuaibanr in Beijing and also known as kuai shu (\"fast books\"), is a variety of shuochang, or oral storytelling performance popular in northern China.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 3, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kuai shu. UF Kuaishu; Shandong kuai shu; Tzu ti shu; Zi di shu)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shandong kuai shu"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shandong kuai shu"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tzu ti shu"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tzu ti shu"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kuaiban"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kuaiban"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kuai ban"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kuai ban"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Zi di shu"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zi di shu"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kuaishu"}}, {"@id": "_:nd0280b37af3f4f8ea40610ccc858532ab23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kuaishu"}}], "@id": "/authorities/genreForms/gf2016026028"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026029", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKur\u0332ava\u00f1ci plays", "identifiers:lccn": "gf2016026029", "madsrdf:adminMetadata": [{"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab1"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kur\u0332ava\u00f1ci plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026585"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018"}], "madsrdf:hasSource": [{"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab5"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab6"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab7"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab8"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab9"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab10"}], "madsrdf:hasVariant": [{"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab11"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab14"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab17"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab20"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab23"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Tamil musical dance dramas from the 17th and 18th centuries that are composed in verse and depict both divine and human love."}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kur\u0332ava\u00f1ci plays"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 467 (The folk varieties of drama viz. Pa\u1e37\u1e37u, Kur\u0332ava\u00f1ci and No\u1e47\u1e6di plays were composed in verses. These poetic plays had their own metre quite different from the lyrics and k\u0101vyas of the earlier Tamil works.) pp. 470-471 (Early types of drama in verse. Kur\u0332ava\u00f1ci: A play of the village masses. This type of drama is intended for the people of hilly tracts. The first and foremost of Kur\u0332ava\u00f1ci was written in the 18th century; Kur\u0332ava\u00f1ci plays; were enacted in the mandapams inside the temples since most of them were in praise of some God.)"}, "madsrdf:citationSource": "Literary heritage of the Tamils, 1981:", "madsrdf:citationStatus": "found"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 364-365 (The purely Tamil dramatic varieties that have survived the havoc of time are vanchi and pallu; kura vanchi; kuravanchi; kuravanji; belongs to the general class of street dramas, a style of performance which still goes on, though unhappily fast dying out.)"}, "madsrdf:citationSource": "Purnalingam Pillai, M.S. Tamil literature, 1985:", "madsrdf:citationStatus": "found"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 224-227 (Kur\u0332ava\u00f1ci (alias kur\u0332am or kur\u0332attipp\u0101\u1e6d\u1e6du). This form was very productive between ca. 1650/1670-1830, developed from the erotic but sublimated 'ballets' that sprang up in Tamil\u0332n\u0101\u1e0du in the late middle ages when local feudal lords, landholders, and temple managers began to utilize courtesan-dancers of temples and towns as instruments of entertainment. Several danceuses participated to enact the story woven around a stereotype plot: a young girl, or a courtesan, playing with her companion, would chance to see the local lord, or the god-image carried in procession, and fall in love with him. Lovesick, she would invite a soothsaying Kur\u0332ava woman to foretell her the future. The handmaid would then carry a love-message, and the god or chieftain would appear in disguise before the girl to woo her. She would not yield, being steadfast in her love; satisfied with her fidelity, the god or the lord would reveal himself and marry her. These 'ballets' were enacted by an all-female cast, consisting of courtesans who rendered the play in pantomime in appropriate costumes. The vocalist of the orchestra sang the songs composed in various metres as substitute for dialogues. This art-form has not survived the first half of the 19th century, but it was revived in the middle of the 20th century by modern dancers and art savants. The songs used as dialogue-substitute developed in the hands of skillful poets into an important and very productive genre, of which the first so far discovered seem to be Ve\u1e45ka\u1e37appa N\u0101yakkar kur\u0332ava\u00f1ci by Cir\u0332r\u0332ampalakkavir\u0101yar (1647/8), and the anonymous Ta\u00f1caive\u1e37\u1e37aippi\u1e37\u1e37aiy\u0101r kur\u0332ava\u00f1ci, which belongs almost certainly to the 2nd half of the 17th century; central theme is that of human and divine love, and the traditional street play is clad in fine poetry and sensuous imagery; dramatic poem; musical dance-drama; kur\u0332ava\u00f1ci plays; the characters of all kur\u0332ava\u00f1cis and pa\u1e37\u1e37us are only types and not individual persons)"}, "madsrdf:citationSource": "Zvelebil, K.V. Tamil literature, 1974:", "madsrdf:citationStatus": "found"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 140 (among the genres which \"incorporate\" the subject of the royal procession are the kur\u0332ava\u00f1ci, the vil\u0101cam, and the k\u0101tal; in the kur\u0332ava\u00f1ci and the vil\u0101cam genres, the royal procession provides the point of departure for the entire plot. The heroine falls in love with the king, as she sees him one day riding in procession. She would probably not have been able to see him otherwise, as access to the court was usually limited. But unlike the ul\u0101, which provides a classified inventory of possible emotional reactions to the fateful encounter, the kur\u0332ava\u00f1ci and the vil\u0101cam focus on an individual poetic persona and her specific emotions.)"}, "madsrdf:citationSource": "Ebeling, S. Colonizing the realm of words, c2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 254-255 (Kur\u0332ava\u00f1ci; known also as kur\u0332attipp\u0101\u1e6d\u1e6du or kur\u0332am; literary genre which had the following set pattern: The heroine sees the hero walking or being carried in procession and falls in love with him; she suffers greatly from her desire; she invites the kur\u0332atti to foretell her future; then the ku\u1e37avan\u0332 or kur\u0332avan\u0332 will appear, and enjoys the embrace of the kur\u0332atti. We have thus, in this literary genre, two kinds and two levels of love: the ideal hero and heroine, who are engaged in the pursuit of future love, so far unfulfilled; and the folk-characters, enjoying their love in the present. Sometimes there are important variations.) p. 257 (kur\u0332ava\u00f1ci plays; kur\u0332ava\u00f1ci poems)"}, "madsrdf:citationSource": "Zvelebil, K.V. Tamil literature, 1975:", "madsrdf:citationStatus": "found"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kur\u0332ava\u00f1ci plays)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kur\u0332am plays"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kur\u0332am plays"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kur\u0332ava\u00f1ci poems"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kur\u0332ava\u00f1ci poems"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kuravanji plays"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kuravanji plays"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kuravanchi plays"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kuravanchi plays"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kur\u0332ava\u00f1ci drama"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kur\u0332ava\u00f1ci drama"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kur\u0332attipp\u0101\u1e6d\u1e6du plays"}}, {"@id": "_:n927631e49b6d4a67bc4fdd536a11408ab27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kur\u0332attipp\u0101\u1e6d\u1e6du plays"}}], "@id": "/authorities/genreForms/gf2016026029"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026030", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLakho\u031c\u0304n ch\u0101tr\u012b plays", "identifiers:lccn": "gf2016026030", "madsrdf:adminMetadata": [{"@id": "_:n4d4949584f834f658415159427982323b1"}, {"@id": "_:n4d4949584f834f658415159427982323b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lakho\u031c\u0304n ch\u0101tr\u012b plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4d4949584f834f658415159427982323b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018"}], "madsrdf:hasSource": [{"@id": "_:n4d4949584f834f658415159427982323b5"}, {"@id": "_:n4d4949584f834f658415159427982323b6"}, {"@id": "_:n4d4949584f834f658415159427982323b7"}, {"@id": "_:n4d4949584f834f658415159427982323b8"}, {"@id": "_:n4d4949584f834f658415159427982323b9"}], "madsrdf:hasVariant": [{"@id": "_:n4d4949584f834f658415159427982323b10"}, {"@id": "_:n4d4949584f834f658415159427982323b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fast-paced, costumed Thai dance dramas performed to return a favor granted by sacred beings."}, {"@id": "_:n4d4949584f834f658415159427982323b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4d4949584f834f658415159427982323b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4d4949584f834f658415159427982323b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lakho\u031c\u0304n ch\u0101tr\u012b plays"}}, {"@id": "_:n4d4949584f834f658415159427982323b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lakhon Chatri; Lakhon Chatri is a traditional performing art that is very well known among Thai people. Area where performed: Central part of Thailand. Essential elements of the performing art: Music, Dance. This traditional performing art is similar to the Lakhon Nok but performed without a stage or curtain. A low stool is placed at the middle of the covered space, (which may have been hurriedly constructed) or other suitable place. The performers are generally women, but males in supporting roles can be used sometimes. The music accompaniment is provided by a ranat ek, a pair of klong chatri, a pair of tabs and some percussion such as ching, chab, krab. Other instruments may be added to the above ensemble. The performers do not sing, only speak their parts. Another performer will do the singing according to the verses spoken by the script reader. The chorus of luk-ku play the krub-ku as an accompaniment. The music includes singing and phleng na-phat, similar to Likay and Lakhon Nok. The tune is the rai. Lakhon Chatri is generally performed as a means of returning a favor granted by sacred beings.)"}, "madsrdf:citationSource": "Asia-Pacific Database on Intangible Cultural Heritage (ICH) website, Nov. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d4949584f834f658415159427982323b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lakho\u031c\u0304n ch\u0101tr\u012b plays)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d4949584f834f658415159427982323b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Les clefs d'or Thailand website, Nov. 16, 2012: Thai dance (the Lakhon dance drama in which the artists playing human characters do not wear masks though those playing gods often do. Narratives are drawn from the Thai version of the Ramayana known as the Ramakien as well as the Buddhist Jataka stories which chronicle the early lives of the Buddha; There are many branches of the Lakhon, a word simply meaning play or drama. The simplest in form is the Lakhon Chatri which is often seen at sacred sites such as the Erewan shrine where the dancers are hired by supplicants wishing to thank or appease the spirits)", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d4949584f834f658415159427982323b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Traditional Thai theatre consists of six dramatic forms: (1) khon (2) lakhon (3) li-khe (4) manohra (5) nang (6) lakhon lek. Lakhon: The more formal lakhon nai was originally performed for northern nobility by all-female ensembles ... lakhon nai deals exclusively with folk tales and features a mix of sung and spoken text ... More common these days is the less refined lakhon chatrii, a fast-paced, costumed dance-drama)"}, "madsrdf:citationSource": "chiangmaihandicrafts.com website, May 28, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d4949584f834f658415159427982323b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Originally from India, lakhon chatri has existed in the Southeast Asian region for centuries. Audiences are taken by its beautiful lyrical prose, unique dances and upbeat music.)"}, "madsrdf:citationSource": "Lakhon chatri a dying art, via WWW, Nov. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d4949584f834f658415159427982323b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d4949584f834f658415159427982323b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lakho\u031c\u0304n ch\u0101tr\u012b drama"}}, {"@id": "_:n4d4949584f834f658415159427982323b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lakho\u031c\u0304n ch\u0101tr\u012b drama"}}, {"@id": "_:n4d4949584f834f658415159427982323b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d4949584f834f658415159427982323b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lakhon chatrii plays"}}, {"@id": "_:n4d4949584f834f658415159427982323b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lakhon chatrii plays"}}], "@id": "/authorities/genreForms/gf2016026030"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026031", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLian hua lao", "identifiers:lccn": "gf2016026031", "madsrdf:adminMetadata": [{"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b1"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lian hua lao"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, "madsrdf:hasSource": [{"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b5"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b6"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b7"}], "madsrdf:hasVariant": [{"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b8"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b11"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b14"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b17"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Traditional Chinese dramas consisting of rhythmic storytelling and singing accompanied by musical instruments."}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lian hua lao"}}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Popular in Beijing, Tianjin and Hebei, Lian Hua Lao is another form of folk art that combines talking and singing. Performance of Lian Hua Lao started among folks in the Song Dynasty and it was after Emperor Qianlong came into crown in the Qing Dynasty that professional Lian Hua Lao performers appeared, with many fans from the \"Eight Banners\" of the Man nationality. Then Lian Hua Lao started to merge with \"Shi Bu Xian\", another form of folk art in the Qing Dynasty. From then on, Lian Hua Lao and Shi Bu Xian were collectively referred to as \"Shi Bu Xian Lian Hua Lao\" or simply \"Shi Bu Xian\" or \"Lian Hua Lao\". Contents of Lian Hua Lao mainly are pieces with lyrics in regards to scenery or narration of folk tales, performed solo or Caichang. During a solo performance, there will be only one performer narrating tales while playing the seven pieces on his own. The seven clappers refer to the two big bamboo clappers held in the performer's right hand and the five small bamboo clappers held in his left hand. The seven pieces are rhythmically played to the combined talking and singing in a Lian Hua Lao performance. In a Caichang show, there will be two to three performers separately playing the roles of Dan (female characters) and clowns to make the show more amusing. In Old Beijing, Lian Hua Lao started with Qishi Lian Hua Lao, where performers spoke and sang sentences while playing bamboo clappers. This kind of Liao Hua Lao is also called Dakou Lian Hua Lao, during which a promoter would cut in after each section chanting \"Ai-Yo Lian Hua Lao, lotus flower falls one by one\". Such propitious sentences and messages can be improvised according to different objects. Lian Hua Lao performed by professional performers is called Xiaokou Lian Hua Lao, which has well-developed musical effects, fair-sounding tones and elegant lyrics. In contemporary times, performances of Lian Hua Lao are accompanied not only by the seven pieces, but stringed instruments and percussion instruments like three-stringed, Yangqin, Erhu and Muyu. In old times, Lian Hua Lao focused on talking and singing, not performance. But since being performed on the stage, Lian Hua Lao performers are attaching due importance to movements and gestures.)"}, "madsrdf:citationSource": "Traditional quyi art--lian hua lao, via Confucius Institute online, Nov. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 71 (Lianhua lao, literally \"songs of the lotus flowers\", is one of the forms of shuochang yishu [narrated and chanted arts]. It has existed for over a thousand years, passing from generation to generation in oral tradition; thought to have originated with the spread of Buddhism, and in particular with the beggar monks, who earned their living by preaching, especially under the Tang dynasty; after the thirteenth century the genre was no longer a mainly religious one and was accepted as secular entertainment; characteristic feature of lianhua lao performances was the rhythm set by wooden clappers, and also the refrain after each stanza--lianhua lao heihei lianhua lao [lotus flower song, hey-hey, lotus flower song]--which became its logo, as it were.) pp. 72-73 (In the second half of the eighteenth and in the nineteenth century lianhua lao with dramatic elements became more important, forming an intermediate stage between shuochang and the theatre. Several performers were required, one representing a woman [dan] and one a comic character [chou]. Both wore simple costumes and their faces were made up. A third actor played the part of a student, a peasant, a shopkeeper, etc; he wore normal clothes. Besides rhythmic recitation, these performances included songs accompanied by a music instrument. They were not only held in the marketplace, but in zashua guan [theatres] as well. There were several names for this type of lianhua lao: caichang lianhua lao; xiaokou lianhua lao; qingchang lianhua lao) pp. 75-76 (The themes of lianhua lao and related forms were many and varied. The largest group comprises texts without a literary model, based on real-life situations. Sometimes the folk performances were also based on literary texts. These stories were not only acted 'live', but from the end of the Qing dynasty they were published in cheap chapbooks, together with dagu, guci [drum songs] and other prosimetric genres; there were publishers who specialized in these chapbooks. In these books lianhua lao were for the most part called luozi.)"}, "madsrdf:citationSource": "The eternal storyteller : oral literature in modern China, 1999, via Google books, viewed Nov. 16, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lian hua lao; UF Guang zi xi; Lianhua lao; Xia zi xi)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Luozi"}}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Luozi"}}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dakou lian hua lao"}}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dakou lian hua lao"}}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lianhua lao"}}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lianhua lao"}}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Guang zi xi"}}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Guang zi xi"}}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Xiaokou lian hua lao"}}, {"@id": "_:nb1bd9bfa25894a75ba9a74c6ba54b196b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Xiaokou lian hua lao"}}], "@id": "/authorities/genreForms/gf2016026031"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026032", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLik\u0113 drama", "identifiers:lccn": "gf2016026032", "madsrdf:adminMetadata": [{"@id": "_:n83600ef4c2014fbe856ed020f6657670b1"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lik\u0113 drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n83600ef4c2014fbe856ed020f6657670b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n83600ef4c2014fbe856ed020f6657670b5"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b6"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b7"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b8"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b9"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b10"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b11"}], "madsrdf:hasVariant": [{"@id": "_:n83600ef4c2014fbe856ed020f6657670b12"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b15"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b18"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Folk drama from Thailand and Cambodia that is set in a loose framework of songs and dance accompanied by p\u012bph\u0101t music."}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lik\u0113 drama"}}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 329 (Likay: spoken drama set in a loose framework of songs and dance)"}, "madsrdf:citationSource": "Brandon, J.R. Theatre in Southeast Asia, 1967:", "madsrdf:citationStatus": "found"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wannakam prako\u031c\u0304p k\u0101nl\u0113n lik\u0113, 1980.", "madsrdf:citationStatus": "found"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Puras pe\u1e25\u1e6d\u016b\u1e45 m\u0101s : y\u012bke r\u1e8fa\u1e45, 198-.", "madsrdf:citationStatus": "found"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lik\u0113 plays)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(like (Thai), see likay; likay (Thai) Popular, commercial \"opera\" that utilizes many elements derived from classical dance-drama (lakon), including dance, singing, and pi phat music. Originated, in part, from Muslim prayer songs (dikay, Thai pronunciation yikay, hence the term likay) of Malay immigrants. In central Thailand often called yikay, yeekay. Also spelled like.)"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Phal\u0101disai Sitthithanyakit. Lik\u0113, 1995?", "madsrdf:citationStatus": "found"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Carkin, G.B. Likay : the Thai popular theatre form and its function within Thai society, 1986.", "madsrdf:citationStatus": "found"}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n83600ef4c2014fbe856ed020f6657670b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yikay drama"}}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yikay drama"}}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n83600ef4c2014fbe856ed020f6657670b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Likay plays"}}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Likay plays"}}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n83600ef4c2014fbe856ed020f6657670b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Y\u012bk\u0113 drama"}}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Y\u012bk\u0113 drama"}}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n83600ef4c2014fbe856ed020f6657670b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yeekay drama"}}, {"@id": "_:n83600ef4c2014fbe856ed020f6657670b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yeekay drama"}}], "@id": "/authorities/genreForms/gf2016026032"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026033", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMakyung plays", "identifiers:lccn": "gf2016026033", "madsrdf:adminMetadata": [{"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b1"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Makyung plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018"}], "madsrdf:hasSource": [{"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b5"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b6"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b7"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b8"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b9"}], "madsrdf:hasVariant": [{"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b10"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b13"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b16"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Traditional Malay dramas that tell stories through dance, song, and spoken text."}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Makyung plays"}}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Makyung (Dance drama). UF Mak yong (Dance drama); Mak yung (Dance drama); Ma\u02bcyong (Dance drama))"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "dance / traditional / Malay theatre (Mak Yong; a dance drama; a comprehensive theatre performance combining dance, opera, drama and comedy)"}, "madsrdf:citationSource": "Dance Malaysia website, Apr. 30, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (Mak Yong; also known as Makyung; typically described as a Malay dance drama, it features storytelling through the use of dance and song) p. 3 (Makyung may be defined as a Malay dance theatre form incorporating elements of ritual, stylized dance, vocal and instrumental music, song, story, improvised and formal spoken text as well as stylized acting)"}, "madsrdf:citationSource": "Makyung, the mystical heritage of Malaysia, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 612 (the female dance drama ma\u02bcyong)"}, "madsrdf:citationSource": "Cambridge guide to world theatre, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 35 (Makyung) p. 47 (in a makyung performance, dance music and dialogue combine to bring to life local lores and legends)"}, "madsrdf:citationSource": "Traditional Malay theatre, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Makyung drama"}}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Makyung drama"}}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mak yong drama"}}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mak yong drama"}}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mak yung drama"}}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mak yung drama"}}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ma\u02bcyong drama"}}, {"@id": "_:n49c8ca3cdbd64f74b632b52f5c1793b6b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ma\u02bcyong drama"}}], "@id": "/authorities/genreForms/gf2016026033"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026034", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPing ju", "identifiers:lccn": "gf2016026034", "madsrdf:adminMetadata": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db1"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ping ju"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}], "madsrdf:hasSource": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db5"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db6"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db7"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db8"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db9"}], "madsrdf:hasVariant": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db10"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db13"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db16"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db19"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db22"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db25"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db28"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db31"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db34"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db37"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db40"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db43"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db46"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical dramas of northern and northeastern China."}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ping ju"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ping ju (Folk dramas))"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pingju (Tangshan, Hebei sung-drama, opera). Pingju (Ping opera) is a regional form that emerged around 1910 in the Tangshan area, Hebei province, where it was particularly popular among coal miners and peasants. It incorporates musical elements from narrative song form (Lianhua lao or \"Lotus Song\"; see quyi), folk dance (bengbeng or \"to caper\"), shadow puppet theatre (Luanzhou yingxi), and Hebei opera (Bangzi). Pingju's music features a range of dialogue and declamatory styles, arias (changqiang), airs for melodic instruments and percussion (qupai), and folk melodies. The arias, accompanied notably by the banhu (two-string fiddle), are sung in melodic and rhythmic modes (banqiang) like most northern opera genres.)"}, "madsrdf:citationSource": "Encyclopedia of contemporary Chinese culture, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 87 (Hebei opera or Ping ju, known as the folk genre bengbeng xi in Hebei province, which was first staged in Shanghai prior to the 1920s)"}, "madsrdf:citationSource": "Meng, Y. Shanghai and the edges of empires, c2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Pingju (Pingju is a form of local Chinese opera from northern China. It originated in Tangshan, Hebei, near the city of Tianjin. The term P\u00edngj\u00f9 was also formerly used to refer to Beijing opera.) Hebei (Traditional forms of Chinese opera in Hebei include Pingju, Hebei Bangzi (also known as Hebei Clapper Opera), and Cangzhou Kuaiban Dagu. Pingju is especially popular: it tends to be colloquial in language and hence easy to understand for audiences. Originating from northeastern Hebei, Pingju has been influenced by other forms of Chinese opera like Beijing opera. Traditionally Pingju makes use of just a xiaosheng (young male lead), a xiaodan (young female lead), and a xiaohualian (young comic character), though it has since diversified with the use of other roles as well.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 7, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pingju, p\u02bcing ch\u00fc. A form of music-drama (xiqu) popular in Beijing, Tianjin, and throught northern and northeastern China which originated in the lianhualao storytelling (quyi) form of eastern Hebei Province; uses banqiangti musical structure and features the banhu spike fiddle; in the past, also called pingqiang bangzixi or p\u02bcing ch\u02bciang pang tzu his, abbreviated pingxi or p\u02bcing his; and bengbengxi or peng peng his, abbreviated bengbeng or peng peng)"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pingqiang bangzixi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pingqiang bangzixi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pingxi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pingxi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "P\u02bbing ch\u00fc"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "P\u02bbing ch\u00fc"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ping operas"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ping operas"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ping qiang bang zi xi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ping qiang bang zi xi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bengbengxi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bengbengxi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pingju"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pingju"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bengbeng xi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bengbeng xi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Beng beng xi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Beng beng xi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ping xi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ping xi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db40", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db41"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "P\u02bbing ch\u02bbiang pang tzu hsi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db41", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "P\u02bbing ch\u02bbiang pang tzu hsi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db43", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db44"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "P\u02bbing hsi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db44", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "P\u02bbing hsi"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db46", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db47"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Peng peng his"}}, {"@id": "_:n8766b1e4ccff4cd3b72a51040acf3b9db47", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Peng peng his"}}], "@id": "/authorities/genreForms/gf2016026034"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026035", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aR\u0101sal\u012bl\u0101 drama", "identifiers:lccn": "gf2016026035", "madsrdf:adminMetadata": [{"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db1"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "R\u0101sal\u012bl\u0101 drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026501"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018"}], "madsrdf:hasSource": [{"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db5"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db6"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db7"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db8"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db9"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db10"}], "madsrdf:hasVariant": [{"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db11"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db14"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db17"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db20"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db23"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that combine poetry, music, and dance and depict episodes from the childhood and adolescence of Krishna."}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "R\u0101sal\u012bl\u0101 drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pref. (type of religious drama characteristic for and unique to the region of Vraja in northwestern Uttar Pradesh; combines poetry, music, dance and drama; language is the Vrajabh\u0101\u1e63\u0101 dialect of Hindi; takes episodes from the childhood life of the Hindu god K\u1e5b\u1e63\u1e47a for its subject-matter; the central theme is the enactment of the r\u0101sa, the circular dance performed by K\u1e5b\u1e63\u1e47a with the cowherd women of Vraja on an autumn full-moon night; pronounced r\u0101sl\u012bl\u0101) introd. (R\u0101sal\u012bl\u0101, the enactment of the r\u0101sa dance, is a form of religious drama whose theoretical foundation plays a central role in Vai\u1e63nava theology; the re-enactment of the r\u0101sa dance becomes central to the religious dramas called r\u0101sal\u012bl\u0101nukara\u1e47a, \"the imitation of the r\u0101sa play\". The compound is conveniently shortened and the plays are called r\u0101sal\u012bl\u0101. They are structured in two parts: an initial dance (r\u0101sa) which forms the most sacred and invariable component of the performance, followed by a one-act play (l\u012bl\u0101) which takes an episode from K\u1e5b\u1e63\u1e47a's childhood in Vraja for its theme. The entire performance is named r\u0101sa after its prior element.)"}, "madsrdf:citationSource": "Thielemann, S. R\u0101sal\u012bl\u0101 : a musical study of religious drama in Vraja, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Iboc\u0101ob\u0101, H. \u015ar\u012b\u015br\u012bgobinda r\u0101sa l\u012bl\u0101, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 49 (The Puranas played an important role in the evolution of Ras Leela theatre in general; the Vraja tradition of Ras Leela has borrowed many features from the descriptions in the Brahmavaivarta Purana)"}, "madsrdf:citationSource": "Varadpande, M.L. Krishna theatre in India, 1982:", "madsrdf:citationStatus": "found"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(raslila. A sacred musical theatre form in north India, celebrating the life of Krishna; consists of two parts, a sacramental circle dance of Krishna with his milkmaid lovers, followed by the enactment of an episode (lila) in his life story; staged in a temple courtyard and major roles are taken by boys. Sometimes more formally called raslilanukaran (imitation of raslila))"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Rani Balbir Kaur. Music in traditional Indian theatre : special reference to raas leela, 2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (r\u00e2s lila) p. 25 (there are many different forms of theatre in India that go under the name r\u00e2s lila, owing to the fact that the term refers not so much to a particular style of presentation but to a particular episode in Krishna mythology in which Krishna and the gopis dance together in the forest at night) p. 26 (the r\u00e2s lila dramatizes the stories of Krishna's childhood and adolescence)"}, "madsrdf:citationSource": "Mason, D.V. Theatre and religion on Krishna's stage, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "R\u0101sl\u012bl\u0101 drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "R\u0101sl\u012bl\u0101 drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Raas leela drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Raas leela drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "R\u0101sa l\u012bl\u0101 drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "R\u0101sa l\u012bl\u0101 drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Raslilanukaran drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Raslilanukaran drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "R\u0101s lila drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "R\u0101s lila drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "R\u0101sal\u012bl\u0101nukara\u1e47a drama"}}, {"@id": "_:na27a0b9f11d24d9fa359c158ad120c3db27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "R\u0101sal\u012bl\u0101nukara\u1e47a drama"}}], "@id": "/authorities/genreForms/gf2016026035"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026036", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSandae drama", "identifiers:lccn": "gf2016026036", "madsrdf:adminMetadata": [{"@id": "_:naead6096d40a4c3da982ffaf9dded927b1"}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sandae drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:naead6096d40a4c3da982ffaf9dded927b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026525"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018"}], "madsrdf:hasSource": [{"@id": "_:naead6096d40a4c3da982ffaf9dded927b5"}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b6"}], "madsrdf:hasVariant": [{"@id": "_:naead6096d40a4c3da982ffaf9dded927b7"}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b10"}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b13"}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b16"}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Korean folk masked dance-dramas that satirize the nobility and clergy."}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-06-02T15:21:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sandae drama"}}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Of the four mask dance-dramas, Sandae, named after the royal nomenclature for the office responsible for handling mask dance-drama, is the best known. It consists of 10 acts and 13 scenes, each named after the main role in each act and scene. Thus, Act One is \"The High Priest;\" Act Two, \"The Pock-Marked Monk;\" Act Three, \"The Dark-Faced Monk;\" Act Four, \"The Monk with the Blinking Eyes\" and so forth. Like the Kkoktugakshi puppet show, the Sandae brought out the triangular affair of the typical yangban, his wife and his concubine. It satirized the Choson nobility and mocked the apostate monks. The Sandae had an all-male cast, playing and dancing to the accompaniment of traditional Korean drums, strings and winds blaring tunes based on folk songs, Buddhist invocations, shamanist invocations and the like. It also had one puppet and a set of 24 masks, one for each of the cast. It was performed on a makeshift open-air stage in the village square on holiday occasions, such as the Tano festival on the fifth day of the Fifth Moon or during shaman prayer-days for rain. Starting after sunset, the show continued deep into the night. However, this unique Korean drama has lost much popular support. Only one troupe has continued to perform it in Yangju village, Kyonggi-do province. A group was organized in Seoul about 90 years ago as the only authentic performers of the Sandae in later-day Korea, but was disbanded after 50 years. The drama has been revived with Government support and has been designated an intangible cultural asset.)"}, "madsrdf:citationSource": "The sandae mask dance-drama, via AsianInfo.org, Nov. 13, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sandaeguk, sandae kuk. Literally: mountain drama. 1. A form of court masked dance-drama in the Choson dynasty (1392 AD to 1910 AD). It is believed that most existing folk masked dance-plays derived from this drama. 2. Abbreviated sandae, santae, sande (mountain), a generic term for several current types of folk masked-plays. In them noblemen (yangban) and monks are satirized. In Yangju and Kyonggi Provinces, also called pyolsandae (separate sandae), to distinguish the present form from its now extinct predecessor ponsandae (original sandae). In Hwanghae Province, also called t'alch'um (masked dance). Also called sandae-nori (mountain dance).)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naead6096d40a4c3da982ffaf9dded927b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Santae drama"}}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Santae drama"}}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naead6096d40a4c3da982ffaf9dded927b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ponsandae drama"}}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ponsandae drama"}}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naead6096d40a4c3da982ffaf9dded927b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sandae-nori drama"}}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sandae-nori drama"}}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naead6096d40a4c3da982ffaf9dded927b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pyolsandae drama"}}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pyolsandae drama"}}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naead6096d40a4c3da982ffaf9dded927b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "T'alch'um drama"}}, {"@id": "_:naead6096d40a4c3da982ffaf9dded927b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "T'alch'um drama"}}], "@id": "/authorities/genreForms/gf2016026036"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026037", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSannata drama", "identifiers:lccn": "gf2016026037", "madsrdf:adminMetadata": [{"@id": "_:nf73b43a1abd541a6b32182233afa8065b1"}, {"@id": "_:nf73b43a1abd541a6b32182233afa8065b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sannata drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf73b43a1abd541a6b32182233afa8065b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, "madsrdf:hasSource": [{"@id": "_:nf73b43a1abd541a6b32182233afa8065b5"}, {"@id": "_:nf73b43a1abd541a6b32182233afa8065b6"}, {"@id": "_:nf73b43a1abd541a6b32182233afa8065b7"}], "madsrdf:hasVariant": {"@id": "_:nf73b43a1abd541a6b32182233afa8065b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf73b43a1abd541a6b32182233afa8065b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf73b43a1abd541a6b32182233afa8065b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf73b43a1abd541a6b32182233afa8065b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sannata drama"}}, {"@id": "_:nf73b43a1abd541a6b32182233afa8065b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sannata (\"small/little theatre\"): an umbrella term for various small-scale Kannada theatre forms of north Karnataka; the adjective refers to the relative scope and the degree of stylization. Previously called Dappinata after the dappu, a small drum used in performances, Sannata got its present name as a contrastive coinage to Doddata, the \"large-scale\" Bayalata variant of eastern Yakshagana. Scholars have identified at least three kinds of Sannata plays according to themes used--Vishnu legends, Siva legends, and contemporary issues. The best example is Sangya-Balya (\"Sangya and Balya\"), the most popular Sannata text.)"}, "madsrdf:citationSource": "The Oxford companion to Indian theatre, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:nf73b43a1abd541a6b32182233afa8065b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 103 (The folk theatre of Karnataka, Bayalata (open air theatre) has derived its form from religious rituals; Dasarata, Sannata, Doddata, Panjata and Yakshagana are the five types of Bayalata commonly performed; Sannata, or the small play, is an improvisation of the Dasarata. Sannata has a full length story that spans around six hours, instead of several small stories; almost all the villages in Karnataka have their own troupe; unlike the Yakshagana, Doddata and puppet plays, Sannata brings the folk theatre to the social plane)"}, "madsrdf:citationSource": "India country study guide. Volume 1, Strategic information and developments, 2012, viewed in Google books, Mar. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf73b43a1abd541a6b32182233afa8065b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "87902771: Shankar, M. Sannata : minor folk-plays of north Karnataka, 1986.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf73b43a1abd541a6b32182233afa8065b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf73b43a1abd541a6b32182233afa8065b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dappinata drama"}}, {"@id": "_:nf73b43a1abd541a6b32182233afa8065b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dappinata drama"}}], "@id": "/authorities/genreForms/gf2016026037"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026038", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTan ci", "identifiers:lccn": "gf2016026038", "madsrdf:adminMetadata": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b1"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tan ci"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b5"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b6"}], "madsrdf:hasVariant": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b7"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b10"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b13"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b16"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b19"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b22"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b25"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b28"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b31"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Chinese stories combined with singing and instrumental music that are presented by one or more performers in local dialect."}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tan ci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 330 (Suzhou tanci, or Suzhou chantefable, is a style of Chinese professional storytelling that combines singing, instrumental music, and a complex mixture of narrative registers and dialogue; English equivalents for Suzhou tanci are many. Among them are \"plucking rhymes\" and \"strum lyric\", \"southern singing narrative,\" and \"story-singing.\" If an English equivalent is desirable, I prefer Hanan's (1973:209) use of the term \"chantefable,\" in the sense that both singing and speaking are used to relate a narrative.) pp. 331-334 (Suzhou tanci belongs to a family of related styles of local dialect storytelling that have at one time or another had some degree of currency in the Yangzi delta. These include styles that are today identified locally as Suzhou tanci, Yangzhou tanci (an alternate name is Yangzhou xianci), and Hangzhou nanci. Of these styles of storytelling that combine speech and instrumentally accompanied song, Suzhou tanci is by far the most vital, with Yangzhou tanci trailing a distant second in popularity. Like Suzhou tanci, some of these styles have related genres in written vernacular fiction. The Suzhou chantefable tradition is often associated with another style of storytelling called Suzhou pinghua (which Blader [1983] terms \"straight storytelling\"). Today most tanci storytellers perform as duos: usually a male lead (shangshou, literally \"upper-hand\") and a female assistant (xiashou, or \"lower-hand\"). Pairs of men, once the rule seventy years ago, are uncommon today, though pairs of women are on the increase, largely due to a lack of younger male performers. A few men and women perform solo, and in some situations three storytellers (sange dang) or even more may perform together.)"}, "madsrdf:citationSource": "Bender, M. Suzhou tanci storytelling in China, in Oral tradition, Oct. 1998, viewed online Nov. 13, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tanci, t\u02bcan tz\u02bcu. A type of storytelling (quyi) which developed c. 14th-16th C; currently popular forms exist in a number of regions throughout China; performed in regional dialect by one to four seated performers who usually sing, speak, and play musical instruments. The three-string lute (sanxian), lute (pipa), or moon guitar (yueqin) is usually the principal instrument.)"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yangzhou xianci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yangzhou xianci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "T\u02bban tz\u02bbu"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "T\u02bban tz\u02bbu"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tanci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tanci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yangzhou tanci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yangzhou tanci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suzhou chantefable"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suzhou chantefable"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nanci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nanci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suzhou tanci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suzhou tanci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hangzhou nanci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hangzhou nanci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2ffba0635714c29877c4ccb463db516b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Xianci"}}, {"@id": "_:nf2ffba0635714c29877c4ccb463db516b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Xianci"}}], "@id": "/authorities/genreForms/gf2016026038"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026039", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTopeng plays", "identifiers:lccn": "gf2016026039", "madsrdf:adminMetadata": [{"@id": "_:nab96b5ced5a84bec8657199e4423e873b1"}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Topeng plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nab96b5ced5a84bec8657199e4423e873b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018"}, "madsrdf:hasSource": {"@id": "_:nab96b5ced5a84bec8657199e4423e873b5"}, "madsrdf:hasVariant": [{"@id": "_:nab96b5ced5a84bec8657199e4423e873b6"}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b9"}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b12"}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b15"}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b18"}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b21"}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b24"}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Indonesian masked dance dramas."}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topeng plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "topeng (Literally: mask. 1. A generic term for a theatrical mask in Indonesia. 2. A generic term for a classical masked play. 3. In Bali, a partially comic masked dance-play based on Balinese chronicles performed by a small all-male troupe. See also: wayang topeng) topeng babakan (In Sunda, a masked street play, performed by professional actors. Also called topeng dalang. See: wayang wong) topeng padjegan (Literally: combination topeng. In Bali, as style of dance-drama in which a single actor wears many masks in quick succession) wayang topeng (Literally: masked wayang. A classical and folk masked dance-drama dating from the 12th C and still popular in Central and East Java. Only Panji stories are enacted. Abbreviated topeng (mask). Klana topeng is a masked dance-play about Panji's opponent, King Klana. See also: topeng) wayang wong (Literally: human wayang. A classical dance-drama that melds dialogue, narrative (by a dalang), dance, and gamelan music. 1. In Central Java, an unmasked dance-drama based on Ramayana and Mahabharata stories. Also called wayang orang. 2. In Cirebon (West Java), a masked dance play primarily presenting Mahabharata stories. Also called topeng dalang (masked-drama with a narrator). 3. In Bali, a ceremonial all-male masked dance-drama dating from the 16th C enacting Ramayana stories. Emphasis is on narrative rather than dance.) 670 Wikipedia, Nov. 12, 2012: Topeng dance (Topeng dance (topeng is Indonesian for \"mask\") is a dramatic form of Indonesian dance in which one or more mask-wearing, ornately-costumed performers interpret traditional narratives concerning fabled kings, heroes and myths, accompanied by gamelan music. The form arose in the 15th century in Bali and Java where it remains prevalent, but it is also found in other Indonesian islands - such as Madura (near East Java); Topeng dance drama)"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985:", "madsrdf:citationStatus": "found"}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab96b5ced5a84bec8657199e4423e873b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Topeng padjegan plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topeng padjegan plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab96b5ced5a84bec8657199e4423e873b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Topeng drama"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topeng drama"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab96b5ced5a84bec8657199e4423e873b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wayang wong plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wayang wong plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab96b5ced5a84bec8657199e4423e873b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Topeng dalang plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topeng dalang plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab96b5ced5a84bec8657199e4423e873b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wayang topeng plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wayang topeng plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab96b5ced5a84bec8657199e4423e873b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Klana topeng plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Klana topeng plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab96b5ced5a84bec8657199e4423e873b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Topeng babakan plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topeng babakan plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab96b5ced5a84bec8657199e4423e873b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wayang orang plays"}}, {"@id": "_:nab96b5ced5a84bec8657199e4423e873b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wayang orang plays"}}], "@id": "/authorities/genreForms/gf2016026039"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026040", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aYak\u1e63ag\u0101na plays", "identifiers:lccn": "gf2016026040", "madsrdf:adminMetadata": [{"@id": "_:n11a134b7ad6347948218b02699321667b1"}, {"@id": "_:n11a134b7ad6347948218b02699321667b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Yak\u1e63ag\u0101na plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026018"}, "madsrdf:hasSource": [{"@id": "_:n11a134b7ad6347948218b02699321667b5"}, {"@id": "_:n11a134b7ad6347948218b02699321667b6"}, {"@id": "_:n11a134b7ad6347948218b02699321667b7"}, {"@id": "_:n11a134b7ad6347948218b02699321667b8"}, {"@id": "_:n11a134b7ad6347948218b02699321667b9"}], "madsrdf:hasVariant": [{"@id": "_:n11a134b7ad6347948218b02699321667b10"}, {"@id": "_:n11a134b7ad6347948218b02699321667b13"}, {"@id": "_:n11a134b7ad6347948218b02699321667b16"}, {"@id": "_:n11a134b7ad6347948218b02699321667b19"}, {"@id": "_:n11a134b7ad6347948218b02699321667b22"}, {"@id": "_:n11a134b7ad6347948218b02699321667b25"}, {"@id": "_:n11a134b7ad6347948218b02699321667b28"}, {"@id": "_:n11a134b7ad6347948218b02699321667b31"}, {"@id": "_:n11a134b7ad6347948218b02699321667b34"}, {"@id": "_:n11a134b7ad6347948218b02699321667b37"}, {"@id": "_:n11a134b7ad6347948218b02699321667b40"}, {"@id": "_:n11a134b7ad6347948218b02699321667b43"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Folk dance-dramas that generally depict stories from Indian epic poems and the Puranas."}, {"@id": "_:n11a134b7ad6347948218b02699321667b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n11a134b7ad6347948218b02699321667b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n11a134b7ad6347948218b02699321667b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yak\u1e63ag\u0101na plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ashton-Sikora, M.B. Yak\u1e63ag\u0101na, a dance drama of India, 1977: pp. 5-6 (The plays are set in an era when Lords \u015aiva and Vi\u1e63\u1e47u, in their manifest human forms walked the earth; comic relief in otherwise serious drama is provided by raucous buffoons; twelve hour performance)", "madsrdf:citationStatus": "found"}, {"@id": "_:n11a134b7ad6347948218b02699321667b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Yakshagana (\"Yaksha songs\"): generic term referring mainly to a traditional form of Kannada theatre predominant in coastal Karnataka, variants of which are found in other parts of the state as well, under names such as Bayalata, Dasavatar, and Bhagavatara Ata. Yakshas form a class of demigods in Hindu mythology, but their connection to this genre remains unclear.)"}, "madsrdf:citationSource": "The Oxford companion to Indian theatre, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:n11a134b7ad6347948218b02699321667b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "yakshagana.com, Oct. 30, 2012: Introduction (Yakshagana is a traditional theatre form combining dance, music, spoken word, costume-makeup, and stage technique with a distinct style and form. It is a theatre form mainly prevalent in the coastal districts and adjacent areas, in Karnataka. It is closely connected with other forms prevailing in other parts of Karnataka, and its neighbouring states of Andhra Pradesh, Kerala, Tamilnadu and Maharastra; defies neat classification into categories like folk, classical, rural. It can be included into each of these, or all of them together depending upon our line of approach. Being a theatre form, unlike a dance form, it is more plural and dynamic; Yakshagana can be rightly called a traditional form; The theatre form, so called today, was and even today, being popularly called Bayalata (open place play) or simply Ata (play). Yakshagana is a scholar's nomenclature may be a hundred years old as far as the theatre in application to performance is concerned, though it is at least six centuries old as a literary composition; literary genre)", "madsrdf:citationStatus": "found"}, {"@id": "_:n11a134b7ad6347948218b02699321667b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ir\u0101mac\u0101mi, T. Tamil Yak\u1e63agaanas, 1987: introd. (established by overwhelming evidence that the Yak\u1e63agaana started in Tamil Nadu and then spread in Karnataka and Andhra; the terukkuuttu is the protoform of South Indian dance drama, the Yak\u1e63agaana) p. 1 (Six Tamil Yak\u1e63agaanas in manuscript form are available in the Government Oriental Manuscripts Library, Madras; Yak\u1e63agaana is the other name for terukkuuttu) p. 19 (Yak\u1e63agaana has a style of music distinct from the two main systems of Indian music viz. the Hindustani and Carnatic. Plays written with this style of music came to be called Yak\u1e63agaana Prasa\u1e45gas, Prasa\u1e45ga meaning lecture/discourse. Almost every writer of such prasa\u1e45gas mentions at the beginning that he is writing in the Yak\u1e63agaana form indirectly referring to the musical style.) p. 24 (Yak\u1e63agaanam is a variety of music, that in South India became a medium of story telling in the form of Champu Kaavya (verse interspersed with prose) and because of this Yak\u1e63agaana works came to be written. These works came to be enacted in the form of dramas; The Yak\u1e63agaanas performed in Karnataka, Andhra and Tamil Nadu are known as Terukuuttu in Tamil, Viithinaa\u1e6dakam in Telugu and Bayalaa\u1e6d\u1e6da in Kannada) p. 33 (Terukuuttu stories are mostly popularly known puranic items)", "madsrdf:citationStatus": "found"}, {"@id": "_:n11a134b7ad6347948218b02699321667b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Yakshagana (Yakshagana is a theater form that combines, dance, music, dialogue, costume, make-up and stage techniques with a unique style and form. This theater style is mainly played in the coastal districts and Malenadu regions of Karnataka, India. Yakshagana is the recent (200 years) scholastic name for what are known as k\u0113\u1e37ike, \u0101\u1e6da, bayal\u0101\u1e6da, da\u015b\u0101vat\u0101ra. All the components of Yakshagana, music, dance and dialog are improvised. Bayalata (Kannada: Bayal\u0101\u1e6da or Bayal\u0101\u1e6dada) is a form of Yakshagana found in southern Indian region of Karnataka featuring stories from Indian epic poetry and the Puranas rendered as dance and drama)"}, "madsrdf:citationSource": "Wikipedia, Oct. 30, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n11a134b7ad6347948218b02699321667b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yak\u1e63ag\u0101na drama"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yak\u1e63ag\u0101na drama"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dasavatar plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dasavatar plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Viithinaa\u1e6dakam plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Viithinaa\u1e6dakam plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bayal\u0101\u1e6da plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bayal\u0101\u1e6da plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Da\u015b\u0101vat\u0101ra plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Da\u015b\u0101vat\u0101ra plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yak\u1e63agaana plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yak\u1e63agaana plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yakshagana plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yakshagana plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bhagavatara plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bhagavatara plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bayalaa\u1e6d\u1e6da plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bayalaa\u1e6d\u1e6da plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Terukkuuttu plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Terukkuuttu plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b40", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b41"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yak\u1e63agaana prasa\u1e45ga plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b41", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yak\u1e63agaana prasa\u1e45ga plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b43", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n11a134b7ad6347948218b02699321667b44"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "K\u0113\u1e37ike plays"}}, {"@id": "_:n11a134b7ad6347948218b02699321667b44", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "K\u0113\u1e37ike plays"}}], "@id": "/authorities/genreForms/gf2016026040"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026041", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBangsawan (Music)", "identifiers:lccn": "gf2016026041", "madsrdf:adminMetadata": [{"@id": "_:nc527985ba44748a3b0bee6dae5023a38b1"}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bangsawan (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc527985ba44748a3b0bee6dae5023a38b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasSource": [{"@id": "_:nc527985ba44748a3b0bee6dae5023a38b5"}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b6"}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b7"}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b8"}], "madsrdf:hasVariant": {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bangsawan (Music)"}}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 17, p. 776 (bangsawan, a popular form of entertainment) v. 11, p. 560 (bangsawan, theatrical genre with vocal and instrumental music)"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Malaysia (One of the most famous of the syncretic music-theatre forms is bangsawan (also known as Malay opera), which first appeared in the 19th century; believed to have originated in Persia and carried by Indian sources to the Malay peninsula; each production consisted of one or more stories enacted with dialogue, song and dance, and supplemented by additional song-and-dance routines performed in front of the closed stage curtain during scene changes; the bangsawan orchestra, music, dance, and stories were highly eclectic, featuring elements of local Malay and various foreign art forms; bangsawan performances now tend to feature mainly Malay stories; a standard repertory of pieces is drawn upon to reflect the mood of an episode in a given story)"}, "madsrdf:citationSource": "Grove music online, viewed August 14, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 92025275: Tan, S.B. Bangsawan : a social and stylistic history of popular Malay opera, 1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "bangsawan (Bangsawan was Malaysia's (and later Indonesia's) first purely secular and commercial theatre, characterized by shameless self-promotion, star appeal, and troupe rivalries. It also introduced indigenous audiences to the proscenium stage, scenery, and lighting. Flashy and theatrical, bangsawan performances appealed across ethnic and class lines. Stories were drawn from popular Middle Eastern, Indian, and Malay sources as well as from adaptations of Western literary classics and films. Dialogue, performed in Malay, was improvised around loose scenarios--a single play could take several nights to complete if a good rapport with the audience was established. In the 1890s Malay troupes toured to Sumatra and Java where local companies subsequently formed, becoming generally known in Indonesia as opera melayu (Malay opera) or stambul. Its popularity peaked during the 1920s and 1930s and began to decline in the 1940s, as intellectuals from the nationalist movements in both Malaysia and Indonesia criticized it as coarse and unrealistic.)"}, "madsrdf:citationSource": "Oxford companion to theatre and performance, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc527985ba44748a3b0bee6dae5023a38b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Malay opera"}}, {"@id": "_:nc527985ba44748a3b0bee6dae5023a38b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Malay opera"}}], "@id": "/authorities/genreForms/gf2016026041"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026042", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBarong (Music)", "identifiers:lccn": "gf2016026042", "madsrdf:adminMetadata": [{"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab1"}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Barong (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026008"}], "madsrdf:hasSource": [{"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab5"}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab6"}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab7"}], "madsrdf:hasVariant": [{"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab8"}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Gamelan music to accompany Balinese dance dramas that depict the struggle between the forces of an evil witch and benign lion-like figure."}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-14T11:33:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "revised"}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Barong (Music)"}}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Bali, Attractions (Barong and keris dance; known as one of Bali's most iconic and spiritual dance dramas, the Barong and Keris dance is an integral part of Balinese culture. The Barong and Keris dance tells the age old story of the battle between good and evil with Barong the protector fighting against the wrath of the witch queen Rangda; the story of the Barong and Keris dance is used as a reflection of the actions and choices of daily life, representing good and bad behaviour, known as dharma and adharma in Balinese culture; the Barong and Rangda masks used in the Barong and Keris dance are especially sacred items and a priest must be present to sprinkle them with holy water from Mount Agung, and offer blessings before they are brought out for a performance)"}, "madsrdf:citationSource": "Travelonline WWW site, July 11, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Shadow puppet theatre (Balinese villagers playing in the barong exorcism dance-drama are not merely actors exercising theatrical skills. The actors' bodies, going into a trance, are believed to receive the spirits of Rangda and the Barong, and it is the spirits themselves that do battle. Thus the performance is actually more a ritual than a piece of theatre)"}, "madsrdf:citationSource": "Britannica WWW site, March 8, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under South-east Asia. 6, Dance and theatre. ii, Indonesia (Balinese dance and drama, for the most part, have their origins in religious ritual and continue to serve ritual functions. Some genres involve trance possession, such as the barong and sanghyang. The barong, accompanied by a relatively large Balinese gamelan (gong kebyar or a derivative), depicts the struggle between the force of an evil witch (Rangda) and a benign lion-like figure (Barong), whose faithful defenders fall into trance as they attack and are repelled by the powerful Rangda)"}, "madsrdf:citationSource": "Grove music online, viewed July 14, 2014 :", "madsrdf:citationStatus": "found"}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Barong and kris dance (Music)"}}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Barong and kris dance (Music)"}}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Barong and keris dance (Music)"}}, {"@id": "_:nfcd0b7e3c91445b192469e4011cf8ebab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Barong and keris dance (Music)"}}], "@id": "/authorities/genreForms/gf2016026042"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026043", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCh'angg\u016dk", "identifiers:lccn": "gf2016026043", "madsrdf:adminMetadata": [{"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b1"}, {"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ch'angg\u016dk"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}], "madsrdf:hasSource": {"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b5"}, "madsrdf:hasVariant": {"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ch'angg\u016dk"}}, {"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ch'angguk is a Korean folk opera. The term Changguk is composed of two words, Ch'ang and g\u016dk. The former refers to 'song', a special type of song called pansori. And the latter refers to 'play' or 'drama'. Therefore Ch'angguk could be called a pansori drama... One can be qualified as a singer(an actor) in Changguk only when he masters pansori through special practice. The number of main characters in Changguk consisting of heroes(heroines) and supporting actors(actresses) is about 20-30, although the exact number varies drama by drama. It is also possible for more supporting casts to participate in a drama, depending on its nature. Music is played by a Korean classical music orchestra consisting of 30-50 members playing traditional Korean musical instruments.)"}, "madsrdf:citationSource": "Wikipedia, viewed Aug. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Changgeuk"}}, {"@id": "_:n3e648cdccd4144a8b4ed613224dd37f6b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Changgeuk"}}], "@id": "/authorities/genreForms/gf2016026043"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026044", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHira gasy", "identifiers:lccn": "gf2016026044", "madsrdf:adminMetadata": [{"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb1"}, {"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hira gasy"}, "madsrdf:elementList": {"@list": [{"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}], "madsrdf:hasSource": [{"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb5"}, {"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb6"}, {"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hira gasy"}}, {"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 11 (\"This study deals with the contemporary Hira Gasy performance in the regions of Imerina and northern Betsileo in the central highland of Madagascar. Hira means song and gasy is an abbreviation of Malagasy. Hira gasy, then means 'Malagasy song' in a broad sense. But it also designates a quite specific kind of performance called Hira Gasy ... The Hira Gasy performance is a kind of multi-media show using speech, song, dance, music and acrobatics.\") p. 85 (\"The four main parts of the Hira Gasy performance are the speech, the mother song, the young boys' dance, and the finale which consists of the child song and the folk dance.\")"}, "madsrdf:citationSource": "Edkvist, I. The performance of tradition : an ethnography of Hira Gasy popular theatre in Madagascar, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Britannica;New Grove;Int. cycl. of music and musicians;Madagascar : society and history, c1986;Bloch, M. Ritual, history, and power, 1989", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n353c9396e3224f91bae5ceb556e6d50eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. 789 (hira-gasy; in the category Theater music)"}, "madsrdf:citationSource": "New Garland encyc. of world music, 1998:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026044"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026045", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIsicathamiya", "identifiers:lccn": "gf2016026045", "madsrdf:adminMetadata": [{"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b1"}, {"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Isicathamiya"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, "madsrdf:hasSource": [{"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b5"}, {"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b6"}], "madsrdf:hasVariant": {"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Isicathamiya"}}, {"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(isicathamiya; performance tradition of competitive song and dance, formerly known as ingoma ebusuku; performed by male a cappella choirs of black, isiZulu-speaking migrants)"}, "madsrdf:citationSource": "Work cat.: Erlmann, V. Nightsong, 1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ingoma ebusuku"}}, {"@id": "_:n7cae3a328a4040e5a8a66f0b1b31ea73b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ingoma ebusuku"}}], "@id": "/authorities/genreForms/gf2016026045"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026046", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJiggs (Ballad operas)", "identifiers:lccn": "gf2016026046", "madsrdf:adminMetadata": [{"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b1"}, {"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jiggs (Ballad operas)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b3"}]}, "madsrdf:exampleNote": "Note under [Jigs (Dance music)]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026645"}, "madsrdf:hasSource": {"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b5"}, "madsrdf:hasVariant": [{"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b6"}, {"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Stage entertainments popular in England and Continental Europe during the 16th-18th centuries that combined drama, music, and dance. For the dance genre popular in the British Isles from the 16th century onward, see [Jigs (Dance music).]"}, {"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jiggs (Ballad operas)"}}, {"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A stage entertainment popular in England and on the Continent (Holland, Germany, Scandinavia) from about 1550 to 1750. The jigg \"combined three arts in which the Elizabethans delighted and excelled -- drama, music and the dance\", though it was aimed at the \"groundlings, not the literati\" of Elizabethan society (Baskervill). The jigg derives from a combination of the improvised popular songs of earlier centuries with the even older traditional ritual dances associated with the important festivals of the year.; By the middle of the 16th century the jigg had assumed its standard form: a short burlesque comedy for two to five characters, sung in verse to one or more well-known tunes, interspersed with much lively dancing and performed by a team of professional comedians.)"}, "madsrdf:citationSource": "Grove music online, March 24, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jigs (Ballad operas)"}}, {"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jigs (Ballad operas)"}}, {"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jygges (Ballad operas)"}}, {"@id": "_:n5f746d3d7c2e4e2aa5a9b13551657df1b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jygges (Ballad operas)"}}], "@id": "/authorities/genreForms/gf2016026046"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026047", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKalgi-tura", "identifiers:lccn": "gf2016026047", "madsrdf:adminMetadata": [{"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab1"}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kalgi-tura"}, "madsrdf:elementList": {"@list": [{"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026961"}], "madsrdf:hasSource": [{"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab5"}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab6"}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab7"}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab8"}], "madsrdf:hasVariant": {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kalgi-tura"}}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kalgi-tura: UF Kalag\u012b-tur\u0101)"}, "madsrdf:citationSource": "LCSH, April 8, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 30 (Kalgi-tura; traditional art form of singing songs)"}, "madsrdf:citationSource": "Tamasha folk theatre of Maharashtra, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kalgi-Tura is a musical ballad tradition prevalent in North Karnataka)"}, "madsrdf:citationSource": "Classical Kannada WWW site, viewed Feb. 1, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(kalgi-tura laavani (ballad) tradition; \"Kalgi-Tura\" is competitive singing glorifying feminine paws as pitted against masculine prowess. The challenge is thrown and accepted. With rhyme and rhythm, meaning and sound, \"Kalgi-Tura\" is interesting to watch and listen. The performance is in 'Kannada.'; The 'Kalgi-Tura' begins when Phakiravva beats a \"Duff\" (percussion) slowly, deliberately, getting herself ready to burst forth in her \"Kalgi\" songs to challenge the principle of male chauvinism down the ages of \"Tura\" (laavani) tradition.; Phakiravva leading artist of the Kalgi-Tura tradition moves on stage with supreme confidence and strikes challenging postures suiting the theme of the song. Within minutes of singing Phakiravva creates a theater through content, song and dance."}, "madsrdf:citationSource": "Udupi pages WWW site, March 24, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kalag\u012b-tur\u0101"}}, {"@id": "_:n52dc0257d12141d2bf191eef2e7c3dfab10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kalag\u012b-tur\u0101"}}], "@id": "/authorities/genreForms/gf2016026047"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026048", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMadrigal comedies", "identifiers:lccn": "gf2016026048", "madsrdf:adminMetadata": [{"@id": "_:nd33e443aa27a4840a04d75d04f8150a0b1"}, {"@id": "_:nd33e443aa27a4840a04d75d04f8150a0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Madrigal comedies"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd33e443aa27a4840a04d75d04f8150a0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasSource": {"@id": "_:nd33e443aa27a4840a04d75d04f8150a0b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music of the late Italian Renaissance that consists of a series of secular vocal pieces with a well-defined plot."}, {"@id": "_:nd33e443aa27a4840a04d75d04f8150a0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd33e443aa27a4840a04d75d04f8150a0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd33e443aa27a4840a04d75d04f8150a0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Madrigal comedies"}}, {"@id": "_:nd33e443aa27a4840a04d75d04f8150a0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A term in general use to describe madrigalesque entertainment music of the late Renaissance in Italy. In the widest sense of the term, a madrigal comedy consists of a series of secular vocal pieces held together by a more or less well-defined plot or story in which the music is descriptive of the action of the characters or situation.)"}, "madsrdf:citationSource": "Grove music online, viewed August 6, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026048"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026049", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMand\u00f3", "identifiers:lccn": "gf2016026049", "madsrdf:adminMetadata": [{"@id": "_:n3af347ea8484434d959d8f3381807a62b1"}, {"@id": "_:n3af347ea8484434d959d8f3381807a62b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mand\u00f3"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3af347ea8484434d959d8f3381807a62b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n3af347ea8484434d959d8f3381807a62b5"}, {"@id": "_:n3af347ea8484434d959d8f3381807a62b6"}, {"@id": "_:n3af347ea8484434d959d8f3381807a62b7"}, {"@id": "_:n3af347ea8484434d959d8f3381807a62b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3af347ea8484434d959d8f3381807a62b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3af347ea8484434d959d8f3381807a62b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n3af347ea8484434d959d8f3381807a62b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mand\u00f3"}}, {"@id": "_:n3af347ea8484434d959d8f3381807a62b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 5, p. 739 (under Goa: the mand\u00f3 genre, of Christian origin, consists of songs with instrumental accompaniment and sometimes also with dance; sung by two or three voices, in Western classical harmony)"}, "madsrdf:citationSource": "Garland encyc. of world music:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3af347ea8484434d959d8f3381807a62b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 58 (under Goa: mando, a Portuguese-derived style of popular folk music and folk song)"}, "madsrdf:citationSource": "White, D. Dict. of pop. mus. styles of the world:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3af347ea8484434d959d8f3381807a62b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mand\u00f3: composite genre of poetry, music and dance, popular among the Catholics of Goa and the neighbouring regions on the west coast of India; the lyrics in Konkani, the language of Goa, include words borrowed or derived from Portuguese; parallel singing in two voices is a distinctive feature of mand\u00f3)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Feb. 22, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n3af347ea8484434d959d8f3381807a62b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mando, mandos; dance song; sung by a combination of two voices)"}, "madsrdf:citationSource": "Work cat.: 99947897: Pereira, J. Song of Goa, 2000", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026049"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026050", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMasques (Music)", "identifiers:lccn": "gf2016026050", "madsrdf:adminMetadata": [{"@id": "_:ned9c587d41bc4652bb4ebe78ca36d3c8b1"}, {"@id": "_:ned9c587d41bc4652bb4ebe78ca36d3c8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Masques (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ned9c587d41bc4652bb4ebe78ca36d3c8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasSource": {"@id": "_:ned9c587d41bc4652bb4ebe78ca36d3c8b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "The music of 16th-17th century courtly entertainments that combined poetic drama, music, dance, song, lavish costume, and costly stage effects with a simple mythological or allegorical plot."}, {"@id": "_:ned9c587d41bc4652bb4ebe78ca36d3c8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ned9c587d41bc4652bb4ebe78ca36d3c8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ned9c587d41bc4652bb4ebe78ca36d3c8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Masques (Music)"}}, {"@id": "_:ned9c587d41bc4652bb4ebe78ca36d3c8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A genre of entertainment that developed in England during the 16th and 17th centuries around a masked dance. Based on allegorical or mythological themes and involving poetry, music and elaborate sets...)"}, "madsrdf:citationSource": "Grove music online, viewed August 10, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026050"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026051", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMelodramas (Music)", "identifiers:lccn": "gf2016026051", "madsrdf:adminMetadata": [{"@id": "_:n737b7b410c5a4b499214e216016df28fb1"}, {"@id": "_:n737b7b410c5a4b499214e216016df28fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Melodramas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n737b7b410c5a4b499214e216016df28fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026054"}, "madsrdf:hasSource": {"@id": "_:n737b7b410c5a4b499214e216016df28fb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Dramas in which the main character speaks during the pauses of, or during, musical accompaniment."}, {"@id": "_:n737b7b410c5a4b499214e216016df28fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n737b7b410c5a4b499214e216016df28fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n737b7b410c5a4b499214e216016df28fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Melodramas (Music)"}}, {"@id": "_:n737b7b410c5a4b499214e216016df28fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Melodrama (A kind of drama, or a part of a drama, in which the action is carried forward by the protagonist speaking in the pauses of, and later commonly during, a musical accompaniment. (It is distinct from the Italian melodramma, meaning simply \"musical drama\", or opera.) The brief orchestral passages that separate the dialogues are clearly related to, and presumably in a sense derived from, those in accompanied operatic recitative (just as the pantomimic movement and gesture of a scene like Beckmesser's discovery of the song manuscript in Die Meistersinger von N\u00fcrnberg, Act 3, has its antecedents in the ballet-pantomime). The term \"melodrama: is also used in a less specifically musical sense to denote a kind of play, particularly popular in the 19th century (more commonly without a musical accompaniment) in which romantic and frequently sensational happenings that follow certain conventions are carried through until at the end Good triumphs and Evil is frustrated. This article is concerned almost entirely with the first of these definition. ... It is more fruitful to consider melodrama as a technique that seeks a particular kind of balance between words and music than to look upon it as an independent dramatic genre)"}, "madsrdf:citationSource": "Grove music online, March 24, 2016:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026051"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026052", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMinstrel shows", "identifiers:lccn": "gf2016026052", "madsrdf:adminMetadata": [{"@id": "_:n6ba8081a65d8445aa91821308864b00ab1"}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Minstrel shows"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6ba8081a65d8445aa91821308864b00ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027050"}, "madsrdf:hasSource": {"@id": "_:n6ba8081a65d8445aa91821308864b00ab5"}, "madsrdf:hasVariant": [{"@id": "_:n6ba8081a65d8445aa91821308864b00ab6"}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab9"}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Minstrel shows"}}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "minstrel show (also called minstrelsy, an indigenous American theatrical form, popular from the early 19th to the early 20th century, that was founded on the comic enactment of racial stereotypes. The tradition reached its zenith between 1850 and 1870. The earliest minstrel shows were staged by white male minstrels (traveling musicians) who, with their faces painted black, caricatured the singing and dancing of slaves. Scholars usually distinguish this form of the tradition as blackface minstrelsy.)"}, "madsrdf:citationSource": "Britannica online, April 8, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ba8081a65d8445aa91821308864b00ab7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "African American minstrel shows"}}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "African American minstrel shows"}}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ba8081a65d8445aa91821308864b00ab10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Minstrelsy"}}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Minstrelsy"}}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6ba8081a65d8445aa91821308864b00ab13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Blackfaced minstrel shows"}}, {"@id": "_:n6ba8081a65d8445aa91821308864b00ab13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blackfaced minstrel shows"}}], "@id": "/authorities/genreForms/gf2016026052"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026053", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aModel operas", "identifiers:lccn": "gf2016026053", "madsrdf:adminMetadata": [{"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb1"}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Model operas"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026012"}, "madsrdf:hasSource": [{"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb5"}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb6"}], "madsrdf:hasVariant": [{"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb7"}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Operas that combined Western instrumentation and Beijing opera singing and were composed during the Cultural Revolution."}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Model operas"}}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under China, II, History and theory. 6. Since 1911 (The music conservatories and many urban professional performance units were closed down during the Cultural Revolution, and much of their repertory, whether for Western or Chinese instruments, was banned. Nonetheless, some composition and performance was allowed at this time, including the combination of Western instruments and Beijing opera singing first assayed in 1968 with an arrangement of songs from the revolutionary model opera Hongdeng ji (\"The Red Lantern\") by pianist Yin Chengzong (b 1941). This was one of the few so-called \"model operas\" (yangbanxi) passed for performance by the cultural authorities. These operas have been criticized for reducing drama to a moralistic triumph of good over evil, yet the music was regarded by many as very well crafted, and in recent years there has been a resurgence of enthusiasm for several of these compositions.)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Revolutionary opera refers to the model operas planned and engineered during the Cultural Revolution by Jiang Qing, the wife of Chairman Mao Zedong. As Communist Party-sanctioned operas, they were considered \"revolutionary\" and modern in terms of thematic and musical features when compared with traditional operas. In total, eight revolutionary operas were made, and, according to some sources, they were the only forms of artistic expression allowed in China at the time)"}, "madsrdf:citationSource": "Wikipedia, Apr. 13, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yangbanxi"}}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yangbanxi"}}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Revolutionary operas (Model operas)"}}, {"@id": "_:nc79e8c0fa1474dc2b2688519ba5c1f0cb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Revolutionary operas (Model operas)"}}], "@id": "/authorities/genreForms/gf2016026053"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026054", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMonodramas (Music)", "identifiers:lccn": "gf2016026054", "madsrdf:adminMetadata": [{"@id": "_:n92856aa36cde4c57b768b88655b521c5b1"}, {"@id": "_:n92856aa36cde4c57b768b88655b521c5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Monodramas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n92856aa36cde4c57b768b88655b521c5b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026051"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026055"}], "madsrdf:hasSource": {"@id": "_:n92856aa36cde4c57b768b88655b521c5b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n92856aa36cde4c57b768b88655b521c5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n92856aa36cde4c57b768b88655b521c5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n92856aa36cde4c57b768b88655b521c5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monodramas (Music)"}}, {"@id": "_:n92856aa36cde4c57b768b88655b521c5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In its narrow meaning, a form of Melodrama which features one character, sometimes with chorus, using speech in alternation with short passages of music, or sometimes speaking over music. Simultaneously with melodrama, the initial enthusiasm for monodrama occurred chiefly in Germany during the 1770s and 80s, and the two terms are often used interchangeably, since many of the early melodramas had only one character on stage at a time...In modern times, the term has lost its exclusive association with the combination of speech and music characteristic of melodrama and is most often used as a synonym for a one-character opera, as in Schoenberg's Erwartung (1909) and Poulenc's La voix humaine (1958); as a non-staged dramatic work for singer and orchestra, as in Poulenc's La dame de Monte Carlo (1961), Floyd's Flower and Hawk (1972), Rochberg's Phaedra (1973--4), J.E. Ivey's Testament of Eve (1976) and Peter Maxwell Davies's The Medium (1981); or even as a purely instrumental work.)"}, "madsrdf:citationSource": "New Grove dict. of mus. online, Mar. 11, 2013", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026054"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026055", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMonologues (Music)", "identifiers:lccn": "gf2016026055", "madsrdf:adminMetadata": [{"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b1"}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Monologues (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026054"}, "madsrdf:hasVariant": [{"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b5"}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b8"}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions in which spoken language is an integral part."}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monologues (Music)"}}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Recitations with music"}}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Recitations with music"}}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Narrations with music"}}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Narrations with music"}}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Speaking with music"}}, {"@id": "_:nb0cb0cb8aa964018ad56c9bf9a905d05b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Speaking with music"}}], "@id": "/authorities/genreForms/gf2016026055"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026056", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMurgas", "identifiers:lccn": "gf2016026056", "madsrdf:adminMetadata": [{"@id": "_:n15d6481eda0442d4a1454d561e57ed52b1"}, {"@id": "_:n15d6481eda0442d4a1454d561e57ed52b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Murgas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n15d6481eda0442d4a1454d561e57ed52b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n15d6481eda0442d4a1454d561e57ed52b5"}, {"@id": "_:n15d6481eda0442d4a1454d561e57ed52b6"}, {"@id": "_:n15d6481eda0442d4a1454d561e57ed52b7"}, {"@id": "_:n15d6481eda0442d4a1454d561e57ed52b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n15d6481eda0442d4a1454d561e57ed52b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:44:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n15d6481eda0442d4a1454d561e57ed52b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n15d6481eda0442d4a1454d561e57ed52b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Murgas"}}, {"@id": "_:n15d6481eda0442d4a1454d561e57ed52b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 51 (traditional murga contains bass drum, snare and cymbals, played by three percussionist; traditional rhythms include marcha cami\u00f3n and the murga candombeada)"}, "madsrdf:citationSource": "Work cat.: 792883700: Romano, M. Coordinaci\u00f3n \u0155tmica : candombe y murga para bater\u00eda, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n15d6481eda0442d4a1454d561e57ed52b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Uruguay, Traditional and popular music, Mestizo music and instruments: murga is a dramatic form used traditionally during Carnival festivities; during the 'golden age' of the 1940s certain characteristics emerged and were consolidated, including the free use of fashionable tunes with satirical lyrics, delivery with a strong nasal voice, use of mestizo rhythms supported by a bass drum, snare drum, and cymbals, and a repertory of gestures and choreographic movements performed by musicians with painted faces wearing colorful clothes; during the 1960s, a number of popular musicians began to build songs based on the marcha cami\u00f3n, one of its rhythmic patterns, and by the 1990s murga was a successful part of the repertory of popular singer-composers)"}, "madsrdf:citationSource": "Grove music online, Apr. 24, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n15d6481eda0442d4a1454d561e57ed52b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2 (under Uruguay: a type of theatrical group which performs in Montevideo during Carnival; instrumentation includes bass drum, cymbal, snare drum, and occasionally aerophones; [the word \"murga\" is used both as the name of the ensemble and the type of music performed by these ensembles])"}, "madsrdf:citationSource": "Garland encyclopedia of world music in Music online, Apr. 24, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n15d6481eda0442d4a1454d561e57ed52b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(murga refers to both a choral-theatrical-musical genre and the ensembles which perform it, usually during festivals like Carnival, celebrations, and sporting events; popular in Uruguay, Spain, Argentina and Panama; also performed in Chile and Colombia; chorus with percussion and sometimes with other instruments)"}, "madsrdf:citationSource": "Spanish Wikipedia, May 1, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2016026056"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026057", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMusic theater", "identifiers:lccn": "gf2016026057", "madsrdf:adminMetadata": [{"@id": "_:nefe9b58bd2d849549375a2846830fb42b1"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Music theater"}, "madsrdf:elementList": {"@list": [{"@id": "_:nefe9b58bd2d849549375a2846830fb42b3"}]}, "madsrdf:exampleNote": "Note under [Musicals; Revues]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:nefe9b58bd2d849549375a2846830fb42b5"}, "madsrdf:hasSource": [{"@id": "_:nefe9b58bd2d849549375a2846830fb42b8"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b9"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b10"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b11"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b12"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b13"}], "madsrdf:hasVariant": [{"@id": "_:nefe9b58bd2d849549375a2846830fb42b14"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b17"}], "madsrdf:historyNote": "[Heading changed from Musical theater to Music theater in May 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical works, often small in scale and primarily of the 20th century, that combine elements of music, drama, and sometimes dance in unconventional ways that result in works distinct from traditional forms. For musical/theatrical productions consisting of musical numbers integrated into a dramatic framework see [Musicals.] For theatrical productions from around the end of the 18th century that feature a series of songs, dances, and other entertainments without any unifying dramatic element see [Revues.]"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-05-26T14:29:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "revised"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Music theater"}}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nefe9b58bd2d849549375a2846830fb42b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Musical theater"}}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musical theater"}}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(music theater)"}, "madsrdf:citationSource": "New Harvard dictionary of music", "madsrdf:citationStatus": "found"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(music theater)"}, "madsrdf:citationSource": "Thames & Hudson encyclopedia of 20th-century music", "madsrdf:citationStatus": "found"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lyric theater: a theatrical production involving music)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(music theater)"}, "madsrdf:citationSource": "New Grove opera", "madsrdf:citationStatus": "found"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Cage, John. Theatre piece.", "madsrdf:citationStatus": "found"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Music theatre (A term often used to characterize a kind of opera and opera production in which spectacle and dramatic impact are emphasized over purely musical factors. It was first used specifically in the 1960s to describe the small-scale musico-dramatic works by composers of the postwar generations that proliferated in western Europe and North America during that decade; 'Music theatre' became an umbrella term covering works ranging from those that were in effect chamber operas, demanding traditional vocal techniques and a high degree of virtuosity in performance, to pieces such as Stockhausen's Herbstmusik (1974) and Musik im Bauch (1975) and many works by Schnebel and Kagel in which the overt musical content was at best minimal; Other composers represented include Cage, Partch, Birtwistle, and Maxwell Davies)"}, "madsrdf:citationSource": "Grove music online, February 14, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nefe9b58bd2d849549375a2846830fb42b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Musical theater"}}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musical theater"}}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nefe9b58bd2d849549375a2846830fb42b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lyric theater"}}, {"@id": "_:nefe9b58bd2d849549375a2846830fb42b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lyric theater"}}], "@id": "/authorities/genreForms/gf2016026057"}
