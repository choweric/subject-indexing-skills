474899cd20e642a8328bb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Vocal chamber music works for multiple voices or chorus, accompanied or unaccompanied."}, {"@id": "_:na79a605227a9474899cd20e642a8328bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:52:18"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na79a605227a9474899cd20e642a8328bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na79a605227a9474899cd20e642a8328bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Part songs"}}, {"@id": "_:na79a605227a9474899cd20e642a8328bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(part song: 1. An unaccompanied secular choral work of relatively modest length; 2. Any unaccompanied secular vocal work)"}, "madsrdf:citationSource": "New Harvard dict. music", "madsrdf:citationStatus": "found"}, {"@id": "_:na79a605227a9474899cd20e642a8328bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(partsong)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Oct. 12, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:na79a605227a9474899cd20e642a8328bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(part-song)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:na79a605227a9474899cd20e642a8328bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(part song)"}, "madsrdf:citationSource": "Amer. heritage dict., 3rd ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:na79a605227a9474899cd20e642a8328bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "partsong (a piece of music in two or more voice-parts without independent accompaniment. In theory, the term encompasses forms such as the glee, madrigal and unaccompanied anthem; in practice, usually refers to small-scale secular pieces for unaccompanied choral singing; no precise definition is possible.)"}, "madsrdf:citationSource": "New Grove dict. of music online, Mar. 22, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:na79a605227a9474899cd20e642a8328bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(part song)"}, "madsrdf:citationSource": "Music index WWW site, Oct. 12, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:na79a605227a9474899cd20e642a8328bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(part song)"}, "madsrdf:citationSource": "Baker's dict. of music", "madsrdf:citationStatus": "found"}, {"@id": "_:na79a605227a9474899cd20e642a8328bb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(part song)"}, "madsrdf:citationSource": "RILM abstracts of music literature via FirstSearch, Oct. 12, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:na79a605227a9474899cd20e642a8328bb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(part song)"}, "madsrdf:citationSource": "Oxf. companion to music", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026984"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026985", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPartimenti", "identifiers:lccn": "gf2014026985", "madsrdf:adminMetadata": [{"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b1"}, {"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Partimenti"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b5"}, {"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b6"}, {"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b7"}, {"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Partimenti"}}, {"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(partimento: term used fairly frequently in the late 18th and early 19th cents. to denote exercises in figured-bass playing, not so much as accompaniments to a solo instrument as self-contained pieces; plural given as partimenti)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Mar. 27, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2001269635: The Langloz manuscript, 2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(partimento, pl. partimenti: musical exercise in contrapuntal improvisation of the 17th and 18th cents., generally played or written on a figured bass)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ad121fb24904c3ca79c2dda5f3853e6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(partimento: in 18th and early 19th cents., a thoroughbass part with occasional melodic suggestions on the basis of which a complete composition rather than simply an accompaniment was to be improvised; numerous such pieces, mainly conceived as pedagogical in nature, were composed by Italian, especially Neapolitan, keyboard composers of the 18th cent.)"}, "madsrdf:citationSource": "New Harvard dict. mus.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026985"}
