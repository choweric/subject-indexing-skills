fcda7f1fda423ea9cd4bd01aef8d8db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Climate fiction"}}, {"@id": "_:n3ffcda7f1fda423ea9cd4bd01aef8d8db5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Butler, O.E. Parable of the sower, 1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ffcda7f1fda423ea9cd4bd01aef8d8db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 1 (cli-fi; term apparently coined by the journalist Dan Bloom in 2007) page 2 (a distinctive body of cultural work which engages with anthropogenic climate change, exploring the phenomenon not just in terms of setting, but with regard to psychological and social issues, combining fictional plots with meteorological facts, speculation on the future and reflection on the human-nature relationship)"}, "madsrdf:citationSource": "Cli-fi, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ffcda7f1fda423ea9cd4bd01aef8d8db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(climate fiction; sometimes shortened to cli-fi; literature that deals with climate change and global warming)"}, "madsrdf:citationSource": [{"@id": "https://en.wikipedia.org/wiki/Climate_fiction"}, "Wikipedia, 28 May 2021"], "madsrdf:citationStatus": "found"}, {"@id": "_:n3ffcda7f1fda423ea9cd4bd01aef8d8db8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3ffcda7f1fda423ea9cd4bd01aef8d8db9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cli-fi"}}, {"@id": "_:n3ffcda7f1fda423ea9cd4bd01aef8d8db9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cli-fi"}}, {"@id": "_:n3ffcda7f1fda423ea9cd4bd01aef8d8db11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3ffcda7f1fda423ea9cd4bd01aef8d8db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Climate change fiction"}}, {"@id": "_:n3ffcda7f1fda423ea9cd4bd01aef8d8db12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Climate change fiction"}}], "@id": "/authorities/genreForms/gf2021026022"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026025", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJhumur (Music)", "identifiers:lccn": "gf2021026025", "madsrdf:adminMetadata": [{"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab1"}, {"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jhumur (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}], "madsrdf:hasSource": [{"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab5"}, {"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab6"}, {"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab7"}, {"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-12-20T10:32:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jhumur (Music)"}}, {"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jhumur is a folk music form popular in the bordering states of Bengal and Bihar. The oral form is another unique feature of Jhumur. On its journey through generations, the songs are embedded with new words, new tunes, new ideas and new thoughts and sometimes make an entire transformation by way of abandoning the old form in its totality)"}, "madsrdf:citationSource": "Folklibrary.com WWW site, January 22, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online, June 11, 2021", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (Laal matir jhumur; a compilation of jhumur songs) container (\"Jhumur is the lifestyle music and dance of the people of Chhotanagpur plateau, including Bankura and Purulia districts of West Bengal ... the songs are a soulful manifestation of local inhabitants' daily life, including their joys and sorrows, struggle and tribulations. There are many songs and dances celebrating different daily chores, rituals and festivities\") (DLC)2021618927"}, "madsrdf:citationSource": "Work cat: Laal matir jhumur, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nee1e25f6eda94aabbe502f740f66dd6ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jhumur is a folk music form of the Chhotanagpur plateau covering several districts of West Bengal, Jharkhand and Odisha. Its origin dates back to the pre-Vaishnav Padabali period (15th century onwards). Jhumur songs and dances are an integral part of local community parabs (festivals), rituals (like Badna, Tusu, Karam Puja) and occasions like weddings and harvests. A unique feature of Jhumur is that it is an oral tradition)"}, "madsrdf:citationSource": "Bncmusical WWW site, January 22, 2018", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2021026025"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026026", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aArtists' statements", "identifiers:lccn": "gf2021026026", "madsrdf:adminMetadata": [{"@id": "_:n540b111f6300469888ecac0478e99c53b1"}, {"@id": "_:n540b111f6300469888ecac0478e99c53b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Artists' statements"}, "madsrdf:elementList": {"@list": [{"@id": "_:n540b111f6300469888ecac0478e99c53b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026163"}, "madsrdf:hasSource": [{"@id": "_:n540b111f6300469888ecac0478e99c53b5"}, {"@id": "_:n540b111f6300469888ecac0478e99c53b6"}, {"@id": "_:n540b111f6300469888ecac0478e99c53b7"}], "madsrdf:hasVariant": [{"@id": "_:n540b111f6300469888ecac0478e99c53b8"}, {"@id": "_:n540b111f6300469888ecac0478e99c53b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Texts by artists that describe and explain the artist's work or theoretical concepts on which the work is based."}, {"@id": "_:n540b111f6300469888ecac0478e99c53b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-11-23T12:01:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n540b111f6300469888ecac0478e99c53b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/nalfc"}, "ri:recordStatus": "new"}, {"@id": "_:n540b111f6300469888ecac0478e99c53b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Artists' statements"}}, {"@id": "_:n540b111f6300469888ecac0478e99c53b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(artists' statements; UF artist's statement; statements, artists'; artists statements; SN Texts by artists, often brief, that state, for example, explanations of the artists' work or theoretical concepts on which their work is based.; hierarchy: declaratory documents, under documents by function, under document genres)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, viewed October 1, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n540b111f6300469888ecac0478e99c53b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Artist's statement; An artist's statement (or artist statement) is an artist's written description of their work. The brief verbal representation is for, and in support of, their own work to give the viewer understanding. As such it aims to inform, connect with an art context, and present the basis for the work; it is, therefore, didactic, descriptive, or reflective in nature.)"}, "madsrdf:citationSource": "Wikipedia, viewed October 1, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n540b111f6300469888ecac0478e99c53b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(each artist contribution includes a picture and an artist's statement) (OCoLC)1236890054"}, "madsrdf:citationSource": "Work cat: 2017 state of the art : ceramics invitational : inspiration and admiration, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n540b111f6300469888ecac0478e99c53b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n540b111f6300469888ecac0478e99c53b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Artist statements"}}, {"@id": "_:n540b111f6300469888ecac0478e99c53b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Artist statements"}}, {"@id": "_:n540b111f6300469888ecac0478e99c53b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n540b111f6300469888ecac0478e99c53b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Statements, Artists'"}}, {"@id": "_:n540b111f6300469888ecac0478e99c53b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Statements, Artists'"}}], "@id": "/authorities/genreForms/gf2021026026"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026027", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRancheras", "identifiers:lccn": "gf2021026027", "madsrdf:adminMetadata": [{"@id": "_:nb673fc4ae750455bbadfa9c85688a191b1"}, {"@id": "_:nb673fc4ae750455bbadfa9c85688a191b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rancheras"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb673fc4ae750455bbadfa9c85688a191b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, "madsrdf:hasSource": [{"@id": "_:nb673fc4ae750455bbadfa9c85688a191b5"}, {"@id": "_:nb673fc4ae750455bbadfa9c85688a191b6"}, {"@id": "_:nb673fc4ae750455bbadfa9c85688a191b7"}, {"@id": "_:nb673fc4ae750455bbadfa9c85688a191b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb673fc4ae750455bbadfa9c85688a191b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-12-20T10:32:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb673fc4ae750455bbadfa9c85688a191b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb673fc4ae750455bbadfa9c85688a191b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rancheras"}}, {"@id": "_:nb673fc4ae750455bbadfa9c85688a191b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert (M\u00e9ndez emerged as a composer with the ranchera song (canci\u00f3n ranchera) Gorrioncillo pecho amarillo) (DLC)2003696438"}, "madsrdf:citationSource": "Work cat: Tributo a Tom\u00e1s M\u00e9ndez, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nb673fc4ae750455bbadfa9c85688a191b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 101 (\"...ranchera regionally based genre of mexico...\")"}, "madsrdf:citationSource": "Garland encyc. world music", "madsrdf:citationStatus": "found"}, {"@id": "_:nb673fc4ae750455bbadfa9c85688a191b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ranchera is a genre of the traditional music of Mexico. Although closely associated with the mariachi groups which evolved in Jalisco in the post-revolutionary period, rancheras are also played today by norte\u00f1o (or Conjunto) or banda (or Duranguense) groups; traditional rancheras are about love, patriotism or nature)"}, "madsrdf:citationSource": "Wikipedia WWW site, Feb. 12, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:nb673fc4ae750455bbadfa9c85688a191b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ranchera: the literal definition of the term is a ranch song; they were sung in Mexico between acts of nation centered plays, and became quite commercially oriented after 1910. Rancheras: very powerful songs expressing sentimentally associated with a person's love for their country)"}, "madsrdf:citationSource": "All music guide WWW site, Feb. 12, 2010", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2021026027"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026028", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aInvectives (Literature)", "identifiers:lccn": "gf2021026028", "madsrdf:adminMetadata": [{"@id": "_:n718c5a313d8041eba08f470c5042492fb1"}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Invectives (Literature)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n718c5a313d8041eba08f470c5042492fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasSource": [{"@id": "_:n718c5a313d8041eba08f470c5042492fb5"}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb6"}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb7"}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb8"}], "madsrdf:hasVariant": {"@id": "_:n718c5a313d8041eba08f470c5042492fb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-09-15T13:56:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Invectives (Literature)"}}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (a scathing indictment of the emperor Justinian and his sixth-century Byzantine court; The outstanding example of vituperative literature that has come to us from all antiquity)"}, "madsrdf:citationSource": "Procopius. Secret history, 1963, via Google books, viewed June 21, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (the invectives of 'Sallust' against 'Cicero' and of 'Cicero' against 'Sallust') p. 12 (\"Invective\" (invectiva, from oratio invectiva, from invehor) means abusive speech, or refers to an abusive written text) p. 13 (Invective is a literary form that aims to humiliate its object in public by any possible means and which addresses the object by name) (OCoLC)436454523"}, "madsrdf:citationSource": "Work cat.: The invectives of Sallust and Cicero : critical edition with introduction, translation, and commentary, \u00a92009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Invective. the literary device in which one attacks or insults a person or thing through the use of abusive language and tone; can be divided into two types: high and low invective; high invective requires the use of formal and creative language; low invective makes use of rude and offensive images; share the same goal: to insult and offend)"}, "madsrdf:citationSource": "Literary terms website, June 21, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Invective; personal attack or satire, often scurrilous, formerly written mainly in verse; di\ufb00erentiated from satire on the grounds that it is personal, motivated by malice, and unjust; is as old as poetry and as widespread; in the West, it appears (if not in the Homeric Margites) at least as early as Archilochus, who wrote an invective against Lycambes; other notable Gr. examples include those by Hipponax against Bupalus, by Anacreon against Artemon, and others by Xenophanes, Timon of Phlius, Sotades (see sotadean), Menippus, and (less virulently) Callimachus; In Lat., invective written chie\ufb02y by Catullus (see choliambus), Ovid (Ibis), Martial, and Varro; in the Middle Ages, Petrarch's invective against doctors, Invective contra medicum, is notable; in the Ren., the scope of personal invective was expanded considerably by the invention of printing, which provided broadsides, bills, and ballads particularly well suited for rapid and wide dispersal of political invective and satire; After 1750, however, verse invective gave ground to prose as the medium of choice, except in the (remarkably durable) trad. of the epigram, incl. scurrilous and vindictive epigrams, which were produced in the 20th c., notably by J. V. Cunningham)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012", "madsrdf:citationStatus": "found"}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n718c5a313d8041eba08f470c5042492fb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vituperative literature"}}, {"@id": "_:n718c5a313d8041eba08f470c5042492fb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vituperative literature"}}], "@id": "/authorities/genreForms/gf2021026028"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026030", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEditorials", "identifiers:lccn": "gf2021026030", "madsrdf:adminMetadata": [{"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b1"}, {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Editorials"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}, "madsrdf:hasSource": [{"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b5"}, {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b6"}, {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b7"}], "madsrdf:hasVariant": {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-09-15T13:56:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ncu"}, "ri:recordStatus": "new"}, {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Editorials"}}, {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (editorials) page 2 (previously published in my weekly newspaper The independent and in The down homer) (OCoLC)1257795868"}, "madsrdf:citationSource": "Work cat: Saunders, W.O. A concept of life, 1921:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "editorial (def. 2b: noun: Originally U.S. An article in a newspaper, magazine, or similar publication that expresses the editor's opinion or the publication's position on a topical issue; a leading article, a leader. Also: a commentary broadcast on radio or television expressing the opinion of the station or network.) leading article (def. 1: noun: One of the longer large-type articles in a newspaper, appearing as the expression of editorial opinion on any subject; a leader)"}, "madsrdf:citationSource": "OED online, Aug. 11, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(editorial: A leader column that offers what purports to be the opinion of the editor)"}, "madsrdf:citationSource": "Harcup, T. A dictionary of journalism, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Leading articles"}}, {"@id": "_:n0fcad4857e3c4bd6a745d7f56b327416b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Leading articles"}}], "@id": "/authorities/genreForms/gf2021026030"}
