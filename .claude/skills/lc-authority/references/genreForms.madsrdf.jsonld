oks"}}], "@id": "/authorities/genreForms/gf2014026145"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026146", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPicture dictionaries", "identifiers:lccn": "gf2014026146", "madsrdf:adminMetadata": [{"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b1"}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Picture dictionaries"}, "madsrdf:elementList": {"@list": [{"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026086"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}], "madsrdf:hasSource": [{"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b5"}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b6"}], "madsrdf:hasVariant": [{"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b7"}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picture dictionaries"}}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picture dictionary See: visual dictionary; visual dictionary: A dictionary in which words and phrases (grouped by subject, theme, or activity) are illustrated, usually in a line drawing on the same or the opposite page, with each term keyed to the corresponding feature in the diagram by a thin line or small reference number printed on the illustration. The format is also used in language dictionaries with the terms corresponding to the illustrations given in two languages. Synonymous with pictorial dictionary and picture dictionary.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picture dictionaries. UF pictorial dictionaries)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Visual dictionaries"}}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Visual dictionaries"}}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pictorial dictionaries"}}, {"@id": "_:n51ad8f1c9165478dbe3a9172ce293b72b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pictorial dictionaries"}}], "@id": "/authorities/genreForms/gf2014026146"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026147", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPicture puzzles", "identifiers:lccn": "gf2014026147", "madsrdf:adminMetadata": [{"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b1"}, {"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Picture puzzles"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027266"}], "madsrdf:hasSource": [{"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b5"}, {"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b6"}, {"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Puzzles that consist of visual images, including connect-the-dots, hidden images, optical illusions, spot-the-differences, what's wrong with this picture, etc."}, {"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:46:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picture puzzles"}}, {"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picture puzzles. Puzzles consisting usually of irregularly cut pieces of pasteboard or wood that when fitted together form complete pictures; historically, the images would not include maps nor would they purport to have an educational emphasis. For similar puzzles of maps, with an educational function, popular from the mid-18th to the early 19th century, use \"dissected maps.\" For puzzles with tightly interlocking pieces made with a jig or jigsaw, use \"jigsaw puzzles\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Picture puzzles. Scope note: Pictures in which some figures or objects are not readily apparent, for example, animal shapes hidden in trees or in a landscape. BT Puzzles. RT Hidden image works)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ad3cfe6a72941089a8d094c7f031209b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picture puzzle: A graphic image that includes figures or objects not readily apparent, for example, human or animal forms hidden in vegetation or in a landscape)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 30, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026147"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026148", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPlaybills (Posters)", "identifiers:lccn": "gf2014026148", "madsrdf:adminMetadata": [{"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb1"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Playbills (Posters)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb3"}]}, "madsrdf:exampleNote": "Note under [Theater programs]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026152"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026038"}], "madsrdf:hasSource": [{"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb5"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb6"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb7"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb8"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb9"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb10"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb11"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb12"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb13"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb14"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb15"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb16"}], "madsrdf:hasVariant": [{"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb17"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb20"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb23"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb26"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb29"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb32"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb35"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Posters or single-sheet programs advertising a theatrical performance, usually listing the cast. For booklets that provide a description of a performance and its cast and crew, and are typically distributed to audience members, see [Theater programs.]"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-09-19T07:32:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Playbills (Posters)"}}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Playbills. Use for single-sheet items advertising plays, usually announcing the cast. BT Broadsides. RT Cast lists; Plays; Theater programs)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill 1. A poster announcing a theatrical performance. 1.1. North American: A theater program)"}, "madsrdf:citationSource": "Oxford dictionaries website, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill: A printed poster or circular advertising the performance of a play, usually indicating the names of the actors and actresses cast in the leading roles. Also, a program for a play or other theatrical entertainment, printed on a single sheet.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill 1 a printed notice advertising a play 2 (North American English) a theatre programme)"}, "madsrdf:citationSource": "Oxford learner's dictionaries website, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill. 1. a poster or circular advertising a play. 2. a program of a play, listing the cast, staff, etc.)"}, "madsrdf:citationSource": "Webster's new world college dictionary, via WWW, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 63 (playbill: poster announcing a play; (US) theatre programme)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Playbills. Scope Note: Programs printed on one sheet for plays or theatrical entertainments. BT Broadsides. RT Theater programs. Theatrical posters)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill: a poster or piece of paper that advertises a play)"}, "madsrdf:citationSource": "Merriam-Webster online, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill: 1. a poster or bill advertising a play 2. the programme of a play)"}, "madsrdf:citationSource": "Collins English dictionary - complete & unabridged 10th edition, via WWW, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poster promoting University of Washington student production of George S. Kaufman and Marc Connelly's play, \"Beggar on Horseback,\" presented at Meany Hall on February 12-13, 1926. It features a large, stylized image of a figure riding a horse and is signed: M. Bayley (possibly Mildred Bayley, a graduating senior in Fine Arts).)"}, "madsrdf:citationSource": "The beggar on horseback : Feb. 12-13, Meany Hall, 1926", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill: a program or announcement of a play)"}, "madsrdf:citationSource": "Dictionary.com, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Playbills. BT Broadsides; Posters. RT Theater programs; also: Theatrical posters. UF Theater posters. BT Playbills; Posters)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e9fffe34664a6fb41a328aa9f9c3fbb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6