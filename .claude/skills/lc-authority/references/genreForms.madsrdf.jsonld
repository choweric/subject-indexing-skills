: "_:nf156d4fdb8734f53bc4b301797c75b46b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Textbooks"}}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(primer: Originally, a Book of Hours. Later, a book, often illustrated, written for young children to teach them how to read and spell. Synonymous in this sense with Dick and Jane book. See also: abecedary, battledore, horn book, and speller. In a more general sense, any book that gives the first principles of a subject or basic instruction for beginners.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 82 (textbook)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Textbooks. UF Handbooks; Instruction books. BT Instructional works (Gathering term; do not assign). NT Alphabet books; Chrestomathies; Grammars; Hornbooks; Primers (Instructional books); Readers; Spellers)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(textbooks. UF text books; text-books; texts (instructional materials). Books used as standard works for the formal study of a particular subject.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Textbooks. UF History Textbooks; Programed Texts; Supplementary Textbooks. BT Books; Instructional Materials. NT Multicultural Textbooks)"}, "madsrdf:citationSource": "ERIC thesaurus, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Primers (Textbooks)"}}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Primers (Textbooks)"}}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "School books"}}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "School books"}}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Schoolbooks"}}, {"@id": "_:nf156d4fdb8734f53bc4b301797c75b46b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@