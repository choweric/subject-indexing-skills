en", "@value": "Scooby-Doo television programs"}}], "@id": "/authorities/genreForms/gf2011026563"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026564", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScreen tests", "identifiers:lccn": "gf2011026564", "madsrdf:adminMetadata": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b1"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Screen tests"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}], "madsrdf:hasSource": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b5"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b6"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b7"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b8"}], "madsrdf:hasVariant": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b9"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b12"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b15"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b18"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b21"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b24"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b27"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b30"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Recordings of screen tests.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025509"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-01-04T10:38:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Screen tests"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Audition: work designed to demonstrate a performer's aptitude or to try a scene in a proposed major work. Includes screen tests created for studios or television networks and moving image \"resume\" work submitted by performers)"}, "madsrdf:citationSource": "Moving image genre-form guide online, January 14, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Glossary, p. 27 (Screen tests: filmed or taped auditions for movies or television programs)"}, "madsrdf:citationSource": "Archival moving image materials : a cataloging manual, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Screen tests)"}, "madsrdf:citationSource": "LCSH, January 14, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 86 (Screen tests, auditions, etc.: use for film or video shot as a test of the suitability of performers, props, wardrobe, particular techniques, etc.)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television auditions"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television auditions"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Auditions, Film"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Auditions, Film"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television screen tests"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television screen tests"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motion picture auditions"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion picture auditions"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Film auditions"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film auditions"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Auditions, Television"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Auditions, Television"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Auditions, Motion picture"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Auditions, Motion picture"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncaff365cc3494402a22c7a687a044310b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motion picture screen tests"}}, {"@id": "_:ncaff365cc3494402a22c7a687a044310b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion picture screen tests"}}], "@id": "/authorities/genreForms/gf2011026564"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026565", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScrewball comedy films", "identifiers:lccn": "gf2011026565", "madsrdf:adminMetadata": [{"@id": "_:ndb902003a6074231aef2d884494d238cb1"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Screwball comedy films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndb902003a6074231aef2d884494d238cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026147"}, "madsrdf:hasSource": [{"@id": "_:ndb902003a6074231aef2d884494d238cb5"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb6"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb7"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb8"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb9"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb10"}], "madsrdf:hasVariant": [{"@id": "_:ndb902003a6074231aef2d884494d238cb11"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb14"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb17"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb20"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb23"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb26"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb29"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb32"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025355"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:23:23"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Screwball comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the term should be Screwball comedies and this will be changed in a new ed. of the genre terms; Populist comedies (listed as a UF under Sophisticated comedies) are a different genre)"}, "madsrdf:citationSource": "Phone call to Martha Yee, UCLA film and television archive, April 29, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sophisticated comedies: has scope note: use for fictional works which adopt a light, witty tone to play out a social comedy involving eccentric but lovable characters; epitomized by comedies of the 30's and 40's directed by Hawks, Capra, Lubitsch and Sturges; has UFs: Crazy comedies, Romantic screwball comedies, Screwball comedies, White telephone comedies)"}, "madsrdf:citationSource": "Moving image materials : genre terms, 1st ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Screwball comedy: Screwball comedy is often confused with romantic comedy, but while the two genres share some elements, screwball comedy is a parody of romantic comedy)"}, "madsrdf:citationSource": "Film reference WWW Home page, Oct. 31, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(screwball comedy: A type of film comedy prominent during the 1930s and a product of the Depression period. These films were an escape from reality, offering gay and attractive characters behaving with abandon and freedom in a rich and glamourous world, one filled with eccentric though nonthreatening comic figures; but also presenting a nonvitriolic satire against the idle and not-so-idle rich, often concluded by the successful bonding of a wealthy heroine and a middle-class hero)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dict., 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Screwball comedy: Fictional work in which the plot normally focuses on a comic battle of the sexes between an eccentric, well-to-do female and a generally passive or weak male. They are caught up in a romantic pursuit or patching up a marriage, with romantic love triumphing in the end. The heroine is often the only one aware of romance until the male's resistance is overcome. The characters behave in wacky manner and the dialogue is fast paced and witty. Note: Not necessary to include the term Romance, since that is implied by Screwball comedy; Sophisticated comedy: Fictional work marked by witty and sophisticated dialogue, centering on marital and romantic relationships, and finding humor in the lives and activities of the rich and urbane. Note: Not necessary to include the term Romance, since that is implied by Sophisticated comedy.)"}, "madsrdf:citationSource": "The moving image genre-form guide, via WWW, Jan. 29, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(screwball comedy (crazy comedy, madcap comedy, oddball comedy, romantic comedy, wacky comedy). This type of comedy which emerged in the thirties has been called by various names--oddball comedy, wacky comedy, crazy comedy--but the term screwball comedy is the one which has been most widely accepted. The genre contains many elements already present in sophisticated comedy (q.v.) which antedates it. Entry under Romantic comedy: the following types of comedy also qualify as romantic comedy: Marriage comedy, Screwball comedy, Sophisticated comedy)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb902003a6074231aef2d884494d238cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb902003a6074231aef2d884494d238cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "White telephone comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "White telephone comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb902003a6074231aef2d884494d238cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Madcap comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Madcap comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb902003a6074231aef2d884494d238cb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wacky comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wacky comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb902003a6074231aef2d884494d238cb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crazy comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crazy comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb902003a6074231aef2d884494d238cb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oddball comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oddball comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb902003a6074231aef2d884494d238cb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Madcap romantic comedies"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Madcap romantic comedies"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb902003a6074231aef2d884494d238cb30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romantic screwball comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romantic screwball comedy films"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb902003a6074231aef2d884494d238cb33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Screwball comedies"}}, {"@id": "_:ndb902003a6074231aef2d884494d238cb33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Screwball comedies"}}], "@id": "/authorities/genreForms/gf2011026565"}
