recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n08d38713be8848eca15fea4d95f08cd9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Erotic comics"}}, {"@id": "_:n08d38713be8848eca15fea4d95f08cd9b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n08d38713be8848eca15fea4d95f08cd9b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay erotic comics"}}, {"@id": "_:n08d38713be8848eca15fea4d95f08cd9b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay erotic comics"}}, {"@id": "_:n08d38713be8848eca15fea4d95f08cd9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Erotic comic books, strips, etc.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n08d38713be8848eca15fea4d95f08cd9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Erotic comic books, strips, etc.)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n08d38713be8848eca15fea4d95f08cd9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (Hentai: A Japanese term meaning \"pervert.\" This refers to pornographic manga or anime; Ecchi: This Japanese term means perverted and is a milder term than hentai. Ecchi applies to works that are erotic in nature, but not pornography.)"}, "madsrdf:citationSource": "Fletcher-Spear, K. Library collections for teens : manga and graphic novels, c2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n08d38713be8848eca15fea4d95f08cd9b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n08d38713be8848eca15fea4d95f08cd9b12"}]}, 