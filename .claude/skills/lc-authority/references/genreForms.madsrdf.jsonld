: {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drama"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed plays"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed plays"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised plays"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised plays"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(drama: In its broadest sense, any work in which actors assume roles before an audience, either in a theater or on radio or television. Drama is a major literary genre, frequently subdivided into the categories of tragedy, comedy, and tragicomedy; play: A composition written to be performed)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Chayefsky, P. The stage plays, 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Vickers, S. Drama scripts for people with special needs, 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(theatrical, noun 1. Stage performances or a stage performance, especially by amateurs. Often used in the plural.)"}, "madsrdf:citationSource": "The American heritage dictionary of the English language, \u00a92000, updated 2009, via WWW, Mar. 11, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Drama. The form of composition designed for performance in the theater, in which actors take the roles of the characters, perform the indicated action, and utter the written dialogue. (The common alternative name for a dramatic composition is a play.))"}, "madsrdf:citationSource": "Abrams, M. A glossary of literary terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(play, noun 3. A dramatic work for the stage or to be broadcast. Synonyms: drama, theatrical work; screenplay, comedy, tragedy; production, performance, show, sketch)"}, "madsrdf:citationSource": "Oxford dictionaries website, July 11, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(play noun 2. a written work in which the story is told through speech and action that is intended to be acted out on stage. Synonyms: drama, dramatization. Related Words: interlude, playlet; comedy, comedy drama, docudrama, dramedy, melodrama, monodrama, musical, musical comedy, psychodrama, tragedy, tragicomedy; magnum opus, opus, work; adaptation)"}, "madsrdf:citationSource": "Merriam-Webster online, July 11, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b18", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wynston, G.P. Adapting stage drama for radio : techniques of preparing stage scripts for Canadian Broadcasting Corporation radio production, 1976.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b19", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hirsch, M.E. Chinese shadow theater playscripts, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Drama. UF Plays. BT Literature)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plays"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plays"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Playscripts"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Playscripts"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramas"}}, {"@id": "_:nd8f158b5565c4462a87dd44fac5910a7b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramas"}}, {"