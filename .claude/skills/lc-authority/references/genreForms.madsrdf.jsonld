5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n491bcbb366b24d2cb9e2519df37bd422b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Frat songs"}}, {"@id": "_:n491bcbb366b24d2cb9e2519df37bd422b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Frat songs"}}, {"@id": "_:n491bcbb366b24d2cb9e2519df37bd422b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n491bcbb366b24d2cb9e2519df37bd422b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Greek letter society songs"}}, {"@id": "_:n491bcbb366b24d2cb9e2519df37bd422b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Greek letter society songs"}}, {"@id": "_:n491bcbb366b24d2cb9e2519df37bd422b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n491bcbb366b24d2cb9e2519df37bd422b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sorority and fraternity songs"}}, {"@id": "_:n491bcbb366b24d2cb9e2519df37bd422b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sorority and fraternity songs"}}], "@id": "/authorities/genreForms/gf2014026815"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026816", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFree jazz", "identifiers:lccn": "gf2014026816", "madsrdf:adminMetadata": [{"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b1"}, {"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Free jazz"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026879"}, "madsrdf:hasSource": [{"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b5"}, {"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b6"}, {"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Free jazz"}}, {"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Free jazz: a term applied to the avant-garde jazz of the 1960s, particularly the work of Ornette Coleman, Cecil Taylor and Albert Ayler, and the late work of John Coltrane)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Mar. 18, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Free jazz was a radical departure from past styles, for typically after playing a quick theme, the soloist does not have to follow any progression or structure and can go in any unpredictable direction)"}, "madsrdf:citationSource": "All-Music Guide WWW site, Mar. 18, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2e4ed72cbef4806ad93b29a5c89ca78b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Coleman, O. Free jazz, p1999.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026816"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026817", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFrevos", "identifiers:lccn": "gf2014026817", "madsrdf:adminMetadata": [{"@id": "_:nbe63faae5c8b4cf497af52db48d9914eb1"}, {"@id": "_:nbe63faae5c8b4cf497af52db48d9914eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Frevos"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbe63faae5c8b4cf497af52db48d9914eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026694"}, "madsrdf:hasSource": {"@id": "_:nbe63faae5c8b4cf497af52db48d9914eb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbe63faae5c8b4cf497af52db48d9914eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbe63faae5c8b4cf497af52db48d9914eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbe63faae5c8b4cf497af52db48d9914eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Frevos"}}, {"@id": "_:nbe63faae5c8b4cf497af52db48d9914eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 982 (frevo: brass-band carnival march and dance music from Recife, Pernambuco, and electrified version of same in Salvador, Bahia)"}, "madsrdf:citationSource": "Garland encyc. world mus.:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026817"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026818", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFugues", "identifiers:lccn": "gf2014026818", "madsrdf:adminMetadata": [{"@id": "_:ne8e28f7fa8a649f2a7fd51192e0dc67ab1"}, {"@id": "_:ne8e28f7fa8a649f2a7fd51192e0dc67ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fugues"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne8e28f7fa8a649f2a7fd51192e0dc67ab3"}]}, "madsrdf:exampleNote": "Note under [Canons (Music)]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:ne8e28f7fa8a649f2a7fd51192e0dc67ab5"}, {"@id": "_:ne8e28f7fa8a649f2a7fd51192e0dc67ab6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical works based on canonic imitation that generally begin with a subject that recurs frequently throughout. For works with a melody that is imitated at a particular interval of time, generally note-for-note see [Canons (Music).]"}, {"@id": "_:ne8e28f7fa8a649f2a7fd51192e0dc67ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne8e28f7fa8a649f2a7fd51192e0dc67ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:43:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne8e28f7fa8a649f2a7fd51192e0dc67ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fugues"}}, {"@id": "_:ne8e28f7fa8a649f2a7fd51192e0dc67ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fugue; type of contrapuntal comp. for particular no. of parts or 'voices'; the vv. enter successively in imitation of each other, the 1st v. entering with a short melody or phrase known as the subject; when all the vv. have entered, the exposition is over; then (normally) there comes an episode or passage of connective leading to another entry or series of entries of the subject, and so on until the end of the piece, entries and episodes alternating; contrasts of key constitute an important element in fugal construction)"}, "madsrdf:citationSource": "Oxford dictionary of music online, viewed July 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne8e28f7fa8a649f2a7fd51192e0dc67ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fugue; a piece of music based on canonic imitation; it is generally distinguished on the one hand from canon, which involves the strictest sort of imitative counterpoint, and on the other from mere imitation, which involves the least strict; there exists no widespread agreement among present-day scholars on what its defining characteristics should be)"}, "madsrdf:citationSource": "Grove music online, viewed July 8, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026818"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026819", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFuji (Music)", "identifiers:lccn": "gf2014026819", "madsrdf:adminMetadata": [{"@id": "_:n888377fb3b934f69a58c1148b46f5a89b1"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fuji (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n888377fb3b934f69a58c1148b46f5a89b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n888377fb3b934f69a58c1148b46f5a89b5"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b6"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b7"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b8"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b9"}], "madsrdf:hasVariant": {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fuji (Music)"}}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fuji music, Fuji)"}, "madsrdf:citationSource": "Work cat.: 2001427832: Odeyemi, D. Sikiru Ayinde Barrister, c2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. 484-485 (under Yoruba popular music: f\u00faj\u00ec: This genre, the most popular one in the early 1990s, grew out of aj\u00eds\u00e1\u00e0r\u00ec, music customarily performed before dawn during Ramadan by young men associated with neighborhood mosques. F\u00faj\u00ec emerged as a genre and marketing label in the late 1960s, when former aj\u00eds\u00e1\u00e0r\u00ec singers Sikiru Ayinde Barrister and Ayinla Kollington were discharged from the Nigerian Army, made their first recordings, and began a periodically bitter rivalry. In the early 1970s, f\u00faj\u00ec succeeded \u00e0p\u00e0l\u00e0 as the most popular genre among Yoruba Muslims, and has since gained a substantial Christian audience. Though f\u00faj\u00ec has to a large degree been secularized, it is still associated with Muslims, and record companies time the release of certain f\u00faj\u00ec recordings to coincide with holy days. F\u00faj\u00ec music is an intensively syncretic style, incorporating aspects of Muslim recitations, Christian hymns, highlife classics, j\u00f9j\u00fa songs, Indian film-music themes, and American pop, within a rhythmic framework based on Yoruba social-dance drumming. To demonstrate knowledge of Yoruba tradition, f\u00faj\u00ec musicians also make use of folkloric idioms, like proverbs and praise names)"}, "madsrdf:citationSource": "Garland encyc. world mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grovemusic.com WWW site, Feb. 13, 2003", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Nigeria: fuji: major style of Nigerian music, rooted in Islam, with strong Arab influence and associated with Ramadan; were: Islamic music in Nigeria influential in \"fuji\" music)"}, "madsrdf:citationSource": "White, D. Dict. pop. mus. styles world", "madsrdf:citationStatus": "found"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fuji encompasses post-World War II western Nigerian percussion and vocal music; under Dr. Sikiru Ayinde Barrister: fuji, an exciting, amplified dance music combining juju, apala, and traditional Yoruban blues that Barrister introduced in the late-'70s; named after Mt. Fuji, the Japanese mountain of love; style has been described as \"juju without the guitars\" and a \"percussion conversation\"; a \"high speed assault by 12 wild percussionists\"; Barrister renamed the musical style \"Fuji garbage\" in 2000)"}, "madsrdf:citationSource": "All music guide WWW site, Feb. 13, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n888377fb3b934f69a58c1148b46f5a89b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fuji garbage (Music)"}}, {"@id": "_:n888377fb3b934f69a58c1148b46f5a89b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fuji garbage (Music)"}}], "@id": "/authorities/genreForms/gf2014026819"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026820", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFunana (Music)", "identifiers:lccn": "gf2014026820", "madsrdf:adminMetadata": [{"@id": "_:n0a2fea3d0e5a4dd2a3d54cde8f947488b1"}, {"@id": "_:n0a2fea3d0e5a4dd2a3d54cde8f947488b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Funana (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0a2fea3d0e5a4dd2a3d54cde8f947488b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n0a2fea3d0e5a4dd2a3d54cde8f947488b5"}, {"@id": "_:n0a2fea3d0e5a4dd2a3d54cde8f947488b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0a2fea3d0e5a4dd2a3d54cde8f947488b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0a2fea3d0e5a4dd2a3d54cde8f947488b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0a2fea3d0e5a4dd2a3d54cde8f947488b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Funana (Music)"}}, {"@id": "_:n0a2fea3d0e5a4dd2a3d54cde8f947488b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Cape Verde (African-influenced genres: Funana is an accordion-based dance music from the island of Santiago that exists in both folk and popular electronic versions. Traditional funana is characterized by the use of the diatonic two-row button accordion and a home-made iron scraper. Two people, usually men, play the instruments, one doubling as a singer. The dance resembles the folk merengue in the Dominican Republic. Funana has become a national rather than an island-specific genre.) under Guinea-Bissau (a type of Crioulo music culture, funana is a fast quadruple-metre dance music originally performed on accordion and scraper, but adapted by commercial bands after 1980)"}, "madsrdf:citationSource": "New Grove dict., 2nd ed.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a2fea3d0e5a4dd2a3d54cde8f947488b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2002401619: Rei di funana, 2001.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026820"}
