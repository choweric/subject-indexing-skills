us": "revised"}, {"@id": "_:n296974d88084437788c4e0838818b400b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fight songs"}}, {"@id": "_:n296974d88084437788c4e0838818b400b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1 (college songs: they include \"fight\" songs)"}, "madsrdf:citationSource": "New Grove dict. of American music, c1986:", "madsrdf:citationStatus": "found"}, {"@id": "_:n296974d88084437788c4e0838818b400b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (College fight songs)"}, "madsrdf:citationSource": "Touchdown! [SR] c1990:", "madsrdf:citationStatus": "found"}, {"@id": "_:n296974d88084437788c4e0838818b400b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fight song. In American and Canadian sports, a fight song is a song associated with a team in both professional and amateur sports. Fight songs are a popular way for fans to cheer for their team. Although the term \"fight song\" is primarily used in America, the use of fight songs is commonplace around the world, but they may be referred to as team anthems or team songs in other countries...)"}, "madsrdf:citationSource": "Wikipedia, viewed June 4, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n296974d88084437788c4e0838818b400b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n296974d88084437788c4e0838818b400b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n296974d88084437788c4e0838818b400b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Team anthems"}}, {"@id": "_:n296974d88084437788c4e0838818b400b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Team anthems"}}, {"@id": "_:n296974d88084437788c4e0838818b400b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n296974d88084437788c4e0838818b400b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Team songs"}}, {"@id": "_:n296974d88084437788c4e0838818b400b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Team songs"}}], "@id": "/authorities/genreForms/gf2014026803"}
