ationStatus": "found"}, {"@id": "_:na97f73b26ca74bc5a53b545a8f28e4f9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "What is a prompt? (\"A writing prompt is a topic, idea, or starting point for an essay, report, response to reading, story, or other forms of writing.\""}, "madsrdf:citationSource": [{"@id": "https://intercom.help/writable/en/articles/3996473-what-is-a-prompt"}, "Writable Help Center website, viewed July 10, 2023:"], "madsrdf:citationStatus": "found"}, {"@id": "_:na97f73b26ca74bc5a53b545a8f28e4f9b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subtitle of \"one hundred writing prompts to help you share your life story) (OCoLC)865711374"}, "madsrdf:citationSource": "Sander, Jennifer Basye. Before I go, there's more you should know, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:na97f73b26ca74bc5a53b545a8f28e4f9b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Library of Congress Subject Headings", "madsrdf:citationStatus": "notfound"}, {"@id": "_:na97f73b26ca74bc5a53b545a8f28e4f9b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(book of 115 writing prompts for erotic stories) (OCoLC)1389806556"}, "madsrdf:citationSource": "Work cat: Newman, Rena Yehuda. 69 writing prompts for deviants, February 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:na97f73b26ca74bc5a53b545a8f28e4f9b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Oxford Dictionary of Literary Terms", "madsrdf:citationStatus": "notfound"}, {"@id": "_:na97f73b26ca74bc5a53b545a8f28e4f9b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Writing prompt (composition), glossary of grammatical and rhetorical terms (\"A writing prompt is a brief passage of text (or sometimes an image) that provides a potential topic idea or starting point for an original essay, report, journal entry, story, poem, or other forms of writing. Writing prompts are commonly used in the essay portions of standardized tests, but they may also be devised by the writers themselves.\""}, "madsrdf:citationSource": [{"@id": "https://www.thoughtco.com/writing-prompt-composition-1692451"}, "Thought Co. website, viewed July 10, 2023:"], "madsrdf:citationStatus": "found"}, {"@id": "_:na97f73b26ca74bc5a53b545a8f28e4f9b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subtitle of \"a book of writing prompts\") (OCoLC)1325669095"}, "madsrdf:citationSource": "Writing dialogue, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:na97f73b26ca74bc5a53b545a8f28e4f9b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(book of 501 sample writing prompts that simulate actual essay test questions) (OCoLC)50809177"}, "madsrdf:citationSource": "501 writing prompts, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:na97f73b26ca74bc5a53b545a8f28e4f9b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na97f73b26ca74bc5a53b545a8f28e4f9b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prompts, Writing"}}, {"@id": "_:na97f73b26ca74bc5a53b545a8f28e4f9b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prompts, Writing"}}], "@id": "/authorities/genreForms/gf2023026072"}
