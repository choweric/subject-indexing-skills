cabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-08T13:53:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0975e6dd7f95461cb3b97df23867ac03b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Public affairs television programs"}}, {"@id": "_:n0975e6dd7f95461cb3b97df23867ac03b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Public affairs: television nonfiction work which include discussions, debates, speeches, and editorials on politics, government, and public policy. The participants may range from a college debate team to journalists, and politicians are frequent guests)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 5, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n0975e6dd7f95461cb3b97df23867ac03b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 80 (Public affairs: use for nonfiction films or video used to record \"talks, commentaries, discussions, speeches, editorials, political programs, documentaries, forums, panels, roundtables and similar programs concerning local, national and international public affairs\" -- FCC regulations)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026476"}
