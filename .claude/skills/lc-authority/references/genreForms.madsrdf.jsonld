Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfebadb7c99114705a880fb97c0c5e3a3b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Private Snafu films"}}, {"@id": "_:nfebadb7c99114705a880fb97c0c5e3a3b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Private Snafu films"}}, {"@id": "_:nfebadb7c99114705a880fb97c0c5e3a3b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(animated film(s); animated cartoon film; animated movies; movie cartoon; animated cartoons)"}, "madsrdf:citationSource": "LC database, Sept. 24, 1987", "madsrdf:citationStatus": "found"}, {"@id": "_:nfebadb7c99114705a880fb97c0c5e3a3b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 12 (animated film (animation): An animated film is one which, by the use of some animation technique, creates the illusion of movement in inanimated objects, drawings, photographs, paper or cardboard cut-outs, puppets, plasticien, and the like)"}, "madsrdf:citationSource": "Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfebadb7c99114705a880fb97c0c5e3a3b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Moving image genre-form guide online, June 18, 2007.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nfebadb7c99114705a880fb97c0c5e3a3b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfebadb7c99114705a880fb97c0c5e3a3b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Private Snafu films"}}, {"@id": "_:nfebadb7c99114705a880fb97c0c5e3a3b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Private Snafu films"}}, {"@id": "_:nfebadb7c99114705a880fb97c0c5e3a3b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfebadb7c99114705a880fb97c0c5e3a3b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@val