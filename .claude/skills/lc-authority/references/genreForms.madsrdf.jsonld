i, \u00a91994-\u00a91996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3457a1807dea4ce888e74a99c9a77344b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3457a1807dea4ce888e74a99c9a77344b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Libretti"}}, {"@id": "_:n3457a1807dea4ce888e74a99c9a77344b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Libretti"}}], "@id": "/authorities/genreForms/gf2014026909"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026910", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLitanies (Music)", "identifiers:lccn": "gf2014026910", "madsrdf:adminMetadata": [{"@id": "_:n1717333b0d5a4fe6bd5246ea1141ec41b1"}, {"@id": "_:n1717333b0d5a4fe6bd5246ea1141ec41b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Litanies (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1717333b0d5a4fe6bd5246ea1141ec41b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}, "madsrdf:hasSource": {"@id": "_:n1717333b0d5a4fe6bd5246ea1141ec41b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1717333b0d5a4fe6bd5246ea1141ec41b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1717333b0d5a4fe6bd5246ea1141ec41b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n1717333b0d5a4fe6bd5246ea1141ec41b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Litanies (Music)"}}, {"@id": "_:n1717333b0d5a4fe6bd5246ea1141ec41b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A prayer form, usually characterized by the announcement of varying invocations (e.g. names of deities or saints) or supplications (Lat. deprecationes, preces etc.) by a leader, each of which is followed by a fixed congregational response. This genre may be distinguished from other responsorial forms by the relative brevity, sometimes parity, of the call and response elements, giving it something of an insistent quality. Often quite rhythmic, litanies frequently accompany processions)"}, "madsrdf:citationSource": "Grove music online, viewed August 10, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026910"}
