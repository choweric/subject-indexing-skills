71"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027172", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aYodels", "identifiers:lccn": "gf2014027172", "madsrdf:adminMetadata": [{"@id": "_:ne21ef2c49416437eae8c220fc3db3906b1"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Yodels"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne21ef2c49416437eae8c220fc3db3906b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026739"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:ne21ef2c49416437eae8c220fc3db3906b5"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b6"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b7"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b8"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b9"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b10"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b11"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b12"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b13"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b14"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b15"}], "madsrdf:hasVariant": [{"@id": "_:ne21ef2c49416437eae8c220fc3db3906b16"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b19"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b22"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:21:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yodels"}}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Traditional Swiss yodels and alphorn music)"}, "madsrdf:citationSource": "Work cat.: 83751103: J\u00fc\u00fczli : jodel du Muotatal, Suisse, \u00a91979", "madsrdf:citationStatus": "found"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Yodeling in American music (Yodeling is a vocalization that uses the larynx muscles and glottal stops to accentuate the abrupt change of vocal register between the chest register and the falsetto or head register; yodel songs; the popular stage adopted the yodel as a vocal burlesque in portrayals of racialized and ethnic others; African American vaudevillians Monroe Tabor, Beulah Henderson, and Charles Anderson placed the comedic burlesques of 19th-century yodel songs in close proximity to the performance traditions of ragtime and the blues in the 1910s and 20s; connection between the yodel and the blues extended to songs of the late 1920s, most notably in the various recordings of \"Yodeling Blues\" and Lottie Kimbrough and Winston Holmes's \"Lost Lover Blues\"; Riley Puckett in 1924 and Jimmie Rodgers in 1927 introduced the yodel to country music by drawing upon the repertory and the diverse yodeling practices established in vaudeville; In his blues songs, Rodgers placed his vocal leaps of an octave to his higher register, a vocalization often heard in the blues, in tandem with his distinct yodels. Gene Autry merged Rodgers's yodels with the image of the cowboy in Hollywood films beginning in the 1930s. Influenced by Rodgers, country artists such as Elton Britt, Patsy Montana, Rosalie Allen, and Wilf Carter continued the practice of rapidly alternating between registers that gestured to the virtuosity of the Alpine tradition)"}, "madsrdf:citationSource": "Grove music online, Dec. 9, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "90741287: Yodel songs, \u21171956.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Country subgenres and styles > Traditional country > Yodeling (Yodeling is a means of vocal performance whereby the singer suddenly changes from a natural voice to a falsetto and back again, constantly alternating between chest and head voices. Originally developed centuries ago by mountain dwellers in the Swiss Alps as a means of communication, yodeling found perhaps its greatest proponent in country music legend Jimmie Rodgers, whose \"Blue Yodel\" records established him as one of the biggest stars of the 1920s and '30s)"}, "madsrdf:citationSource": "AllMusic website, Dec. 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(country music yodel songs)"}, "madsrdf:citationSource": "95760740: Britt, Elton. Elton Britt yodel songs, 1956?", "madsrdf:citationStatus": "found"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yodeling songs of the Alps, between 1982 and 1989?", "madsrdf:citationStatus": "found"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Yodel music (Yodeling (or yodelling, jodeling) is a form of singing that involves singing an extended note which rapidly and repeatedly changes in pitch from the vocal or chest register (or \"chest voice\") to the falsetto/head register; making a high-low-high-low sound. This vocal technique is used in many cultures throughout the world. In Alpine folk music, it was probably developed in the Swiss Alps and Austrian Alps as a method of communication between mountain peaks, later becoming part of the region's traditional music. In Persian classical music, singers frequently use tahrir, a yodeling technique that oscillates on neighbor tones. In Georgian traditional music, yodelling takes the form of krimanchuli technique, and is used as a top part in three/four part polyphony. In Central Africa, Pygmy singers use yodels within their elaborate polyphonic singing, and the Shona people of Zimbabwe sometimes yodel while playing the mbira. Yodeling is often used in American bluegrass and country music.) Yodeling music (see Yodel music)"}, "madsrdf:citationSource": "last.fm website, Dec. 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A style of folk singing, to a succession of vowels, characterized by rapid shifts between full voice and falsetto combine with rapid alternation between two pitches or the arpeggiation of several)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Yodel, type of singing in which high falsetto and low chest notes are rapidly alternated; its production is helped by the enunciation of open and closed vowels on the low and high notes of wide intervals. Yodeling is also used as a means of communicating over moderate distances by the inhabitants of mountainous regions. It is associated with the Alpine peoples of Switzerland and the Austrian Tirol. But it is found also in other mountain regions (e.g., in China and the Americas) and among the Pygmies of Africa and the Aboriginal peoples of Australia. In Alpine folk singing, yodeling--frequently mixed with nonsense syllables--occurs in passages called Jodlers, which occur at the beginning, middle, or end of a song. The origin of yodeling is buried in antiquity. It has been suggested that it originated as an imitation of the music of the alpenhorn (alphorn), but this point is uncertain)"}, "madsrdf:citationSource": "Britannica online, Dec. 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Country songs with yodeling)"}, "madsrdf:citationSource": "Clark, Slim. Yodeling Slim Clark singin' yodelin' guitar pickin' cowboy songs, \u21172012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yodellin' Kenny Roberts sings country songs, 1963?", "madsrdf:citationStatus": "found"}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne21ef2c49416437eae8c220fc3db3906b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yodeling"}}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yodeling"}}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne21ef2c49416437eae8c220fc3db3906b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jodeling"}}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jodeling"}}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne21ef2c49416437eae8c220fc3db3906b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yodelling"}}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yodelling"}}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne21ef2c49416437eae8c220fc3db3906b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yodles"}}, {"@id": "_:ne21ef2c49416437eae8c220fc3db3906b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yodles"}}], "@id": "/authorities/genreForms/gf2014027172"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027173", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aYom Kippur music", "identifiers:lccn": "gf2014027173", "madsrdf:adminMetadata": [{"@id": "_:n258bb432c7af4bdbb9c6a7f59b7fdfc5b1"}, {"@id": "_:n258bb432c7af4bdbb9c6a7f59b7fdfc5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Yom Kippur music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n258bb432c7af4bdbb9c6a7f59b7fdfc5b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026857"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasVariant": {"@id": "_:n258bb432c7af4bdbb9c6a7f59b7fdfc5b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music that is traditionally associated with Yom Kippur."}, {"@id": "_:n258bb432c7af4bdbb9c6a7f59b7fdfc5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:05:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n258bb432c7af4bdbb9c6a7f59b7fdfc5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n258bb432c7af4bdbb9c6a7f59b7fdfc5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yom Kippur music"}}, {"@id": "_:n258bb432c7af4bdbb9c6a7f59b7fdfc5