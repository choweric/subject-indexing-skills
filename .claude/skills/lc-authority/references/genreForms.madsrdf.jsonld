recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n3eaab679a95240a096df5d125509c128b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quodlibets (Music)"}}, {"@id": "_:n3eaab679a95240a096df5d125509c128b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(quotlibet)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n3eaab679a95240a096df5d125509c128b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Quodlibet; a composition in which well-known melodies and texts appear in successive or simultaneous combinations; generally serves no higher purpose than that of humor or technical virtuosity)"}, "madsrdf:citationSource": "New Grove dict. of mus. online, Mar. 21, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n3eaab679a95240a096df5d125509c128b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3eaab679a95240a096df5d125509c128b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quotlibets (Music)"}}, {"@id": "_:n3eaab679a95240a096df5d125509c128b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quotlibets (Music)"}}], "@id": "/authorities/genreForms/gf2014027028"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027029", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aQur\u02bcanic recitations", "identifiers:lccn": "gf2014027029", "madsrdf:adminMetadata": [{"@id": "_:n72212e840ec34a2591461d9a29fcfb82b1"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Qur\u02bcanic recitations"}, "madsrdf:elementList": {"@list": [{"@id": "_:n72212e840ec34a2591461d9a29fcfb82b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026707"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasSource": [{"@id": "_:n72212e840ec34a2591461d9a29fcfb82b5"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b6"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b7"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b8"}], "madsrdf:hasVariant": [{"@id": "_:n72212e840ec34a2591461d9a29fcfb82b9"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b12"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b15"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b18"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Qur\u02bcanic recitations"}}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Qur\u02bcan reading (A recitation (qir\u0101'a) or chanting (tit\u0101wa) of the Qu'ran in Arabic, moving between a kind of stylized speech and singing. It is read by the clergy or Qu'ran readers as part of the liturgy and on other occasions, in all Islamic countries)"}, "madsrdf:citationSource": "Grove music online, viewed May 28, 2014 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Koran. Arabic. Qur\u02bc\u0101n al-\u1e25ak\u012bm [SR], 1976.", "madsrdf:citationStatus": "found"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Quran reading (Qur'an reading is the reading (tarteel, tajwid, or taghbir) aloud, reciting, or chanting of portions of the Qur'an. The reciter is called a t\u0101l\u012b, murattil, mujawwid, or most commonly a qari. (Touma 1996, p. 153-154) Recitation should be done according to rules of pronunciation, intonation, and caesuras established by the Islamic prophet Muhammad, though first recorded in the eighth century CE. The most popular reading is that of Hafs on the authority of `asim. Similarly, each melodic passage centers on a single tone level, but the melodic contour and melodic passages are largely shaped by the reading rules, creating passages of different lengths whose temporal expansion is defined through caesuras. Skilled readers may read professionally for mosques in cities)"}, "madsrdf:citationSource": "Wikipedia, viewed May 28, 2014 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "WWW Google search, May 27, 2003 (Koranic recitation 164 hits; Koranic recitations 114 hits)", "madsrdf:citationStatus": "found"}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72212e840ec34a2591461d9a29fcfb82b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Koranic recitations"}}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Koranic recitations"}}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72212e840ec34a2591461d9a29fcfb82b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Koranic chants"}}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Koranic chants"}}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72212e840ec34a2591461d9a29fcfb82b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Recitations, Koranic"}}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Recitations, Koranic"}}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72212e840ec34a2591461d9a29fcfb82b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Recitations, Qur\u02bcanic"}}, {"@id": "_:n72212e840ec34a2591461d9a29fcfb82b19", "@type": "madsrdf:GenreFormElement", "madsrdf:eleme