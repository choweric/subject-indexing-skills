{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026136", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOutlines and syllabi", "identifiers:lccn": "gf2014026136", "madsrdf:adminMetadata": [{"@id": "_:n88c2409b2dd445618478c170ce9e8f01b1"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Outlines and syllabi"}, "madsrdf:elementList": {"@list": [{"@id": "_:n88c2409b2dd445618478c170ce9e8f01b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026084"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}], "madsrdf:hasSource": [{"@id": "_:n88c2409b2dd445618478c170ce9e8f01b5"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b6"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b7"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b8"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b9"}], "madsrdf:hasVariant": [{"@id": "_:n88c2409b2dd445618478c170ce9e8f01b10"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b13"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b16"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b19"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b22"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Outlines and syllabi"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(compendium, plural compendiums, compendia. 1.a brief treatment or account of a subject, especially an extensive subject; concise treatise: a compendium of medicine. 2. a summary, epitome, or abridgment. 3. a full list or inventory: a compendium of their complaints. Also, compend)"}, "madsrdf:citationSource": "Dictionary.com, July 31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(outlines (documents). General descriptions covering the main points of a subject, such as summaries of written works or speeches expressed as headings and subheadings; syllabi. UF syllabuses. Outlines or brief statements of the main points of a lecture or course of study.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 60 (outline: brief verbal description, summary, rough draft, pr\u00e9cis)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Course Descriptions. UF Course Outlines; Syllabi)"}, "madsrdf:citationSource": "ERIC thesaurus, via WWW, Aug. 7, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(outline: A popular treatment of an extensive subject (example: The Outline of History by H.G. Wells). Also refers to a summary of the main aspects of a topic or a systematic list of the most important points of a speech or written work, often with indention used to indicate logical subordination. Also refers to a line or thin edge drawn around a picture or image, as a form of decoration or to establish its visual limits; syllabus: An outline of the topics to be covered in a formal course of study, given in the order in which they are to be discussed in class, with any assignments and related readings also indicated. Some college and university faculty make their syllabi available online, usually on the World Wide Web, or place printed copies on reserve at the library. In a more general sense, a concise statement of the main points of a subject or argument, or a summary or schedule of contents, as at the beginning of a legal brief or court opinion, stating the points of law involved in the case; compendium: A work that presents in condensed form the main points of a longer work, prepared by a person other than the original author. Also, a work that treats a broad subject or entire field of knowledge briefly and concisely, sometimes in the form of an outline. Used synonymously with digest and epitome.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n88c2409b2dd445618478c170ce9e8f01b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Compendiums"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Compendiums"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n88c2409b2dd445618478c170ce9e8f01b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Syllabuses"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Syllabuses"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n88c2409b2dd445618478c170ce9e8f01b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Compendia"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Compendia"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n88c2409b2dd445618478c170ce9e8f01b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Course outlines"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Course outlines"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n88c2409b2dd445618478c170ce9e8f01b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Syllabi"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Syllabi"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n88c2409b2dd445618478c170ce9e8f01b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Compends"}}, {"@id": "_:n88c2409b2dd445618478c170ce9e8f01b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Compends"}}], "@id": "/authorities/genreForms/gf2014026136"}
