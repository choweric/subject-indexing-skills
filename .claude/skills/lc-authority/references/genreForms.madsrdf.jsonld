ncements"}}, {"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio special announcements"}}, {"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio spots (Announcements)"}}, {"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio spots (Announcements)"}}, {"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Special announcements, Radio"}}, {"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Special announcements, Radio"}}, {"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spots, Radio (Announcements)"}}, {"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spots, Radio (Announcements)"}}, {"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Announcements, Radio"}}, {"@id": "_:n1c4268a2298a47d7b1eeea59024da9d8b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Announcements, Radio"}}], "@id": "/authorities/genreF