ecordStatus": "revised"}, {"@id": "_:n4d5e5761688d491e8732a33a978971cfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puppet television programs"}}, {"@id": "_:n4d5e5761688d491e8732a33a978971cfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Puppet: Work that photographs puppets in a manner sometimes related to, but distinct from, animation, since it uses a three-dimensional rather than two-dimensional perspective. Puppet work may be presented in an abstract or realistic manner, with the puppets controlled by hand and photographed through stop-motion, or photographed in live-action, with strings or electronic mechanisms to operate their limbs and expressions. Used for Marionette)"}, "madsrdf:citationSource": "Moving image genre-form guide online, July 30, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d5e5761688d491e8732a33a978971cfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Puppet works: use for films or video used to record a live action puppet performance; UF Marionette works; Puppet films)"}, "madsrdf:citationSource": "Yee, M. M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d5e5761688d491e8732a33a978971cfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Puppet television programs)"}, "madsrdf:citationSource": "LCSH, July 30, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d5e5761688d491e8732a33a978971cfb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d5e5761688d491e8732a33a978971cfb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television puppet shows"}}, {"@id": "_:n4d5e5761688d491e8732a33a978971cfb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television puppet shows"}}, {"@id": "_:n4d5e5761688d491e8732a33a978971cfb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d5e5761688d491e8732a33a978971cfb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Puppet shows (Television programs)"}}, {"@id": "_:n4d5e5761688d491e8732a33a978971cfb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puppet shows (Television programs)"}}, {"@id": "_:n4d5e5761688d491e8732a33a978971cfb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d5e5761688d491e8732a33a978971cfb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Marionette television programs"}}, {"@id": "_:n4d5e5761688d491e8732a33a978971cfb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Marionette television programs"}}], "@id": "/authorities/genreForms/gf2011026481"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026482", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aQuadrangle maps", "identifiers:lccn": "gf2011026482", "madsrdf:adminMetadata": [{"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b1"}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Quadrangle maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b5"}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b6"}], "madsrdf:hasVariant": [{"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b7"}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Maps that cover a rectangular or nearly rectangular region defined by four specified points.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025018"}}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T10:53:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quadrangle maps"}}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cartographic materials, 2002, 2005 update;Form/genre for cartographic materials [draft of LC working group], 1996.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "quadrangle (1. a figure, in the plane, consisting of four specified points and the lines or line segments on which they lie. The quadrangle and the quadrilateral map define the same shape. They differ in that the quadrangle is defined by four specified points, the quadrilateral by four specified lines or line-segments. 3. a map or plot of a rectangular or nearly rectangular region, usually bounded by given meridians of longitude and parallels of latitude. Sometimes called a quad (jargon) or quadrangular map. In the USA, the standard map is the quadrangle of 7.5' of longitude and latitude. Other sizes are integral multiples of the standard; see from: quadrangle map)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quadrangular maps"}}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quadrangular maps"}}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quad maps"}}, {"@id": "_:nd15c8005086c490d9f13d4bef49d8db6b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quad maps"}}], "@id": "/authorities/genreForms/gf2011026482"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026483", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRace films", "identifiers:lccn": "gf2011026483", "madsrdf:adminMetadata": [{"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb1"}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Race films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026229"}, "madsrdf:hasSource": [{"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb5"}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb6"}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb7"}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb8"}], "madsrdf:hasVariant": {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films produced with African American casts specifically for African American audiences beginning in the late silent-film days and continuing until the end of the 1940s.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025511"}}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T10:57:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Race films"}}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 5 (In response to Birth of a nation, efforts began in the African-American community to show a more honest depiction of Black people by producing the first \"all-colored cast\" feature movies, or \"race films.\")"}, "madsrdf:citationSource": "Richards, Larry. African American films through 1959:", "madsrdf:citationStatus": "found"}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Race films. A term used to designate films with African American casts made specifically for African American audiences begun in the late silent-film days and continuing until the end of the 1940s.)"}, "madsrdf:citationSource": "Konigsberg, Ira. Complete film dict., 2nd ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Race film. Term used in the American film industry from the silent cinema through the 1940s to refer to movies made by African-American film-makers specifically for African-American audiences.)"}, "madsrdf:citationSource": "Blandford, Steven. Film studies dict., 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Race movies. Features with all-black casts made specifically for African-American audiences)"}, "madsrdf:citationSource": "Katz, Ephraim. Film enc., 4th ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Race movies"}}, {"@id": "_:n02c341d1ecd44ffe88bbc2a2618e1d9cb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Race movies"}}], "@id": "/authorities/genreForms/gf2011026483"}
