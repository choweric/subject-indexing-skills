10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc41b58c0cba44e889c23da22dc154f7fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Low budget films"}}, {"@id": "_:nc41b58c0cba44e889c23da22dc154f7fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 173 (low-budget film (cheap film): A term used very often to indicate a film made cheaply with a modicum of investment)"}, "madsrdf:citationSource": "Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc41b58c0cba44e889c23da22dc154f7fb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Moving image genre form guide via WWW, July 18, 2007", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nc41b58c0cba44e889c23da22dc154f7fb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc41b58c0cba44e889c23da22dc154f7fb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Low budget movies"}}, {"@id": "_:nc41b58c0cba44e889c23da22dc154f7fb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Low budget movies"}}, {"@id": "_:nc41b58c0cba44e889c23da22dc154f7fb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc41b58c0cba44e889c23da22dc154f7fb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Low budget motion pictures"}}, {"@id": "_:nc41b58c0cba44e889c23da22dc154f7fb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Low budget motion pictures"}}, {"@id": "_:nc41b58c0cba44e889c23da22dc154f7fb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc41b58c0cba44e889c23da22dc154f7fb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Low budget pictures"}}, {"@id": "_:nc41b58c0cba44e889c23da2