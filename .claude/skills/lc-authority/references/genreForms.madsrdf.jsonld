cordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n400c1ed0396c4601a3d1731960e02d4fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bible plays"}}, {"@id": "_:n400c1ed0396c4601a3d1731960e02d4fb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Manley, W.F. Bible dramas for church and home, 1928.", "madsrdf:citationStatus": "found"}, {"@id": "_:n400c1ed0396c4601a3d1731960e02d4fb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Blackburn, R.H. Tudor Biblical drama, c1957.", "madsrdf:citationStatus": "found"}, {"@id": "_:n400c1ed0396c4601a3d1731960e02d4fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bible plays. Here are entered works on the dramatization of Biblical events, collections of such dramatizations, and such individual plays as are not entered under the name of a principal character or other specific heading.)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n400c1ed0396c4601a3d1731960e02d4fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n400c1ed0396c4601a3d1731960e02d4fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biblical drama"}}, {"@id": "_:n400c1ed0396c4601a3d1731960e02d4fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biblical drama"}}, {"@id": "_:n400c1ed0396c4601a3d1731960e02d4fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n400c1ed0396c4601a3d1731960e02d4fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bible drama"}}, {"@id": "_:n400c1ed0396c4601a3d1731960e02d4fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bible drama"}}], "@id": "/authorities/genreForms/gf2014026241"}
