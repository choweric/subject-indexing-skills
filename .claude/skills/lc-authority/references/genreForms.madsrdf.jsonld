{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027182", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHuman sounds", "identifiers:lccn": "gf2014027182", "madsrdf:adminMetadata": [{"@id": "_:n42b49a64c4f640dab220c3142bbd4182b1"}, {"@id": "_:n42b49a64c4f640dab220c3142bbd4182b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Human sounds"}, "madsrdf:elementList": {"@list": [{"@id": "_:n42b49a64c4f640dab220c3142bbd4182b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026710"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026070"}], "madsrdf:hasSource": [{"@id": "_:n42b49a64c4f640dab220c3142bbd4182b5"}, {"@id": "_:n42b49a64c4f640dab220c3142bbd4182b6"}, {"@id": "_:n42b49a64c4f640dab220c3142bbd4182b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n42b49a64c4f640dab220c3142bbd4182b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n42b49a64c4f640dab220c3142bbd4182b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n42b49a64c4f640dab220c3142bbd4182b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Human sounds"}}, {"@id": "_:n42b49a64c4f640dab220c3142bbd4182b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Human & Special Track[s] [include] crying, yawning, sighing, sneezing, hiccups, eating and drinking sounds, footsteps, yelling, giggling, screaming, bonebreaking, etc.)"}, "madsrdf:citationSource": "Zomba Production Music Scandinavia website FX Collection 5", "madsrdf:citationStatus": "found"}, {"@id": "_:n42b49a64c4f640dab220c3142bbd4182b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "99 SFX.4, v. 3."}, "madsrdf:citationSource": "Work cat.: The ultimate digital stereo sound effects library. People & sounds [SR]:", "madsrdf:citationStatus": "found"}, {"@id": "_:n42b49a64c4f640dab220c3142bbd4182b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(BBC SFX Library includes \"human sounds from around ... the world\" and THE COLLECTION SFX includes \"human sounds\")"}, "madsrdf:citationSource": "Gefen Systems SFX and Music CD Libraries website", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027182"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027183", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPantomimes (Music)", "identifiers:lccn": "gf2014027183", "madsrdf:adminMetadata": [{"@id": "_:nfddc1ce4947c422c8bbbd4fb7b672368b1"}, {"@id": "_:nfddc1ce4947c422c8bbbd4fb7b672368b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pantomimes (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfddc1ce4947c422c8bbbd4fb7b672368b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026716"}, "madsrdf:hasSource": [{"@id": "_:nfddc1ce4947c422c8bbbd4fb7b672368b5"}, {"@id": "_:nfddc1ce4947c422c8bbbd4fb7b672368b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfddc1ce4947c422c8bbbd4fb7b672368b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nfddc1ce4947c422c8bbbd4fb7b672368b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfddc1ce4947c422c8bbbd4fb7b672368b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pantomimes (Music)"}}, {"@id": "_:nfddc1ce4947c422c8bbbd4fb7b672368b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pantomime. In the 19th century, the term pantomime also referred to a comic entertainment, popular in England, France, and the Hapsburg empire. ... these entertainments might contain songs, dances, instrumental pieces, and spectacular stage effects as well as scends in dumbshow. In present-day England, the pantomime, based on a traditional story or a fairy tale, is a popular form of Christmas entertainment)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfddc1ce4947c422c8bbbd4fb7b672368b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pantomime. A musical-dramatic genre, taking different forms in different periods and places. The Latin pantomimus originally referred to a Roman actor who specialized in dumb show, supported by instrumental music and a chorus; by extension the word denotes a dramatic representation in dumb show. Normal modern English usage is confined to a theatrical entertainment, usually presented in the Christmas season, which, whilst no longer in dumb show, continues to use music and other spectacular elements to support a children's tale that is often no more than a flimsy backcloth for buffoonery, dancing, topical songs and allusions and, until comparatively recent times, a harlequinade.)"}, "madsrdf:citationSource": "Grove music online, viewed August 27, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027183"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027184", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNotated music", "identifiers:lccn": "gf2014027184", "madsrdf:adminMetadata": [{"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb1"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Notated music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026956"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026983"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026986"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027077"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027085"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027102"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027150"}], "madsrdf:hasSource": [{"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb5"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb6"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb7"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb8"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb9"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb10"}], "madsrdf:hasVariant": {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music expressed through musical notation."}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-03T13:41:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Notated music"}}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 29 (Part II. Sheet music)"}, "madsrdf:citationSource": "Drops of brandy : an anthology of M\u00e9tis music, \u00a92002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(microfilm collection of sheet music published in the United States between 1769 and 1830 of instrumental and vocal works; chiefly pieces for solo piano and songs in English with piano accompaniment)"}, "madsrdf:citationSource": "American sheet music to 1830, 197-?", "madsrdf:citationStatus": "found"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Star spangled songbook : a history in sheet music of \"The star-spangled banner\", 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sheet music: music printed on large unbound sheets of paper)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Aug. 15, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (Content expressed through a form of musical notation intended to be perceived visually. Includes all forms of musical notation other than those intended to be perceived through touch.)"}, "madsrdf:citationSource": "RDA Toolkit, viewed December 10, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Graphic, non-realized representations of musical works intended to be perceived visually)"}, "madsrdf:citationSource": "Bibframe.org, viewed December 10, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sheet music"}}, {"@id": "_:n66b43ca2d37c4de3b56e599a7b6b83cbb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sheet music"}}], "@id": "/authorities/genreForms/gf2014027184"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027185", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAmbient music (Electronica)", "identifiers:lccn": "gf2014027185", "madsrdf:adminMetadata": [{"@id": "_:n18077971594c4530838e0216f58a1cdcb1"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ambient music (Electronica)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n18077971594c4530838e0216f58a1cdcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026783"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026020"}, "madsrdf:hasSource": [{"@id": "_:n18077971594c4530838e0216f58a1cdcb5"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb6"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb7"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb8"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb9"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb10"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb11"}], "madsrdf:hasVariant": [{"@id": "_:n18077971594c4530838e0216f58a1cdcb12"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb15"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb18"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb21"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ambient music (Electronica)"}}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Compounds + elements, p2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ambient house (An early categorical marker used to distinguish newer wave ambient artists such as the Orb, the KLF, Irresistible Force, Future Sound of London, and Orbital; often applied indiscriminately to designate dance music not necessarily just for dancing; it's since been replaced by a barrage of more specific terms and is rarely used) Downbeat (generic term sometimes used to replace ambient-house and ambient-techno, considering that the amount and complexity of electronic listening music described under the \"ambient\" umbrella has made the terms practically useless by the mid-'90s; in its widest possible definition, downbeat is any form of electronic music created for the living room instead of the dance floor)"}, "madsrdf:citationSource": "AllMusic, viewed July 14, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ambient house (A form of 20th-century club dance music; music to relax to, away from the more fevered, heavily rhythmic music; much of it is not intended for dancing; many records are arhythmic; often lacks a diatonic center and features perpetual atonality and prolonged washes of chords played on a synthesizer; term 'ambient' was eventually applied, unconvincingly, to many other forms of dance music, such as dub and drum 'n' bass)"}, "madsrdf:citationSource": "Grove music online, viewed July 14, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(evolved from experimental electronic music of the '70s synth-based artists and the trance-like techno dance music of the '80s; became a popular cult music in the early '90s; spacious, electronic music that is concerned with sonic texture, not songwriting or composing; frequently repetitive and it all sounds the same to the casual listener although there are significant differences between the artists)"}, "madsrdf:citationSource": "Allmusic WWW site, Aug. 1, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Such music has many names: ambient, new age, contemporary instrumental, experimental, spacerock, chillout, ambient techno, ambient trance, mood music, world music, new acoustic music; one of the common features of ambient and downtempo recordings: subtle in forms and invites listener attention even if it also works well as background; doesn't fit easily into the mainstream classifications of rock, dance, folk, classical or jazz; often instrumental... By the turn of the millennium the word chillout had come to encompass an extraordinary variety of downtempo music associated with the electronic dance scene, and sometimes even just downtempo vocal pop or rock.)"}, "madsrdf:citationSource": "Ambient music guide website, viewed July 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(developed as a musical genre since the late '70s; associated primarily with the creation of a mood of relaxation or contemplation; the noun \"ambience\" has emerged as an alternative term for \"ambient music\")"}, "madsrdf:citationSource": "The Oxford dictionary of new words, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ambient music; includes forms of music that put an emphasis on tone and atmosphere over traditional musical structure or rhythm; originated in the United Kingdom at a time when new sound-making devices such as the synthesizer were being introduced to a wider market; ambient compositions are often quite lengthy)"}, "madsrdf:citationSource": "Wikipedia, viewed July 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18077971594c4530838e0216f58a1cdcb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ambience (Electronica)"}}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ambience (Electronica)"}}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18077971594c4530838e0216f58a1cdcb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Downbeat (Electronica)"}}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Downbeat (Electronica)"}}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18077971594c4530838e0216f58a1cdcb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chillout music (Electronica)"}}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chillout music (Electronica)"}}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18077971594c4530838e0216f58a1cdcb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ambient house (Electronica)"}}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ambient house (Electronica)"}}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n18077971594c4530838e0216f58a1cdcb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Downtempo (Electronica)"}}, {"@id": "_:n18077971594c4530838e0216f58a1cdcb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Downtempo (Electronica)"}}], "@id": "/authorities/genreForms/gf2014027185"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027186", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBackground music", "identifiers:lccn": "gf2014027186", "madsrdf:adminMetadata": [{"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb1"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Background music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasSource": [{"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb5"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb6"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb7"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb8"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb9"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb10"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb11"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb12"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb13"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb14"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb15"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb16"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb17"}], "madsrdf:hasVariant": [{"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb18"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb21"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb24"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb27"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb30"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb33"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb36"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Background music"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Muzak: live trademark; Environmental music by Muzak: live trademark; disclaimer: \"No claim is made to the exclusive right to use 'environmental music' apart from the mark shown)"}, "madsrdf:citationSource": "United States Patent and Trademark Office online trademark search system, Feb. 5, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kommerzstimmung erzeugende und verkaufsstimulierende Musik; KVM)"}, "madsrdf:citationSource": "Work cat.: Stromeyer, M.A. Die Anwendung der funktionalen Musik im Marketing, 198-", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Environmental music (Background music; notion of music as a utilitarian and unobtrusive background to other activities was predicted in 1920 by Erik Satie with his Musique d'ameublement, or \"furniture music\"); under Ambient music (Term used by Brian Eno to describe his own type of environmental music) Environmental music (Background music; definitions and interpretations of environmental music proliferated in the 20th century) Brian Eno (Development of ambient music in the 1970s by releasing Discreet music and Music for airports; wrote that ambient music \"must be able to accommodate many levels of listening attention without enforcing one in particular; it must be as ignorable as it is interesting\")"}, "madsrdf:citationSource": "Grove music online, viewed August 14, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Background music)"}, "madsrdf:citationSource": "OED", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Background music)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Oxford English dictionary, 1989;Collier's;Britannica Micro.;Americana;Acad. Am. encyc.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Background music)"}, "madsrdf:citationSource": "Random House", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Muzak (A type of environmental music piped into public buildings in order to create a specific atmosphere or mood)"}, "madsrdf:citationSource": "Grove music online, Feb. 5, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Muzak (A term for recorded background music played in public places (e.g. hotels, airports, and shops) and offices; recordings typically consist of a seamless string of bland, unobtrusive orchestral arrangements of pop and light music, with a narrow range of dynamics and tempo; first broadcast in 1922 by the American company Wired Music, later renamed Muzak (hence this generic name), but it is now available commercially worldwide; may be applied pejoratively to any characterless recorded music)"}, "madsrdf:citationSource": "Oxford companion to music online, Feb. 5, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ambient music; includes forms of music that put an emphasis on tone and atmosphere over traditional musical structure or rhythm; originated in the United Kingdom at a time when new sound-making devices such as the synthesizer were being introduced to a wider market; ambient compositions are often quite lengthy)"}, "madsrdf:citationSource": "Wikipedia, viewed July 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Background music; refers to various styles of music or soundscapes primarily intended to be passively listened to; not meant to be the main focus of an audience, but rather to supplement that which is meant to be focused upon)"}, "madsrdf:citationSource": "Wikipedia, viewed August 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Elevator music (also known as Muzak, piped music, weather music, or lift music) refers to a type of popular music, often instrumental, that is commonly played through speakers at shopping malls, grocery stores, department stores, telephone systems (while the caller is on hold), cruise ships, airliners (during take-off and flight), hotels, airports, business offices, hospitals, and elevators.)"}, "madsrdf:citationSource": "Wikipedia, Feb. 5, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Environmental music (background music))"}, "madsrdf:citationSource": "American Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Environmental music"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Environmental music"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lift music"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lift music"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Elevator music"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Elevator music"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Weather music"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Weather music"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ambient music (Background music)"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ambient music (Background music)"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Piped music"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Piped music"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Muzak (Trademark)"}}, {"@id": "_:n7b50b909b1af4305b4f1c0604e4acf7eb37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Muzak (Trademark)"}}], "@id": "/authorities/genreForms/gf2014027186"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027188", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAguinaldos", "identifiers:lccn": "gf2014027188", "madsrdf:adminMetadata": [{"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b1"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Aguinaldos"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026716"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b5"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b6"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b7"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b8"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b9"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aguinaldos"}}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Aguinaldo is a folk genre of Christmas music in several Latin American countries, based on an archaic form of Spanish Christmas carols or villancicos which is traditionally sung on Christmas itself or during the surrounding holiday season. Aguinaldo music is often performed by what is called parrandas - a casual group of people, often family or friends, who merrily go from house to house taking along their singing.)"}, "madsrdf:citationSource": "Wikipedia, viewed December 12, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 10 (Also address)ing Puerto Rican folk music from an ethnomusicological perspective, in the article, \"D\u00e9cima, Seis and the Art of the Puertorican Trovador Within the Modern Social Context,\" Prisco Hern\u00e1ndez explores the music of Puerto Rican folk musicians including the d\u00e9cima, seis and aguinaldo. His analysis demonstrates that these forms have fully developed musical and poetic structures and aesthetics)"}, "madsrdf:citationSource": "Gleason, David G. La parranda puertorrique\u00f1o, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "entry for aguinaldo (a generic term used in Venezuela for both religious and secular Christmas songs. Melodies are usually in 2/4 or 6/8 metre. Aguinaldo can be used to mean a 'Christmas gift.' Musical 'cards' are often performed by itinerant musicians or ordinary people, moving from house to house as part of the parranda, a tradition where in return for a song a gift may be given); entry for Puerto Rico, Traditional music, Hispanic genres (aguinaldo; religious music in Puerto Rico centres on the aguinaldo and the villancico, both descendants of the 16th-century Spanish villancico. In modern popular usage the two names are almost interchangeable and refer to a specific repertory of well-known songs whose texts deal with the Christmas cycle. The most common themes are the Nativity, the Three Kings and praise of the Virgin or Child. The melodies are usually in simple or compound binary metre; the rhythmic syncopation that many aguinaldos or villancicos display may be the result of African influence, although this has not been fully investigated)"}, "madsrdf:citationSource": "Grove music online WWW site, July 13, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Puerto Rican music (The aguinaldo is most characteristically sung during the Christmas season, when groups of revelers (parrandas) go from house to house, singing j\u00edbaro songs and partying. The aguinaldo texts are generally not about Christmas, and also unlike Anglo-American Christmas carols, they are generally sung by a solo with the other revelers singing chorus. In general, Christmas season is a time when traditional music--both seis and aguinaldo--is most likely to be heard. Fortunately, many groups of Puerto Ricans are dedicated to preserving traditional music by continued practice.\")"}, "madsrdf:citationSource": "Wikipedia, viewed December 9, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 975 (aguinaldo; Song genre throughout Hispanic America that is usually sung around Christmas and that involves gifts of coins, candy, food, or drink in exchange for music)"}, "madsrdf:citationSource": "Garland encyc. of world music:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0cb028a0f7cc4dc89a6aaf7c761f3369b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (aguinaldo)"}, "madsrdf:citationSource": "Work cat.: Lebr\u00f3n, L. Madrigal navide\u00f1o [SR] 195-:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027188"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027189", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVillanelle (Songs)", "identifiers:lccn": "gf2014027189", "madsrdf:adminMetadata": [{"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb1"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Villanelle (Songs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026835"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026074"}], "madsrdf:hasSource": [{"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb5"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb6"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb7"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb8"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb9"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb10"}], "madsrdf:hasVariant": [{"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb11"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb14"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb17"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb20"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb23"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Strophic songs for three or four voices that were composed in the Neapolitan dialect in the 16th century and that consciously imitate folk lyric traditions."}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:53:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Villanelle (Songs)"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(villanella; villanesca; canzone villanesca alla napolitana; aria napolitana; canzone napolitana; villanella alla napolitana; villanelle)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(villanelle; canzone villanesche; canzone villanesche alla napolitana; canzoni alla napolitana)"}, "madsrdf:citationSource": "LC database, Mar. 2, 1987", "madsrdf:citationStatus": "found"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Villanella (The generic designation canzone villanesca alla napolitana ('rustic song in the Neapolitan style') was coined in Naples to mark the d\u00e9but in print of a local genre (RISM 15375). It was used consistently until 1565 to describe strophic songs for three or four voices in Neapolitan dialect that consciously imitated (or borrowed from) lyric traditions of the street and countryside)"}, "madsrdf:citationSource": "Grove music online, viewed December 12, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(villanella; pl. villanelle)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Kapsperger, G.G. Villanelle a una e pi\u00f9 voci, 1979.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(villanella; villanellas)"}, "madsrdf:citationSource": "Apel. Harvard dict. of music, 2nd ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Villanellas (Songs)"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Villanellas (Songs)"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Villanesche (Songs)"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Villanesche (Songs)"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Canzone napolitane"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Canzone napolitane"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Arie napolitane (Songs)"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Arie napolitane (Songs)"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Canzone villanesche"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Canzone villanesche"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Canzoni alla napolitana"}}, {"@id": "_:nc8e0a1639fdf4500a57b4d3d4cfccdbcb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Canzoni alla napolitana"}}], "@id": "/authorities/genreForms/gf2014027189"}
