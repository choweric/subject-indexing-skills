00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n60d627ac09b34bb19ae984bea670fb59b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theater announcements (Motion pictures)"}}, {"@id": "_:n60d627ac09b34bb19ae984bea670fb59b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Glossary, p. 32 (Theater announcements: non-commercial messages shown to the audience)"}, "madsrdf:citationSource": "Archival moving image materials : a cataloging manual, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n60d627ac09b34bb19ae984bea670fb59b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 99 (Theater announcements: use for statements made by theater management for various purposes, including identifying the company which owns or operates the theater, requesting audience participation in, e.g., not smoking, introducing the previews or the feature, etc.)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n60d627ac09b34bb19ae984bea670fb59b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60d627ac09b34bb19ae984bea670fb59b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Announcements, Theater (Motion pictures)"}}, {"@id": "_:n60d627ac09b34bb19ae984bea670fb59b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Announcements, Theater (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2011026688"}
