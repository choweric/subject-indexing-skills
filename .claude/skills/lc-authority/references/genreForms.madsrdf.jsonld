 "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(drama television series about the lives of intersex people and their families)"}, "madsrdf:citationSource": "Work cat.: Moorat, 2006", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2020026004"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026005", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIntersex films", "identifiers:lccn": "gf2020026005", "madsrdf:adminMetadata": [{"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb1"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Intersex films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026039"}, "madsrdf:hasSource": [{"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb5"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb6"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb7"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb8"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb9"}], "madsrdf:hasVariant": {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films featuring intersex characters or addressing intersex themes."}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "revised"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intersex films"}}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (intersex films)"}, "madsrdf:citationSource": "Intersex Society of North America. ISNA news, summer 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(films addressing the issues faced by individuals who may have biological characteristics of both male and female sexes; films about intersex issues)"}, "madsrdf:citationSource": "Intersex films kick off \"Love Your Body\" program, via UNC Greensboro website, posted Oct. 4, 2007, viewed on Jan. 17, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(2007 motion picture drama about a 15-year-old intersex child whose parents moved from Buenos Aires to an isolated cabin outside of Piri\u00e1polis, Uruguay, to protect their child from prejudice)"}, "madsrdf:citationSource": "Work cat.: XXY, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles listed include: Predestination; XXY; The Last Summer of La Boyita; Spork; Being Impossible; Arianna; Ponyboi; Orchids: My Intersex Adventure; XXXY; Hermafrodita; Intersexion; Third Person)"}, "madsrdf:citationSource": "Most popular intersex movies and TV shows, via IMDb website, viewed on Jan. 17, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(2018 motion picture drama; summary: A young woman discovers she was submitted to several surgeries to correct her intersexual body as a baby. She has to find her own self outside gender binaries.)"}, "madsrdf:citationSource": "Yo, imposible = Being impossible, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Intersexual films"}}, {"@id": "_:nd613f70c2d3a457fa1bdca47f35987adb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intersexual films"}}], "@id": "/authorities/genreForms/gf2020026005"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026006", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIntersex television programs", "identifiers:lccn": "gf2020026006", "madsrdf:adminMetadata": [{"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b1"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Intersex television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasSource": [{"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b5"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b6"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b7"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b8"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b9"}], "madsrdf:hasVariant": {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs featuring intersex characters or addressing intersex themes."}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ic"}, "ri:recordStatus": "revised"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intersex television programs"}}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (\"I shall be examining the writing of people with intersex variations for contemporary screen productions, focusing on fictional characters with intersex variations in narrative film and television genres--drama and comedy predominantly\") p. 3 (in the past ten to fifteen years, characters with an intersex variation have become the subject of many television programs) pp. 13-14 (\"In the first episode of the second series of MTV's comedic high school drama Faking It (2014-present) entitled The Morning Aftermath (2015), one of the main characters, the somewhat conservative yet confrontational \"Lauren Cooper\", somewhat reluctantly \"outs\" herself as intersex ... Her intersex character arc is explored across multiple episodes of the second series ... For Lauren's intersex story, the writers and producers worked closely with consultants from InterAct, a group for young people with intersex variations or DSD committed to sharing their stories with the world\")"}, "madsrdf:citationSource": "Hart, P. Writing characters with intersex variations for television, 2016, via WWW, Jan. 17, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Most popular intersex movies and TV shows, via IMDb website, Jan. 17, 2020.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(MTV's teen comedy Faking It is poised to break new ground on the small screen in its second season when it explores what it's like to be born intersex; The season two premiere will reveal that [the character] Lauren regularly takes hormones and was born with Androgen Insensitive Syndrome, a type of intersex condition that means she was born with male chromosomes but develops as a female)"}, "madsrdf:citationSource": "MTV's \"Faking it\" to tell intersex story in season 2, via Hollywood reporter website, posted Sept. 12, 2014, viewed on Jan. 17, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(drama television series about the lives of intersex people and their families)"}, "madsrdf:citationSource": "Work cat.: Moorat, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. (intersex television documentaries)"}, "madsrdf:citationSource": "Transforming gender, sex, and place, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Intersexual television programs"}}, {"@id": "_:n7ff397da648a415e9cc6ae8cb3021002b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intersexual television programs"}}], "@id": "/authorities/genreForms/gf2020026006"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026010", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpeech corpora", "identifiers:lccn": "gf2020026010", "madsrdf:adminMetadata": [{"@id": "_:n323b9a45c05c499f9044179861db1ca7b1"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Speech corpora"}, "madsrdf:elementList": {"@list": [{"@id": "_:n323b9a45c05c499f9044179861db1ca7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026005"}, "madsrdf:hasSource": [{"@id": "_:n323b9a45c05c499f9044179861db1ca7b5"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b6"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b7"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b8"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b9"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b10"}], "madsrdf:hasVariant": [{"@id": "_:n323b9a45c05c499f9044179861db1ca7b11"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b14"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b17"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "new"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-05-14T09:21:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Speech corpora"}}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 27 (A spoken language corpus is a corpus consisting of recordings of speech which accessible in computer readable form, and which are transcribed orthographically, or into a recognized phonetic or phonemic notation)"}, "madsrdf:citationSource": "Spoken corpora and linguistic studies, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Using LDC Data page (LDC distribute corpora ... Text data ... Speech (audio) data) ... video data)"}, "madsrdf:citationSource": [{"@id": "https://www.ldc.upenn.edu/data-management/using"}, "Linguistic Data Consortium website, viewed Feb. 6, 2020"], "madsrdf:citationStatus": "found"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Corpora of spoken language contain transcriptions of spontaneous or planned speech, such as broadcast news or elicited narratives and dialogues. They are often aligned with the accompanying recordings. They are an invaluable resource for various kinds of linguistic research, such as phonology, conversational analysis, and dialectology.)"}, "madsrdf:citationSource": "CLARIN website, Feb. 6. 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 10, p. 5108 (Corpus: written texts, transcriptions, recorded data, etc. used as a basis for any sort of linguistic or language related investigation; a computer or computerized corpus is a body of such data in a machine-readable form.)"}, "madsrdf:citationSource": "The Encyclopedia of language and linguistics:", "madsrdf:citationStatus": "found"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Speech corpus ( A speech corpus (or spoken corpus) ... In speech technology, speech corpora are used, among the other things, to create acoustic models (which can be used with a speech recognition engine). In linguistics, spoken corpora are used to do research into phonetic, conversation analysis, dialectology and other fields)"}, "madsrdf:citationSource": "Wikipedia, Feb. 6, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Callfriend Canadian French speech corpus, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n323b9a45c05c499f9044179861db1ca7b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spoken corpora"}}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spoken corpora"}}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n323b9a45c05c499f9044179861db1ca7b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spoken data"}}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spoken data"}}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n323b9a45c05c499f9044179861db1ca7b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Audio data"}}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Audio data"}}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n323b9a45c05c499f9044179861db1ca7b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Speech data"}}, {"@id": "_:n323b9a45c05c499f9044179861db1ca7b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Speech data"}}], "@id": "/authorities/genreForms/gf2020026010"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026011", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAfrofuturist comics", "identifiers:lccn": "gf2020026011", "madsrdf:adminMetadata": [{"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b1"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Afrofuturist comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026530"}, "madsrdf:hasSource": [{"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b5"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b6"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b7"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b8"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b9"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b10"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b11"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b12"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b13"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b14"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b15"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b16"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b17"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b18"}], "madsrdf:hasVariant": {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b19"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Science fiction comics that feature Black characters and concerns, and depict technology as a resource for Black empowerment."}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-06-17T13:41:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Afrofuturist comics"}}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"comic books can be a medium that integrates Afrofuturism ... by providing a fantasy setting and visual storytelling\"; \"Many comic books writers set their characters to engage in Afrofuturist explorations\"; \"Afrofuturist comic books\"; \"Afrofuturism is not simply a tool of representation, but also a technique that incorporates the medium of comic books to re-craft and build a history and identity through the African diasporic women's narratives\")"}, "madsrdf:citationSource": "Gipson, G. The future is black and female : Afrofuturism and comic books, Oct. 14, 2017, via African American Intellectual History Society website, viewed Feb. 11, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 1-30 (\"Afrofuturism and comic books\"; Marvel's Black Panther series \"is typically Afrofuturist in that it looks to Africa for answer for the future, rather than seeing Africa as an underdeveloped continent and relic of the past\")"}, "madsrdf:citationSource": "Burger, B. A nation under our feet : Black Panther, Afrofuturism and the potential of thinking through political structures, in Image & text v. 33, no. 1 (2019):", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 211 (\"building Afrofuturist worlds in comics\")"}, "madsrdf:citationSource": "Afrofuturism 2.0, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 142 (\"using comics to shape black identities and Afrofuturism\") p. 159 (\"Afrofuturistic comic art\")"}, "madsrdf:citationSource": "Womack, Y. L. Afrofuturism, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "About Us (\"African-centered science fiction and fantasy comics; a genre that is also known as Afrofuturism\")"}, "madsrdf:citationSource": "Black Sun Comics website, viewed Feb. 11, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Afrofuturist comics collection, held by California State University Dominguez Hills, via the Online Archive of California website, viewed Feb. 11, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(genres: Afrofuturist comics)"}, "madsrdf:citationSource": "Goodreads website, viewed Feb. 11, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel adaptation of Butler's Afrofuturist novel)"}, "madsrdf:citationSource": "Work cat: Duffy, D. Octavia E. Butler's Parable of the sower, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel about Black Panther's \"techno-genius sister\" Shuri, set in the Afrofuturist nation of Wakanda)"}, "madsrdf:citationSource": "Okorafor, N. Shuri. Volume 1, The search for Black Panther, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 65 (\"Black to the future: a librarian's guide to building an Afrofuturist comics and graphic novels collection\") p. 73 (Black Panther \"embrace[s] African culture and the diaspora, modeling Afrofuturism in comic form\") pp. 78-79 (Afrofuturistic comics \"explicitly position and re-imagine Black futures [and] employ technology as a resource for Black liberation ... it is the combination of features that make a work Afrofuturist in nature\"; Afrofuturist comics feature African diaspora characters, address issues of Black empowerment or Black futures collectively, and utilize technology for Black empowerment) p. 81 (Milestone Media \"is one of the few Black-owned companies with established Afrofuturist characters and series\") p. 82 (\"Key artists to consider when researching and selecting Afrofuturist comics include Dwayne McDuffie, Christopher Priest, Jamal Y. Igle, Reynaldo Anderson, David Walker, Afua Richardson, John Jennings, Nnedi Okorafor, and Felicia Henderson\") pp. 87-90 (includes list of selected Afrofuturist comics and graphic novel titles)"}, "madsrdf:citationSource": "Comics and critical librarianship, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 182 (\"Afrofuturism percolates, as well, through black-written, black-drawn comics such as Milestone Media's Hardware ... about a black scientist who dons forearm-mounted cannons and a 'smart' battle suit to wage guerrilla war on his Orwellian, multinational employer\")"}, "madsrdf:citationSource": "Dery, M. Black to the future, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Afrofuturist graphic novel series)"}, "madsrdf:citationSource": "JTW. The Afrofuturist, 2014-", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 44 (\"Because the character and the comic book offered a grand and a triumphant vision of Afrofuturist blackness, the Black Panther series is significant and compelling as one of the most mainstream yet radical representations of blackness in American pop culture\") p. 92 (John Henry Irons/Steel from DC Comics \"is invested with undeniable signifiers of black culture and history that make him an Afrofuturistic version of the black American folk hero John Henry\") p. 31 (DC Comics' \"Mosaic\" Green Lantern series \"presented one of the most daring and complex representations of Afrofuturistic blackness of the time and arguably since\")"}, "madsrdf:citationSource": "Nama, A. Super black : American pop culture and black superheroes, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b18", "@type": "madsrdf:Source", "madsrdf:citationSource": "Tim Fielder talks about Afrofuturist comics, Apr. 27, 2016, via Literature at MIT website, viewed Feb. 11, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Afrofuturistic comics"}}, {"@id": "_:ncaf54d1068cd48549056ba02b95c1b77b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Afrofuturistic comics"}}], "@id": "/authorities/genreForms/gf2020026011"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026012", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRole-playing games", "identifiers:lccn": "gf2020026012", "madsrdf:adminMetadata": [{"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b1"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Role-playing games"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, "madsrdf:hasSource": [{"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b5"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b6"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b7"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b8"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b9"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b10"}], "madsrdf:hasVariant": [{"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b11"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Games in which players assume the roles of imaginary characters who engage in adventures in a fictional setting."}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-13T13:46:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Role-playing games"}}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(braille role-playing game)"}, "madsrdf:citationSource": "Star Trek adventures : the roleplaying game : starter set, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"a strategy role playing game\"; \"sequel to 1988's Wasteland, the first-ever post-apocalyptic computer RPG\")"}, "madsrdf:citationSource": "Work cat: Wasteland 2, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(role-playing game: \"a game in which participants act out roles\"; \"a game in which players take on the roles of imaginary characters who engage in adventures, typically in a particular fantasy setting overseen by a referee\"; \"a computer game of this kind\")"}, "madsrdf:citationSource": "Oxford English dictionary online, viewed Feb. 12, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a role-playing board game)"}, "madsrdf:citationSource": "Planet Mercenary : role-playing game, the fun-toting, maxim-quoting space opera RPG, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 76 (\"all forms of role playing games ... share a group of characteristics, which makes them identifiable from other types of games: storytelling with rules, control of fictional characters, a fictitious reality, usually the presence of a game master (or game engine), and at least one player\")"}, "madsrdf:citationSource": "Tychsen, A. Role playing games, in IE 2006 : Third Australasian Conference on Interactive Entertainment, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Role-playing game)"}, "madsrdf:citationSource": "Art & Architecture Thesaurus, viewed Feb. 12, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "RPGs (Role-playing games)"}}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "RPGs (Role-playing games)"}}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Roleplaying games"}}, {"@id": "_:n6b4b078cd8854fb8b41409ef44694c00b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Roleplaying games"}}], "@id": "/authorities/genreForms/gf2020026012"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026013", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWordless novels", "identifiers:lccn": "gf2020026013", "madsrdf:adminMetadata": [{"@id": "_:n4b533af6036c40d689b352e597ab8b88b1"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Wordless novels"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4b533af6036c40d689b352e597ab8b88b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026020"}], "madsrdf:hasSource": [{"@id": "_:n4b533af6036c40d689b352e597ab8b88b5"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b6"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b7"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b8"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b9"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b10"}], "madsrdf:hasVariant": [{"@id": "_:n4b533af6036c40d689b352e597ab8b88b11"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b14"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-11-13T13:46:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wordless novels"}}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (a novel in woodcuts)"}, "madsrdf:citationSource": "Ward, Lynd. God's man, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Two volumes consisting of six wordless woodcut novels) dust jkt. (\"From the eve of the Great Depression to the onset of World War II, Lynd Ward, America's first great graphic novelist, bore witness to the roiling, dizzying national scene as both a master printmaker and a socially committed storyteller. His medium of expression, the wordless 'novel in woodcuts,' was his alone in the United States, and he quickly brought it from bold iconic infancy to a still unrivaled richness of drama, characterization, imagery, and technique\")"}, "madsrdf:citationSource": "Work cat.: Ward, Lynd. Six novels in woodcuts, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"The so-called graphic novel--which may be no more than a successful rebranding of comics--has become a very popular genre, with its own bestseller list in the New York Times, and growing shelfspace in new book stores. In light of this new-found prominence and respectability, it's interesting to look back at the precursors to the graphic novel, the stages the idea of the illustrated novel-length story went through before settling into the form we current know. One of these stages was the wordless novel, in particular the work of American Lynd Ward, who was both an influential illustrator of children's books (he won a Caldecott Award) and a pioneer of the wordless novel\"; Frans Masereel's wordless novel The Sun (1919). Told in a series of woodcuts without any words; another early wordless novel, Otto N\u00fcckel's Destiny (1926); wordless project. Gods' Man, a meditation on the artist's struggle, was published by Cape & Smith in 1929. As Masreel and N\u00fcckel had only been published in Europe, it became America's first wordless novel)"}, "madsrdf:citationSource": "Rennicks, Rich. Lynd Ward and the wordless novel, via The new antiquarian blog, Oct. 3, 2016, viewed Feb. 12, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(woodcut novels, which are wordless imaginative and realistic stories by [Frans] Masereel, Otto N\u00fcckel, Lynd Ward and others; told in black and white pictures that focus on humanistic ideas. The woodcut novel refers not only to woodcuts but also to wood engravings, linocuts, leadcuts, and solid plastic. A woodcut uses the plank cut with the grain, while a wood engraving uses hardwood cut across the grain that allows a finer line. Despite their short-lived popularity, the woodcut novel had an important impact on the development of the contemporary graphic novel; At the core of the woodcut novel and the wordless novel is the use of pictures to tell a story; Creators of the woodcut novels include George Walker and various artists who teeter between the graphic novel and artists' books; The recognition of the woodcut novel as part of the medium of comics and its place in the history of comics was confirmed with the selection of Lynd Ward as the Judges' Choice in the 2011 Will Eisner Hall of Fame; wordless novels ... like Pilipino Food (1972) by Ed Badajos or Squeak the Mouse (1984) by Mattioli lead to a series of works like Gon by Masashi Tanaka and the Frank series by Jim Woodring in the 1990s, in addition to single works by a variety of artists like Mea Culpa by Peter Kalberkamp and The Silent City by Erez Yakin)"}, "madsrdf:citationSource": "Beron\u00e4, David A. Woodcut novels : cutting a path to the graphic novel, via Comics forum, posted May 23, 2013, viewed Feb. 10, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Wordless novel (The wordless novel is a narrative genre that uses sequences of captionless pictures to tell a story. As artists have often made such books using woodcut and other relief printing techniques, the terms woodcut novel or novel in woodcuts are also used. The genre flourished primarily in the 1920s and 1930s and was most popular in Germany; Lynd Ward brought the genre to the United States in 1929 when he produced Gods' Man, which inspired other American wordless novels; In the 1970s, the example of the wordless novel inspired cartoonists such as Will Eisner and Art Spiegelman to create book-length non-genre comics--\"graphic novels\")"}, "madsrdf:citationSource": "Wikipedia, Feb. 12, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Stories without words. UF Novels in pictures; Picture novels; Romans beelden; Woodcut novels. BT Illustrated works)"}, "madsrdf:citationSource": "RBMS controlled vocabularies: genre terms, via WWW, Feb. 12, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b533af6036c40d689b352e597ab8b88b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories without words"}}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories without words"}}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b533af6036c40d689b352e597ab8b88b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novels in pictures"}}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novels in pictures"}}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b533af6036c40d689b352e597ab8b88b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Picture novels"}}, {"@id": "_:n4b533af6036c40d689b352e597ab8b88b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picture novels"}}], "@id": "/authorities/genreForms/gf2020026013"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026014", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSchool fiction", "identifiers:lccn": "gf2020026014", "madsrdf:adminMetadata": [{"@id": "_:ne5290180761049f5918cab9162c66fdfb1"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "School fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne5290180761049f5918cab9162c66fdfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:ne5290180761049f5918cab9162c66fdfb5"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb6"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb7"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb8"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb9"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb10"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb11"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb12"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb13"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb14"}], "madsrdf:hasVariant": {"@id": "_:ne5290180761049f5918cab9162c66fdfb15"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that is set in a school and focuses on the lives and interactions of students, teachers, and administrators."}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-08-17T13:54:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "School fiction"}}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Chronicles the goings-on in a large metropolitan high school, detailing the experiences of an idealistic first-year teacher who is plagued by difficulties arising from an overwhelming bureauracy, inadequate facilities, and some unforgettable students)"}, "madsrdf:citationSource": "Kaufman, Bel. Up the down staircase, 1965", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 140 (school fiction; school novels are increasingly drawn on as sources for educational history; novel set in school; school stories) p. 141 (pictures of school life; novels specifically about school life began to be common and popular in the 1850s) p. 142 (the most celebrated school story of all, Tom Brown's Schooldays, 1857)"}, "madsrdf:citationSource": "British journal of educational studies, June 1979:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(School stories. Use for individual works, collections, or materials about school stories. UF School fiction; Schools--Fiction. BT Fiction)"}, "madsrdf:citationSource": "Sears list of subject headings, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "introd. (narratives set and British and American boarding schools; school fiction; American school fiction)"}, "madsrdf:citationSource": "Pitofsky, Alexander H. American boarding school fiction, 1928/1981, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(school stories. SN Narratives that focus on the life and experiences of a child or young person while at school; originally set in boarding schools, more recent examples may concern day schools. UF school novels. BT <genres for literature>)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Feb. 12, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(school stories; The tradition of the school story began in earnest with the publication of Thomas Hughes's Tom Brown's Schooldays in 1857, which opened the floodgate for a stream of books, comics and tales flowing well into the 1970s; they were subject to a series of shared conventions, the recognition of which made them a familiar, nostalgic experience, even to those readers who didn't attend boarding school; Although the better-known examples tend to be those set in boys' schools, the first published school story is thought to be Sarah Fielding's 1749 novel The Governess, or The Little Female Academy, and stories for boys and girls grew up in tandem and along similar lines; Typically, school stories uphold the virtues of bravery, decency of character and honour; themes of fairness, hard work, the defeat of bullies and excellence in academic and sporting endeavors)"}, "madsrdf:citationSource": "Lucas, John. Has public school fiction passed the test of time?, via The guardian, 4 Jan, 2011, viewed Feb. 12, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(School Stories; genre, British in origin, in which school is not just a backdrop but rather the raison d'\u00eatre of the novel; Thomas Hughes's Tom Brown's School-Days (1857), generally considered to be the first boys' school story; stories set in high schools and public (i.e., large private) schools; By the 1970s the genre appeared to be in terminal decline. Then along came Harry Potter. J.K. Rowling's novels combine several genres, but a convincing case could be (and has been) made that they are first and foremost school stories)"}, "madsrdf:citationSource": "The Oxford encyclopedia of children's literature, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a school story)"}, "madsrdf:citationSource": "Speed, Nell. At boarding school with the Tucker twins, \u00a91915", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a school story)"}, "madsrdf:citationSource": "Work cat.: Farrar, F. W. Eric, or, Little by little : a tale of Roslyn School, 1891", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Eric, or, Little by Little (Eric, or, Little by Little is a book by Frederic W. Farrar, first edition 1858; deals with the descent into moral turpitude of a boy at a boarding school; he encounters the good and bad aspects of the traditional boys' school) School story (The school story is a fiction genre centering on older pre-adolescent and adolescent school life, at its most popular in the first half of the twentieth century. While examples do exist in other countries, it is most commonly set in English boarding schools and mostly written in girls' and boys' subgenres, reflecting the single-sex education typical until the 1950s. It focuses largely on friendship, honor and loyalty between pupils. Plots involving sports events, bullies, secrets, rivalry and bravery are often used to shape the school story; school stories have remained popular in other forms, with a focus on state run coeducational schools, and themes involving more modern concerns such as racial issues, family life, sexuality and drugs; more recently it has seen a revival with the success of the Harry Potter series, which uses many plot motifs commonly found in the traditional school story; the school story genre; school stories originated in Britain with Tom Brown's Schooldays by Thomas Hughes (1857); boarding school stories)"}, "madsrdf:citationSource": "Wikipedia, Feb. 12, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5290180761049f5918cab9162c66fdfb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "School stories"}}, {"@id": "_:ne5290180761049f5918cab9162c66fdfb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "School stories"}}], "@id": "/authorities/genreForms/gf2020026014"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026015", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFull-text databases", "identifiers:lccn": "gf2020026015", "madsrdf:adminMetadata": [{"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b1"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Full-text databases"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026081"}, "madsrdf:hasSource": [{"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b5"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b6"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b7"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b8"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b9"}], "madsrdf:hasVariant": {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-13T13:46:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Full-text databases"}}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "full-text database (A full-text database is a compilation of documents or other information in the form of a database in which the complete text of each referenced document is available for online viewing, printing, or downloading. In addition to text documents, images are often included, such as graphs, maps, photos, and diagrams. A full-text database is searchable by keyword, phrase, or both.)"}, "madsrdf:citationSource": "WhatIs.com, Feb. 13, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (archive that makes the backfiles of scholarly periodicals in the arts, humanities and social sciences available electronically, providing access to the searchable full text of hundreds of titles) about (full text of a growing number of digitized periodicals that have been indexed in its sister database, Periodicals Index Online; contains over 700 journals comprising more than 3 million articles and 15 million article pages; Coverage is from volume 1 issue 1 of each journal and issues are digitized from cover to cover)"}, "madsrdf:citationSource": "Work cat.: Periodicals archive online, accessed Feb. 13, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Full-Text Database: A full-text database is a database that is comprised of several books, articles, journals, magazines, newspapers and other textual documents but does not include graphical documents such as drawings, diagrams or pictures. Each of the referenced documents can be viewed, printed or downloaded online. It is also searchable by using keywords, phrases or both.)"}, "madsrdf:citationSource": "Technology dictionary, via Techopedia website, Feb. 13, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Full-text database (A full-text database or a complete-text database is a database that contains the complete text of books, dissertations, journals, magazines, newspapers or other kinds of textual documents. They differ from bibliographic databases (which contain only bibliographical metadata, including abstracts in some cases) and non-bibliographic databases (such as directories and numeric databases))"}, "madsrdf:citationSource": "Wikipedia, Feb. 13, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(full-text: An electronic resource that provides the entire text of a single work (example: Britannica Online) or of articles published in one or more journals, magazines, and/or newspapers. For example, a bibliographic database that provides the complete text of a significant proportion of the works indexed, in addition to the bibliographic citation and (in many cases) an abstract of the content (example: JSTOR). Also spelled full text and fulltext; full-text search: A search of a bibliographic database in which the entire text of each record or document is searched and the entry retrieved if the terms included in the search statement are present. Most Web search engines are designed to perform full-text searches)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, viewed Feb. 13, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fulltext databases"}}, {"@id": "_:n0cc3927d35ed467088eb303ca6a43d33b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fulltext databases"}}], "@id": "/authorities/genreForms/gf2020026015"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026016", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAfrofuturist fiction", "identifiers:lccn": "gf2020026016", "madsrdf:adminMetadata": [{"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b1"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Afrofuturist fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026529"}, "madsrdf:hasSource": [{"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b5"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b6"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b7"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b8"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b9"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b10"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b11"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b12"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b13"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b14"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b15"}], "madsrdf:hasVariant": [{"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b16"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Science fiction that features Black characters and concerns, and depicts technology as a resource for Black empowerment. For fiction rooted in African culture, history, and mythology that depicts technology as a resource for African empowerment see [Africanfuturist fiction.]"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-04-15T12:19:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "revised"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Afrofuturist fiction"}}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Topic guide--Magical YA Fiction Starring African and African American Women (\"Afrofuturistic fiction\")"}, "madsrdf:citationSource": "Chicago Public Library website, viewed Feb. 13, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Afrofuturist fiction\")"}, "madsrdf:citationSource": "Botha, N. We need Afrofuturism more than ever, Nov. 23, 2015, via Dazed Digital website, viewed Feb. 13, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Edwards-Thro, S. \"Istwa sa a pa senp\" : body, land, and family in Haitian Afrofuturist fiction, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 58 (\"Afrofuturism as 'speculative fiction that treats African-American themes and addresses African-American concerns in the context of 20th century technoculture--and more generally, African-American signification that appropriates images of technology and a prosthetically enhanced future' to explore how people of color might radically change the social and political world\"; Afrofuturist fiction draws on the historical experience of African diaspora people, and utilizes technology to posit a better collective future) p. 60 (\"Afrofuturist fiction\") p. 61 (\"Afrofuturism remained distinct from specialist SF in its sustained consideration of race as a central factor informing the relations of science and society\") p. 63 (\"the first generation of Afrofuturist SF authors--including Octavia E. Butler, Samuel R. Delany, Charles Saunders, and Steve Barnes\") p. 67 (Afrofuturist Nnedi Okorafor \"uses the techniques of Afrofuturism to explore how Africans grapple with the lingering alienation of their various colonial pasts while combining Eurowestern and African technoscientific traditions to build new futures\")"}, "madsrdf:citationSource": "The Cambridge companion to American science fiction, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Black No More resists the push toward preaching and the urge toward looking backward into history. Afrofuturist before such a term existed, it insists, instead, on peering forward into what could come to be\")"}, "madsrdf:citationSource": "Senna, D. George Schulyer: an Afrofuturist before his time, Jan. 19, 2018, via New York Review of Books website, viewed Feb. 13, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Afrofuturist fiction novel set thirty years in the future about a young African American woman with hyperempathy in a U.S. on the verge of violent destruction)"}, "madsrdf:citationSource": "Butler, O. E. Parable of the sower, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Afrofuturism ... fiction collections\"; \"Afrofuturistic fiction\")"}, "madsrdf:citationSource": "Ybarra, E. Dreaming of Wakanda: Afrofuturism and Afrofantasy, Feb. 28, 2018, via Los Angeles Public Library website, viewed Feb. 13, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: [Afrofuturist novel that asks] \"What if the African natives developed steam power ahead of their colonial oppressors?\")"}, "madsrdf:citationSource": "Work cat: Shawl, N. Everfair : a novel, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 70-88 (\"Afrofuturist fiction\")"}, "madsrdf:citationSource": "Brickler, A. D. J. Black mecha is built for this : Black masculine identity in Firedance and Afro Samurai, in Canadian journal of cultural studies, v. 39 (2018):", "madsrdf:citationStatus": "found"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 180 (\"Speculative fiction that treats African-American themes and addresses African-American concerns in the context of twentieth-century technoculture ... might, for want of a better term, be called 'Afrofuturism'\")"}, "madsrdf:citationSource": "Dery, M. Black to the future, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Afrofuturist speculative fiction anthology)"}, "madsrdf:citationSource": "Mothership : tales from Afrofuturism and beyond, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Afrofuturistic fiction"}}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Afrofuturistic fiction"}}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Afrofuturism fiction"}}, {"@id": "_:nc30e39b5184b45fe93ac455a5a8218b9b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Afrofuturism fiction"}}], "@id": "/authorities/genreForms/gf2020026016"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026034", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPishdar\u0101mads", "identifiers:lccn": "gf2020026034", "madsrdf:adminMetadata": [{"@id": "_:n67557ea09eab460bbd6398061bf40644b1"}, {"@id": "_:n67557ea09eab460bbd6398061bf40644b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pishdar\u0101mads"}, "madsrdf:elementList": {"@list": [{"@id": "_:n67557ea09eab460bbd6398061bf40644b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026760"}, "madsrdf:hasSource": [{"@id": "_:n67557ea09eab460bbd6398061bf40644b5"}, {"@id": "_:n67557ea09eab460bbd6398061bf40644b6"}, {"@id": "_:n67557ea09eab460bbd6398061bf40644b7"}], "madsrdf:hasVariant": {"@id": "_:n67557ea09eab460bbd6398061bf40644b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n67557ea09eab460bbd6398061bf40644b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-11-13T13:45:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n67557ea09eab460bbd6398061bf40644b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-24T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n67557ea09eab460bbd6398061bf40644b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pishdar\u0101mads"}}, {"@id": "_:n67557ea09eab460bbd6398061bf40644b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc labels (124 qa\u1e6d\u02bbah\u02b9-\u012b barguz\u012bdah az m\u016bs\u012bq\u012b-i kl\u0101s\u012bk-i \u012ar\u0101n = 124 pieces of Iranian classical music) contents listing in accompanying booklet (6 CD set: almost all of the pieces on CD 1 and about a quarter on CD 2 are entitled Pishdar\u00e2mad, followed by an indication of the dastg\u0101h (mode) and the composer) (DLC)2020615114"}, "madsrdf:citationSource": "Work cat: 124 qa\u1e6d\u02bbah\u02b9-\u012b barguz\u012bdah az m\u016bs\u012bq\u012b-i kl\u0101s\u012bk-i \u012ar\u0101n = 124 pieces of Iranian classical music, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n67557ea09eab460bbd6398061bf40644b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Iran. II. Classical traditions. 4. Composed music (\"20th-century performing practice of the 12 dastg\u0101hs [modes] led to the creation of a new genre of composed pieces by known authors ... In the main, there are four types of composed music. Three are purely instrumental: pishdar\u0101mad, reng, and ch\u0101h\u0101rmezr\u0101b ... The pishdar\u0101mad \"pre-introduction\" owes its origins to a growing interest in ensemble playing ... Although essentially an ensemble piece, true to the classical tradition, the pishdar\u0101mad is monophonic and, as such, it can also be played by a single instrument. ... The rhythm is mostly in duple time, less commonly in triple or quadruple time. The tempo is normally moderate and the piece may last some two to five minutes.\""}, "madsrdf:citationSource": "Grove music online, February 24, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n67557ea09eab460bbd6398061bf40644b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 137 (in the twentieth century, \"the term dastg\u0101h came to designate ... a suite form consisting of pishdar\u0101mad (\"overture\"), \u0101v\u0101z (rad\u012bf), ta\u1e63n\u012bf (a composed metric song ... ), and reng (a dance form). The pishdar\u0101mad is the opening instrumental piece, often in 2/4 meter, played by a solo melodic instrument and drum or more often by a small group of instrumentalists\") page 863 (pish-dar\u0101mad) page 1089 (pish dar\u0101mad: Instrumental composition played by a melodic instrument and drum or by a small ensemble before the initial g\u016bshe-h\u0101 [piece or section] of a Persian dastg\u0101h)"}, "madsrdf:citationSource": "The Garland encyclopedia of world music. Vol. 6, The Middle East, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n67557ea09eab460bbd6398061bf40644b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n67557ea09eab460bbd6398061bf40644b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pish-dar\u0101mads"}}, {"@id": "_:n67557ea09eab460bbd6398061bf40644b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pish-dar\u0101mads"}}], "@id": "/authorities/genreForms/gf2020026034"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026035", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRengs", "identifiers:lccn": "gf2020026035", "madsrdf:adminMetadata": [{"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b1"}, {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rengs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026760"}], "madsrdf:hasSource": [{"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b5"}, {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b6"}, {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b7"}], "madsrdf:hasVariant": {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-11-13T13:45:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-24T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rengs"}}, {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Iran. II. Classical traditions. 4. Composed music (\"20th-century performing practice of the 12 dastg\u0101hs [modes] led to the creation of a new genre of composed pieces by known authors ... In the main, there are four types of composed music. Three are purely instrumental: pishdar\u0101mad, reng, and ch\u0101h\u0101rmezr\u0101b ... The reng is a dance piece. There are some very old rengs by unknown composers, but hundreds of rengs have also been composed in modern times. In form, the reng resembles the pishdar\u0101mad; it also draws on melodic material of the relevant dastg\u0101h. It is, however, in a faster tempo, is nearly always in 6/8 time, and usually concludes the performance of a dastg\u0101h. A reng can be played by an ensemble, but ... is also very often played as the concluding piece for a solo performance\")"}, "madsrdf:citationSource": "Grove music online, February 24, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc labels (124 qa\u1e6d\u02bbah\u02b9-\u012b barguz\u012bdah az m\u016bs\u012bq\u012b-i kl\u0101s\u012bk-i \u012ar\u0101n = 124 pieces of Iranian classical music) contents listing in accompanying booklet (6 CD set: about 3/4 of the pieces om CD 2, all on CDs 3 and 4, and about 1/4 on CD 5 are entitled Reng, followed by an indication of the dastg\u0101h (mode) and the composer) (DLC)2020615114"}, "madsrdf:citationSource": "Work cat: 124 qa\u1e6d\u02bbah\u02b9-\u012b barguz\u012bdah az m\u016bs\u012bq\u012b-i kl\u0101s\u012bk-i \u012ar\u0101n = 124 pieces of Iranian classical music, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 137 (in the twentieth century, \"the term dastg\u0101h came to designate ... a suite form consisting of pishdar\u0101mad (\"overture\"), \u0101v\u0101z (rad\u012bf), ta\u1e63n\u012bf (a composed metric song ... ), and reng (a dance form). ... A closing instrumental reng would also be performed by a soloist or by an ensemble. The rhythm of the reng form is based on a traditional Persian dance rhythm, a particular form of 6/8 time with an emphasis shifting from a division into three accents to a division into two (hemiola). Often this rhythm uses an extended sixth beat with a delayed and shortened first beat. The ta\u1e63n\u012bf and reng bring a lighter and faster finish to the dastg\u0101h performance and are believed to be a way of bringing people out of their thoughts into a renewed sense of their surroundings\") page 834 (\"In Persian classical music, the playing of a reng--often an extended, multisectional piece in a rapid 6/8--marks the end of a performance\") page 879 (\"A musical composition specifically suited to dance performances is called reng\")"}, "madsrdf:citationSource": "The Garland encyclopedia of world music. Vol. 6, The Middle East, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reng-h\u0101"}}, {"@id": "_:nec6f44d9d1054d6d8174a8e61b18a655b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reng-h\u0101"}}], "@id": "/authorities/genreForms/gf2020026035"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026036", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCh\u0101h\u0101rmezr\u0101bs", "identifiers:lccn": "gf2020026036", "madsrdf:adminMetadata": [{"@id": "_:n3171cc8481ab458695f0d2da04e586dcb1"}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ch\u0101h\u0101rmezr\u0101bs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3171cc8481ab458695f0d2da04e586dcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026760"}, "madsrdf:hasSource": [{"@id": "_:n3171cc8481ab458695f0d2da04e586dcb5"}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb6"}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb7"}], "madsrdf:hasVariant": [{"@id": "_:n3171cc8481ab458695f0d2da04e586dcb8"}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-11-13T13:45:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-24T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ch\u0101h\u0101rmezr\u0101bs"}}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc labels (124 qa\u1e6d\u02bbah\u02b9-\u012b barguz\u012bdah az m\u016bs\u012bq\u012b-i kl\u0101s\u012bk-i \u012ar\u0101n = 124 pieces of Iranian classical music) contents listing in accompanying booklet (6 CD set: approximately 3/4 of the pieces on CD 5 are entitled Chah\u00e2rmezr\u00e2b, followed by an indication of the dastg\u0101h (mode) and the composer) (DLC)2020615114"}, "madsrdf:citationSource": "Work cat: 124 qa\u1e6d\u02bbah\u02b9-\u012b barguz\u012bdah az m\u016bs\u012bq\u012b-i kl\u0101s\u012bk-i \u012ar\u0101n = 124 pieces of Iranian classical music, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 67 (\"The instrumental form chah\u0101rme\u017cr\u0101b ... uses a short repeating rhythmic pattern as an underlying basis for improvisation or composition ...) page 137 (\"the chah\u0101rme\u017cr\u0101b ... was gradually introduced as a standard part of the dastg\u0101h performance ... It ... often precedes or follows an important g\u016bshe [piece]. The basis of the chah\u0101rme\u017cr\u0101b is a rhythmic motive (p\u0101ye) that incorporates a pedal tone and acts as an ostinato and rhythmic accompaniment to the melody line. A chah\u0101rme\u017cr\u0101b is usually performed in 3/8, 6/8, 6/16, 9/16, or 12/16 meter\") page 866 (chah\u0101rme\u017cr\u0101b-ha [used as a plural]) page 1079 (\"chah\u0101r me\u017cr\u0101b: \"Four strokes\" (Persian), a composition emphasizing instrumental virtuosity\")"}, "madsrdf:citationSource": "The Garland encyclopedia of world music. Vol. 6, The Middle East, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Iran. II. Classical traditions. 4. Composed music (\"20th-century performing practice of the 12 dastg\u0101hs [modes] led to the creation of a new genre of composed pieces by known authors ... In the main, there are four types of composed music. Three are purely instrumental: pishdar\u0101mad, reng, and ch\u0101h\u0101rmezr\u0101b ... Unlike the preceding two forms, the ch\u0101h\u0101rmezr\u0101b is exclusively a solo instrumental composition intended to display the performer's virtuosity. Its melodic content is simple and slight, with emphasis on fast and flowing movement around a fragmentary basic motif. A recurring rhythmic motif in 6/8 time is a common feature. However, modern ch\u0101h\u0101rmezr\u0101bs have become more elaborate, sometimes involving rhythmic syncopation and melodic extensions requiring modulations. The ch\u0101h\u0101rmezr\u0101b is less fixed than the other compositional forms, allowing for some expansion through improvisation. The position of a ch\u0101h\u0101rmezr\u0101b in the course of a dastg\u0101h performance is not fixed ... Additional ch\u0101h\u0101rmezr\u0101bs may be placed before or after one or more of the prominent gushehs [pieces] of the dastg\u0101h. ... Contemporary instrumentalists ... tend to intersperse their rendition of a dastg\u0101h with an ever-increasing number of such display pieces\")"}, "madsrdf:citationSource": "Grove music online, February 24, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3171cc8481ab458695f0d2da04e586dcb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chah\u0101r me\u017cr\u0101bs"}}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chah\u0101r me\u017cr\u0101bs"}}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3171cc8481ab458695f0d2da04e586dcb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chah\u0101rme\u017cr\u0101b-ha"}}, {"@id": "_:n3171cc8481ab458695f0d2da04e586dcb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chah\u0101rme\u017cr\u0101b-ha"}}], "@id": "/authorities/genreForms/gf2020026036"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026037", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTasnifs", "identifiers:lccn": "gf2020026037", "madsrdf:adminMetadata": [{"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b1"}, {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tasnifs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026760"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b5"}, {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b6"}, {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b7"}], "madsrdf:hasVariant": {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-11-13T13:45:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-24T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tasnifs"}}, {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc labels (124 qa\u1e6d\u02bbah\u02b9-\u012b barguz\u012bdah az m\u016bs\u012bq\u012b-i kl\u0101s\u012bk-i \u012ar\u0101n = 124 pieces of Iranian classical music) contents listing in accompanying booklet (6 CD set: almost all of the pieces on CD 6 are entitled Tasnif, followed by an indication of the dastg\u0101h (mode) and the composer) (DLC)2020615114"}, "madsrdf:citationSource": "Work cat: 124 qa\u1e6d\u02bbah\u02b9-\u012b barguz\u012bdah az m\u016bs\u012bq\u012b-i kl\u0101s\u012bk-i \u012ar\u0101n = 124 pieces of Iranian classical music, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 137 (in the twentieth century, \"the term dastg\u0101h came to designate ... a suite form consisting of pishdar\u0101mad (\"overture\"), \u0101v\u0101z (rad\u012bf), ta\u1e63n\u012bf (a composed metric song ... ), and reng (a dance form). ... The ta\u1e63n\u012bf is a composed song form, usually in 3/4 or 6/8 meter, performed by a vocal soloist and accompanied by one or more instruments. ... The ta\u1e63n\u012bf that is now part of a dastg\u0101h performance can have a variety of forms) page 834 (ta\u1e63n\u012bf-ha: \"composed settings of classical, popular, or contemporary poems\") page 1093 (ta\u1e63n\u012bf: \"Vocal composition with a poetic text in Persian ... included at specified points in performances of classical music\")"}, "madsrdf:citationSource": "The Garland encyclopedia of world music. Vol. 6, The Middle East, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Iran. II. Classical traditions. 4. Composed music (\"20th-century performing practice of the 12 dastg\u0101hs [modes] led to the creation of a new genre of composed pieces by known authors ... In the main, there are four types of composed music. Three are purely instrumental: pishdar\u0101mad, reng, and ch\u0101h\u0101rmezr\u0101b. The fourth, the tasnif ... is a vocal genre. ... The tasnif is a vocal piece performed with instrumental accompaniment by a soloist or an ensemble. Its structure parallels that of the pishdar\u0101mad, but it usually comes towards the end of a dastg\u0101h, just before the reng. In modern times it is not uncommon for the same tasnif to open and close a performance. Tasnifs written in the early years of the 20th century have serious poetic content with a social and patriotic message ... In the 1930s and 40s most tasnifs were set to high-quality lyric verses by classical poets ... In the succeeding period of increased commercialization, tasnifs deteriorated in poetic and musical standard ... \")"}, "madsrdf:citationSource": "Grove music online, February 24, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ta\u1e63n\u012bf-ha"}}, {"@id": "_:nbd20dd4623b9498faf33f2f7af7e76d6b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ta\u1e63n\u012bf-ha"}}], "@id": "/authorities/genreForms/gf2020026037"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026038", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBeast epics", "identifiers:lccn": "gf2020026038", "madsrdf:adminMetadata": [{"@id": "_:n7962a19d58574cd3ba3f1b6261593681b1"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Beast epics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7962a19d58574cd3ba3f1b6261593681b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026448"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026525"}], "madsrdf:hasSource": [{"@id": "_:n7962a19d58574cd3ba3f1b6261593681b5"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b6"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b7"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b8"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b9"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b10"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b11"}], "madsrdf:hasVariant": [{"@id": "_:n7962a19d58574cd3ba3f1b6261593681b12"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b15"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-13T13:46:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Beast epics"}}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(beast epic: a long verse narrative in which the misadventures of animals satirize human foibles and follies)"}, "madsrdf:citationSource": "Dictionary.com, Feb. 27, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 69 (There are three distinct genres of beast fable. A beast or animal fable proper--sometimes referred to as an apologue--is a short narrative in verse or prose using animals as the main characters and concluding with an explicitly defined moral relating to the human characteristics displayed by the animals. A second type of story, the beast or animal epic, is a variant of the beast fable. The main difference between the beast fable and the beast epic is that the focus of the beast epic is upon its narrative, whereas the focus of the beast fable is upon didacticism: the fable is used to teach something, sometimes about the animal, but usually about humans. The beast epic's narrative is usually much more developed than the beast fable's narrative, as are the characters.)"}, "madsrdf:citationSource": "A companion to Old and Middle English literature, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beast Epic. A medieval literary form consisting of a series of linked stories grouped around animal characters and often presenting satirical comment on the church or court by means of human qualities attributed to beast characters; oldest example known seems to be that of Paulus Diaconus, late in the eighth century; in the twelfth and thirteen centuries the beast epics were very popular in northern France, western Germany, and Flanders; various forms of the beast epic have one episode generally treated as the nucleus for the story, such as the healing of the sick lion by the fox's prescription that he wrap himself in the wolf's skin; some of the other animals common to the form, besides Reynard the Fox, the lion and the wolf, are the cock (Chanticleer), the cat, the hare, the came, the ant, the bear, the badger, and the stag. The best known of the beast epics, and the most influential, is the Roman de Renart, a poem of thirty thousand lines comprising twenty-seven sets of \"branches\" of stories)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, \u00a92009", "madsrdf:citationStatus": "found"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(beast epic: A series of stories popular during the Middle Ages in which the characters are animals with human qualities, usually written in the form of an allegory satirizing the Catholic Church, the royal court, or some other powerful person, group, or institution (example: Pierre de Saint-Cloud's 12th-century Roman de Renart). A more recent example is George Orwell's Animal Farm (1945), written in the same tradition)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS: online dictionary for library and information science, viewed Feb. 27, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beast epic, popular genre in various literatures, consisting of a lengthy cycle of animal tales that provides a satiric commentary on human society. Although individual episodes may be drawn from fables, the beast epic differs from the fable not only in length but also in putting less emphasis on a moral. The earliest European beast epics were in Latin, but vernacular epics in French, German, and Dutch existed in the late Middle Ages. Among the most famous are the 10th- and 11th-century cycles in which the hero is Reynard the Fox)"}, "madsrdf:citationSource": "Britannica online, Feb. 27, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 15 (the work is clearly a satire) p. 20 (Medieval literature abounds in stories about animals, of which there are two main, easily distinguished varieties: animal fables and beast epic; Animal fables ... are small narratives in which animals act and speak, with even smaller morals tacked on at the end of the little stories; Beast epic, by contrast, is a group of interconnected narratives, set in the court of the lion; its single hero is Reynard the Fox. Beast epic presents narratives of dark but vital humor that repeat the same narrative with many variations)"}, "madsrdf:citationSource": "Work cat.: Reynard the Fox : a new translation, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(beast epic: a poem with epic conventions in which animals speak and act like human beings)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Feb. 27, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7962a19d58574cd3ba3f1b6261593681b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Animal epics"}}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Animal epics"}}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7962a19d58574cd3ba3f1b6261593681b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epics, Beast"}}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epics, Beast"}}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7962a19d58574cd3ba3f1b6261593681b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epics, Animal"}}, {"@id": "_:n7962a19d58574cd3ba3f1b6261593681b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epics, Animal"}}], "@id": "/authorities/genreForms/gf2020026038"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026039", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLilit", "identifiers:lccn": "gf2020026039", "madsrdf:adminMetadata": [{"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b1"}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lilit"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b5"}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b6"}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b7"}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b8"}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-13T13:46:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lilit"}}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 299 (Lilit is a type of verse comprised of a mixture of khlong and rai poetic forms)"}, "madsrdf:citationSource": "Wannakhad\u012b \u02bbaphith\u0101n, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Lilit (a form of Thai poetry; an alternating Raay and Kloang verse; usually the Raay is used to describe the action and the Kloang is the dialogue; it is stanzaic, alternating Raay couplets with Kloang quatrains; syllabic, the couplets are 5 syllable lines and the quatrains are L1-L3 7 syllable lines and L4 is a 9 syllable line; couplets composed with a chain, linking the lines of the couplet and linking the stanzas; rhymed, composed with cross, interlaced and end rhyme)"}, "madsrdf:citationSource": [{"@id": "http://poetscollective.org/poetryforms/lilit/"}, "Poetry forms, on Poets collective website, Feb. 27, 2020:"], "madsrdf:citationStatus": "found"}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lilit-style verse about barge and land processions during a Khatina ceremony in Thailand)"}, "madsrdf:citationSource": "Work cat.: Param\u0101nuchit Chin\u014drot. Lilit krab\u016ban h\u01e3 phrakathin phayuhay\u0101ttr\u0101 th\u0101ng sathonlam\u0101k l\u00e6 chonlam\u0101k, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Thai poetry (A composition consisting of rai alternating with (and ending with) khlong is known as lilit)"}, "madsrdf:citationSource": "Wikipedia, Feb. 27, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5147811b9df489dbd0ab6a33fbaae51b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Thailand, Poetry of: lilit, a combination of r\u0101\u012b and khl\u014dng)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, \u00a92012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2020026039"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026040", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNirat", "identifiers:lccn": "gf2020026040", "madsrdf:adminMetadata": [{"@id": "_:n8df3104d68184d9285d2d16e646491f9b1"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nirat"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8df3104d68184d9285d2d16e646491f9b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026419"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026132"}], "madsrdf:hasSource": [{"@id": "_:n8df3104d68184d9285d2d16e646491f9b5"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b6"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b7"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b8"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b9"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-08-17T13:54:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-02-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nirat"}}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Thai literature: nirat poems--a genre characterized by the themes of journeying, separation, and love-longing)"}, "madsrdf:citationSource": "Britannica online, Feb. 28, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 15 (In this nirat, the poet narrates his lovelorn feelings for his lover, who he had left suddenly without bidding farewell. He describes beautiful landscapes, ways of life, history, and arts and culture of the places he travels through with a sense of humor)"}, "madsrdf:citationSource": "Work cat.: Suntho\u031c\u0304n Ph\u016b. Nir\u0101t M\u01b0\u0304ang Kl\u01e3ng, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Thai literature (The nirat [in Thai script: nir\u0101t] is a lyrical genre, popular in Thai literature, which can be translated as 'farewell poetry'. The core of the poetry is a travel description, but essential is the longing for the absent lover. The poet describes his journey through landscapes, towns, and villages, but he regularly interrupts his description to express his feelings for and thoughts of the abandoned lover. Nirat poetry probably originated from the Northern Thai people)"}, "madsrdf:citationSource": "Wikipedia, Feb. 28, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 15 (In Thai literary tradition the term 'Nirat' is clearly associated with a kind of love poem--a lamentation of love when the poet is on a journey and separated from his beloved. The essence of Nirat lies in the charm of the expression of longing and desire and in the descriptions of places and people) p. 19 (three Nirat; three modern Nirat; the Nirat form)"}, "madsrdf:citationSource": "Journal of the Siam Society, v. 88 (2000):", "madsrdf:citationStatus": "found"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Thai poetry: A favorite poetic form, almost always a love poem, is the nirat, meaning \"separation.\" It sings of the charms of the loved one the poet has left behind. As he progresses on his journey, he relates what he sees to memories he holds dear. In a sense, the nirat is a series of travel notes to one's beloved, interspersed with comments about her)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, 1965", "madsrdf:citationStatus": "found"}, {"@id": "_:n8df3104d68184d9285d2d16e646491f9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 33 (the literary genre known as nirat; Nirat are long, reflective and lyrical poems written in khlong verse form. In nirat poetry, the poet, who is usually away on a journey or in exile, expresses his longing for his beloved and how the scenery and incidents encountered on his journey remind him of the happy times when he was with his love. The nirat genre has continued to this day, adapting to modern circumstances and often relating journeys abroad)"}, "madsrdf:citationSource": "South-East Asia : languages and literatures, a select guide, 1989:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2020026040"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026044", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHigh interest-low vocabulary books", "identifiers:lccn": "gf2020026044", "madsrdf:adminMetadata": [{"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab1"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "High interest-low vocabulary books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026160"}, "madsrdf:hasSource": [{"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab5"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab6"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab7"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab8"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab9"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab10"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab11"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab12"}], "madsrdf:hasVariant": [{"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab13"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab16"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab19"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab22"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-06-17T13:41:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "High interest-low vocabulary books"}}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 65 (High-interest, low readability books, known as \"hi-lo\" books, combine engaging, age-appropriate content with texts written at a lower reading level to interest struggling readers. Hi-lo books are highly readable, with controlled vocabularies, simple sentences, and shorter page counts and chapters)"}, "madsrdf:citationSource": "School library journal, Feb. 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"hi-lo books\" (\"hi\" stands for \"high interest,\" \"lo\" stands for \"low readability,\" \"low vocabulary,\" or \"lower reading level\") specifically geared to encourage reading. Hi-lo books and reading lists focus on titles that engage readers' interest level but are written at a lower reading level)"}, "madsrdf:citationSource": "Kennedy, E. High interest-low reading level books for reluctant readers, via ThoughtCo. website, updated Jan. 9, 2020, viewed on Mar. 23, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Mar. 23, 2020", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(series: Rapid reads)"}, "madsrdf:citationSource": "Work cat.: Anderson-Dargatz, G. Playing with fire, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hi-Lo books (high interest/low readability; Hi-Lo books can motivate struggling readers by providing books on topics that are engaging that are also targeted toward their independent reading level. Hi-Lo books can help build reading fluency, vocabulary, background knowledge, and interest in reading)"}, "madsrdf:citationSource": "Hi-Lo books for struggling or reluctant readers, via Homeschooling with dyslexia website, Mar. 23, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Books > Hi-lo books > Playing with fire (A hi-lo book for adults working to improve literacy skills, or for readers who just want a quick read)"}, "madsrdf:citationSource": "Gail Anderson-Dargatz website, Mar. 23, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab11", "@type": "madsrdf:Source", "madsrdf:citationSource": [{"@id": "https://seattle.bibliocommons.com/list/share/72464741/100345981"}, "ALSC hi-lo books for upper elementary grades, via Seattle Public Library website, viewed Mar. 23, 2020"], "madsrdf:citationStatus": "found"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(High Interest Low Vocabulary Books. Scope Note: Books designed to interest learners whose reading abilities are below age or grade level. BT Books. RT Instructional Materials; Readability; Reading Materials; Remedial Reading; Supplementary Reading Materials)"}, "madsrdf:citationSource": "ERIC thesaurus, via WWW, Mar. 23, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hi-lo books"}}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hi-lo books"}}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "High interest-lower reading level books"}}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "High interest-lower reading level books"}}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "High interest-low reading level books"}}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "High interest-low reading level books"}}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Low vocabulary-high interest books"}}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Low vocabulary-high interest books"}}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "High-low books"}}, {"@id": "_:n4ac92e0c618d4f7baa3b1cf30bf1042ab26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "High-low books"}}], "@id": "/authorities/genreForms/gf2020026044"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026047", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aErotic periodicals", "identifiers:lccn": "gf2020026047", "madsrdf:adminMetadata": [{"@id": "_:n064078fcab1b488a8552b340ad71e0c0b1"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Erotic periodicals"}, "madsrdf:elementList": {"@list": [{"@id": "_:n064078fcab1b488a8552b340ad71e0c0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026139"}, "madsrdf:hasSource": [{"@id": "_:n064078fcab1b488a8552b340ad71e0c0b5"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b6"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b7"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b8"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b9"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b10"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b11"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b12"}], "madsrdf:hasVariant": [{"@id": "_:n064078fcab1b488a8552b340ad71e0c0b13"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b16"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b19"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-06-17T13:41:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-04-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Erotic periodicals"}}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection also contains erotic magazines, literature and motion pictures)"}, "madsrdf:citationSource": "Work cat.: Harbaugh, C.J. Charles J. Harbaugh papers, 1950-1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sex-oriented periodicals. UF Sexually oriented periodicals. BT Periodicals. NT Girlie magazines)"}, "madsrdf:citationSource": "LCSH, Apr. 10, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dirty mags)"}, "madsrdf:citationSource": "Drake, K. Best independent erotic magazines right now (NSFW), via Stack magazines website, Feb. 2020, viewed Apr. 10, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In the last decade, stacks of new erotic independent magazines have been finding their way to bedside tables, with the aim to inspire exploration and orientation, as well as titillation. A title like Math has a feminist and progressive focus, Extra Extra from Amsterdam blends erotica with contemporary art, and Fluffer Everyday from Greece wants to excite readers through the ordinary. Other titles of note are Baroness, which brands itself as erotica for women, and the queer feminist zine Salacious from the U.S., which presents and explores desire and sexuality through comics, with an emphasis on inclusivity.)"}, "madsrdf:citationSource": "Morley, M. Hot stuff: how these new erotic magazines are using design to excite, entice + subvert, via AIGA Eye on design website, Feb. 14, 2018, viewed Apr. 10, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Jatkola, B.L. Violence against women in five erotic magazines, 1981.", "madsrdf:citationStatus": "found"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(periodical titles: Adonis male erotica magazine; Australasian sexpaper; Black sex mates; Black sexations; Erotic lingerie; Erotica magazine; Experience readers' erotic letters; Hustler's barely legal : a celebration of sexual debutantes; Magazin Snob : (one of) the best erotic magazine(s) in the world; Playboy; Playgirl; Ripe erotica magazine; Screw; Screw : Australia's national adult weekly; Sex files; Sex weekly : an erotic periodical; Whap! : women who administer punishment)"}, "madsrdf:citationSource": "OCLC, Apr. 10, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(erotica magazines)"}, "madsrdf:citationSource": "Muroyama, M. The top 10 erotic magazines you need to checkout, via Baron website, 12 Feb. 2016, viewed Apr. 10, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sex magazines in the library collection, \u00a91981.", "madsrdf:citationStatus": "found"}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n064078fcab1b488a8552b340ad71e0c0b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sexually oriented periodicals"}}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sexually oriented periodicals"}}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n064078fcab1b488a8552b340ad71e0c0b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sex-oriented periodicals"}}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sex-oriented periodicals"}}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n064078fcab1b488a8552b340ad71e0c0b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Erotica periodicals"}}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Erotica periodicals"}}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n064078fcab1b488a8552b340ad71e0c0b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sex periodicals"}}, {"@id": "_:n064078fcab1b488a8552b340ad71e0c0b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sex periodicals"}}], "@id": "/authorities/genreForms/gf2020026047"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026048", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aUK garage (Music)", "identifiers:lccn": "gf2020026048", "madsrdf:adminMetadata": [{"@id": "_:n069df46c657e4536ac7d5be340a0853eb1"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "UK garage (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n069df46c657e4536ac7d5be340a0853eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153"}, "madsrdf:hasSource": [{"@id": "_:n069df46c657e4536ac7d5be340a0853eb5"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb6"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb7"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb8"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb9"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb10"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb11"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb12"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb13"}], "madsrdf:hasVariant": [{"@id": "_:n069df46c657e4536ac7d5be340a0853eb14"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-04-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-07-15T14:51:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "UK garage (Music)"}}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(UK garage is a much-loved genre of music in the United Kingdom and Ireland. Originating in the 1990s, it experienced mainstream success in the early 2000s, before returning to the underground in the mid-2000s; depends heavily on bass lines; the genre pioneered the use of unique bass lines, showing how they can uncharacteristically be used to evoke a range of emotional responses; was influenced and developed from pre-existing forms of dance music. The parents of UK garage are house music and jungle music; musically UK garage is soulful, yet fun at the same time. Unlike many forms of dance music, it does not take itself too seriously. Throughout the years, there have been a range of different styles within the genre)"}, "madsrdf:citationSource": "Top 10 best old-school UK garage songs, via Spinditty website, updated Sept. 7, 2015, viewed Apr. 28, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Garage (A form of 20th-century club dance music. As 'garage' rock, the term had earlier been used to denote movement primarily outside the commercial rock mainstream, predominantly in the USA and beginning in the 1960s, and with a philosophy somewhat akin to later Indie music. It originated at the Paradise Garage nightclub in New York City, from where the genre takes its name. Like house music, it was derived from and shares many of disco's characteristics, with simple, rigid 4/4 rhythm tracks and pulsating basslines (often influenced by dub reggae). However, while disco used large orchestras to add texture to the music, garage is nearly all electronic. It is slower than house, with 115-20 beats per minute as opposed to 122-6, and, in contrast to the more rhythmic arrangements found in more generic house music, is smoother, more melodic and frequently contains a female soul vocal. Early garage records included D-Train's You're the One for Me and the Peech Boys' Don't Make Me Wait (both 1981). By the late both 1990s, it found a new popularity in the UK as 'speed garage', sometimes inappropriately called 'underground garage', which increased the tempo to that of house, and became the dominating club sound for several years)"}, "madsrdf:citationSource": "Grove music online, Apr. 28, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(UK garage; its offspring genres like grime, dubstep, UK funky and bassline; heavily influenced by slightly faster, tougher bassline focused sounds; new generation of electronic music, one that seemed to perfectly fuse dance and urban bass-driven sounds)"}, "madsrdf:citationSource": "Moll, H. UK garage: the 40 best tracks of 1995 to 2005, via Mixmag website, Mar. 15, 2019, viewed Apr. 28, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(UK garage (also known as UKG) is a genre of electronic music originating from England in the early 1990s. The genre usually features a distinctive syncopated 4/4 percussive rhythm with 'shuffling' hi-hats and beat-skipping kick drums. Garage tracks also commonly feature 'chopped up' and time-shifted or pitch-shifted vocal samples complementing the underlying rhythmic structure at a tempo usually around 128 to 140 BPM. UK garage was largely subsumed into other styles of music and production in the mid-2000s, including dubstep, bassline and grime. The decline of UK garage during the mid-2000s saw the birth of UK funky, which is closely related)"}, "madsrdf:citationSource": "UK garage music, via Discogs website, Apr. 28, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: So Solid Crew (Musical group). London's UK garage mafia, \u21172001.", "madsrdf:citationStatus": "found"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Garage music genre overview (By 1996, a British variant of garage had emerged, dubbed speed garage (and later 2-step) for its aggressive synthesis of drum'n'bass and ragga with the original garage sound)"}, "madsrdf:citationSource": "AllMusic website, Apr. 28, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "The 31 best UK garage songs ever, via Billboard website, Nov. 22, 2016, viewed Apr. 28, 2020.", "madsrdf:citationStatus": "found"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(UK garage (also known as UKG or speed garage) is an umbrella term that refers to several different varieties of modern electronic dance music generally connected to the evolution of garage house and the popularity of jungle in the United Kingdom during the mid-1990s. A variation of the genre, 2-step, will seed the germination of grime in East London a decade later. Related to: 2-step; dubstep; future garage; electronic; house; 2-step garage) Artists like The Artful Dodger, Double 99, Grant Nelson, So Solid Crew, Heartless Crew, The Streets, Shanks & Bigfoot, Craig David, DJ Luck & MC Neat, Sweet Female Attitude, Sunship (Ceri Evans), Oxide and Neutrino, and numerous others have made the mainstream in the UK, whilst Dizzee Rascal's and Wiley's arrival in the mid-2000s raised the profile of grime)"}, "madsrdf:citationSource": "Uk garage music, via last.fm website, Apr. 28, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(UK garage; artists like Dizzee Rascal, Burial, Wiley, The Streets, Ms Dynamite; The family tree of UKG's sub-genres is an absolutely fascinating piece of modern music history. In 20 years it has either directly created or influenced: 2step, Speed Garage, Dubstep, Bassline, Grime, UK Funky and not to mention all the other genres it influenced outside of the Garage spectrum)"}, "madsrdf:citationSource": "UK garage history & family tree : 20 years of UKG!, via WWW, viewed Apr. 28, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n069df46c657e4536ac7d5be340a0853eb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "UKG (Music)"}}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "UKG (Music)"}}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n069df46c657e4536ac7d5be340a0853eb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Speed garage (Music)"}}, {"@id": "_:n069df46c657e4536ac7d5be340a0853eb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Speed garage (Music)"}}], "@id": "/authorities/genreForms/gf2020026048"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026050", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChristian fiction", "identifiers:lccn": "gf2020026050", "madsrdf:adminMetadata": [{"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb1"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Christian fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026502"}, "madsrdf:hasSource": [{"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb5"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb6"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb7"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb8"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb9"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb10"}], "madsrdf:hasVariant": {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that promotes Christian teachings or exemplifies a Christian way of life."}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ncu"}, "ri:recordStatus": "new"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-11-13T13:45:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Christian fiction"}}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Oxford dictionary of literary terms, 2015", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Christian fiction: Use for works of imaginative fiction that promote Christian teachings or exemplify a Christian way of life)"}, "madsrdf:citationSource": "GSAFD, May 1, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Christian fiction; UF Christian stories)"}, "madsrdf:citationSource": "LCSH, May 1, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subject heading: Christian life--Fiction; plot is about four women and their relationships with Christianity)"}, "madsrdf:citationSource": "Work cat: Desperate decisions, \u00a92010", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(in article \"Christian Fiction Keeps Its Allure\": Publishing Christian fiction can pay, and pay big, but it's harder than ever to succeed in the category; lists publishing imprints such as Bethany House, Chosen, FaithWords, Thomas Nelson, and Zondervan that focus on Christian fiction)"}, "madsrdf:citationSource": "Publishers weekly WWW site, May 1, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "preface (\"Christian\" does not designate any particular denomination or style of writing, but rather a worldview, a set of assumptions, often left unexpressed, but nonetheless apparent in the work of the writer)"}, "madsrdf:citationSource": "Encyclopedia of contemporary Christian fiction, \u00a92009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Christian stories"}}, {"@id": "_:n9a258cd25c704d279d76a892c28bfbfdb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Christian stories"}}], "@id": "/authorities/genreForms/gf2020026050"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026051", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBody horror films", "identifiers:lccn": "gf2020026051", "madsrdf:adminMetadata": [{"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b1"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Body horror films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026321"}, "madsrdf:hasSource": [{"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b5"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b6"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b7"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b8"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b9"}], "madsrdf:hasVariant": {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-07-15T14:51:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Body horror films"}}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Horror films: Body Horror (Body-Horror Films); relies on the destruction of the body for shock effect. In this kind of horror, bodies or parts of the body explode, ooze, are crushed, or melt away on-screen. Otherwise, the body may be made to burst open so as to allow some supernatural form or an alien's offspring to shoot out or crawl nauseatingly into view, or the body may be subjected to some vile and gory surgical experiment. Examples: Carne per Frankenstein (1973); The Manitou (1977); The Evil Dead (1980); The Beast Within (1981); Re-Animator (1985); The Fly (1986); The Fly II (1989))"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Seth Brundle develops a system to transport objects in a matter of seconds, but when he tries it on himself, Seth's genes and molecules are accidentally fused with those of a fly. Seth's excitement over his new physical abilities turns into a nightmare as his insect half begins to take over)"}, "madsrdf:citationSource": "Work cat.: Fly (Motion picture : 1986). The fly, \u00a92005", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Body horror movies might make up one of cinema's more disgusting film genres, but they've unquestionably given cinema some of its most wholly original masters. For instance, where would David Cronenberg and David Lynch be without their breakthrough body horror entries?; Eraserhead (David Lynch, 1978); Tetsuo: The Iron Man (Shinya Tsukamoto, 1989); Teeth (Mitchell Lichtenstein, 2007); Videodrome (David Cronenberg, 1983); Slither (James Gunn, 2008); The Fly (David Cronenberg, 1986); Raw (Julia Ducournau, 2016); Re-Animator (Stuart Gordon, 1985); The Thing (John Carpenter, 1982); The Brood (David Cronenberg, 1979))"}, "madsrdf:citationSource": "Sharf, Z. The 10 Best Body Horror Movies Ever Made, From \"The Fly\" to \"Teeth\", via IndieWire website, Oct 25, 2019, viewed May 6, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Body horror (Body horror or biological horror is a subgenre of horror that intentionally showcases graphic or psychologically disturbing violations of the human body. These violations may manifest through aberrant sex, mutations, mutilation, zombification, gratuitous violence, disease, or unnatural movements of the body. Body horror was a description originally applied to an emerging subgenre of North American horror films; Canadian filmmaker David Cronenberg is considered a principal originator of body horror through early films such as Shivers and Rabid, and his remake of The Fly. The body horror genre is widely represented throughout Japanese horror and within contemporary media, such as anime)"}, "madsrdf:citationSource": "Wikipedia, May 6, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Herbert West has a very good head on his shoulders ... and another one in a dish on his desk!)"}, "madsrdf:citationSource": "Re-animator (Motion picture : 1985). H.P. Lovecraft's Re-animator, \u00a92007", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biological horror films"}}, {"@id": "_:nfd7b2a020cc44ae8a0288a15ea8bac39b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biological horror films"}}], "@id": "/authorities/genreForms/gf2020026051"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026052", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEaster poetry", "identifiers:lccn": "gf2020026052", "madsrdf:adminMetadata": [{"@id": "_:nc47c0f62e4914c25bff93e6f9ccd31a5b1"}, {"@id": "_:nc47c0f62e4914c25bff93e6f9ccd31a5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Easter poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc47c0f62e4914c25bff93e6f9ccd31a5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nc47c0f62e4914c25bff93e6f9ccd31a5b5"}, {"@id": "_:nc47c0f62e4914c25bff93e6f9ccd31a5b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc47c0f62e4914c25bff93e6f9ccd31a5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-07-15T14:51:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc47c0f62e4914c25bff93e6f9ccd31a5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ncu"}, "ri:recordStatus": "new"}, {"@id": "_:nc47c0f62e4914c25bff93e6f9ccd31a5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Easter poetry"}}, {"@id": "_:nc47c0f62e4914c25bff93e6f9ccd31a5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Easter--Poetry)"}, "madsrdf:citationSource": "LCSH, May 7, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:nc47c0f62e4914c25bff93e6f9ccd31a5b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Bradlee, C. D. Easter poem, between 1874 and 1882.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2020026052"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026053", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBody horror television programs", "identifiers:lccn": "gf2020026053", "madsrdf:adminMetadata": [{"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b1"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Body horror television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026323"}, "madsrdf:hasSource": [{"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b5"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b6"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b7"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b8"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b9"}], "madsrdf:hasVariant": {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-07-15T14:51:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Body horror television programs"}}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Originally produced as a made-for-TV film in 1993; contents: The gas station / director, John Carpenter -- Hair / director, John Carpenter -- The eye / director, Tobe Hooper; summary: A horror film composed of three tales, the first about a serial killer, the second about a hair transplant that goes wrong and the third about a baseball player)"}, "madsrdf:citationSource": "Work cat.: Bpdy bags, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Horror films: Body Horror (Body-Horror Films); relies on the destruction of the body for shock effect. In this kind of horror, bodies or parts of the body explode, ooze, are crushed, or melt away on-screen. Otherwise, the body may be made to burst open so as to allow some supernatural form or an alien's offspring to shoot out or crawl nauseatingly into view, or the body may be subjected to some vile and gory surgical experiment)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Body horror (Body horror or biological horror is a subgenre of horror that intentionally showcases graphic or psychologically disturbing violations of the human body. These violations may manifest through aberrant sex, mutations, mutilation, zombification, gratuitous violence, disease, or unnatural movements of the body. Body horror was a description originally applied to an emerging subgenre of North American horror films; Canadian filmmaker David Cronenberg is considered a principal originator of body horror through early films such as Shivers and Rabid, and his remake of The Fly. The body horror genre is widely represented throughout Japanese horror and within contemporary media, such as anime)"}, "madsrdf:citationSource": "Wikipedia, May 6, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Body Bags (1993 TV Movie); Three short stories in the horror genre: the first about a serial killer, the second about a hair transplant gone wrong, and the third about a baseball player)"}, "madsrdf:citationSource": "Most popular body horror movies and TV shows, via IMDb website, May 8, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(any form of horror or squickiness involving body parts, parasitism, disfigurement, mutation, or unsettling bodily configuration, not induced by immediate violence)"}, "madsrdf:citationSource": "Body horror, via TV tropes website, May 6, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biological horror television programs"}}, {"@id": "_:n284012f3b3a3451fa349d6b21f6531b5b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biological horror television programs"}}], "@id": "/authorities/genreForms/gf2020026053"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026054", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKoridos", "identifiers:lccn": "gf2020026054", "madsrdf:adminMetadata": [{"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b1"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Koridos"}, "madsrdf:elementList": {"@list": [{"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b5"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b6"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b7"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b8"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b9"}], "madsrdf:hasVariant": [{"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b10"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-07-15T14:51:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Koridos"}}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xiii (awits and corridos, verse narratives on chivalric-heroic, religious, and legendary themes) p. xv (It is not known exactly how and when metrical romances were introduced into the Philippines; before the coming of the Spaniards, the Tagalogs did not seem to have any idea of metrical romance) p. xvi (it is fairly certain that they were already being written during the second half of the eighteenth century) p. xvii (During the 19th and well into the 20th century, the awits and corridos held undisputed sway) p. xxiii (At the present time, awits and corridos are generally read, but there is evidence that they were once also sung, chanted, or at least recited) pp. xxiv-xxv (Philippine metrical romances use a uniform stanza pattern, the quatrain, which may employ eight-syllable or twelve-syllable lines. In Tagalog, romances written in eight-syllable quatrains are called corridos and those in twleve-syllable quatrains awits; some literary historians and critics distinguish them further: awits are chivalric-heroic poems and corridos are legendary and religious poems; corridos were drawn from fantastic and legendary themes belonging to Europe and introduced by the Spaniards; the corrido is based on an existing tale or legend from European countries; the awit, a story fabricated from the imagination of the writer although the setting and characters are still ostensibly European; none of these secondary distinctions are borne out by this study except the distinction in terms of musical setting; the romances written in octosyllabic lines read at a faster tempo than those in dodecasyllabic lines; the difference in syllabic count seems to be the only valid distinction and is strictly observed in Tagalog romances)"}, "madsrdf:citationSource": "Eugenio, D.L. Awit and corrido : Philippine metrical romances, 1987:", "madsrdf:citationStatus": "found"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Philippines (The singing of epics is found in all layers of Filipino culture ... Epic singing may also be related to pasyon, a chanted narrative of the Passion and other biblical events sung during Lent, and to metrical romances, including the duodecasyllabic line awit and octosyllabic corrido)"}, "madsrdf:citationSource": "Brandon, J. R. The Cambridge guide to Asian theatre, 2000, viewed online through Credo Reference, June 3, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(romantic narratives in stanzaic verse, which is of two types--quatrains of twelve-syllable lines in assonance, and quatrains of eight-syllable lines in assonance; common generic name for the type of stories we are accustomed to term in English \"metrical romances\" is corrido; in Tagalog the term, if strictly used, is applied only to poems written in octosyllabic lines; Philippine corridos vary in length from a few hundred to several thousand lines)"}, "madsrdf:citationSource": "Fansler, D.S. Metrical romances in the Philippines, via WWW, May 18, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "awit (plural awits; a long metrical tale or romance written in a vernacular language of the Philippines during the period of Spanish control; similar to the korido, but showing less Spanish influence) korido (also spelled corrido; plural koridos; a long metrical tale or romance written in a vernacular language of the Philippines during the period of Spanish control; similar to the awit, but showing more Spanish influence)"}, "madsrdf:citationSource": "Macquarie dictionary, 2017, viewed online through Credo Reference, June 3, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(corrido in Tagalog)"}, "madsrdf:citationSource": "Work cat.: Corrido at Pinagdaanang buhay ng Prinsipe Baldovino, between 1900 and 1950", "madsrdf:citationStatus": "found"}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Corridos (Koridos)"}}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Corridos (Koridos)"}}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Awits"}}, {"@id": "_:n474f52f602934ee8bef6c8a4e35d3dc0b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Awits"}}], "@id": "/authorities/genreForms/gf2020026054"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026057", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSevdalinkas", "identifiers:lccn": "gf2020026057", "madsrdf:adminMetadata": [{"@id": "_:nc6ebac6f42394814ac4f000aed100804b1"}, {"@id": "_:nc6ebac6f42394814ac4f000aed100804b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sevdalinkas"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc6ebac6f42394814ac4f000aed100804b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026912"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nc6ebac6f42394814ac4f000aed100804b5"}, {"@id": "_:nc6ebac6f42394814ac4f000aed100804b6"}, {"@id": "_:nc6ebac6f42394814ac4f000aed100804b7"}], "madsrdf:hasVariant": {"@id": "_:nc6ebac6f42394814ac4f000aed100804b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc6ebac6f42394814ac4f000aed100804b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-12-20T10:32:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc6ebac6f42394814ac4f000aed100804b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-07-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc6ebac6f42394814ac4f000aed100804b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sevdalinkas"}}, {"@id": "_:nc6ebac6f42394814ac4f000aed100804b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 1057 (in the Glossary: \"sevdalinke 'Love songs' of urban Muslim culture in Bosnia-Hercegovina\")"}, "madsrdf:citationSource": "The Garland encyclopedia of world music, vol. 8, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6ebac6f42394814ac4f000aed100804b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (Live in Mostar : sevdah music from Bosnia and Herzegovina; [performed by the group] Divanhana) insert (\"Divanhana's intention is to present urban traditional music, not only from Bosnia and Herzegovina, but traditional music from the whole Balkan region, with a particular focus on sevdalinka\") (DLC)2020619833"}, "madsrdf:citationSource": "Work cat: Live in Mostar, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6ebac6f42394814ac4f000aed100804b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Bosnia and Herzegovina. II. Traditional music. 3. Urban vocal folk music (\"Urban traditions were shaped by a strong West Asian influence, city dwellers being 'open' to the East. In urban singing, we can distinguish between female and male songs. ... Still, the two have something in common: we recognize both as forms of sevdalinka, from the Turkish word sevdah, meaning passion, love, and amorous yearning. Both sing about love, though in different ways. Both are essentially songs of an intimate nature; are intended for performance in 'closed environments'; are dynamically of lower intensity (particularly compared to rural singing); and are traditionally performed by a single singer, with or without instrumental accompaniment (saz and, in more recent times, accordion), with the capacity to show individual expression and artistic acumen. Distinctive features of these songs include long phrases with a wide melodic range, a melismatic, highly ornamental vocal style, and a modal character related to the Turkish makam (pl. makamlar), including hid\u017eaz [hic\u00e2z], usak, and nahvan. In select cases, notably in makam hid\u017eaz, this results in the use of the interval of the augmented 2nd.\" Plural form: sevdalinke)"}, "madsrdf:citationSource": "Grove music online, July 1, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6ebac6f42394814ac4f000aed100804b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc6ebac6f42394814ac4f000aed100804b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sevdalinke"}}, {"@id": "_:nc6ebac6f42394814ac4f000aed100804b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sevdalinke"}}], "@id": "/authorities/genreForms/gf2020026057"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026058", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aYom Kippur poetry", "identifiers:lccn": "gf2020026058", "madsrdf:adminMetadata": [{"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b1"}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Yom Kippur poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026503"}, "madsrdf:hasSource": [{"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b5"}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b6"}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b7"}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b8"}], "madsrdf:hasVariant": [{"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b9"}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-09-04T13:09:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-07-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yom Kippur poetry"}}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Religious poetry in Ladino for Rosh Hashana and Yom Kippur, 1976.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Tfiles\u0300 poemes un gezangen far Yom Kiper, 1941.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "added t.p. (The \"Avoda\" for Yom Kippur : its characteristics, history and development in Hebrew poetry)"}, "madsrdf:citationSource": "Malachi, Z. ha-\u02bbAvodah le-Yom ha-Kipurim, 1973 or 1974:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free translation of Hebrew Rosh Hashana and Yom Kippur poems into Ladino)"}, "madsrdf:citationSource": "Work cat.: Israel, R.E. Traducsion libera de las poezias ebraicas de Ro\u015f A\u015fana i Kipur, 1910", "madsrdf:citationStatus": "found"}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yom ha-Kippurim poetry"}}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yom ha-Kippurim poetry"}}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Day of Atonement poetry"}}, {"@id": "_:nb96fbb6f522547fc99ccc4fbe7284f39b13", "@type": 