e": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a type of popular song)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ccc21bf890a4066a6c6cd9019bde841b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Yamaori, T. Enka to Nihonjin, c1984.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ccc21bf890a4066a6c6cd9019bde841b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kodansha encycl. of Japan", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026785"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026786", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEnsaladas", "identifiers:lccn": "gf2014026786", "madsrdf:adminMetadata": [{"@id": "_:n95f3be40d80340e9b125c883d04a10d8b1"}, {"@id": "_:n95f3be40d80340e9b125c883d04a10d8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ensaladas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n95f3be40d80340e9b125c883d04a10d8b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026984"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027028"}], "madsrdf:hasSource": [{"@id": "_:n95f3be40d80340e9b125c883d04a10d8b5"}, {"@id": "_:n95f3be40d80340e9b125c883d04a10d8b6"}, {"@id": "_:n95f3be40d80340e9b125c883d04a10d8b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n95f3be40d80340e9b125c883d04a10d8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n95f3be40d80340e9b125c883d04a10d8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n95f3be40d80340e9b125c883d04a10d8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ensaladas"}}, {"@id": "_:n95f3be40d80340e9b125c883d04a10d8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ensalada, Spanish compositions of the 16th century of a comic character which mix religious and secular styles, various meters, languages, dialects, and popular songs)"}, "madsrdf:citationSource": "Dicc. m\u00fas. labor, 1959", "madsrdf:citationStatus": "found"}, {"@id": "_:n95f3be40d80340e9b125c883d04a10d8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ensalada, a kind of quodlibet popular in 16th century Spain)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n95f3be40d80340e9b125c883d04a10d8b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 93722087: Flecha, M. La viuda, 1992.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026786"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026787", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEntrem\u00e9s (Music)", "identifiers:lccn": "gf2014026787", "madsrdf:adminMetadata": [{"@id": "_:n58232a5b9c334802893b80121b040904b1"}, {"@id": "_:n58232a5b9c334802893b80121b040904b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Entrem\u00e9s (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n58232a5b9c334802893b80121b040904b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026876"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027065"}, "madsrdf:hasSource": {"@id": "_:n58232a5b9c334802893b80121b040904b5"}, "madsrdf:hasVariant": {"@id": "_:n58232a5b9c334802893b80121b040904b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n58232a5b9c334802893b80121b040904b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n58232a5b9c334802893b80121b040904b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n58232a5b9c334802893b80121b040904b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Entrem\u00e9s (Music)"}}, {"@id": "_:n58232a5b9c334802893b80121b040904b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Entrem\u00e9s. A form of short Spanish scenic entertainment, usually comic, which flourished in the 17th century and was performed between the acts of a larger, more serious theatrical work. It was popular in character, and commonly called for instrumentally accompanied songs and dances, but the genre also attracted literary figures as eminent as Tirso de Molina and Quevedo)"}, "madsrdf:citationSource": "Grove music online, viewed August 23, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n58232a5b9c334802893b80121b040904b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n58232a5b9c334802893b80121b040904b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Entremets (Music)"}}, {"@id": "_:n58232a5b9c334802893b80121b040904b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Entremets (Music)"}}], "@id": "/authorities/genreForms/gf2014026787"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026788", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEnumerative songs", "identifiers:lccn": "gf2014026788", "madsrdf:adminMetadata": [{"@id": "_:nb30576d299fb4561ad974129d621be3cb1"}, {"@id": "_:nb30576d299fb4561ad974129d621be3cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Enumerative songs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb30576d299fb4561ad974129d621be3cb3"}]}, "madsrdf:exampleNote": "Note under [Cumulative songs]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, "madsrdf:hasSource": {"@id": "_:nb30576d299fb4561ad974129d621be3cb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Songs that repetitiously list a series of associated items, actions, or people. For songs that repetitiously list a series of associated items, actions, or people, in which each stanza incorporates the words from all previous stanzas in incremental fashion, see [Cumulative songs.]"}, {"@id": "_:nb30576d299fb4561ad974129d621be3cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb30576d299fb4561ad974129d621be3cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:43:33"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb30576d299fb4561ad974129d621be3cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Enumerative songs"}}, {"@id": "_:nb30576d299fb4561ad974129d621be3cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under France 4. Form and structure (...On the other hand, enumerative songs are common (Alouette, La Perdriolle), and a decreasing enumeration (generally from eight down to one) is often associated with dance-songs.)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026788"}
