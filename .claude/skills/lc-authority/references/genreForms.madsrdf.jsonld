", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Death registers"}}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(death registers. UF necrologies (death registers). BT death records. Official lists of recorded deaths, including details considered sufficiently important to be formally noted, and maintained in a regular manner for a community; typically including the names of the deceased, dates of death, living relatives, and often location and cause of death.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "research guides > deaths (death records; death register; \"Information in death records may include name, date and place of birth, cause of death, parent's names and birthplaces, spouse and burial location\")"}, "madsrdf:citationSource": "Utah State Archives research website, Aug. 1, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (\"This website is a directory of links to websites with online death indexes, listed by state and county. Included are death records, death certificate indexes, death notices and registers, obituaries, probate indexes, and cemetery and burial records.\")"}, "madsrdf:citationSource": "Online searchable death indexes & records, viewed Aug. 1, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c446d89b5bb4b989805705af862fcd3b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Death records"}}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Death records"}}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c446d89b5bb4b989805705af862fcd3b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Registers of deaths"}}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Registers of deaths"}}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c446d89b5bb4b989805705af862fcd3b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indexes, Death"}}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indexes, Death"}}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c446d89b5bb4b989805705af862fcd3b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Burial records"}}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Burial records"}}, {"@id": "_:n0c446d89b5bb4b989805705af862fcd3b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c446d89b5bb4b989805705af862fcd3b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Records, Death"}}, {"@id"