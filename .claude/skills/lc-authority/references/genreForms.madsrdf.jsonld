ype": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Corpora (Linguistics). UF Corpus-based analysis (Linguistics); Corpus linguistics. BT Linguistics analysis (Linguistics))"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n6eb6662a1676487fb4970ae6552d7a2ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Introduction page (This site contains downloadable, full-text corpus data from nine large corpora of English)"}, "madsrdf:citationSource": [{"@id": "https://www.corpusdata.org"}, "Full-text corpus data, online viewed July 8, 2019"], "madsrdf:citationStatus": "found"}, {"@id": "_:n6eb6662a1676487fb4970ae6552d7a2ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "LDC Catalog page (LDC's Catalog contains hundreds of data including corpora)"}, "madsrdf:citationSource": [{"@id": "https://catalog.ldc.upenn.edu/"}, "Linguistic Data Consortium, online, viewed June 18, 2019"], "madsrdf:citationStatus": "found"}, {"@id": "_:n6eb6662a1676487fb4970ae6552d7a2ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(corpus, corpora: A collection of LINGUISTIC DATA, either written texts or a TRANSCRIPTION of recorded speech, which can be used as a starting-point of linguistic description or as a means of verifying hypotheses about a LANGUAGE (corpus linguistics))"}, "madsrdf:citationSource": "Dictionary of Linguistics and Phonetics, online, viewed May 28, 2019", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026083"}
