fcaef453eb1f749718b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 13 (a musical genre)"}, "madsrdf:citationSource": "Work cat.: Roda de choro, jan/fev 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a967acb94924dfcaef453eb1f749718b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(choro; chorinho; Brazilian popular music developed in Rio de Janeiro ca. 1870; repertory consists of dances of European origin performed at popular festivities)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a967acb94924dfcaef453eb1f749718b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a967acb94924dfcaef453eb1f749718b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chorinhos"}}, {"@id": "_:n7a967acb94924dfcaef453eb1f749718b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chorinhos"}}], "@id": "/authorities/genreForms/gf2014026714"}
