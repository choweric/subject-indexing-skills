{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026749", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aZombie films", "identifiers:lccn": "gf2011026749", "madsrdf:adminMetadata": [{"@id": "_:nbda90709f5dd4a7c91755f95b99dc658b1"}, {"@id": "_:nbda90709f5dd4a7c91755f95b99dc658b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Zombie films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbda90709f5dd4a7c91755f95b99dc658b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026402"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026056"}], "madsrdf:hasSource": [{"@id": "_:nbda90709f5dd4a7c91755f95b99dc658b5"}, {"@id": "_:nbda90709f5dd4a7c91755f95b99dc658b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional films that feature the reanimation of corpses that prey on human beings.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025377"}}, {"@id": "_:nbda90709f5dd4a7c91755f95b99dc658b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nbda90709f5dd4a7c91755f95b99dc658b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nbda90709f5dd4a7c91755f95b99dc658b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zombie films"}}, {"@id": "_:nbda90709f5dd4a7c91755f95b99dc658b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Paranormal films. Films about the paranormal, purported phenomena described in popular culture, folk, and other non-scientific bodies of knowledge, whose existence within these contexts is described as beyond normal experience or scientific explanation; paranormal phenomena include extrasensory perception (ESP), telekinesis, ghosts, poltergeists, life after death, reincarnation, faith healing, human auras, and so forth)"}, "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nbda90709f5dd4a7c91755f95b99dc658b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Zombie movie; traditionally, zombies are corpses reanimated into a semblance of life by the magic of a voodoo priest. They are strong and powerful and obey unquestioningly their master's orders. At present, voodoo trappings are no longer necessary to awaken the dead; any supernatural or pseudo-scientific method will do.)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026749"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026750", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:naab738ca238d48fb9c781a7b4219402ab1"}, {"@id": "_:naab738ca238d48fb9c781a7b4219402ab2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is covered by the genre/form terms Swashbuckler films {(gf2011026628)} and Western films {(gf2011026735).}"}, "madsrdf:elementList": {"@list": [{"@id": "_:naab738ca238d48fb9c781a7b4219402ab3"}]}, "madsrdf:useInstead": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026628"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026735"}], "madsrdf:variantLabel": {"@language": "en", "@value": "Zorro films"}}, {"@id": "_:naab738ca238d48fb9c781a7b4219402ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:naab738ca238d48fb9c781a7b4219402ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-03-12T12:34:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:naab738ca238d48fb9c781a7b4219402ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zorro films"}}], "@id": "/authorities/genreForms/gf2011026750"}
