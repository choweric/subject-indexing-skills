"@type": "madsrdf:Source", "madsrdf:citationSource": "Arden, J. Two autobiographical plays, 1971.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e61cb7f8ead46a7bf65094216e1efa9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autobiographical drama. UF Autobiographical plays)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026230"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026231", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAutobiographical fiction", "identifiers:lccn": "gf2014026231", "madsrdf:adminMetadata": [{"@id": "_:n746a645a013c4ec187ea092cc5d73945b1"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Autobiographical fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n746a645a013c4ec187ea092cc5d73945b3"}]}, "madsrdf:exampleNote": "Note under [Fictional autobiographies]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026246"}, "madsrdf:hasSource": [{"@id": "_:n746a645a013c4ec187ea092cc5d73945b5"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b6"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b7"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b8"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b9"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b10"}], "madsrdf:hasVariant": [{"@id": "_:n746a645a013c4ec187ea092cc5d73945b11"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b14"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b17"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that is based on events in the author's life but employs fictional characters intermixed with fictional events. For works that present themselves as autobiographies but whose narrators and events are fictional see [Fictional autobiographies.]"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:13:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autobiographical fiction"}}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The I-novel: \"I-novel\" is an inexact translation from the Japanese of shish\u014dsetsu (alternately read watakushi sh\u014dsetsu). Shish\u014dsetsu, which can be translated more accurately as self-writing, denotes prose fiction of variable length believed to reflect authentically the private life of the author)"}, "madsrdf:citationSource": "Encyclopedia of life-writing, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autofiction: Autofiction is a homodiegetic narrative that declares itself to be fiction - by being called 'novel' on the front page, for example - but actually relates events of the author's own life and identifies the author in the text by his or her real name)"}, "madsrdf:citationSource": "Routledge encyclopedia of narrative theory, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autobiographical novel: In contrast with the pure autobiography, an autobiographical novel is a semi-fictional narrative based in part on the author's life experience, but these experiences are often transposed onto a fictional character or intermixed with fictional events. Examples include Thomas Wolfe's Look Homeward, Angel and James Joyce's Portrait of the Artist as a Young Man.)"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, April 17, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autobiographical fiction: Use for works in which the events in the writer's life slightly disguised are presented as fiction. Samuel Butler's The way of all flesh is an example of autobiographical fiction. UF Fiction, Autobiographical)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(autobiographical novel (often qualified as \"semi-autobiographical\" refers to a kind of novel, of a \"Bildungsroman\", in which the events, settings, and characters are based upon the author's own life.)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, c2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v.1 (Autobiographical novel: it is impossible to draw a clear line between autobiographical and nonautobiographical fiction. How much of the author's life should be present in a novel to qualify it as autobiographical? This essay will take a highly pragmatic approach to the term, applying it to novels that exhibit a significant and generally uncontested autobiographical presence.The distinction between autobiographical fiction and fictional autobiography is more straightforward. An autobiographical novel follows novelistic conventions but contains some material taken from the author's life. A fictional autobiography, such as Daniel Defoe's Moll Flanders (1722), is entirely fictional but observes the conventions of autobiography in its account of the life of the narrator)"}, "madsrdf:citationSource": "Encyclopedia of the novel, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n746a645a013c4ec187ea092cc5d73945b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Semiautobiographical fiction"}}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Semiautobiographical fiction"}}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n746a645a013c4ec187ea092cc5d73945b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Semi-autobiographical fiction"}}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Semi-autobiographical fiction"}}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n746a645a013c4ec187ea092cc5d73945b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autofiction"}}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autofiction"}}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n746a645a013c4ec187ea092cc5d73945b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autobiographic fiction"}}, {"@id": "_:n746a645a013c4ec187ea092cc5d73945b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autobiographic fiction"}}], "@id": "/authorities/genreForms/gf2014026231"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026232", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAutobiographical poetry", "identifiers:lccn": "gf2014026232", "madsrdf:adminMetadata": [{"@id": "_:n014cba11874b4550bea16a7e04f45996b1"}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Autobiographical poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n014cba11874b4550bea16a7e04f45996b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026047"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026247"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026272"}, "madsrdf:hasSource": [{"@id": "_:n014cba11874b4550bea16a7e04f45996b5"}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b6"}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b7"}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b8"}], "madsrdf:hasVariant": {"@id": "_:n014cba11874b4550bea16a7e04f45996b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-13T18:11:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autobiographical poetry"}}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 188 (The dominant mode of contemporary poetry is normally described as the autobiographical poetry of voice, an artifice of expression that depends heavily on its implicit claim to authenticity. Personal experience backs up what is said, and is often also the subject-matter. This poetry has become so widely promulgated that it is now the dominant paradigm for contemporary poetry, a success usually attributed to ideologies of individuality, especially the belief that selfhood inherits the voice.)"}, "madsrdf:citationSource": "Middleton, P. Literatures of memory, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autobiographical poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Confessional poetry: An autobiographical mode of verse that reveals the poet's personal problems with unusual frankness. That term and its cognate confessionalism are usually applied to certain poets of the United States from the late 1950s to the late 1960s, notably Robert Lowell. The term is sometimes used more loosely to refer to any personal or autobiographical poetry, but its distinctive sense depends on the candid examination of what were at the time of writing virtually unmentionable kinds of private distress.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "I sing the song of myself : an anthology of autobiographical poems, c1978.", "madsrdf:citationStatus": "found"}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n014cba11874b4550bea16a7e04f45996b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autobiographic poetry"}}, {"@id": "_:n014cba11874b4550bea16a7e04f45996b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autobiographic poetry"}}], "@id": "/authorities/genreForms/gf2014026232"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026233", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAutos sacramentales", "identifiers:lccn": "gf2014026233", "madsrdf:adminMetadata": [{"@id": "_:n4685786d51984e9788e12a7470a1b0ffb1"}, {"@id": "_:n4685786d51984e9788e12a7470a1b0ffb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Autos sacramentales"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4685786d51984e9788e12a7470a1b0ffb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026218"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026501"}], "madsrdf:hasSource": [{"@id": "_:n4685786d51984e9788e12a7470a1b0ffb5"}, {"@id": "_:n4685786d51984e9788e12a7470a1b0ffb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Spanish allegorical religious plays of the 16-18th centuries performed on the feast of Corpus Christi."}, {"@id": "_:n4685786d51984e9788e12a7470a1b0ffb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-15T09:06:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4685786d51984e9788e12a7470a1b0ffb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4685786d51984e9788e12a7470a1b0ffb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autos sacramentales"}}, {"@id": "_:n4685786d51984e9788e12a7470a1b0ffb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(auto sacramental (sacramental play). A type of drama performed in Spain on the feast of Corpus Christi from the 16th through the 18th centuries. The auto, a one-act drama, featured mythic, allegorical, or historical characters; the action concluded with the manifestation of a Communion host and chalice. The aim of many of the autos was to draw analogies between secular stories of love and adventure and the divine mystery of the Eucharist.)"}, "madsrdf:citationSource": "Quinn, E. A dict. of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n4685786d51984e9788e12a7470a1b0ffb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(auto sacramental (plural autos sacramentales). A Spanish form of allegorical religious play in one act performed at the feast of Corpus Christi between the 16th and 18th centuries. These were didactic plays on biblical or historical subjects, usually culminating in the display of a large host and chalice symbolizing the sacrament of the Eucharist; hence the term 'sacramental play')"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026233"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026234", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAzharot", "identifiers:lccn": "gf2014026234", "madsrdf:adminMetadata": [{"@id": "_:nb22068b32962468bab12246fc4b7a295b1"}, {"@id": "_:nb22068b32962468bab12246fc4b7a295b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Azharot"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb22068b32962468bab12246fc4b7a295b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026416"}, "madsrdf:hasSource": [{"@id": "_:nb22068b32962468bab12246fc4b7a295b5"}, {"@id": "_:nb22068b32962468bab12246fc4b7a295b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Hebrew liturgical poems on the 613 commandments."}, {"@id": "_:nb22068b32962468bab12246fc4b7a295b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:07:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb22068b32962468bab12246fc4b7a295b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb22068b32962468bab12246fc4b7a295b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Azharot"}}, {"@id": "_:nb22068b32962468bab12246fc4b7a295b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Azharot: Liturgical poems dealing with the enumeration and explanation of the 613 commandments (the numerical value of the word azharot in Hebrew is 613). These poems were called azharot after the initial word of an early composition of this nature dating from the geonic period. They were recited in the Shavu'ot liturgy, especially among Sephardim before Musaf)"}, "madsrdf:citationSource": "The Oxford dictionary of Jewish religion, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nb22068b32962468bab12246fc4b7a295b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Azharot)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026234"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026235", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBallades (Poetry)", "identifiers:lccn": "gf2014026235", "madsrdf:adminMetadata": [{"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b1"}, {"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ballades (Poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b5"}, {"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b6"}, {"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Old French poems consisting of three stanzas, followed by a four-line envoy."}, {"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:07:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ballades (Poetry)"}}, {"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ballade: One of the most popular artificial French verse forms. The ballade should not, however, be confused with the ballad. The ballade form has been rather liberally interpreted. Early usage most frequently demanded three stanzas and an envoy, though the number of lines per stanza and of syllables per line varied.)"}, "madsrdf:citationSource": "Harmon, J. A handbook to literature, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ballade: An OF verse form, particularly popular during the 14th and 15th c. The commonest type consists of three eight-line stanzas rhyming ababbcbe, with a four-line envoi rhyming bcbc. The last line of the first stanza serves as the refrain repeated in the last line of each stanza and of the envoi. Its rhyming complexity makes the ballade a difficult form)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms, 1982", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a10e42ce6bf4bbbbbde223d13bb5d40b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ballade: A fixed verse form derived from Old French poetry. In its most common form, the ballade consists of three stanzas and an envoy, a short concluding stanza often addressed to a person of importance. The meter is usually iambic or anapestic tetrameter, and the rhyme scheme is regularly ababbcbC in each of the octaves and bcbC in the envoy (Capital letters represent lines repeated as refrains)."}, "madsrdf:citationSource": "Beckson, K. Literary terms, 1989", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026235"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026236", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBathetic poetry", "identifiers:lccn": "gf2014026236", "madsrdf:adminMetadata": [{"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b1"}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bathetic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b5"}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b6"}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b7"}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b8"}], "madsrdf:hasVariant": {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Overtly sentimental or ludicrous poems that exhibit insincere pathos, triteness, or banality."}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:08:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bathetic poetry"}}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bathos: Excessive sentimentality or ludicrousness. Bathos is produced by an unsuccessful attempt to elicit pity or sorrow from the reader. Bathos also results when elevated language and style are used inappropriately in treating a commonplace subject)"}, "madsrdf:citationSource": "Morner, K. NTC's dictionary of literary terms, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(for a poem to be truly bad--to become a classic of the Bad Poetry genre--genuine feeling isn't quite enough; In fact, the canon of Bad Poetry is indistinguishable, in certain important ways, from great poetry: It, too, 'delights and instructs.')"}, "madsrdf:citationSource": "Chiasson, D. Bad to the bone : an anthology of verse offers up the banal, the bathetic, the bloated, via Slate website, viewed May 7, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(There is a fine collection of bathetic in The Stuffed Owl (1930, rev. ed. 1948), an anthology of bad verse selected by Wyndham Lewis)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bathos: A sudden and ridiculous descent from the exalted to the ordinary, especially when a writer, striving for the noble or pathetic, achieves the ludicrous)"}, "madsrdf:citationSource": "Beckson, K. Literary terms, 1989", "madsrdf:citationStatus": "found"}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bad poetry (Bathetic poetry)"}}, {"@id": "_:nc79ad9abcb0b42b9900b6ca65d628666b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bad poetry (Bathetic poetry)"}}], "@id": "/authorities/genreForms/gf2014026236"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026237", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBawdy plays", "identifiers:lccn": "gf2014026237", "madsrdf:adminMetadata": [{"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b1"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bawdy plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026526"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026319"}, "madsrdf:hasSource": [{"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b5"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b6"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b7"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b8"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b9"}], "madsrdf:hasVariant": [{"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b10"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b13"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comedic plays that are sexually indecent, coarse, or lewd."}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:08:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bawdy plays"}}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bawdy 1: : obscene, lewd; 2: boisterously or humorously indecent)"}, "madsrdf:citationSource": "Merriam-Webster online, Dec. 21, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The most popular types of Elizabethan plays were histories of England's rulers, but revenge dramas and bawdy comedies also drew significant crowds.)"}, "madsrdf:citationSource": "Elizabethan drama, via Enotes website, Dec. 21, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "([Aphra] Behn, known for her bawdy dramas and sex comedies--hallmarks of Restoration humor--consistently and openly pushed for female sexual agency.)"}, "madsrdf:citationSource": "Mann, R. Reading past culture through popular culture, 2009, via WWW, viewed Dec. 21, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Gallander, B. Dark ages romance : a contemporary sex comedy, 1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 114 (The court-centred theatres of the Restoration and late seventeenth century--with typically boisterous audiences, and repertoires rich in bawdy dramas--were hardly venues for teaching modern manners and ethics.)"}, "madsrdf:citationSource": "Goring, P. The rhetoric of sensibility in eighteenth-century culture, c2005, via Google books, viewed Dec. 21, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bawdy drama"}}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bawdy drama"}}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sex comedy plays"}}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sex comedy plays"}}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sex comedies (Drama)"}}, {"@id": "_:nc3969aa4ac964b4e8000a9f853d62801b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sex comedies (Drama)"}}], "@id": "/authorities/genreForms/gf2014026237"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026238", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBawdy poetry", "identifiers:lccn": "gf2014026238", "madsrdf:adminMetadata": [{"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b1"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bawdy poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026321"}, "madsrdf:hasSource": [{"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b5"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b6"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b7"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b8"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b9"}], "madsrdf:hasVariant": {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that are sexually indecent, coarse, or lewd."}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:08:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bawdy poetry"}}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bawdy poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lovers, rakes, and rogues : amatory, merry, and bawdy verse from 1580 to 1830, c1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Pushkin, A.S. Pushkin threefold : narrative, lyric, polemic, and ribald verse, 1972.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bawdy: 1. Obscene, lewd. 2. Boisterously or humorously indecent; ribald)"}, "madsrdf:citationSource": "Merriam-Webster online, Jan. 5, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bawdy verse: X-rated poetry written anonymously for the purpose of recital)"}, "madsrdf:citationSource": "Poetrysoup.com, Jan. 5, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ribald poetry"}}, {"@id": "_:n1826e703c29348e9abaf9de7dd90f2b5b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ribald poetry"}}], "@id": "/authorities/genreForms/gf2014026238"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026239", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBestiaries", "identifiers:lccn": "gf2014026239", "madsrdf:adminMetadata": [{"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb1"}, {"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bestiaries"}, "madsrdf:elementList": {"@list": [{"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026218"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}], "madsrdf:hasSource": [{"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb5"}, {"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb6"}, {"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb7"}, {"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Collections of medieval allegories featuring animals that were intended to teach Christian morals."}, {"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-31T10:15:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bestiaries"}}, {"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "bestiary (a medieval often illustrated work in verse or prose describing with an allegorical moralizing commentary the appearance and habits of real and fabled animals)"}, "madsrdf:citationSource": "Merriam Webster online, May 6, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 135 (bestiary: a medieval compilation in verse or prose in which the supposed characteristics of real and imaginary animals (or plants or stones) are allegorized for the purpose of moral or religious instruction)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 80 (bestiary: a medieval didactic genre in prose in which the behavior of animals (used in symbolic types) points a moral. The prototype is very probably the Greek Physiologus (2nd-4th c. A.D.), a compendium of some fifty fabulous anecdotes; The period of greatest popularity for bestiaries in Europe was from the 12th to the 14th c., especially in French. The development and combination of story and moral in the bestiaries had some influence on the evolution of the exemplum and the fable)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n15d1bb1499ec4e92a81d56e378b5322bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bestiary: literary genre in the European Middle Ages consisting of a collection of stories, each based on a description of certain qualities of an animal, plant, or even stone. The stories presented Christian allegories for moral and religious instruction and admonition)"}, "madsrdf:citationSource": "Britannica Academic Edition online, Feb. 10, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026239"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026240", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBible fiction", "identifiers:lccn": "gf2014026240", "madsrdf:adminMetadata": [{"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb1"}, {"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bible fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb3"}]}, "madsrdf:exampleNote": "Note under [Bible stories]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb5"}, {"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb6"}], "madsrdf:hasVariant": {"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Imaginative fiction in which characters and settings are taken from the Bible. For paraphrases of Biblical texts in story form see [Bible stories.]"}, {"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:14:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bible fiction"}}, {"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The term Bible fiction refers to works of fiction which use characters, settings and events taken from the Bible. The degree of fictionalisation in these works varies and, although they are often written by Christians or Jews, this is not always the case)"}, "madsrdf:citationSource": "Wikipedia, Oct. 31, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bible fiction: Use for works of imaginative fiction in which characters and settings are taken from the Bible; for example, Taylor Caldwell's I, Judas.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biblical fiction"}}, {"@id": "_:n28900c053ab74034adb3760ad9c2cf3cb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biblical fiction"}}], "@id": "/authorities/genreForms/gf2014026240"}
