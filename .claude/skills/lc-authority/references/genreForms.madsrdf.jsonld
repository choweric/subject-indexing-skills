srdf:citationNote": {"@language": "en", "@value": "(humor. UF humorous; humour; humourous. That quality in speech, writing, action, or situation that is amusing or appeals to a sense of what is absurdly incongruous, an oddity, jocular, facetious, comical, or fun.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n616ba613c64348a0b8386447ce6a018cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Humorous works (Gathering term; do not assign). Scope Note: Gathering term; do not use; index under a narrower term. BT Purpose of work (Gathering term; do not assign). NT Burlesques; Caricatures; Cartoons; Comedies; Comic books; Comic histories; Epigrams; Fabliaux; Facetiae; Jestbooks; Minstrel jokes; Nonsense verse; Parodies; Pastiches; Satires)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n616ba613c64348a0b8386447ce6a018cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(humor: A literary genre in which the author presents a story, poem, joke, etc., for the amusement of the reader.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n616ba613c64348a0b8386447ce6a018cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n616ba613c64348a0b8386447ce6a018cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wit and humor"}}, {"@id": "_:n616ba613c64348a0b8386447ce6a018cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wit and humor"}}, {"@id": "_:n616ba613c64348a0b8386447ce6a018cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id":