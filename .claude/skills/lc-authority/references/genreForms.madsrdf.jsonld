3455b95312b39dfc5173fb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCCN 92765385: Original piano rags from the Golden Age of Rag, 19--.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4fba0164b13455b95312b39dfc5173fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rags: passim.)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Jan. 17, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4fba0164b13455b95312b39dfc5173fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ragtime: a style of popular music that flourished from about 1896 to 1918; its most important element, rhythmic syncopation, was recognized as a general trait of Afro-American music; lost strength during World War I, giving way to jazz, the new American syncopated popular music)"}, "madsrdf:citationSource": "New Grove dict. of Amer. music", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4fba0164b13455b95312b39dfc5173fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4fba0164b13455b95312b39dfc5173fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rags (Popular music)"}}, {"@id": "_:nb4fba0164b13455b95312b39dfc5173fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rags (Popular music)"}}], "@id": "/authorities/genreForms/gf2014027034"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027035", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRai (Music)", "identifiers:lccn": "gf2014027035", "madsrdf:adminMetadata": [{"@id": "_:n669faaafaf8247fcb48e583983b94944b1"}, {"@id": "_:n669faaafaf8247fcb48e583983b94944b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rai (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n669faaafaf8247fcb48e583983b94944b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n669faaafaf8247fcb48e583983b94944b5"}, {"@id": "_:n669faaafaf8247fcb48e583983b94944b6"}, {"@id": "_:n669faaafaf8247fcb48e583983b94944b7"}, {"@id": "_:n669faaafaf8247fcb48e583983b94944b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n669faaafaf8247fcb48e583983b94944b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n669faaafaf8247fcb48e583983b94944b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n669faaafaf8247fcb48e583983b94944b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rai (Music)"}}, {"@id": "_:n669faaafaf8247fcb48e583983b94944b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A genre of North African popular music, most closely associated with the city of Waharan (Oran) in western Algeria and nearby towns on both sides of the border with Morocco; earliest music of this name was performed by female singers in the bars of Oran during the 1920s and 30s. They were accompanied by the gaspah (an end-blown flute) and the guellal (a pottery, single-headed cylindrical drum)... With the arrival of cassette technology and a period of relative political calm in the late 1970s, ra\u00ef recordings began to be produced for local consumption. There was considerable experimentation in the recording studios and gradually the genre incorporated novel regional and global musical element...)"}, "madsrdf:citationSource": "Grove music online, viewed November 25, 2104", "madsrdf:citationStatus": "found"}, {"@id": "_:n669faaafaf8247fcb48e583983b94944b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "passim (le Ra\u00ef)"}, "madsrdf:citationSource": "Work cat.: 96-143865: Virolle-Souib\u00e8s, M. La chanson ra\u00ef, c1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:n669faaafaf8247fcb48e583983b94944b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove;New Harvard dict. of music;Web. 3", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n669faaafaf8247fcb48e583983b94944b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rai; ra\u00ef)"}, "madsrdf:citationSource": "LC database, Feb. 25, 1997", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027035"}
