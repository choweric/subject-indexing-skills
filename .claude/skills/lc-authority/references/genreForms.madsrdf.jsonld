{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026553", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSamurai films", "identifiers:lccn": "gf2011026553", "madsrdf:adminMetadata": [{"@id": "_:n1f561185859940cba5e93c397c45c439b1"}, {"@id": "_:n1f561185859940cba5e93c397c45c439b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Samurai films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1f561185859940cba5e93c397c45c439b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n1f561185859940cba5e93c397c45c439b5"}, "madsrdf:hasSource": [{"@id": "_:n1f561185859940cba5e93c397c45c439b8"}, {"@id": "_:n1f561185859940cba5e93c397c45c439b9"}, {"@id": "_:n1f561185859940cba5e93c397c45c439b10"}], "madsrdf:hasVariant": [{"@id": "_:n1f561185859940cba5e93c397c45c439b11"}, {"@id": "_:n1f561185859940cba5e93c397c45c439b14"}, {"@id": "_:n1f561185859940cba5e93c397c45c439b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature samurai and are usually set in the Tokugawa period of Japanese history.", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026748"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025263"}]}, {"@id": "_:n1f561185859940cba5e93c397c45c439b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:08:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1f561185859940cba5e93c397c45c439b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n1f561185859940cba5e93c397c45c439b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Samurai films"}}, {"@id": "_:n1f561185859940cba5e93c397c45c439b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1f561185859940cba5e93c397c45c439b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Zatoichi films"}}, {"@id": "_:n1f561185859940cba5e93c397c45c439b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zatoichi films"}}, {"@id": "_:n1f561185859940cba5e93c397c45c439b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(samurai cinema: in Japan the term chanbara, also spelled chambara, is used for this genre; subcategory of jidaigeki, which equates to period drama; historically, the genre is usually set in the Tokugawa era (1600-1868) and focuses on the end of an entire way of life for the samurai)"}, "madsrdf:citationSource": "Wikipedia, Aug. 28, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1f561185859940cba5e93c397c45c439b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(samurai film (chambara film; samurai swordplay movie): Chambara films (period films about samurai) are a violent Japanese film genre which gained popularity after World War II. They are well-known in the West, mainly through the films of Akira Kurosawa and the master characterizations of Toshiro Mifune; relies on swordsmanship as the essential ingredient of the genre)"}, "madsrdf:citationSource": "Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1f561185859940cba5e93c397c45c439b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(chanbara/chambara - refers to a specific sub-genre of the jidaigeki drama. A drama series focusing on sword fighting, kendo or samurai, which was made popular during the 1940's through 1960's. Normally, you would not use chanbara when referencing period Japanese dramas. Instead, jidaigeki drama would be the more appropriate name when applying to Japanese dramas. Unfortunately, many web sites misspell the romaji as chambara, but when used with that form of spelling, everyone knows what it means.)"}, "madsrdf:citationSource": "Japanese entertainment glossary of terms, via WWW, Aug. 3, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n1f561185859940cba5e93c397c45c439b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1f561185859940cba5e93c397c45c439b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chambara films"}}, {"@id": "_:n1f561185859940cba5e93c397c45c439b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chambara films"}}, {"@id": "_:n1f561185859940cba5e93c397c45c439b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1f561185859940cba5e93c397c45c439b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Zatoichi films"}}, {"@id": "_:n1f561185859940cba5e93c397c45c439b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zatoichi films"}}, {"@id": "_:n1f561185859940cba5e93c397c45c439b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1f561185859940cba5e93c397c45c439b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chanbara films"}}, {"@id": "_:n1f561185859940cba5e93c397c45c439b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chanbara films"}}], "@id": "/authorities/genreForms/gf2011026553"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026554", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSamurai television programs", "identifiers:lccn": "gf2011026554", "madsrdf:adminMetadata": [{"@id": "_:nea26b9ce8d064ad38986a69f66748427b1"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Samurai television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nea26b9ce8d064ad38986a69f66748427b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasSource": [{"@id": "_:nea26b9ce8d064ad38986a69f66748427b5"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b6"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b7"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b8"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b9"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b10"}], "madsrdf:hasVariant": [{"@id": "_:nea26b9ce8d064ad38986a69f66748427b11"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that feature samurai and are usually set in the Tokugawa period of Japanese history.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025070"}}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:08:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Samurai television programs"}}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Atsuhime [VR], 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(chanbara/chambara - Refers to a specific sub-genre of the jidaigeki drama. A drama series focusing on sword fighting, kendo or samurai, which was made popular during the 1940's through 1960's. Normally, you would not use chanbara when referencing period Japanese dramas. Instead, jidaigeki drama would be the more appropriate name when applying to Japanese dramas. Unfortunately, many web sites misspell the romaji as chambara, but when used with that form of spelling, everyone knows what it means.)"}, "madsrdf:citationSource": "Japanese entertainment glossary of terms, via WWW, Aug. 3, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Samurai cinema: In Japan, the term chanbara, also commonly spelled \"chambara\", is used for this genre, literally \"sword fighting\" movies, roughly equating to western swashbuckler films.)"}, "madsrdf:citationSource": "Wikipedia, Aug. 3, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Atsuhime (drama) (Atsuhime is the 47th NHK Taiga drama. It began on Jan. 6, 2008, completing its run with 50 episodes. Based on Tomiko Miyao's novel Tensh\u014d-in Atsuhime, the protagonist is Tensh\u014d-in (Princess Atsu), the wife of Tokugawa Iesada, the thirteenth sh\u014dgun of the Edo shogunate) The Samurai (TV series) (The Samurai was a Japanese television historical drama series of the 1960s made by Senkosha Productions. The series premiered on October 7, 1962 in Japan and ran until March 1965. Its original Japanese title was Onmitsu Kenshi ('spy swordsman')) Samurai Champloo (Samurai Champloo is a Japanese animated television series consisting of twenty-six episodes. It was broadcast in Japan from May 20, 2004, through March 19, 2005, on the television network, Fuji TV. The series is a cross-genre work of media, blending the action and samurai genres with elements of slapstick comedy. It is also a period piece, taking place during Japan's Edo period.)"}, "madsrdf:citationSource": "Wikipedia, Aug. 3, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Samurai TV Series (programs listed for sale include: Hasshu Mawari Kuwayama Jube - 2007 TV Mini Series 8 Episodes; Ryoma Den - 2010 NHK Taiga Drama Episode 1-24; Sakuya Konohana - 2010 NHK TV Drama Mini Series 10 Episodes; Three Outlaw Samurai TV Series Vol.1; Sensitive Samurai - Season 1 - 4 Disc Set; Sensitive Samurai - Season 2 - 4 Disc Set; Tenchijin - 2009 NHK Taiga Drama - Episodes 1 to 47; Atsuhime - 2008 NHK Taiga Drama; Three Generations Of The Yagyu Sword - 6 Vol., 13 Episodes; Zatoichi TV Series - Grand Finale)"}, "madsrdf:citationSource": "Japanesesamuraidvd.com website, Aug. 3, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "TV series (programs listed for sale include: The Sensitive Samurai - Season 1: A classic samurai drama, set in the 18th century; tragedy, honor, revenge, love, tears, laughter and swordsmanship extraordinary; Shinsengumi: Focuses on a group of young samurai who were hoping for bright future by working for the Tokugawa in the 1850s and 60s, the last days of the shogunate; Tenchijin: The story centers on Naoe Kanetsugu, a loyal and devoted samurai in Echigo Province in the 16th century.)"}, "madsrdf:citationSource": "Kurotokagi Gumi website, Aug. 3, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nea26b9ce8d064ad38986a69f66748427b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chambara television programs"}}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chambara television programs"}}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nea26b9ce8d064ad38986a69f66748427b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chanbara television programs"}}, {"@id": "_:nea26b9ce8d064ad38986a69f66748427b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chanbara television programs"}}], "@id": "/authorities/genreForms/gf2011026554"}
