ecordStatus": "new"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-18T07:01:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cycling maps"}}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1137318759"}, "madsrdf:citationSource": "Naperville Park District (Ill.). Naperville biking map & guide, 2016 or 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)70959637"}, "madsrdf:citationSource": "King County (Wash.). Department of Transportation. King County bicycling guidemap, \u00a92006.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Adventure Maps, Inc. Central Oregon cycling map & guide, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)956458520"}, "madsrdf:citationSource": "Adventure Maps, Inc. Central Oregon road biking map & guide, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The map shows trails, bike lanes, wide shoulders, and routes commonly used by cyclists)"}, "madsrdf:citationSource": [{"@id": "https://www.trpc.org/179/Thurston-County-Bicycle-Map"}, "Thurston County bicycle map, via Thurston Regional Planning Council website, May 29, 2024"], "madsrdf:citationStatus": "found"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1390422155"}, "madsrdf:citationSource": "Work cat.: Seattle (Wash.). Department of Transportation. 2022 Seattle bike map, 2022.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Bicycle map (A bicycle map, also known as a bike map, is a specialized map designed to assist cyclists in navigating urban, suburban, or rural areas safely and efficiently. It typically highlights bike lanes, dedicated bike paths, shared roads, and other infrastructure that accommodates bicyclists. These maps may also include information on elevation changes, points of interest, bike racks, repair stations, and traffic conditions relevant to cyclists. Bicycle maps aim to provide cyclists with essential information to plan their routes, promote cycling as a mode of transportation, and enhance the overall biking experience by ensuring accessibility and safety)"}, "madsrdf:citationSource": "Wikipedia, May 29, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(4,980 results for \"bicycling map\"; 46,700 results for \"biking map\"; 162,000 results for \"bicycle map\"; 210,000 results for \"cycling map\")"}, "madsrdf:citationSource": "Google search, May 29, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)50113313"}, "madsrdf:citationSource": "Krebs Cycle Products (Firm). Mount Diablo and East Bay hills mountain biking map, \u00a91994.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)48687614"}, "madsrdf:citationSource": "Colorado. Department of Transportation. Bicycle/Pedestrian Program. Colorado bicycling map, \u00a92001.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bicycle maps"}}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bicycle maps"}}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bike maps"}}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bike maps"}}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bicycling maps"}}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bicycling maps"}}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biking maps"}}, {"@id": "_:n4023147f374a4bb3a5630aabd2992b8cb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biking maps"}}], "@id": "/authorities/genreForms/gf2024026051"}
