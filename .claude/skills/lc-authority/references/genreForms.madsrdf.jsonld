rities/genreForms/gf2022026064"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026075"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026038"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026039"}], "madsrdf:hasSource": [{"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b5"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b6"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b7"}], "madsrdf:hasVariant": [{"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b8"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b11"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b14"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b17"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b20"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b23"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b26"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b29"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music composed in any classical, learned, and/or court tradition, in cultures that have a division between art and folk music. For popular and folk music in cultures that distinguish it from art music see [Popular music; Folk music,] or a subgenre of either."}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T16:10:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Art music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(art music: Music composed in a classical tradition and intended as serious art, especially as distinguished from popular or folk music)"}, "madsrdf:citationSource": "Amer. Herit. dict. of the Engl. lang., via WWW, Dec. 4, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Grove dictionary of American music, 2nd ed. (art music; one of three categories in a contemporary taxonomy that typically includes folk, art, and popular musics; it had been assumed by many 19th- and early 20th-century Euro-Americans that art music was a predominantly Western musical type composed by specially trained individuals; the term \"art music,\" if considered a viable category at all today, is now more often understood to refer to a kind of music found across cultures that is defined not by any particular or exclusively musical qualities but instead by its origins ... its systems of support and transmission ... and its primarily literate dissemination) Oxford companion to music (art music; [term] used to describe music that is written down and that takes a more or less established form to transmit some sort of artistic expression. The term is often used in contradistinction to folk and popular music, as well as some forms of liturgical music (especially plainchant) and dance music, but, particularly since the 20th century, the distinctions have become blurred)"}, "madsrdf:citationSource": "Oxford music online, viewed July 19, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Art music; also known as serious music; an umbrella term used to refer to musical traditions implying advanced structural and theoretical considerations and a written musical tradition; while often used to refer primarily to Western historical classical music, the term may refer to: the classical/art music traditions of several different cultures around the world, modern and contemporary classical music, including serialism, electronic art music, experimental (art) music and minimalist music, as well as other forms, [and] some forms of jazz, excluding most forms generally considered to be popular music"}, "madsrdf:citationSource": "Wikipedia, viewed July 29, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Middle Eastern classical music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Middle Eastern classical music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Western art music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Western art music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Classical music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Classical music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Court music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Court music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "East Asian classical music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "East Asian classical music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "South Asian classical music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "South Asian classical music"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Serious music (Art music)"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serious music (Art music)"}}, {"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9b99e4f766b40e8adb9e9eaecb7f495b30"}]}, "