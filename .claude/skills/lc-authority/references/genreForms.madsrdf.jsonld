{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026407", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMotorcycle films", "identifiers:lccn": "gf2011026407", "madsrdf:adminMetadata": [{"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb1"}, {"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Motorcycle films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": {"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb5"}, "madsrdf:hasVariant": {"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025251"}}, {"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:34:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motorcycle films"}}, {"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(motorcycle movie, bike movie, biker film, cycle film, wheeler picture; two types of motorcycle movies: The motocycle gang film and movies just featuring motorcyclists; movies featuring motorcycle racing are a subdivision of the sports movie)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biker films"}}, {"@id": "_:n82053e0c49ef4780ac87f085e0aa65beb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biker films"}}], "@id": "/authorities/genreForms/gf2011026407"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026408", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMountain films", "identifiers:lccn": "gf2011026408", "madsrdf:adminMetadata": [{"@id": "_:ndd9376d3f1db4420b67c63627736588bb1"}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mountain films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndd9376d3f1db4420b67c63627736588bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:ndd9376d3f1db4420b67c63627736588bb5"}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb6"}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb7"}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb8"}], "madsrdf:hasVariant": [{"@id": "_:ndd9376d3f1db4420b67c63627736588bb9"}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025252"}}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:34:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mountain films"}}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mountain Film (Mountaineering Film). The mountain film revealed itself as a genre in the early twenties; it was especially popular in Germany, where, in the late twenties and early thirties, the mountain film (Bergfilm) fit in with that country's cult of youth and nature)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mountain Films. During the Weimar Republic in Germany, prior to the rise of Hitler, a film genre was developed to parallel (arguably, rival) the American Western. These films used mountain scenes and settings to develop similar \"Western\" attitudes concerning the protagonist's struggles and conflicts. The physical power, potential and actuality of the character or heroic figure was emphasized)"}, "madsrdf:citationSource": "All movie guide Film glossary, via WWW, Dec. 1, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Moving image genre-form guide, via WWW, July 19, 2007", "madsrdf:citationStatus": "notfound"}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "entertainment section (Mountain films; Canadian films on mountain sports; Banff Mountain Film Festival is an international film competition featuring the world's best films and videos on mountain subjects)"}, "madsrdf:citationSource": "The Hindu, July 18, 2003, via WWW, Dec. 1, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd9376d3f1db4420b67c63627736588bb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mountaineering films"}}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mountaineering films"}}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd9376d3f1db4420b67c63627736588bb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bergfilme"}}, {"@id": "_:ndd9376d3f1db4420b67c63627736588bb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bergfilme"}}], "@id": "/authorities/genreForms/gf2011026408"}
