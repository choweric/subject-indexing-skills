{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027129", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTarantellas (Music)", "identifiers:lccn": "gf2014027129", "madsrdf:adminMetadata": [{"@id": "_:n0109dd2d0a894f22ae1ffee1b12a922bb1"}, {"@id": "_:n0109dd2d0a894f22ae1ffee1b12a922bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tarantellas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0109dd2d0a894f22ae1ffee1b12a922bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:n0109dd2d0a894f22ae1ffee1b12a922bb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0109dd2d0a894f22ae1ffee1b12a922bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0109dd2d0a894f22ae1ffee1b12a922bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0109dd2d0a894f22ae1ffee1b12a922bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tarantellas (Music)"}}, {"@id": "_:n0109dd2d0a894f22ae1ffee1b12a922bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A folk dance of southern Italy that takes it name from the town of Taranto... It is in a rapid accelerating 6 /8 with shifts between major and minor)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027129"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027130", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTechno (Music)", "identifiers:lccn": "gf2014027130", "madsrdf:adminMetadata": [{"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b1"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Techno (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026825"}, "madsrdf:hasSource": [{"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b5"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b6"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b7"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b8"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b9"}], "madsrdf:hasVariant": {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-07-13T13:04:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "revised"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Techno (Music)"}}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(supplier of quality underground dance music: includes techno)"}, "madsrdf:citationSource": "WWW.elevatorrecords.com WWW site, Apr. 18, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 9 (The development of the music which has been known as techno since the mid-eighties is linked to the availability of the technology necessary for its production) p. 120 (Techno is party music, techno is party culture, and partying is the be-all and end-all of techno)"}, "madsrdf:citationSource": "Techno style, 1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 98014754: Reynolds, S. Generation ecstasy : into the world of techno and rave culture, 1998 (techno music; style of popular dance music performed at rave parties; produced by computers and sampling technology)", "madsrdf:citationStatus": "found"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(online record store specializing in all kinds of underground dance music: includes techno)"}, "madsrdf:citationSource": "DanceGrooves WWW site, 04-18-00", "madsrdf:citationStatus": "found"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(techno: variant of house music, priginating in Detroit at end of 1980s; replaced original Afro-American and Latin-American roots of house by drawing upon synthetic sound concepts of new wave as well as minimalist aesthetic of the German electronic band Kraftwerk; developed from this a dance music which was decidedly mechanical, pounding like a machine, highly technologized, digitally produced; term first used in title of album issued in London by Virgin Records in 1988; at beginning of 1990s, took discotheques practically by storm, especially in metropolises of North America and Europe; in the process, split into subcategories (ambient, breakbeat, gabber, goa, hardcore techno, jungle, tekkno, trance, tribal); meanwhile, Original form also trades under the name Detroit techno; the term \"techno-pop\" appears as cross-ref. to \"synthi-pop,\" a style which came on the scene in Great Britain in 1982)"}, "madsrdf:citationSource": "Wicke, P. Handbuch der popul\u00e4ren Musik, c1997", "madsrdf:citationStatus": "found"}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Detroit techno (Music)"}}, {"@id": "_:ne38036ad204d4c5e9fc19a2398b42d14b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Detroit techno (Music)"}}], "@id": "/authorities/genreForms/gf2014027130"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027131", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTejano music", "identifiers:lccn": "gf2014027131", "madsrdf:adminMetadata": [{"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b1"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tejano music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b5"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b6"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b7"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b8"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b9"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b10"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b11"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b12"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b13"}], "madsrdf:hasVariant": [{"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b14"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b17"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tejano music"}}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Tejano music's adaptation to a Mexican market, 1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tejano music awards; tejano music)"}, "madsrdf:citationSource": "Music index, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tex-Mex (Sp. Tejano conjunto) Popular music genre originally from southern Texas, which has some similarities to the Mexican norte\u00f1o, but is also influenced by several American musical genres and in particular features elements of polka. The basic duo of accordion and bajo sexto (12-string bass guitar) has grown to include other instruments (drum kit, bass guitar, etc.) but these two instruments still characterize the sound of the ensemble. As the repertory has diversified a sub-genre known as 'Tejano music' (which is more rock and pop orientated) has also emerged)"}, "madsrdf:citationSource": "New Grove dict. mus., 2nd ed. WWW site, Aug. 16, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Guinness encyc. of pop. music, 1992;New Grove dict. of music and musicians, 1980", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tex-Mex: of, relating to, or being the Mexican-American culture; existing or originating in especially southern Texas (e.g. Tex-Mex music))"}, "madsrdf:citationSource": "Merriam-Webster collegiate dict. online WWW site, Aug. 16, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xi (Texas-Mexican music, or m\u00fasica tejana; not one single music but several musical and musico-literary genres (e.g. corrido, canci\u00f3n, canci\u00f3n- corrido), ensembles (e.g. conjunto, close cousin of m\u00fasica norte\u00f1a, and the Texas-Mexican orquesta), and their styles; also includes synthesizer-driven ensembles and styles, known since the mid-1980s as \"Tejano\")"}, "madsrdf:citationSource": "Pe\u00f1a, Manuel H. M\u00fasica tejana, c1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 7, no. 11, p. 36 (Tejano music is derived from Conjunto and still influenced by it)"}, "madsrdf:citationSource": "Hispanic, Dec., 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tejano: The term Tejano, derived from the Spanish adjective tejano or (feminine) tejana (and written in Spanish with a lower-case t), denotes a Texan of Mexican descent, thus a Mexican Texan or a Texas Mexican)"}, "madsrdf:citationSource": "Handbook of Texas Online WWW site, Aug. 17, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ECIP t.p. (Tex-Mex music) galley (M\u00fasica tejana, or Texas-Mexican music; m\u00fasica tejana comprises all the musical genres, forms, and styles that have existed in the Tejano community since at least the nineteenth century; Tejanos are individuals of Mexican descent who were born and raised in Texas; m\u00fasica tejana comprises several musical ensembles, not simply conjuntos; includes vocal groups of varying sizes and five distinct ensembles conjuntos, progressive conjuntos, orquestas, grupos, and country bands)"}, "madsrdf:citationSource": "San Miguel, Guadalupe. Tejano proud, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "M\u00fasica tejana"}}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "M\u00fasica tejana"}}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Texas-Mexican music"}}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Texas-Mexican music"}}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tex-Mex music"}}, {"@id": "_:nc5ca5a1bfedc4286933e072cd92bb291b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tex-Mex music"}}], "@id": "/authorities/genreForms/gf2014027131"}
