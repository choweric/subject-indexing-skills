ordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:00:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rechtsb\u00fccher"}}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Rechtsb\u00fccher (This heading is used as a genre/form heading for compilations of, and commentaries on, common (civil, criminal, and procedural) law and feudal (constitutional) law of the Holy Roman Empire composed in German prose, e.g., Sachsenspiegel (a private account of Imperial laws that gained the status of Imperial law itself and served as a model for a large number of noted Rechtsb\u00fccher to the end of the 19th century))"}, "madsrdf:citationSource": "Genre/form terms for law materials [report prepared by the Technical Services Special Interest Section of AALL], 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ee5c0540f144aa39018dfa653215323b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stadtrechtsb\u00fccher"}}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stadtrechtsb\u00fccher"}}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ee5c0540f144aa39018dfa653215323b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Richtsteige (Rechtsb\u00fccher)"}}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Richtsteige (Rechtsb\u00fccher)"}}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ee5c0540f144aa39018dfa653215323b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spiegel (Rechtsb\u00fccher)"}}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spiegel (Rechtsb\u00fccher)"}}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ee5c0540f144aa39018dfa653215323b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gewohnheiten (Rechtsb\u00fccher)"}}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gewohnheiten (Rechtsb\u00fccher)"}}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ee5c0540f144aa39018dfa653215323b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Landrechtsb\u00fccher"}}, {"@id": "_:n4ee5c0540f144aa39018dfa653215323b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Landrechtsb\u00fccher"}}], "@id": "/authorities/genreForms/gf2011026523"}
