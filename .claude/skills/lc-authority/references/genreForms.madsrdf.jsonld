{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026373", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLoose-leaf services", "identifiers:lccn": "gf2011026373", "madsrdf:adminMetadata": [{"@id": "_:nad1b07b562f1482a8eab46e37dd71485b1"}, {"@id": "_:nad1b07b562f1482a8eab46e37dd71485b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Loose-leaf services"}, "madsrdf:elementList": {"@list": [{"@id": "_:nad1b07b562f1482a8eab46e37dd71485b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026351"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}], "madsrdf:hasSource": {"@id": "_:nad1b07b562f1482a8eab46e37dd71485b5"}, "madsrdf:hasVariant": {"@id": "_:nad1b07b562f1482a8eab46e37dd71485b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Legal publications that bring together primary and secondary materials pertaining to a particular field or topic, and that are issued in binders and updated with replacement pages, sequential newsletters, or both.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025123"}}, {"@id": "_:nad1b07b562f1482a8eab46e37dd71485b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T13:52:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nad1b07b562f1482a8eab46e37dd71485b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nad1b07b562f1482a8eab46e37dd71485b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Loose-leaf services"}}, {"@id": "_:nad1b07b562f1482a8eab46e37dd71485b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Loose-leaf services (This heading is used as a genre/form heading for legal publications that bring together primary and secondary materials pertaining to a particular field or topic. To maintain currency, they are issued in binders and updated with replacement pages, sequential newsletters, or both. Examples: 1. Standard federal tax reporter published by Commerce Clearing House (CCH) 2. U.S. law week published by the Bureau of National Affairs (BNA) 3. United States tax reporter published by the Research Institute of America (RIA))"}, "madsrdf:citationSource": "Genre/form terms for law materials [report prepared by the Technical Services Special Interest Section of AALL], 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b07b562f1482a8eab46e37dd71485b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nad1b07b562f1482a8eab46e37dd71485b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Looseleaf services"}}, {"@id": "_:nad1b07b562f1482a8eab46e37dd71485b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Looseleaf services"}}], "@id": "/authorities/genreForms/gf2011026373"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026374", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLoran charts", "identifiers:lccn": "gf2011026374", "madsrdf:adminMetadata": [{"@id": "_:n406afb6d877c4ccb9214020e279afe0cb1"}, {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Loran charts"}, "madsrdf:elementList": {"@list": [{"@id": "_:n406afb6d877c4ccb9214020e279afe0cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026034"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026418"}], "madsrdf:hasSource": [{"@id": "_:n406afb6d877c4ccb9214020e279afe0cb5"}, {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb6"}, {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb7"}], "madsrdf:hasVariant": {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025063"}}, {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T12:50:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Loran charts"}}, {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(loran chart: plotting charts on which loran ground wave line of positions and sky-wave correction values have been printed, for use in loran navigation)"}, "madsrdf:citationSource": "Glossary of mapping, charting, and geodetic terms, 1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LORAN: abbrev. for long range navigation; section on Loran charts: common marine nautical charts include visible representations of TD lines at regular intervals over water areas. The TD lines representing a given master-slave pairing are printed with distinct colors, and note the specific time difference indicated by each line)"}, "madsrdf:citationSource": "Wikipedia, Dec. 1, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Loran chart (a chart on which are shown the ground-wave lines of position and sky-wave corrections for Loran) chart, long-range navigation (a small scale (1:3,000,000 or less) aeronautical chart designed for navigation on long flights and relying principally on dead reckoning and celestial navigation)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n406afb6d877c4ccb9214020e279afe0cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Long-range navigation charts"}}, {"@id": "_:n406afb6d877c4ccb9214020e279afe0cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Long-range navigation charts"}}], "@id": "/authorities/genreForms/gf2011026374"}
