abfa528158fba981e7db13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n453d388bf1284abfa528158fba981e7db14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stats"}}, {"@id": "_:n453d388bf1284abfa528158fba981e7db14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stats"}}], "@id": "/authorities/genreForms/gf2014026181"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026182", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStudy guides", "identifiers:lccn": "gf2014026182", "madsrdf:adminMetadata": [{"@id": "_:n484aca40e96f48819d45758e749fd994b1"}, {"@id": "_:n484aca40e96f48819d45758e749fd994b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Study guides"}, "madsrdf:elementList": {"@list": [{"@id": "_:n484aca40e96f48819d45758e749fd994b3"}]}, "madsrdf:exampleNote": "Note under [Problems and exercises]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, "madsrdf:hasSource": [{"@id": "_:n484aca40e96f48819d45758e749fd994b5"}, {"@id": "_:n484aca40e96f48819d45758e749fd994b6"}, {"@id": "_:n484aca40e96f48819d45758e749fd994b7"}], "madsrdf:hasVariant": [{"@id": "_:n484aca40e96f48819d45758e749fd994b8"}, {"@id": "_:n484aca40e96f48819d45758e749fd994b11"}, {"@id": "_:n484aca40e96f48819d45758e749fd994b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works designed to help prepare for examinations or courses of study. For practice problems and exercises designed to develop and improve skills in an area of study, see [Problems and exercises.]"}, {"@id": "_:n484aca40e96f48819d45758e749fd994b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-07-13T14:04:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dgpo"}, "ri:recordStatus": "revised"}, {"@id": "_:n484aca40e96f48819d45758e749fd994b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n484aca40e96f48819d45758e749fd994b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Study guides"}}, {"@id": "_:n484aca40e96f48819d45758e749fd994b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(examination study guides. Resources intended as preparation for specific exercises testing knowledge, aptitude, or skills)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n484aca40e96f48819d45758e749fd994b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Study Guides. BT Guides; Instructional Materials)"}, "madsrdf:citationSource": "ERIC thesaurus, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n484aca40e96f48819d45758e749fd994b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(study aid: Educational material designed to help the student learn by self-study, often used in conjunction with a formal course of study. The category includes books, glossaries, flash cards, self-tests, animations, image galleries, and interactive media; study guide: A manual designed to help the reader prepare for a standardized or certification examination required for advancement in a course of study or in a career. Synonymous with test guide)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n484aca40e96f48819d45758e749fd994b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n484aca40e96f48819d45758e749fd994b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Test guides"}}, {"@id": "_:n484aca40e96f48819d45758e749fd994b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Test guides"}}, {"@id": "_:n484aca40e96f48819d45758e749fd994b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n484aca40e96f48819d45758e749fd994b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Examination study guides"}}, {"@id": "_:n484aca40e96f48819d45758e749fd994b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Examination study guides"}}, {"@id": "_:n484aca40e96f48819d45758e749fd994b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n484aca40e96f48819d45758e749fd994b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Study aids"}}, {"@id": "_:n484aca40e96f48819d45758e749fd994b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Study aids"}}], "@id": "/authorities/genreForms/gf2014026182"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026183", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aStyle manuals", "identifiers:lccn": "gf2014026183", "madsrdf:adminMetadata": [{"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb1"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Style manuals"}, "madsrdf:elementList": {"@list": [{"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026109"}, "madsrdf:hasSource": [{"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb5"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb6"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb7"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb8"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb9"}], "madsrdf:hasVariant": [{"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb10"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb13"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Style manuals"}}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Epp, M.A. Style guides for technical reports, journal articles, dissertations, term papers, publications, theses, 1975.", "madsrdf:citationStatus": "found"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(style manuals. UF style sheets. Sets of standards for the technical aspects of writing and design of documents, either for general use or for specific publications, organizations, or fields.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(style manual: A guide to a prescribed set of rules for typing research papers and theses, usually written for a specific academic discipline or group of related disciplines, covering the mechanics of writing (punctuation, capitalization, quotations, plagiarism, etc.), format (spacing, headings, tables and illustrations, etc.), and correct form of documentation (footnotes, endnotes, and bibliographies), usually including pertinent examples.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 79 (style-book: book containing styles of deeds etc., 2 manual of house style)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Style guide. A style guide or style manual is a set of standards for the writing and design of documents, either for general use or for a specific publication, organization or field. The implementation of a style guide provides uniformity in style and formatting within a document and across multiple documents. Style guides are common for general and specialized use, for the general reading and writing audience, and for students and scholars of various academic disciplines, medicine, journalism, the law, government, business, and industry.)"}, "madsrdf:citationSource": "Wikipedia, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Style-books"}}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Style-books"}}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Style sheets"}}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Style sheets"}}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Style guides"}}, {"@id": "_:n32a772a8f4a2481a88a960f3769d75cfb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Style guides"}}], "@id": "/authorities/genreForms/gf2014026183"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026184", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSudoku puzzles", "identifiers:lccn": "gf2014026184", "madsrdf:adminMetadata": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b1"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sudoku puzzles"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, "madsrdf:hasSource": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b5"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b6"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b7"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b8"}], "madsrdf:hasVariant": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b9"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b12"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b15"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b18"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b21"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b24"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b27"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b30"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sudoku puzzles"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"In the May 1979 issue of Dell Pencil Puzzles & Word Games (issue #16), page 6, something amazing appeared: Number Place. ... Who made this puzzle? In addition to being the crossword editor of the New York Times, Will Shortz is a puzzle historian, so he did detective work to find the answer. He knew that 'Number Place' puzzles had appeared in Dell Magazines, and went through his collection to find the first. Dell listed no author, but the name Howard Garns always appeared in the contributor's list of any issue containing a 'Number Place' puzzle. Also, Garns' name did not appear in any issue lacking a Number Place, which clinched the identification. ... Howard Garns made many Number Place puzzles for Dell, quickly simplifying the rules to those used today--Fill in the grid so that every row, column, and 3x3 box contains the digits 1 through 9. In April 1984, Japan's puzzle group Nikoli discovered Dell's Number Place presented it for a Japanese audience in the pages of puzzle paper Monthly Nikolist. Originally named Suuji Wa Dokushin Ni Kagiru, ('the numbers must be single') the puzzle became very popular. Kaji Maki, the president of Nikoli, abbreviated it to Sudoku (Su = number, Doku = single), and trademarked the name. As the popular[ity] grew, competing companies stayed with the non-trademarked name Number Place, or 'nanpure'. Even today, many Japanese puzzle magazines spell out 'Number Place' in English. In the United States and elsewhere, it's called Sudoku ('single number' in Japanese). Thus, Japanese-speakers use the English, and English-speakers use the Japanese.\")"}, "madsrdf:citationSource": "Pegg, E. Sudoku variations, via Mathematical Association of America website, viewed June 21, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sudoku, originally called Number Place, is a logic-based, combinatorial number-placement puzzle. The objective is to fill a 9x9 grid with digits so that each column, each row, and each of the nine 3x3 sub-grids that compose the grid (also called \"boxes\", \"blocks\", \"regions\", or \"sub-squares\") contains all of the digits from 1 to 9.)"}, "madsrdf:citationSource": "Wikipedia, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sudoku: a puzzle in which several numbers are to be filled into a 9x9 grid of squares so that every row, every column, and every 3x3 box contains the numbers 1 through 9. Origin: Japanese s\u016bdoku, short for s\u016bji wa dokushin ni kagiru \"the numerals must remain single\" (i.e., the digits can occur only once))"}, "madsrdf:citationSource": "Merriam-Webster online, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sudoku: A puzzle in which players insert the numbers one to nine into a grid consisting of nine squares subdivided into a further nine smaller squares in such a way that every number appears once in each horizontal line, vertical line, and square.)"}, "madsrdf:citationSource": "Oxford dictionaries website, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Su doku puzzles"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Su doku puzzles"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Squared away (Puzzles)"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Squared away (Puzzles)"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Number place (Puzzles)"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Number place (Puzzles)"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suuji wa dokushin ni kagiru (Puzzles)"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suuji wa dokushin ni kagiru (Puzzles)"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Su do ku puzzles"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Su do ku puzzles"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nanpure (Puzzles)"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nanpure (Puzzles)"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "S\u016bji wa dokushin ni kagiru (Puzzles)"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "S\u016bji wa dokushin ni kagiru (Puzzles)"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne59d1516a91743e187a2d1718050c7f4b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nine numbers (Puzzles)"}}, {"@id": "_:ne59d1516a91743e187a2d1718050c7f4b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nine numbers (Puzzles)"}}], "@id": "/authorities/genreForms/gf2014026184"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026186", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTables (Data)", "identifiers:lccn": "gf2014026186", "madsrdf:adminMetadata": [{"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b1"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tables (Data)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b3"}]}, "madsrdf:exampleNote": "Note under [Graphs]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026071"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026106"}], "madsrdf:hasSource": [{"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b5"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b6"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b7"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b8"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b9"}], "madsrdf:hasVariant": [{"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b10"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b13"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Data in textual form arranged in columns and rows. For graphic representations of data see [Graphs.]"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:27:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tables (Data)"}}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(table: A compact, systematic list of data, as in a table of contents listing the chapters of a book, or the Periodic Table of Elements in chemistry. Also refers to the compact arrangement of facts, figures, or other data in vertical rows and columns to facilitate comparison, usually with a title across the top or an explanatory caption or note written or printed underneath. In books containing information in tabular format, a list of tables is usually provided in the front matter with page numbers as locators. Some statistical reference works consisting entirely of tables are indexed by table number.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tables (Data). Category: Publication/Document Types. BT Visual Aids. RT Charts; Data; Graphs; Spreadsheets)"}, "madsrdf:citationSource": "ERIC thesaurus, via WWW, Oct. 3, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tables (documents). Condensed, orderly arrangements of data, especially those in which the data are arranged in columns and rows.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tables (data) DEF (1) An array of data, each item of which may be unambiguously identified by means of one or more arguments. (2) A collection of data in which each item is uniquely identified by a label, by its position relative to the other items, or by some other means)"}, "madsrdf:citationSource": "NASA thesaurus, 2012, via WWW, Oct. 3, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tables (Data). Alternative Labels: Data tables; Tabular data. Broader Concept: Data representation. Narrower Concept: Two-way tables)"}, "madsrdf:citationSource": "Schools online thesaurus, Oct. 3, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Data, Tabular"}}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Data, Tabular"}}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tabular data"}}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tabular data"}}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Data tables"}}, {"@id": "_:n4c49c35b6cd045ff94b108046befb0a7b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Data tables"}}], "@id": "/authorities/genreForms/gf2014026186"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026187", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTactile works", "identifiers:lccn": "gf2014026187", "madsrdf:adminMetadata": [{"@id": "_:n0f56e8b5364543579c02062db1b267d2b1"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tactile works"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0f56e8b5364543579c02062db1b267d2b3"}]}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026053"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026192"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026018"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026023"}], "madsrdf:hasSource": [{"@id": "_:n0f56e8b5364543579c02062db1b267d2b5"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b6"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b7"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b8"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b9"}], "madsrdf:hasVariant": [{"@id": "_:n0f56e8b5364543579c02062db1b267d2b10"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that require physical interaction by engaging the sense of touch."}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:42:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tactile works"}}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Australia. Division of National Mapping. Tactual atlas of Australia, 1987-1988.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tactile materials: Reading materials in which the text is converted into a series of raised symbols, as in braille, or is presented in surfaces of contrasting texture, for the manual use of visually impaired persons.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 18, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tactile atlases, Tactile cartographic materials, Tactile globes, Tactile maps, Tactual atlases, Tactual globes, Tactual maps USE Cartographic materials for people with visual disabilities)"}, "madsrdf:citationSource": "LCGFT", "madsrdf:citationStatus": "found"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(entries for Tactile Graphic; Tactile Image; Tactile Musical Notation; Tactile Notated Movement; Tactile Notated Music; Tactile Text; Tactile Three-Dimensional Form)"}, "madsrdf:citationSource": "RDA glossary, viewed July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tactile: of, relating to, mediated by, or affecting the sense of touch; tactual: of or relating to the sense or the organs of touch : derived from or producing the sensation of touch : tactile)"}, "madsrdf:citationSource": "Merriam-Webster online, Aug. 18, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0f56e8b5364543579c02062db1b267d2b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tactile materials"}}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tactile materials"}}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0f56e8b5364543579c02062db1b267d2b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tactual works"}}, {"@id": "_:n0f56e8b5364543579c02062db1b267d2b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tactual works"}}], "@id": "/authorities/genreForms/gf2014026187"}
