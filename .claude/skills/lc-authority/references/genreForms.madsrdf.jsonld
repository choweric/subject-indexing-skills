{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026022", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHuaynos", "identifiers:lccn": "gf2015026022", "madsrdf:adminMetadata": [{"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b1"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Huaynos"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b5"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b6"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b7"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b8"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b9"}], "madsrdf:hasVariant": [{"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b10"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b13"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b16"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b19"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b22"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b25"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b28"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b31"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b34"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b37"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b40"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b43"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b46"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b49"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b52"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-08-12T09:53:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Huaynos"}}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A social dance... in Bolivia, Peru, northern Chile, Ecuador and northern Argentina. Of enormous popularity, its modern forms are part of the repertory of various ensembles. It is characterized by syncopated, anhemitonic pentatonic melodies beginning with a leap of a perfect 4th and ending with descending pendular motion. The huayno has a binary structure and duple metre, is in moderate tempo and often concludes with a fuga section that repeats the piece at twice the original speed...)"}, "madsrdf:citationSource": "Grove music online, viewed May 1, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 477 (Huayno (wayno)...; many regional variants and adopts different names, including chuscada (Ancash), pampe\u00f1a (Arequipa), cachua (Cajamarca), chymaycha (Amazonas and Huanuco), and huaylacha (Colca Valley). Usually in duple meter, it consists of a pair of musical phrases in periodic form (AABB). Like other Andean genres, it may have a closing section, called fuga or qawachan, which consists of a contrasting theme in a faster tempo. )"}, "madsrdf:citationSource": "Garland encyclopedia of world music. Vol. 2, South America, Mexico, Central America, and the Carribean, viewed online May 1, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Robles, M. El huayno.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Huayno, vals, chicha, rock; m\u00fasica popular peruana?", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2."}, "madsrdf:citationSource": "Work cat.: Huayno [SR] p1991:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Guai\u00f1os"}}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Guai\u00f1os"}}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Huay\u00f1us"}}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Huay\u00f1us"}}, {"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ebefa547dd24000b9cdbe47ba388098b17"}]}, "madsrdf:variantLabel": {"@