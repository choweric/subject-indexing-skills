d.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n66dcd334f27840a69b19ac4b688b6077b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Casebooks (Law)"}}, {"@id": "_:n66dcd334f27840a69b19ac4b688b6077b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66dcd334f27840a69b19ac4b688b6077b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Casebooks"}}, {"@id": "_:n66dcd334f27840a69b19ac4b688b6077b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Casebooks"}}, {"@id": "_:n66dcd334f27840a69b19ac4b688b6077b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Casebooks (This heading is used as a genre/form heading for law school textbooks containing leading court decisions in a particular field, together with commentary and other material useful for classroom discussion)"}, "madsrdf:citationSource": "Genre/form terms for law materials [report prepared by the Technical Services Special Interest Section of AALL], 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66dcd334f27840a69b19ac4b688b6077b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(casebook 1: a book containing records of illustrative cases that is used for reference and instruction (as in law or medicine) 2: a compilation of primary and secondary documents relating to a central topic together with scholarly comment, exercises, and study aids that is designed to serve as a sourcebook for short papers (as in a writing course) or as a point of departure for a research paper)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Nov. 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n66dcd334f27840a69b19ac4b688b6077b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(casebook: A book containing records or descriptions of actual cases that have occurred in a professional discipline (law, medicine, psychology, sociology, social work, counseling, etc.), selected to illustrate important principles and concepts, for the use of students as a textbook and practitioners for reference. Legal casebooks are typically plainly bound. Compare with case study)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Nov. 8, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n66dcd334f27840a69b19ac4b688b6077b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66dcd334f27840a69b19ac4b688b6077b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Casebooks"}}, {"@id": "_:n66dcd334f27840a69b19ac4b688b6077b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Casebooks"}}], "@id": "/authorities/genreForms/gf2011026115"}
