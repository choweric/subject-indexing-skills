, "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "spirit writing (automatic writing held to be produced under the influence of spirits)"}, "madsrdf:citationSource": "Merriam Webster online, Sept. 8, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n70225224f4524509b8fb18169507dc7eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Spirit writings (Scope note: This heading is used for automatic writing said to have been produced under the influence of spirits.)"}, "madsrdf:citationSource": "Religion genre/form terms: information gathered on behalf of the Library of Congress... American Theological Library Association, et. al, c2012:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026052"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026053", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTracts (Ephemera)", "identifiers:lccn": "gf2015026053", "madsrdf:adminMetadata": [{"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b1"}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tracts (Ephemera)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}], "madsrdf:hasSource": [{"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b5"}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b6"}], "madsrdf:hasVariant": [{"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b7"}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Pamphlets, leaflets, etc., that contain religious exhortations, doctrinal discussions, or proselytizing appeals, and that are often issued by religious or political groups."}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-06-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:53:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tracts (Ephemera)"}}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "tract (def. 1: the verses of Scripture sung or recited in the Roman liturgy of the mass after the gradual or instead of the alleluia on penitential days from Septuagesima to Holy Saturday, on ember days, and at most vigils and requiems; def. 2: a pamphlet, leaflet, or folder issued (as by a political or religious group) for propaganda; especially : one containing a religious exhortation, a doctrinal discussion, or a proselytizing appeal)"}, "madsrdf:citationSource": "Merriam Webster online, June 2, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Tracts (Scope note: This heading is used for pamphlets issued for a religious or moral purpose.)"}, "madsrdf:citationSource": "Religion genre/form terms: information gathered on behalf of the Library of Congress... American Theological Library Association, et. al, c2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pamphlets (Tracts)"}}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pamphlets (Tracts)"}}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Leaflets (Tracts)"}}, {"@id": "_:ndda4a66c0cd64b3089d1ddf4c2a74522b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Leaflets (Tracts)"}}], "@id": "/authorities/genreForms/gf2015026053"}
