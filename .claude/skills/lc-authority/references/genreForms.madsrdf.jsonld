873cb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sherlock Holmes films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sherlock Holmes films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scooby-Doo films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scooby-Doo films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Charlie Chan films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Charlie Chan films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shaft films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shaft films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fant\u00f4mas films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fant\u00f4mas films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Torchy Blane films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Torchy Blane films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bulldog Drummond films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bulldog Drummond films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb26", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 69 (Mysteries: use for fictional genre films and programs which usually revolve around the solution of a murder and do not have as their central character a private eye or gentleman detective; includes films and programs about a victim being driven crazy by someone, and films in which a character accused of murder tracks down the real villain. BT: Crime films and programs; RT: Detective films and programs; UF: Murder mysteries; Who-done-it's) p. 40 (Detective films and programs: use for fictional genre films and programs which focus on the investigations of a detective who is not with an official law enforcement agency. BT: Crime films and programs; RTs: Mysteries; Police films and programs; NT Private eye films and programs)"}, "madsrdf:citationSource": "Yee, M. M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb27", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 199-200 (Mystery film: usually a murder has been committed and the mystery engages the audience and characters in the film in a game of deduction brying to guess who is the murderer ... not all mysteries have to do with murder. The mystery could be a search for an object, the solving of a puzzle, or the explanation for a strange happening)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb28", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Whodunit: variant whodunnit; complex, plot-driven variety of the detective story in which the puzzle is paramount)"}, "madsrdf:citationSource": "Wikipedia, March 5, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb29", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Chan is missing, 1982.", "madsrdf:citationStatus": "found"}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb30", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mystery: fictional work in which a detective (sometimes merely an endangered individual forced to \"detect\" for his own self-protection) attempts to solve a crime, usually a murder or theft. The detective may be an amateur, a private investigator, or a plainclothes member of a police force, but whatever the identity, the mystery places the emphasis on the search for clues and rationative power of the detective, rather than the efforts of police or lawbreakers. In the mystery, suspense derives from the narrative's puzzle-like structure, with a group of suspects, whose testimony and motives must all be investigated until, in the surprising conclusion, the intelligent detective perceives the flawed alibi or other clue betraying the culprit's identity. RTs: Caper, Crime, Film noir, Gangster, Police, and Thriller)"}, "madsrdf:citationSource": "Moving image genre-form guide online, January 28, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb31", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Detective and mystery films)"}, "madsrdf:citationSource": "LCSH, January 28, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scooby-Doo films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scooby-Doo films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Private eye films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Private eye films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb38", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb39"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Murder mystery films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb39", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Murder mystery films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb41", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb42"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Who-done-it films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb42", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Who-done-it films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb44", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb45"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Torchy Blane films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb45", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Torchy Blane films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb47", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb48"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bulldog Drummond films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb48", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bulldog Drummond films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb50", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb51"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fant\u00f4mas films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb51", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fant\u00f4mas films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb53", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb54"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Whodunit films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb54", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Whodunit films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a87873cb56", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neff9f2426c7142d99362c9b83a87873cb57"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Charlie Chan films"}}, {"@id": "_:neff9f2426c7142d99362c9b83a8