{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026381", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMade-for-TV movies", "identifiers:lccn": "gf2011026381", "madsrdf:adminMetadata": [{"@id": "_:n9736341ba0964deb9726c34f233c79c4b1"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Made-for-TV movies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9736341ba0964deb9726c34f233c79c4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasSource": [{"@id": "_:n9736341ba0964deb9726c34f233c79c4b5"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b6"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b7"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b8"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b9"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b10"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b11"}], "madsrdf:hasVariant": [{"@id": "_:n9736341ba0964deb9726c34f233c79c4b12"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b15"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b18"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b21"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b24"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b27"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b30"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b33"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b36"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b39"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b42"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b45"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b48"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b51"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b54"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b57"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b60"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025512"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:31:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Made-for-TV movies"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 151-152 (chapter title: The American made-for-TV movie; TV movies; telefeature; telefilms; vidpics; movies made-for-television; the made-for-TV movie is a rich and varied genre, encompassing its own unique formal, stylistic, and topical strategies on which the process of definition and evaluation can continue to develop; can be divided into three categories/subgenres: the telefeature, the docudrama, and the mini-series; telefeature refers to a fictional narrative produced for TV that is a discrete entity occupying at least 90 \"commercial\" minutes but not exceeding one evening of programming; docudrama is a story film designed to recreate actual persons, places, and events; mini-series is an extended telefeature or docudrama that is broadcast in multiple segments over two or more nights) pp. 175-180 (videography includes: Brian's Song; The Night Stalker; That Certain Summer; Rich Man, Poor Man; Sybil; Roots; Holocaust; Shogun; The Day After)"}, "madsrdf:citationSource": "TV genres, 1985:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(television feature films; made-for-television feature films; made-for-TV feature films; TV films)"}, "madsrdf:citationSource": "Google search, Mar. 1, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Television feature. Individual fictional work (often called \"Made for TV movie\") presented on television, usually running from 90 minutes to three hours in length (which may include commercials), and is not part of a regular series or mini-series. Used for Made for TV movie; Television movie)"}, "madsrdf:citationSource": "The moving image genre-form guide, via WWW, Mar. 29, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(made-for-TV movie: Film produced for airing on television. Later, it may have a domestic video or foreign theatrical release. Also called a movie for television, TV movie, telefilm or telepic)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dict., c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Television Movie (Made-for-TV Movie, Movie-for-TV, Movie Made-for-Television, Telefeature, Telefilm, TV Movie, TVM, Vidpic). Formerly, the designation television film used to mean a film of any length (including information and entertainment films) made for the purpose of being shown on television; in recent times, the term telefilm or TV film is generally used to mean a feature-length narrative film made exclusively for television, although some are released theatrically or made available on video-cassette. Made-for-television films are not a recent innovation ... only since 1972 that telefeatures telecast on American networks outnumbered theatrical films shown on TV ... Miniseries, novels for television and some docudramas are forms which differ from TV movies only by their greater length.)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Made for TV movies. Use for a feature-length fictional fictional film made for television broadcast rather than for theatrical release. UF Films on television, Movies on television, TV movies, Telefeatures, Television broadcasting of films (LCSH), Television films, Television movies)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 13 (made-for-TV movie)"}, "madsrdf:citationSource": "The television genre book, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9736341ba0964deb9726c34f233c79c4b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Telefeatures"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telefeatures"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9736341ba0964deb9726c34f233c79c4b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tele-features"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tele-features"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9736341ba0964deb9726c34f233c79c4b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Made-for-TV films"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Made-for-TV films"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9736341ba0964deb9726c34f233c79c4b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Telepics"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telepics"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9736341ba0964deb9726c34f233c79c4b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Features, Television"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Features, Television"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9736341ba0964deb9726c34f233c79c4b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Telemovies"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telemovies"}}, {"@id": "_:n9736341ba0964deb9726c34f233c79c4b30", "@type": ["madsrdf