oc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n0455312abdd34747a0758b2dada410ecb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vampire films"}}, {"@id": "_:n0455312abdd34747a0758b2dada410ecb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0455312abdd34747a0758b2dada410ecb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dracula films"}}, {"@id": "_:n0455312abdd34747a0758b2dada410ecb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dracula films"}}, {"@id": "_:n0455312abdd34747a0758b2dada410ecb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(vampire drama: Use for fictional genre films and programs which focus on vampires, i.e., the living dead, who subsist on human blood, and who live in coffins by day and rise at night; BT Monster drama)"}, "madsrdf:citationSource": "Yee, M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n0455312abdd34747a0758b2dada410ecb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Paranormal films. Films about the paranormal, purported phenomena described in popular culture, folk, and other non-scientific bodies of knowledge, whose existence within these contexts is described as beyond normal experience or scientific explanation; paranormal phenomena include extrasensory perception (ESP), telekinesis, ghosts, poltergeists, life after death, reincarnation, faith healing, human auras, and so forth)"}, "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n0455312abdd34747a0758b2dada410ecb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0455312abdd34747a0758b2dada410ecb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dracula films"}}, {"@id": "_:n0455312abdd34747a0758b2dada410ecb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dracula films"}}], "@id": "/authorities/genreForms/gf2011026716"}
