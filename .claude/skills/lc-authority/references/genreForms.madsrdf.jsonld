da8d004e5ca59b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d60c2cf8a3943d2867da8d004e5ca59b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Copybooks (Pattern books)"}}, {"@id": "_:n4d60c2cf8a3943d2867da8d004e5ca59b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Copybooks (Pattern books)"}}], "@id": "/authorities/genreForms/gf2017027248"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027249", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPhotographs", "identifiers:lccn": "gf2017027249", "madsrdf:adminMetadata": [{"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b1"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Photographs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027266"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026032"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027230"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027261"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026026"}], "madsrdf:hasSource": [{"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b5"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b6"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b7"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b8"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b9"}], "madsrdf:hasVariant": [{"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b10"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b13"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b16"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photographs"}}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pic (informal British English; a photograph, picture, or illustration; plurals: pics, pix)"}, "madsrdf:citationSource": "Collins English dictionary online, Feb. 15, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(photographs; UF Photos; Note: Refers to still images produced from radiation-sensitive materials (sensitive to light, electron beams, or nuclear radiation), generally by means of the chemical action of light on a sensitive film, paper, glass, or metal. It does not include reproductive prints of documents and technical drawings, for which descriptors found under \"reprographic copies\" are more appropriate. Photographs may be positive or negative, opaque or transparent.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, March 31, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Photographs; Scope: The word PHOTOGRAPHS is a general designation for any photographic process. The narrower terms include both physical media and genre categories.; BT Pictures; NT Abstract photographs [and 58 other terms as indicated in scope note]; RT Airbrush works; Mixed media; Montages; Stereographs; Transmitted images; Transparencies)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, March 31, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "RBMS Controlled vocabularies: Genre terms, March 31, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Photographs; UF Photos; Snapshots; BT Pictures; see also subdivision Photographs under subjects for works consisting of actual photographs, that is, photographic prints or digital photographs, rather than reproductions of photographs.; Scope: Here are entered works that discuss photographs themselves as objects of special interest, including their classification, cataloging, copying, coloring, mounting, etc.)"}, "madsrdf:citationSource": "LCSH, March 31, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pix (Photographs)"}}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pix (Photographs)"}}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photos"}}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photos"}}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pics (Photographs)"}}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pics (Photographs)"}}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Snapshots"}}, {"@id": "_:n25e0fbabc2cf4df09136fef7eaf6da29b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Snapshots"}}], "@id": "/authorities/genreForms/gf2017027249"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027250", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPhotomontages", "identifiers:lccn": "gf2017027250", "madsrdf:adminMetadata": [{"@id": "_:n5e7e9821958b41dea0795503807f92f2b1"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Photomontages"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5e7e9821958b41dea0795503807f92f2b3"}]}, "madsrdf:exampleNote": "Note under [Collages]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027218"}, "madsrdf:hasSource": [{"@id": "_:n5e7e9821958b41dea0795503807f92f2b5"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b6"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b7"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b8"}], "madsrdf:hasVariant": [{"@id": "_:n5e7e9821958b41dea0795503807f92f2b9"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b12"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that consist chiefly or wholly of photographic images that are arranged into a somewhat unified composition. For works in two dimensions or low relief in which relatively flat materials, such as paper, cloth, or other materials are fixed to a support, see [Collages.]"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photomontages"}}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(photomontages; variants: photomontage; montages (photographic); note: Refers to combinations of photographic images, or photographic with other images, such as architectural drawings, usually arranged into a somewhat unified image. For photographs produced by printing two or more negatives as one unified image, use \"composite photographs.\" When pieces of photographs or other relatively flat materials are pasted together into less unified images, use \"collages.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, December 13, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Photomontage: a technique of image-making from bits of different preexisting photographs which are cut out, arranged, and pasted down to form a composition, it was largely the creation of the Berlin Dadaists. Prominent among its pioneers were Raoul Hausmann, John Heartfield, and Hannah Hc\u0332h. Photomontage has also been used by Surrealists such as Max Ernst and pop artists such as Richard Hamilton.)"}, "madsrdf:citationSource": "The concise Oxford dictionary of art terms, Oxford reference, viewed December 13, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Montages; UF Photocollages; Photomontages; BT Pictures; RT Collages; Composite photographs; Medley prints; Mixed media; Photographs; scope note: Compositions made by juxtaposing or superimposing multiple pictures to create a single image. May be produced by pasting together whole or partial pictures or by recopying multiple images through photography or scanning. Includes photomontages in both the commercial graphic arts and fine art contexts.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, December 13, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Photocollage; UF Photo collage; BT Collage; scope note: Here are entered works on collage consisting primarily of photographs or reproductions of photographs from magazines, newspapers, etc. Works on combining in a single photographic composition elements from various sources by techniques such as taking a number of exposures on the same negative, or superimposing or juxtaposing negatives to form a composite print, as well as collections of such photographs are entered under Photomontage.)"}, "madsrdf:citationSource": "LCSH, December 13, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5e7e9821958b41dea0795503807f92f2b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photocollages"}}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photocollages"}}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5e7e9821958b41dea0795503807f92f2b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Montages, Photographic"}}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Montages, Photographic"}}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5e7e9821958b41dea0795503807f92f2b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photographic montages"}}, {"@id": "_:n5e7e9821958b41dea0795503807f92f2b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photographic montages"}}], "@id": "/authorities/genreForms/gf2017027250"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027251", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPictures", "identifiers:lccn": "gf2017027251", "madsrdf:adminMetadata": [{"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b1"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pictures"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027266"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027224"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027225"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027248"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026046"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, "madsrdf:hasSource": [{"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b5"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b6"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b7"}], "madsrdf:hasVariant": [{"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b8"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b11"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b14"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b17"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Visual representations that are generally two-dimensional and to which more specific headings such as [Caricatures] or [Coloring books] cannot be assigned. For visual works created for aesthetic purposes, see [Art] or more specific terms such as [Paintings; Photographs; Portraits;] or [Prints.]"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pictures"}}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(images (object genre); variants: image (object genre); note: Depictions and representations on a surface in two dimensions or low relief, or digital, whether the optical counterpart exists in reality or only in imagination. For example, the term may refer to a depiction as distinguished from its support, as when referring to a drawing as distinct from the paper upon which it is drawn. For a representation of an object as opposed to the tangible object itself, as when distinguishing between a photograph or digital image and the art object depicted, use the descriptor \"visual surrogates\" or the UF \"images (visual surrogates).\" For three-dimensional works, use \"objects\" or a more specific term, such as \"sculpture (visual works).\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, October 16, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pictures; BT Objects; NT Abstract works; Airbrush works; Allegories; Amateur works; Animation cels; Brush works; Camera lucida works; Camera obscura works; Caricatures; Cartoons (Commentary); Censored works; Children's art; Collages; Conjectural works; Cut-paper works; Devotional images; Drawings; Genre works; Illustrations; Juvenilia; Montages; Paintings; Photographs; Portraits; Posters; Prints; Reconstructions; Sandpaintings; Still lifes; Three-in-one pictures; Transparencies; Ukiyo-e; Views; Vignettes; RT Design drawings; Electronic images; scope note: Visual presentations, primarily two-dimensional.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, October 16, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pictures; UF Iconography; Pictorial representations; BT Art; Visual aids; SA Pictorial works; NT Caricatures and cartoons; Cataloging of pictures; Digital images; Illustration of books; Libraries and pictures; Oval pictures; Photographs; Portraits; Posters; Preserved flower pictures; Transparencies; Views; scope note: Here are entered works that discuss pictures themselves as objects of special interest, including their classification, cataloging, copying, printing, mounting, etc. Pictures that are representative of particular art media are entered under the medium, e.g. Painting; Engraving; etc.)"}, "madsrdf:citationSource": "LCSH, October 16, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Illustrations"}}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Illustrations"}}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pictorial representations"}}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pictorial representations"}}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graphic works"}}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic works"}}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Images"}}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Images"}}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pictorial works"}}, {"@id": "_:n2b3d0cfc346f45a2bd016d08a9d7e2e0b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pictorial works"}}], "@id": "/authorities/genreForms/gf2017027251"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027252", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPlaying cards", "identifiers:lccn": "gf2017027252", "madsrdf:adminMetadata": [{"@id": "_:n3cb6908a3c6544c9857b553cd802494fb1"}, {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Playing cards"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3cb6908a3c6544c9857b553cd802494fb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026027"}, "madsrdf:hasSource": [{"@id": "_:n3cb6908a3c6544c9857b553cd802494fb5"}, {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb6"}, {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb7"}], "madsrdf:hasVariant": {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Sets of cards that either follow a standard suit or have specialized markings and are used as game accessories or in fortune telling."}, {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Playing cards"}}, {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playing cards; cards, playing; BT recreational artifacts (equipment); SN Cards made in sets of a designated number and marked for use as game accessories during play. The markings or designs may follow a standard suit or rank system or may be special and individualized.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, April 18, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Playing cards; BT Cards; NT Fortune telling cards; Game cards; SN: Cards made in sets of a designated number of cards and marked for use in playing one or more games or telling fortunes.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, April 18, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Playing cards; UF Cards, Playing; Cards [Earlier established form]; BT Card games--Equipment and supplies; RT Card shuffling)"}, "madsrdf:citationSource": "LCSH, April 18, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3cb6908a3c6544c9857b553cd802494fb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cards, Playing"}}, {"@id": "_:n3cb6908a3c6544c9857b553cd802494fb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cards, Playing"}}], "@id": "/authorities/genreForms/gf2017027252"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027253", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPolitical cartoons", "identifiers:lccn": "gf2017027253", "madsrdf:adminMetadata": [{"@id": "_:nbcfc018d8c2240daae672023921b9e37b1"}, {"@id": "_:nbcfc018d8c2240daae672023921b9e37b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Political cartoons"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbcfc018d8c2240daae672023921b9e37b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027225"}, "madsrdf:hasSource": [{"@id": "_:nbcfc018d8c2240daae672023921b9e37b5"}, {"@id": "_:nbcfc018d8c2240daae672023921b9e37b6"}, {"@id": "_:nbcfc018d8c2240daae672023921b9e37b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbcfc018d8c2240daae672023921b9e37b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbcfc018d8c2240daae672023921b9e37b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nbcfc018d8c2240daae672023921b9e37b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Political cartoons"}}, {"@id": "_:nbcfc018d8c2240daae672023921b9e37b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Political cartoons; UF Cartoons, Political; BT Caricatures and cartoons; Wit and humor, Pictorial; SEE ALSO subdivisions History--Caricatures and cartoons and Politics and government--Caricatures and cartoons under countries, cities, etc., e.g. United States--Politics and government--1969-1974--Caricatures and cartoons; SN Here are entered works on the history and art of drawing political cartoons. Works consisting of general collections of political cartoons are entered under World politics--Caricatures and cartoons. Works consisting of collections of political cartoons pertaining to a specific region, country, city, etc., are entered under the name of the place with subdivision History--Caricatures and cartoons or Politics and government--Caricatures and cartoons.)"}, "madsrdf:citationSource": "LCSH, March 12, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nbcfc018d8c2240daae672023921b9e37b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Political cartoons; BT Cartoons (Commentary); RT Editorial cartoons); SN Cartoons that present a viewpoint on a contemporary political issue, situation, public figure, or institution. They frequently employ wit, satire, or caricature, and may use a vocabulary of symbols, types, or figures to represent political entities, bodies, or principles.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, March 12, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nbcfc018d8c2240daae672023921b9e37b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(political cartoons; SN Cartoons which act as visual satire, combining exaggerated caricature with political statements. The form became popular in French graphic art during the 19th century, particularly with artist Honor Daumier.; UF political cartoon; cartoons, political; BT cartoons (humorous images))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, March 12, 2017", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027253"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027254", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPortraits", "identifiers:lccn": "gf2017027254", "madsrdf:adminMetadata": [{"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b1"}, {"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Portraits"}, "madsrdf:elementList": {"@list": [{"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b3"}]}, "madsrdf:exampleNote": "Example under [Pictures]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027266"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027260"}, "madsrdf:hasSource": [{"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b5"}, {"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b6"}, {"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b7"}, {"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Images that are intended to portray one or more persons, fictitious characters, or mythological beings."}, {"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Portraits"}}, {"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Portrait: a painting, drawing, photograph, or engraving of a person, especially one depicting only the face or head and shoulders.)"}, "madsrdf:citationSource": "Oxford dictionary of English (3rd ed.), Oxford reference, October 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Portraits; BT Pictures; NT Group portraits; Portrait drawings; Portrait paintings; Portrait photographs; Portrait prints; Self-portraits; RT Caricatures; Crayon enlargements; Family trees; Posing; Silhouettes; scope note: Graphic representations, especially of the face, of real persons, usually posed, living or dead. Pictures whose purpose is the portrayal of an individual or several people, not pictures that merely include people as part of an event or scene.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, October 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(portraits; variant: portraiture; note: Representations of real individuals that are intended to capture a known or supposed likeness, usually including the face of the person. For representations intended to be anonymous, or of fictional or mythological characters, see \"figures (representations).\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, October 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n10b1b15e503a4d2db6e5b6d44d67c191b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Portraits; UF Portraiture; BT Art; Biography; Pictures; RT Block books; Block printing; NT Biography-18th century-Portraits; Biography-20th century-Portraits; Crowned-nun portraits; Effigies; Equestrian portraits; Jewish portraits; Portrait medallions; Portrait miniatures; Portraits, Group; Portraits on pottery; Portraits on quilts; Profile portraits; Self-portraits; Silhouettes; Spirit portraits)"}, "madsrdf:citationSource": "LCSH, October 9, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027254"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027255", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPrints", "identifiers:lccn": "gf2017027255", "madsrdf:adminMetadata": [{"@id": "_:nb9828521a8424a0790666480788bf1bcb1"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Prints"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb9828521a8424a0790666480788bf1bcb3"}]}, "madsrdf:exampleNote": "Example under [Pictures]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027266"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027239"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027241"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027256"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027258"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026034"}], "madsrdf:hasSource": [{"@id": "_:nb9828521a8424a0790666480788bf1bcb5"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb6"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb7"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb8"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb9"}], "madsrdf:hasVariant": [{"@id": "_:nb9828521a8424a0790666480788bf1bcb10"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb13"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb16"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Images that are formed by transfer from one surface or source to another, and that are usually created with ink and produced in multiple impressions."}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prints"}}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Prints; UF Fine prints; BT Graphic arts; NT Altered prints; Buddhist prints; Color prints; Engraving; Erotic prints; Etching; Fashion prints; Genre prints; Historical prints; Indian prints; Jewish prints; Landscape prints; Large prints; Lithography; Marine prints; Miniature printing; Miniature prints; Nature prints; Naval prints; Portrait prints; Potato prints; Relief printing; Shinto prints; Sporting prints; Stonecut prints; Vitreographs; Wood-engraving; Wood-engraving-Printing)"}, "madsrdf:citationSource": "LCSH, August 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "RBMS Controlled vocabularies: Genre terms, August 14, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Print: An image or design impressed or stamped on a support such as paper or fabric. The term encompasses a wide range of techniques used to produce multiple versions of an original design.)"}, "madsrdf:citationSource": "The concise Oxford dictionary of art terms, Oxford art online, August 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Prints; BT Pictures; NT A la poup\u011b prints; Abstract prints; Allegorical prints; Artists' proofs; Baxter-process prints; Baxter prints; Bird's-eye view prints; Cast paper prints; Cellocuts; Chine coll \u030cprints; Cityscape prints; Cloth prints; Collagraphs; Commemorative prints; Costume prints; Counterproofs; Digital prints; Embossed prints; Fashion prints; Fish prints; Genre prints; Intaglio prints; Landscape prints; Marine prints; Medley prints; Naval prints; Photomechanical prints; Planographic prints; Portrait prints; Progressive proofs; Proofs before letters; Relief prints; Reproductive prints; Restrikes; Seascape prints; Still life prints; Trial proofs; Vues d'optique; scope note: Images formed by transfer from one surface or source to another. Usually created with ink(s) and produced in multiple impressions.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, June 10, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(prints (visual works); variants: print (visual work); artists' prints; fine-art prints; fine art prints; fine-arts prints; fine prints; note: Pictorial works produced by transferring images by means of a matrix such as a plate, block, or screen, using any of various printing processes. With regard to photographs, prefer \"photographic prints\"; for types of reproductions of technical drawings and documents, see terms found under \"reprographic copies.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, August 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9828521a8424a0790666480788bf1bcb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Artists' prints"}}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Artists' prints"}}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9828521a8424a0790666480788bf1bcb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fine prints"}}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fine prints"}}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9828521a8424a0790666480788bf1bcb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fine art prints"}}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fine art prints"}}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9828521a8424a0790666480788bf1bcb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fine arts prints"}}, {"@id": "_:nb9828521a8424a0790666480788bf1bcb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fine arts prints"}}], "@id": "/authorities/genreForms/gf2017027255"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027256", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRelief prints", "identifiers:lccn": "gf2017027256", "madsrdf:adminMetadata": [{"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb1"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Relief prints"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027255"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027240"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027268"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027269"}], "madsrdf:hasSource": [{"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb5"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb6"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb7"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb8"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb9"}], "madsrdf:hasVariant": {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Prints made from ink applied on the raised areas of the printing block or plate after the other areas have been carved or etched away."}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Relief prints"}}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(relief printing; note: Printing processes in which the nonprinting areas of the block or plate are carved, engraved, or etched away, leaving the original plane surface raised so that ink is deposited and transferred to paper. Traditionally a woodcut technique, relief printing developed into letterpress for the printing of text and wood engraving to provide accompanying illustrations. It is one of the oldest printing techniques known.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, November 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(relief prints; variants: relief print; block prints; prints, relief; relief-prints; note: Prints made using a process of relief printing.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, November 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 327 (relief print: a print made by any ink printing process in which the high parts of the printing surface take ink and transfer it to the print support. The most common relief processes are woodcut, wood engraving, letterpress (from metal type or halftone cuts), and linoleum cut.)"}, "madsrdf:citationSource": "Benson, R. The printed picture, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Relief prints; UF Block prints; BT Prints; NT Cerographs; Letterpress works; Linocuts; Metal cuts; Relief printed etchings; Rubbings; Wood engravings; Woodcuts; RT A la poup\u011b prints; Cellocuts; Collagraphs)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, November 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Relief printing: in art printmaking, a process consisting of cutting or etching a printing surface in such a way that all that remains of the original surface is the design to be printed. Examples of relief-printing processes include woodcut, anastatic printing (also called relief etching), linocut, and metal cut.)"}, "madsrdf:citationSource": "Britannica academic, viewed November 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Block prints"}}, {"@id": "_:nc796e4deaab84dd6b96e5b2629186c2eb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Block prints"}}], "@id": "/authorities/genreForms/gf2017027256"}
