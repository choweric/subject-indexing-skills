{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026806", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFlamenco music", "identifiers:lccn": "gf2014026806", "madsrdf:adminMetadata": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b1"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Flamenco music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027063"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027080"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027086"}], "madsrdf:hasSource": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b5"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b6"}], "madsrdf:hasVariant": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b7"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b10"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b13"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b16"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b19"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b22"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b25"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b28"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b31"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flamenco music"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "flamenco (cante flamenco; generic term applied to a particular body of cante (song), baile (dance) and toque (solo guitar music), mostly emanating from Andalucia in southern Spain; also known as cante andaluz, cante gitano or ca\u00f1i (\"Gypsy song\") and cante hondo (\"deep song\"). Although these terms have been used interchangeably, modern studies avoid such nomenclature except for cante hondo, an important subdivision of cante flamenco.)"}, "madsrdf:citationSource": "New Grove dict. of mus. online, Jun. 21, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the repertory includes characteristic styles of singing (including cante hondo or jondo), dancing, and guitar playing)"}, "madsrdf:citationSource": "New Harvard dict. of mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cante flamenco"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cante flamenco"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hondo, Cante"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hondo, Cante"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ca\u00f1i, Cante"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ca\u00f1i, Cante"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cante jondo"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cante jondo"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cante hondo"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cante hondo"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cante ca\u00f1i"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cante ca\u00f1i"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cante andaluz"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cante andaluz"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jondo, Cante"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jondo, Cante"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Andaluz, Cante"}}, {"@id": "_:n8a78d640f18a4bc882f8ec0923aa0295b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Andaluz, Cante"}}], "@id": "/authorities/genreForms/gf2014026806"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026807", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFolias (Music)", "identifiers:lccn": "gf2014026807", "madsrdf:adminMetadata": [{"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b1"}, {"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Folias (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027156"}], "madsrdf:hasSource": [{"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b5"}, {"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b6"}], "madsrdf:hasVariant": {"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folias (Music)"}}, {"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A dance, probably Portuguese in origin, the characteristic harmonic framework of which was adopted by several 17th- and 18th-century composers as the basis of sets of variations. )"}, "madsrdf:citationSource": "Oxford companion to music online, viewed August 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folia. A term for a musical framework used during the Baroque period for songs, dances and sets of variations. In the late 17th century a related, alternative form gained popularity and for some time co-existed with the original model.)"}, "madsrdf:citationSource": "Grove music online, viewed August 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Follias (Music)"}}, {"@id": "_:n0e8884a994624dc08771b67eba9f7fa4b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Follias (Music)"}}], "@id": "/authorities/genreForms/gf2014026807"}
