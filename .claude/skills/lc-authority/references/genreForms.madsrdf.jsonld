{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026737", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWestern television programs", "identifiers:lccn": "gf2011026737", "madsrdf:adminMetadata": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b1"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Western television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b5"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026578"}, "madsrdf:hasSource": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b8"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b9"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b10"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b11"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b12"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b13"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b14"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b15"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b16"}], "madsrdf:hasVariant": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b17"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b20"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b23"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b26"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b29"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b32"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b35"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b38"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b41"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b44"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b47"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that feature the American West during the period of westward expansion.", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026751"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025310"}]}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:04:06"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Western television programs"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Zorro television programs"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zorro television programs"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 107 (sagebrush sagas)"}, "madsrdf:citationSource": "Kirkley, D.H. A descriptive study of the network television western during the seasons 1955-1956--1962-1963, 1979, via Google books, viewed Oct. 4, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"cowboy and Indian\" television shows; cowboy and Indian television programs; cowboy and Indian television movies; television westerns)"}, "madsrdf:citationSource": "Google search, Oct. 4, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Western; a film genre since earliest days of motion pictures that derives from the history and legends of the western part of this country, especially during the last half of the nineteenth century ... The most impressive, human, but still self-critical Western in recent years has not been made for the movie screen, but was made for television--the four-part series Lonesome Dove (1989))"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dictionary, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Western television programs)"}, "madsrdf:citationSource": "LCSH, July 30, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Western: Fictional work set in the period of American westward expansion. Although usually set in the western United States from 1865-1900, settings in the Western may extend back to the era of America's colonial period, or as far geographically as Mexico, and into the first half of the 20th century. Many westerns made through the 1950s used a contemporary setting for traditional western narratives, and a few examples of the genre continue to be made, set in modern times)"}, "madsrdf:citationSource": "Moving image genre-form guide online, July 30, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sagebrush saga: Nickname for a Western movie. Also called a sagebrusher. Entertainment trade paper use.)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dictionary, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Western (Cowboy Film, Western Film). Westerns are an amalgam of myth, history and legend--fantasy and reality intertwine. Set on the North American continent (movies set in Latin America, Australia, South Africa, or other lands are not authentic Westerns), they are based on tradition and a solid historical heritage. Many western heroes existed in real life ... and some of the Western sagas describe real historical episodes of the conquest of the American West; peopled by a profusion of colorful and familiar types--cowboys, Indians, U.S. marshalls, rangers, bounty hunters, Mexicans, half-breeds, saloon girls, homesteaders, carpetbaggers and John Wayne who appeared in 153 movies; fall under seven basic plot types; the terms oater, oats opera, horse opera or horse opry are synonymous with Western; they also have a derogatory meaning indicating a cheaply made film about cowboys--a B-Western. A sagebrusher is another slang term for a Western)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 103 (Westerns: fictional genre films and programs set on the American frontier and/or in the American West. A common theme is the coming of civilization and law to the wilderness)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Western (genre). The Western is a genre of various visual arts, such as film, television, radio, literature, painting and others. Westerns are devoted to telling stories set primarily in the latter half of the 19th century in the American Old West). Some Westerns are set as early as the Battle of the Alamo in 1836. There are also a number of films about Western-type characters in contemporary settings, such as Junior Bonner set in the 1970s and The Three Burials of Melquiades Estrada in the 21st century. The American Film Institute defines western films as those \"set in the American West that embod[y] the spirit, the struggle and the demise of the new frontier.\")"}, "madsrdf:citationSource": "Wikipedia, Oct. 4, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sagebrushers (Television programs)"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sagebrushers (Television programs)"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oats operas (Television programs)"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oats operas (Television programs)"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television westerns"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television westerns"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Horse operas (Television programs)"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horse operas (Television programs)"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Horse opries (Television programs)"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horse opries (Television programs)"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Westerns (Television programs)"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Westerns (Television programs)"}}, {"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n59cf490dec8742c6bfe164f0f63bf800b36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oaters (Television programs)"}}, {"@id": "_:n59cf490dec8742c6b