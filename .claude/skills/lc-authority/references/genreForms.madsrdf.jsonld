{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026470", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPromotional films", "identifiers:lccn": "gf2011026470", "madsrdf:adminMetadata": [{"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b1"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Promotional films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b3"}]}, "madsrdf:exampleNote": "Note under: [Sponsored films]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026423"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026038"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026599"}, "madsrdf:hasSource": [{"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b5"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b6"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b7"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b8"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b9"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b10"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b11"}], "madsrdf:hasVariant": [{"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b12"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b15"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b18"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that promote or advertise a product, industry, service, organization, etc. For films produced, subsidized, financed, or otherwise significantly supported by a business, government body, organization, etc., see [Sponsored films.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025542"}}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:36:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Promotional films"}}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Promo 3. Any promotional short film or videotape)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dictionary, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Promotional films)"}, "madsrdf:citationSource": "LCSH, Feb. 25, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Glossary, p. 24 (Promotional materials: presentations designed to carry a message about a particular moving image work to exhibitors, sponsors, agents, etc.)"}, "madsrdf:citationSource": "Archival moving image materials : a cataloging manual, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Company promotion: work which promotes a company or industry, usually by detailing noteworthy accomplishments, but does not actually promote a product or service. Such work is typically commercial-length, from 10 seconds to 3 minutes; Infomercial: Work promoting a product or service that usually lasts at least 30 min.; Political commercial: Work which promotes certain candidates, political parties, or political views, varying in length from short commercials (a few minutes or less) to longer programs lasting an hour or more; Promotional announcement: Work which promotes a network or promotes a particular television show; Public service announcement: Work which promotes certain charitable causes or types of behavior; Advertising: work which promotes a product, service, candidate, or company. Include promotional work for consumer products and services shown in theaters. UF Promotional)"}, "madsrdf:citationSource": "Moving image genre-form guide online, Feb. 25, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Promotional film: Any nonfictional film made to promote or publicize a specific business, industry, or cause)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dictionary, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(promotional film: A nonfiction motion picture of any length made to publicize or further the interests of a specific business, industry, organization, cause, etc., for example, Walt Disney's last film, a 1966 preview to EPCOT. Abbreviated promo film)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS: online dictionary for library and information science, viewed Feb. 24, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 26 (Advertising: use for films and programs the primary purpose of which is to sell a product or service. UF: Promotional works) p. 81 (Public relations films: used for nonfiction films and video designed to cause the public and/or customers or clients to take a favorable view towards an institution or business)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Advertising films"}}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Advertising films"}}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Company promotion films"}}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Company promotion films"}}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Promo films"}}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Promo films"}}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Public relations films"}}, {"@id": "_:n74f42974bd7c4429b12b3596fc9f4358b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Public relations films"}}], "@id": "/authorities/genreForms/gf2011026470"}
