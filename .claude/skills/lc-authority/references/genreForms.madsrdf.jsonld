{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026024", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSamurai comics", "identifiers:lccn": "gf2015026024", "madsrdf:adminMetadata": [{"@id": "_:nbf007d8751df482887e73ad713262b60b1"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Samurai comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbf007d8751df482887e73ad713262b60b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:nbf007d8751df482887e73ad713262b60b5"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b6"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b7"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b8"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b9"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b10"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b11"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b12"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that feature samurai and are usually set in the Tokugawa period of Japanese history."}, {"@id": "_:nbf007d8751df482887e73ad713262b60b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:12:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Samurai comics"}}, {"@id": "_:nbf007d8751df482887e73ad713262b60b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ronin (DC Comics) (Ronin (formally written as R\u014dnin) is a comic book limited series published between 1983 and 1984, by DC Comics. The series was written and drawn by Frank Miller with artwork painted by Lynn Varley. It takes place in a dystopic near-future New York in which a ronin is reincarnated; samurai comic books) R\u014dnin (A r\u014dnin was a samurai with no lord or master during the feudal period (1185-1868) of Japan. A samurai became masterless from the death or fall of his master, or after the loss of his master's favor or privilege.)"}, "madsrdf:citationSource": "Wikipedia, May 27, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "2014430261: Samura, H. Mugen no j\u016bnin. English. Blade of the immortal, 1997-", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "2013018738: Wilson, S.M. The 47 Ronin : a graphic novel, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kalonji, J.-P. 365 samurai and a few bowls of rice, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Richardson, M. 47 Ronin, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Amano, J. Ronin Hood of the 47 Samurai, 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "2014430269: Koike, K. Samurai executioner omnibus, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Okazaki, T. Afro Samurai, c2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf007d8751df482887e73ad713262b60b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2014015203: Miller, F. Ronin, the deluxe edition, 2014.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026024"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026025", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aApocryphal works", "identifiers:lccn": "gf2015026025", "madsrdf:adminMetadata": [{"@id": "_:n094bf4dd4e924d2e9279f9a45c8cdceab1"}, {"@id": "_:n094bf4dd4e924d2e9279f9a45c8cdceab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Apocryphal works"}, "madsrdf:elementList": {"@list": [{"@id": "_:n094bf4dd4e924d2e9279f9a45c8cdceab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026026"}, "madsrdf:hasSource": {"@id": "_:n094bf4dd4e924d2e9279f9a45c8cdceab5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that are excluded from the sacred canon of a religion, denomination, sect, etc., e.g., the apocryphal gospels; the Tripi\u1e6daka apocryphal works."}, {"@id": "_:n094bf4dd4e924d2e9279f9a45c8cdceab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-23T11:19:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n094bf4dd4e924d2e9279f9a45c8cdceab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-06-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n094bf4dd4e924d2e9279f9a45c8cdceab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Apocryphal works"}}, {"@id": "_:n094bf4dd4e924d2e9279f9a45c8cdceab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Apocryphal works Scope note: This heading is used for writings or statements of questionable authorship or authenticity. For biblical literature, these are books excluded from both the Catholic canon and the Protestant and Jewish canons of the Old Testament and from the Catholic and Protestant canons of the New Testament. Examples include the apocryphal gospels and Tripi\u1e6daka apocryphal books.)"}, "madsrdf:citationSource": "Religion genre/form terms: information gathered on behalf of the Library of Congress... American Theological Library Association, et. al, c2012:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026025"}
