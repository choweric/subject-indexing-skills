{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026373", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHorror fiction", "identifiers:lccn": "gf2014026373", "madsrdf:adminMetadata": [{"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b1"}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Horror fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026047"}, "madsrdf:hasSource": [{"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b5"}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b6"}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b7"}], "madsrdf:hasVariant": [{"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b8"}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that is intended to shock or frighten by inducing feelings of revulsion, terror, or loathing."}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T15:29:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horror fiction"}}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(horror fiction; horror stories; scary stories; scary tales; stories of fantasy and horror; horror novels; tales of terror)"}, "madsrdf:citationSource": "LC database, Nov. 12, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Horror story: a fictional narrative which shocks or even frightens the reader, and/or perhaps induces a feeling of repulsion or loathing.)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, c1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The goal of horror fiction is to produce fear in readers, sometimes through psychology, sometimes through gory details, and its appeal occurs on a very deep emotional level. It contains a monster of some type, and supernatural elements figure prominently. Thus, horror certainly includes stories of ghosts, ghouls, werewolves, and vampires of wide variety. The genre runs the gamut from contemporary tales filled with graphic sex as well as gore, to classics such as Bram Stoker's Dracula, which creates the loathsome vampire, hunted by those who fear him. What is important is the feeling of foreboding that permeates the novels, the sense of unease as we await the unexpected.)"}, "madsrdf:citationSource": "Saricks, J. The reader's advisory guide to genre fiction, c2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scary fiction"}}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scary fiction"}}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Terror fiction"}}, {"@id": "_:n78cecad0852a4be7b5d0d58c44233c50b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Terror fiction"}}], "@id": "/authorities/genreForms/gf2014026373"}
