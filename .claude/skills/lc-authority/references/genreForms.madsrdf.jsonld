ce": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n4f94e780d04c4240b81e4243e218e31db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sketchbooks"}}, {"@id": "_:n4f94e780d04c4240b81e4243e218e31db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sketchbooks; UF Sketchpads; BT Albums; SN Albums of drawings or paintings on pages bound together before the images were created."}, "madsrdf:citationSource": "Thesaurus for graphic materials, April 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f94e780d04c4240b81e4243e218e31db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sketchbooks; UF sketch books, sketch-books; SN Books or pads of blank sheets used or intended for sketching, which are informal or rough drawings.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, April 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f94e780d04c4240b81e4243e218e31db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Notebooks; UF Exercise books; Sketchbooks; BT Books)"}, "madsrdf:citationSource": "LCSH, April 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f94e780d04c4240b81e4243e218e31db8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4f94e780d04c4240b81e4243e218e31db9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sketch books"}}, {"@id": "_:n4f94e780d04c4240b81e4243e218e31db9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sketch books"}}, {"@id": "_:n4f94e780d04c4240b81e4243e218e31db11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4f94e780d04c4240b81e4243e218e31db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sketchpads"}}, {"@id": "_:n4f94e780d04c42