{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027223", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBook objects", "identifiers:lccn": "gf2017027223", "madsrdf:adminMetadata": [{"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb1"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Book objects"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb3"}]}, "madsrdf:exampleNote": "Note under [Artists' books]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027259"}, "madsrdf:hasSource": [{"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb5"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb6"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb7"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb8"}], "madsrdf:hasVariant": [{"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb9"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb12"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Sculptural works that mimic the format or structure of the book. For books that are produced by artists and intended as visual art objects, see [Artists' books.]"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Book objects"}}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(book objects; variants: book object; objects, book; note: Art which makes use of the book format or the structure of the book; typically usage is limited to unique sculptural works that take the form of, or incorporate, books but that do not communicate in the ways characteristic of a conventional book, such as being experienced sequentially. For books made or conceived by visual artists, use \"artists' books\" or \"bookworks.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, August 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCSH, August 14, 2016;RBMS Controlled vocabularies: Genre terms, August 14, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page C21(L) (blooks; term coined by Mindell Dubansky to designate objects made to mimic the form of books)"}, "madsrdf:citationSource": "New York Times, January 29, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 14 (bookobject; describe books that assume a sculptural role based on formal qualities rather than informational capacity)"}, "madsrdf:citationSource": "Art libraries journal, volume 28/4 (2003):", "madsrdf:citationStatus": "found"}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Blooks"}}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blooks"}}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Objects, Book"}}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Objects, Book"}}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bookobjects"}}, {"@id": "_:nf55e990bf90a4d2bb5240de925408c7cb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bookobjects"}}], "@id": "/authorities/genreForms/gf2017027223"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027224", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCaricatures", "identifiers:lccn": "gf2017027224", "madsrdf:adminMetadata": [{"@id": "_:n922f867213d1420db0a9a88a103397dfb1"}, {"@id": "_:n922f867213d1420db0a9a88a103397dfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Caricatures"}, "madsrdf:elementList": {"@list": [{"@id": "_:n922f867213d1420db0a9a88a103397dfb3"}]}, "madsrdf:exampleNote": "Example under [Pictures]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027251"}], "madsrdf:hasSource": [{"@id": "_:n922f867213d1420db0a9a88a103397dfb5"}, {"@id": "_:n922f867213d1420db0a9a88a103397dfb6"}, {"@id": "_:n922f867213d1420db0a9a88a103397dfb7"}, {"@id": "_:n922f867213d1420db0a9a88a103397dfb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Images, especially portraits, that exaggerate certain features or characteristics to humorous or ludicrous effect."}, {"@id": "_:n922f867213d1420db0a9a88a103397dfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n922f867213d1420db0a9a88a103397dfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n922f867213d1420db0a9a88a103397dfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Caricatures"}}, {"@id": "_:n922f867213d1420db0a9a88a103397dfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Caricatures; UF Stereotypes; BT Cartoons (Commentary); RT Ethnic stereotypes; Portraits; scope note: Cartoons that portray in a critical or facetious way a real individual or group, or a figure representing a social, political, ethnic, or racial type. The effect is usually achieved through distortion or exaggeration of the features or form.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, June 10, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n922f867213d1420db0a9a88a103397dfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(caricatures; UF caricature; Zerrbild; note: Exaggerated, distorted representations of a subject in art or literature; in art, refers particularly to representations, often portraits, that exaggerate certain features or characteristics to humorous or ludicrous effect.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, June 10, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n922f867213d1420db0a9a88a103397dfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Caricatures; BT Humorous works (gathering term); Illustrated works; RT Cartoons; scope note: Use for verbal or visual works which portray in a critical or facetious way a real individual or group, or a figure representing a social, political, ethnic, or racial type. The effect is usually achieved through distortion or exaggeration of some characteristic or characteristics.)"}, "madsrdf:citationSource": "RBMS Controlled vocabularies: Genre terms, June 10, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n922f867213d1420db0a9a88a103397dfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Caricatures and cartoons; UF Cartoons; Humorous illustrations; Illustrations, Humorous; Pictures, Humorous; BT Pictures; RT Caricature; Wit and humor, Pictorial; see also subdivision Caricatures and cartoons under names of individual persons, families, and corporate bodies and under classes of persons, ethnic groups, topical subjects, and individual wars, for collections or discussions of caricatures or pictorial humor about these persons or topics; and headings for individual cartoon characters, e.g. Mickey Mouse (Fictitious character); LCSH also has the process Caricature; BT Art; Drawing; Satire; RT Caricatures and cartoons; Parody.)"}, "madsrdf:citationSource": "LCSH, June 10, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027224"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027225", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCartoons (Humor)", "identifiers:lccn": "gf2017027225", "madsrdf:adminMetadata": [{"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab1"}, {"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cartoons (Humor)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab3"}]}, "madsrdf:exampleNote": "Note under [Comics (Graphic works)]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027251"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027253"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026103"}], "madsrdf:hasSource": [{"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab5"}, {"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab6"}, {"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Pictures that use wit and/or satire to comment on events, social habits, politics, or other subjects. For narrative works that employ sequential art, and often prose, to tell a story, see [Comics (Graphic works).]"}, {"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cartoons (Humor)"}}, {"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Caricatures and cartoons; UF Cartoons; Humorous illustrations; Illustrations, Humorous; Pictures, Humorous; BT Pictures; RT Caricature; Wit and humor, Pictorial; SEE ALSO subdivision Caricatures and cartoons under names of individual persons, families, and corporate bodies and under classes of persons, ethnic groups, topical subjects, and individual wars, for collections or discussions of caricatures or pictorial humor about these persons or topics; and headings for individual cartoon characters, e.g. Mickey Mouse (Fictitious character))"}, "madsrdf:citationSource": "LCSH, March 12, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(cartoons (humorous images); UF cartoon (humorous image); SN Pictorial images, usually drawings, that are humorous or that use wit and satire to comment on contemporary events, social habits, political trends, or other topical subjects, often executed in a broad or abbreviated manner. Originally referred to full-page illustrations in a circulating paper or periodical, especially when comical and relating to current events.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, March 12, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n58a639ddefca4d098a1d27f0ae6d9a8ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cartoons (Commentary); SN Pictorial images using wit to comment on such things as contemporary events, social habits, or political trends; usually executed in a broad or abbreviated manner.; UF Cartoons; Comic pictures; BT Pictures; NT Comic cards; Comics; Editorial cartoons; Political cartoons; Satires (Visual works); RT Humorous pictures; Protest works)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, March 12, 2017", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027225"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027226", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCartoons (Working drawings)", "identifiers:lccn": "gf2017027226", "madsrdf:adminMetadata": [{"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb1"}, {"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cartoons (Working drawings)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027231"}, "madsrdf:hasSource": [{"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb5"}, {"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb6"}, {"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb7"}, {"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Full-sized preparatory drawings created to transfer a design to the working surface of a painting, tapestry, or other large work."}, {"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cartoons (Working drawings)"}}, {"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCSH, August 30, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cartoon; Drawing, sometimes coloured, made specifically as a pattern for a painting, textile or stained-glass panel. It is produced on the same scale as the final work and is usually fairly detailed. The transfer of the image works best if the drawing in the cartoon is of a linear nature and if the composition has crisp, clear outlines.)"}, "madsrdf:citationSource": "Grove Art Online, August 16, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cartoons (Working drawings); Scope Note: Full-size preparatory drawings made to transfer a design to the working surface of a painting, tapestry, or other large work. UF Cartoon patterns. BT Working drawings)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, August 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a5f5625a3404897b80ac035cdd1f77fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(cartoons (working drawings); UF cartoon (working drawing); Note: Refers to full-size preparatory drawings made for the purpose of transferring a design to the working surface of a painting, tapestry, or other large work.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, August 16, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027226"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027227", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCollages", "identifiers:lccn": "gf2017027227", "madsrdf:adminMetadata": [{"@id": "_:n18cfccebdf144e07a5d8f62840772569b1"}, {"@id": "_:n18cfccebdf144e07a5d8f62840772569b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Collages"}, "madsrdf:elementList": {"@list": [{"@id": "_:n18cfccebdf144e07a5d8f62840772569b3"}]}, "madsrdf:exampleNote": "Note under [Photomontages]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027218"}, "madsrdf:hasSource": [{"@id": "_:n18cfccebdf144e07a5d8f62840772569b5"}, {"@id": "_:n18cfccebdf144e07a5d8f62840772569b6"}, {"@id": "_:n18cfccebdf144e07a5d8f62840772569b7"}, {"@id": "_:n18cfccebdf144e07a5d8f62840772569b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works in two dimensions or low relief in which relatively flat materials, such as paper, cloth, or other materials are fixed to a support. For works that consist chiefly or wholly of photographic images that are arranged into a somewhat unified composition, see [Photomontages.]"}, {"@id": "_:n18cfccebdf144e07a5d8f62840772569b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n18cfccebdf144e07a5d8f62840772569b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n18cfccebdf144e07a5d8f62840772569b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Collages"}}, {"@id": "_:n18cfccebdf144e07a5d8f62840772569b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Collages; BT Pictures; RT Mixed media; Montages; Scope: Mixed media constructions in which bits of relatively flat materials, such as newspaper or cloth, or three-dimensional objects, are fixed to a support for symbolic or suggestive effect.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, June 5, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n18cfccebdf144e07a5d8f62840772569b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collages (visual works); UF collage (visual work); Note: Works in two dimensions or very low relief that were made by gluing paper, fabrics, photographs, or other materials onto a flat surface; NT applique prints (collages); papiers colle; photocollages (photographic compositions); AAT also has \"collage (technique)\" as term)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, June 5, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n18cfccebdf144e07a5d8f62840772569b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "RBMS Controlled vocabularies: Genre terms, June 5, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n18cfccebdf144e07a5d8f62840772569b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Collage; UF Collages; BT Art; Found objects (Art); Handicraft; Montage)"}, "madsrdf:citationSource": "LCSH, June 5, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027227"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027228", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCollection catalogs", "identifiers:lccn": "gf2017027228", "madsrdf:adminMetadata": [{"@id": "_:n8bf4d661363e4f678e3144613536324ab1"}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Collection catalogs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8bf4d661363e4f678e3144613536324ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026057"}, "madsrdf:hasSource": [{"@id": "_:n8bf4d661363e4f678e3144613536324ab5"}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab6"}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab7"}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab8"}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Scholarly listings of collections of objects or materials, especially those contained in museums or archives."}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Collection catalogs"}}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Collection catalog, or collections catalog; in museums and archives for catalog of objects or material)"}, "madsrdf:citationSource": "Wikipedia, June 15, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCSH, June 15, 2016;Art & architecture thesaurus online, June 15, 2016;Thesaurus for graphic materials, June 15, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "MetPublications page (\"Notable collection catalogues\" is one of main links by type of publication along with \"Favorite Met titles\" and \"Notable exhibition catalogues\" and \"Book titles with full text online\")"}, "madsrdf:citationSource": "Metropolitan Museum of Art website, June 15, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "foreword (... a catalogue of the collection)"}, "madsrdf:citationSource": "Walters Art Gallery. Handbook of the collection, c1936:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8bf4d661363e4f678e3144613536324ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(left-anchored title phrase search \"collection catalog\" yields approximately three dozen relevant titles that start with \"collection catalog(s)\" and more than 100 that start with \"collection catalogue\")"}, "madsrdf:citationSource": "OCLC database, June 15, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027228"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027229", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDigital art", "identifiers:lccn": "gf2017027229", "madsrdf:adminMetadata": [{"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b1"}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Digital art"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027218"}, "madsrdf:hasSource": [{"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b5"}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b6"}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b7"}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b8"}], "madsrdf:hasVariant": {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Visual works created or modified using a computer or other digital method."}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Digital art"}}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Thesaurus for graphic materials, October 9, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Computer art; UF Art, Computer; Computer craft; Digital art [Former heading]; BT Art, Modern--20th century; Art, Modern--21st century; NT Computer graphics; Electronic mail art; Stereograms; scope note: Here are entered works on art produced by using computers as an artistic medium.)"}, "madsrdf:citationSource": "LCSH, October 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Digital art: a term first used in the 1980s, it describes art that is essentially computer generated. Recent developments have included the creation of interactive digital art which permits the audience a certain amount of control over the final result.)"}, "madsrdf:citationSource": "The concise Oxford dictionary of art terms, Oxford reference, viewed October 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(digital art (visual works); variants: digital arts; art, digital; note: Visual works created or modified using a computer or other digital medium. These products are exhibited in a variety of ways: statically or as interactive concepts that may reveal or obscure their computer origins. For works that use computer machinery intrinsically as a part of the work, use \"computer art.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, October 9, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Computer art"}}, {"@id": "_:nf46cd920166d496b9a918a1c7bc5de25b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Computer art"}}], "@id": "/authorities/genreForms/gf2017027229"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027230", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDocumentary photographs", "identifiers:lccn": "gf2017027230", "madsrdf:adminMetadata": [{"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b1"}, {"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Documentary photographs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027249"}], "madsrdf:hasSource": [{"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b5"}, {"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b6"}, {"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b7"}, {"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Photographs that are used to chronicle events, places, environments, etc."}, {"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentary photographs"}}, {"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(documentary photographs; UF photographs, documentary; Note: Photographs taken as or subsequently used as documentary evidence.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, December 11, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Documentary photography usually refers to a popular form of photography used to chronicle events or environments both significant and relevant to history and historical events as well as everyday life. It is typically covered in professional journalism, or real life reportage, but it may also be an amateur, artistic, or academic pursuit.)"}, "madsrdf:citationSource": "Wikipedia, April 27, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Thesaurus for graphic materials, December 11, 2016;RBMS Controlled vocabularies: Genre terms, December 11, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n6b24dc99ee43427896e6a7a724dabf98b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Documentary photography; earlier form: Photography, Documentary; BT Photography)"}, "madsrdf:citationSource": "LCSH, December 11, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027230"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027231", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDrawings", "identifiers:lccn": "gf2017027231", "madsrdf:adminMetadata": [{"@id": "_:n9042da67e7e846f4876652e40c10aa9bb1"}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Drawings"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9042da67e7e846f4876652e40c10aa9bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027266"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026174"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026295"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027217"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027226"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027247"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027267"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026037"}], "madsrdf:hasSource": [{"@id": "_:n9042da67e7e846f4876652e40c10aa9bb5"}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb6"}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb7"}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb8"}], "madsrdf:hasVariant": {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-23T11:20:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drawings"}}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "RBMS Controlled vocabularies: Genre terms, June 5, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(drawings (visual works); UF drawing (visual work); Note: Visual works produced by drawing, which is the application of lines on a surface, often paper, by using a pencil, pen, chalk, or some other tracing instrument to focus on the delineation of form rather than the application of color. This term is often defined broadly to refer to computer-generated images as well.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, June 5, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Drawing; UF Drawings; Sketching; BT Art; Graphic arts; Illustration of books; Manual training; see also subdivision Drawings under technical topics for collections of drawings, plans, etc., and for the technique of making such drawings, unless a separate heading for the technique has been provided, e.g. Automobiles--Drawings; Automotive drafting)"}, "madsrdf:citationSource": "LCSH, June 5, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Drawings; Scope note: Narrower terms include both physical media and genre categories but are limited to those which use drawing in the sense of a specific medium rather than in the everyday sense of graphic representation.; BT Pictures; Catalogers Note: When using a genre term that includes the word DRAWINGS, also index under a more specific physical process name, if desired. Used in a note under DIGITAL PRINTS, INKJET PRINTS, and MIXED MEDIA.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, June 5, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9042da67e7e846f4876652e40c10aa9bb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sketches"}}, {"@id": "_:n9042da67e7e846f4876652e40c10aa9bb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sketches"}}], "@id": "/authorities/genreForms/gf2017027231"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027232", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEngravings", "identifiers:lccn": "gf2017027232", "madsrdf:adminMetadata": [{"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b1"}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Engravings"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027239"}, "madsrdf:hasSource": [{"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b5"}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b6"}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b7"}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b8"}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Prints on paper that incorporate impressions that are created on a printing plate into which the design was incised."}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Engravings"}}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Engraving; UF Copper engravings; Engravings [Former heading]; Line-engraving; Siderography; Steel-engraving; BT Graphic arts; Prints; RT Etching; NT Bamboo engraving; Cataloging of engravings; Color prints; Crayon engraving; Dotted prints (Engravings); Dry-point; Glass engraving; Glyptics; Graphotyping; Jewelry engraving; Jewish engraving; Mezzotint engraving; Monotype (Engraving); Niello; Photoengraving; Photogravure; Prints in paste; Rotogravures; Shell engraving; Stipple engraving; Wood-engraving)"}, "madsrdf:citationSource": "LCSH, August 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Engraving: Technique of intaglio printmaking in which an image is cut with tools into a plate from which multiple impressions may be made; the term is also applied to the resulting print, which has characteristic lines created by the tools and techniques of cutting. The incised image, which lies below the plate's surface, is filled with ink, and then pressure is used to force the paper into the inked lines, creating a slightly raised three-dimensional line and an embossed platemark.)"}, "madsrdf:citationSource": "Grove art online, Oxford art online, August 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Engravings; BT Intaglio prints; NT Steel engravings; Stipple engravings)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, June 10, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 320 (engraving: the process of removing material from a printing surface (usually metal or wood) through the use of a burin. Engraved lines in an intaglio process hold ink, and print; in a relief process they create nonprinting areas)"}, "madsrdf:citationSource": "Benson, R. The printed picture, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c3bceea64184630b8ad0387556ae3c1b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(engravings (prints); note: Prints on paper incorporating impressions of a reverse design created on a printing plate, usually copper, into which the design has been incised (engraved) using burins or gravers. Historically, \"engravings\" has sometimes been incorrectly used to refer to all prints, regardless of the specific technique. For prints made from designs engraved on a flat wooden block, use \"wood cuts\"; for prints made from a plate that is etched rather than engraved, use \"etchings.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, August 14, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027232"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027233", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEtchings", "identifiers:lccn": "gf2017027233", "madsrdf:adminMetadata": [{"@id": "_:ncd1ba8dbe429451682b4179335f8d750b1"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Etchings"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncd1ba8dbe429451682b4179335f8d750b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027239"}, "madsrdf:hasSource": [{"@id": "_:ncd1ba8dbe429451682b4179335f8d750b5"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b6"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b7"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b8"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b9"}], "madsrdf:hasVariant": {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Prints made from a metal printing plate onto which a design was made by coating the plate with an acid-resistant ground, creating a design in the coating with an etching needle, and then exposing the plate to acid."}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-23T11:20:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Etchings"}}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Etchings; BT Intaglio prints; NT Soft-ground etchings; RT Aquatints; Relief printed etchings)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, June 10, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Etching; UF Etchings [Former heading]; BT Art; Prints; RT Engraving; NT Aquatint; Cement clinkers-Etching; Crystals-Etching; Dry-point; Etching, Anonymous; Glass etching; Particle track etching; Plasma etching; Pyrography; Semiconductors-Etching; Stipple engraving)"}, "madsrdf:citationSource": "LCSH, August 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(etchings (prints); variants: etching (print); hard-ground etchings (prints); note: Prints made from an etched printing plate, which is a metal plate on which a design is made by coating the plate with an acid-resistant substance, creating a design in the coating, and then exposing the plate to acid, which etches the plate where the metal is exposed. For designs incised directly into a copper plate using a burin or graver, use \"engravings (prints).\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, August 21, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 320 (etching: most commonly, an intaglio printing method in which the ink-bearing cells or lines of an image are formed by chemical action on a printing plate. In plate-making, etching is the removal of metal through chemical action, by an acid or some other solvent.)"}, "madsrdf:citationSource": "Benson, R. The printed picture, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Etching; After engraving, the most important of the intaglio printmaking processes. In etching the design is bitten by acid on to the printing plate. In the printmaking process the printing plate is first covered with a layer of acid-resistant ground made of various waxes, gums, and resins. The ground is often darkened, usually with the smoke of lighted tapers; this aids the visibility of the process of drawing the design, which is done with an etching needle into the ground, thus clearing a path through to the printing plate, which is immersed in a bath of acid. The depth of the lines is determined by the strength of the acid and the length of time the plate is left therein. Plates can be wholly or partially rebitten by further immersions. Parts of the design can be selected for further bitings by covering over or stopping-out those sections of the design considered to have been sufficiently bitten already. Once biting has been completed, the acid-resistant ground is cleaned off and the plate is inked up and printed from. The more deeply bitten the lines the more distinctly they print.)"}, "madsrdf:citationSource": "The concise Oxford dictionary of art terms, Oxford art online, August 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd1ba8dbe429451682b4179335f8d750b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hard-ground etchings"}}, {"@id": "_:ncd1ba8dbe429451682b4179335f8d750b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hard-ground etchings"}}], "@id": "/authorities/genreForms/gf2017027233"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027234", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFloor plans", "identifiers:lccn": "gf2017027234", "madsrdf:adminMetadata": [{"@id": "_:nc199e6a2205a4a6bb238818851772696b1"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Floor plans"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc199e6a2205a4a6bb238818851772696b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027217"}], "madsrdf:hasSource": [{"@id": "_:nc199e6a2205a4a6bb238818851772696b5"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b6"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b7"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b8"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b9"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b10"}], "madsrdf:hasVariant": [{"@id": "_:nc199e6a2205a4a6bb238818851772696b11"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Representations of horizontal sections through buildings that diagram the enclosing walls, interior spaces, doors, windows, etc., of a building."}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Floor plans"}}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "RBMS Controlled vocabularies: Genre terms, Sept. 1, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Seattle Art Museum (Seattle, Wash.), February 2, 1932 ground floor plan, via University of Washington Libraries Digital Collections website, viewed on Sept. 1, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Floor plans. Scope note: Plans that represent horizontal sections cut through the walls and other vertical elements of a building at one or more levels. They demonstrate the shape and disposition of spaces, chambers, and structural components. They include information on placement and dimensions of features, such as doors, walls, built-in equipment, and room names. BT Plans; Sections)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Sept. 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(floor plan: A plan representing a horizontal section through the walls and other vertical elements of a building at one or more levels, showing the shape and disposition of rooms, spaces, and structural components, with information on the placement and dimensions of features such as doors, walls, stairways, and built-in fixtures and equipment, with room numbers and/or names included.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Sept. 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Floorplan. SN Plan showing a horizontal section, size and arrangement of rooms within a building, may include location of doors, windows and other features. BT Technical drawing)"}, "madsrdf:citationSource": "EH and National Trust resource description thesaurus, via WWW, Sept. 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(floor plans (orthographic projections). Note: Drawings or works in another two-dimensional medium that represent a horizontal section through a building taken above a floor to diagrammatically illustrate the enclosing walls, interior spaces, doors, and windows of a building. UF floor-plan drawings; plans, floor (orthographic projections). BT building plans. NT ground plans; typical floor plans)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Sept. 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc199e6a2205a4a6bb238818851772696b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Floorplans"}}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Floorplans"}}, {"@id": "_:nc199e6a2205a4a6bb238818851772696b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc199e6a2205a4a6bb238818851772696b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@v