{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026657", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision cop shows", "identifiers:lccn": "gf2011026657", "madsrdf:adminMetadata": [{"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb1"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television cop shows"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026658"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026197"}, "madsrdf:hasSource": [{"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb5"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb6"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb7"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb8"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb9"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb10"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb11"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb12"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb13"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb14"}], "madsrdf:hasVariant": [{"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb15"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb18"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb21"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb24"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb27"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb30"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025517"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:13:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television cop shows"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(policier: A film based on a police novel, portraying crime and its detection by police)"}, "madsrdf:citationSource": "Oxford dictionaries website, Sept. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Police: fictional work portraying the activities and personalities of official law enforcement officers and agencies (from municipal police to F.B.I. to G-men) in tracking criminals. Police stories offer many of the same elements as the Crime and Mystery genres, but with an added concentration on the procedures of police work and characterizations of police officers)"}, "madsrdf:citationSource": "Moving image genre-form guide online, January 28, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(policier: a novel, TV drama, or, esp., film focusing on a realistic depiction of the work of the police in investigating a crime or crimes)"}, "madsrdf:citationSource": "Webster's new world college dictionary, c2010, via yourdictionary.com, Sept. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Cop shows)"}, "madsrdf:citationSource": "LCSH, January 28, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Cop Show (The Cop Show is an idealised representation of police work, justified by the Rule of Cool. Morality is very black and white, being a cop is far more dangerous in this genre than it really is, shoot-outs and standoffs are common, as are car chases and serial killers. The protagonist is often a cowboy cop who often gets his man (even if not the first time). Of course, they don't forget the niggling details of the job, either. Specific variants: Buddy Cop Show. The more realistic representation of police work in fiction is a Police Procedural. See also and compare with: Criminal Procedural, Forensic Drama, Law Procedural) Police Procedural (A Police Procedural is concerned with an accurate representation of the day to day realities and procedures of the police. It's a very specific sub-genre of crime fiction. The Police Procedural is almost the antithesis of the Cop Show. The Police Procedural is characterized by the lack of emphasis on the character's personal lives and the increased focus on the nuts-and-bolts of law enforcement. This term is also sometimes used specifically to describe the \"Reverse Whodunnit\" style of crime drama made famous by Columbo, despite the fact that most examples have very little to do with actual police procedure. Note that the focus on \"realistic\" police work doesn't mean the show has to be set in \"reality\". A show looking at the day-to-day routine of the Space Police is still a procedural. Both the Police Procedural and the Cop Show are sometimes called \"Precinct Shows\". See also: Criminal Procedural, Forensic Drama, Buddy Cop Show, Cop Show)"}, "madsrdf:citationSource": "TV tropes website, Sept. 30, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cop shows 236,000 hits; Police shows 47,000 hits; Police television shows 1,940 hits)"}, "madsrdf:citationSource": "Google, Jan. 28, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hit counts, all searches combined with \"television\": Cop shows: 160,000; Police procedurals: 62,000; policiers: 234,000 (most hits on first several pages are in French); Precinct shows: 578, most irrelevant)"}, "madsrdf:citationSource": "Google search, Nov. 7, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 78 (Police films and programs: use for fictional genre films and programs which focus on the fight against crime conducted by official law enforcement agencies such as the Police Dept., or the FBI. Include here semidocumentaries and procedurals which re-enact actual cases and/or attempt to protray actual crime fighting techniques. UF Cop films and programs; Law enforcement films and programs; Policiers)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "List of genres (Police procedural: pioneered by the popular show Dragnet. The stories revolve around a crime that has been committed and must be solved by the end of the episode following a very generic and usually unchanging structure of events. The crime is committed, witnesses are questioned, an arrest occurs, and then a judicial conclusion wraps it up. As the name implies, the show communicates everything \"by the book,\" as it would happen in real life. In such modern Police Procedurals such as Law & Order, you see and hear even the officers reading freshly arrested criminals their Miranda rights. Not quite as dramatic or action-oriented as the Dick Tracy-style of detective shows.)"}, "madsrdf:citationSource": "Wikipedia, Jan. 1, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(policier \u200e(plural policiers) - English: (film, often italicized) A police movie, particularly one based on a police novel)"}, "madsrdf:citationSource": "Wiktionary, Sept. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Policiers (Television programs)"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Policiers (Television programs)"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cop television programs"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cop television programs"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Police shows (Television programs)"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Police shows (Television programs)"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Police television programs"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Police television programs"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Police procedurals (Television programs)"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Police procedurals (Television programs)"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cop shows (Television programs)"}}, {"@id": "_:nbf39c9f73f2448b4a837ce9676749f2eb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cop shows (Television programs)"}}], "@id": "/authorities/genreForms/gf2011026657"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026658", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision crime shows", "identifiers:lccn": "gf2011026658", "madsrdf:adminMetadata": [{"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab1"}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television crime shows"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab3"}]}, "madsrdf:exampleNote": "Note under [True crime television programs]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026252"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026197"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026291"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026347"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026464"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026657"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026095"}], "madsrdf:hasReciprocalAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026109"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026694"}], "madsrdf:hasSource": [{"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab5"}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab6"}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab7"}], "madsrdf:hasVariant": [{"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab8"}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab11"}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional television programs that feature the commission and investigation of crimes. For nonfiction television programs that feature actual footage and reenactments of criminal and police activities see [True crime television programs.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025533"}}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:12:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television crime shows"}}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 39 (Crime films and programs: use for fictional genre films and programs which focus on the commission and investigation of crime. NT: Caper films and programs, Detective films and programs, Film noir, Gangster films and programs, Legal films and programs, Mysteries, Police films and programs, Prison films and programs)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Crime: fictional work depicting a narrative descent into the underworld of syndicates, criminals, and their lawless activities, such as the drug trade, or bootlegging during the Prohibition era. The plot turns on such questions as how a criminal will be caught or who stole the object of value...Use more specific types of the crime formula when possible, such as Caper, Film Noir, Gangster, Mystery, Police, or Thriller, if one of those aspects is the primary situation or character. For true crime, use Reality-based)"}, "madsrdf:citationSource": "Moving image genre-form guide online, February 11, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(crime shows: 156,000 hits; crime television programs: 26 hits; criminal shows: 536 hits; criminal television programs: 5 hits)"}, "madsrdf:citationSource": "Google, March 26, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Criminal shows"}}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Criminal shows"}}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Criminal television programs"}}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Criminal television programs"}}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crime television programs"}}, {"@id": "_:n6f4b9c0430f24c4381a6c769cbc76fdab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crime television programs"}}], "@id": "/authorities/genreForms/gf2011026658"}
