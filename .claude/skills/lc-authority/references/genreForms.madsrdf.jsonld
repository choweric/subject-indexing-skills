ent", "madsrdf:elementValue": {"@language": "en", "@value": "Science films"}}, {"@id": "_:nb60c20017e48494496fbc7e55e6df0d5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Scientific works (Nonfiction): use for nonfiction film or video which depicts, analyzes or is concerned in a technical way with the sciences, including the biological or life sciences (e.g., botany, zoology), physical sciences (e.g. physics and chemistry), mathematics and logic, and applied sciences (e.g., technology, ecology); BT: Documentaries and factual works)"}, "madsrdf:citationSource": "Moving image materials, 1988", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026559"}
