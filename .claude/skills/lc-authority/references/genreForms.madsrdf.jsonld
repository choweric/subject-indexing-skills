{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026495", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRadio docudramas", "identifiers:lccn": "gf2011026495", "madsrdf:adminMetadata": [{"@id": "_:n586ee0767d4349b9baecf51c36d749d6b1"}, {"@id": "_:n586ee0767d4349b9baecf51c36d749d6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Radio docudramas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n586ee0767d4349b9baecf51c36d749d6b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026506"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": {"@id": "_:n586ee0767d4349b9baecf51c36d749d6b5"}, "madsrdf:hasVariant": {"@id": "_:n586ee0767d4349b9baecf51c36d749d6b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Radio programs that use drama to portray factual events or conditions.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025658"}}, {"@id": "_:n586ee0767d4349b9baecf51c36d749d6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T09:46:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n586ee0767d4349b9baecf51c36d749d6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n586ee0767d4349b9baecf51c36d749d6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio docudramas"}}, {"@id": "_:n586ee0767d4349b9baecf51c36d749d6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Radio docudramas use radio to deliver health messages in an entertaining manner; they rely on a good story line to engage the audience)"}, "madsrdf:citationSource": "Centers for Disease Control and Prevention website, Dec. 19, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n586ee0767d4349b9baecf51c36d749d6b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n586ee0767d4349b9baecf51c36d749d6b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Docudramas, Radio"}}, {"@id": "_:n586ee0767d4349b9baecf51c36d749d6b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Docudramas, Radio"}}], "@id": "/authorities/genreForms/gf2011026495"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026496", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRadio field reports", "identifiers:lccn": "gf2011026496", "madsrdf:adminMetadata": [{"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb1"}, {"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Radio field reports"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb3"}]}, "madsrdf:exampleNote": "Notes under [Radio news programs; Special events radio coverage]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026424"}, "madsrdf:hasSource": {"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb5"}, "madsrdf:hasVariant": {"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Radio reportorial pieces recorded on location. For radio programs that feature commentators in the studio reporting on current events and noteworthy issues see [Radio news programs.] For radio reports of noteworthy events, often featuring several commentators and combining studio reports with on-the-scene coverage, see [Special events radio coverage.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025569"}}, {"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:03:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio field reports"}}, {"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Field reports: Reportorial pieces recorded on location; often at the scene of a particular event; these can be edited. RT News, Special events coverage. Examples: A broadcast from aboard ship during the 1944 Guam campaign; Coverage of the dedication of RCA transmitter in Fairbanks, AK)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Nov. 14, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Field reports, Radio"}}, {"@id": "_:nc62bcf6e3d7a49adb49faaaeca8b753bb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Field reports, Radio"}}], "@id": "/authorities/genreForms/gf2011026496"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026497", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRadio game shows", "identifiers:lccn": "gf2011026497", "madsrdf:adminMetadata": [{"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b1"}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Radio game shows"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b3"}]}, "madsrdf:exampleNote": "Note under [Radio quiz shows]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026506"}, "madsrdf:hasSource": [{"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b5"}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b6"}], "madsrdf:hasVariant": [{"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b7"}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b10"}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Radio programs that feature contestants participating in various types of competitive activities for prizes. For radio programs that feature a question-and-answer format see [Radio quiz shows.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025559"}}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:04:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio game shows"}}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Quiz shows: Programs on which a group of people (experts, celebrities, and/or members of the audience) compete in answering questions or partake in some other competitive activity, following certain rules, usually for prizes; UF Contests, Game shows, Panel game shows; Examples: NBC spelling bee; Truth or consequences; What's my name?; Information please)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Nov. 28, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "quiz and game shows page (prior to the quiz show scandals in 1958 no differentiation existed between quiz shows and game shows; all shows that deal with competitions between individuals or groups, and based primarily on the display of factual knowledge will be considered quiz shows; shows dealing with human knowledge (knowledge of people or of individuals) or that are based primarily on gambling or on physical performances fall in the category of game shows; The gong show or Double dare are not considered quiz shows since they rely primarily or completely on physical talents; Family feud and The newlywed game rely entirely on knowledge of people or of individuals and would therefore also be considered game shows; Jeopardy!, with its focus on academic, factual knowledge, is clearly a quiz show)"}, "madsrdf:citationSource": "Museum of Broadcast Communications WWW site, March 28, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio contests"}}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio contests"}}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Contests, Radio"}}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Contests, Radio"}}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Game shows (Radio programs)"}}, {"@id": "_:nfa9f24e2f2f74b8db66a3c2522dc2615b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Game shows (Radio programs)"}}], "@id": "/authorities/genreForms/gf2011026497"}
