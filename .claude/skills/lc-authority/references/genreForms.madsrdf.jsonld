"@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paintings"}}, {"@id": "_:n42e34efc10d2438eab1f0c247effbe32b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Painting; UF Oil painting; Painting, Primitive; Paintings; BT Graphic arts)"}, "madsrdf:citationSource": "LCSH, March 26, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n42e34efc10d2438eab1f0c247effbe32b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(paintings (visual works); BT visual works by material or technique [guide term] Note: Unique works in which images are formed primarily by the direct application of pigments suspended in oil, water, egg yolk, molten wax, or other liquid, arranged in masses of color, onto a generally two-dimensional surface.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, March 26, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n42e34efc10d2438eab1f0c247effbe32b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Paintings; Scope note: Narrower terms include both physical media and genre categories.; BT Pictures; NT Abstract paintings; Allegorical paintings; Casein paintings; Cityscape paintings; Genre paintings; Landscape paintings; Marine paintings; Miniatures (Paintings); Oil paintings; Pastels (Visual works); Polymer paintings; Portrait paintings; Screen paintings; Still life paintings; Tempera paintings; RT Airbrush works; Brush works; Mixed media; Watercolors)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, March 26, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027246"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027247", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPastels (Visual works)", "identifiers:lccn": "gf2017027247", "madsrdf:adminMetadata": [{"@id": "_:nc63bf465c06c4164874554ec67e7eed2b1"}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pastels (Visual works)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc63bf465c06c4164874554ec67e7eed2b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027231"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027246"}], "madsrdf:hasSource": [{"@id": "_:nc63bf465c06c4164874554ec67e7eed2b5"}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b6"}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b7"}], "madsrdf:hasVariant": [{"@id": "_:nc63bf465c06c4164874554ec67e7eed2b8"}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Drawings made with colored sticks of chalk that deposit a powdery color on a surface."}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastels (Visual works)"}}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pastels (visual works); variants: pastel (visual work); pastel drawings; pastel paintings; note: Works of art, typically on a paper or vellum support, to which designs are applied using crayons made of ground pigment held together with a binder, typically oil or water and gum. Works in this medium are sometimes classified as drawings, and sometimes as paintings, typically based on the local curatorial department responsible for the work or on the material of the support (pastels on paper may be classified as drawings, while pastels on vellum may be classified as paintings).)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, December 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pastels (Visual works); UF Pastel drawings; Pastel paintings; BT Drawings; Paintings; scope note: \"Drawings\" or \"paintings\" made with colored sticks of chalk in a nongreasy binder, depositing a powdery color on a surface.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, December 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pastel drawing; UF Pastel painting; Pastels [Former heading]; BT Drawing)"}, "madsrdf:citationSource": "LCSH, December 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc63bf465c06c4164874554ec67e7eed2b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pastel drawings"}}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastel drawings"}}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc63bf465c06c4164874554ec67e7eed2b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pastel paintings"}}, {"@id": "_:nc63bf465c06c4164874554ec67e7eed2b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastel paintings"}}], "@id": "/authorities/genreForms/gf2017027247"}
