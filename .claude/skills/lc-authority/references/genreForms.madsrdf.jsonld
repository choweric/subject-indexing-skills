{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026977", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOratorios", "identifiers:lccn": "gf2014026977", "madsrdf:adminMetadata": [{"@id": "_:n68b7e8a986f949e5a98cf2b5b35fb081b1"}, {"@id": "_:n68b7e8a986f949e5a98cf2b5b35fb081b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Oratorios"}, "madsrdf:elementList": {"@list": [{"@id": "_:n68b7e8a986f949e5a98cf2b5b35fb081b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027081"}, "madsrdf:hasSource": {"@id": "_:n68b7e8a986f949e5a98cf2b5b35fb081b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n68b7e8a986f949e5a98cf2b5b35fb081b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n68b7e8a986f949e5a98cf2b5b35fb081b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n68b7e8a986f949e5a98cf2b5b35fb081b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oratorios"}}, {"@id": "_:n68b7e8a986f949e5a98cf2b5b35fb081b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "extended musical setting of a sacred text made up of dramatic, narrative and contemplative elements. Except for a greater emphasis on the chorus throughout much of its history, the musical forms and styles of the oratorio tend to approximate to those of opera in any given period, and the normal manner of performance is that of a concert (without scenery, costumes or action)"}, "madsrdf:citationSource": "New Grove dict. of mus. online, Apr. 17, 2003:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026977"}
