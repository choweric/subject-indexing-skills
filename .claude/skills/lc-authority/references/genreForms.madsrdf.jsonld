{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026664", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision melodramas", "identifiers:lccn": "gf2011026664", "madsrdf:adminMetadata": [{"@id": "_:n546e86e3156146f89113bed5429d5212b1"}, {"@id": "_:n546e86e3156146f89113bed5429d5212b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television melodramas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n546e86e3156146f89113bed5429d5212b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026252"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026681"}, "madsrdf:hasSource": [{"@id": "_:n546e86e3156146f89113bed5429d5212b5"}, {"@id": "_:n546e86e3156146f89113bed5429d5212b6"}], "madsrdf:hasVariant": [{"@id": "_:n546e86e3156146f89113bed5429d5212b7"}, {"@id": "_:n546e86e3156146f89113bed5429d5212b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional television programs that feature suffering protagonists victimized by situations or events, in which emotion is emphasized.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025566"}}, {"@id": "_:n546e86e3156146f89113bed5429d5212b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:20:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n546e86e3156146f89113bed5429d5212b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n546e86e3156146f89113bed5429d5212b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television melodramas"}}, {"@id": "_:n546e86e3156146f89113bed5429d5212b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Melodrama: fictional work emphasizing emotional vicissitudes and tragic occurrences, traditionally presented in an overwrought manner. The plot usually concerns victimized or suffering protagonists and a mixture of difficulties among lovers, family, friends, or the community. The story typically encompasses both familial and romantic themes)"}, "madsrdf:citationSource": "Moving image genre-form guide online, April 7, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n546e86e3156146f89113bed5429d5212b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 63 (Melodrama: use for fictional genre films which revolve around relatively passive, suffering protagonists, victimized by situations or events related to society, family, and/or sexuality. Emotion, rather than action, is emphasized, and is usually expressed through music, mise en scene, and production design, as well as character portrayal. The narrative is set in contemporary times and is usually resolved by a \"happy ending.\")"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n546e86e3156146f89113bed5429d5212b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n546e86e3156146f89113bed5429d5212b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Melodramatic television programs"}}, {"@id": "_:n546e86e3156146f89113bed5429d5212b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Melodramatic television programs"}}, {"@id": "_:n546e86e3156146f89113bed5429d5212b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n546e86e3156146f89113bed5429d5212b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Melodramas, Television"}}, {"@id": "_:n546e86e3156146f89113bed5429d5212b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Melodramas, Television"}}], "@id": "/authorities/genreForms/gf2011026664"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026665", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision mini-series", "identifiers:lccn": "gf2011026665", "madsrdf:adminMetadata": [{"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b1"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television mini-series"}, "madsrdf:elementList": {"@list": [{"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026680"}, "madsrdf:hasSource": [{"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b5"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b6"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b7"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b8"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b9"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b10"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b11"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b12"}], "madsrdf:hasVariant": [{"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b13"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b16"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b19"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b22"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b25"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b28"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b31"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025506"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-09-12T13:46:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television mini-series"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Television mini-series: multi-episode program of limited duration, shown on a daily or weekly schedule, usually lasting fifteen hours or less in total running time)"}, "madsrdf:citationSource": "Moving image genre-form guide online, January 7, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(television limited series; what we once called miniseries; some limited series are parts of stories that can be continued in other, new miniseries; whether you call them \"limited series\" or the old-fashioned \"miniseries,\" the options available in 2019 are some of the best yet)"}, "madsrdf:citationSource": "The best new limited series of 2019, via Ranker website, viewed June 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 64 (Mini-series: use for a program in a number of episodes or parts which has a story line which continues from one episode or part to the next, and which is not intended to be continued indefinitely)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the term 'limited series' means that the series' storyline is guaranteed to finish within the final episode of the series; A Netflix 'limited series' acts as a mini-series with usually around 4-10 episodes where the main story arc of the show will be full resolved within that time-frame. This doesn't necessarily mean an end for the show itself however. There have been cases where the show continues however the entire storyline may be different, either with or without the same actors starring too)"}, "madsrdf:citationSource": "What is a Netflix 'limited series' and what's different about them?, Capital FM website, posted 2 Oct. 2018, viewed June 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "credits (an HBO limited series)"}, "madsrdf:citationSource": "Sharp objects, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Miniseries: The Primetime Emmys defines a miniseries as being more than six hours or in two or more parts. It also must be close-ended. Famous miniseries include \"Roots\" and \"Band of Brothers.\" Miniseries aren't so much literal \"mini series,\" in that they are small versions of the on-going 22-episode series that networks put on the air, but more like extended TV movies, which is perhaps why they are included in the same awards category as TV movies. Limited Series: Limited series and miniseries are not interchangeable. Limited series indicates that a network sees potential in a show to continue for many seasons, but the actual seasons themselves needn't be 22 episodes long. It can also refer to a show the network wants to try out in smaller doses with the possibility of renewal based on how well it does in the ratings.)"}, "madsrdf:citationSource": "Reihe, A. What is the difference between a miniseries, limited series and event series?, via Screener website, posted Jan. 21, 2014, viewed June 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Winners & Nominees, Best Television Limited Series or Motion Picture Made for Television)"}, "madsrdf:citationSource": "Golden Globe Awards website, June 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Primetime Emmy Award for Outstanding Limited Series (category of limited series that are two or more episodes with a total running time of at least 150 minutes. The program must tell a complete, non-recurring story, and not have an ongoing storyline or main characters in subsequent seasons; category began as the Outstanding Drama/Comedy - Limited Episodes in 1973; renamed Outstanding Limited Series in 1974 and later Outstanding Miniseries in 1986. In 1991, Outstanding Miniseries category was merged with Outstanding TV Movie to form Outstanding Drama/Comedy Special and Miniseries; merge was reversed in 1992; in 2011 the categories were again merged as Primetime Emmy Award for Outstanding Miniseries or Movie before reverting in 2014 following an influx in limited series; a year later, category was changed to Outstanding Limited Series and the rules were made to distinguish that category from that of a movie by having the work have at least two episodes and from that of a regular series by having no more than five episodes)"}, "madsrdf:citationSource": "Wikipedia, June 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television miniseries"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television miniseries"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Series, Limited (Television programs)"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Series, Limited (Television programs)"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Limited series (Television programs)"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Limited series (Television programs)"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Limited serials (Television programs)"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Limited serials (Television programs)"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mini-series, Television"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mini-series, Television"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Serials, Limited (Television programs)"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serials, Limited (Television programs)"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Miniseries, Television"}}, {"@id": "_:n145a53891a72428a9c0a7b7d6a30a716b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Miniseries, Television"}}], "@id": "/authorities/genreForms/gf2011026665"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026666", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision musicals", "identifiers:lccn": "gf2011026666", "madsrdf:adminMetadata": [{"@id": "_:nfcb4e9c830354d599f2320767255432bb1"}, {"@id": "_:nfcb4e9c830354d599f2320767255432bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television musicals"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfcb4e9c830354d599f2320767255432bb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026957"}], "madsrdf:hasSource": [{"@id": "_:nfcb4e9c830354d599f2320767255432bb5"}, {"@id": "_:nfcb4e9c830354d599f2320767255432bb6"}, {"@id": "_:nfcb4e9c830354d599f2320767255432bb7"}], "madsrdf:hasVariant": {"@id": "_:nfcb4e9c830354d599f2320767255432bb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025548"}}, {"@id": "_:nfcb4e9c830354d599f2320767255432bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nfcb4e9c830354d599f2320767255432bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-05T16:20:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfcb4e9c830354d599f2320767255432bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television musicals"}}, {"@id": "_:nfcb4e9c830354d599f2320767255432bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Television musicals)"}, "madsrdf:citationSource": "LCSH, March 4, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfcb4e9c830354d599f2320767255432bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Musical: predominantly theatrical fiction work whose plot is structured around segments featuring combinations of music, song, and dance, including such various types as backstage, comedy, rock, and musical biographies. In the Hollywood context, musicals emerged with the coming of sound motion pictures, from roots in stage musicals and operettas, revues, and vaudeville)"}, "madsrdf:citationSource": "Moving image genre-form guide online, March 4, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfcb4e9c830354d599f2320767255432bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 68 (Musicals: use for fictional films and programs in which structure and movement are determined by musical numbers; songs, and usually dancing)"}, "madsrdf:citationSource": "Yee, M. M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfcb4e9c830354d599f2320767255432bb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfcb4e9c830354d599f2320767255432bb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Musical television programs"}}, {"@id": "_:nfcb4e9c830354d599f2320767255432bb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musical television programs"}}], "@id": "/authorities/genreForms/gf2011026666"}
