ntSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-23T16:14:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Computer animation films"}}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shrek films"}}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shrek films"}}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Toy Story films"}}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Toy Story films"}}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 37 (Computer animation: use for animation achieved by photographing in stop-motion the illumination of a cathode ray tube in accordance with signals fed to the CRT by a computer)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A computer-animated film commonly refers to feature films that have been computer-animated to appear three dimensional on a movie screen. While traditional 2D animated films are now done primarily with the help of computers, the technique to render realistic 3D computer graphics (CG), or 3D Computer-generated imagery (CGI), is unique to using computers to create movies. Movies that are entirely computer-animated, and rendered in 3D...are sometimes referred to as CG films)"}, "madsrdf:citationSource": "Wikipedia website, January 17, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Computer animation: type of animation in which the visuals are composed predominantly of computer-generated imagery. Used for CGI)"}, "madsrdf:citationSource": "Moving image genre-form guide online, January 17, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 14 (computer animated films)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "CGI films (Computer animation)"}}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "CGI films (Computer animation)"}}, {"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne56ed128b2984140aa0f70f4cb6ca295b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "CG films (Computer animation)"}}, {"@id": "_:ne56ed128b29