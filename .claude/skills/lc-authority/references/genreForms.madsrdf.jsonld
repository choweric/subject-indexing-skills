{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026855", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHeike biwa", "identifiers:lccn": "gf2014026855", "madsrdf:adminMetadata": [{"@id": "_:n6abbe25329d5463b8ad389935105ac79b1"}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Heike biwa"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6abbe25329d5463b8ad389935105ac79b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026961"}], "madsrdf:hasSource": [{"@id": "_:n6abbe25329d5463b8ad389935105ac79b5"}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b6"}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b7"}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b8"}], "madsrdf:hasVariant": [{"@id": "_:n6abbe25329d5463b8ad389935105ac79b9"}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heike biwa"}}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(heike biwa or heikyoku)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(One of the principal genres of Japanese music of the Kamakura and Muromachi eras is the narrative performance tradition now called heikyoku or heike-biwa ... performance with biwa of individual stories or episodes from a corpus referred to as Heike monogatari (Tale of the Heike))"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Oct 13, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(heikyoku, also called Heike biwa)"}, "madsrdf:citationSource": "Kodansha encyc. Japan", "madsrdf:citationStatus": "found"}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Okumura-ke z\u014d T\u014dd\u014dza Heike biwa shiry\u014d, 1984.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6abbe25329d5463b8ad389935105ac79b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Heikyoku"}}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heikyoku"}}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6abbe25329d5463b8ad389935105ac79b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Heikebiwa"}}, {"@id": "_:n6abbe25329d5463b8ad389935105ac79b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heikebiwa"}}], "@id": "/authorities/genreForms/gf2014026855"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026856", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aH\u0113visi (Music)", "identifiers:lccn": "gf2014026856", "madsrdf:adminMetadata": [{"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b1"}, {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "H\u0113visi (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}, "madsrdf:hasSource": [{"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b5"}, {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b6"}, {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b7"}], "madsrdf:hasVariant": {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "H\u0113visi (Music)"}}, {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(h\u0113visi (also h\u0113visi p\u016bj\u0101): Buddhist kettledrum-and-oboe ceremonial ensemble in Sri Lanka; provides music for Buddhist rituals in Sri Lankan temples; instruments are the horan\u00e2va (\"small oboe\"), which plays simple melodic patterns defining the time, place, and occasion, and two types of drum; on the double-headed cylindrical drum (daule), drummers play ostinato cyclical rhythms, and on the paired small kettledrums (tamm\u00e2\u1e6d\u1e6da) they play rhythmic elaborations; in ritual processions in the hill country and as accompaniment to the Kandyan sacred processional dance, the drummers wear spectacular headdresses and breastplates and dance as they play)"}, "madsrdf:citationSource": "Garland encyc. of world music", "madsrdf:citationStatus": "found"}, {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 94904116: J\u014dn, G\u012b. P\u012b. H\u0113visi guruvaray\u0101, 1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(h\u0113visi: term used for Buddhist ritual music of Sri Lanka and the ensemble used to play it, which consists of a horan\u01dfva (oboe) and two drums, the daula and the tamm\u00e4\u1e6d\u1e6da; the correct but rarely used name for the h\u0113visi ensemble is sinh\u0101rakk\u0101ra)"}, "madsrdf:citationSource": "New Grove dict. mus. insts.", "madsrdf:citationStatus": "found"}, {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "H\u0113visi p\u016bj\u0101 (Music)"}}, {"@id": "_:n19da8c5d0faa47c3b3ca7aee865b4037b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "H\u0113visi p\u016bj\u0101 (Music)"}}], "@id": "/authorities/genreForms/gf2014026856"}
