{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026040", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAcrostics (Puzzles)", "identifiers:lccn": "gf2014026040", "madsrdf:adminMetadata": [{"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b1"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Acrostics (Puzzles)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026014"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026090"}, "madsrdf:hasSource": [{"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b5"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b6"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b7"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b8"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b9"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b10"}], "madsrdf:hasVariant": [{"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b11"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T14:52:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Acrostics (Puzzles)"}}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(acrostic. Originally, a short verse composition, constructed so that one or more sets of letters (such as the initial, middle, or final letters of the lines), taken consecutively, form words. An acrostic in which the initial letters form the alphabet is called an abecedarius. Ancient Greek and Latin writers, medieval monks, and Renaissance poets are among those who devised acrostics. Today the term is used for a type of word puzzle utilizing the acrostic principle. A popular form is double acrostics, puzzles constructed so that the middle or last, as well as initial, letters of lines may form words.)"}, "madsrdf:citationSource": "Merriam-Webster online, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acrostics. BT Literary recreations; Puzzles)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acrostic (puzzle). An acrostic is a type of word puzzle, related somewhat to crossword puzzles, that uses an acrostic form. It typically consists of two parts. The first part is a set of lettered clues, each of which has numbered blanks representing the letters of the answer. The second part is a long series of numbered blanks and spaces, representing a quotation or other text, into which the answers for the clues fit. In some forms of the puzzle, the first letters of each correct clue answer, read in order from clue A on down the list, will spell out the author of the quote and the title of the work it is taken from; this can be used as an additional solving aid.)"}, "madsrdf:citationSource": "Wikipedia, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(acrostic 1. A puzzle where you fill a square grid with words reading the same down as across - word square. 2. Verse in which certain letters such as the first in each line form a word or message)"}, "madsrdf:citationSource": "WordWeb online, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(acrostic 1. A poem or series of lines in which certain letters, usually the first in each line, form a name, motto, or message when read in sequence. 2. See word square; word square (Games): A set of words arranged in a square such that they read the same horizontally and vertically. Also called acrostic)"}, "madsrdf:citationSource": "The American heritage dictionary of the English language, \u00a92000", "madsrdf:citationStatus": "found"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acrostics. BT Puzzles)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Word squares"}}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Word squares"}}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Acrostic puzzles"}}, {"@id": "_:n6511f5eba53a46e2b01e1b159c7e4e85b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Acrostic puzzles"}}], "@id": "/authorities/genreForms/gf2014026040"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026041", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAdaptations", "identifiers:lccn": "gf2014026041", "madsrdf:adminMetadata": [{"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b1"}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Adaptations"}, "madsrdf:elementList": {"@list": [{"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026084"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b5"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026254"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026484"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026653"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026005"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026007"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026042"}], "madsrdf:hasSource": [{"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b8"}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b9"}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b10"}], "madsrdf:hasVariant": {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Paraphrases, rewritings, etc., that are intended for a different audience or purpose, or are in a different form, from the original.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026043"}}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-11-23T12:02:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Adaptations"}}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Opera adaptations"}}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Opera adaptations"}}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 24 (adaptation: something adapted)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(adaptation: A work that has been edited or rewritten, in part or in its entirety, for a new use, audience, or purpose. Also, a work converted to another literary form or artistic medium to serve a different or related purpose, while retaining as much of the action, characters, language, and tone of the original as possible, for example, a novel or story adapted for performance on the stage, a play adapted for the motion picture screen, or an engraving based on a painting. In music, a work that is a distinct alteration of another musical work (for example, a free transcription), or that paraphrases parts of various works or imitates the style of another composer, or that is somehow based on another musical work)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Adaptation: 1) A new derivative work created by revision of a previously existing work that substantially changes the nature and content of that work. 2) In the case of a musical work, a derivative work described as freely transcribed, based on, etc.; a revision incorporating new material; a paraphrase of various works by, or in the general style of, another composer; revisions in which the harmony or musical style of the original has been changed; performances involving substantial creative responsibility for adaptation, improvisation, etc., on the part of the performer or performers; or any other distinct alteration of another musical work.)"}, "madsrdf:citationSource": "RDA glossary, viewed July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Opera adaptations"}}, {"@id": "_:nedd273b9c6ca4c9190e3dc67f48c6ea8b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Opera adaptations"}}], "@id": "/authorities/genreForms/gf2014026041"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026042", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlmanacs", "identifiers:lccn": "gf2014026042", "madsrdf:adminMetadata": [{"@id": "_:nb8b16e2355e94514a858f610db411921b1"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Almanacs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb8b16e2355e94514a858f610db411921b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026174"}], "madsrdf:hasSource": [{"@id": "_:nb8b16e2355e94514a858f610db411921b5"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b6"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b7"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b8"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b9"}], "madsrdf:hasVariant": {"@id": "_:nb8b16e2355e94514a858f610db411921b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb8b16e2355e94514a858f610db411921b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Almanacs"}}, {"@id": "_:nb8b16e2355e94514a858f610db411921b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Almanacs. Use for works containing a calendar of days, weeks, and months, together with information such as astronomical data, various statistics, etc. Do not use for modern factual compendia such as the World Almanac.)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(almanac 1. A compendium, usually an annual, of statistics and facts, both current and retrospective. May be broad in geographical and subject coverage, or limited to a particular country or state or to a special subject. Compare with yearbook. 2. An annual containing miscellaneous matter such as a calendar, a list of astronomical events, planting tables, astrological predictions, and anecdotes)"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 25 (almanac: annual publication containing collection of useful facts, publication containing data on royal families etc.)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(almanacs. UF almanacks. Publications, usually annuals, containing a variety of useful facts of miscellaneous nature, or statistical information; originally included projections of coming days, months, and holidays.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(almanac: Originally, a book introduced by the Moors to Spain, listing the days, weeks, and months of the year and providing information about festivals, holidays, astronomical phenomena, etc. In modern usage, an annual compendium of practical dates, facts, and statistics, current and/or retrospective, often arranged in tables to facilitate comparison. Almanacs can be general or related to a specific subject or academic discipline. Also spelled almanack.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb8b16e2355e94514a858f610db411921b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb8b16e2355e94514a858f610db411921b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Almanacks"}}, {"@id": "_:nb8b16e2355e94514a858f610db411921b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Almanacks"}}], "@id": "/authorities/genreForms/gf2014026042"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026043", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnagrams", "identifiers:lccn": "gf2014026043", "madsrdf:adminMetadata": [{"@id": "_:n87fcada791c644a282d7dc1cc68e2720b1"}, {"@id": "_:n87fcada791c644a282d7dc1cc68e2720b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Anagrams"}, "madsrdf:elementList": {"@list": [{"@id": "_:n87fcada791c644a282d7dc1cc68e2720b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026014"}, "madsrdf:hasSource": [{"@id": "_:n87fcada791c644a282d7dc1cc68e2720b5"}, {"@id": "_:n87fcada791c644a282d7dc1cc68e2720b6"}, {"@id": "_:n87fcada791c644a282d7dc1cc68e2720b7"}, {"@id": "_:n87fcada791c644a282d7dc1cc68e2720b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n87fcada791c644a282d7dc1cc68e2720b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n87fcada791c644a282d7dc1cc68e2720b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T14:52:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n87fcada791c644a282d7dc1cc68e2720b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anagrams"}}, {"@id": "_:n87fcada791c644a282d7dc1cc68e2720b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anagrams. BT Puzzles)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n87fcada791c644a282d7dc1cc68e2720b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anagrams. BT Anonyms and pseudonyms; Monograms; Puzzles. RT Chronograms)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n87fcada791c644a282d7dc1cc68e2720b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anagram: A word, phrase, sentence, name, or title made from another by the rearrangement of its letters. The basic rule of anagramming is that all the letters must be used once and only once, as in \"cone\" made from the letters of the word \"once.\")"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n87fcada791c644a282d7dc1cc68e2720b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anagram: a rearranging of the letters of a word or phrase that results in a new word or phrase. The palindrome is an anagram that reads the same way backwards or forwards.)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026043"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026044", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnecdotes", "identifiers:lccn": "gf2014026044", "madsrdf:adminMetadata": [{"@id": "_:naff72804223e4201bf03037836731e33b1"}, {"@id": "_:naff72804223e4201bf03037836731e33b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Anecdotes"}, "madsrdf:elementList": {"@list": [{"@id": "_:naff72804223e4201bf03037836731e33b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, "madsrdf:hasSource": [{"@id": "_:naff72804223e4201bf03037836731e33b5"}, {"@id": "_:naff72804223e4201bf03037836731e33b6"}, {"@id": "_:naff72804223e4201bf03037836731e33b7"}, {"@id": "_:naff72804223e4201bf03037836731e33b8"}, {"@id": "_:naff72804223e4201bf03037836731e33b9"}, {"@id": "_:naff72804223e4201bf03037836731e33b10"}, {"@id": "_:naff72804223e4201bf03037836731e33b11"}, {"@id": "_:naff72804223e4201bf03037836731e33b12"}], "madsrdf:hasVariant": [{"@id": "_:naff72804223e4201bf03037836731e33b13"}, {"@id": "_:naff72804223e4201bf03037836731e33b16"}, {"@id": "_:naff72804223e4201bf03037836731e33b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:naff72804223e4201bf03037836731e33b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:naff72804223e4201bf03037836731e33b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naff72804223e4201bf03037836731e33b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anecdotes"}}, {"@id": "_:naff72804223e4201bf03037836731e33b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anecdote. A short narrative usually consisting of a single incident or episode. Often humorous, anecdotes can be real or fictional. When they appear within a larger context, as an author's digression or a brief story told by one character to another, they tend to reveal something meaningful to the work as a whole.)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:naff72804223e4201bf03037836731e33b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 26 (anecdote: narrative of an amusing incident)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:naff72804223e4201bf03037836731e33b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anecdotes. UF Ana; Facetiae; Humor. BT Biography; Wit and humor)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:naff72804223e4201bf03037836731e33b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anecdote noun, plural anecdotes or for 2, anecdota. 1. a short account of a particular incident or event, especially of an interesting or amusing nature. 2. a short, obscure historical or biographical account. Synonyms: story, yarn, reminiscence)"}, "madsrdf:citationSource": "Dictionary.com, June 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:naff72804223e4201bf03037836731e33b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anecdote: 1. A short and amusing or interesting story about a real incident or person; 1.1. An account regarded as unreliable or hearsay; 1.2. The depiction of a minor narrative incident in a painting)"}, "madsrdf:citationSource": "Oxford dictionaries website, June 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:naff72804223e4201bf03037836731e33b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anecdote. A short, amusing true story is an anecdote. You might come back from a crazy spring break with a lot of anecdotes to tell. The roots of anecdote lie in the Greek word anekdota, meaning \"unpublished.\" The word's original sense in English was \"secret or private stories\"--tales not fit for print, so to speak. It can still have connotations of unreliability, as in the phrase \"anecdotal information.\" But the most common sense today is that of \"a funny story about something that happened.\")"}, "madsrdf:citationSource": "Vocabulary.com, June 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:naff72804223e4201bf03037836731e33b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(An anecdote is a short and amusing but serious account, which may depict a real/fake incident or character. Anecdotes can be as brief as the setting and provocation of a bon mot. An anecdote is always presented as based in a real incident involving actual persons, whether famous or not, usually in an identifiable place. However, over time, modification in reuse may convert a particular anecdote to a fictional piece, one that is retold but is \"too good to be true\". Sometimes humorous, anecdotes are not jokes, because their primary purpose is not simply to evoke laughter, but to reveal a truth more general than the brief tale itself, or to delineate a character trait in such a light that it strikes in a flash of insight to its very essence.)"}, "madsrdf:citationSource": "Wikipedia, June 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:naff72804223e4201bf03037836731e33b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anecdote, plural anecdotes also anecdota: a short story about an interesting or funny event or occurrence; ana, plural ana or anas: 1 : a collection of the memorable sayings of a person 2 : a collection of anecdotes or interesting information about a person or a place; facetiae, noun plural: witty or humorous writings or sayings)"}, "madsrdf:citationSource": "Merriam-Webster online, June 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:naff72804223e4201bf03037836731e33b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naff72804223e4201bf03037836731e33b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anas (Anecdotes)"}}, {"@id": "_:naff72804223e4201bf03037836731e33b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anas (Anecdotes)"}}, {"@id": "_:naff72804223e4201bf03037836731e33b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naff72804223e4201bf03037836731e33b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anecdota (Anecdotes)"}}, {"@id": "_:naff72804223e4201bf03037836731e33b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anecdota (Anecdotes)"}}, {"@id": "_:naff72804223e4201bf03037836731e33b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naff72804223e4201bf03037836731e33b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ana (Anecdotes)"}}, {"@id": "_:naff72804223e4201bf03037836731e33b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ana (Anecdotes)"}}], "@id": "/authorities/genreForms/gf2014026044"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026045", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnnals and chronicles", "identifiers:lccn": "gf2014026045", "madsrdf:adminMetadata": [{"@id": "_:n6883e0190ef54395b44f92f595bc1464b1"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Annals and chronicles"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6883e0190ef54395b44f92f595bc1464b3"}]}, "madsrdf:exampleNote": "Note under [Chronologies]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n6883e0190ef54395b44f92f595bc1464b5"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b6"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b7"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b8"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b9"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b10"}], "madsrdf:hasVariant": {"@id": "_:n6883e0190ef54395b44f92f595bc1464b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Discussions of events written in chronological order. For lists of events arranged by date or time see [Chronologies.]"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-05-25T13:49:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Annals and chronicles"}}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(annals 1. A periodical which records the transactions of an organization or events and developments in a special field. 2. A record of events arranged in chronological order. 3. In a general sense, any historical narrative.)"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 26 (annals: narrative of events year by year, historical records) p. 33 (chronicle 1 continuous record of events, 2 register, narrative)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(annals. A record of events arranged in chronological order; chronicles. These differ from annals in being more connected and full, though like annals, the events are treated in the order of time.)"}, "madsrdf:citationSource": "Harrod, L.M. The librarians' glossary of terms used in librarianship and the book crafts and reference book, 1971", "madsrdf:citationStatus": "found"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(annals (histories, without comment). Records of events arranged in yearly sequence, usually without comment or interpretation by the compiler. For more connected and full descriptions of events in chronological order, use \"chronicles.\" BT histories (literature genre); chronicles. Histories in which events are described in chronological order. For records of events in yearly sequence but less connected or filled out by commentary or interpretation, use \"annals.\" UF annals (histories, with comment and interpretation). BT histories (literature genre))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Sept. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Annals. Use for historical records arranged year by year. BT Historical works; Chronicles. Use for histories in which events are described in chronological order. These differ from annals in being more connected and full. BT Historical works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Sept. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(annals: A periodical in which the transactions of a society or organization, or events and developments in a specific discipline or field of study, are recorded (example: Annals of the American Academy of Political and Social Science, published since 1890). In a more general sense, a list of events recorded in chronological order. See also: chronicle; chronicle: Originally, a detailed chronological record of contemporary events, usually recorded year by year over an extended period of time, with little or no interpretation or analysis and no pretense of literary style. The first examples, world histories beginning with Creation, relied largely on biblical sources. Local chronicles began in the 9th century during the reign of King Alfred with the Anglo-Saxon Chronicle, eventually covering the history of England from 60 B.C. to the 12th century. In the 13th century, vernacular chronicles began to emerge. In modern usage, a list of events described and recorded in the order in which they occurred. The treatment is fuller and more connected than annals.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, via WWW, Sept. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6883e0190ef54395b44f92f595bc1464b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chronicles and annals"}}, {"@id": "_:n6883e0190ef54395b44f92f595bc1464b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chronicles and annals"}}], "@id": "/authorities/genreForms/gf2014026045"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026046", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnnual reports", "identifiers:lccn": "gf2014026046", "madsrdf:adminMetadata": [{"@id": "_:n433d1abe0f91421799a13804ad7fd531b1"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Annual reports"}, "madsrdf:elementList": {"@list": [{"@id": "_:n433d1abe0f91421799a13804ad7fd531b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026163"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026174"}], "madsrdf:hasSource": [{"@id": "_:n433d1abe0f91421799a13804ad7fd531b5"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b6"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b7"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b8"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b9"}], "madsrdf:hasVariant": [{"@id": "_:n433d1abe0f91421799a13804ad7fd531b10"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b13"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Annual reports"}}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(annual reports. Documentation summarizing the activities of an organization over the course of a year.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(annual report: A printed publication, usually less than 100 pages in length, submitted each year by the officers of a publicly held company to its board of directors (or other governing body) and issued in softcover for distribution to current and prospective shareholders, describing the firm's activities during the preceding fiscal year and its current financial position. Some nonprofit organizations also publish annual reports)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Greenland Analogue Project, Yearly report, 2009; Great Lakes Environmental Research Laboratory. Yearly report, FY 1995; Newfoundland. Economic Recovery Commission. Yearly report of the Economic Recovery Commission, Sept. 1, 1989/Aug. 31, 1990; International Organization of Journalists. Yearly report of the International Organisation of Journalists, 1992; Land and Agricultural Bank of South Africa. Yearly report of the Central Board of the Land and Agricultural Bank of South Africa, together with financial statements for the year ended ..., 31st Dec. 1924)"}, "madsrdf:citationSource": "OCLC, Sept. 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Annual reports. BT Periodicals)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(annual report: An official document describing and reviewing the activities, programs, and operations of an organization or one of its divisions for the previous, and usually fiscal, year. It is frequently used for administrative reporting or public relations and usually submitted to the next higher level of administrative authority.)"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n433d1abe0f91421799a13804ad7fd531b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yearly reports"}}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yearly reports"}}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n433d1abe0f91421799a13804ad7fd531b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reports, Yearly"}}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reports, Yearly"}}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n433d1abe0f91421799a13804ad7fd531b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reports, Annual"}}, {"@id": "_:n433d1abe0f91421799a13804ad7fd531b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reports, Annual"}}], "@id": "/authorities/genreForms/gf2014026046"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026047", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAutobiographies", "identifiers:lccn": "gf2014026047", "madsrdf:adminMetadata": [{"@id": "_:ne7f448132ed244e9b264930df0f74928b1"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Autobiographies"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne7f448132ed244e9b264930df0f74928b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026049"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026064"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026065"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026056"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026176"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026229"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026230"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026232"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026011"}], "madsrdf:hasSource": [{"@id": "_:ne7f448132ed244e9b264930df0f74928b5"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b6"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b7"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b8"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b9"}], "madsrdf:hasVariant": [{"@id": "_:ne7f448132ed244e9b264930df0f74928b10"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b13"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b16"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autobiographies"}}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The word 'egodocument' refers to autobiographical writing, such as memoirs, diaries, letters and travel accounts.)"}, "madsrdf:citationSource": "Center for the Study of Egodocuments and History WWW site, Dec. 29, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autobiography: UF Egodocuments; UF Memoirs)"}, "madsrdf:citationSource": "LCSH, Dec. 29, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 28 (autobiography)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autobiographies. BT Biographies. NT Confessions; Memoirs. RT Diaries)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(autobiography: An account of a person's life written by its subject, usually in the form of a continuous narrative of events considered by the author to be the most important or interesting, selected from those he or she is willing to reveal. Contemporary autobiographies of famous people are often written with the assistance of a ghost writer. An autobiography differs from a diary or journal in being written for others rather than for purely private reasons. See also: confessions; confessions: An autobiography in which the author discloses personal feelings and private matters, usually with a spiritual, intellectual, or theoretical purpose; memoirs: A narrative of events or reminiscences based on the author's own observations or personal knowledge of the world in which he (or she) lived, including events witnessed, people known or observed, places visited, etc. The life need not have been historically significant but one that placed the writer in a position to observe firsthand significant events as they unfolded. Unlike a private diary or journal, memoirs are usually written for publication long after the occurrence of the events described and do not necessarily provide a day-to-day account.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7f448132ed244e9b264930df0f74928b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Memoirs"}}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Memoirs"}}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7f448132ed244e9b264930df0f74928b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Egodocuments"}}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Egodocuments"}}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7f448132ed244e9b264930df0f74928b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Confessions (Autobiographies)"}}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Confessions (Autobiographies)"}}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7f448132ed244e9b264930df0f74928b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Personal memoirs"}}, {"@id": "_:ne7f448132ed244e9b264930df0f74928b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Personal memoirs"}}], "@id": "/authorities/genreForms/gf2014026047"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026048", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBibliographies", "identifiers:lccn": "gf2014026048", "madsrdf:adminMetadata": [{"@id": "_:n37f247bc48284474b91c5166ee8fc638b1"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bibliographies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n37f247bc48284474b91c5166ee8fc638b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026015"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026077"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026090"}], "madsrdf:hasSource": [{"@id": "_:n37f247bc48284474b91c5166ee8fc638b5"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b6"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b7"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b8"}], "madsrdf:hasVariant": [{"@id": "_:n37f247bc48284474b91c5166ee8fc638b9"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b12"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b15"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b18"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bibliographies"}}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bibliographies. BT Reference works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 26 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 29 (bibliography)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bibliographies. UF book lists. Lists of books, documents, and other bibliographical items, often all related by author, topic, or another criterion. Bibliographies are arranged in some logical order giving brief information about the works, such as author, date, publisher, and place of publication.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, June 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bibliography: Strictly speaking, a systematic list or enumeration of written works by a specific author or on a given subject, or that share one or more common characteristics (language, form, period, place of publication, etc.); webliography: An enumerative list of digital resources on a specific topic or subject, available in print or on the Web. Typically, the URLs of any Web sites included in the resource list are embedded in the HTML document, enabling the user to connect to the site by clicking on its hypertext link.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS: online dictionary for library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n37f247bc48284474b91c5166ee8fc638b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Webliographies"}}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Webliographies"}}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n37f247bc48284474b91c5166ee8fc638b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lists of publications"}}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lists of publications"}}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n37f247bc48284474b91c5166ee8fc638b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Book lists"}}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Book lists"}}, {"@id": "_:n37f247bc48284474b91c5166ee8fc638b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n37f247bc48284474b91c5166ee8fc638b19"}]}, "madsrdf:variantLabel": {"@l