{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026683", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCampursari", "identifiers:lccn": "gf2014026683", "madsrdf:adminMetadata": [{"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb1"}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Campursari"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb5"}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb6"}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb7"}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb8"}], "madsrdf:hasVariant": {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Campursari"}}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Indonesia. III. Central Java. 1. History. Non-traditional instruments such as electric bass have been added to the gamelan for the campursari (\"mixed essence\") genre)"}, "madsrdf:citationSource": "New Grove online, May 13, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 182-183 (campursari; musical genre increasingly popular since the mid-1990s; a 2001 performance by Tombo Sutris in Yogyakarta had a dozen musicians playing gamelan instruments in combination with keyboards, bass guitar, dangdut and kroncong instruments, and six female singers)"}, "madsrdf:citationSource": "Journal of social issues in Southeast Asia, vol. 21, no. 2, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(campursari 1,950,000 results; \"campur sari\" 207,000 results)"}, "madsrdf:citationSource": "Google WWW search, May 13, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (Campur sari; originally a combination of keroncong and Javanese gamelan; now includes elements of dangdut, pop music, and other musical elements; originated in the 1960s when musicians at government radio stations began including Javanese gamelan instruments in broadcast performances of keroncong music) p. 3 (in the late 1980s, campur sari underwent a revival; uses keroncong instruments with saxophone, trumpet, angkling, drum set, bongos, maracas, tabla, keyboard, etc.)"}, "madsrdf:citationSource": "Asian music, vol. 34, no. 2, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Campur sari"}}, {"@id": "_:nc17202595c5a4c79a498558e24fe2c6bb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Campur sari"}}], "@id": "/authorities/genreForms/gf2014026683"}
