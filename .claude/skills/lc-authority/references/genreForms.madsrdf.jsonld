{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026109", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMalapropisms", "identifiers:lccn": "gf2017026109", "madsrdf:adminMetadata": [{"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b1"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Malapropisms"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026159"}], "madsrdf:hasSource": [{"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b5"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b6"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b7"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b8"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b9"}], "madsrdf:hasVariant": {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Humorous misuse or distortion of a word or phrase, generally through substitution of a similar-sounding word."}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-09-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-14T12:43:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Malapropisms"}}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(malapropism 1: the usually unintentionally humorous misuse or distortion of a word or phrase; especially: the use of a word sounding somewhat like the one intended but ludicrously wrong in the context. 2: malaprop; malaprop: an example of malapropism; \"was famed for malaprops\")"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Sept. 15, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(video compilation of malapropisms spoken by George W. Bush)"}, "madsrdf:citationSource": "Work cat.: Bushisms, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(malapropism (US malaprop): The mistaken use of a word in place of a similar-sounding one, often with an amusing effect (e.g. 'dance a flamingo' instead of flamenco))"}, "madsrdf:citationSource": "Oxford dictionaries website, Sept. 15, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary note: Offers an array of malapropisms, foot-in-mouth statements, and gaffes from America's forty-third president, encompassing Bush's verbal contortions as he speaks out on government, leadership, and other topics)"}, "madsrdf:citationSource": "Bush, George W. Still more George W. Bushisms, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Malapropisms. BT Speech errors. LC classification: PN6231.M19 (Wit and humor))"}, "madsrdf:citationSource": "LCSH, Sept. 15, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Malaprops"}}, {"@id": "_:n7e97d5c07cf046778cb395ea7dbc5331b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Malaprops"}}], "@id": "/authorities/genreForms/gf2017026109"}
