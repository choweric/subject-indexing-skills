{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026525", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRelief models", "identifiers:lccn": "gf2011026525", "madsrdf:adminMetadata": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b1"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Relief models"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026113"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027245"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026787"}], "madsrdf:hasSource": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b5"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b6"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b7"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b8"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b9"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b10"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b11"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b12"}], "madsrdf:hasVariant": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b13"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b16"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b19"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b22"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b25"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b28"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b31"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b34"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b37"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b40"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025024"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:46:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Relief models"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (Summit manufactures raised-relief maps that let you see and feel the mountains, valleys, and true texture of the earth. Summit maps merge precise terrain elevation data with high-resolution earth imagery and maps to create stunning 3D wall maps; 3D maps)"}, "madsrdf:citationSource": "Summit Terragraphics website, Aug. 31, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Raised-relief map (A raised-relief map or terrain model is a three-dimensional representation, usually of terrain. When representing terrain, the elevation dimension is usually exaggerated by a factor between five and ten; this facilitates the visual recognition of terrain features. Construction: Starting with a topographic map one can cut out from some sheet material successive layers, with edges following the contour lines on the map. These may be assembled in a stack to obtain a rough approximation of the terrain. This method, without vertical exaggeration, is commonly used as the base for architectural models. For models of landforms, the stack will then be smoothed by filling with some material. This may then be used directly or for greater durability a mold may be made from this. This mold may then be used to produce a plaster model. Vacuum formed models: By using automated machinery a topographic model may be made by cutting a form with a numerically controlled mill guided by interpretation of the data used to produce a topographic map, The map may then be printed on a sheet of thermoplastic, which is then heated and drawn over the master. Vacuum is then applied to draw the soft plastic into the shape of the form. Such maps are commonly available in specialty map stores)"}, "madsrdf:citationSource": "Wikipedia, Aug. 31, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Raised Relief Maps (Raised Relief Maps present a dramatic visual and tactile representation of a desired geographical area. Sometimes referred to as three dimensional maps, most incorporate shaded relief to enhance topographic diversity)"}, "madsrdf:citationSource": "The Map Shop website, Aug. 31, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Characteristics (Cartographic terrain or relief models are three-dimensional representations of a part of the earth's surface. Only with terrain models it is possible to entirely depict the third dimension. Particularly on large-scale models, a huge amount of topographic details and information can be shown. ... In the early time of topographic relief depiction, terrain models were the easiest way to see the world from the bird's eye view and the only one, where the observer could choose his position freely)"}, "madsrdf:citationSource": "Terrain models, via WWW, Aug. 31, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Raised Relief Maps (Raised relief maps, or three dimensional (3D) topographical maps are a great visual and practical aid for gaining a better understanding of any geographical area. Using vinyl molds, raised relief maps are able to easily illustrate changes in elevation and other topographic information)"}, "madsrdf:citationSource": "Metsker Maps of Seattle website, Aug. 31, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Raised Relief Maps (raised relief maps; raised maps)"}, "madsrdf:citationSource": "McMaps.com website, Aug. 31, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(relief model: a general category which denotes any three-dimensional representation of an object or geographic area, modeled in any size or medium; see also plastic relief map, terrain model)"}, "madsrdf:citationSource": "Glossary of mapping, charting, and geodetic terms, 1973", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "relief map (a map whose surface is shaped to represent the topography in a region. Also called a terrain model or relief model) relief model (1. a model of the whole or part of the Earth's surface; 2. a representation, to scale in three dimensions, of a section of the crust of the Earth or of another celestial body. A relief model made primarily to display features on the Earth's surface is sometimes called a topographic model; 3. SEE map, relief)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Topographic models"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topographic models"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Three-dimensional topographical maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Three-dimensional topographical maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "3-D topographical maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "3-D topographical maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Three-dimensional topographic maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Three-dimensional topographic maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "3D topographic maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "3D topographic maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "3D topographical maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "3D topographical maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Relief models, Raised"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Relief models, Raised"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "3-D topographic maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "3-D topographic maps"}}, {"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb4216bcc8a549d8b8ecc5618cbfc394b38"}]}, "madsrdf:variantLabel"