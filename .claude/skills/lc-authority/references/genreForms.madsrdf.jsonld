ote": {"@language": "en", "@value": "(Braille books Use Books for the visually impaired)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 26 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0751bc7a90f64a5bb07c7f538d010b13b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Braille: A tactile system of embossed print invented in 1829 by blind Parisian Louis Braille in which the letters of the alphabet are represented by combinations of six raised dots arranged in columns three dots high and two dots wide to enable visually impaired persons to read by touch. The most widely used tactile medium in the world, Braille is employed by libraries in the United States for signage and materials for readers with visual impairments that prevent them from reading conventional print.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0751bc7a90f64a5bb07c7f538d010b13b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Braille books. BT Books)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026053"}
