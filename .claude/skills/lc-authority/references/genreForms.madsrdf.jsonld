a68daa64ef44b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ethnological maps"}}, {"@id": "_:naa564cff99ee46198cbba68daa64ef44b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnological maps"}}], "@id": "/authorities/genreForms/gf2014026012"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026028", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCowboy poetry", "identifiers:lccn": "gf2014026028", "madsrdf:adminMetadata": [{"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b1"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cowboy poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026343"}, "madsrdf:hasSource": [{"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b5"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b6"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b7"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b8"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b9"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b10"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b11"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that describe cowboys and their way of life that are generally written by people with firsthand experience of that life."}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:12:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-07-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cowboy poetry"}}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cowboy poetry is rhymed, metered verse written by someone who has lived a significant portion of his or her life in Western North American cattle culture. The verse reflects an intimate knowledge of that way of life, and the community from which it maintains itself in tradition. Cowboy poetry may or may not in fact be anonymous in authorship but must have qualities, content, and style that permit it to be accepted into the repertoire of the cultural community as reflecting that community's aesthetics in style, form, and content. The structural style of cowboy poetry has its antecedents in the ballad style of England and the Appalachian South.)"}, "madsrdf:citationSource": "What is cowboy poetry? Who is a cowboy poet?, via WWW, July 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cowboy poetry is a form of poetry which grew out of a tradition of extemporaneous composition carried on by workers on cattle drives and ranches. After a day of work, cowboys would gather around a campfire and entertain one another with tall tales and folk songs. Illiteracy was common, so poetic forms were employed to aid memory. Contrary to common belief, cowboy poetry does not actually have to be written by cowboys, though adherents would claim that authors should have some connection to the cowboy life such that they can write poetry with an \"insider's perspective\". One example of a popular \"cowboy poem\" written by a non-cowboy is \"The Ride of Paul Venarez\" by Eben E. Rexford, a 19th-century freelance author.)"}, "madsrdf:citationSource": "Wikipedia, July 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cowboy poetry is poetry by or about cowboys. Its direct origins are from the great cattle drives after the Civil War that brought beef from the isolated West to the populated cities of the North and East. This poetry blossomed as an insider's art form at the height of the cowboy in popular culture, the first half of the twentieth century. In 1985, folklorists from the West first staged a forum for cowboy poetry in Elko, Nevada. This now yearly event, The National Cowboy Poetry Gathering, sponsored by the Western Folklife Center, has spawned a grassroots arts revival throughout the American West. Cowboy poetry is a tradition of working ranch people writing, reciting, publishing, and performing poetry that illuminates the occupational life of herding cattle on horseback. It is most prevalently written in traditional forms--rhyme and meter--with structure inherited from the ballad tradition of Great Britain. However, some of the finest of this contemporary poetry breaks all the rules of the tradition. Cowboys are generally critical of the inauthentic and put a high value on poetic craftsmanship, though the values for appraising the poetry are quite different from modern, academically-based poetics.)"}, "madsrdf:citationSource": "Online Nevada encyclopedia, July 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cowboy poetry, 1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cowboy poetry. A genre of folk poetry written by people with firsthand experience in the life of horse, trail, and ranch. Cowboy poetry dates back to the mid-nineteenth century, but remains popular today. Plainspoken and often humorous, it is usually composed in songlike verse, such as ballad stanzas, and is meant to be recited aloud)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2007568459: Cowboy poetry classics, p2003.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cowboy poets & cowboy poetry, c2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1fc88baed2c4416ea70ab9a91e633f80b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cowboy poetry. Poetry written for and about the North American ranching culture, often by those involved personally in the way of life. A parallel trad. exists in Australian bush poetry, South Am. gaucho poetry, and among horseback herding people worldwide. Cowboy poetry descends from georgic, pastoral, and romantic nature poetry. Forms and modes range from unadorned imagery (similar to haiku) to narrative, lyric, sonnet, ode, ballad, free verse, and more. Folklorists have done extensive investigation of cowboy songs and poetry, but the poetry has escaped serious analysis as lit. Cowboy poetry can be divided into two kinds: written by or for the working class, and written by or for the landowner class. ... Collections of cowboy poetry written by women have appeared ... One final misconception is that the poetry comes from an oral rather than a written trad.)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026028"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026029", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpoonerisms", "identifiers:lccn": "gf2014026029", "madsrdf:adminMetadata": [{"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b1"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Spoonerisms"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, "madsrdf:hasSource": [{"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b5"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b6"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b7"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b8"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b9"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Humorous mistakes in which the speaker switches the initial sounds of two or more words."}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:12:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-07-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spoonerisms"}}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(spoonerism: A verbal error in which a speaker accidentally transposes the initial sounds or letters of two or more words, often to humorous effect, as in the sentence \"you have hissed the mystery lectures,\" accidentally spoken instead of the intended sentence \"you have missed the history lectures.\")"}, "madsrdf:citationSource": "Oxford dictionaries website, July 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bred any good rooks lately? : a collection of puns, shaggy dogs, spoonerisms, feghoots & malappropriate stories, 1986.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(spoonerism. A reversal of sounds in two words, with humorous effect; named after English clergyman and scholar William Spooner)"}, "madsrdf:citationSource": "Hirsch, E.D. The new dictionary of cultural literacy, c2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(spoonerism: a humorous mistake in which a speaker switches the first sounds of two or more words; a transposition of usually initial sounds of two or more words (as in tons of soil for sons of toil))"}, "madsrdf:citationSource": "Merriam-Webster online, July 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Nicholas, M. Silly spoonerisms!, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c2163bfecfc49ddbc47a851840ddde2b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Agee, J. Smart feller, fart smeller : and other spoonerisms, 2006.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026029"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026030", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOriginal cast recordings", "identifiers:lccn": "gf2014026030", "madsrdf:adminMetadata": [{"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb1"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Original cast recordings"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, "madsrdf:hasSource": [{"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb5"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb6"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb7"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb8"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb9"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb10"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb11"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb12"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb13"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb14"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb15"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb16"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb17"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb18"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb19"}], "madsrdf:hasVariant": [{"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb20"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb23"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb26"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb29"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-11T15:40:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-09-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Original cast recordings"}}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Loewe, F. My fair lady : original London cast recording, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Larson, J. Rent : original Broadway recording, p1996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 180 (original cast albums) p. 182 (Decca's 1943 cast recording of the original Broadway production of Oklahoma! is often cited as the first original Broadway cast album. This claim is also often disputed, since recordings of music from musical performed by members of the stage cast has been heard on records since at least the turn of the twentieth century when Emile Berliner, inventor of the gramophone, recorded songs from Florodora, featuring members of the London cast. Oklahoma!, however, in addition to its being a milestone in the development of the musical as an art form, was also a major landmark in recording history, since the success of its album release established the original cast recording as a staple element of the Broadway musical.)"}, "madsrdf:citationSource": "The Oxford handbook of the American musical, c2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Loesser, F. Guys & dolls : original cast album, p2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 181 (As historical documents, Broadway cast recordings preserve the performances of the original singers fresh from the stage, but as record albums they were conceived to be satisfying in purely aural terms. So, while a cast recording may be known to a far larger audience than ever experienced the show in the theatre, what listeners actually hear is, in the vast majority of cases, a paradoxical kind of authenticity: the original cast performing an abridged version of the music, with little or no dialogue, and with numbers sometimes presented in a different order (in the days of long-playing records, a strong ending to side one and beginning to side two were further conditioning factors). Since it is usually the cast album that provides the most lasting and most widely known documentation of a show in its 'original' form, it is worth considering the musical alterations made to transform it into a successful recording)"}, "madsrdf:citationSource": "The Cambridge companion to recorded music, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Cast recording (A cast recording is a recording of a stage musical that is intended to document the songs as they were performed in the show and experienced by the audience. An original cast recording or OCR, as the name implies, features the voices of the show's original cast. A cast recording featuring the first cast to perform a musical in a particular venue is known, for example, as an \"original Broadway cast recording\" or an \"original London cast recording\". Cast recordings are (usually) studio recordings rather than live recordings. The recorded song lyrics and orchestrations are identical (or very similar to) those of the songs as performed in the theatre. Like any studio performance, the recording is of course an idealized rendering, more glossily perfect than any live performance could be, and without audible audience reaction. Nevertheless, the listener who has attended the live show expects it to be an accurate souvenir of the experience. ... The British were the first to make cast recordings, and they were also the first to make original London cast recordings of shows that had already opened on Broadway, but had not been recorded with their original Broadway cast. ... Prior to the development of original cast recordings, there had of course been recordings of songs from musicals, and collections of several such songs, and recordings of songs performed by cast members; but they were recordings of songs, not recordings of a musical. ... The first complete so-called original cast album was Marc Blitzstein's 1938 album of songs from The Cradle Will Rock although these were recorded with just piano accompaniment and not the show's orchestra)"}, "madsrdf:citationSource": "Wikipedia, Sept. 8, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Youmans, V. No, no, Nanette : original Broadway cast recording, p1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Du Prez, J. Monty Python's Spamalot : original Broadway cast recording, p2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sound Track Album Retailers (Firm). Price guide for original cast records, 1984.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Shire, D. Big [sound recording] : the musical : original cast recording, p1996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Coleman, C. The life : the new musical : original cast recording, p1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb16", "@type": "madsrdf:Source", "madsrdf:citationSource": "Osborne, J. The official price guide to movie/TV soundtracks & original cast albums, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb17", "@type": "madsrdf:Source", "madsrdf:citationSource": "Schwartz, S. Pippin : original cast album, p2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb18", "@type": "madsrdf:Source", "madsrdf:citationSource": "Osborne, J. Movie/TV soundtracks & original cast recordings price & reference guide, c2003.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb19", "@type": "madsrdf:Source", "madsrdf:citationSource": "Broadway : the great original cast recordings, p1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cast recordings, Original"}}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cast recordings, Original"}}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Original cast albums"}}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Original cast albums"}}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cast albums, Original"}}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cast albums, Original"}}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Albums, Original cast"}}, {"@id": "_:n2575d4680a4b479d888a49e0bfdff8ccb30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Albums, Original cast"}}], "@id": "/authorities/genreForms/gf2014026030"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026031", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPicaresque drama", "identifiers:lccn": "gf2014026031", "madsrdf:adminMetadata": [{"@id": "_:n746ddd00bc79412b9d4446f413bd9becb1"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Picaresque drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n746ddd00bc79412b9d4446f413bd9becb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n746ddd00bc79412b9d4446f413bd9becb5"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb6"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb7"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb8"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb9"}], "madsrdf:hasVariant": {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Drama that describes the adventures of a resourceful rogue."}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-10-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:12:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picaresque drama"}}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 40 (Picaresque literature is a highly theatrical genre ... As a picaresque drama, Solanas's Up Your Ass, serves as an ironic and satirical comedy of manners)"}, "madsrdf:citationSource": "Warner, S. Acts of gaiety, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "publisher desc. (\"The plot of this play revolves around a lovable trickster who aims to be helpful in order to be liked. His journey to find his identity ends with him finding his true vocation on the stage.\")"}, "madsrdf:citationSource": "Work cat.: Cervantes Saavedra, M.d. Pedro, the Great Pretender, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 63 (Bertolt Brecht used the background of the Thirty Years' War for his picaresque drama Mutter Courage und ihre Kinder (Mother Courage; 1941))"}, "madsrdf:citationSource": "Wagener, H. Understanding Franz Werfel, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 90 (Gay's The Beggar's Opera represents a, perhaps better the, use of the picaresque in drama.)"}, "madsrdf:citationSource": "The picaresque, c1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 7 (roguery in the songs, stories, ballads and dramas of the seventeenth and eighteenth centuries attaining culmination of perfection in John Fletcher's \"Beggars' Bush\", Richard Brome's \"Jovial Crew or the Merry Beggars\", John Gay's \"Beggar's Opera\", and Robert Burns' \"Jolly Beggars\") p. 26 (the drama of roguery)"}, "madsrdf:citationSource": "Pabisch, M. Picaresque dramas of the 17th and 18th centuries, 1910:", "madsrdf:citationStatus": "found"}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n746ddd00bc79412b9d4446f413bd9becb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Picaresques (Drama)"}}, {"@id": "_:n746ddd00bc79412b9d4446f413bd9becb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picaresques (Drama)"}}], "@id": "/authorities/genreForms/gf2014026031"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026035", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProspectuses", "identifiers:lccn": "gf2014026035", "madsrdf:adminMetadata": [{"@id": "_:n3f870613d92a4215b4b69deb0da18857b1"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Prospectuses"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3f870613d92a4215b4b69deb0da18857b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n3f870613d92a4215b4b69deb0da18857b5"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b6"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b7"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b8"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b9"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b10"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b11"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-11-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-11-09T15:31:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prospectuses"}}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Prospectus may refer to: Prospectus (finance); Prospectus (university); Prospectus (book); Concept note, also called prospectus. Prospectus (book): A book prospectus is a printed description of or advertisement for that book, usually issued before publication in an attempt to generate interest and advance orders. The word derives from Latin, meaning literally something which gives a view or prospect (in this case of a book). Some prospectuses are lavishly-produced, especially for private press books. Printed advertisements for and catalogues of books were produced in Europe as early as the 1470s, although very few survive and what we recognize today as prospectuses (containing information on the text, physical nature, price and availability of a forthcoming book) did not develop until the seventeenth century, when they were generally issued for books published by subscription. Prospectuses are of great interest to the historian and bibliographer because they often give information about a book, its author, publisher, printer or illustrator which is not available elsewhere)"}, "madsrdf:citationSource": "Wikipedia, Sept. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "American-Yukon Company (Seattle, Wash.). Prospectus of the American-Yukon Company, Seattle, Washington, 18--", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(prospectus, plural prospectuses 1 : a preliminary printed statement that describes an enterprise (as a business or publication) and that is distributed to prospective buyers, investors, or participants 2 : something (as a statement or situation) that forecasts the course or nature of something)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Sept. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(prospectus: A separately printed announcement, usually in the form of a leaflet, distributed by a publisher to prospective purchasers, describing or sketching the plan of a forthcoming publication for the purpose of soliciting advance orders, sometimes with the added inducement of a prepublication price or discount. Usually includes a sample page and illustration, table of contents, list of contributors, and information about price and estimated date of publication. Used for major works, such as serials and expensive multivolume reference sets, to provide more detailed information than a selector can normally obtain from reading reviews and book announcements)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Sept. 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Prospectus of the Columbian gazette : a new paper proposed, if sufficient patronage be furnished, to be published in the town of Columbus, Ohio, 1815.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Adams, D. Prospectus of a periodical work, to be published at Boston, and to be entitled The medical and agricultural register, 1805.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Prospectuses (Prospectuses. SN Use for formal summaries of proposed commercial, literary, or other ventures to solicit investment, purchase, or participation. UF Subscription proposals. BT Advertisements. NT Book prospectuses; Company prospectuses) Book prospectuses (Book prospectuses. SN Use for printed descriptions or accounts, sometimes incorporating sample text or specimen pages, issued separately or as part of books or periodicals, to solicit subscription, purchase, or other patronage of forthcoming books. UF Prospectuses, Book. BT Prospectuses) Company prospectuses (Company prospectuses. SN Use for formal summaries of proposed commercial ventures distributed to prospective investors or participants. UF Business prospectuses; Commercial prospectuses; Prospectuses, Business; Prospectuses, Commercial. BT Prospectuses)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Sept. 6, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f870613d92a4215b4b69deb0da18857b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(prospectus noun, plural prospectuses. 1. a document describing the major features of a proposed literary work, project, business venture, etc., in enough detail so that prospective investors, participants, or buyers may evaluate it. 2. a brochure or other document describing the major features, attractions, or services of a place, institution, or business to prospective patrons, clients, owners, or members)"}, "madsrdf:citationSource": "Dictionary.com, Sept. 6, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026035"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026037", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAbridgments", "identifiers:lccn": "gf2014026037", "madsrdf:adminMetadata": [{"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb1"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Abridgments"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026084"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026137"}, "madsrdf:hasSource": [{"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb5"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb6"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb7"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb8"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb9"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb10"}], "madsrdf:hasVariant": [{"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb11"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb14"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb17"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb20"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Abridgments"}}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(abridgment: A shortened version or edition of a written work that preserves the overall meaning and manner of presentation of the original but omits the less important passages of text and usually any illustrations, notes, and appendices. Often prepared by a person other than the original author or editor, an abridged edition is generally intended for readers unlikely to purchase the unabridged version because of its length, complexity, or price. Also spelled abridgement. Abbreviated abr. Synonymous with condensation.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epitome 2. a condensed account, especially of a literary work; abstract) compendium (plural compendiums, compendia. Also compend. 1. a brief treatment or account of a subject, especially an extensive subject; concise treatise: a compendium of medicine. 2. a summary, epitome, or abridgment. 3. a full list or inventory)"}, "madsrdf:citationSource": "Dictionary.com, Aug. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Abridgement (An abridgement (or abridgment) is a condensing or reduction of a book or other creative work into a shorter form while maintaining the unity of the source) Epitome (An epitome is a summary or miniature form; an instance that represents a larger reality, also used as a synonym for embodiment. Epitomacy represents, \"to the degree of.\" An abridgment differs from an epitome in that an abridgment is made of selected quotations of a larger work; no new writing is composed, as opposed to the epitome, which is an original summation of a work, at least in part.)"}, "madsrdf:citationSource": "Wikipedia, July 24, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Condensed books. UF Abridged books; Book digests; Books, Abridged; Books, Condensed; Digests of books, BT Books)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Abridgements)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 24 (abridgement: epitome or compendium of a larger work) p. 35 (compendium: digest, epitome)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Condensations"}}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Condensations"}}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Abridgements"}}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Abridgements"}}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Condensed books"}}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Condensed books"}}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Abridged books"}}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Abridged books"}}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Book digests"}}, {"@id": "_:n8eccc11e98f547b2a4c22d2fbb00f00cb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Book digests"}}], "@id": "/authorities/genreForms/gf2014026037"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026038", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAbstracts", "identifiers:lccn": "gf2014026038", "madsrdf:adminMetadata": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b1"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Abstracts"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026084"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b5"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b6"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b7"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b8"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b9"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b10"}], "madsrdf:hasVariant": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b11"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b14"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b17"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b20"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b23"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b26"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b29"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b32"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Abstracts"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstract (a brief written statement of the main points or facts in a longer report, speech, etc. Synonyms: summary, breviary, brief, capsule, conspectus, digest, encapsulation, epitome, inventory, outline, pr\u00e9cis, recap, recapitulation, r\u00e9sum\u00e9 (or resume also resum\u00e9), roundup, rundown, run-through, sum, summa, summarization, summing-up, sum-up, synopsis, wrap-up) compendium (1: a brief summary of a larger work or of a field of knowledge : abstract) pr\u00e9cis (plural pr\u00e9cis; a brief summary of the main points and ideas of a piece of writing or speech. Synonyms: abstract, breviary, brief, capsule, conspectus, digest, encapsulation, epitome, inventory, outline, summary, recap, recapitulation, r\u00e9sum\u00e9 (or resume also resum\u00e9), roundup, rundown, run-through, sum, summa, summarization, summing-up, sum-up, synopsis, wrap-up) synopsis (plural synopses; 1 : a condensed statement or outline (as of a narrative or treatise) : abstract. 2 : the abbreviated conjugation of a verb in one person only; epitome 1a: a summary of a written work)"}, "madsrdf:citationSource": "Merriam-Webster online, June 25, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subdivision --Abstracts. Use as a form subdivision under names of countries, cities, etc., and under classes of persons, ethnic groups, and topical headings for works that list publications on the subject and provide full bibliographical information together with substantive summaries or condensations of the facts, ideas, or opinions presented in each publication listed. Use under names of individual persons and corporate bodies for abstracts of works by or about the person or corporate body. Also use under types of publications for works that summarize the contents of those publications.)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epitome 2. a condensed account, especially of a literary work; abstract) compendium (plural compendiums, compendia. Also compend. 1. a brief treatment or account of a subject, especially an extensive subject; concise treatise: a compendium of medicine. 2. a summary, epitome, or abridgment. 3. a full list or inventory)"}, "madsrdf:citationSource": "Dictionary.com, Aug. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 24 (abstract: summary of book or document) p. 64 (pr\u00e9cis: summary, abstract)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(abstracts (summaries). Brief summaries that provide the essential points of written works, such as the content of a publication or of a journal. UF abstract (summary); pr\u00e9cis)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, June 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Abstract (summary) (An abstract is a brief summary of a research article, thesis, review, conference proceeding or any in-depth analysis of a particular subject or discipline, and is often used to help the reader quickly ascertain the paper's purpose. When used, an abstract always appears at the beginning of a manuscript or typescript, acting as the point-of-entry for any given academic paper or patent application. Abstracting and indexing services for various academic disciplines are aimed at compiling a body of literature for that particular subject. The terms pr\u00e9cis or synopsis are used in some publications to refer to the same thing that other publications might call an \"abstract\". In management reports, an executive summary usually contains more information (and often more sensitive information) than the abstract does.)"}, "madsrdf:citationSource": "Wikipedia, June 25, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epitomes"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epitomes"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Compendia"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Compendia"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Compendiums"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Compendiums"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Compends"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Compends"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pr\u00e9cis"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pr\u00e9cis"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Summaries of publications"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Summaries of publications"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Synopses (Abstracts)"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Synopses (Abstracts)"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a1bf577810c447db3556f50399d4427b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Publication summaries"}}, {"@id": "_:n7a1bf577810c447db3556f50399d4427b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Publication summaries"}}], "@id": "/authorities/genreForms/gf2014026038"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026039", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAcademic theses", "identifiers:lccn": "gf2014026039", "madsrdf:adminMetadata": [{"@id": "_:n2664120ad97543c7afb09999a61c426fb1"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Academic theses"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2664120ad97543c7afb09999a61c426fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n2664120ad97543c7afb09999a61c426fb5"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb6"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb7"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb8"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb9"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb10"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb11"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb12"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb13"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb14"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb15"}], "madsrdf:hasVariant": [{"@id": "_:n2664120ad97543c7afb09999a61c426fb16"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb19"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb22"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb25"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb28"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb31"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb34"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb37"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb40"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb43"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb46"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb49"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb52"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb55"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb58"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb61"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb64"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb67"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb70"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb73"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:20:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Academic theses"}}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "contents (Graduating with honors : writing your senior thesis)"}, "madsrdf:citationSource": "Shoup, K. What can you do with a major in business?, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Thesis by Claudia Maria Ludescher in partial fulfilment of the requirements for the Degree of Bachelor of Applied Science - Environment Studies with Honours)"}, "madsrdf:citationSource": "Ludescher, C.M. Perceived meanings of \"ecologically sustainable development\" within the CRC Reef Research Centre, 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(thesis: A proposition advanced and defended in a formal disputation, especially by a candidate in partial fulfillment of university requirements for a master's degree; Master's theses. Compare with dissertation; dissertation: A lengthy, formal written treatise or thesis, especially an account of scholarly investigation or original research on a specialized topic, submitted to a university in partial fulfillment of the requirements for a Ph.D. degree.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Thesis. A thesis or dissertation is a document submitted in support of candidature for an academic degree or professional qualification presenting the author's research and findings. In some contexts, the word \"thesis\" or a cognate is used for part of a bachelor's or master's course, while \"dissertation\" is normally applied to a doctorate, while in other contexts, the reverse is true. Dissertations and theses may be considered as grey literature; Master's theses; PhD theses; doctoral theses; senior theses; academic thesis; bachelor's thesis; diploma thesis; master thesis; undergraduate thesis; bachelors thesis; licentiate dissertation; graduate thesis or dissertation; academic dissertation; doctoral dissertation; senior projects)"}, "madsrdf:citationSource": "Wikipedia, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(series: Amherst College honors thesis)"}, "madsrdf:citationSource": "Rein, B.W. An analysis and critique of the Union financing of the Civil War, 1962", "madsrdf:citationStatus": "found"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (A thesis submitted in fulfilment of the requirement for the degree of Bachelor of Architecture (Honours), University of Sydney)"}, "madsrdf:citationSource": "Gurr, L.M. Nelson Lodge, 1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dissertations, Academic. UF Academic dissertations; Theses)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (An undergraduate honours thesis presented to the Government Department, Harvard University, in the spring of 1961)"}, "madsrdf:citationSource": "Wilkinson, R. The prefects, 1964:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (University of Tennesee Honors Thesis Projects)"}, "madsrdf:citationSource": "Roberts, D.S. Why we don't vote, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Academic dissertations. UF Dissertations, academic; Theses)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 40 (dissertation) p. 83 (thesis: dissertation (for university degree))"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2664120ad97543c7afb09999a61c426fb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Master's dissertations"}}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Master's dissertations"}}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2664120ad97543c7afb09999a61c426fb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Doctoral dissertations"}}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Doctoral dissertations"}}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2664120ad97543c7afb09999a61c426fb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Senior theses"}}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Senior theses"}}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2664120ad97543c7afb09999a61c426fb26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ph. D. dissertations"}}, {"@id": "_:n2664120ad97543c7afb09999a61c426fb26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ph. D. dissertations"}}, {"@id": "_:n2664120ad9754