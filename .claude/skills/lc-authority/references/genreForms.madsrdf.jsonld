{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026814", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFrat rock music", "identifiers:lccn": "gf2014026814", "madsrdf:adminMetadata": [{"@id": "_:n5de763916a8848d298c428b6104203d9b1"}, {"@id": "_:n5de763916a8848d298c428b6104203d9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Frat rock music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5de763916a8848d298c428b6104203d9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}, "madsrdf:hasSource": [{"@id": "_:n5de763916a8848d298c428b6104203d9b5"}, {"@id": "_:n5de763916a8848d298c428b6104203d9b6"}, {"@id": "_:n5de763916a8848d298c428b6104203d9b7"}], "madsrdf:hasVariant": {"@id": "_:n5de763916a8848d298c428b6104203d9b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5de763916a8848d298c428b6104203d9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-19T16:40:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5de763916a8848d298c428b6104203d9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5de763916a8848d298c428b6104203d9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Frat rock music"}}, {"@id": "_:n5de763916a8848d298c428b6104203d9b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grovemusic.com WWW site, Jan. 27, 2003;Shuker, R. Key concepts pop. mus.;White, D. Dict. pop. mus. styles world;Pickering, D. Cassell comp. 20th-cent. mus.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n5de763916a8848d298c428b6104203d9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Frat rock was garage rock before there was garage rock--big, dumb party music that was raw, ragged, and fun. Songs like \"Double Shot of My Baby's Love\" and \"Louie Louie\"--singles that were so catchy and so simple, any band could cover them and sound good. These songs were favorites of covers bands in the early '60s, when local bands frequently played parties at fraternity houses)"}, "madsrdf:citationSource": "All music guide WWW site, Jan. 27, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n5de763916a8848d298c428b6104203d9b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2001126057: Hall, R. Playing for a piece of the door, c2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5de763916a8848d298c428b6104203d9b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5de763916a8848d298c428b6104203d9b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fraternity rock music"}}, {"@id": "_:n5de763916a8848d298c428b6104203d9b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fraternity rock music"}}], "@id": "/authorities/genreForms/gf2014026814"}
