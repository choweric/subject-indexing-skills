, "ri:recordStatus": "revised"}, {"@id": "_:n1b45bc93c6a54a4b81664530316491deb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musical games"}}, {"@id": "_:n1b45bc93c6a54a4b81664530316491deb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1b45bc93c6a54a4b81664530316491deb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Games with music"}}, {"@id": "_:n1b45bc93c6a54a4b81664530316491deb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Games with music"}}], "@id": "/authorities/genreForms/gf2014026954"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026955", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMusical parodies", "identifiers:lccn": "gf2014026955", "madsrdf:adminMetadata": [{"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b1"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Musical parodies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b3"}]}, "madsrdf:exampleNote": "Note under [Contrafacta; Song parodies]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026869"}, "madsrdf:hasSource": [{"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b5"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b6"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b7"}], "madsrdf:hasVariant": [{"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b8"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b11"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b14"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Compositions that distort or exaggerate features of another composition or a composer's works in general for humorous or satirical ends. For vocal works from the Middle Ages or Renaissance in which a new text has been substituted for the original without a significant change to the music see [Contrafacta.] For post-Renaissance songs in which a new text has been substituted for the original without a significant change to the music see [Song parodies.]"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-23T12:31:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "revised"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musical parodies"}}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Parody, 2: A work in which a new text has been substituted for the original, often without humorous intent; a work of this type from the Middle Ages or Renaissance is usually termed a contrafactum)"}, "madsrdf:citationSource": "New Harvard Dictionary of Music,", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Parody (1: A work that, with humorous or satirical aims, makes distorted or exaggerated use of some other work or type of work. 2: A work in which a new text has been substituted for the original, often without humorous intent. A work of this type from the Middle Ages or Renaissance is usually termed a contrafactum. 3: A composition that seriously reworks the musical material of another composition.)"}, "madsrdf:citationSource": "New Harvard dict. of mus:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Parody ii (A composition generally of humorous or satirical intent in which turns of phrase or other features characteristic of another composer or type of composition are employed and made to appear ridiculous, especially through their application to ludicrously inappropriate subjects.) Under Parody i (A term used to denote a technique of composition, primarily associated with the 16th century, involving the use of pre-existing material.)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Nov. 1, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Opera parodies"}}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Opera parodies"}}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Operatic parodies"}}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Operatic parodies"}}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Parodies (Music)"}}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Parodies (Music)"}}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Parodies, Operatic"}}, {"@id": "_:n4fe0bf736c4245a693fa9ea715f8c882b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Parodies, Operatic"}}], "@id": "/authorities/genreForms/gf2014026955"}
