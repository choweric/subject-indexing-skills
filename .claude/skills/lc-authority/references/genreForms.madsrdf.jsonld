value": "Television dance parties"}}, {"@id": "_:ne2b80db7c9204df79942f9f8bfe00196b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 40 (Dance parties and contests: use for programs which focus on dancing by members of the viewing public. Competition is often involved.)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2b80db7c9204df79942f9f8bfe00196b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Television dance parties)"}, "madsrdf:citationSource": "LCSH, October 22, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2b80db7c9204df79942f9f8bfe00196b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2b80db7c9204df79942f9f8bfe00196b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dance parties, Television"}}, {"@id": "_:ne2b80db7c9204df79942f9f8bfe00196b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dance parties, Television"}}], "@id": "/authorities/genreForms/gf2011026659"}
