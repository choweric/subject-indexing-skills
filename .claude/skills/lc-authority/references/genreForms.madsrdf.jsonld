748ec552da763b48"}, {"@id": "_:n655f88398f42471bb86748ec552da763b51"}, {"@id": "_:n655f88398f42471bb86748ec552da763b54"}, {"@id": "_:n655f88398f42471bb86748ec552da763b57"}, {"@id": "_:n655f88398f42471bb86748ec552da763b60"}, {"@id": "_:n655f88398f42471bb86748ec552da763b63"}, {"@id": "_:n655f88398f42471bb86748ec552da763b66"}, {"@id": "_:n655f88398f42471bb86748ec552da763b69"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that comically imitate another work or group of works of a more serious nature. For films that use wit, irony, or sarcasm to hold up human vices or foibles to ridicule or scorn see [Satirical films.]", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026028"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025344"}]}, {"@id": "_:n655f88398f42471bb86748ec552da763b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n655f88398f42471bb86748ec552da763b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T09:56:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n655f88398f42471bb86748ec552da763b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Parody films"}}, {"@id": "_:n655f88398f42471bb86748ec552da763b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n655f88398f42471bb86748ec552da763b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Austin Powers films"}}, {"@id": "_:n655f88398f42471bb86748ec552da763b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Austin Powers films"}}, {"@id": "_:n655f88398f42471bb86748ec552da763b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 469, entry under: Parody (In films, a humorous imitation of another work, such as a particular novel, play, poem, or another film; spoof; silent parodies; film parodies)"}, "madsrdf:citationSource": "Langman, L. Encyc. of Am. film comedy, 1987:", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(spoof 1. a mocking imitation of someone or something, usually light and good-humored; lampoon or parody)"}, "madsrdf:citationSource": "Random House Web. unabr. dict., c1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under genre: Parody film, see Parody (Parody: an imitation, and distortion, of a more serious film for humorous effect; Spoof: a parody or mockery of another film or film genre)"}, "madsrdf:citationSource": "Geduld, H.M. An ill. glossary of film terms, c1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(parody: Satirical or humorous imitation of a serious subject. Related terms: satire, spoof, takeoff; spoof: Humorous parody. For example, Airplane! (1980) was a spoof of airplane disaster films; takeoff: Another name for a parody. Also called a send-up)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dict., c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(January 23, 1932: Educational Films Corporation signs 3-year-old Shirley Temple to appear in a series of film take-offs called Baby Burlesks; film takeoffs; film sendups of the traditional genre film; one of the funniest h'wood film sendups; horror film send-ups; feature-film send-ups of that oh-so-'70s sitcom [The Brady Bunch]; The Wizard of Oz has appeared in various recent film send-ups; silent film send-ups)"}, "madsrdf:citationSource": "Google search, Dec. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(parody: A work that comically imitates another work or group of works of a more serious nature. The parody performs its humorous imitation by picking out the more pronounced and sometimes silly elements of its subject and exaggerating them, though it may do so in a good-natured as well as satiric manner; takeoff)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dict., 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(spoof n. 2: a light, amiable, humorous but usu. telling takeoff (as on human nature, customs, or manners) : parody)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "thesaurus (spoof - a composition that imitates or misrepresents somebody's style, usually in a humorous way: parody, pasquinade, put-on, sendup, charade, lampoon, mockery, burlesque, travesty, takeoff)"}, "madsrdf:citationSource": "TheFreeDictionary website, Dec. 8, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 9, p. 290 (genre parody: \"In the 1980s ... genre parody would become a genre unto itself ... archival pastiches like Dead Man Don't Wear Plaid, mock documentaries like This is Spinal Tap, and parody series like those originating with Airplane! and The Naked Gun)"}, "madsrdf:citationSource": "History of the American cinema, c1990:", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 219-220, entry under: parody films (parodies of famous films and film genres; the Western parody Blazing Saddles and the horror spoof Young Frankenstein; movie parodies)"}, "madsrdf:citationSource": "Siegel, S. American film comedy, c1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(spoof 3. A gentle satirical imitation; a light parody)"}, "madsrdf:citationSource": "Am. herit. dict. of the Eng. lang., c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b19", "@type": "madsrdf:Source", "madsrdf:citationSource": "The top 25 best parody/take off movies, via YouTube, viewed Dec. 8, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(spoof noun (Informal) parody, take-off (informal), satire, caricature, mockery, send-up (Brit. informal), travesty, lampoon, burlesque)"}, "madsrdf:citationSource": "Collins thesaurus of the English language, via TheFreeDictionary website, Dec. 8, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n655f88398f42471bb86748ec552da763b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n655f88398f42471bb86748ec552da763b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@va