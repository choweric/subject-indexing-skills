{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026046", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPicture discs (Sound recordings)", "identifiers:lccn": "gf2022026046", "madsrdf:adminMetadata": [{"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb1"}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Picture discs (Sound recordings)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027251"}], "madsrdf:hasSource": [{"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb5"}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb6"}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb7"}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb8"}], "madsrdf:hasVariant": {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb9"}, "madsrdf:historyNote": "[Established November 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-06-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-14T11:32:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picture discs (Sound recordings)"}}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Picture discs--records with an image; Picture discs are records that appear to have pictures, images, or graphics on their playing surface. While most phonograph records are black, except for the label in the center, picture discs may display a photograph or artwork over the entire playing surface. Picture discs look like round photographs, though unlike photographs, they can also play music. From a manufacturing standpoint, picture discs consist of a solid core, made of plastic, paper, or metal, that has a paper image placed over it. The core and photo are then covered with clear vinyl and the grooves are pressed on top of them using traditional record presses. This process necessarily uses less vinyl in the grooves than standard records, and often yields less-than-optimal sound quality. Because of their substandard sound quality, most picture discs are produced as limited edition products, generally targeted at collectors, and are intended to supplement the supply of standard black vinyl records)"}, "madsrdf:citationSource": "RareRecords.net WWW site, October 3, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Bush, Kate. The kick inside, 1978.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 6 (A picture disc is a phonograph record. It has a picture or graphics paper (or cardboard) sheet underneath the grooves of clear (transparent) vinyl, plastic, or shellac)"}, "madsrdf:citationSource": "Lindsay, J. Picture discs of the world, 1990 :", "madsrdf:citationStatus": "found"}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "edition statement (12\" picture disc vinyl single)"}, "madsrdf:citationSource": "Work cat: Macintosh Plus. Sick & panic, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Discs, Pictures (Sound recordings)"}}, {"@id": "_:ne86adf0e22a640a3a0bfb5927d44cb0cb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Discs, Pictures (Sound recordings)"}}], "@id": "/authorities/genreForms/gf2022026046"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026048", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSubject dictionaries", "identifiers:lccn": "gf2022026048", "madsrdf:adminMetadata": [{"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b1"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Subject dictionaries"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026086"}, "madsrdf:hasSource": [{"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b5"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b6"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b7"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b8"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b9"}], "madsrdf:hasVariant": [{"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b10"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b13"}], "madsrdf:historyNote": "[Established November 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-14T11:32:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-07-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Subject dictionaries"}}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a subject dictionary) (OCoLC)1261878973"}, "madsrdf:citationSource": "Work cat.: Earl, Richard. The concise Oxford dictionary of mathematics, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "H 1540, p. 3 (Subject dictionaries; works consisting of comprehensive, alphabetical lists of terms pertaining to those subjects, usually with definitions)"}, "madsrdf:citationSource": "Subject headings manual, via WWW, July 1, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subject dictionary; subject-specific dictionary)"}, "madsrdf:citationSource": "Glosbe dictionary website, July 1, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Subject Dictionaries (Subject dictionaries explain terms associated with specialized subject fields, occupations, or professions. They define unique terms and words not usually found in general dictionaries. There are law dictionaries, mathematics dictionaries, music dictionaries, and genealogical dictionaries. Specialized dictionaries can be found in most library reference collections and should not be overlooked by family historians)"}, "madsrdf:citationSource": "RootsWeb, July 1, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Single-field dictionary (A single-field dictionary is a specialized dictionary that has been designed and compiled to cover the terms of one particular subject field; Examples of single-field dictionaries are a dictionary of law, a dictionary of economics and a dictionary of welding) Dictionary (A broad distinction is made between general and specialized dictionaries. Specialized dictionaries include words in specialist fields, rather than a complete range of words in the language; The word dictionary (unqualified) is usually understood to refer to a general purpose monolingual dictionary)"}, "madsrdf:citationSource": "Wikipedia, July 1, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Single-field dictionaries"}}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Single-field dictionaries"}}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Subject-specific dictionaries"}}, {"@id": "_:n7531dd8c27bc4872ae7ccc8cdde38418b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Subject-specific dictionaries"}}], "@id": "/authorities/genreForms/gf2022026048"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026049", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMaskanda", "identifiers:lccn": "gf2022026049", "madsrdf:adminMetadata": [{"@id": "_:n1be6ccc523804beaa3b1e629334c027cb1"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Maskanda"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1be6ccc523804beaa3b1e629334c027cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n1be6ccc523804beaa3b1e629334c027cb5"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb6"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb7"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb8"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb9"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb10"}], "madsrdf:hasVariant": {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb11"}, "madsrdf:historyNote": "[Established November 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-07-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maskanda"}}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Maskanda; urban performance style from South Africa; Maskanda describes a musical genre typically performed by young Zulu men, many of whom have been involved in the migrant labour system, mixing indigenous, rural musical practices with urban styles. The practice clearly dates back to the early 20th century, but it possibly has earlier roots in the introduction of the guitar by Portuguese sailors in the 1880s; a common theme is nostalgic longing for rural homelands and loved ones, or commentary on the urban situation)"}, "madsrdf:citationSource": "Grove music online, May 20, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(maskanda; from Zulu umaskanda, from Afrikaans musikant (\"musician\"); alternative forms: maskandi; noun: maskanda (uncountable). 1. (South Africa) A style of Zulu folk music, normally played solo)"}, "madsrdf:citationSource": "Wiktionary, July 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "What is maskanda? (Maskanda is a subgenre of Zulu folk music, born in South Africa; singers often sing about real life experiences, daily joys and sorrows, and observations of the world; often played on acoustic guitars; other common Maskanda instruments include violins, concertinas, mouth organs, and jaw harps. Male Maskandi traditionally play guitar, concertina, or violin, while women Maskandi more often play mouth organs or jaw harps; the music has improvisational elements, allowing musicians to compose and compete with one another)"}, "madsrdf:citationSource": "Afropop Worldwide WWW site, July 11, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (subtitle: Zulu guitars dance, maskanda from South Africa)"}, "madsrdf:citationSource": "Work cat: Introducing Shiyani Ngcobo, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Maskandi (redirected from Maskanda; maskandi is a kind of Zulu folk music that is evolving with South African society; typically played on cheap, portable instruments, or modern instruments tuned or produced to imitate the polyphonic sounds of the old instruments; etymologically the word derives from the Afrikaans musikante (musicians))"}, "madsrdf:citationSource": "Wikipedia, July 11, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Maskanda) p. vi (popular music style in South Africa)"}, "madsrdf:citationSource": "Titus, Barbara, 1973- Hearing maskanda, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1be6ccc523804beaa3b1e629334c027cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Maskandi"}}, {"@id": "_:n1be6ccc523804beaa3b1e629334c027cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maskandi"}}], "@id": "/authorities/genreForms/gf2022026049"}
