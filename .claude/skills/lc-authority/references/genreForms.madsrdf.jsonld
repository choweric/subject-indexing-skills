42eaafed43a29efe1699b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Avodah piyyutim"}}, {"@id": "_:n76d8f4cc54a542eaafed43a29efe1699b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Idelsohn, A.Z. Jewish liturgy and its development, 1932: p. 42 (\"Almost every prominent payetan [author of piyutim] attempted to write an Avoda [singular form]\"; Avodoth)", "madsrdf:citationStatus": "found"}, {"@id": "_:n76d8f4cc54a542eaafed43a29efe1699b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Penn Library WWW site, Feb. 4, 2005: Online Exhibition \"Challenging Boundaries\" (Avodah piyyutim)", "madsrdf:citationStatus": "found"}, {"@id": "_:n76d8f4cc54a542eaafed43a29efe1699b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Association of Jewish Studies WWW site, Feb. 4, 2005: 31st annual conference program (Avodah piyyutim)", "madsrdf:citationStatus": "found"}, {"@id": "_:n76d8f4cc54a542eaafed43a29efe1699b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2005002648: Swartz, M. Avodah, 2005: ECIP galley (Avodah piyyutim, Avodah poems; these poems treat of the creation of the world, the patriarchs of humanity, the history of the Jews, and the details of the Yom Kippur liturgy; \"Some of the most prominent poets of medieval Spain ... composed Avodah piyyutim. In the southern Italian, Byzantine and Franco-German (Ashkenazic)communities, this genre continued as well\")", "madsrdf:citationStatus": "found"}, {"@id": "_:n76d8f4cc54a542eaafed43a29efe1699b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Judaica: v. 3, col. 978 (Avodah piyyut [singular form]) v. 5, col. 1379 (piyyutim of the Avodah)", "madsrdf:citationStatus": "found"}, {"@id": "_:n76d8f4cc54a542eaafed43a29efe1699b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n76d8f4cc54a542eaafed43a29efe1699b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Avodoth"}}, {"@id": "_:n76d8f4cc54a542eaafed43a29efe1699b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Avodoth"}}, {"@id": "_:n76d8f4cc54a542eaafed43a29efe1699b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n76d8f4cc54a542eaafed43a29efe1699b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Piyyutim of the Avodah"}}, {"@id": "_:n76d8f4cc54a542eaafed43a29efe1699b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Piyyutim of the Avodah"}}], "@id": "/authorities/genreForms/gf2014026641"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026642", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAyres", "identifiers:lccn": "gf2014026642", "madsrdf:adminMetadata": [{"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b1"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ayres"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": [{"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b5"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b6"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b7"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b8"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b9"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b10"}], "madsrdf:hasVariant": [{"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b11"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b14"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "English lute-songs of the late 16th and early 17th centuries."}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T09:57:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ayres"}}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Air (ayre; lute ayre; As well as the parts for solo voice and lute ... composers generally provided an optional part for bass viol, and often extra vocal parts as well, for alto, tenor, and bass. Thus the ayres could be performed as solo songs with instrumental accompaniment, or as partsongs for several voices; or if desired, the extra vocal parts could be performed on instruments.)"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (Ayre/Ayres: Type (English))"}, "madsrdf:citationSource": "Final rpt. of the Working Grp. on Types of Compositions, 2nd ed., 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ayre, (1) The English lute-accompanied song of the late 16th and early 17th centuries. Such pieces were often published with an optional bass viol part or with three additional vocal parts.)"}, "madsrdf:citationSource": "New Harvard dict. of music, 1986", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ayre: archaic var. of AIR)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 97019868: Fischlin, D. In small proportions : a poetics of the English ayre, 1596-1622.", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lute-songs; airs)"}, "madsrdf:citationSource": "LC database, May 15, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lute-songs"}}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lute-songs"}}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Airs (Lute-songs)"}}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Airs (Lute-songs)"}}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lute-ayres"}}, {"@id": "_:nfc9c8dcc6e764fc0a11af5fe9d211cd7b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lute-ayres"}}], "@id": "/authorities/genreForms/gf2014026642"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026643", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBachata", "identifiers:lccn": "gf2014026643", "madsrdf:adminMetadata": [{"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb1"}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bachata"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb5"}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb6"}], "madsrdf:hasVariant": [{"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb7"}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb10"}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb13"}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bachata"}}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bachata; Dominican musical genre and dance; developed out of earlier rural string musics, principally bolero but also son, merengue, and ranchera; originally applied to the informal rural parties where such music was played; in the 1960s, bachata developed as part of the urban underworld and changed from a romantic serenade style to one associated with brothels and harsh lyrics; at that time it was known as musica de amargue or musica de guardia; in the 1980s Blas Dur\u00e1n's experiments with electric guitar and the development of a unique dance style began to expand bachata's audience; today it is played with two electroacoustic guitars, electric bass, g\u00fcira, and bongos)"}, "madsrdf:citationSource": "Grove music online, viewed August 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP galley (bachata, or m\u00fasica de amargue; guitar-based Dominican popular music form of uneducated country people and the urban poor)"}, "madsrdf:citationSource": "Work cat.: 94-29477: Pacini-Hernandez, D. Bachata, 1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Amargue, M\u00fasica de"}}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Amargue, M\u00fasica de"}}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "M\u00fasica de amargue"}}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "M\u00fasica de amargue"}}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Guardia, M\u00fasica de"}}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Guardia, M\u00fasica de"}}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "M\u00fasica de guardia"}}, {"@id": "_:nfe182ce6a1d24dc1a77a0f440017553cb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "M\u00fasica de guardia"}}], "@id": "/authorities/genreForms/gf2014026643"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026644", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBail\u0101 (Music)", "identifiers:lccn": "gf2014026644", "madsrdf:adminMetadata": [{"@id": "_:nab115a4cf4d94c8588b5663c414fb834b1"}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bail\u0101 (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nab115a4cf4d94c8588b5663c414fb834b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nab115a4cf4d94c8588b5663c414fb834b5"}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b6"}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b7"}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b8"}], "madsrdf:hasVariant": [{"@id": "_:nab115a4cf4d94c8588b5663c414fb834b9"}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bail\u0101 (Music)"}}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Sri Lanka, Popular music: Bail\u0101 is a popular music and dance genre with probable roots in Afro-Portuguese performance traditions in Sri Lanka. Whether amplified or acoustic, bail\u0101 music characteristically uses instrumental combinations that include the banjo or mandolin, violin, guitar, rab\u0101na (hand-held frame drum), and a pair of congas. When it involves a solo singer and a chorus, it is known as chorus bail\u0101, a genre brought into prominence via radio by Wally Bastiansz (1913-85). V\u0101de (\"debate\") bail\u0101, less common than chorus bail\u0101, calls on performers to extemporize on themes and melodies set by a panel of judges or by the audience)"}, "madsrdf:citationSource": "Grove music online WWW site, July 18, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2004314653: Per\u0113r\u0101, \u0100r.S. 1505 si\u1e6da ada dakv\u0101 bayil\u0101 kal\u0101va, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Sri Lanka: baila: fast modern dance music accompanied by electric guitar, bass, drums, etc.; updated form of \"kaffrinna\" music; from the Portuguese word for \"dance\")"}, "madsrdf:citationSource": "White, D. Dict. pop. mus. styles world", "madsrdf:citationStatus": "found"}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 5, p. 976 (bail\u0101 (also bayala): popular Sinhalese music and dance genre in Sri Lanka incorporating Portuguese rhythms)"}, "madsrdf:citationSource": "Garland encyc. world mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab115a4cf4d94c8588b5663c414fb834b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bayala (Music)"}}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bayala (Music)"}}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab115a4cf4d94c8588b5663c414fb834b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bayil\u0101 (Music)"}}, {"@id": "_:nab115a4cf4d94c8588b5663c414fb834b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bayil\u0101 (Music)"}}], "@id": "/authorities/genreForms/gf2014026644"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026645", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBallad operas", "identifiers:lccn": "gf2014026645", "madsrdf:adminMetadata": [{"@id": "_:n7f1816059dec4fc980c84f5a8da271c8b1"}, {"@id": "_:n7f1816059dec4fc980c84f5a8da271c8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ballad operas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7f1816059dec4fc980c84f5a8da271c8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026046"}, "madsrdf:hasSource": {"@id": "_:n7f1816059dec4fc980c84f5a8da271c8b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "English dramatic form of the mid-18th century, in which songs set to traditional or popular melodies were integrated into the dramatic structure of a play."}, {"@id": "_:n7f1816059dec4fc980c84f5a8da271c8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n7f1816059dec4fc980c84f5a8da271c8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:20:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7f1816059dec4fc980c84f5a8da271c8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ballad operas"}}, {"@id": "_:n7f1816059dec4fc980c84f5a8da271c8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ballad opera; A distinctively English form in which spoken dialogue alternates with songs set to traditional or popular melodies and sung by the actors themselves. A vogue for the form was sparked by the enormous popularity of John Gay's The Beggar's Opera (January 1728) but faded out by the mid-1730s... The term 'ballad opera' is a misnomer. The works so described are plays (almost always comic, usually farcical) into which a variety of songs have been worked. Fewer than half the songs are actually popular ballads... In every instance, however, the music is fitted with new words, and the songs are integrated into the dramatic structure of the play, not simply interpolated as variety or entr'acte entertainment.)"}, "madsrdf:citationSource": "Grove music online, viewed April 7, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026645"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026646", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBallades (Instrumental music)", "identifiers:lccn": "gf2014026646", "madsrdf:adminMetadata": [{"@id": "_:na14ed34b655b4d4ab8417492d5247366b1"}, {"@id": "_:na14ed34b655b4d4ab8417492d5247366b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ballades (Instrumental music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na14ed34b655b4d4ab8417492d5247366b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:na14ed34b655b4d4ab8417492d5247366b5"}, {"@id": "_:na14ed34b655b4d4ab8417492d5247366b6"}, {"@id": "_:na14ed34b655b4d4ab8417492d5247366b7"}, {"@id": "_:na14ed34b655b4d4ab8417492d5247366b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na14ed34b655b4d4ab8417492d5247366b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na14ed34b655b4d4ab8417492d5247366b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na14ed34b655b4d4ab8417492d5247366b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ballades (Instrumental music)"}}, {"@id": "_:na14ed34b655b4d4ab8417492d5247366b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ballade; a term applied to an instrumental (normally piano) piece in a narrative style; first used by Chopin)"}, "madsrdf:citationSource": "Grove music online, viewed August 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na14ed34b655b4d4ab8417492d5247366b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 69, col. 1 (Ballade; may be instrumental or vocal, the former sometimes with explicit or inferable relation to the literary genre)"}, "madsrdf:citationSource": "New Harvard dict. of music:", "madsrdf:citationStatus": "found"}, {"@id": "_:na14ed34b655b4d4ab8417492d5247366b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3.", "madsrdf:citationStatus": "found"}, {"@id": "_:na14ed34b655b4d4ab8417492d5247366b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP t.p. (instrumental ballade)"}, "madsrdf:citationSource": "Work cat.: Parakilas, J. Ballads without words, c1992:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026646"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026647", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBallades (Formes fixes)", "identifiers:lccn": "gf2014026647", "madsrdf:adminMetadata": [{"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b1"}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ballades (Formes fixes)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": [{"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b5"}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b6"}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b7"}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b8"}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ballades (Formes fixes)"}}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3.", "madsrdf:citationStatus": "found"}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ballade; one of the three formes fixes of 14th-century French poetry and music)"}, "madsrdf:citationSource": "Harvard dict. of music", "madsrdf:citationStatus": "found"}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ballade. One of the three formes fixes (the others are the rondeau and the virelai) that dominated French song and poetry in the 14th and 15th centuries. In its standard late medieval shape the ballade text falls into three stanzas, sharing the same metrical and rhyme scheme and ending with the same refrain. The music for each stanza follows the overall pattern I-I-II. )"}, "madsrdf:citationSource": "Grove music online, viewed August 4, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Binchois, G. Gilles Binchois [SR] p1979.", "madsrdf:citationStatus": "found"}, {"@id": "_:nee8bfda53d9b48b88c25753d5646cab4b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026647"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026648", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBallads", "identifiers:lccn": "gf2014026648", "madsrdf:adminMetadata": [{"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b1"}, {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ballads"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026961"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026734"}, "madsrdf:hasSource": [{"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b5"}, {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b6"}, {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b7"}], "madsrdf:hasVariant": {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "European and North American narrative songs that describe a dramatic episode in strophic form, often with a recurrent refrain."}, {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T09:57:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ballads"}}, {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Friedman, A.B. The Viking book of folk ballads of ... 1956.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ballad; term used for a short popular traditional song that normally frames a narrative element. Scholars of the term's history and origin take it to signify a relatively concise composition known throughout Europe since the late Middle Ages, spreading later to the New World, notably the Americas: it combines narrative, dramatic dialogue and lyrical passages in strophic form sung to a rounded tune, and often includes a recurrent refrain. Performance is predominantly by solo singers, though choral and dance elements are known in some cultures.)"}, "madsrdf:citationSource": "Grove music online, viewed July 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Southern folk ballads, 1987-1988.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Folk ballads"}}, {"@id": "_:n3525caa6f3584b3fb68bda624c5decb5b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folk ballads"}}], "@id": "/authorities/genreForms/gf2014026648"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026649", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBallate", "identifiers:lccn": "gf2014026649", "madsrdf:adminMetadata": [{"@id": "_:n2e30bfc4fc1b4d4583e1b48cdee3a3e2b1"}, {"@id": "_:n2e30bfc4fc1b4d4583e1b48cdee3a3e2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ballate"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2e30bfc4fc1b4d4583e1b48cdee3a3e2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": {"@id": "_:n2e30bfc4fc1b4d4583e1b48cdee3a3e2b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2e30bfc4fc1b4d4583e1b48cdee3a3e2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2e30bfc4fc1b4d4583e1b48cdee3a3e2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2e30bfc4fc1b4d4583e1b48cdee3a3e2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ballate"}}, {"@id": "_:n2e30bfc4fc1b4d4583e1b48cdee3a3e2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ballata; Italian dance-song, and poetic and musical form, in use from the second half of the 13th century until the 15th century and beyond... The ballata consists of the following parts: ripresa, two (rarely more) symmetrical piedi or mutazioni, volta (equal in length to the ripresa) and ripresa... Only the texts have reached us from the early history of the ballata. The music was evidently based on oral tradition. With the rise of the ballata to an art form the first monophonic ballate with music appear in a northern Italian manuscript (I-Rvat 215). Another manuscript (I-Fl 87) contains five monophonic ballate by Gherardello da Firenze, five by Lorenzo da Firenze and one monophonic piece by Niccol\u00f2 da Perugia. The first polyphonic ballate appeared in Florence in the 1360s. It is with this development that the form finally reached artistic stature and from that time... The 141 ballate of Landini (composed between c1365 and 1397) offer a good cross-section of the various types of polyphonic ballate)"}, "madsrdf:citationSource": "Grove music online, viewed June 3, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026649"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026650", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBallets (Music)", "identifiers:lccn": "gf2014026650", "madsrdf:adminMetadata": [{"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b1"}, {"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ballets (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}], "madsrdf:hasSource": {"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b5"}, "madsrdf:hasVariant": {"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical works composed for, or adapted as, ballets."}, {"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T09:58:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ballets (Music)"}}, {"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ballet; a style of theatrical dancing that developed in France during the 17th century; achieved 'classical' status in the 19th century; also describes a theatrical spectacle, in which use it has a history stretching back to the Middle Ages; since the late 18th century \"ballet\" as a genre has usually meant a spectacle accompanied by purely instrumental music; the 20th century saw a shift in emphasis away from story ballets set to newly composed scores towards more abstract works set to pre-existing music not necessarily composed for dancing)"}, "madsrdf:citationSource": "Grove music online, viewed August 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ballet (Music)"}}, {"@id": "_:n0f0a8138f3eb426c9504f7ba19a5b0b2b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ballet (Music)"}}], "@id": "/authorities/genreForms/gf2014026650"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026651", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBalletti (Part songs)", "identifiers:lccn": "gf2014026651", "madsrdf:adminMetadata": [{"@id": "_:na148b0d421bc4cb880ea2706ca90098eb1"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Balletti (Part songs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na148b0d421bc4cb880ea2706ca90098eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026984"}, "madsrdf:hasSource": [{"@id": "_:na148b0d421bc4cb880ea2706ca90098eb5"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb6"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb7"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb8"}], "madsrdf:hasVariant": [{"@id": "_:na148b0d421bc4cb880ea2706ca90098eb9"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb12"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb15"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Balletti (Part songs)"}}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2003056928: Pike, L. The evolution of the English ballett, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Balletto (ballett): 1) Italian dance popular in the 16th and 17th cents.; 2) Italian dance-song, \"invented\" by G.G. Gastoldi and deriving from the original dance and from the canzonetta (especially in its form: two repeated sections, each ending with a refrain of such nonsense syllables as \"fa-la\" or \"lirum-lirum\"; style was taken up by composers in Germany and, particularly, in England [plural form used in article: balletti])"}, "madsrdf:citationSource": "Oxf. comp. mus., 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Balletto: 1) 15th-cent. choreographed Italian dance using pantomimic gesture; 2) Vocal piece in homophonic, dance-rhythm style, with strophic texts punctuated by nonsense refrains such as \"fa-la-la\"; taken up in Germany and especially in England, where Morley produced a sophisticated genre that under Weelkes drew close to the madrigal and freedom of rhythm and contrapuntal style [plural form used in article: balletti]; 3) Instrumental dance, mainly for lute in the late 16th cent., and for guitar, keyboard, and chamber ensemble throughout the 17th cent.)"}, "madsrdf:citationSource": "New Harvard dict. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Balletto (It.; Fr. ballet; Eng. ballett): An Italian dance of the 16th and 17th centuries, occasionally called \"bal\" or \"ballo.\" There seem to be three periods of development, two instrumental and one vocal: for lute during the second half of the 16th century; for voice from 1591 to about 1623; and for chamber ensemble from about 1616 to the end of the 17th century; originated in Italy and spread to England and Germany. Both Morley and Praetorius considered the Mantuan composer G.G. Gastoldi to have invented the vocal balletto as a musical genre; Gastoldi's first set of ballettos enjoyed enormous popularity north of the Alps, spawning imitations in Germany and England, where the ballett as cultivated and transformed by Morley and Weelkes produced a small repertory of enduringly popular vocal music; although Morley knew the tradition of dancing to such songs, it is now generally assumed that neither his balletts nor those of his English successors were intended for dancing; Weelkes's balletts are transformed into vocal chamber music by eliding contrapuntal phrases and, in particular, by madrigalian devices that render both rhythms and phrasing erratic. Fa-la: A term probably introduced by Thomas Morley as a synonym for \"ballett.\" Thereafter it was used colloquially in English to refer to the fairly homophonic, syllabic dance-songs of the late 16th century and early 17th that were characterized by a refrain of nonsense syllables)"}, "madsrdf:citationSource": "Grovemusic.com WWW site, Oct. 28, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na148b0d421bc4cb880ea2706ca90098eb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ballets (Part songs)"}}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ballets (Part songs)"}}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na148b0d421bc4cb880ea2706ca90098eb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Balletts (Part songs)"}}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Balletts (Part songs)"}}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na148b0d421bc4cb880ea2706ca90098eb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fa-las (Part songs)"}}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fa-las (Part songs)"}}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na148b0d421bc4cb880ea2706ca90098eb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ballettos (Part songs)"}}, {"@id": "_:na148b0d421bc4cb880ea2706ca90098eb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ballettos (Part songs)"}}], "@id": "/authorities/genreForms/gf2014026651"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026652", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBambucos (Music)", "identifiers:lccn": "gf2014026652", "madsrdf:adminMetadata": [{"@id": "_:n4fbc86afd54b4d089d007fa421fd9ed8b1"}, {"@id": "_:n4fbc86afd54b4d089d007fa421fd9ed8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bambucos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4fbc86afd54b4d089d007fa421fd9ed8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n4fbc86afd54b4d089d007fa421fd9ed8b5"}, {"@id": "_:n4fbc86afd54b4d089d007fa421fd9ed8b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4fbc86afd54b4d089d007fa421fd9ed8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4fbc86afd54b4d089d007fa421fd9ed8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n4fbc86afd54b4d089d007fa421fd9ed8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bambucos (Music)"}}, {"@id": "_:n4fbc86afd54b4d089d007fa421fd9ed8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (bambuco)"}, "madsrdf:citationSource": "Work cat.: Jervis, C. Ten confianza en mi [SR] 196-:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fbc86afd54b4d089d007fa421fd9ed8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bambuco; the national dance of Colombia. Originally a serenading song for the solo voice, the modern bambuco is most often sung in duet or parallel thirds, with strummed accompaniment on tiple, guitar, and bandola; texts typically revolve around archetypal subjects often with a gendered chauvinistic viewpoint, including the extolling of a woman's beauty, her desirability, idyllic love, the pain of thwarted love, pride in being Colombian or coming from a particular region)"}, "madsrdf:citationSource": "Grove music online WWW site, Nov. 8, 2007", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026652"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026653", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBanda (Music)", "identifiers:lccn": "gf2014026653", "madsrdf:adminMetadata": [{"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b1"}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Banda (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b5"}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b6"}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b7"}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b8"}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Banda (Music)"}}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 622, under Mexico (Other folk-derived popular musics: By the early 1990s, \"new\" pop groups called bandas, emulating the raucous, brass-woodwind-percussion sounds of two closely related ensembles, Sinaloa-style bands (bandas sinaloenses) and Zacatecas-style bands (tamborazos zacatecanos), dominated Mexican pop)"}, "madsrdf:citationSource": "Garland encyc. of world music:", "madsrdf:citationStatus": "found"}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(banda: major genre of ragged, brassy, tinny music which blossomed in 1991; originated in the state of Sinaloa)"}, "madsrdf:citationSource": "White, D. Dict. of popular music styles of the world, c1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(usage in documents retrieved by Google search: banda music; banda)"}, "madsrdf:citationSource": "WWW, June 7, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(banda; banda music)"}, "madsrdf:citationSource": "Work cat.: 2001026897: Simonett, H. Banda, c2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n92f0860febec481fa2bd3fd39dd5df47b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Banda; Banda sinaloense; generic Spanish term for a variety of ensembles consisting of brass, woodwind, and percussion instruments found throughout Latin America; banda sinaloense gained a reputation in the international popular music market at the close of the twentieth century; the main appeal of banda was, and continues to be, its danceable rhythms ranging from the local son, guaracha, polka, waltz, and schottische to the international fox trot, Cuban danz\u00f3n, bolero, mambo, and cha-cha)"}, "madsrdf:citationSource": "Grove music online, viewed August 14, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026653"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026654", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBarbershop (Music)", "identifiers:lccn": "gf2014026654", "madsrdf:adminMetadata": [{"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b1"}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Barbershop (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": [{"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b5"}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b6"}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b7"}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b8"}], "madsrdf:hasVariant": [{"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b9"}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Barbershop (Music)"}}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (barbershop singing)"}, "madsrdf:citationSource": "Work cat.: Fitch, E.M. Thru the years with the Harmonizers, c1984:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(barbershopping)"}, "madsrdf:citationSource": "LC data base, 5/1/85", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Barbershop : barbershop singing)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Barbershop (style of unaccompanied singing that originated in the USA in the late 19th century. It is characterized by four-part harmony using chords that contain tritones...From the 1940s on, barbershop harmony was sung either by male or by female quartets and choruses, but in the later 20th century mixed-voice groups gained increasing popularity.)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, June 3, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Barbershop style music"}}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Barbershop style music"}}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Barbershop harmony"}}, {"@id": "_:ne5269b0de9f04bacb4e7a96a092d1316b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Barbershop harmony"}}], "@id": "/authorities/genreForms/gf2014026654"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026655", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBarcaroles", "identifiers:lccn": "gf2014026655", "madsrdf:adminMetadata": [{"@id": "_:n41c0347e043d4261810499297b2812d5b1"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Barcaroles"}, "madsrdf:elementList": {"@list": [{"@id": "_:n41c0347e043d4261810499297b2812d5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n41c0347e043d4261810499297b2812d5b5"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b6"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b7"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b8"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b9"}], "madsrdf:hasVariant": {"@id": "_:n41c0347e043d4261810499297b2812d5b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n41c0347e043d4261810499297b2812d5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Barcaroles"}}, {"@id": "_:n41c0347e043d4261810499297b2812d5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Barcarole [Fr. barcarolle; It. barcarola]. A song of the Venetian gondoliers, or a vocal or instrumental composition modeled on such a song. In the latter, a rhythmically repetitive accompaniment, usually in moderate 6/8 or 12/8 meter, evokes the motion of a boat in the waves. Various 18th- and 19th-century operas contain vocal barcaroles; also well-known examples for piano)"}, "madsrdf:citationSource": "The new Harvard dict. of music, 1986", "madsrdf:citationStatus": "found"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Faur\u00e9, G. 13 barcarolles [ER] 1983.", "madsrdf:citationStatus": "found"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Barcarolle; title given to pieces that imitate or suggest the songs (barcarole) sung by Venetian gondoliers as they propel their boats through the water)"}, "madsrdf:citationSource": "Grove music online, viewed August 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Casella, A. Barcarola : per pianoforte, c1917.", "madsrdf:citationStatus": "found"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(barcarole or barcarolle 1) a boat song esp. as sung by Venetian gondoliers and typically characterized by the alternation of a strong and a weak beat in 6/8 time and suggesting a rowing rhythm 2) an art song or other piece of music imitating a barcarole)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n41c0347e043d4261810499297b2812d5b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n41c0347e043d4261810499297b2812d5b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Barcarolles"}}, {"@id": "_:n41c0347e043d4261810499297b2812d5b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Barcarolles"}}], "@id": "/authorities/genreForms/gf2014026655"}
