teTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ic"}, "ri:recordStatus": "revised"}, {"@id": "_:n38c7bff911414dad9f371277ea5bc865b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transgender television programs"}}, {"@id": "_:n38c7bff911414dad9f371277ea5bc865b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 665 (queer television) p. 666 (LGBTQ television; LGBTQ representation on the small screen)"}, "madsrdf:citationSource": "GLQ, v. 17, no. 4 (2011):", "madsrdf:citationStatus": "found"}, {"@id": "_:n38c7bff911414dad9f371277ea5bc865b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Transparent: Season 1 (2014) (This comedy series based in Los Angeles follows the goings-on of the dysfunctional Pfefferman family. Season 1 kicks off with the father of the family, Morton Pfefferman (Jeffrey Tambor), opening up about identifying as a woman, and becoming Maura.)"}, "madsrdf:citationSource": "Rotten tomatoes website, June 11, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n38c7bff911414dad9f371277ea5bc865b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"'Some people have wrongheaded views of the trans community or the gay community, and this show is really about seeing them as full human beings,' Ryan Murphy told Vanity Fair at the premiere of his latest drama, Pose, in New York on Thursday night. The show doesn't debut until June 3 on FX, but it's already earned headlines for its cast and crew: five trans actors, all women of color, are series regulars, and its entire team--writers, filmmakers, cast, and crew combined--includes 140 trans and L.G.B.T.Q. people.\")"}, "madsrdf:citationSource": "Chi, P. Why Ryan Murphy's new trans drama, Pose, is so personal, via Vanity fair website, posted May 18, 2018, viewed June 11, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n38c7bff911414dad9f371277ea5bc865b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the most important LGBT television series of the last 45 years; LGBT TV series)"}, "madsrdf:citationSource": "Reader's poll: the 25 most important LGBT television series, via IndieWire website, Jun 15, 2014, viewed June 11, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n38c7bff911414dad9f371277ea5bc865b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Transparent (TV series) (Transparent is an American comedy-drama web television series; story revolves around a Los Angeles family and their lives following the discovery that the person they knew as their father Mort (Jeffrey Tambor) is a trans woman)"}, "madsrdf:citationSource": "Wikipedia, June 11, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n38c7bff911414dad9f371277ea5bc865b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LGBTQ-inclusive programming on TV"}, "madsrdf:citationSource": "Deerwater, R. Must-see LGBTQ TV, via GLAAD website, posted June 10, 2018, viewed June 11, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n38c7bff911414dad9f371277ea5bc865b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Transparent (Television program). Season 1. Transparent. Season one, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n38c7bff911414dad9f371277ea5bc865b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n38c7bff911414dad9f371277ea5bc865b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trans television programs"}}, {"@id": "_:n38c7bff911414dad9f371277ea5bc865b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trans television programs"}}], "@id": "/authorities/genreForms/gf2018026077"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026078", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTransgender drama", "identifiers:lccn": "gf2018026078", "madsrdf:adminMetadata": [{"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b1"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Transgender drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b5"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b6"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b7"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b8"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b9"}], "madsrdf:hasVariant": {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Drama featuring transgender characters or addressing transgender themes."}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transgender drama"}}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rikki Beadle-Blair's latest play, Summer in London; The first play in the UK to feature an entirely trans cast tells the comical story of four homeless men trying to impress their \"ideal woman\", and teaches some important lessons about trans theatre; an entirely trans cast, a massive achievement in itself in a climate where trans stories are rarely told on stage, on screen or in our history books)"}, "madsrdf:citationSource": "Necati, Y. Summer in London is the trans play actually being told by transgender actors, via The independent website, posted 25 July 2017, viewed June 11, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the play F2M; concerns a transgendered college student and her parents)"}, "madsrdf:citationSource": "Patricia Wettig is ready to play, via TheaterMania website, viewed June 11, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Based on a real-life case of a boy raised as a girl after a dire surgical mishap, this play is sensitively acted but could go deeper into the issues; Anna Ziegler's Boy explores the intersections of gender and medical ethics to reflect on notions of identity, on which behaviors are inherent and which are learned or deliberately performed)"}, "madsrdf:citationSource": "Boy review - transgender drama is brisk and fascinating but too tidy, via The guardian website, 10 Mar 2016, viewed June 11, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the acclaimed transgender-themed play Charm--inspired by the real-life story of Miss Gloria Allen; by playwright Philip Dawkins)"}, "madsrdf:citationSource": "MCC Theater's transgender-themed play Charm begins tonight, via Broadway world website, posted Aug. 31, 2017, viewed June 11, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LC subj. hdgs.: Transgender people--Drama; Families--Drama)"}, "madsrdf:citationSource": "Work cat.: Wettig, Patricia. F2M, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trans drama"}}, {"@id": "_:n2be463557ff14ce7af0170ce5f829ff5b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trans drama"}}], "@id": "/authorities/genreForms/gf2018026078"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026079", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTransgender films", "identifiers:lccn": "gf2018026079", "madsrdf:adminMetadata": [{"@id": "_:n7032a49239504be5b00b408462295a3cb1"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Transgender films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7032a49239504be5b00b408462295a3cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026039"}, "madsrdf:hasSource": [{"@id": "_:n7032a49239504be5b00b408462295a3cb5"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb6"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb7"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb8"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb9"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb10"}], "madsrdf:hasVariant": {"@id": "_:n7032a49239504be5b00b408462295a3cb11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films featuring transgender characters or addressing transgender themes."}, {"@id": "_:n7032a49239504be5b00b408462295a3cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "revised"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transgender films"}}, {"@id": "_:n7032a49239504be5b00b408462295a3cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(movies about transgender people; Ma vie en rose (1997), one of the most sensitive of a wave of 1990s trans movies;"}, "madsrdf:citationSource": "Jacques, J. 10 great transgender films, via BFI [British Film Institute] website, updated 6 June 2018, viewed on June 12, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Two twenty year-olds living in Kentucky, Robby and his best friend since childhood, Ricky, a gorgeous transgender girl, have never dated. Lamenting the lack of eligible bachelors, Ricky considers dating a girl. In walks Francesca, a beautiful young d\u00e9butante waiting for her Marine fiance to return from the war. Ricky and Francesca strike up a friendship, and maybe a little more, which forces Robby to face his true feelings for Ricky)"}, "madsrdf:citationSource": "Work cat.: Boy meets girl (Motion picture : 2014). Boy meets girl, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LGBT films; films ... projecting the complexities of the LGBTQ experience)"}, "madsrdf:citationSource": "The 75 greatest LGBT films of all time, via Slant website, June 21, 2016, viewed June 12, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LGBTQ films; queer films; LGBT films)"}, "madsrdf:citationSource": "The 20 best LGBTQ movies of the 21st century, via IndieWire website, Aug. 25, 2017, viewed on June 12, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(transgender films; transgender movies)"}, "madsrdf:citationSource": "Atkinson, S. 10 films that will open your eyes about transgendered people, via Highsnobiety website, posted Jan. 12, 2017, viewed on June 12, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: It's Christmas Eve and transgender sex worker Sin-Dee Rella has just gotten out of jail and discovered from her BFF Alexandra that her pimp-boyfriend Chester has been cheating on her with a cis-woman. She decides to take matters into her own hands by avenging herself on her love-rival)"}, "madsrdf:citationSource": "Work cat.: Tangerine (Motion picture : 2015). Tangerine, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n7032a49239504be5b00b408462295a3cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7032a49239504be5b00b408462295a3cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trans films"}}, {"@id": "_:n7032a49239504be5b00b408462295a3cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trans films"}}], "@id": "/authorities/genreForms/gf2018026079"}
