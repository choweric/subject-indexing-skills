{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026164", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aConsilia", "identifiers:lccn": "gf2011026164", "madsrdf:adminMetadata": [{"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b1"}, {"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Consilia"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b3"}]}, "madsrdf:exampleNote": "Note under [Responsa (Jewish law)]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026351"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}], "madsrdf:hasReciprocalAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026172"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026533"}], "madsrdf:hasSource": {"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b5"}, "madsrdf:hasVariant": {"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Expert opinions and legal briefs addressing questions of law during litigations in 14th to 18th century Europe, prepared for a judge or a party by Roman law or canon law scholars. For Jewish decisions see [Responsa (Jewish law)]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025091"}}, {"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T13:46:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Consilia"}}, {"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Consilla (This heading is used as a genre/form heading for expert opinions and legal briefs addressing questions of law during litigations in 14th to 18th century Europe, prepared for a judge or a party by Roman law or canon law scholars. Since the opinions were often given in response to a question (quaestio) by a judge or party, the titles often read: \"Consilia sive responsa\" (Opinions rather than answers). Jewish decisions (She'elot u-Teshuvot -- questions and answers) are entered under Responsa.)"}, "madsrdf:citationSource": "Genre/form terms for law materials [report prepared by the Technical Services Special Interest Section of AALL], 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Responsa"}}, {"@id": "_:nd912eaa5fb5341508d7e4d8e0220c7d3b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Responsa"}}], "@id": "/authorities/genreForms/gf2011026164"}
