d": "_:n6cee4fca9d3e47a4997398b6c03c1dd1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dance television programs"}}, {"@id": "_:n6cee4fca9d3e47a4997398b6c03c1dd1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dance)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n6cee4fca9d3e47a4997398b6c03c1dd1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dance. Nonfiction work primarily concerned with dance, dancers, and choreography, including types of dance such as ballet, jazz, modern, ballroom, tap, folk, ethnic, and vaudeville. Dance work may be biographical, ethnographic, educational, or instructional in nature)"}, "madsrdf:citationSource": "Moving image genre/form guide, via WWW, Oct. 8, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n6cee4fca9d3e47a4997398b6c03c1dd1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Originally telecast by PBS on Great performances, Dance in America)"}, "madsrdf:citationSource": "A hymn for Alvin Ailey [VR] c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n6cee4fca9d3e47a4997398b6c03c1dd1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Originally presented as an episode of Dance in America in 1976)"}, "madsrdf:citationSource": "Work cat.: Martha Graham Dance Company [VR] c1998", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026189"}
