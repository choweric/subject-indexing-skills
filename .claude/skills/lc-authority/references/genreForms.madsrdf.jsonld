{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026161", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aConcert films", "identifiers:lccn": "gf2011026161", "madsrdf:adminMetadata": [{"@id": "_:n8c87c5addcab4c019024631d9203ffb0b1"}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Concert films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8c87c5addcab4c019024631d9203ffb0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026276"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026538"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026414"}, "madsrdf:hasSource": [{"@id": "_:n8c87c5addcab4c019024631d9203ffb0b5"}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b6"}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b7"}], "madsrdf:hasVariant": [{"@id": "_:n8c87c5addcab4c019024631d9203ffb0b8"}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b11"}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films of musical concert performances recorded in front of a live audience.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025013"}}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T11:36:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Concert films"}}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Concert Film. Examples listed include: Richard Pryor: Live in Concert; Margaret Cho: Assassin; Judy Garland in Concert; B.B. King: Live in Africa; Emerson, Lake & Palmer in Concert; Concert for Kampuchea; The Police: Synchronicity Concert; Bill Cosby: Himself; An Irish Evening: Live at the Grand Opera House, Belfast)"}, "madsrdf:citationSource": "Internet movie database, Aug. 28, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "subgenre listed under Musical: Rock Concert Films (Concert Film, Rock-Concert Documentary, Rock Doc. ,They fall under the category of documentaries and are a permanent record of the actual performance or happening in which folk or rock music is played to its audience, either in the open air or in enclosed locales. See also Rock Film)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "concert film (A film that records a live musical performance before a public audience. In commercial cinema, the form has largely been relegated to such rock documentaries as Michael Wadleigh's Woodstock (1970) ... and Jonathan Demme's Stop Making Sense (1984), a purer record of a concert by the Talking Heads; rock documentary: A type of concert film that presents a performance of rock music, frequently employing filmic technique to create for the audience the experience of attending such a performance while also seeming to make some kind of social statement about the music and the culture which produces it)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dict., 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8c87c5addcab4c019024631d9203ffb0b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "In-concert films"}}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "In-concert films"}}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8c87c5addcab4c019024631d9203ffb0b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Live concert films"}}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Live concert films"}}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8c87c5addcab4c019024631d9203ffb0b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Live-in-concert films"}}, {"@id": "_:n8c87c5addcab4c019024631d9203ffb0b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Live-in-concert films"}}], "@id": "/authorities/genreForms/gf2011026161"}
