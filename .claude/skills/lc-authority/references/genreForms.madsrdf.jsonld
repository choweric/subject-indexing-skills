es"}}, {"@id": "_:n6cb4b53a2bf9481aac5ea8f36947c8fcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page [6] (collection of reproduced radio program schedules for station JODK, originally published in \"Keij\u014d Nipp\u014d,\" August 1925-December 1930) (DLC)2023515001"}, "madsrdf:citationSource": "Work cat: Keij\u014d H\u014ds\u014dkyoku (JODK) rajio puroguramu sh\u016bsei, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6cb4b53a2bf9481aac5ea8f36947c8fcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page xi (As radio entered the 1920s ... the corporate partners of RCA [Radio Corporation of America] were experimenting with radio stations that were designed to broadcast to the general public. [Radio pioneers Reginald] Fessenden and [Lee] de Forest made radio broadcasts to anyone who might have been listening but never established radio stations with regular program schedules); page 116 (Dayparting is the practice of segmenting the broadcast schedule into blocks for purposes of targeting listenership at a given time); page 167 (Format radio is the most popular and commercially successful method of building a radio station's program schedule to target a specific audience effectively)"}, "madsrdf:citationSource": "Historical dictionary of American radio, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6cb4b53a2bf9481aac5ea8f36947c8fcb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6cb4b53a2bf9481aac5ea8f36947c8fcb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio broadcast schedules"}}, {"@id": "_:n6cb4b53a2bf9481aac5ea8f36947c8fcb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio broadcast schedules"}}], "@id": "/authorities/genreForms/gf2024026052"}
