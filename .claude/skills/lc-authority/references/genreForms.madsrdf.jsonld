alue": {"@language": "en", "@value": "Church orders"}}, {"@id": "_:na52643f418f748eea1cdb074e5b5593bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "church order (a regulation or code of regulations decreed by ecclesiastical or scriptural authority; (also as a mass noun) such regulations collectively.)"}, "madsrdf:citationSource": "OED online, June 2, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:na52643f418f748eea1cdb074e5b5593bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Church orders (This heading is used for documents containing the regulations and directions for the governance of the church, the regulation of the liturgy, the discipline of members, the care of church property, etc.; UF: Kirchenordnungen)"}, "madsrdf:citationSource": "Religion genre/form terms: information gathered on behalf of the Library of Congress... American Theological Library Association, et. al, c2012:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026054"}
