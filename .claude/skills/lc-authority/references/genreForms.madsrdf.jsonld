{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026035", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIj\u0101zah", "identifiers:lccn": "gf2015026035", "madsrdf:adminMetadata": [{"@id": "_:ncefebf91440e43089fd0ca5c9f490fb8b1"}, {"@id": "_:ncefebf91440e43089fd0ca5c9f490fb8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ij\u0101zah"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncefebf91440e43089fd0ca5c9f490fb8b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026163"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026026"}], "madsrdf:hasSource": {"@id": "_:ncefebf91440e43089fd0ca5c9f490fb8b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "The license of a Muslim scholar to teach one or more works, which may include a detailed record of the scholar's intellectual lineage."}, {"@id": "_:ncefebf91440e43089fd0ca5c9f490fb8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:42:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncefebf91440e43089fd0ca5c9f490fb8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-06-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ncefebf91440e43089fd0ca5c9f490fb8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ij\u0101zah"}}, {"@id": "_:ncefebf91440e43089fd0ca5c9f490fb8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ij\u0101zah: This heading is used for works that contain a Muslim's scholar's license to teach one or more works. It may include a detailed record of the scholar's intellectual lineage (i.e., the chain of scholars through which a particular work, or school of thought has been handed down).)"}, "madsrdf:citationSource": "Religion genre/form terms: information gathered on behalf of the Library of Congress... American Theological Library Association, et. al, c2012:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026035"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026036", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKoans", "identifiers:lccn": "gf2015026036", "madsrdf:adminMetadata": [{"@id": "_:n185e45d3e8ef48af9179238d41b4c72db1"}, {"@id": "_:n185e45d3e8ef48af9179238d41b4c72db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Koans"}, "madsrdf:elementList": {"@list": [{"@id": "_:n185e45d3e8ef48af9179238d41b4c72db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026026"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026056"}, "madsrdf:hasSource": [{"@id": "_:n185e45d3e8ef48af9179238d41b4c72db5"}, {"@id": "_:n185e45d3e8ef48af9179238d41b4c72db6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Paradoxes used in Zen Buddhism as instruments of meditation to encourage sudden intuitive enlightenment rather than dependence upon reason."}, {"@id": "_:n185e45d3e8ef48af9179238d41b4c72db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:42:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n185e45d3e8ef48af9179238d41b4c72db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-06-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n185e45d3e8ef48af9179238d41b4c72db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Koans"}}, {"@id": "_:n185e45d3e8ef48af9179238d41b4c72db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(koan: a paradox used in Zen Buddhism as an instrument of meditation in training monks to despair of an ultimate dependence upon reason and to force them into sudden intuitive enlightenment)"}, "madsrdf:citationSource": "Merriam Webster online, June 2, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n185e45d3e8ef48af9179238d41b4c72db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Koans: This heading is used in Zen Buddhism for paradoxical statements intended to be meditated upon.)"}, "madsrdf:citationSource": "Religion genre/form terms: information gathered on behalf of the Library of Congress... American Theological Library Association, et. al, c2012:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026036"}
