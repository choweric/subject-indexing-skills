{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026124", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWanted posters", "identifiers:lccn": "gf2017026124", "madsrdf:adminMetadata": [{"@id": "_:ne1054537818b488da2962a455177cf24b1"}, {"@id": "_:ne1054537818b488da2962a455177cf24b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Wanted posters"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne1054537818b488da2962a455177cf24b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026152"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026133"}], "madsrdf:hasSource": [{"@id": "_:ne1054537818b488da2962a455177cf24b5"}, {"@id": "_:ne1054537818b488da2962a455177cf24b6"}, {"@id": "_:ne1054537818b488da2962a455177cf24b7"}, {"@id": "_:ne1054537818b488da2962a455177cf24b8"}, {"@id": "_:ne1054537818b488da2962a455177cf24b9"}, {"@id": "_:ne1054537818b488da2962a455177cf24b10"}], "madsrdf:hasVariant": [{"@id": "_:ne1054537818b488da2962a455177cf24b11"}, {"@id": "_:ne1054537818b488da2962a455177cf24b14"}, {"@id": "_:ne1054537818b488da2962a455177cf24b17"}, {"@id": "_:ne1054537818b488da2962a455177cf24b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Posters that describe and/or depict criminals sought by law enforcement agencies."}, {"@id": "_:ne1054537818b488da2962a455177cf24b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne1054537818b488da2962a455177cf24b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-05T13:53:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne1054537818b488da2962a455177cf24b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wanted posters"}}, {"@id": "_:ne1054537818b488da2962a455177cf24b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wanted posters. UF reward poster. SN Broadsides, posters, or fliers that describe criminals sought by law enforcement agencies. Wanted posters usually include an offer of reward for capture or information, with a pictorial representation of the person sought)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Oct. 13, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1054537818b488da2962a455177cf24b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Wanted posters. UF Reward posters. SN Broadsides or posters describing criminals sought by law enforcement agencies. Often include offers of rewards. BT Broadsides. BT Posters. RT Identification photographs)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Oct. 13, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1054537818b488da2962a455177cf24b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Wanted posters. UF Reward posters; Wanted circulars. BT Posters)"}, "madsrdf:citationSource": "LCSH, Oct. 13, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1054537818b488da2962a455177cf24b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(reproductions of wanted posters; partial contents: Execution broadsides -- Slave notices -- Pinkerton posters -- The FBI's most wanted -- America's most wanted)"}, "madsrdf:citationSource": "Work cat.: 2009013581: Hall, R. Wanted : the outlaw in American visual culture, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1054537818b488da2962a455177cf24b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 245 (wanted fliers; printed fliers listing fugitives wanted by the Bureau; the flier contains the name, a photograph, aliases, previous convictions, the crime the person is wanted for, and a caution note on how dangerous the person is)"}, "madsrdf:citationSource": "Haines, G.K. Unlocking the files of the FBI, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1054537818b488da2962a455177cf24b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wanted poster: A poster displaying details of a person or persons wanted by the police or a similar agency, usually under the heading \"Wanted\")"}, "madsrdf:citationSource": "Oxford dictionaries online, Oct. 13, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ne1054537818b488da2962a455177cf24b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne1054537818b488da2962a455177cf24b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Circulars, Wanted (Posters)"}}, {"@id": "_:ne1054537818b488da2962a455177cf24b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Circulars, Wanted (Posters)"}}, {"@id": "_:ne1054537818b488da2962a455177cf24b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne1054537818b488da2962a455177cf24b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wanted circulars (Posters)"}}, {"@id": "_:ne1054537818b488da2962a455177cf24b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wanted circulars (Posters)"}}, {"@id": "_:ne1054537818b488da2962a455177cf24b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne1054537818b488da2962a455177cf24b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wanted fliers (Posters)"}}, {"@id": "_:ne1054537818b488da2962a455177cf24b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wanted fliers (Posters)"}}, {"@id": "_:ne1054537818b488da2962a455177cf24b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne1054537818b488da2962a455177cf24b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reward posters"}}, {"@id": "_:ne1054537818b488da2962a455177cf24b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reward posters"}}], "@id": "/authorities/genreForms/gf2017026124"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026125", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDuologues", "identifiers:lccn": "gf2017026125", "madsrdf:adminMetadata": [{"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b1"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Duologues"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026285"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}], "madsrdf:hasSource": [{"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b5"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b6"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b7"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b8"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b9"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b10"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b11"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b12"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b13"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b14"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b15"}], "madsrdf:hasVariant": [{"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b16"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b19"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-05T13:53:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Duologues"}}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(duodrama: A dramatic piece for two speaking characters; duologue 1. A scene or part of a scene in which two actors converse in the presence of other actors who, by stage convention, do not overhear. 2. Part of a scene, a whole scene, or even an entire dramatic piece or performance in which only two actors participate)"}, "madsrdf:citationSource": "Bowman, W.P. Theatre language, c1961", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Duologue: Dialogue for two actors)"}, "madsrdf:citationSource": "Winslow, C. The Oberon glossary of theatrical terms, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "White, L. Lady Jemima's weekly thought : a comedy duologue, \u00a91937.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (two-man play)"}, "madsrdf:citationSource": "Martineck, J. Wise men, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "contents (Scenes for two actresses -- Scenes for two actors -- Scenes for one actress and one actor)"}, "madsrdf:citationSource": "Shakespeare, W. Shakespeare for two : a comprehensive collection of two-person scenes, \u00a92006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Methuen book of duologues for young actors, 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Duologue is a conversation between two characters. In Greek tragedy, duologues were common among the protagonist and another character. Shakespeare used it to give further information about the plot; Duodrama is a late 18th century German theatrical entertainment consisting of silent actors of whom only two spoke)"}, "madsrdf:citationSource": "Sebastian, A.J. Literary terms in drama, theatre and cinema, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(duologue or duodrama: A short presentation or scene for two speaking characters (although other non-speaking actors may be present on stage). Duologues became popular as part of triple bills in Germany in the late 18th century.)"}, "madsrdf:citationSource": "The Methuen Drama dictionary of the theatre, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(duologue: A short theatrical presentation or single scene in which only two actors deliver lines (although they may be supported by other silent performers). The form became popular in Germany during the late 18th century as part of triple bills and remains a common feature of modern drama)"}, "madsrdf:citationSource": "The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Duologue (A dialogue exchange between two characters. The epeisodia of Greek tragedy were frequently duologues between the protagonist and one other actor. Shakespeare often uses duologues to supply information, advance the action, and provide contrast with fuller 'public' sences. Chekhov's plays reveal many contrasting character relationships through duologues.) Duodrama (A short theatrical entertainment, developed in Germany in the later eighteenth century as part of a triple bill. It involved a number of silent actors and two speaking roles (as compared with monodrama, which has only one))"}, "madsrdf:citationSource": "Hodgson, T. The drama dictionary, c1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (a duologue) p. 4 of cover (a dul"}, "madsrdf:citationSource": "Work cat.: Carlin, Murray. Not now, sweet Desdemona, 1969:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Two-person plays"}}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Two-person plays"}}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Duodramas"}}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Duodramas"}}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Two-man plays"}}, {"@id": "_:n9e5b6c36729749eb805d1df5fc1d2482b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Two-man plays"}}], "@id": "/authorities/genreForms/gf2017026125"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026126", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLiterary criticism", "identifiers:lccn": "gf2017026126", "madsrdf:adminMetadata": [{"@id": "_:nd11fd0c9303f42db9496043b802f9763b1"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Literary criticism"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd11fd0c9303f42db9496043b802f9763b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026025"}, "madsrdf:hasSource": [{"@id": "_:nd11fd0c9303f42db9496043b802f9763b5"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b6"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b7"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b8"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b9"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b10"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b11"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b12"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b13"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b14"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b15"}], "madsrdf:hasVariant": [{"@id": "_:nd11fd0c9303f42db9496043b802f9763b16"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b19"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that evaluate, study, and discuss literature of any genre."}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:25:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Literary criticism"}}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Criticism. UF Evaluation of literature; Literary criticism. BT Literature; Rhetoric. RT Aesthetics)"}, "madsrdf:citationSource": "LCSH, Oct. 16, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Wyatt, Jean. Love and narrative form in Toni Morrison's later novels, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(literary criticism. UF criticism of literature; literary analysis. SN The discipline of describing, interpreting, and evaluating literary works, including the exposition of principles, methods, and theories for the analysis of such works. BT criticism; literature (discipline))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Oct. 16, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(literary criticism: The art or practice of judging and commenting on the qualities and character of literary works)"}, "madsrdf:citationSource": "Oxford dictionaries website, Oct. 16, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Literary criticism (Literary criticism, the reasoned consideration of literary works and issues. It applies, as a term, to any argumentation about literature, whether or not specific works are analyzed. More strictly construed, the term covers only what has been called \"practical criticism,\" the interpretation of meaning and the judgment of quality. Criticism in this narrow sense can be distinguished not only from aesthetics (the philosophy of artistic value) but also from other matters that may concern the student of literature: biographical questions, bibliography, historical knowledge, sources and influences, and problems of method; Criticism will here be taken to cover all phases of literary understanding, though the emphasis will be on the evaluation of literary works and of their authors' places in literary history. For another particular aspect of literary criticism, see textual criticism)"}, "madsrdf:citationSource": "Britannica online, Oct. 16, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(criticism. The reasoned discussion of literary works, an activity which may include some or all of the following procedures, in varying proportions: the defence of literature against moralists and censors, classification of a work according to its genre, interpretation of its meaning, analysis of its structure and style, judgement of its worth by comparison with other works, estimation of its likely effect on readers, and the establishment of general principles by which literary works (individually, in categories, or as a whole) can be evaluated and understood. Contrary to the everyday sense of criticism as \"fault-finding\", much modern criticism (particularly of the academic kind) assumes that the works it discusses are valuable; the functions of judgement and analysis having to some extent become divided between the market (where reviewers ask \"Is this worth buying?\") and the educational world (where academics ask \"Why is this so good?\"))"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2015, via Oxford reference online, Oct. 16, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Literary criticism is the evaluation, analysis, description, or interpretation of literary works. It is usually in the form of a critical essay, but in-depth book reviews can sometimes be considered literary criticism. Criticism may examine a particular literary work, or may look at an author's writings as a whole)"}, "madsrdf:citationSource": "ipl2 website (hosted by iSchool at Drexel University), Oct. 16, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(literary criticism: the formal study and discussion of works of literature, for example by judging and explaining their importance and meaning)"}, "madsrdf:citationSource": "Cambridge dictionary online, Oct. 16, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Alice Munro's miraculous art : critical essays, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(literary criticism: the evaluation, study and discussion of literature)"}, "madsrdf:citationSource": "Collins English dictionary online, Oct. 16, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Subject guides > Literary criticism (Literary criticism is the term given to studies that define, classify, analyze, interpret, and evaluate works of literature. There are many types of literary criticism: some examples include historical criticism, textual criticism, feminist criticism, and formalist criticism. Literary criticism may examine a particular literary work or it may look at an author's writings as a whole)"}, "madsrdf:citationSource": "Mississippi State University Libraries Research guides website, Oct. 16, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd11fd0c9303f42db9496043b802f9763b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Criticism, Literary"}}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Criticism, Literary"}}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd11fd0c9303f42db9496043b802f9763b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Literary analysis"}}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Literary analysis"}}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd11fd0c9303f42db9496043b802f9763b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Analysis, Literary"}}, {"@id": "_:nd11fd0c9303f42db9496043b802f9763b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Analysis, Literary"}}], "@id": "/authorities/genreForms/gf2017026126"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026128", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRicercars", "identifiers:lccn": "gf2017026128", "madsrdf:adminMetadata": [{"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb1"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ricercars"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb5"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb6"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb7"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb8"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb9"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb10"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb11"}], "madsrdf:hasVariant": [{"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb12"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-05T13:53:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ricercars"}}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ricercar: A type of instrumental piece common during the 16th and 17th centuries. The earliest were improvisatory in style, often for solo instruments such as the bass viol or lute (e.g. those in Francesco Spinacino's Intabulatura de lauto, 1607). They consisted of highly embellished, unaccompanied melody, often containing many scalar passages, and were not very different from the early 16th-century Prelude. They usually lack a distinct shape and are seemingly designed as an exercise for the fingers (see also Tiento; Toccata); From about 1610, motet-like instrumental pieces are more often called 'sonata' (e.g. Giovanni Gabrieli's Sonata pian e forte) and the term 'ricercar' tends to be associated with works that display some form of contrapuntal learnedness. In this sense, the word persisted until the end of the Baroque period, the most notable examples being in Bach's Musical Offering (1747). There, as was almost traditional by this time, the two 'ricercari' are placed among a set of canons and are fugal in style, written in old-fashioned note-values and conceived as a display of compositional skill. It is difficult by this stage to say how, if at all, these differ from fugues)"}, "madsrdf:citationSource": "The Oxford companion to music, via Oxford music online, Oct. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ricercare noun plural -cari or -cars (in music of the 16th and 17th centuries): 1. an elaborate polyphonic composition making extensive use of contrapuntal imitation and usually very slow in tempo. 2. an instructive composition to illustrate instrumental technique; \u00e9tude)"}, "madsrdf:citationSource": "Collins English dictionary online, Oct. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ricercare (plural ricercares): Alternative spelling of ricercar; ricercar (plural ricercars): An instrumental musical composition, fugal in style but in a more serious character and with longer notes)"}, "madsrdf:citationSource": "Wiktionary, Oct. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Piston, W. Ricercare for orchestra, 1968.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ricercare [ricercar, recercar(e), recerchar(e), ricercata]. In its widest sense, a piece of an esoteric nature; a technical exercise either of a practical nature or illustrative of some device of composition; Originally the term \"ricercare\" was used for a piece of preludial character for lute or keyboard instrument (as in the expression \"ricercare le corde\", \"to try out the strings\"), giving it a meaning comparable to that of \"tastar\", \"ta\u00f1er\", \"tiento\" etc. (see Toccata and Tiento). The commonest type subsequently was the imitative ricercare, similar in scope to the fantasia and fugue. Some uses appear to combine two different meanings of the word, as, for example, imitative ricercares designed as exercises in vocalization, or elaborate and technically difficult compositions for viol illustrating the technique of setting a cantus firmus; The precise origin of the imitative ricercare is disputed. Many scholars have assumed that it was the instrumental counterpart to the motet and derived directly from it; The few modern composers who have used the term have generally implied by it a severe fugue with archaic mannerisms)"}, "madsrdf:citationSource": "Grove music online, Oct. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ricercare, (Italian: \"to seek out\") plural ricercari, also spelled ricercar, musical composition for instruments in which one or more themes are developed through melodic imitation; it was prominent in the 16th and 17th centuries. The earliest ricercari, which were for the lute, appeared in late 15th-century manuscripts and in a publication dated 1507. Other instrumental forms of the period, the canzona and fantasia, closely resembled the ricercare, particularly in the use of melodic imitation, and the names were often interchanged)"}, "madsrdf:citationSource": "Britannica online, Oct. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ricercar or ricercare plural ricercars or ricercari: any of various usually keyboard musical forms especially of the 16th and 17th centuries in either quasi-improvisatory toccata style or strict polyphonic fugal style)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Oct. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ricercari"}}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ricercari"}}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ricercares"}}, {"@id": "_:n6d14368d3b214f6b8f7abdf07044826fb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ricercares"}}], "@id": "/authorities/genreForms/gf2017026128"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026130", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGraphic novel adaptations", "identifiers:lccn": "gf2017026130", "madsrdf:adminMetadata": [{"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb1"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Graphic novel adaptations"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026362"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026005"}], "madsrdf:hasSource": [{"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb5"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb6"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb7"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb8"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb9"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb10"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb11"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb12"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb13"}], "madsrdf:hasVariant": [{"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb14"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb17"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb20"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-05T13:53:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic novel adaptations"}}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 251 (Graphic novelization)"}, "madsrdf:citationSource": "The encyclopedia of fantasy, 1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "RDA Appendix J.2.2 (graphic novelization of (work): A work that has been adapted as a graphic novel; adapted as graphic novel (work): A graphic novel based on the source work)"}, "madsrdf:citationSource": "RDA toolkit, accessed Oct. 20, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 110 (graphic novelization of Shakespeare)"}, "madsrdf:citationSource": "Shakespeare studies, v. 38 (2010):", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 189 (graphic novelisation)"}, "madsrdf:citationSource": "Barton, S. Visual devices in contemporary prose fiction, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"graphic novelizations,\" 72,500 hits; \"graphic novelisations,\" 19,900 hits; \"graphic novel adaptations,\" 209,000 hits)"}, "madsrdf:citationSource": "Google, Dec. 14, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Borup, W.E. Representations of gender in graphic novel adaptations, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novelization of Octavia E. Butler's Kindred)"}, "madsrdf:citationSource": "Work cat.: Duffy, Damian. Kindred : a graphic novel adaptation, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Drawn from the classics : essays on graphic adaptations of literary works, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hinds, Gareth. Poe : stories and poems : a graphic novel adaptation, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graphic novelisations"}}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic novelisations"}}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graphic novelizations"}}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic novelizations"}}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novelisations, Graphic"}}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novelisations, Graphic"}}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novelizations, Graphic"}}, {"@id": "_:nd3a3c253c0ac4cd09d73d24672a983adb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novelizations, Graphic"}}], "@id": "/authorities/genreForms/gf2017026130"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026131", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFunny animal comics", "identifiers:lccn": "gf2017026131", "madsrdf:adminMetadata": [{"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb1"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Funny animal comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb3"}]}, "madsrdf:exampleNote": "Note under [Animal comics.]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb5"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb6"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb7"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb8"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb9"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb10"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb11"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb12"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb13"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb14"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb15"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb16"}], "madsrdf:hasVariant": [{"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb17"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that feature anthropomorphic animals. For comics that feature stories about animals see [Animal comics.]"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-22T15:58:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Funny animal comics"}}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, t.p. verso (all stories written and drawn by Carl Barks) introd. (Scrooge McDuck)"}, "madsrdf:citationSource": "Work cat.: Barks, C. Carl Barks' greatest DuckTales stories, \u00a92006- :", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Funny Animal Comics. Above all other genres, funny animal comics have represented comics' role as lightweight children's entertainment; the funny animals genre; typically features characters who combine animal faces with upright bodies that include hands, dressed (at least partially) in clothes, who converse with each other using language rather than animal sounds. These characters think and act more like people than like animals. They exist either in a world that is entirely or mostly inhabited by funny animal characters or in which the animal characters are accepted as people by human characters. The art typically features a rounded, simplified, and exaggerated style rather than a detailed or realistic style; Carl Barks, by universal acclaim, was the most important cartoonist in the funny animal comic book genre; in 1942 he was assigned to draw the first Donald Duck comic book that consisted of original material; continued to write and draw duck stories for the next two decades; perhaps the greatest funny animal comic, Walt Kelly's \"Pogo\")"}, "madsrdf:citationSource": "Encyclopedia of comic books and graphic novels, c2010, via Google books, viewed Oct. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 181 ([Robert] Crumb was influenced by the \"funny animal\" comic books that he and his brother Charles read during their childhood, such as Little Lulu by John Stanley; Donald Duck by Carl Barks; and Pogo by Walt Kelly) p. 481 (Scrooge McDuck, the protagonist, is the heir of Castle McDuck in Scotland. Like all characters in the story, he is a humanized animal; [Don] Rosa's primary page layout is the eight-panel grid used in most funny-animal comics during the 1950's and 1960's) p. 583 (Omaha the Cat Dancer's history begins in 1978, as comics creator Reed Waller's contribution to Vootie, a self-published one-shot magazine created by a cooperative of \"funny animal\" cartoonists) p. 813 (At the time of Tantrum's original publication, comics were mainly superhero stories, romance stories, funny animal stories, and adaptations of popular films)"}, "madsrdf:citationSource": "Critical survey of graphic novels, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 500 (Funny Animals. Humorous stories in which the protagonist or supporting characters are animals. The animals may appear to be normal-looking, typically with the ability to speak, or may be anthropomorphized, with human qualities as well as the ability to speak. Examples: The Collected Sam & Max; Comic Adventures of Boots; The Frank Book; Gon; Howard the Duck; Owly; Peanutbutter and Jeremy's Best Book Ever!; Salmon Doubts; Sky Ape)"}, "madsrdf:citationSource": "Pawuk, M. Graphic novels : a genre guide to comic books, manga, and more, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (\"by '78 I was doing fanzines and laying the foundation for what would become Albedo Anthropomorphics. Albedo Anthropomorphics started as a funny animal comic anthology comic, with my Erma Felna, EDF as a science-fiction series within. ... Birthright was conceived as a distant sequel to the Erma Felna story line for Fantagraphics Books Critters funny animal anthology comic\")"}, "madsrdf:citationSource": "Steve Gallacci website, Oct. 20, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Glossary (Funny Animal: A genre of fiction which, like superheroes, is found more often in comics and animation than elsewhere, and which is characterized by animals that walk and talk just like humans. Many aficionados of the genre insist that a funny animal no more has to be \"funny\" than a comic book must be \"comic\", citing Bucky O'Hare and Teenage Mutant Ninja Turtles, but others disagree. Many of the best funny animals, such as Uncle Scrooge, combine humor with adventure in about equal measure; but some, like Usagi Yojimbo, while not totally eschewing humor, place more emphasis on the dramatic aspects of their stories. And then, of course, there are Pogo, Bugs Bunny and suchlike, that are almost all humor)"}, "madsrdf:citationSource": "Markstein, D.D. Don Markstein's Toonopedia, via WWW, viewed Oct. 20, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Funny animal (A funny animal is an anthropomorphic animal character who lives like a human. Funny animals typically are bipedal, wear clothes, live in houses, drive vehicles, and have jobs, which distinguish them from other animal characters who may nonetheless display anthropomorphic characteristics such as speaking or showing facial expressions. Funny animal (also talking animal) is also the genre of comics and animated cartoons which primarily feature funny animals; the genre is not exclusively comedic. Dark or serious stories featuring characters of this sort can also be grouped under the \"funny animals\" category)"}, "madsrdf:citationSource": "Wikipedia, Oct. 20, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Barks, C. Walt Disney's Donald Duck adventures, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 187 (Funny animal comic: A comic that uses anthropomorphic animals, such as Maus, Mouse Guard or Pride of Baghdad, but not necessarily in a humorous manner)"}, "madsrdf:citationSource": "Fletcher-Spear, K. Library collections for teens : manga and graphic novels, \u00a92011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Albedo Anthropomorphics (Albedo Anthropomorphics, or Albedo for short, was a furry comic book anthology series which was credited with starting the furry comic book subgenre that featured sophisticated stories with funny animals primarily intended for an adult audience. Albedo was started by Steve Gallacci, who produced its main feature, Erma Felna: EDF--a sophisticated science fiction military series set in a sector of space populated by sapient and predominantly humanoid versions of mammal and avian species)"}, "madsrdf:citationSource": "Wikipedia, Oct. 20, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xiv (superhero comic books in general, and especially those with the more serious superheroes, like Superman and Batman, have always seemed to me hopelessly inferior to the best comics with \"funny animals\" like Donald Duck) p. 10 (the very best Dell comics belong to genres of other kinds: the comic books with animated characters--\"funny animals,\" talking animals like Donald Duck--and precocious child characters like Little Lulu) p. 85 (two popular genres: talking animals and superheroes) p. 88 (Like superheroes, \"funny animals\" could be generated with apparent ease in almost infinite variety; although the earliest of Dell's comic books with talking animals typically were drawn with six panels to the page, by early in 1944 the standard page had become eight panels, four rows of two panels each)"}, "madsrdf:citationSource": "Barrier, J.M. Funnybooks : the improbable glories of the best American comic books, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb16", "@type": "madsrdf:Source", "madsrdf:citationSource": "Albedo anthropomorphics, 1983-", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Animal comics, Funny"}}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Animal comics, Funny"}}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Animal comics (Funny animal comics)"}}, {"@id": "_:n9eb05b002a8a4b4781d3a40539cb7cccb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Animal comics (Funny animal comics)"}}], "@id": "/authorities/genreForms/gf2017026131"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026133", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFliers (Ephemera)", "identifiers:lccn": "gf2017026133", "madsrdf:adminMetadata": [{"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b1"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fliers (Ephemera)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026124"}, "madsrdf:hasSource": [{"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b5"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b6"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b7"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b8"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b9"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b10"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b11"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b12"}], "madsrdf:hasVariant": [{"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b13"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-05T13:53:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fliers (Ephemera)"}}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(flier: An inexpensive, widely distributed handbill or circular of small size (usually 8 1/2 x 11 inches), used flat or folded for advertising and announcements. Also spelled flyer. Synonymous in the UK with leaflet. See also: ephemera; leaflet: A publication of two to four pages, unstitched and unbound, usually folded or stapled together, as in the program notes distributed to attendees at a performance. Also refers to a thin pamphlet of comparatively small size)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS: online dictionary for library and information science, Oct. 23, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(flier also flyer: a piece of paper containing an advertisement or information, usually given out to people walking by; leaflet: a piece of paper, or several pieces of paper folded together, that gives information or advertises something)"}, "madsrdf:citationSource": "Cambridge dictionary online, Oct. 23, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fliers (Printed matter). SN Inexpensively produced single sheet announcements or advertisements for distribution among the general public. UF Fliers; Flyers (Printed matter). BT Ephemera)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Oct. 23, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Genre terms: a thesaurus for use in rare book and special collections cataloging, via RBMS controlled vocabularies website, Oct. 23, 2017", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(flier (also flyer) 2. A small handbill advertising an event or product; leaflet 1. A printed sheet of paper containing information or advertising and usually distributed free)"}, "madsrdf:citationSource": "Oxford dictionaries website, Oct. 23, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(consists of photocopies of a newspaper clipping from the Seattle Daily Times (June 21, 1925) and a flyer for the 1925 Benefit Dance Recital organized by the Vocational Scholarship Committee of the National Council of Jewish Women. The newspaper item describes her as \"Ida Levin,\" while she is billed on the flyer as \"Ida Levine\")"}, "madsrdf:citationSource": "Work cat.: Portnoff, M. Marguerite Portnoff collection of Ida Levin ephemera, 1925", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fliers (printed matter). SN Printed pieces such as notices or advertisements intended for distribution by hand or by mail. For those intended for posting, use \"posters.\" UF flyers (printed matter). BT information artifacts)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Oct. 23, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(flier or less commonly flyer 3. usually spelled flyer : an advertising circular; leaflet 3. a usually folded printed sheet intended for free distribution)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Oct. 23, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Leaflets (Fliers)"}}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Leaflets (Fliers)"}}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Flyers (Ephemera)"}}, {"@id": "_:nd2516fcb4e93430c829a757ad016a7d5b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flyers (Ephemera)"}}], "@id": "/authorities/genreForms/gf2017026133"}
