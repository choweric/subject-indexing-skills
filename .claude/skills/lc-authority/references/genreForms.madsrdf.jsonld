loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n1e1c5f99b2ab4b6690c7279487598c30b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio airchecks"}}, {"@id": "_:n1e1c5f99b2ab4b6690c7279487598c30b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In the radio industry, an aircheck is generally a demonstration recording, often intended to show off the talent of an announcer or radio programmer to a prospective future employer. A scoped (telescoped) aircheck usually contains only segments where the announcer is actually talking. In an unscoped aircheck, all programming is left intact and unedited, including music, commercials, newscasts, jingles and other on-air events)"}, "madsrdf:citationSource": "Wikipedia, via WWW, Nov. 29, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e1c5f99b2ab4b6690c7279487598c30b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1e1c5f99b2ab4b6690c7279487598c30b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Airchecks, Radio"}}, {"@id": "_:n1e1c5f99b2ab4b6690c7279487598c30b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Airchecks, Radio"}}, {"@id": "_:n1e1c5f99b2ab4b6690c7279487598c30b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1e1c5f99b2ab4b6690c7279487598c30b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio air checks"}}, {"@id": "_:n1e1c5f99b2ab4b6690c7279487598c30b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio air checks"}}, {"@id": "_:n1e1c5f99b2ab4b6690c7279487598c30b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1e1c5f99b2ab4b6690c7279487598c30b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Air checks, Radio"}}, {"@id": "_:n1e1c5f99b2ab4b6690c7279487598c30b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Air checks, Radio"}}], "@id": "/authorities/genreForms/gf2011026485"}
