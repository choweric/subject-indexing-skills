{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026446", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPixilated animation films", "identifiers:lccn": "gf2011026446", "madsrdf:adminMetadata": [{"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b1"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pixilated animation films"}, "madsrdf:elementList": {"@list": [{"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026049"}, "madsrdf:hasSource": [{"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b5"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b6"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b7"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b8"}], "madsrdf:hasVariant": [{"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b9"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b12"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025572"}}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:03:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pixilated animation films"}}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pixilated, var.: pixillated)"}, "madsrdf:citationSource": "American heritage dictionary, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 75 (Pixillated animation: use for animation of the movements of live actors who either move from point to point and pause en route to be photographed a frame at a time, or are photographed in continuous, varying camera speeds. The resulting footage is modified by skip-frame and stop-frame techniques, optical printing, etc.)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pixillation animation: type of animation which generally uses humans or other live subjects filmed incrementally in various fixed poses, creating an unnatural or surreal effect when played back at normal speed)"}, "madsrdf:citationSource": "Moving image genre-form guide online, April 14, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pixilated: 278,000 hits; pixillated: 13,900 hits)"}, "madsrdf:citationSource": "Google, June 4, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pixillated animation films"}}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pixillated animation films"}}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pixillation animation films"}}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pixillation animation films"}}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pixilation animation films"}}, {"@id": "_:na72762cafffa4ceca27f9ca57cd526a7b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pixilation animation films"}}], "@id": "/authorities/genreForms/gf2011026446"}
