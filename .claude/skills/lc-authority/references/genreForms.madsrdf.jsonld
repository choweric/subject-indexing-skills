}, {"@id": "_:n0ea6000a89c44a639ce11eb73525469eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n0ea6000a89c44a639ce11eb73525469eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio anthologies"}}, {"@id": "_:n0ea6000a89c44a639ce11eb73525469eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anthology: A collection of literary works; also applied to radio or TV programs, movies, comic books and other such media featuring a variety of different stories; examples of radio anthologies are Suspense and Escape)"}, "madsrdf:citationSource": "Wikipedia, Nov. 20, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea6000a89c44a639ce11eb73525469eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anthologies: Previously existing or newly created discrete works intentionally gathered together into a single program or entity. Examples: Modern romances; My secret story; Stroke of fate)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Nov. 20, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea6000a89c44a639ce11eb73525469eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Audio collections: spoken arts: spoken word (Radio anthologies; excerpts of Garrison Keillor's Lake Wobegon stories from Prairie home companion may be heard on A prairie home companion 25th anniversary collection)"}, "madsrdf:citationSource": "Multimedia seeds, viewed Nov. 21, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea6000a89c44a639ce11eb73525469eb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ea6000a89c44a639ce11eb73525469eb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anthologies, Radio"}}, {"@id": "_:n0ea6000a89c44a639ce11eb73525469eb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anthologies, Radio"}}, {"@id": "_:n0ea6000a89c44a639ce11eb73525469eb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ea6000a89c44a639ce11eb73525469eb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anthology radio programs"}}, {"@id": "_:n0ea6000a89c44a639ce11eb73525469eb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anthology radio programs"}}], "@id": "/authorities/genreForms/gf2011026487"}
