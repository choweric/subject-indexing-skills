zations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0c89e28517a6486d9be334fb59dae7a8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scores"}}, {"@id": "_:n0c89e28517a6486d9be334fb59dae7a8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Graphical, symbolic, or word-based musical notation representing the sounds of all the parts of an ensemble or a work for solo performer or electronic media. )"}, "madsrdf:citationSource": "RDA toolkit, viewed August 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c89e28517a6486d9be334fb59dae7a8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The notation of a work, especially one for ensemble, presented in such a way that simultaneous moments in all voices or parts are aligned vertically.)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027077"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027078", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSea shanties", "identifiers:lccn": "gf2014027078", "madsrdf:adminMetadata": [{"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b1"}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sea shanties"}, "madsrdf:elementList": {"@list": [{"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027171"}, "madsrdf:hasSource": {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b5"}, "madsrdf:hasVariant": [{"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b6"}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b9"}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b12"}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b15"}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b18"}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b21"}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Sailors' work songs."}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:58:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sea shanties"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Shanty. A sailors' work song. The basic form of the shanty is a call-and-response pattern, both universal and ancient. The shanty as we know it belongs to a short and very specific period: from about 1830, when competitive packet-ship transport was initiated in America, to about 1870, when British domination of clipper-ship transport was supplanted by steam. This competitive environment required coordination of manpower in heaving and hauling. A soloist, the 'shantyman', would improvise verses, and the working team would punctuate with invariable refrains, containing one or two accents at which combined forces would pull together. The musical form and melodic characteristics suggest the Anglo-Celtic and African influences of the multinational workforce that sang the shanty. Different tasks required different tunes: short-haul jobs tended to use single-line tunes; General Taylor is more elaborate with longer verses and two pulls in the refrain, suiting the long-haul jobs; a more lyrical form, as in Rio Grand, could be used for the continuous, rather than intermittent, effort required at the capstan.)"}, "madsrdf:citationSource": "Oxford Music online, viewed June 11, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shanties"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shanties"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sailor songs"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sailor songs"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chanteys"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chanteys"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sea chanteys"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sea chanteys"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chanties"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chanties"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chantys"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chantys"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sea chanties"}}, {"@id": "_:n714a983c8bfd40c88ec87d0a4c656313b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sea chanties"}}], "@id": "/authorities/genreForms/gf2014027078"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027079", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSean-n\u00f3s", "identifiers:lccn": "gf2014027079", "madsrdf:adminMetadata": [{"@id": "_:n92784abe16bc40238987aa0581426aceb1"}, {"@id": "_:n92784abe16bc40238987aa0581426aceb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sean-n\u00f3s"}, "madsrdf:elementList": {"@list": [{"@id": "_:n92784abe16bc40238987aa0581426aceb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, "madsrdf:hasSource": {"@id": "_:n92784abe16bc40238987aa0581426aceb5"}, "madsrdf:hasVariant": {"@id": "_:n92784abe16bc40238987aa0581426aceb6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n92784abe16bc40238987aa0581426aceb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n92784abe16bc40238987aa0581426aceb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n92784abe16bc40238987aa0581426aceb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sean-n\u00f3s"}}, {"@id": "_:n92784abe16bc40238987aa0581426aceb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sean-n\u00f3s. A term generally used to refer to various styles and repertories of singing believed to be the oldest in Ireland. Sean-n\u00f3s performance is usually associated with small, intimate spaces rather than large venues, with understatement rather than dramatic declamation, and with intricate vocal ornamentation.)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n92784abe16bc40238987aa0581426aceb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n92784abe16bc40238987aa0581426aceb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Old-style (Music)"}}, {"@id": "_:n92784abe16bc40238987aa0581426aceb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Old-style (Music)"}}], "@id": "/authorities/genreForms/gf2014027079"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027080", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSeguidillas (Music)", "identifiers:lccn": "gf2014027080", "madsrdf:adminMetadata": [{"@id": "_:n5673a380bba64cdeb2e9920a63891647b1"}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Seguidillas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5673a380bba64cdeb2e9920a63891647b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026806"}, "madsrdf:hasSource": [{"@id": "_:n5673a380bba64cdeb2e9920a63891647b5"}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b6"}], "madsrdf:hasVariant": [{"@id": "_:n5673a380bba64cdeb2e9920a63891647b7"}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b10"}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-29T15:18:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Seguidillas (Music)"}}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "seguidilla (siguidilla) (a Spanish dance and song; literary antecedents detected as far back as the 15th century or possibly earlier, but seems not to have existed as a piece of music until the 1590s. Under Spain/Traditional and popular music/Dance and instrumental music: sevillanas, regional variant of dance-song seguidillas)"}, "madsrdf:citationSource": "New Grove dict. of mus. online, Mar. 28, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "seguidilla (1. Spanish verse form; 2. a couple dance, widely distributed in Spain, done to the singing of a text of the type described under (1) and accompanied by the guitar; 3. (siguiriya, seguidilla gitana) one of the principal types of flamenco music, also termed playera)"}, "madsrdf:citationSource": "New Harvard dict. of mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5673a380bba64cdeb2e9920a63891647b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Playeras (Music)"}}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Playeras (Music)"}}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5673a380bba64cdeb2e9920a63891647b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Siguidillas (Music)"}}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Siguidillas (Music)"}}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5673a380bba64cdeb2e9920a63891647b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Siguiriyas (Music)"}}, {"@id": "_:n5673a380bba64cdeb2e9920a63891647b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Siguiriyas (Music)"}}], "@id": "/authorities/genreForms/gf2014027080"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027081", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSepolcri", "identifiers:lccn": "gf2014027081", "madsrdf:adminMetadata": [{"@id": "_:n31af3133eb8b4205a1c0b2257128ea84b1"}, {"@id": "_:n31af3133eb8b4205a1c0b2257128ea84b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sepolcri"}, "madsrdf:elementList": {"@list": [{"@id": "_:n31af3133eb8b4205a1c0b2257128ea84b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026861"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026977"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027038"}], "madsrdf:hasSource": [{"@id": "_:n31af3133eb8b4205a1c0b2257128ea84b5"}, {"@id": "_:n31af3133eb8b4205a1c0b2257128ea84b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n31af3133eb8b4205a1c0b2257128ea84b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n31af3133eb8b4205a1c0b2257128ea84b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n31af3133eb8b4205a1c0b2257128ea84b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sepolcri"}}, {"@id": "_:n31af3133eb8b4205a1c0b2257128ea84b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 99391966: Schmelzer, J.H. St\u00e4rcke der Lieb, c1998: t.p. (sepolcro) introd. (also, rappresentazione sacra; plural: sepolcri; type of oratorio with staging initially performed at churches of the Imperial court in Vienna in the 17th century on Maundy Thursday or Good Friday; evolved from the late medieval custom of the Planctus Mariae, the Virgin Mary's lamentations at the Sepulchre of Christ)", "madsrdf:citationStatus": "found"}, {"@id": "_:n31af3133eb8b4205a1c0b2257128ea84b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove (sepolcro; sepolcri)", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027081"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027082", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSequences (Music)", "identifiers:lccn": "gf2014027082", "madsrdf:adminMetadata": [{"@id": "_:nc176bdcb627941b694104a829e70afb5b1"}, {"@id": "_:nc176bdcb627941b694104a829e70afb5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sequences (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc176bdcb627941b694104a829e70afb5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026843"}, "madsrdf:hasSource": {"@id": "_:nc176bdcb627941b694104a829e70afb5b5"}, "madsrdf:hasVariant": {"@id": "_:nc176bdcb627941b694104a829e70afb5b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc176bdcb627941b694104a829e70afb5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc176bdcb627941b694104a829e70afb5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc176bdcb627941b694104a829e70afb5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sequences (Music)"}}, {"@id": "_:nc176bdcb627941b694104a829e70afb5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sequence (i); A category of medieval Latin chant (also called Prosa or 'prose') which flourished from about 850 to 1150. Throughout that period both its musical and literary importance were great; and from about 850 to 1000, when the large repertories were firmly established, the sequence represented one of the most important kinds of music produced in the West-- important because of its intrinsic musical values as well as its historical significance for the development of style in general... Since the sequence itself underwent profound structural modifications in its development, it is not possible to give a simple definition of its form that holds for the entire period; with that reservation, the sequence can be described as a piece of sacred chant of ample dimensions, in length as well as melodic range, set syllabically with a Latin text. The text consisted mostly of a series of couplets each having two isosyllabic lines sung to the same melody; each couplet was different from the preceding couplet in melody and usually in length. In earlier sequences the text was not governed by regular accent patterns or by end-rhyme, hence was indeed 'prose'. After 1000 the texts scanned and rhymed to an increasing degree, finally becoming verse...The texts were often associated with a particular season, feast or saint's day, hence were 'proper' in the liturgical sense. Certainly by the end of the 10th century - and probably by the end of the 9th - they came to be sung at Mass, immediately after the alleluia, as a medieval addition to the Proper of the Mass. In this and in other ways the sequence is related to the alleluia, but the relationship is neither clear nor simple, and has been the subject of controversy.)"}, "madsrdf:citationSource": "Grove music online, viewed May 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc176bdcb627941b694104a829e70afb5b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc176bdcb627941b694104a829e70afb5b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prosae (Music)"}}, {"@id": "_:nc176bdcb627941b694104a829e70afb5b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prosae (Music)"}}], "@id": "/authorities/genreForms/gf2014027082"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027083", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSequentiaries (Service books)", "identifiers:lccn": "gf2014027083", "madsrdf:adminMetadata": [{"@id": "_:n2ec1a6d705ea4049b70889f99e4095efb1"}, {"@id": "_:n2ec1a6d705ea4049b70889f99e4095efb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sequentiaries (Service books)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2ec1a6d705ea4049b70889f99e4095efb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027085"}, "madsrdf:hasSource": [{"@id": "_:n2ec1a6d705ea4049b70889f99e4095efb5"}, {"@id": "_:n2ec1a6d705ea4049b70889f99e4095efb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2ec1a6d705ea4049b70889f99e4095efb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2ec1a6d705ea4049b70889f99e4095efb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2ec1a6d705ea4049b70889f99e4095efb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sequentiaries (Service books)"}}, {"@id": "_:n2ec1a6d705ea4049b70889f99e4095efb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 17, p. 156 (Sequentiary)"}, "madsrdf:citationSource": "New Grove dict. of music and musicians, 1980:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2ec1a6d705ea4049b70889f99e4095efb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sequentiary)"}, "madsrdf:citationSource": "Work cat.: Biblioth\u00e8que municipale de Douai. Manuscript. 124 [Sequentiary and kyriale from Anchin, 15th-16th centuries]", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027083"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027084", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSerenatas", "identifiers:lccn": "gf2014027084", "madsrdf:adminMetadata": [{"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb1"}, {"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Serenatas"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasSource": [{"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb5"}, {"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb6"}, {"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb7"}, {"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serenatas"}}, {"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Scarlatti, A. Venere, Amore e Ragione, c2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Serenata: In the Baroque period, a cantata composed to celebrate a special occasion such as the name-day of a prince of the arrival of an important visitor. Serenatas were often performed in the evening and outdoors, hence the name. They were usually longer and more elaborate than solo cantatas, with several characters and a plot or theme of pastoral, mythological, or allegorical content. Serenatas commonly featured impressive costumes and scenery but little or no stage action. Important composers of serenatas include Alessandro Stradella and Alessandro Scarlatti in Italy and Johann Joseph Fux and Antonio Caldara in Vienna.)"}, "madsrdf:citationSource": "Harvard dict. of music, 4th ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Grove music online (Serenata: A dramatic cantata, normally celebratory or eulogistic, for two or more singers with orchestra. The serenata shares important features with the chamber cantata, oratorio and opera. It has been seen variously as a species of overblown cantata and a miniature opera, but in reality, the serenata is a distinct genre. The serenata shares important features with the chamber cantata, oratorio, and opera. Like the cantata, it was usually a courtly entertainment given privately before an invited audience; however, learned societies and colleges also promoted serenatas. They vary greatly in length.)"}, "madsrdf:citationSource": "Oxford music online, Oct. 3, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc225bd39f42e4df0a90fa3e935d925ceb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Oxford companion to music (Serenata: A large-scale, cantata-like work for performance at court or at the home of an aristocratic family on a special occasion. A typical serenata had a pastoral, allegorical, or mythological subject, which involved at least two characters. In length somewhere between a cantata and an opera, it was often divided into sections, each consisting of recitatives and arias, and was given in an elaborate setting with costumes but without dramatic action. Handel's Acis and Galatea is a well-known example.)"}, "madsrdf:citationSource": "Oxford music online, Oct. 3, 2011:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027084"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027085", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aService books (Music)", "identifiers:lccn": "gf2014027085", "madsrdf:adminMetadata": [{"@id": "_:nfbbd0928767744b08d0ef8544d876ddfb1"}, {"@id": "_:nfbbd0928767744b08d0ef8544d876ddfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Service books (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfbbd0928767744b08d0ef8544d876ddfb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027184"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026026"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026636"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026842"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026871"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026901"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026941"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027014"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027083"}], "madsrdf:hasVariant": {"@id": "_:nfbbd0928767744b08d0ef8544d876ddfb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfbbd0928767744b08d0ef8544d876ddfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-09-28T10:54:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfbbd0928767744b08d0ef8544d876ddfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nfbbd0928767744b08d0ef8544d876ddfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Service books (Music)"}}, {"@id": "_:nfbbd0928767744b08d0ef8544d876ddfb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfbbd0928767744b08d0ef8544d876ddfb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Choir books"}}, {"@id": "_:nfbbd0928767744b08d0ef8544d876ddfb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Choir books"}}], "@id": "/authorities/genreForms/gf2014027085"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027086", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSevillanas (Music)", "identifiers:lccn": "gf2014027086", "madsrdf:adminMetadata": [{"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb1"}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sevillanas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026806"}], "madsrdf:hasSource": [{"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb5"}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb6"}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb7"}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb8"}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sevillanas (Music)"}}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sevillanas: slightly faster variant from Andalusia of seguidillas; also a type of flamenco music derived from this variant)"}, "madsrdf:citationSource": "New Harvard dict. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(form of Spanish folk music; defined by Diccionario de la Real Academia Espa\u00f1ola de la lengua as \"musical, dance air characteristic of Sevilla and bordering land; it appears that sevillanas were originally a variant of seguidillas; well into the 19th cent., sevillanas began to develop along independent lines; musical influence of flamenco upon the sevillana is very pronounced; usually sung by one or several persons; a number of instruments, particularly guitar, can be used by way of rhythmic, harmonic, and melodic support; in classical sevillanas, hands of players are clapped and castanets and timbrels used; in modern sevillanas, any instrument, from synthesizer to symphony orchestra, may be employed; many classical composers have been inspired by sevillanas)"}, "madsrdf:citationSource": "Work cat.: 99481560: Murciano, M. 4 sevillanas para 4 guitarras, c1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sevillana: flamenco-style song and dance of Andalusian origin)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Feb. 14, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sevillana: seguidilla, esp. the seguidilla as danced or played in Seville; often used in pl.)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ea7b24f3e76419f9e6f81ffe374f90cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Spain: sevillana (lively dance song from Seville)"}, "madsrdf:citationSource": "White, D. Dict. pop. mus. styles of the world:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027086"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027087", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aShape-note hymnals", "identifiers:lccn": "gf2014027087", "madsrdf:adminMetadata": [{"@id": "_:na7e964d698c9426eba430fba891d5ab5b1"}, {"@id": "_:na7e964d698c9426eba430fba891d5ab5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Shape-note hymnals"}, "madsrdf:elementList": {"@list": [{"@id": "_:na7e964d698c9426eba430fba891d5ab5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026871"}, "madsrdf:hasSource": [{"@id": "_:na7e964d698c9426eba430fba891d5ab5b5"}, {"@id": "_:na7e964d698c9426eba430fba891d5ab5b6"}, {"@id": "_:na7e964d698c9426eba430fba891d5ab5b7"}, {"@id": "_:na7e964d698c9426eba430fba891d5ab5b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na7e964d698c9426eba430fba891d5ab5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na7e964d698c9426eba430fba891d5ab5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na7e964d698c9426eba430fba891d5ab5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shape-note hymnals"}}, {"@id": "_:na7e964d698c9426eba430fba891d5ab5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Shape note)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:na7e964d698c9426eba430fba891d5ab5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Shape-note hymnody (Much of the music in the shape-note hymnbooks was written by the late 18th-century singing-school composers of New England, who also introduced the practice of including a pedagogical preface to a tune book; to the New England repertory of psalm and hymn tunes, fuging-tunes, set-pieces and anthems the shape-note hymnbook compilers made a significant addition, folk hymns and spirituals drawn from oral tradition)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Apr. 25, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:na7e964d698c9426eba430fba891d5ab5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Shape-note hymnody)"}, "madsrdf:citationSource": "AmeriGrove", "madsrdf:citationStatus": "found"}, {"@id": "_:na7e964d698c9426eba430fba891d5ab5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under shape-note (a type of notation employed in tune books and hymnals in the U.S. ... from the 19th century until the present)"}, "madsrdf:citationSource": "New Harvard dict. of mus.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027087"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027088", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aShigin", "identifiers:lccn": "gf2014027088", "madsrdf:adminMetadata": [{"@id": "_:n836cc35be56649279829a0d11140e673b1"}, {"@id": "_:n836cc35be56649279829a0d11140e673b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Shigin"}, "madsrdf:elementList": {"@list": [{"@id": "_:n836cc35be56649279829a0d11140e673b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026707"}, "madsrdf:hasSource": [{"@id": "_:n836cc35be56649279829a0d11140e673b5"}, {"@id": "_:n836cc35be56649279829a0d11140e673b6"}, {"@id": "_:n836cc35be56649279829a0d11140e673b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n836cc35be56649279829a0d11140e673b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n836cc35be56649279829a0d11140e673b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n836cc35be56649279829a0d11140e673b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shigin"}}, {"@id": "_:n836cc35be56649279829a0d11140e673b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Music of the shigin : chanting to Chinese poetry)"}, "madsrdf:citationSource": "Music of the shigin, 2003 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n836cc35be56649279829a0d11140e673b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Garland encylopedia of world music. Volume 3: The United States and Canada:", "madsrdf:citationStatus": "found"}, {"@id": "_:n836cc35be56649279829a0d11140e673b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Shigin (Japanese: \u8a69\u541f) is a performance of reciting a Japanese poem or a Chinese poem read in Japanese, each poem (Japanese: \u8a69 = shi) usually chanted (Japanese: \u541f = gin) by an individual or in a group. Reciting can be done loudly before a large audience, softly to a few friends, or quietly to the reciter himself or herself. Each reciting is also termed gin. Any forms of the Japanese and Chinese poetry are used for reciting... Members of a Shigin group will usually gather to train in a washitsu, or Japanese-style room with tatami matting. Participants kneel in the lotus or seiza position, thought to be the optimum posture to allow strong and steady projection during chanting. They are encouraged to focus their energy in their gut (thought in Zen to be the locus of power) and sing by slowly expelling this energy. Conversely, singing from the chest, as would be encouraged in classical Western operatic style, is deemed unauthentic."}, "madsrdf:citationSource": "Wikipedia, viewed May 28, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027088"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027089", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSh\u014dmy\u014d", "identifiers:lccn": "gf2014027089", "madsrdf:adminMetadata": [{"@id": "_:n7dc58161116b4f6593d17ac858c42d60b1"}, {"@id": "_:n7dc58161116b4f6593d17ac858c42d60b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sh\u014dmy\u014d"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7dc58161116b4f6593d17ac858c42d60b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026707"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasSource": [{"@id": "_:n7dc58161116b4f6593d17ac858c42d60b5"}, {"@id": "_:n7dc58161116b4f6593d17ac858c42d60b6"}, {"@id": "_:n7dc58161116b4f6593d17ac858c42d60b7"}, {"@id": "_:n7dc58161116b4f6593d17ac858c42d60b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7dc58161116b4f6593d17ac858c42d60b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n7dc58161116b4f6593d17ac858c42d60b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7dc58161116b4f6593d17ac858c42d60b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sh\u014dmy\u014d"}}, {"@id": "_:n7dc58161116b4f6593d17ac858c42d60b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Japon : Sh\u00f4my\u00f4, rituel bouddhique) insert (Buddhist chants from the Ch\u00fbkyoku Rishu Zanma\u00ef ceremony of the Shingon school sung in Sanskrit, Chinese, and Japanese)"}, "madsrdf:citationSource": "Japon, p 1994 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dc58161116b4f6593d17ac858c42d60b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Japon : Sh\u00f4my\u00f4, Secte Tenda\u00ef = Japan : Sh\u00f4my\u00f4, Tenda\u00ef Sect)"}, "madsrdf:citationSource": "Japon, p 1995 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dc58161116b4f6593d17ac858c42d60b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "T\u014ddaiji Shunie sh\u014dmy\u014d no senritsu ni kansuru kenky\u016b /", "madsrdf:citationStatus": "found"}, {"@id": "_:n7dc58161116b4f6593d17ac858c42d60b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sh\u014dmy\u014d (\u58f0\u660e?) is a style of Japanese Buddhist chant, used mainly in the Tendai and Shingon sects. There are two styles: ryokyoku and rikkyoku, described as difficult and easy to remember, respectively. Sh\u014dmy\u014d, like gagaku, employs the Yo scale, a pentatonic scale with ascending intervals of two, three, two, two, and three semitones)"}, "madsrdf:citationSource": "Wikipedia, viewed May 28, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027089"}
