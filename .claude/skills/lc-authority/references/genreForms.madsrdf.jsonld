00087419c5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantasy radio programs"}}, {"@id": "_:ne26ec803c5544022a0b75600087419c5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasy: Fictional programs which depict imaginary characters, often with supernatural powers, sometimes inhabiting imaginary worlds; UF Adult fantasy; Fairy tales. Example: Dark fantasy)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Nov. 7, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:ne26ec803c5544022a0b75600087419c5b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne26ec803c5544022a0b75600087419c5b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fairy tales (Radio programs)"}}, {"@id": "_:ne26ec803c5544022a0b75600087419c5b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fairy tales (Radio programs)"}}], "@id": "/authorities/genreForms/gf2011026243"}
