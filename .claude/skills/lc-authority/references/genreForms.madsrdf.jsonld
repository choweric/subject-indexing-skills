{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027128", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTap dance music", "identifiers:lccn": "gf2014027128", "madsrdf:adminMetadata": [{"@id": "_:nba13a6c290f241138c31ea2aeafb8c1fb1"}, {"@id": "_:nba13a6c290f241138c31ea2aeafb8c1fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tap dance music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nba13a6c290f241138c31ea2aeafb8c1fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:nba13a6c290f241138c31ea2aeafb8c1fb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions either composed or arranged for tap dancing."}, {"@id": "_:nba13a6c290f241138c31ea2aeafb8c1fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:01:06"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nba13a6c290f241138c31ea2aeafb8c1fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nba13a6c290f241138c31ea2aeafb8c1fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tap dance music"}}, {"@id": "_:nba13a6c290f241138c31ea2aeafb8c1fb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wor