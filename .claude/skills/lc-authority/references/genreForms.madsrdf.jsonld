e": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Zoning > Zoning maps (Zoning maps show the boundaries of zoning districts throughout the city)"}, "madsrdf:citationSource": "New York City Dept. of City Planning website, July 21, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n58cb8fca1bd74ca3bcee4edde37b6e23b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 84690039: City of Lynnwood, official zoning map, 1982?", "madsrdf:citationStatus": "found"}, {"@id": "_:n58cb8fca1bd74ca3bcee4edde37b6e23b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Area zoning guidelines and adopted zoning maps for the Stevens Pass and upper Skykomish study area, 1974?", "madsrdf:citationStatus": "found"}, {"@id": "_:n58cb8fca1bd74ca3bcee4edde37b6e23b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n58cb8fca1bd74ca3bcee4edde37b6e23b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Zoning district maps"}}, {"@id": "_:n58cb8fca1bd74ca3bcee4edde37b6e23b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zoning district maps"}}], "@id": "/authorities/genreForms/gf2011026752"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026755", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPhotomaps", "identifiers:lccn": "gf2011026755", "madsrdf:adminMetadata": [{"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b1"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Photomaps"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026032"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}], "madsrdf:hasSource": [{"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b5"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b6"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b7"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b8"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b9"}], "madsrdf:hasVariant": [{"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b10"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b13"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b16"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-03-12T13:40:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-11-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photomaps"}}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(photographic map: map made from assembling photographs and adding appropriate information such as a reference system, grid, labels, scale, and so forth)"}, "madsrdf:citationSource": "Practical handbook of digital mapping : terms and concepts, c1994", "madsrdf:citationStatus": "found"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(photomap: an aerial photograph or a photomosaic on which symbols, names, boundaries etc. have been added so that it may serve as a map)"}, "madsrdf:citationSource": "Clark, A.N. Longman dict. of geography, human and physical, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 50 (\"The dividing line between a controlled photomosaic and a photomap is not always easy to define since it rests primarily on the degree of cartographic enhancement of the photographic image. The photomosaic is normally a monochrome image and has some limited cartographic treatment usually--a title, grid, scale, some names, certain symbols. With the photomap, the cartographic effort is much greater--several colours may be used and a considerable amount of symbolized information added. However, this considerable effort is normally made only where the base is an orthophotographic one, in which case it becomes an orthophotomap.\")"}, "madsrdf:citationSource": "Petrie, G. Orthophotomaps, in Transactions of the Institute of British Geographers, new ser., v. 2, no. 1 (1977), via JSTOR, viewed July 28, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(orthophoto map: a geometrically accurate map derived from satellite remote sensing or from aerial photography)"}, "madsrdf:citationSource": "Clark, A.N. The Penguin dict. of geography, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 218 (For decades, aerial photographs have been assembled into mosaics which, in turn, have been overprinted with selected map symbols to produce photomaps; photomaps have been used during military operations as a replacement for unavailable topographic maps) p. 220 (Photomaps prepared from conventional uncontrolled or controlled mosaics have long been used as planimetric map substitutes, but the relief displacement inherent in the photos limited their usefulness. The orthophotomap has all the advantages of the photographic image and is of consistent scale as well.)"}, "madsrdf:citationSource": "Elements of cartography, c1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photo maps"}}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photo maps"}}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Orthophotomaps"}}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Orthophotomaps"}}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Orthophoto maps"}}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Orthophoto maps"}}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photographic maps"}}, {"@id": "_:n6073cbd5e1ba49fbb15a29a28401fee1b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photographic maps"}}], "@id": "/authorities/genreForms/gf2011026755"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026756", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFlow maps", "identifiers:lccn": "gf2011026756", "madsrdf:adminMetadata": [{"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb1"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Flow maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb5"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb6"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb7"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb8"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb9"}], "madsrdf:hasVariant": [{"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb10"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb13"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb16"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb19"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-09-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-11-15T11:28:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flow maps"}}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 225 (Maps that show linear movement between places are called flow maps, and because of this quality, are sometimes referred to as dynamic maps. Symbols on quantitative flow maps are lines, usually with arrows to show direction, that vary in width ... Flow mapping began with those done by Henry Drury Harness in 1837 ... Flow maps used in textbooks are divided into three classes: radial, network, and distributive) p. 226 (can show what kind of (qualitative) or how much (quantitative) movement there is between two places; flow line maps; In the last edition of his book, Raisz places them into a class of maps called cartograms. However, not to be confused with value-by-area cartograms, flow maps are more correctly called linear cartograms) p. 239 (glossary definitions for types of flow maps: desire line map; distributive flow map; network flow map; radial flow map; traffic flow map)"}, "madsrdf:citationSource": "Dent, B.D. Cartography : thematic map design, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Geological Survey (U.S.). The Pu\u02bbu \u02bb\u014c\u02bb\u014d-K\u016bpaianaha eruption of K\u012blauea, November 1991-February 1994 : field data and flow maps, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Oregon. Dept. of Transportation. Traffic flow map, 2009, Oregon State highway system, 2009?", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Flow maps in cartography are by definition of Phan (2005) \"a mix of maps and flow charts, that show the movement of objects from one location to another, such as the number of people in a migration, the amount of goods being traded, or the number of packets in a network.\" Flow maps according to Harris (1999) \"can be used to show movement of almost anything, including tangible things such as people, products, natural resources, weather, etc, as well as intangible things such as know-how, talent, credit of goodwill.\" Flow maps can indicate things like: * What it is that flows, moves, migrates, etc. * What direction the flow is moving and/or what the source and destination are. * How much is flowing, being transferred, transported, etc. * General information about what is flowing and how it is flowing.)"}, "madsrdf:citationSource": "Wikipedia, July 28, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Chishitsu Ch\u014dsajo (Japan). Heat flow map of East and Southeast Asia, c1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dynamic maps"}}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dynamic maps"}}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Flow line maps"}}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flow line maps"}}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Line maps, Flow"}}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Line maps, Flow"}}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Linear cartograms"}}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Linear cartograms"}}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cartograms, Linear"}}, {"@id": "_:nd3138c3b9c92460585c9fa2108b4515eb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cartograms, Linear"}}], "@id": "/authorities/genreForms/gf2011026756"}
