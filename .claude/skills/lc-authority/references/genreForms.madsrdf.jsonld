srdf:elementValue": {"@language": "en", "@value": "Zombie comics"}}, {"@id": "_:n577ba09129744a50b41926e899af9e8db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection of zombie comic strips)"}, "madsrdf:citationSource": "Work cat.: Syafrian, H. Zombie ngehe! : the adventure begins, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n577ba09129744a50b41926e899af9e8db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beginning with the legendary E.C. Comics horror titles from the 1940s and '50s, vampires, zombies, demons, and all other types of creepy creatures have made a major impact on the storytelling medium; 10. The Zombie; 11. Tales from the Crypt Zombie)"}, "madsrdf:citationSource": "Serafino, J. The 15 scariest monsters in comic books, via Complex website, Oct. 31, 2012, viewed on July 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n577ba09129744a50b41926e899af9e8db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel, originally published as comic books with same title; summary: Every time Gwen, a zombie, eats someone's brains she also inherits some of their memories and the latest morsel she devoured gives her memories of a murder she and her friends need to solve.)"}, "madsrdf:citationSource": "Roberson, C. iZombie, 2011-2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n577ba09129744a50b41926e899af9e8db8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lee, T. Pride and prejudice and zombies : the graphic novel, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:n577ba09129744a50b41926e899af9e8db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, back cover (\"All hell breaks loose when a fateful accident sets in motion a series of terrifying events that will threaten the town of Riverdale like never before! When the dead begin to rise, craving human flesh, it's up to Archie, Betty & Veronica, and the Gang to fight for their lives against the zombie hordes led by their former pal, Jughead.\")"}, "madsrdf:citationSource": "Aguirre-Sacasa, R. Afterlife with Archie, 2014- :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026037"}
