y/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6e89f6ba816d4146acc40568276e1b01b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Christmas music"}}, {"@id": "_:n6e89f6ba816d4146acc40568276e1b01b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Christmas music; comprises a variety of genres of music normally performed or heard around the Christmas season)"}, "madsrdf:citationSource": "Wikipedia, viewed August 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6e89f6ba816d4146acc40568276e1b01b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6e89f6ba816d4146acc40568276e1b01b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Christmas songs"}}, {"@id": "_:n6e89f6ba816d4146acc40568276e1b01b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Christmas songs"}}], "@id": "/authorities/genreForms/gf2014026716"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026717", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChutney (Music)", "identifiers:lccn": "gf2014026717", "madsrdf:adminMetadata": [{"@id": "_:nc26a88219c524ff881d65128d46bfe64b1"}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Chutney (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc26a88219c524ff881d65128d46bfe64b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nc26a88219c524ff881d65128d46bfe64b5"}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b6"}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b7"}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b8"}], "madsrdf:hasVariant": {"@id": "_:nc26a88219c524ff881d65128d46bfe64b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chutney (Music)"}}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 86 (classical singing (tan) performed by Asian Indians in Trinidad during celebrations after wedding rituals is followed by so-called chutney songs, which are danceable and easy to sing; in the 1980s, chutney combined with soca (soul calypso) to become chutney-soca, a mixture of Trinidadian modern calypso, sung in Hindi with Indian vocal ornamentations and dholak accompaniment)"}, "madsrdf:citationSource": "Garland encyc. of world music, 1998- :", "madsrdf:citationStatus": "found"}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(although the chutney vogue is a recent phenomenon, it derives from folk song genres brought by East Indian immigrants to Guyana, Surinam, and Trinidad; at the same time that it is declining as a folk custom, it has come to be reinvented as a popular culture phenomenon; primarily functions as dance music; in lyrics, Hindi and Bhojpuri are increasingly being replaced by English or by a mixture of English and Hindi)"}, "madsrdf:citationSource": "Work cat.: 99053448: Manuel, P.L. East Indian music in the West Indies, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Guyana (chutney, soca-like music of the East Indian population) under Surinam (chutney, East Indian music similar to soca) under Trinidad & Tobago (chutney, East Indian modern pop music in Trinidad)"}, "madsrdf:citationSource": "White, D. Dict. of pop. mus. styles of the world, c1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 249 (chutney: a light, fast Indo-Caribbean song and dance in modernized Indian folk style)"}, "madsrdf:citationSource": "Manuel, P.L. Caribbean currents, 1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc26a88219c524ff881d65128d46bfe64b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chutney songs"}}, {"@id": "_:nc26a88219c524ff881d65128d46bfe64b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chutney songs"}}], "@id": "/authorities/genreForms/gf2014026717"}
