dsrdf:elementValue": {"@language": "en", "@value": "Terminator films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Star Trek films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Star Trek films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Star Wars films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Star Wars films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alien films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alien films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db17", "@type": "madsrdf:Source", "madsrdf:citationSource": "Snelgrove, K. The sci-fi film & television quiz book, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(science fiction: Fictional work that relies on some type(s) of advanced technology, scientific development, or encounter with alien life, to make the narrative possible. Stories frequently have a prophetic nature, forecasting how technological changes may impact society in the years to come)"}, "madsrdf:citationSource": "Moving image genre/form guide via WWW, Oct. 17, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db19", "@type": "madsrdf:Source", "madsrdf:citationSource": "Weaver, T. I talked with a zombie : interviews with 23 veterans of horror and sci-fi films and television, c2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Science fiction: Use for fictional genre films and programs which revolve around imaginary science and technology, and visions of future society; UF Mad scientist drama; Science fiction films; Science fiction television programs; Star Trek films; Star Wars films; utopian works; BT Fantasy; NT Superhero drama; RT Horror drama; Monster drama)"}, "madsrdf:citationSource": "Yee, M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db21", "@type": "madsrdf:Source", "madsrdf:citationSource": "The greatest sci-fi films of all time, c2011-", "madsrdf:citationStatus": "found"}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db22", "@type": "madsrdf:Source", "madsrdf:citationSource": "Guerrero, E. Fantastic otherness : racial representation in Hollywood's sci-fi and horror films, 1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db23", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Science fiction film (Extrapolative film, Future film, Sci-fier, Sci-fi film, SF film). A clear-cut definition is not easy to formulate because science fiction encroaches on the adjacent genres of fantasy and horror, very often blending freely with them. For the sake of simplicity, science fiction is best defined as a genre that deals with imaginary journeys, imaginary worlds and societies from the standpoint of credible possibility presented in rational scientific terms. Science fiction films are also made of aliens, bug-eyed monsters and creatures galore; robots, computers and other technological advances. Subgenres: Dystopian films; Future barbarian movies; Invasion films; Period SF films; Political extrapolation films; Prehistoric fantasies; SF comedies; SF disaster films; SF horror films; SF sex films; Social extrapolation film; Space operas; Space travel films; Time travel films)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Star Wars films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Star Wars films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alien films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alien films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Extrapolative films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Extrapolative films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Star Trek films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Star Trek films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Future films (Science fiction films)"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Future films (Science fiction films)"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sci-fi films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sci-fi films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db42", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db43"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Terminator films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db43", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Terminator films"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db45", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db46"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sci-fiers (Motion pictures)"}}, {"@id": "_:naf8e35c7f1b44b2cadd8daf6a7ba8b5db46", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sci-fiers (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2011026556"}
