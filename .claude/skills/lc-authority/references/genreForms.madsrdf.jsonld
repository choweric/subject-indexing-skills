{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026057", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aComposite atlases", "identifiers:lccn": "gf2011026057", "madsrdf:adminMetadata": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b1"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Composite atlases"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026058"}, "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b5"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b8"}], "madsrdf:hasSource": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b11"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b12"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b13"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b14"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b15"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b16"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b17"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b18"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b19"}], "madsrdf:hasVariant": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b20"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b23"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b26"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b29"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b32"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025036"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:30:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Composite atlases"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Atlases factice"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Atlases factice"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Atlas factice"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Atlas factice"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Celestial globes)"}, "madsrdf:citationSource": "LCSH, Jan. 8, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bound sets of maps, which are called Atlas Factice, are almost never called atlases by their makers or producers)"}, "madsrdf:citationSource": "Varanka, D. Precursors to the rise of English world atlases, 2001 [paper from the 20th International Cartographic Conference] via ESRI web site, April 20, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 26 (\"atlas factice\": an atlas made up by a mapseller from map sheets in his stock)"}, "madsrdf:citationSource": "Compleat plattmaker, 1978, via Google books, April 20, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (atlas factice: a composite work made up of a selection of previously issued maps. It may be bound or loose-leaf)"}, "madsrdf:citationSource": "Cartographic materials, 2nd ed., 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (a unique sixteenth century composite atlas from the House of Bertelli in Venice) p. 3 (composite atlases; can be subdivided into three types: collections compiled by a map publisher mainly from his own program; atlases composed by booksellers from the production of several local publishers; and volumes consisting of maps by various publishers, bound together by a later proprietor; the first two types are common in Dutch, Italian, French, and German cartography up to the end of the 18th century) p. 4 (alternate names: Lafreri atlas and IATO or \"Italian assembled-to-order\" atlas; modern writing tries to avoid these terms)"}, "madsrdf:citationSource": "The Strabo illustratus atlaes, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "subject index (Atlases factice)"}, "madsrdf:citationSource": "Newberry Library cartographic catalog, viewed December 24, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 51-70, in chapter \"Italian composite atlases of the sixteenth century\" by David Woodward (Italian publishers issued atlases consisting of separately published maps and views assembled into the order of individual clients; the common designation \"Lafreri atlas\" to include any Italian composite atlas or atlas factice of the 16th century is highly misleading; of the surviving Italian 16th-century composite atlases, only about a quarter bear the well-known title page issued by Antonio Lafreri; atlases were assembled for clients either from already printed maps in stock or other marks of authorship; miscellaneous in authorship and format, a kind of contemporary cartographic anthology) p. 102 (Dutch firm of Covens and Mortier and the house of Ottens were both famous for voluminous atlases assembled to order, ca. 1720-1780) p. 272 (maps engraved by the Bordiga brothers in Milan were reprinted up to the 1850s and assembled to form composite atlases)"}, "madsrdf:citationSource": "Images of the world, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b18", "@type": "madsrdf:Source", "madsrdf:citationSource": "Glossary of mapping, charting,and geodetic terms, 1973;Glossary of the mapping sciences, 1994;Glosssary of technical terms in cartography, 1966;Enzyklop\u00e4disches W\u00f6rterbuch Kartographie in 25 Sprachen, 1997;Glosario de t\u00e9rminos cartogr\u00e1ficos y fotogram\u00e9tricos, 1986;Map-making to 1900, 1976.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 297 (composite atlas, also known as atlas factice; a unique assemblage of previously issued maps; may have been assembled from the stock of a single mapseller for a particular customer or may have been assembled by a collector from personal stock; usually bound but may be loose-leaf; may or may not have a title page)"}, "madsrdf:citationSource": "Descriptive cataloging of rare materials (cartographic), 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Atlas factice"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Atlas factice"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "IATO atlases"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "IATO atlases"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lafreri atlases"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lafreri atlases"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Atlases factice"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Atlases factice"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8fd8c06a9c164648b87127a84dabab27b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Italian assembled-to-order atlases"}}, {"@id": "_:n8fd8c06a9c164648b87127a84dabab27b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Italian assembled-to-order atlases"}}], "@id": "/authorities/genreForms/gf2011026057"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026058", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAtlases", "identifiers:lccn": "gf2011026058", "madsrdf:adminMetadata": [{"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b1"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Atlases"}, "madsrdf:elementList": {"@list": [{"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026057"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026121"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026365"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026742"}], "madsrdf:hasSource": [{"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b5"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b6"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b7"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b8"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b9"}], "madsrdf:hasVariant": [{"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b10"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b13"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025008"}}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-12T12:03:06"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Atlases"}}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "atlas (a collection of maps designed to be kept (bound or loose) in a volume)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Centro Nacional de Registros (El Salvador). Atlas hist\u00f3rico cartogr\u00e1fico de El Salvador = Historical cartographic atlas of El Salvador, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (atlas: A unit of extent that is a volume of maps or other cartographic content with or without descriptive text. This term applies to cartographic resources.)"}, "madsrdf:citationSource": "RDA, via RDA toolkit, Apr. 10, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(atlas: A bound or boxed collection of maps, usually related in subject or theme, with an index of place names (gazetteer) usually printed at the end. The term was also used in the wider sense of a collection of maps with illustrations of topographical features, portraits, and pictures of plants and animals, mythological scenes, historical events, etc. In most modern atlases, the maps are printed in uniform style and format, on a fairly consistent scale. An atlas may be issued as an independent publication or as accompanying material, with or without descriptive text, plates, charts, tables, etc.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Apr. 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(atlas 3 a : a bound collection of maps often including illustrations, informative tables, or textual matter. b : a bound collection of tables, charts, or plates)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Apr. 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cartographic atlases"}}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cartographic atlases"}}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographic atlases"}}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographic atlases"}}, {"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n60fd38cc1db24bc1a8251aeb757ed479b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographical atlases"}}, {"@id":