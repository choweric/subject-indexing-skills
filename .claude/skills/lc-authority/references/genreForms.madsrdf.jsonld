Upside-down books"}}, {"@id": "_:n1f9320d5f1774bc9a44f92ed75074549b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Upside-down books. UF Reversible books; Turn-around books. BT Optical illusions; Toy and movable books)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n1f9320d5f1774bc9a44f92ed75074549b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1f9320d5f1774bc9a44f92ed75074549b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Turn-around books"}}, {"@id": "_:n1f9320d5f1774bc9a44f92ed75074549b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Turn-around books"}}, {"@id": "_:n1f9320d5f1774bc9a44f92ed75074549b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1f9320d5f1774bc9a44f92ed75074549b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reversible books"}}, {"@id": "_:n1f9320d5f1774bc9a44f92ed75074549b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reversible books"}}], "@id": "/authorities/genreForms/gf2014026206"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026207", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVital statistics", "identifiers:lccn": "gf2014026207", "madsrdf:adminMetadata": [{"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b1"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Vital statistics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b3"}]}, "madsrdf:exampleNote": "Note under [Census data]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026181"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026059"}, "madsrdf:hasSource": [{"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b5"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b6"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b7"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b8"}], "madsrdf:hasVariant": [{"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b9"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b12"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b15"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b18"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Official public records of births, deaths, marriages, divorces, and other life events. For official counts of the population of a place or ethnic group, sometimes including data relating to economic and social conditions, see [Census data.]"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:29:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vital statistics"}}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Vital statistics. UF Vital event statistics; Vital rates. BT Statistics)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(vital statistics records. UF vital records (vital statistics records). Public records kept by a state, city, or other governmental subdivision, under a statutory provision, of births, deaths, marriages, diseases, divorces, and other life events; vital records (document genre). Generally, records of organizations which are vital to the continuity of a business in case of emergency or after a disaster. For public records of life events generated under government or other authority, use \"vital statistics records.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(vital records: Records essential to an agency in the ongoing conduct of its business or affairs, without which it would cease to function effectively, for example, the file of patron records used by a library in circulation transactions. For archivists, identifying and protecting vital records under every conceivable circumstance is a primary concern in records management and disaster planning. Also refers to the official records of births, deaths, and marriages maintained by an agency of local, state, or national government. Synonymous with vital statistics.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Vital Statistics. Used for general articles concerning statistics of births, deaths, marriages, etc. UF Vital Statistics Registrations. NT Life Expectancy; Life Tables; Morbidity; Mortality; Pregnancy Rate)"}, "madsrdf:citationSource": "MeSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Records, Vital (Statistics)"}}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Records, Vital (Statistics)"}}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vital records (Statistics)"}}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vital records (Statistics)"}}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vital event statistics"}}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vital event statistics"}}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vital rates"}}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vital rates"}}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vital statistics records"}}, {"@id": "_:n02167c1c689a4c0d91dd4a1ba4749e92b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vital statistics records"}}], "@id": "/authorities/genreForms/gf2014026207"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026208", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aYearbooks", "identifiers:lccn": "gf2014026208", "madsrdf:adminMetadata": [{"@id": "_:n3506f97e71234269bd69b74abb28ffeeb1"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Yearbooks"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3506f97e71234269bd69b74abb28ffeeb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026064"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026174"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026172"}, "madsrdf:hasSource": [{"@id": "_:n3506f97e71234269bd69b74abb28ffeeb5"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb6"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb7"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb8"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb9"}], "madsrdf:hasVariant": [{"@id": "_:n3506f97e71234269bd69b74abb28ffeeb10"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yearbooks"}}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(yearbook: An annual compendium of facts and statistics of the preceding year, frequently limited to a special subject. Compare with almanac (1))"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 88 (yearbook 1 book of records of cases, 2 annual publication by a society etc.)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(yearbooks. UF year books. Books published annually as a compendium, report, or summary of the statistics or facts of a calendar year and intended as reference books, limited to a special subject.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Yearbooks. Use for annual compendia of facts and statistics of the preceding year, frequently limited to a special subject. BT Periodicals; Reference works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(yearbook: An annual documentary, historical, or memorial compendium of facts, photographs, statistics, etc., about the events of the preceding year, often limited to a specific country, institution, discipline, or subject. Optional yearbooks are offered by some publishers of general encyclopedias. Also spelled year book. Compare with annual. Also refers to an annual high school or college publication commemorating a particular school year or graduating class in photographs, usually sold in hardcover to seniors by advance special order at the end of the school year.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3506f97e71234269bd69b74abb28ffeeb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Annuals (Yearbooks)"}}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Annuals (Yearbooks)"}}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3506f97e71234269bd69b74abb28ffeeb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Year books"}}, {"@id": "_:n3506f97e71234269bd69b74abb28ffeeb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Year books"}}], "@id": "/authorities/genreForms/gf2014026208"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026209", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aYellow pages", "identifiers:lccn": "gf2014026209", "madsrdf:adminMetadata": [{"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb1"}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Yellow pages"}, "madsrdf:elementList": {"@list": [{"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026189"}, "madsrdf:hasSource": [{"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb5"}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb6"}], "madsrdf:hasVariant": [{"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb7"}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb10"}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yellow pages"}}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(yellow pages: The portion of a telephone directory or trade directory following the white pages in which the names, phone numbers, and mailing addresses of commercial enterprises are listed, usually alphabetically by subject or in a classified arrangement, so named because the section is printed on yellow paper. Yellow pages are also available online and for specific professions.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 88 (yellow pages: classified sections of, or supplement to, telephone directory)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Telephone yellow pages"}}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telephone yellow pages"}}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Telephone yellowpages"}}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telephone yellowpages"}}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yellowpages"}}, {"@id": "_:nea676afe62234d3ab2c2588d32be1f6fb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yellowpages"}}], "@id": "/authorities/genreForms/gf2014026209"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026210", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aZines", "identifiers:lccn": "gf2014026210", "madsrdf:adminMetadata": [{"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b1"}, {"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Zines"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026139"}], "madsrdf:hasSource": [{"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b5"}, {"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b6"}, {"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Self-published, non-commercial publications that are usually devoted to specialized or unconventional subject matter."}, {"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T09:56:23"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zines"}}, {"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(zine: Derived from \"fanzine\" (a contraction of \"fan magazine\"), pronounced \"zeen.\" The term came into use during the 1980s to refer to a small, low-circulation magazine or newspaper, self-published out of passion for the subject rather than for personal gain, usually produced with the aid of desktop publishing software and high-quality photocopy machines. Zines represent the convergence of amateur publishing hobbyists, high school underground newspapers, the literary small press, political radicalism, and do-it-yourself popular culture. They are usually not available by subscription, often appear irregularly or infrequently, and may have a lifetime of only one or two issues. Some are available online via the World Wide Web.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Zines. Use for independent self-publications, periodical or monographic, usually inexpensively produced and with small circulation, covering any of a wide range of topics. BT Conditions of publication (Gathering term; do not assign). NT Fanzines; Fanzines. Use for independent, self-published periodicals issued by or for enthusiasts of aspects of popular culture and entertainment, usually inexpensively produced and with small circulation. UF Fan magazines. BT Periodicals; Zines)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c2f86e179e64c5990c2edec7d1c78a7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fanzines. UF zines. Periodicals for enthusiasts of aspects of popular culture such as pop music, comic books, and other specialized interests, especially science fiction and fantasy works, often inexpensively produced and with small circulation.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 30, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026210"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026211", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAbecedariuses", "identifiers:lccn": "gf2014026211", "madsrdf:adminMetadata": [{"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb1"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Abecedariuses"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026214"}, "madsrdf:hasSource": [{"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb5"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb6"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb7"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb8"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb9"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb10"}], "madsrdf:hasVariant": {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems in which each line or stanza begins with a successive letter of the alphabet."}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-04-16T14:35:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Abecedariuses"}}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(abecedarius, a type of acrostic in which the first letter of each line of a poem or the first letter of the first word of each stanza taken in order forms the alphabet. Examples of these are some of the Psalms (in Hebrew), such as Psalms 25 and 34, where successive verses begin with the letters of the Hebrew alphabet in order. The word is from the late Latin for \"alphabetical\" and is derived from the names of the letters a, b, c, and d.)"}, "madsrdf:citationSource": "Britannica online, July 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abecedarium (See: abecedary) abecedarius (See: acrostic) abecedary (A book containing the letters of the alphabet and basic rules of spelling and grammar, used in Europe as a primer before the invention of the printing press. Early printed examples (sometimes in the form of a broadsheet) displayed the alphabet in uppercase and lowercase letters in both roman and gothic type, with separate lists of vowels, dipthongs, and consonants. By 1700, some ABC books included children's rhymes. Synonymous with abecedarium (plural: abecedarii). See also: horn book) acrostic (A verse or list of words composed in such a way that certain letters of each line (usually the first and/or last), when read in order of appearance, spell a word, phrase, or sentence. An abecedarius is an acrostic in which the pattern consists of the letters of the alphabet in traditional order)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS: online dictionary for library and information science, viewed Jan. 15, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acrostic: A poem in which the first or last letters of each line vertically form a word, phrase, or sentence. Apart from puzzles in newspapers and magazines, the most common modern versions involve the first letters of each line forming a single word when read downwards. An acrostic that involves the sequential letters of the alphabet is said to be an abecedarius or an abecedarian poem. Abecedarian acrostics were also a common genre in classical Hebrew poetry)"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, July 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(abecedarius -es: a poem in which the lines or stanzas begin with the letters of the alphabet in regular order (as the 119th Psalm in Hebrew or Chaucer's A B C))"}, "madsrdf:citationSource": "Merriam-Webster online, July 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Abecedarius: pl. form abecedarii)"}, "madsrdf:citationSource": "Grammarist website, July 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetic Forms: Abecedarian and Acrostic. The abecedarian is an ancient poetic form guided by alphabetical order; numerous examples of abecedarians in the Hebrew Bible; a form derived from the abecedarian is the acrostic)"}, "madsrdf:citationSource": "Poets.org, Dec. 26, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Abecedarii"}}, {"@id": "_:nc1fc1c2ab8084b9db314d5e40e88d9ffb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Abecedarii"}}], "@id": "/authorities/genreForms/gf2014026211"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026212", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCumulative rhymes", "identifiers:lccn": "gf2014026212", "madsrdf:adminMetadata": [{"@id": "_:na52273f13f794a9ba326d862970dee78b1"}, {"@id": "_:na52273f13f794a9ba326d862970dee78b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cumulative rhymes"}, "madsrdf:elementList": {"@list": [{"@id": "_:na52273f13f794a9ba326d862970dee78b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026459"}, "madsrdf:hasSource": [{"@id": "_:na52273f13f794a9ba326d862970dee78b5"}, {"@id": "_:na52273f13f794a9ba326d862970dee78b6"}, {"@id": "_:na52273f13f794a9ba326d862970dee78b7"}], "madsrdf:hasVariant": {"@id": "_:na52273f13f794a9ba326d862970dee78b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Nursery rhymes in which phrases are repeated and built up as the verse progresses."}, {"@id": "_:na52273f13f794a9ba326d862970dee78b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na52273f13f794a9ba326d862970dee78b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T12:59:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na52273f13f794a9ba326d862970dee78b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cumulative rhymes"}}, {"@id": "_:na52273f13f794a9ba326d862970dee78b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In cumulative rhymes a phrase is introduced in one verse and then repeated in subsequent verses, along with the newer phrases introduced in those verses. Each verse grows longer and longer. By the end it can be a real memory challenge to sing the whole thing)"}, "madsrdf:citationSource": "Mama Lisa's world, via WWW, Jan. 5, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:na52273f13f794a9ba326d862970dee78b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"accumulative rhymes\": 534 hits; \"cumulative rhymes\": 1,370 hits)"}, "madsrdf:citationSource": "Google, March 6, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:na52273f13f794a9ba326d862970dee78b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Accumulative rhymes. Scope note: Use for nursery rhymes in which the phrases repeat and build up as the verse progresses)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Jan. 5, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:na52273f13f794a9ba326d862970dee78b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na52273f13f794a9ba326d862970dee78b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Accumulative rhymes"}}, {"@id": "_:na52273f13f794a9ba326d862970dee78b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Accumulative rhymes"}}], "@id": "/authorities/genreForms/gf2014026212"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026213", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCumulative tales", "identifiers:lccn": "gf2014026213", "madsrdf:adminMetadata": [{"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b1"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cumulative tales"}, "madsrdf:elementList": {"@list": [{"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026344"}, "madsrdf:hasSource": [{"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b5"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b6"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b7"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b8"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b9"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b10"}], "madsrdf:hasVariant": [{"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b11"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b14"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b17"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Tales in which the action or dialogue is repeated and built up as the tale progresses."}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T12:59:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cumulative tales"}}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"accumulative tales\": 428 hits; \"cumulative tales\": 6,100 hits)"}, "madsrdf:citationSource": "Google, March 6, 2 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Cumulative Tale. The cumulative tale is a variation on the repetitive tale. In the cumulative tale the action and/or dialogue repeats but also accumulates.)"}, "madsrdf:citationSource": "Cat O'Rushes : a folkloric and literature resource for teachers and librarians, via WWW, Feb. 27, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the accumulative, or clock story; the accumulative tale is the simplest form of the tale. It may be: (1) A tale of simple repetition. (2) A tale of repetition with an addition, incremental iteration. (3) A tale of repetition, with variation.)"}, "madsrdf:citationSource": "Kready, L. A study of fairy tales, via WWW, Feb. 27, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In a cumulative tale, sometimes also called a chain tale, action or dialogue repeats and builds up in some way as the tale progresses.)"}, "madsrdf:citationSource": "Wikipedia, Jan. 15, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Accumulative tales are of very high antiquity. The original of \"the House that Jack Built\" is well known to be an old Hebrew hymn in Sepher Haggadah.)"}, "madsrdf:citationSource": "Halliwell, J. Popular rhymes and nursery tales, via WWW, Feb. 27, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cumulative tales. Here are entered collections of narratives or tales in which the action or dialogue repeats and builds up as the tale progresses. UF Cumulative stories)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Accumulative tales"}}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Accumulative tales"}}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories, Clock"}}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories, Clock"}}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Clock stories"}}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Clock stories"}}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chain tales"}}, {"@id": "_:n87ab96c5d007400ebfda8afae22f8f74b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chain tales"}}], "@id": "/authorities/genreForms/gf2014026213"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026214", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAcrostics (Poetry)", "identifiers:lccn": "gf2014026214", "madsrdf:adminMetadata": [{"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b1"}, {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Acrostics (Poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026588"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026211"}, "madsrdf:hasSource": [{"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b5"}, {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b6"}, {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b7"}], "madsrdf:hasVariant": {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry in which particular letters can be read vertically to reveal a hidden message."}, {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-03T08:25:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Acrostics (Poetry)"}}, {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(acrostic. A poem in which the initial letters of each line can be read down the page to spell either an alphabet, a name (often that of the author, a patron, or a loved one), or some other concealed message. Variant forms of acrostic may use middle letters or final letters of lines or, in prose acrostics, initial letters of sentences or paragraphs.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acrostic. A poem in which a vertical order of a letter in each line, when read downward, spells out a word, often the name of a beloved person, or, in the special case of the abecedarius, spells out the alphabet)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dict. of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "poetry types (Acrostic Poetry is where the first letter of each line spells a word, usually using the same words as in the title)"}, "madsrdf:citationSource": "Shadow poetry website, June 25, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Acrostic poetry"}}, {"@id": "_:nf894c3a1861f429286e6bbf49be7aa47b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Acrostic poetry"}}], "@id": "/authorities/genreForms/gf2014026214"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026215", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aActing editions", "identifiers:lccn": "gf2014026215", "madsrdf:adminMetadata": [{"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb1"}, {"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Acting editions"}, "madsrdf:elementList": {"@list": [{"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb5"}, {"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb6"}], "madsrdf:hasVariant": {"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays with full stage directions that are intended for personnel directly involved in a theatrical production."}, {"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:06:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Acting editions"}}, {"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(acting edition: An edition of a play intended for the use of actors and others directly involved in theater production, which includes fuller stage directions (entrances, exits, stage properties, etc.) than one intended for reading, usually published in limp paper covers and priced lower than other editions of the work. Compare with script.)"}, "madsrdf:citationSource": "Reitz, J.M. Online dictionary for library and information science, Nov. 14, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acting editions. Scope Note: Use for plays with extensive printed production information. UF Acting versions. BT Plays)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Nov. 1, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Acting versions"}}, {"@id": "_:nee4ed43bba204ab784e42646d13f6e0bb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Acting versions"}}], "@id": "/authorities/genreForms/gf2014026215"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026216", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAction and adventure comics", "identifiers:lccn": "gf2014026216", "madsrdf:adminMetadata": [{"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb1"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Action and adventure comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026019"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026058"}], "madsrdf:hasSource": [{"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb5"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb6"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb7"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb8"}], "madsrdf:hasVariant": [{"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb9"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb12"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-13T18:11:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action and adventure comics"}}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Adventure comics differ slightly from superhero comics in that they don't usually entail spandex tights and super powers. They're set in a world closer to our own as far as realism goes, featuring characters closer to Indiana Jones than Superman or Spider-Man. Adventure comics still maintain a sense of the epic, however, as their heroes travel to far-flung locales and battle colorful villains in an effort to keep the world safe.)"}, "madsrdf:citationSource": "Vaux, R. How to make an adventure comic, via WWW, Dec. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (Action/Adventure)"}, "madsrdf:citationSource": "Rothschild, D.A. Graphic novels, 1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Adventure. Adventure comics are the most popular comics to read on the wiki, but definitely not the most popular to make. Subcategories: Epic: Epic comics are those which are about a journey or a saga of some sort, and are (usually) very long, detailed, and popular)"}, "madsrdf:citationSource": "List of Userpedia comic genres, via WWW, Dec. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 135 (Action and adventure; The action and adventure genre in comic books and graphic novels; classic tales of good guys versus bad guys, exotic locations, brave heroes, dastardly villains, and plenty of danger; heroes as rugged adventurers, jungle warriors, cowboys, samurai, spies, fighters, soldiers, and more) pp. 136-192 (subcategories: Prehistoric adventure; Heroic adventure; Adventurers, explorers, and soldiers of fortune; Fists of fury and swords of steel--fighting adventure stories; War stories; Far East adventure--code of the warrior: samurai, ninja, and other Asian influences; Religious heroes; Spies/espionage; Westerns)"}, "madsrdf:citationSource": "Pawuk, M. Graphic novels : a genre guide to comic books, manga, and more, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Action comics"}}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action comics"}}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Adventure comics"}}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Adventure comics"}}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Action-adventure comics"}}, {"@id": "_:nd1d9567ec60f4ea3bca5f2b9713af7dfb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action-adventure comics"}}], "@id": "/authorities/genreForms/gf2014026216"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026217", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAction and adventure fiction", "identifiers:lccn": "gf2014026217", "madsrdf:adminMetadata": [{"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b1"}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Action and adventure fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026551"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026147"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026023"}], "madsrdf:hasSource": [{"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b5"}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b6"}], "madsrdf:hasVariant": [{"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b7"}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b10"}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b13"}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-13T18:11:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action and adventure fiction"}}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Adventure fiction. UFs: Adventure stories, Swashbucklers; use for works characterized by an emphasis on physical and often violent action, exotic locales, and dangers, generally with little character development)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 17 (novels in the Adventure genre are action-packed, feature a hero on a mission, and are often set in exotic locales during times of war and peace; characteristics of adventure: pacing is generally brisk, as the hero escapes from one dangerous episode to the next; the story line focuses on action, usually a mission; there is always an identifiable hero; detailed settings are important, generally 'elsewhere', i.e. foreign)"}, "madsrdf:citationSource": "Saricks, J. Readers' advisory guide to genre fiction, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Adventure fiction"}}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Adventure fiction"}}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Swashbucklers (Fiction)"}}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Swashbucklers (Fiction)"}}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Swashbuckler fiction"}}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Swashbuckler fiction"}}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Action fiction"}}, {"@id": "_:n897df7b56a3b4181b3fd58ad26a7f546b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action fiction"}}], "@id": "/authorities/genreForms/gf2014026217"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026218", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAllegories", "identifiers:lccn": "gf2014026218", "madsrdf:adminMetadata": [{"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b1"}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Allegories"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026233"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026239"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026442"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026467"}, "madsrdf:hasSource": [{"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b5"}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b6"}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b7"}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b8"}], "madsrdf:hasVariant": {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-31T10:15:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Allegories"}}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(allegory: A story, poem, or picture which can be interpreted to reveal a hidden meaning, typically a moral or political one. The word comes (in late Middle English) via Old French and Latin from Greek all\u0113goria, from allos 'other' + -agoria 'speaking')"}, "madsrdf:citationSource": "Oxford dictionary of phrase and fable, via Oxford reference online, Dec. 15, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(allegory: as a rule an allegory is a story in verse or prose with a double meaning: a primary or surface meaning; and a secondary or under-the-surface meaning; closely related to the fable and the parable)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(allegory: a story in which the characters and events are symbols that stand for ideas about human life or for a political or historical situation)"}, "madsrdf:citationSource": "Merriam-Webster online, March 6, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(allegory: a story or visual image with a second distinct meaning partially hidden behind its literal or visible meaning. The principal technique of allegory is personification, whereby abstract qualities are given human shape; an allegory may be conceived as a metaphor that is extended into a structured system. In written narrative, allegory involves a continuous parallel between two (or more) levels of meaning in a story, so that the persons and events correspond to their equivalents in a system of ideas or a chain of events external to the tale: each character and episode in John Bunyan's The Pilgrim's Progress (1678), for example, embodies an idea within a pre-existing Puritan doctrine of salvation)"}, "madsrdf:citationSource": "Baldick, C. Oxford dictionary of literary terms, via Oxford reference online, Dec. 15, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Allegorical literature"}}, {"@id": "_:nd40d39dccf9e4a6c985e2e7e599f03a5b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Allegorical literature"}}], "@id": "/authorities/genreForms/gf2014026218"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026219", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlphabet rhymes", "identifiers:lccn": "gf2014026219", "madsrdf:adminMetadata": [{"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b1"}, {"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Alphabet rhymes"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026459"}, "madsrdf:hasSource": [{"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b5"}, {"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b6"}], "madsrdf:hasVariant": {"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-13T18:11:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alphabet rhymes"}}, {"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alphabet rhymes. Scope note: Use for works consisting of short rhymes for teaching the alphabet; broader term: poems)"}, "madsrdf:citationSource": "Genre terms: a thesaurus for use in rare book and special collections cataloging, via the Rare Books and Manuscripts Section website, Jan. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alphabet rhyme, mnemonic verse, or song used to help children learn an alphabet; such devices appear in almost every alphabetic language. Some of the early English favourites are about 300 years old and have served as models for countless variations)"}, "madsrdf:citationSource": "Britannica Academic Edition online, Jan. 5, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rhyming alphabets"}}, {"@id": "_:n7ed90fdda97a4fc3b95f9ad2c77808a7b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rhyming alphabets"}}], "@id": "/authorities/genreForms/gf2014026219"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026220", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlternative histories (Fiction)", "identifiers:lccn": "gf2014026220", "madsrdf:adminMetadata": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b1"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Alternative histories (Fiction)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b3"}]}, "madsrdf:exampleNote": "Note under [Counterfactual histories]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b5"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b6"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b7"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b8"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b9"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b10"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b11"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b12"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b13"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b14"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b15"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b16"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b17"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b18"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b19"}], "madsrdf:hasVariant": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b20"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b23"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b26"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b29"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b32"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b35"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b38"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b41"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b44"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b47"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b50"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction in which the plot or setting assumes an alternative outcome of an historical event. For nonfiction that presents alternative outcomes of historical events and subsequent changes in history see [Counterfactual histories.]"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:13:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative histories (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Subtitle on cover: Where would we be today : a novel)"}, "madsrdf:citationSource": "Moore, P.N. What if Hitler won the war?, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 214 (Allohistorical fiction deals with the question of what might have been. It explores alternative histories in which the Reformation did not take place, or Hitler died as a young man, or the Axis Powers won World War II)"}, "madsrdf:citationSource": "The fantastic other, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Use for works featuring key changes in historical facts.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternate History (sometimes abbreviated AH) is the most frequently used term for the fictional genre which often presupposes a change of a minor historical event that produces an incredible series of changes in the world, diverging it from Our Timeline (OTL) and creating a new, alternate and parallel world. Other terms used include alternative history, allohistory and uchronie.)"}, "madsrdf:citationSource": "Alternative history : what is althistory?, via Althistory wiki, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 162-164 (Alternate history; what-if fiction; alternate history novels and short stories; what-if scenarios)"}, "madsrdf:citationSource": "Roese, N.J. If only, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 85 (uchronic fiction)"}, "madsrdf:citationSource": "Monsters in the mirror, \u00a92010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a novel)"}, "madsrdf:citationSource": "Blumetti, R. The lion is humbled : what if Germany defeated Britain in 1940?, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternative histories (Fiction), UF Alternate histories (Fiction). BT Fiction)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hit counts: Alternative histories: 132,000; Allohistorical fiction: 320; Alt-history fiction: 5,480; Alternate history fiction: 12,800; Alternative history fiction: 6,420; Uchronian fiction: 365; Uchronic fiction: 141; what-if fiction: 6,470; What ifs AND fiction: 295,000)"}, "madsrdf:citationSource": "Google, Nov. 7, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Alternate History (A type of Speculative Fiction (sometimes called \"Uchronia\" or \"Anachronism\") set in a world where one or more historical events unfolded differently than they did in the real world. Often set some time after the event (called a \"point of divergence\", or PoD, by fans of the genre), such stories typically describe a Present Day world vastly changed by the difference, or follow another major historical event in light of the change. Sometimes linked with a Time Travel story--the point of divergence is often caused by travelers from \"our\" timeline (OTL in Alt-history parlance) seeking to effect a desired change. ... The setting of an alternate history is often described as a What If?; The genre has become increasingly popular since the late 20th century, perhaps because it was a tumultuous century rich in \"what if\" opportunities; Philip K. Dick's The Man in the High Castle, a Germans-Win-WWII story, is a seminal work in the genre) What If? (A Super Trope to Alternate Universe and Elseworld, \"What If?\" stories do to fictional Continuity what Alternate History does to Real Life history. The purpose of a what-if is to consider what effects might be caused if some event or invention had come about.)"}, "madsrdf:citationSource": "TV tropes website, Sept. 2, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Alternate history (Alternate history or alternative reality is a genre of fiction consisting of stories that are set in worlds in which one or more historical events unfolds differently from how it did in this reality. It can be variously seen as a sub-genre of literary fiction, science fiction, and historical fiction; different alternate history works may use tropes from any or all of these genres. It is sometimes abbreviated AH. Another occasionally used term for the genre is \"allohistory\" (literally \"other history\")) Uchronia (Uchronia refers to a hypothetical or fictional time-period of our world, in contrast to altogether fictional lands or worlds. A concept similar to alternate history but different in the manner that uchronic times are not easily defined (mainly placed in some distant or unspecified point before current times), sometimes reminiscent of a constructed world. Some, however, do use uchronia to refer to an alternate history)"}, "madsrdf:citationSource": "Wikipedia, Aug. 5, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 161 (alt-history fiction relates imagined worlds wherein a point of divergence acts as a fulcrum for a host of potential alternate responses or results. That is, alt-history fiction relies on readers' shared, experiential history (usually global) in the telling of an alternative to that history)"}, "madsrdf:citationSource": "Scotland as science fiction, \u00a92012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 102 (uchronian fiction)"}, "madsrdf:citationSource": "Wesseling, E. Writing history as a prophet, 1991:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 204 (uchronian fiction; alternative histories)"}, "madsrdf:citationSource": "International postmodernism, \u00a91997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternative history genre: for fiction works which speculate on what could have happened if a significant historical event had gone differently.)"}, "madsrdf:citationSource": "Goodreads.com, Oct. 29, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternate history fiction"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternate history fiction"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "What ifs (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "What ifs (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternative history fiction"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative history fiction"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "What if fiction"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "What if fiction"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alt-history fiction"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alt-history fiction"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternate histories (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternate histories (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b38", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b39"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Uchronies (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b39", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Uchronies (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b41", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b42"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Allohistories (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b42", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Allohistories (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b44", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b45"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Histories, Alternative (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b45", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Histories, Alternative (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b47", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b48"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternative realities (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b48", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative realities (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b50", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b51"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Uchronias (Fiction)"}}, {"@id": "_:n1bf6e7a432f04b6b86491b813a592f58b51", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Uchronias (Fiction)"}}], "@id": "/authorities/genreForms/gf2014026220"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026221", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnacreontic poetry", "identifiers:lccn": "gf2014026221", "madsrdf:adminMetadata": [{"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b1"}, {"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Anacreontic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b5"}, {"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b6"}, {"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Light and cheerful poems written in the style of the Greek poet Anacreon and characterized by an erotic, amorous, or Bacchanalian spirit."}, {"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:06:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anacreontic poetry"}}, {"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anacreontic verse: Verse in praise of wine, women, and Epicurean pleasures generally, after the manner of Anacreon, sixth-century-B.C. Greek poet.)"}, "madsrdf:citationSource": "Beckson, K. Literary terms, 1989", "madsrdf:citationStatus": "found"}, {"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anacreontic poetry: Verse in the mood and manner of the lyrics of the Greek poet Anacreon; that is, poems characterized by an erotic, amatory, or Bacchanalian spirit. The characteristic Anacreontic lines consist of a pyrrhic foot, two trochees, and a spondee, for which the nearest regular English counterpart would be trochaic tetrameter.)"}, "madsrdf:citationSource": "Harmon, J. A handbook to literature, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:ndbc6a8d9b7604af1b1fb024abc125fd5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anacreontic poetry as a genre originates with the Greek lyric poet Anacreon, a native of the Aegean island of Teos, who lived from ca. 570 B.C. until ca. 480 B.C. Anacreon's style was widely imitated by Greek poets in antiquity, but also, from the mid-sixteenth century onwards, by a great many European poets who re-developed the genre in various ways.)"}, "madsrdf:citationSource": "Literary encyclopedia online, Jan. 5, 2013", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026221"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026222", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAntimasques", "identifiers:lccn": "gf2014026222", "madsrdf:adminMetadata": [{"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b1"}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Antimasques"}, "madsrdf:elementList": {"@list": [{"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026335"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026428"}, "madsrdf:hasSource": [{"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b5"}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b6"}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b7"}], "madsrdf:hasVariant": [{"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b8"}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b11"}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Farcical scenes presented as burlesque preludes or interludes to masques."}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Antimasques"}}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(masque: In the Renaissance, an elaborate entertainment that combined drama, poetry, and music. The structure of the masque centered on the dancing of a group of elaborately costumed members of the aristocracy whose movement, interspersed with poetry and song, enacted the \"plot.\" Their appearance was preceded by an \"antimasque,\" in which professional performers would enact scenes of disorder and ribaldry. These performers would then be banished by a verse announcing the arrival of the masquers)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anti-masque. A comic and grotesque piece of clowning that sometimes preceded the performance of a masque (hence the alternative spelling, antemasque). Ben Jonson introduced this farcical prelude to some of his masques from 1609 onwards, using it as a kind of burlesque of the main action.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anti-masque. It took the form of either a buffoonish and grotesque episode before the main masque or an interlude, similarly farcical, during it. When performed beforehand, it was known as an ante-masque. One form of it was a burlesque of the masque itself, in which case it had some affinity with the Greek satyr play.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dict. of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anti-masques"}}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anti-masques"}}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Antemasques"}}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Antemasques"}}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ante-masques"}}, {"@id": "_:n709cbb1cd5184e82b0ae9cb5a3cfee89b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ante-masques"}}], "@id": "/authorities/genreForms/gf2014026222"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026223", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAntinovels", "identifiers:lccn": "gf2014026223", "madsrdf:adminMetadata": [{"@id": "_:nce5ecfc32e38405896a86922477f8167b1"}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Antinovels"}, "madsrdf:elementList": {"@list": [{"@id": "_:nce5ecfc32e38405896a86922477f8167b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026325"}, "madsrdf:hasSource": [{"@id": "_:nce5ecfc32e38405896a86922477f8167b5"}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b6"}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b7"}], "madsrdf:hasVariant": [{"@id": "_:nce5ecfc32e38405896a86922477f8167b8"}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that avoids elements such as plot, dialogue, and character, and focuses instead on sheer perception."}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:07:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Antinovels"}}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 105 (Robbe-Grillet's nouveau romans)"}, "madsrdf:citationSource": "Analecta Husserliana, vol. CI, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "anti-novel (A form of experimental fiction that dispenses with certain traditional elements of novel-writing like the analysis of characters' states of mind or the unfolding of a sequential plot; the term is usually associated with the French nouveau roman) nouveau roman (The French term ('new novel') applied since the mid-1950s to experimental novels by a group of French writers who rejected many of the traditional elements of novel-writing, such as the sequential plot and the analysis of characters' motives)"}, "madsrdf:citationSource": "Oxford dictionary of literary terms,via Oxford reference online, Nov. 8, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anti-novel: the movement away from the traditional novel form in France in the form of the nouveau roman tends to an ideal that may be called the anti-novel--a work of the fictional imagination that ignores such properties as plot, dialogue, human interest; individual character is not important, and consciousness dissolves into sheer \"perception\"; even time is reversible, since perceptions have nothing to do with chronology; New novel: French nouveau roman, also called antinovel)"}, "madsrdf:citationSource": "Britannica online academic edition, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nce5ecfc32e38405896a86922477f8167b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nouveaux romans"}}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nouveaux romans"}}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nce5ecfc32e38405896a86922477f8167b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anti-novels"}}, {"@id": "_:nce5ecfc32e38405896a86922477f8167b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anti-novels"}}], "@id": "/authorities/genreForms/gf2014026223"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026224", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aApocalyptic comics", "identifiers:lccn": "gf2014026224", "madsrdf:adminMetadata": [{"@id": "_:n75a07e03cb7748319a81fdb623684161b1"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Apocalyptic comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n75a07e03cb7748319a81fdb623684161b3"}]}, "madsrdf:exampleNote": "Note under [Dystopian comics]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026530"}, "madsrdf:hasSource": [{"@id": "_:n75a07e03cb7748319a81fdb623684161b5"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b6"}], "madsrdf:hasVariant": [{"@id": "_:n75a07e03cb7748319a81fdb623684161b7"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b10"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b13"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b16"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b19"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics set in a world or civilization after a catastrophic event (e.g., nuclear war, an alien invasion), sometimes also including the period immediately preceding the event. For comics set in an uncertain future, in a society ruled by an ineffectual, corrupt, or oppressive regime or by aliens, robots, etc., see [Dystopian comics.]"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:12:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Apocalyptic comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Chapter 3--Science Fiction, p. 245 (Post-Apocalypse. This subgenre examines what life would be like if a planet wide disaster struck Earth. In the tales there may be an ecological change, civilization may nearly be made extinct, and strange life-forms may now inhabit Earth. The subgenre is closely related to dystopian science fiction, but goes one step further by showcasing the entire collapse of society following a nuclear holocaust or other devastating event.)"}, "madsrdf:citationSource": "Pawuk, M. Graphic novels : a genre guide to comic books, manga, and more, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Apocalyptic films. This heading is used as a genre/form heading for films set in a world or civilization after a catastrophic event (e.g., nuclear war, an alien invasion), sometimes also including the period immediately preceding the event. Films set in an uncertain future, in a society ruled by an ineffectual, corrupt, or oppressive regime or by aliens, robots, etc., are entered under Dystopian films. UF Doomsday films; End-of-the-world films; Post-apocalyptic films; Post-apocalyptic science fiction films; Postapocalyptic films; Postapocalyptic science fiction films)"}, "madsrdf:citationSource": "LCGFT, Oct. 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n75a07e03cb7748319a81fdb623684161b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Postapocalyptic science fiction comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Postapocalyptic science fiction comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n75a07e03cb7748319a81fdb623684161b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Post-apocalyptic comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Post-apocalyptic comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n75a07e03cb7748319a81fdb623684161b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Post-apocalyptic science fiction comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Post-apocalyptic science fiction comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n75a07e03cb7748319a81fdb623684161b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Doomsday comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Doomsday comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n75a07e03cb7748319a81fdb623684161b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Postapocalyptic comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Postapocalyptic comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n75a07e03cb7748319a81fdb623684161b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "End-of-the-world comics"}}, {"@id": "_:n75a07e03cb7748319a81fdb623684161b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "End-of-the-world comics"}}], "@id": "/authorities/genreForms/gf2014026224"}
