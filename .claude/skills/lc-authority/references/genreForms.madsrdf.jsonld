{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026501", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aReligious drama", "identifiers:lccn": "gf2014026501", "madsrdf:adminMetadata": [{"@id": "_:n8e748c5970d4468d88531f6e7701d9e0b1"}, {"@id": "_:n8e748c5970d4468d88531f6e7701d9e0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Religious drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8e748c5970d4468d88531f6e7701d9e0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026233"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026241"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026251"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026322"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026436"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026442"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026446"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026567"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026035"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026062"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026063"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026006"}], "madsrdf:hasSource": [{"@id": "_:n8e748c5970d4468d88531f6e7701d9e0b5"}, {"@id": "_:n8e748c5970d4468d88531f6e7701d9e0b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8e748c5970d4468d88531f6e7701d9e0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-13T18:11:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8e748c5970d4468d88531f6e7701d9e0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8e748c5970d4468d88531f6e7701d9e0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Religious drama"}}, {"@id": "_:n8e748c5970d4468d88531f6e7701d9e0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Religious drama. BT Drama)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e748c5970d4468d88531f6e7701d9e0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Religious drama; religious plays; plays on religious themes; religious subjects; with the disappearance of the medieval liturgical drama, religion as a subject for plays was, with rare exceptions, replaced on the English stage by classical history and mythology and plots drawn from contemporary life. It came back tentatively in the late 19th century, when professional dramatists began to include religion and the clergy in serious plays of contemporary life. Meanwhile the Biblical 'spectacular', of which Wilson Barrett's The Sign of the Cross (1895) is typical, was also popular until taken over by the cinema.)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026501"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026502", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aReligious fiction", "identifiers:lccn": "gf2014026502", "madsrdf:adminMetadata": [{"@id": "_:nae63473f651940e5ab4bb9e15be7603ab1"}, {"@id": "_:nae63473f651940e5ab4bb9e15be7603ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Religious fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nae63473f651940e5ab4bb9e15be7603ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026012"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026138"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026139"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026050"}], "madsrdf:hasSource": [{"@id": "_:nae63473f651940e5ab4bb9e15be7603ab5"}, {"@id": "_:nae63473f651940e5ab4bb9e15be7603ab6"}, {"@id": "_:nae63473f651940e5ab4bb9e15be7603ab7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nae63473f651940e5ab4bb9e15be7603ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nae63473f651940e5ab4bb9e15be7603ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nae63473f651940e5ab4bb9e15be7603ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Religious fiction"}}, {"@id": "_:nae63473f651940e5ab4bb9e15be7603ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(in titles: religious fiction; religious fiction in America; best selling religious fiction, 1900-1953; religious fiction of Georges Bernanos; five Victorian authors and their religious fiction; best religious stories; a religious novel; the religious novel, 1925-1949; the religious novel in the early nineteenth century)"}, "madsrdf:citationSource": "OCLC, July 18, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nae63473f651940e5ab4bb9e15be7603ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Religious fiction)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nae63473f651940e5ab4bb9e15be7603ab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008;Kennedy, X.J. The Longman dictionary of literary terms, c2006;Cuddon, J. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "notfound"}], "@id": "/authorities/genreForms/gf2014026502"}
