": {"@type": "xsd:dateTime", "@value": "2019-07-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "revised"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Genderqueer comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel about gender identity, queer and transgender life)"}, "madsrdf:citationSource": "Mady G. A quick & easy guide to queer and trans identities, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Started as a way to explain to eir family what it means to be nonbinary and asexual, Gender Queer is more than a personal story: it is a useful and touching guide on gender identity)"}, "madsrdf:citationSource": "Kobabe, M. Gender queer : a memoir, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(genderfluid comics)"}, "madsrdf:citationSource": "Muo, C. 15 comics for anyone struggling to explain what it means to be queer, Mar. 11, 2014, via BuzzFeed website, viewed Jul. 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Krazy Kat, the first gender-fluid comics character, via Karen Green Twitter website, posted Oct. 22, 2018, viewed Jul. 8, 2019.", "madsrdf:citationStatus": "found"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: first ever non-binary comics anthology)"}, "madsrdf:citationSource": "Gil, J. Heartwood : non-binary tales of Sylvan fantasy, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(gender variant comics)"}, "madsrdf:citationSource": "Rooster tails : a New Zealand transman comic blog, Jul. 19, 2012, via Genderqueer Australia website, viewed Jul. 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nonbinary comics; comics featuring nonbinary characters)"}, "madsrdf:citationSource": "Finn, C. The ComicsAlliance guide to great comics for trans and nb youth, Nov. 17, 2016, via ComicsAlliance website, viewed Jul. 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Three small zines, each about 3 inches square, each collecting 6 of the comics from my \"Genderqueer\" series\")"}, "madsrdf:citationSource": "Work cat: Kobabe, M. Genderqueer comics, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(searched for numbers of hits for terminology suggested by the other citations, with the understanding that the hits may refer to persons as well as to publications; genderqueer comics: 3,550 hits; gender-creative comics: 1 hit (for LCSH tentative list); gender-fluid comics: 141 hits; gender independent comics: 6 hits; gender-nonconforming comics: 110 hits; gender-non-normative comics: 1 hit (for LCSH tentative list); gender-queer comics: 3,550 hits; gender-variant comics: 5 hits; genderfluid comics: 574 hits; non-binary comics: 3,410 hits; nonbinary comics: 2,710 hits)"}, "madsrdf:citationSource": "Google, Sept. 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gender-nonconforming people. UF Gender-creative people; Gender-independent people; Gender-non-normative people; Gender-variant people; Genderqueer people; Non-binary people)"}, "madsrdf:citationSource": "LCSH, viewed Jul. 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gender-fluid comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gender-fluid comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Genderfluid comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Genderfluid comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gender-queer comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gender-queer comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nonbinary comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonbinary comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Non-binary comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Non-binary comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gender-nonconforming comics"}}, {"@id": "_:n792e84bc4cef4ed3ac0e2167f0e22e81b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gender-nonconforming comics"}}], "@id": "/authorities/genreForms/gf2019026102"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026103", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEditorial cartoons", "identifiers:lccn": "gf2019026103", "madsrdf:adminMetadata": [{"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb1"}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Editorial cartoons"}, "madsrdf:elementList": {"@list": [{"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027225"}, "madsrdf:hasSource": [{"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb5"}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb6"}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb7"}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb8"}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-04T13:40:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Editorial cartoons"}}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Newspaper editorial cartoons are graphic expressions of their creator's ideas and opinions. In addition, the editorial cartoon usually, but not always, reflects the publication's viewpoint. Editorial cartoons are based on current events. That means that they are produced under restricted time conditions in order to meet publication deadlines (often 5 or 6 per week). Editorial cartoons, like written editorials, have an educational purpose. They are intended to make readers think about current political issues. Editorial cartoons differ from comic strips. Editorial cartoons appear on the newspaper's editorial or front page, not on the comics page. They usually employ a single-panel format and do not feature continuing characters in the way that comic strips do. Editorial cartoons are sometimes referred to as political cartoons, because they often deal with political issues.)"}, "madsrdf:citationSource": "Editorial cartoons : an introduction, via Ohio State University History Teaching Institute website, July 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Nazi Germany as reflected in American caricatures 1933-1945 : editorial cartoons by Pulitzer Prize winners, 2018.", "madsrdf:citationStatus": "found"}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Editorial cartoons. SN Cartoons offering political commentary or social protest and made for publication in a newspaper or periodical. BT Cartoons (Commentary); Periodical illustrations. RT Political cartoons)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, July 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Editorial cartoons. UF Cartoons, Editorial. BT Caricatures and cartoons; Editorials; Wit and humor, Pictorial)"}, "madsrdf:citationSource": "LCSH, July 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n93ea4469e4134ba0b7d0112923cdc18eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(editorial cartoons. SN Cartoons that express editorial opinions, usually by appearing on the editorial pages of a newspaper or periodical. BT cartoons (humorous images); also has heading political cartoons as NT under cartoons (humorous images))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 8, 2019", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026103"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026104", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMonster comics", "identifiers:lccn": "gf2019026104", "madsrdf:adminMetadata": [{"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b1"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Monster comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026021"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026037"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026039"}], "madsrdf:hasSource": [{"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b5"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b6"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b7"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b8"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b9"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-04T13:40:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monster comics"}}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(1. Ge Ge Ge no Kitaro; 2. Hellboy; 3. Saga of the Swamp Thing; 4. Strange Tales/Tales to Astonish/Journey into Mystery/Tales of Suspense/Amazing Fantasy; 5. The Goon; 6. Man-Thing; 7. Criminal Macabre; 8. Baltimore: The Curse Bells; 9. High Moon; 10. Werewolf by Night)"}, "madsrdf:citationSource": "Elkin, D. Top 10 monster comics, via Comics bulletin website, posted Apr. 17, 2012, viewed on July 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 66 (monster comics; Marvel monster comics of the 1950s and early 1960s; the Marvel monster genre) p. 69 (Marvel's monster comics)"}, "madsrdf:citationSource": "Marvel Comics into film, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel collecting stories about Kitaro, a three hundred and fifty year old yokai, a spirit monster)"}, "madsrdf:citationSource": "Work cat.: Mizuki, S. Kitaro, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(GeGeGe no Kitar\u014d, originally known as Kitar\u014d of the Graveyard (Hakaba Kitar\u014d), is a Japanese manga series created in 1960 by Shigeru Mizuki; known for its popularization of the folklore creatures known as y\u014dkai, a class of spirit-monster to which all of the main characters belong; many storylines involve Kitar\u014d facing off with myriad monsters from other countries, such as the Chinese vampire Yasha, the Transylvanian Dracula IV, and other such non-Japanese creations. In addition to this, Kitar\u014d also locks heads with various malevolent Y\u014dkai who threaten the balance between the Japanese creatures and humans)"}, "madsrdf:citationSource": "Wikipedia, July 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. 339 (old-time horror comics and monster comics)"}, "madsrdf:citationSource": "Icons of the American comic book, \u00a92013:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf070b077be7e4e80b17a82597c8e4e52b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beginning with the legendary E.C. Comics horror titles from the 1940s and '50s, vampires, zombies, demons, and all other types of creepy creatures have made a major impact on the storytelling medium; 1. Swamp Thing; 2. Bernie Wrightson's Frankenstein; 3. Killer Croc; 4. Solomon Grundy; 5. Man-Thing; 6. Violator; 7. Etrigan; 8. Sadu-Hem; 9. Morbius, the Living Vampire; 10. The Zombie; 11. Tales from the Crypt Zombie; 12. Werewolf by Night; 13. Man-Bat; 14. Fin Fang Foom; 15. Vermin)"}, "madsrdf:citationSource": "Serafino, J. The 15 scariest monsters in comic books, via Complex website, Oct. 31, 2012, viewed on July 8, 2019", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026104"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026106", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBisexual drama", "identifiers:lccn": "gf2019026106", "madsrdf:adminMetadata": [{"@id": "_:nccfc4ba2251547ab99005156a3b126c4b1"}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bisexual drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:nccfc4ba2251547ab99005156a3b126c4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:nccfc4ba2251547ab99005156a3b126c4b5"}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b6"}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b7"}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b8"}], "madsrdf:hasVariant": {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Drama featuring bisexual characters or addressing bisexual themes."}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "revised"}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bisexual drama"}}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a drama about a bisexual woman) p. 4 of cover (\"Adele, hard at work on a large triptych, looks back on the two major loves of her life, which somehow managed to provide her with everything she needed to know about the art of living. Through these two tumultuous loves, Adele discovered both the limits of her powers and the true depths of her gifts. The road to redemption remains before her with the return of both loves to her side.\")"}, "madsrdf:citationSource": "Work cat.: Lucas, C. Ode to joy, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: When John takes a break from his boyfriend, his accidentally meets the girl of his dreams. Filled with guilt and indecision, he decides there is only one way to straighten this out ... Mike Bartlett's metrosexual play about love and longing provides us with questions of who we are and who we want to be)"}, "madsrdf:citationSource": "Bartlett, M. Cock, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: The central character is a boy traumatized by male rape. During follow-up counselling, he explores his bisexual nature)"}, "madsrdf:citationSource": "Krummeck, P. iVirgin boy, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Writer-director Craig Lucas shakes up the Rattlestick with a portrait of a bisexual painter and her two lovers; Writer-director Craig Lucas tracks Adele over 14 years and two rocky affairs--one with a hard-partying [male] surgeon, the other with an [woman] executive with a bad ticker)"}, "madsrdf:citationSource": "Ode to joy review, via TimeOut New York website, posted Feb. 27, 2014, viewed on July 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nccfc4ba2251547ab99005156a3b126c4b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bi drama"}}, {"@id": "_:nccfc4ba2251547ab99005156a3b126c4b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bi drama"}}], "@id": "/authorities/genreForms/gf2019026106"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026107", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBook of Mormon comics", "identifiers:lccn": "gf2019026107", "madsrdf:adminMetadata": [{"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b1"}, {"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Book of Mormon comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026500"}, "madsrdf:hasSource": [{"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b5"}, {"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b6"}, {"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics depicting characters, events, etc., from the Book of Mormon."}, {"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-04T13:40:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Book of Mormon comics"}}, {"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic novel)"}, "madsrdf:citationSource": "Carter, Stephen. IPlates : pure Book of Mormon awesomeness. Zerin's sacrifice, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a comic book)"}, "madsrdf:citationSource": "Peery, Corey. Book of Mormon heroes. Nephi : his reign and ministry, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:n3bb4a0f5a7284425bb78b643ff4c6941b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(multi-part graphic novel)"}, "madsrdf:citationSource": "Allred, Mike. The golden plates : the Book of Mormon in pictures and word, \u00a92004-", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026107"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026108", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPassover fiction", "identifiers:lccn": "gf2019026108", "madsrdf:adminMetadata": [{"@id": "_:n2162564a823d422eb8ac715db113d661b1"}, {"@id": "_:n2162564a823d422eb8ac715db113d661b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Passover fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2162564a823d422eb8ac715db113d661b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n2162564a823d422eb8ac715db113d661b5"}, {"@id": "_:n2162564a823d422eb8ac715db113d661b6"}, {"@id": "_:n2162564a823d422eb8ac715db113d661b7"}, {"@id": "_:n2162564a823d422eb8ac715db113d661b8"}, {"@id": "_:n2162564a823d422eb8ac715db113d661b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2162564a823d422eb8ac715db113d661b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-04T13:40:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2162564a823d422eb8ac715db113d661b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2162564a823d422eb8ac715db113d661b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Passover fiction"}}, {"@id": "_:n2162564a823d422eb8ac715db113d661b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: A young girl and her relatives celebrate Passover with the traditional seder, a dinner with special foods and special meaning)"}, "madsrdf:citationSource": "Schotter, R. Passover magic, \u00a91995", "madsrdf:citationStatus": "found"}, {"@id": "_:n2162564a823d422eb8ac715db113d661b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: cumulative rhyme in the style of \"The House That Jack Built\" describes the traditions connected to a family's celebration of the Passover seder)"}, "madsrdf:citationSource": "Manushkin, F. The matzah that Papa brought home, \u00a91995", "madsrdf:citationStatus": "found"}, {"@id": "_:n2162564a823d422eb8ac715db113d661b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: After her parents' divorce, a young girl experiences a variety of Passover seders)"}, "madsrdf:citationSource": "Portnoy, M.A. A tale of two seders, \u00a92010", "madsrdf:citationStatus": "found"}, {"@id": "_:n2162564a823d422eb8ac715db113d661b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Strauss, L.L. The Elijah door : a Passover tale, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2162564a823d422eb8ac715db113d661b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: As a Confederate family prepares for Passover the day after the Civil War has ended, a Yankee arrives on their Virginia doorstep and is invited to share their meal, to the dismay of ten-year-old Jacob)"}, "madsrdf:citationSource": "Weber, E. The Yankee at the seder, \u00a92009", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2019026108"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026109", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAvadana stories", "identifiers:lccn": "gf2019026109", "madsrdf:adminMetadata": [{"@id": "_:n76a4e8c629c74d259c4b76735a73e108b1"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Avadana stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n76a4e8c629c74d259c4b76735a73e108b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026049"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}], "madsrdf:hasSource": [{"@id": "_:n76a4e8c629c74d259c4b76735a73e108b5"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b6"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b7"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b8"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b9"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b10"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b11"}], "madsrdf:hasVariant": [{"@id": "_:n76a4e8c629c74d259c4b76735a73e108b12"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b15"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b18"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b21"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b24"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b27"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b30"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Stories that are usually narrated by the Buddha and that identify characters in the past as former births of characters in the present."}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-21T12:35:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Avadana stories"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sarkar, S. Studies in the common J\u0101taka and Avad\u0101na tales, 1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Avad\u0101na (Avad\u0101na, Buddhist literature; legendary material centring on the Buddha's explanations of events by a person's worthy deeds in a previous life; P\u0101li cognate is Apad\u0101na; Avad\u0101na designates both the class of such stories scattered within the Vinaya Pi\u1e6daka (\"Basket of Discipline\") and separate collections based upon them)"}, "madsrdf:citationSource": "Britannica online, July 15, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Avad\u0101na (in Sanskrit; apad\u0101na in Pali); name for a general type of Buddhist narrative, and the generic name given to many individual narratives and narrative collections)"}, "madsrdf:citationSource": "Fiordalis, D. Avad\u0101na, 2017, via Oxford bibliographies website, July 15, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Avad\u00e2na-\u00e7ataka : cent l\u00e9gendes bouddhiques : la centaine d'Avad\u00e2nas, 1979.", "madsrdf:citationStatus": "found"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Tatelman, J. The glorious deeds of P\u016br\u1e47a : a translation and study of the P\u016br\u1e47\u0101vad\u0101na, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, jkt. (The \"Divyavadana,\" or Heavenly Exploits, is a collection of thirty-eight Buddhist biographical stories. The genre of narratives of an individual's religiously significant deeds is as old as Buddhism, and its manifestations are as widely spread across Buddhist Asia, in classical and vernacular languages, down to the present day)"}, "madsrdf:citationSource": "The heavenly exploits, 2005- :", "madsrdf:citationStatus": "found"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Avadana (Avad\u0101na; avad\u0101na stories; genre of Buddhist literature; denotes a narrative of an individual's religiously significant deeds. Often these narratives constitute full-fledged religious biographies, sometimes of eminent monastics, sometimes of ordinary lay disciples; range from formulaic tales that simply dramatize the workings of karma (action) and the efficacy of faith and devotion, to fantastical adventure stories, to the sophisticated art of virtuosi poets; consist of a story of the present, a story of the past, and a juncture in which the narrator, always the Buddha or another enlightened saint, identifies characters in the past as former births of characters in the present. For the story of the past, some avad\u0101nas substitute a prediction of the protagonist's spiritual destiny)"}, "madsrdf:citationSource": "Encyclopedia of Buddhism, c2004, via Encyclopedia.com, viewed July 15, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n76a4e8c629c74d259c4b76735a73e108b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Avadana tales"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Avadana tales"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n76a4e8c629c74d259c4b76735a73e108b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Apadana tales"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Apadana tales"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n76a4e8c629c74d259c4b76735a73e108b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tales, Avadana"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tales, Avadana"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n76a4e8c629c74d259c4b76735a73e108b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tales, Apadana"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tales, Apadana"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n76a4e8c629c74d259c4b76735a73e108b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories, Apadana"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories, Apadana"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n76a4e8c629c74d259c4b76735a73e108b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories, Avadana"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories, Avadana"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n76a4e8c629c74d259c4b76735a73e108b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Apadana stories"}}, {"@id": "_:n76a4e8c629c74d259c4b76735a73e108b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Apadana stories"}}], "@id": "/authorities/genreForms/gf2019026109"}
