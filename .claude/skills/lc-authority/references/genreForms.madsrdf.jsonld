Form", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television reviews"}}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television reviews"}}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television programme criticism"}}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television programme criticism"}}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "TV criticism"}}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "TV criticism"}}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Criticism, Television program"}}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Criticism, Television program"}}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television program criticism"}}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television program criticism"}}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reviews, Television program"}}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reviews, Television program"}}], "@id": "/authorities/genreForms/gf2021026032"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026034", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRisographs", "identifiers:lccn": "gf2021026034", "madsrdf:adminMetadata": [{"@id": "_:n8d07356534544324ace9145973dc9335b1"}, {"@id": "_:n8d07356534544324ace9145973dc9335b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Risographs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8d07356534544324ace9145973dc9335b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027255"}, "madsrdf:hasSource": [{"@id": "_:n8d07356534544324ace9145973dc9335b5"}, {"@id": "_:n8d07356534544324ace9145973dc9335b6"}, {"@id": "_:n8d07356534544324ace9145973dc9335b7"}, {"@id": "_:n8d07356534544324ace9145973dc9335b8"}, {"@id": "_:n8d07356534544324ace9145973dc9335b9"}, {"@id": "_:n8d07356534544324ace9145973dc9335b10"}], "madsrdf:historyNote": "[Established September 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Digital prints produced by piercing a printing stencil plate with holes and passing ink through the holes to transfer an image onto paper."}, {"@id": "_:n8d07356534544324ace9145973dc9335b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-07T10:19:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8d07356534544324ace9145973dc9335b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-07-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/nnmm"}, "ri:recordStatus": "new"}, {"@id": "_:n8d07356534544324ace9145973dc9335b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Risographs"}}, {"@id": "_:n8d07356534544324ace9145973dc9335b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Risographs; BT Digital prints; Digital prints produced by scanning an original image, burning voids corresponding to image areas in a master sheet, and forcing ink through voids in the master)"}, "madsrdf:citationSource": "Artists' Books Thesaurus online, June 3, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d07356534544324ace9145973dc9335b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Risograph is a brand of digital duplicators manufactured by the Riso Kagaku Corporation, that are designed mainly for high-volume photocopying and printing. It was released in Japan in 1980. It is sometimes called a digital duplicator or printer-duplicator, as newer models can be used as a network printer as well as a stand-alone duplicator)"}, "madsrdf:citationSource": "Wikipedia, June 10, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d07356534544324ace9145973dc9335b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Risograph; Etymology: after the Riso Kagaku Corporation, +\u200e -graph; A high-speed printing machine used for high-volume photocopying by means of an internal stencil)"}, "madsrdf:citationSource": "Wiktionary, June 3, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d07356534544324ace9145973dc9335b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Artists' Book Terms (Risographs; BT Digital print; Digital prints produced by scanning an original image, burning voids corresponding to image areas in a master sheet, and forcing ink through voids in the master)"}, "madsrdf:citationSource": "Opening Artists' Books online, June 3, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d07356534544324ace9145973dc9335b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 9 (\"The Risograph, Riso printer, or RISO printer-duplicator is a stencil printer designed principally for high-volume duplicating. As a printing method it sits somewhere on the spectrum between screen printing and offset lithography, but what sets Riso apart is the unique aesthetic and highly tactile finish of the prints ... Riso inks are liquid and not coated or fully opaque ... Riso ink is made of soy oil ... because Riso uses real ink, Riso prints are very tactile -- you can really feel the ink.\") page 14 (Another characteristic of the Riso printing process is that, despite being digitally-based, there will always be minute variations between prints, even from the same run. This confers a palpable handmade aesthetic, and in principle means that each piece is unique ... All of these details combine to confer on Riso prints a distinctive, attractive look) (OcoLC)974977069"}, "madsrdf:citationSource": "Work cat.: Risomania : the new spirit of printing, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d07356534544324ace9145973dc9335b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Risograph's environmental performance (The RISOGRAPH is a stencil printing style digital duplicator. It works by piercing a printing stencil plate with holes and passing ink through the holes to transfer an image onto paper)"}, "madsrdf:citationSource": "Riso Kagaku Corporation web site, June 10, 2021:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2021026034"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026038", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRoad trip comics", "identifiers:lccn": "gf2021026038", "madsrdf:adminMetadata": [{"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b1"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Road trip comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b5"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b6"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b7"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b8"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b9"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b10"}], "madsrdf:hasVariant": [{"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b11"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics set on the open road, in which a life-changing journey is a central part of the action."}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-09-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-11-23T12:01:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Road trip comics"}}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Roadtrip cartoons and comics\"; \"Road-trip cartoons and comics\")"}, "madsrdf:citationSource": "Cartoonstock website, viewed Sept. 10, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(road trip comic; summary: \"Bea is on the run. And then, she runs into Lou. This chance encounter sends them on a journey through West Texas, where strange things follow them wherever they go. The landscape morphs into an unsettling world, a mysterious cat joins them, and they are haunted by a group of threatening men. To stay safe, Bea and Lou must trust each other as they are driven to confront buried truths\")"}, "madsrdf:citationSource": "Walden, T. Are you listening?, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 51 (the Danish comic series \"Petzi\" and \"Jimmy das Gummipferd\" are examples of \"'road comics', following the protagonists' travels\")"}, "madsrdf:citationSource": "Novel perspectives on German-language comics studies, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The less than epic adventures of TJ and Amal: omnibus; \"E.K. Weaver's critically-acclaimed road trip romance comic\")"}, "madsrdf:citationSource": "Goodreads website, viewed Sept. 10, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "back cover (\"In the span of a single tumultuous evening, Amal calls off his arranged marriage, comes out to his conservative parents, gets disowned, goes on a bender-- and wakes up next morning to find a lanky, dreadlocked vagrant named TJ in his kitchen. TJ claims that the two have made a drunken pact to travel from Berkeley, California to Providence, Rhode Island. As it happens, Amal promised his sister he'd be in Providence for her graduation the following week. As for TJ-- well, he's got his own reasons. The agreement is simple: Amal does the driving, TJ pays the way-- but a 3500 mile journey leaves plenty of time for things to get complicated\")"}, "madsrdf:citationSource": "Work cat: Weaver, E. K. The less than epic adventures of TJ and Amal, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(road trip comic; summary: \"Ever read On the Road? Or seen Tommy Boy? This is just like that, but with Spider-Man and Deadpool. The two red-clad heroes are traveling across America, discovering their country and true friendship and just like every other great road trip, this one ends up in the Negative Zone\")"}, "madsrdf:citationSource": "Thompson, R. Spider-Man/Deadpool. Vol. 8, Road trip, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Roadtrip comics"}}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Roadtrip comics"}}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Road comics"}}, {"@id": "_:n290a1cb6487b4d8499ee5c456d2078a7b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Road comics"}}], "@id": "/authorities/genreForms/gf2021026038"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026041", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIntersex comics", "identifiers:lccn": "gf2021026041", "madsrdf:adminMetadata": [{"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b1"}, {"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Intersex comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026162"}, "madsrdf:hasSource": [{"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b5"}, {"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b6"}], "madsrdf:hasVariant": {"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics featuring intersex characters or addressing intersex themes."}, {"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "revised"}, {"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-09-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intersex comics"}}, {"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Groundbreaking Japanese Comic Depicts Intersex, Sep. 1, 2003 (\"'IS: Otoko demo onna demo nai sei (translation: the sex that is neither male or female)' is a groundbreaking new comic series by Chiyo Rokuhana\"; \"Based on interviews the author conducted with intersex individuals, each episode of 'IS' (which spans about 100 pages) tells a multidimentional human story of an intersex person who lives and breathes in Japan\")"}, "madsrdf:citationSource": "Intersex Initiative website, viewed Sept. 29, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(part of a manga series based on the lives of intersex people)"}, "madsrdf:citationSource": "Work cat: Rokuhana, C. IS. 7, Intersexual, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Intersexual comics"}}, {"@id": "_:n37cc6ef257d94159bd38cbb5a2d853c8b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intersexual comics"}}], "@id": "/authorities/genreForms/gf2021026041"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026042", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWar songs", "identifiers:lccn": "gf2021026042", "madsrdf:adminMetadata": [{"@id": "_:nf4aae57483ea4e6096125cf76705034db1"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "War songs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf4aae57483ea4e6096125cf76705034db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026936"}, "madsrdf:hasSource": [{"@id": "_:nf4aae57483ea4e6096125cf76705034db5"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db6"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db7"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db8"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db9"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db10"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db11"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db12"}], "madsrdf:hasVariant": [{"@id": "_:nf4aae57483ea4e6096125cf76705034db13"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-12-20T10:32:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-10-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "War songs"}}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(contents: Patriotic songs -- The soldiering life -- Battlefield deaths -- Domestic scenes -- Emancipation songs) (OCoLC)3295672"}, "madsrdf:citationSource": "The Civil War songbook : complete original sheet music for 37 songs, \u00a91977", "madsrdf:citationStatus": "found"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(contents: Revolutionary War -- War of 1812 -- Mexican War -- Civil War -- Spanish-American war -- World War) (OCoLC)337868"}, "madsrdf:citationSource": "American war songs, 1971", "madsrdf:citationStatus": "found"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(contents: I wish I was in Dixie's land -- All quiet along the Potomac tonight -- We are coming, Father Abra'am -- Mother, is the battle over? -- Tenting on the old camp ground -- The drummer boy of Shiloh -- Beauregard's retreat from Shiloh -- Jeff in petticoats -- Weeping, sad and lonely -- I'm a good old rebel -- When Johnny comes marching home -- We are coming from the cotton fields)"}, "madsrdf:citationSource": "Songs of the Civil War, 1987?, \u21171976", "madsrdf:citationStatus": "found"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)760202117"}, "madsrdf:citationSource": "Work cat.: Ottoman traditional war songs, 2004?", "madsrdf:citationStatus": "found"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)686641"}, "madsrdf:citationSource": "Songs of many wars : from the sixteenth to the twentieth century, 1943.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "World War II (Composers and performers representing every style of music pitched in to create songs that would inspire the troops, motivate defense workers, and generally keep the morale of the nation high as it undertook the challenges of global conflict; many songs that listeners associated with the war (or at least wartime) did not make that connection explicit. It was enough for composers to hint at such a link and allow the audience to derive their own meaning from the songs. A classic example was \"White Christmas,\" which was not written as a war song, but whose lyrics of separation and remembrance struck a chord among listeners of that era) Harding, Walter N(ewton) H(enry) (Harding's American music holdings consisted largely of 60,000 to 70,000 items of sheet music, with particular strengths in the areas of ragtime, comic opera, minstrel-show music, war songs, and Chicago imprints) Morfov, Alexandar (During his career in the Bulgarian Army as a commanding officer he wrote many marches, hymns, and war songs which were sung by soldiers in their battles; Among the most famous of Morfov's compositions are his marches and war songs. During his first years at the military school he wrote the march Napred! Nii schte pobedim [\"Onward! We will win\"] (1900), text by S. Maximov, sung by soldiers at the beginning of the Balkan War) Towa (Large gourd vessel rattle of the Baule people of the Ivory Coast; used mainly on ceremonial occasions to mark the appearance of masked dancers; it also accompanies war songs)"}, "madsrdf:citationSource": "Grove music online, Oct. 5, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(War songs. UF Battle songs; Soldiers' songs. BT Songs. RT Military music)"}, "madsrdf:citationSource": "LCSH, Oct. 5, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(contents: Free America -- The red, white, and blue (O Columbia, the gem of the ocean) -- The soldier's tear -- The bonnie blue flag -- The battle cry of freedom -- When Johnny comes marching home -- Tenting to-night -- Tramp! Tramp! Tramp! -- Marching through Georgia -- Captain Jinks of the Horse Marines -- The faded coat of blue -- Over there -- He is there! -- God be with our boys to-night -- Give a little credit to the navy -- When Alexander takes his ragtime band to France -- K-K-K-Katy -- Over yonder where the lilies grow -- Would you rather be a colonel with an eagle on your arm than a private with a chicken on your knee? -- There's a long, long trail -- When the boys come sailing home -- My buddy -- Keep the home-fires burning) (OCoLC)921262241"}, "madsrdf:citationSource": "Over there! : songs from America's wars, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf4aae57483ea4e6096125cf76705034db14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Battle songs"}}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Battle songs"}}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf4aae57483ea4e6096125cf76705034db17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Soldiers' songs"}}, {"@id": "_:nf4aae57483ea4e6096125cf76705034db17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soldiers' songs"}}], "@id": "/authorities/genreForms/gf2021026042"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026043", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBoard books", "identifiers:lccn": "gf2021026043", "madsrdf:adminMetadata": [{"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b1"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Board books"}, "madsrdf:elementList": {"@list": [{"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, "madsrdf:hasSource": [{"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b5"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b6"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b7"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b8"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b9"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b10"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b11"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b12"}], "madsrdf:hasVariant": {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b13"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Books with stiff board or plastic pages that are designed to stimulate early-literacy skills of babies and very young children."}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-01-19T12:15:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-10-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Board books"}}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Because very young children learn as much through their mouths as through their other senses, many of their first books are made of washable foam-filled cloth pages or constructed with heavy laminated cardboard or plastic pages that will withstand teeth and sticky fingers. These 'board books' or cloth books are frequently identification books or 'naming books'\")"}, "madsrdf:citationSource": "Continuum encyclopedia of children's literature, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(board book; summary: \"High-contrast black-and-white art for babies who are beginning to look and learn\")"}, "madsrdf:citationSource": "Work cat: Linenthal, P. Look look!, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 41 (\"boardbooks\"; \"board books played an important role in the development of early-literacy skills in children younger than age four\") p. 42 (\"value of board books as vehicles for getting infants and toddlers interested in books and reading because the books are hard for chewing purposes and small enough to fit in little hands\")"}, "madsrdf:citationSource": "Kaplan, A. G. From board to cloth and back again : a preliminary exploration of board books, in Children and libraries, v. 10, no. 3 (Winter 2012):", "madsrdf:citationStatus": "found"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Board books: \"Simple books with sturdy cardboard pages often laminated for protection, intended for very young children\"; considered a \"form\")"}, "madsrdf:citationSource": "Art and architecture thesaurus online, viewed Oct. 28, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(board book; publisher's information: \"Before they are able to clearly see colors, babies respond to the strong contrast between black and white, which makes this the perfect first book for young, developing brains. Experiencing bold black-and-white contrast helps stimulate development in the retina and the optic nerve\")"}, "madsrdf:citationSource": "Hoban, T. White on black, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Board books: \"A durable book of small size designed for very young children, consisting of a few unnumbered pages made of pasteboard covered in glossy paper printed with colorful illustrations and little if any text\")"}, "madsrdf:citationSource": "ODLIS : online dictionary for library and information science, viewed Oct. 28, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Packed with bright, lively pictures and large, simple text -- this is an ideal book to stimulate recognition and encourage talking and naming. Chunky format and hard-wearing pages are great for little hands\")"}, "madsrdf:citationSource": "Wilkes, A. My first word board book, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Board book: \"a type of book with pages made of sturdy paperboard, designed for use by babies and young children\")"}, "madsrdf:citationSource": "Oxford English dictionary online, viewed Oct. 28, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Boardbooks"}}, {"@id": "_:nabeb1d6b67ea4d28ba19e7969282b113b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Boardbooks"}}], "@id": "/authorities/genreForms/gf2021026043"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026044", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNew jack swing (Music)", "identifiers:lccn": "gf2021026044", "madsrdf:adminMetadata": [{"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b1"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "New jack swing (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026823"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027052"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027106"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026156"}], "madsrdf:hasSource": [{"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b5"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b6"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b7"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b8"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b9"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b10"}], "madsrdf:hasVariant": [{"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b11"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b14"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b17"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "A pop-oriented rhythm-and-blues genre that fuses a soul-based vocal style, a funk- or go-go-based propulsive rhythmic swing, and jazz glissandi, using sampled sounds, synthesized sounds, drum machines, and sometimes rap."}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-11-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-03-03T09:03:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "New jack swing (Music)"}}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Seabrook, John. Factory girls, October 8, 2012 (Like K-drama, K-pop is a blend not just of Western and traditional but of new and old; the music sometimes sounds like New jack swing - the late-eighties dance music created by the American producer and songwriter Teddy Riley and popularized by Michael and Janet Jackson, Boyz II Men, and Bobby Brown, among others; if there is a single video from the eighties that captures many of the elements that later resurfaced in K-pop, it is Bobby Brown's 1988 hit \"My prerogative,\" with its triplet swing on the sixteenth note, a signature of New jack swing."}, "madsrdf:citationSource": [{"@id": "https://www.newyorker.com/magazine/2012/10/08/factory-girls-2"}, "New Yorker Magazine WWW site, November 18, 2021:"], "madsrdf:citationStatus": "found"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(New jack swing; a pop-oriented rhythm-and-blues style that fuses a soul-based vocal style, a funk- or go-go-based propulsive rhythmic swing, jazz glissandi, and rap, using sampled sounds (modified by turntable techniques), synthesized sounds (such as strings), and drum machines (that create insistent beats). New York artist and producer Teddy Riley is generally credited for creating New jack swing (a term coined by writer and director Barry Michael Cooper) in the late 1980s...The no. 1 rhythm-and-blues single \"I want her\" (1987) by Keith Sweat is considered to be the first New jack swing hit; at its peak during the early 1990s, several female groups emerged, such as TLC and SWV, whose music is referred to as New Jill swing; major productions include the Grammy-winning album CrazySexyCool (1994) by TLC. Subsequent developments fused with, or emphasized, other music styles, such as soul, which led to the emergence of styles from hip hop soul to nouveau soul or alternative soul)"}, "madsrdf:citationSource": "Grove Music Online, November 18, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Zhan\u00e9. Sending my love, 1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Leight, Elias. How American R&B songwriters found a new home in K-Pop, May 2, 2018 (Teddy Riley, the American singer-songwriter-producer famous for his work with acts like Keith Sweat, Guy and Blackstreet, was one of the first to make the trip to South Korea, flying out in 2009 and establishing a sideline as a New jack swing savant for Girls Generation and Jay Park. Another early K-pop convert was Harvey Mason Jr."}, "madsrdf:citationSource": [{"@id": "https://www.rollingstone.com/music/music-news/how-american-rb-songwriters-found-a-new-home-in-k-pop-627643/"}, "Rolling Stone WWW site, November 18, 2021:"], "madsrdf:citationStatus": "found"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Sybil. Don't make me over, 1989.", "madsrdf:citationStatus": "found"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(New jack swing; new jack or swingbeat is a fusion genre that fuses the rhythms and production techniques of hip hop and dance-pop with the urban contemporary sound of R&B; Merriam-Webster's online dictionary defines new jack swing as \"pop music usually performed by Black musicians that combines elements of jazz, funk, rap, and rhythm and blues.\" New jack swing did take up the trend of using sampled beats and tunes, and also created beats using the then-new SP-1200 sampler...The Roland TR-808 was sampled to create distinctive, syncopated, swung rhythms, with its snare sound being especially prominent; Washington, D.C. go-go bands (Chuck Brown, Trouble Funk, EU) were roots of new jack swing; the term \"new jack swing\" describes the sound produced and engineered by R&B/hip hop artist and producer Teddy Riley; the defining feature of Riley's music was the introduction of swingbeats, \"a rhythmic pattern using offbeat accented 16th note triplets\"; in 2018, the new jack swing sound made a comeback with the release of the remix of \"Finesse,\" a song by American singer/songwriter Bruno Mars from his third studio album, 24K Magic, which features Cardi B; stylistic origins: contemporary R&B, rhythm and blues music, soul, funk, hip hop, go-go, gospel music, dance music; cultural origins: late 1980s, United States; typical instruments: singing, rapping, keyboards, drum machines, samplers)"}, "madsrdf:citationSource": [{"@id": "https://en.wikipedia.org/wiki/New_jack_swing"}, "Wikipedia, November 18, 2021"], "madsrdf:citationStatus": "found"}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Newjack swing (Music)"}}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Newjack swing (Music)"}}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Swingbeat (Music)"}}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Swingbeat (Music)"}}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "New Jill swing (Music)"}}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "New Jill swing (Music)"}}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "New jack (Music)"}}, {"@id": "_:n09c98617f1ed4e3f8045469ce7beec58b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "New jack (Music)"}}], "@id": "/authorities/genreForms/gf2021026044"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026046", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChiptunes", "identifiers:lccn": "gf2021026046", "madsrdf:adminMetadata": [{"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb1"}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Chiptunes"}, "madsrdf:elementList": {"@list": [{"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026783"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026066"}], "madsrdf:hasSource": [{"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb5"}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb6"}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb7"}], "madsrdf:hasVariant": [{"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb8"}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb11"}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb14"}], "madsrdf:historyNote": "[Established April 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-04-07T08:58:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-11-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chiptunes"}}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Chipocrite (Musician). Earth night, 2019.", "madsrdf:citationStatus": "found"}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Chiptune: Term related to music made by the eight-bit soundchips in 1980s and early 1990s gaming systems and microcomputers, as well as music composed using modified ('modded') gaming systems or environments designed to emulate the capabilities of early soundchips. (A chip, or microchip, is an integrated circuit packaged in a usually flat rectangular body with input and output pins for attachment to a larger circuit system.) The original systems include the NEC PC-8801, Commodore 64, Nintendo Entertainment Systems, Amiga, Game Boy, and Mega Drive/Genesis. The distinctive sound of music from these systems arises from their use of only a few simple waveforms, white noise, and beeps, as well as unreliable pitches and limited polyphony)"}, "madsrdf:citationSource": "Grove music online, searched Nov. 19, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Chiptune: Also known as chip music or 8-bit music; a style of synthesized electronic music made using the programmable sound generator (PSG) sound chips or synthesizers in vintage arcade machines, computers and video game consoles; commonly used to refer to tracker format music which intentionally sounds similar to older PSG-created music (this is the original meaning of the term), as well as music that combines PSG sounds with modern musical styles and has been described as \"an interpretation of many genres\" since any existing song can be arranged in a chiptune style defined more by choice of instrument and timbre than specific style elements.)"}, "madsrdf:citationSource": "Wikipedia, viewed Nov. 19, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "8-bit music"}}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "8-bit music"}}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Eight bit music"}}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Eight bit music"}}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chip music"}}, {"@id": "_:n58e147e1b5e74a269f4f4e89bf55246cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chip music"}}], "@id": "/authorities/genreForms/gf2021026046"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026047", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBody horror fiction", "identifiers:lccn": "gf2021026047", "madsrdf:adminMetadata": [{"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b1"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Body horror fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026373"}, "madsrdf:hasSource": [{"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b5"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b6"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b7"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b8"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b9"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b10"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b11"}], "madsrdf:hasVariant": [{"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b12"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b15"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b18"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Horror fiction in which the horror is principally derived from the graphic destruction or degeneration of the human body."}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-11-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-03-03T09:03:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Body horror fiction"}}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a body horror novel) (OCoLC)1018306427"}, "madsrdf:citationSource": "Work cat.: Whiteley, A. The beauty, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Beauty, by Aliya Whiteley)"}, "madsrdf:citationSource": "Body horror books, via Goodreads website, Nov. 21, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Body horror, biological horror, organic horror or venereal horror is horror fiction in which the horror is principally derived from the graphic destruction or degeneration of the body. Such works may deal with disease, decay, parasitism, mutilation, or mutation. Other types of body horror include unnatural movements, or the anatomically incorrect placement of limbs to create 'monsters' out of human body parts)"}, "madsrdf:citationSource": "educalingo website, Nov. 21, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(body horror, biological horror, organic horror or visceral horror; body horror fiction; books/short stories about body horror ... such as the 2012 Mammoth Book of Body Horror, or the 2017 Year's Best Body Horror. If anthologies aren't your thing, check out Gwendolyn Kiste's The Rust Maidens, Claire Fitzpatrick's Metamorphosis, Scott Sigler's Infected, Nick Cutter's The Troop, as well as Tim Meyer's Limbs: A Love Story or Scott Cole's Superghost)"}, "madsrdf:citationSource": "A brief intro to body horror, via Sci-fi & scary website, posted 15 Apr. 2020, viewed Nov. 21, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(body horror fiction)"}, "madsrdf:citationSource": "Writers who read : a conversation on body horror with Julian K. Jarboe, via Catapult website, posted Oct. 14, 2021, viewed Nov. 21, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Body horror or biological horror is a subgenre of horror that intentionally showcases grotesque or psychologically disturbing violations of the human body. These violations may manifest through aberrant sex, mutations, mutilation, zombification, gratuitous violence, disease, or unnatural movements of the body; In addition to common tropes used within the broader horror genre, some tropes specific to the body horror subgenre may include invasion, contagion, mutation, transformation, disease, mutilation, or other unnatural or violent distortions of the human body)"}, "madsrdf:citationSource": "Wikipedia, Nov. 21, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(body horror; subgenre; The Beauty, Aliya Whiteley: \"... a small colony of men and boys finds a strange fungus growing over the burial sites of the women. At first, it's merely a curiosity, an odd form of yellow mushroom, but doesn't stay that way for long. Very soon the story spirals into a twisted form of venereal horror, as the mushrooms take on the shape of women and the intimacy-starved men decide to take advantage of their new pliable companions as much as they possibly can\")"}, "madsrdf:citationSource": "Reader, S. Our bodies, our scares : 7 intimate works of body horror, via Nightfire website, posted Feb. 10, 2020, viewed Nov. 21, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biological horror fiction"}}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biological horror fiction"}}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Venereal horror fiction"}}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Venereal horror fiction"}}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Visceral horror fiction"}}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Visceral horror fiction"}}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Organic horror fiction"}}, {"@id": "_:n3de1660fa96740dbbe7e92fbd4e73733b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Organic horror fiction"}}], "@id": "/authorities/genreForms/gf2021026047"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026048", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChristian rock music", "identifiers:lccn": "gf2021026048", "madsrdf:adminMetadata": [{"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db1"}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Christian rock music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026728"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026041"}, "madsrdf:hasSource": [{"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db5"}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db6"}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db7"}], "madsrdf:hasVariant": [{"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db8"}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db11"}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db14"}], "madsrdf:historyNote": "[Established April 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-04-07T08:58:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-12-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Christian rock music"}}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Christian rock; \"form of rock music that features lyrics focusing on matters of Christian faith, often with an emphasis on Jesus, typically performed by self-proclaimed Christian individuals. The extent to which their lyrics are explicitly Christian varies between bands. Many bands who perform Christian rock have ties to the contemporary Christian music labels, media outlets, and festivals, while other bands are independent\")"}, "madsrdf:citationSource": "Wikipedia, viewed Dec. 8, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "found in Chapter 1 (Christian rock and roll; also identified as Jesus rock; \"off the beaten path of America's traditional religions, this spiritualization of rock and roll nevertheless created opportunities for Judea-Christian beliefs to influence rock. Though hardly expressions of Christian doctrine, many songs following this trend (Norman Greenbaum's \"Spirit in the Sky,\" James Taylor's \"Fire and Rain\") drew freely from Christian culture, if not Christian belief. Indeed, this same period saw the production of Jesus Christ Superstar and Godspell, two extraordinarily successful \"rock operas\" that blended popular music, rock and roll included, with Christian myths and ideas. Given this environment, Christian rock and roll -- JesusRock --began to seem less and less a contradiction in terms\")"}, "madsrdf:citationSource": "Apostles of rock, 1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Christian rock music album by Rockers for God)"}, "madsrdf:citationSource": "Work cat: The banner, 1990:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jesus rock music"}}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jesus rock music"}}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock music, Christian"}}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock music, Christian"}}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Christian rock and roll music"}}, {"@id": "_:nb83d5ee952a143f1b4790c0f1965d93db15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Christian rock and roll music"}}], "@id": "/authorities/genreForms/gf2021026048"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026049", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCommercial treaties", "identifiers:lccn": "gf2021026049", "madsrdf:adminMetadata": [{"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b1"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Commercial treaties"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026707"}, "madsrdf:hasSource": [{"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b5"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b6"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b7"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b8"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b9"}], "madsrdf:hasVariant": [{"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b10"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-03-03T09:03:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-12-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Commercial treaties"}}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(compilation of commercial treaties) (OCoLC)1588770"}, "madsrdf:citationSource": "Work cat.: India. India's trade agreements with other countries, 1976", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(commercial treaty: An agreement between two or more countries setting forth conditions under which business between or among the countries may be transacted. It may outline tariff privileges, terms on which property may be owned, the manner in which claims may be settled, etc.)"}, "madsrdf:citationSource": "Dictionary of international trade, via WWW, Dec. 8, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Commercial treaties. UF Trade agreements (Commerce). BT Treaties; also form subdivision Commercial treaties. SN Use as a form subdivision under names of countries, etc., for collections of commercial treaties of those places)"}, "madsrdf:citationSource": "LCSH, Dec. 8, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Commercial treaties are bilateral or multilateral treaties of public international law for the purpose of regulating conditions of, and establishing mutual rights to, trade and other commercial activities among the parties; usually concluded between States. Subjects of international law other than States, such as international organizations and customs unions possessing full autonomy in the conduct of their external economic relations, may also be contracting parties to commercial treaties, subject to their constituent legal foundations and their possession of legal capacity in international relations)"}, "madsrdf:citationSource": "Oxford public international law website, Dec. 8, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(commercial treaty: a treaty that defines the conditions under which citizens of one country may do business in another and covers such matters as the right to hold property, mode of enforcing claims, and tariff privileges)"}, "madsrdf:citationSource": "Merriam-Webster online dictionary, Dec. 8, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trade agreements (Treaties)"}}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trade agreements (Treaties)"}}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Agreements, Trade (Treaties)"}}, {"@id": "_:nd3f7f7e508a8408fbd3a4f83339334d7b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Agreements, Trade (Treaties)"}}], "@id": "/authorities/genreForms/gf2021026049"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026001", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAsexual fiction", "identifiers:lccn": "gf2022026001", "madsrdf:adminMetadata": [{"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb1"}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Asexual fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026063"}, "madsrdf:hasSource": [{"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb5"}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb6"}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb7"}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb8"}], "madsrdf:hasVariant": {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb9"}, "madsrdf:historyNote": "[Established April 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction featuring asexual characters or addressing asexual themes."}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-22T12:06:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "revised"}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-01-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Asexual fiction"}}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(asexual fiction. BT LGBTQ fiction. SN Fiction pertaining especially to asexual persons and/or culture.)"}, "madsrdf:citationSource": "GSSO - the gender, sex, and sexual orientation ontology, viewed Jan. 2, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Asexual fiction. UF Ace fiction. BT LQBTQ+ fiction. SN Written works of fiction featuring asexual characters or addressing asexual themes)"}, "madsrdf:citationSource": "Homosaurus, viewed Jan. 2, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Alice's last girlfriend, Margo, ended things when Alice confessed she's asexual. Now Alice is sure she's done with dating ... and then she meets Takumi. She can't stop thinking about him or the rom-com-grade romance feelings she did not ask for. When her blissful summer takes an unexpected turn and Takumi becomes her knight with a shiny library-employee badge, Alice has to decide if she's willing to risk their friendship for a love that might not be reciprocated-- or understood) (OCoLC)974452907"}, "madsrdf:citationSource": "Work cat.: Kann, C. Let's talk about love, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Ace Romance: Let's Talk About Love by Claire Kann; \"Coming-of-age stories pair well with characters coming to terms with their sexuality, just as college student Alice does in this swoony contemporary New Adult romance. Since her girlfriend broke up with her because of her asexuality, Alice has sworn off dating. But when Takumi starts working alongside her at the library, she finds herself falling for him. Lovely depiction of a biromantic asexual young Black woman.\")"}, "madsrdf:citationSource": "Hill, N. 8 asexual books to help you celebrate Pride Month, via Book riot website, posted June 19, 2020, viewed Jan. 2, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ace fiction"}}, {"@id": "_:naf8ab22eb2314fe582f2a4c2cff169dbb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ace fiction"}}], "@id": "/authorities/genreForms/gf2022026001"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026002", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIntersex poetry", "identifiers:lccn": "gf2022026002", "madsrdf:adminMetadata": [{"@id": "_:nf977909695b8443da390d5656de00745b1"}, {"@id": "_:nf977909695b8443da390d5656de00745b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Intersex poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf977909695b8443da390d5656de00745b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026037"}, "madsrdf:hasSource": [{"@id": "_:nf977909695b8443da390d5656de00745b5"}, {"@id": "_:nf977909695b8443da390d5656de00745b6"}, {"@id": "_:nf977909695b8443da390d5656de00745b7"}], "madsrdf:hasVariant": {"@id": "_:nf977909695b8443da390d5656de00745b8"}, "madsrdf:historyNote": "[Established April 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry featuring intersex characters or addressing intersex themes."}, {"@id": "_:nf977909695b8443da390d5656de00745b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-01-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf977909695b8443da390d5656de00745b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/nmw"}, "ri:recordStatus": "revised"}, {"@id": "_:nf977909695b8443da390d5656de00745b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intersex poetry"}}, {"@id": "_:nf977909695b8443da390d5656de00745b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(intersex poetry) (OCoLC)983824279"}, "madsrdf:citationSource": "Work cat.: Owens, Rochelle. Hermaphropoetics, drifting geometries, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nf977909695b8443da390d5656de00745b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Homosaurus, Jan. 4, 2022;GSSO - the Gender, Sex, and Sexual Orientation ontology, Jan. 4, 2022", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nf977909695b8443da390d5656de00745b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection of erotic and intersex poetry) (OCoLC)456170047"}, "madsrdf:citationSource": "Beccadelli, Antonio. The hermaphrodite, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:nf977909695b8443da390d5656de00745b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf977909695b8443da390d5656de00745b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Intersexual poetry"}}, {"@id": "_:nf977909695b8443da390d5656de00745b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intersexual poetry"}}], "@id": "/authorities/genreForms/gf2022026002"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026003", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAsexual poetry", "identifiers:lccn": "gf2022026003", "madsrdf:adminMetadata": [{"@id": "_:ned022e0740754beda2ee1e554cb4f073b1"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Asexual poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:ned022e0740754beda2ee1e554cb4f073b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026037"}, "madsrdf:hasSource": [{"@id": "_:ned022e0740754beda2ee1e554cb4f073b5"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b6"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b7"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b8"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b9"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b10"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b11"}], "madsrdf:hasVariant": {"@id": "_:ned022e0740754beda2ee1e554cb4f073b12"}, "madsrdf:historyNote": "[Established April 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry featuring asexual characters or addressing asexual themes."}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-01-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-07T10:19:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Asexual poetry"}}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: A collection of poems I wrote while in college about how I slowly experience the firsts of having a crush, finding a term I felt comfortable with, meeting another ace and other firsts I experience while coming to terms about my sexuality. I highly recommend this for every asexual out there, but also for anyone written for anyone inside or outside the LGBTQ community. While the poems are written from an asexual's point of view, they are really meant for anyone to read, especially those coming to terms with their sexuality\") (OCoLC)1110581234"}, "madsrdf:citationSource": "Hamell, Lauren. An asexual's firsts, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (a collection of poetry from the aromantic and asexual community) (OCoLC)1291464066"}, "madsrdf:citationSource": "Aro/ace anthology 2021 : an anthology of the beauty, diversity, kindness and expression of romanticism and asexuality in a creative community, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Homosaurus, Jan. 4, 2022;GSSO - the Gender, Sex, and Sexual Orientation ontology, Jan. 4, 2022", "madsrdf:citationStatus": "notfound"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: A poetry collection about the mythic life of Artemis, Greek Goddess of the hunt. Told through the perspective of Artemis herself with the contributions of a few other Greek Goddesses. This collection reimagines and follows Artemis navigating her lifelong vow of chastity and, rather than suffering through it, owning it as a facet of her aromanticism and asexuality) (OCoLC)1204100468"}, "madsrdf:citationSource": "Eileen, Shelby. Goddess of the hunt, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lately I've been thinking about getting back into writing poetry and mixing my \"ace-ness\" in it ... I just wrote a piece on me thoughts about love for me as ace)"}, "madsrdf:citationSource": "jLpfeiffer. Ace poetry/writing, via The Asexual Visibility & Education Network website, posted May 25, 2019, viewed on Jan. 4, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(My June 5, 2012 Poetry Fishbowl sold out, so all the poems have been posted. Three of them from this batch feature asexual protagonists, and two of those are explicitly about asexuality)"}, "madsrdf:citationSource": "Barrette, Elizabeth. Ace poetry, via The wordsmith's forge blog, posted June 8, 2012, viewed on Jan. 4, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(online anthology of ace poetry)"}, "madsrdf:citationSource": "Dead Ace Poet Society blog, via Tumblr, viewed Jan. 4, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ned022e0740754beda2ee1e554cb4f073b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ace poetry"}}, {"@id": "_:ned022e0740754beda2ee1e554cb4f073b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ace poetry"}}], "@id": "/authorities/genreForms/gf2022026003"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026004", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAsexual comics", "identifiers:lccn": "gf2022026004", "madsrdf:adminMetadata": [{"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b1"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Asexual comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026162"}, "madsrdf:hasSource": [{"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b5"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b6"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b7"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b8"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b9"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b10"}], "madsrdf:hasVariant": {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b11"}, "madsrdf:historyNote": "[Established May 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics featuring asexual characters or addressing asexual themes."}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-01-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-22T12:06:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Asexual comics"}}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Brave, witty and empowering, this graphic memoir follows Rebecca as she navigates her asexual identity and mental health in a world obsessed with sex. From school to work to relationships, this book offers an unparalleled insight into asexuality) (OCoLC)1150014128"}, "madsrdf:citationSource": "Work cat.: Burgess, R. How to be ace : a memoir of growing up asexual, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Homosaurus, Jan. 4, 2022;Wikipedia, Sept. 14, 2022 (Ace Comics was a comic book series published by David McKay Publications between 1937 and 1949)", "madsrdf:citationStatus": "notfound"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Started as a way to explain to eir family what it means to be nonbinary and asexual, Gender Queer is more than a personal story: it is a useful and touching guide on gender identity) (OCoLC)1064772433"}, "madsrdf:citationSource": "Kobabe, M. Gender queer : a memoir, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "afterword (This work focuses on asexuality. I arrived at the idea to do a story on this topic after reading several romance manga and just not feeling it. And so when I learned about what asexuality is, I realized, \"this it it!\" and decided to make a manga about it) (OCoLC)1257576100"}, "madsrdf:citationSource": "Uta, I. Mine-kun is asexual, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Conference > Program/Schedule (includes program titled \"Too Ace for This: Crafting Asexual and Aromantic Comics\")"}, "madsrdf:citationSource": [{"@id": "https://queersandcomics.com/program"}, "Queers & Comics Conference website, Sept. 14, 2022:"], "madsrdf:citationStatus": "found"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 32 (Although Jughead's asexuality was not explicitly discussed prior to the most recent series of Jughead comics, it is not unreasonable to claim that he has always been depicted in ways we would now call ace) (OCoLC)1079394225"}, "madsrdf:citationSource": "Wrhel, N. Acest of aces : representations of asexuality in fiction, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ace comics"}}, {"@id": "_:neb69c26952b34d10a19b7f0cb90041c3b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ace comics"}}], "@id": "/authorities/genreForms/gf2022026004"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026005", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAromantic poetry", "identifiers:lccn": "gf2022026005", "madsrdf:adminMetadata": [{"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb1"}, {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Aromantic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb5"}, {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb6"}, {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb7"}], "madsrdf:hasVariant": {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb8"}, "madsrdf:historyNote": "[Established April 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry featuring aromantic characters or addressing aromantic themes."}, {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/nmw"}, "ri:recordStatus": "revised"}, {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-01-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aromantic poetry"}}, {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (a collection of poetry from the aromantic and asexual community) (OCoLC)1291464066"}, "madsrdf:citationSource": "Work cat.: Aro/ace anthology 2021, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"here's a collection of reblogged aro poetry more welcoming for loveless aros and aros with complicated relationships to love. These pieces still reference love and discuss love, romance and amatonormativity. They're not, however, focused on presenting or showcasing the author or narrator's platonic or familial love. In other words, an aro narrator's need to love or have their love seen and valued by others is not what these poems are about\")"}, "madsrdf:citationSource": "Poetry collection: aro and loveless, via Aro worlds website, viewed Jan. 10, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Some point in time earlier in the year, I said that I would write some aromantic poetry\")"}, "madsrdf:citationSource": "Poems from an aromantic asexual, via Lines and lamentations blog, posted Nov. 30, 2016, viewed Jan. 10, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Aro poetry"}}, {"@id": "_:n204dd6bc8f3148a88fd9506bcae83d6eb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aro poetry"}}], "@id": "/authorities/genreForms/gf2022026005"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026007", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTransgender poetry", "identifiers:lccn": "gf2022026007", "madsrdf:adminMetadata": [{"@id": "_:n3ec478400f664dc68f3c93dbc0867750b1"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Transgender poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3ec478400f664dc68f3c93dbc0867750b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026037"}, "madsrdf:hasSource": [{"@id": "_:n3ec478400f664dc68f3c93dbc0867750b5"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b6"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b7"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b8"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b9"}], "madsrdf:hasVariant": {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b10"}, "madsrdf:historyNote": "[Established May 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry featuring transgender characters or addressing transgender themes."}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/nmw"}, "ri:recordStatus": "revised"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-01-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transgender poetry"}}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (\"Water I Won't Touch is a life raft and a self-portrait, concerned with the vitality of trans people living in a dangerous and inhospitable landscape ... these ambitious poems ...\") (OCoLC)1201225487"}, "madsrdf:citationSource": "Candrilli, K.R. Water I won't touch, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(transgender poetry. SN Poetry by or otherwise relating to transgender persons. BT LGBTQ poetry)"}, "madsrdf:citationSource": "GSSO - the gender, sex, and sexual orientation ontology, viewed Jan. 13, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "publisher's website (poems that pursue the particular and multiple trans relationships to desire, embodiment, housing, sex, ecology, history, pop culture, and the working day) (OCoLC)1144090716"}, "madsrdf:citationSource": "Work cat.: We want it all : an anthology of radical trans poetics, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)839307399"}, "madsrdf:citationSource": "Troubling the line : trans and genderqueer poetry and poetics, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Transgender poetry. BT LGBTQ+ poetry)"}, "madsrdf:citationSource": "Homosaurus (V3), viewed Jan. 13, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3ec478400f664dc68f3c93dbc0867750b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trans poetry"}}, {"@id": "_:n3ec478400f664dc68f3c93dbc0867750b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trans poetry"}}], "@id": "/authorities/genreForms/gf2022026007"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026008", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aUnderground periodicals", "identifiers:lccn": "gf2022026008", "madsrdf:adminMetadata": [{"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b1"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Underground periodicals"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026139"}, "madsrdf:hasSource": [{"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b5"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b6"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b7"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b8"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b9"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b10"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b11"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b12"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b13"}], "madsrdf:hasVariant": [{"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b14"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b17"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b20"}], "madsrdf:historyNote": "[Established May 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Periodicals issued by radical, anti-establishment, counter-culture groups with content that challenges propriety and explores alternative forms of lifestyle or artistic expression."}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-02-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-05-26T14:29:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Underground periodicals"}}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In the late 1960s, the underground press was a spontaneous and primitive rebellion against the status quo, with visual and verbal obscenity as its most potent weapons; Some editors preferred using the words 'radical', 'revolutionary' or 'alternative'. Paul Krassner, editor/publisher of The Realist, the mother of all undergrounds, argued that the only true underground periodical in America was The Outlaw, produced by inmates of San Quentin Prison; Initially, it was termed 'underground' because it represented an illicit, post-Beat subculture that advocated organised disobedience in opposition to the Vietnam War and in support of the Civil Rights movement. Eventually, sex, drugs and rock'n'roll were added to the liturgy; The undergrounds challenged propriety through word and picture. Written and visual obscenity was a prime weapon. Accepted notions of design were ignored, which gave the newspapers their collective untutored look; were aimed at different audiences spanning an age range, from 16 to 30, with contrasting socio-political principles that included the far-, middle-, centre- and neo-left, as well as hippies, Leninists, anarchists, populists, Maoists, occultists, student guerrillas, Black Panthers and rock'n' rollers. Libertines were attracted to the softcore porn and personal classi\ufb01eds found in many of the publications)"}, "madsrdf:citationSource": "Heller, S. Kicking complacency in the ass, via Eye magazine website, summer 2000, viewed online Feb. 16, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "underground publications (1. Printed publications issued secretly by a group or movement organized usually to overthrow or undermine a governing authority, or, in time of war, the power in authority. Synonymous with clandestine publications. 2. Sometimes used synonymously with alternative publications) alternative publications (Publications which express views or treat subjects not normally presented in the daily or establishment press. May be politically or culturally right or left of center, but the left usually is emphasized. Sometimes called underground publications)"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a gay underground periodical) (OCoLC)33257552"}, "madsrdf:citationSource": "Work cat.: The adz, Oct. 9, 1970", "madsrdf:citationStatus": "found"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1150888838"}, "madsrdf:citationSource": "Under the radar : underground zines and self-publications 1965-1975, 2019.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Underground periodicals (Underground periodicals. UF Alternative periodicals. BT Periodicals; Underground press publications. RT Zines) Underground press publications (Underground press publications. UF Alternative press publications. SN Here are entered works about publications issued legally (and usually serially) and produced by radical, anti-establishment, counter-culture groups. Works about publications issued clandestinely and contrary to government regulation are entered under Underground literature.)"}, "madsrdf:citationSource": "LCSH, Feb. 16, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(underground: adjective 1.2 Relating to or denoting a group or movement seeking to explore alternative forms of lifestyle or artistic expression; radical and experimental. Synonyms: alternative, radical, revolutionary, unconventional, unorthodox, avant-garde, experimental, innovative, groundbreaking, pioneering, novel)"}, "madsrdf:citationSource": "Lexico website, Feb. 16, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 76 (The most important catalyst for underground comix was the rise of the \"underground\" press in 1965. With the advent of cheaper offset printing, new radical press periodicals appeared across the country. ... By 1967 the underground press had its own news syndicates with the Underground Press Syndicate and the Liberation News Service, which provided articles and art to members. The syndicates spurred a boom in the underground press from 1967 to 1969 with hundreds of underground periodicals appearing across the United States and Canada)"}, "madsrdf:citationSource": "Lopes, P.D. Demanding respect : the evolution of the American comic book, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "underground press (A publisher that issues printed publications unofficially or clandestinely, usually to members of a group or organization that opposes the policies of an established government or other authority, more common during periods of civil unrest than in times of peace and prosperity. Eventually, most underground presses either disband or become \"above ground\" publishing houses; underground comics: Small press or self-published comic books, often socially satirical in tone, containing content considered outside the mainstream by the Comics Code Authority, usually because drug use, sex, or violence is depicted too explicitly) alternative press (A small, politically progressive publisher not controlled by the handful of giant multinational corporations that dominate the publishing industry worldwide. Alternative press publications often address important social issues and publish innovative and experimental works largely ignored or covered superficially in the mainstream press)"}, "madsrdf:citationSource": "Online dictionary for library and information science, Feb. 16, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)4003418"}, "madsrdf:citationSource": "Noyce, J.L. The directory of British alternative periodicals, 1965-1974, 1979.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternative periodicals"}}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative periodicals"}}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radical periodicals"}}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radical periodicals"}}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Revolutionary periodicals"}}, {"@id": "_:n6750bbb651824d4f9a1be148c52cc4a6b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Revolutionary periodicals"}}], "@id": "/authorities/genreForms/gf2022026008"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026011", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWebcomics", "identifiers:lccn": "gf2022026011", "madsrdf:adminMetadata": [{"@id": "_:n72fd0314feca4831a0c91609db9c28d5b1"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Webcomics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n72fd0314feca4831a0c91609db9c28d5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n72fd0314feca4831a0c91609db9c28d5b5"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b6"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b7"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b8"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b9"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b10"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b11"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b12"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b13"}], "madsrdf:hasVariant": [{"@id": "_:n72fd0314feca4831a0c91609db9c28d5b14"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b17"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b20"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b23"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b26"}], "madsrdf:historyNote": "[Established May 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics published primarily or only online, that may incorporate web-specific capabilities such as infinite canvas, animation, pixel art, and interactive elements."}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-05-26T14:29:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-02-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Webcomics"}}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(webcomics; also known as online comics or internet comics; \"on-line comic\"; \"comics published on a website or mobile app\"; many published exclusively on the web, though others are also published or reprinted in print format; \"with webcomics the restrictions of traditional books, newspapers or magazines can be lifted, allowing artists and writers to take advantage of the web's unique capabilities\" such as using pixel art or incorporating animation or interactive elements; also notable is the infinite scroll or \"infinite canvas\" webcomic, where \"artists are free to spread out in any direction indefinitely with their comics\"; \"when the Web became widely popular in the mid-1990s, more people started creating comics exclusively for this medium. By the year 2000, various webcomic creators were financially successful and webcomics became more artistically recognized. Unique genres and styles became popular during this period. The 2010s also saw the rise of webtoons [comics usually meant to be read on smartphones] in South Korea, where the form has become very prominent\")"}, "madsrdf:citationSource": "Wikipedia, viewed Feb. 22, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(webcomic about a Muslim superheroine who combats Islamophobia and misogyny; comic available in English and Arabic)"}, "madsrdf:citationSource": "Work cat: Mohamed, D. Qahera, 2013-", "madsrdf:citationStatus": "found"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(webcomic; 2005 archived version of webcomic describes itself as the \"Web's only Fully Interactive, Multiple Path, Reader-Written, Death-Obsessed Comics Extravaganza\")"}, "madsrdf:citationSource": "McCloud, S. Choose your own Carl, viewed Feb. 22, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(webcomic incorporating animation and alternate links for reading in different orders)"}, "madsrdf:citationSource": "Parker, C. Argon Zark!, viewed Feb. 22, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(webcomics: \"comics by form\"; \"comics having a primary or only published format on a Web site\")"}, "madsrdf:citationSource": "Art and Architecture Thesaurus, viewed Feb. 22, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wordless infinite canvas webcomic by Swiss artist Demian5 about an Egyptian king's travels through a desert)"}, "madsrdf:citationSource": "Demian5. When I am king, viewed Feb. 22, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Charley Parker's full-color, animation-embedded, visually experimental 'Argon Zark!'\" was an early webcomics experiment with web-specific format possibilities; \"Jesse Reklaw's 'Slow Wave,' launched in 1995 and still running weekly, latched onto a smart, simple premise: readers emailed Reklaw descriptions of their dreams, and he adapted them into four-panel strips. It was a concept that would be hard to pull off without the instantaneous communication of the Web, and it presaged the importance of reader/creator back-and-forth in the webcomics world\"; webcomics experimentation continued in the 2000s: \"In 2002, Cat Garza started 'Cuentos de la Frontera,' an collection of Hispanic folk tales and urban legends adapted to explore McCloud's idea of the online 'infinite canvas.' Swiss cartoonist Demian5 published his silent infinite-canvas strip 'When I Am King' in 2001\"; webcomics continue to adapt to changing social media and app environments: \"webcartoonists are now using or building apps to distribute their comics over iPhones or other devices\")"}, "madsrdf:citationSource": "Garrity, S. The history of webcomics, Jul. 15, 2011, via Comics Journal website, viewed Feb. 22, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Begun in June of 1995, Charley Parker's Argon Zark was the first comic created specifically to be published on the World Wide Web, and it remains the longest-running\"; \"One of the more interesting aspects of the series is Parker's use of animation effects and alternate links from the comic. He was among the first to push his comics beyond the limits of what is possible on the printed page\"; Scott McCloud \"used his personal website as a place to explore all of the possibilities he imagined for using the web as a method of comics distribution, as well as being a place for experimentation. For example, using infinite canvas as a story-telling aide, having the audience participate in the creation of the comic, and using emerging technology to help ease those browser navigation blues\")"}, "madsrdf:citationSource": "The artistic history of webcomics : a Webcomics examiner roundtable, 2005, via The Webcomics examiner, viewed Feb. 22, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.o.c. p. (Building a web comic using caching; Enhancing the web comic)"}, "madsrdf:citationSource": "Alameda, E. Practical Rails projects, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72fd0314feca4831a0c91609db9c28d5b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Online comics"}}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Online comics"}}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72fd0314feca4831a0c91609db9c28d5b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "On-line comics"}}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "On-line comics"}}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72fd0314feca4831a0c91609db9c28d5b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Web comics"}}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Web comics"}}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72fd0314feca4831a0c91609db9c28d5b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Internet comics"}}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Internet comics"}}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n72fd0314feca4831a0c91609db9c28d5b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Webtoons"}}, {"@id": "_:n72fd0314feca4831a0c91609db9c28d5b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Webtoons"}}], "@id": "/authorities/genreForms/gf2022026011"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026013", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEnvironmental comics", "identifiers:lccn": "gf2022026013", "madsrdf:adminMetadata": [{"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b1"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Environmental comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b5"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b6"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b7"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b8"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b9"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b10"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b11"}], "madsrdf:hasVariant": [{"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b12"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b15"}], "madsrdf:historyNote": "[Established May 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that focus on environmental and ecological issues and the impacts of human activities on nature."}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-05-26T14:29:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-03-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Environmental comics"}}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(environmental comic; summary: \"Tells the story of Minamata disease, a debilitating and sometimes fatal condition caused by the Chisso chemical factory's careless release of methylmercury into the waters of the coastal community of Minamata in southern Japan. First identified in 1956, it became a hot topic in Japan in the 1970s and 80s, growing into an iconic struggle between people versus corporations and government agencies\")"}, "madsrdf:citationSource": "Wilson, S. M. The Minamata story : an ecotragedy, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(environmental comic; summary: \"A humorous exploration of climate change that explains the science and progression of global warming; discusses actions that have been taken to prevent or slow it down; and includes references for further investigation\")"}, "madsrdf:citationSource": "Work cat: Evans, K. Weird weather : everything you didn't want to know about climate change but should probably find out, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comics \"can be used as an educational tool when it comes to environmental issues--these are sometimes called 'eco-comics'\"; \"ecological comics\")"}, "madsrdf:citationSource": "Berry, M. From health to the environment, how comics could drive behaviour change, Feb. 7, 2022, via The Conversation website, viewed Mar. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "About (\"investigates how comics ... can disseminate knowledge about environmental problems and imagine potential solutions in accessible narratives that appeal to more diverse audiences than those reached by technical scientific research alone\")"}, "madsrdf:citationSource": "Environmental Comics Database, viewed Mar. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"With comics becoming more topical in recent years, many creators are tackling environmental causes in their work. While the titles below vary in genre and style, their message--that nature is formidable yet also fragile--remains constant. So with Earth Day coming up on April 22, here are 14 comics that cover topics from climate change to pollution, deforestation, endangered species, and more\")"}, "madsrdf:citationSource": "White, M. 14 Great environmental comics, Apr. 1, 2015, via Publishers Weekly website, viewed Mar. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 9 (\"In the 1960s and 1970s, North American governments used comic books with explicitly modern environmental themes or, as I have termed them, 'eco-comics' as part of state-sponsored environmental education programs\")"}, "madsrdf:citationSource": "McLaughlin, M. J. Rise of the eco-comics : the state, environmental education and Canadian comic books, 1971-1975, in Material culture review 77/78 (Spring/Fall 2013)", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(environmental comic; summary: \"What happens to the things we so casually throw away? In fact, much of our trash makes its way to the middle of the Pacific Ocean, where it joins one of the largest accumulations of human consumer waste on the planet. Artist and storyteller Rachel Hope Allison's debut graphic novel brings to life the plight of our oceans in a moving fable about beauty, loneliness, and hope\")"}, "madsrdf:citationSource": "Allison, R. H. I'm not a plastic bag : a graphic novel, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ecological comics"}}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ecological comics"}}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Eco-comics"}}, {"@id": "_:n1ebc1fd0cf8142b085d093ec0d433c45b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Eco-comics"}}], "@id": "/authorities/genreForms/gf2022026013"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026014", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSamples (Music)", "identifiers:lccn": "gf2022026014", "madsrdf:adminMetadata": [{"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb1"}, {"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Samples (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, "madsrdf:hasSource": [{"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb5"}, {"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb6"}], "madsrdf:hasVariant": {"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb7"}, "madsrdf:historyNote": "[Established September 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Recordings that are meant to be transposed into new recordings, either analog or digital."}, {"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-03-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-09-07T10:19:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Samples (Music)"}}, {"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection of samples to be used in MAGIX music maker)"}, "madsrdf:citationSource": "Work cat: Wave sound pool, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Sampling (\"A process in which a sound is taken directly from a recorded medium and transposed onto a new recording. At first sampling was done directly from original vinyl sources, with DJs mixing records first with other records, as part of a DJ set, and then during live performances. The most famous early example was the Sugarhill Gang's Rapper's Delight, a 15-minute single which featured rapping over a reconstituted loop of Good Times by Chic: it simultaneously introduced both rap and sampling to a worldwide audience. Double D and Steinski took sampling technique further in the early 1980s, using innumerable samples and cut-ups as the basis for their own non-rap tracks. Their influence can be heard on M/A/R/R/S's UK number one hit, Pump Up the Volume, a collection of samples (done on turntables, as was still common) overlaid on a drum machine track and bassline. Sampling technology progressed in the 1980s, with the Ensoniq Mirage (the first affordable digital sampler, 1985) and the Akai S1000 (1989) present in most recording studios. The technique was later used on rock records such as Bittersweet Symphony by the Verve, which looped a pattern sampled from a string arrangement of the Rolling Stones's As Time Goes By\")"}, "madsrdf:citationSource": "Grove Music Online, searched March 9, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sampling (Music)"}}, {"@id": "_:na0c380186f6446be8af8ccb3ef646b4cb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sampling (Music)"}}], "@id": "/authorities/genreForms/gf2022026014"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026015", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAppointment books", "identifiers:lccn": "gf2022026015", "madsrdf:adminMetadata": [{"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b1"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Appointment books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, "madsrdf:hasSource": [{"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b5"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b6"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b7"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b8"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b9"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b10"}], "madsrdf:hasVariant": [{"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b11"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b14"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b17"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b20"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b23"}], "madsrdf:historyNote": "[Established July 2022.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-03-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/hu"}, "ri:recordStatus": "new"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-07-08T14:37:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Appointment books"}}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(datebook: a small book or calendar in which one writes planned or scheduled dates, appointments, etc.)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, March 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(2002 appointment book which also includes a directory of New Caledonian and French government officials; 5 business days per page with each day further divided into 2-hour blocks with space to write appointments within them) (OCoLC)1267552880"}, "madsrdf:citationSource": "Work cat: Agenda des institutions de Nouvelle-Cal\u00e9donie, 2002, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(appointment books (preferred); variants: books, appointment; date books; engagement books; engagement calendars; note: books for recording engagements; usually containing calendars)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, March 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Appointment books; UF Appointment calendars; UF Datebooks; BT Blank-books; BT Calendars)"}, "madsrdf:citationSource": "LCSH, March 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Appointment books; UF Engagement books; BT Record-keeping works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, March 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Engagement books"}}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Engagement books"}}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Engagement calendars"}}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Engagement calendars"}}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Appointment calendars"}}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Appointment calendars"}}, {"@id": "_:n4468a28c50c1480681b8e52d4fc297b0b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4468a28c50c1480681b8e52d