{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026377", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n70606b4e009544859a27e9257e548216b1"}, {"@id": "_:n70606b4e009544859a27e9257e548216b2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is covered by the genre/form term {Globes} (gf2011026300)."}, "madsrdf:elementList": {"@list": [{"@id": "_:n70606b4e009544859a27e9257e548216b3"}]}, "madsrdf:useInstead": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026300"}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lunar globes"}}, {"@id": "_:n70606b4e009544859a27e9257e548216b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n70606b4e009544859a27e9257e548216b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-06-13T12:12:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n70606b4e009544859a27e9257e548216b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lunar globes"}}], "@id": "/authorities/genreForms/gf2011026377"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026378", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLyrical films", "identifiers:lccn": "gf2011026378", "madsrdf:adminMetadata": [{"@id": "_:n99749c4d6c764bbdb322124ab7004a0db1"}, {"@id": "_:n99749c4d6c764bbdb322124ab7004a0db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lyrical films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n99749c4d6c764bbdb322124ab7004a0db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026235"}, "madsrdf:hasSource": [{"@id": "_:n99749c4d6c764bbdb322124ab7004a0db5"}, {"@id": "_:n99749c4d6c764bbdb322124ab7004a0db6"}, {"@id": "_:n99749c4d6c764bbdb322124ab7004a0db7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films in which the images and other content are presented as subjective experiences as seen through the eyes of the filmmaker.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025608"}}, {"@id": "_:n99749c4d6c764bbdb322124ab7004a0db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T07:06:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n99749c4d6c764bbdb322124ab7004a0db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n99749c4d6c764bbdb322124ab7004a0db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lyrical films"}}, {"@id": "_:n99749c4d6c764bbdb322124ab7004a0db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 355 (Lyrical film; Lyrical cinema: the lyrical form is a style of film composition developed by Stan Brakhage in which the filmmaker, behind the camera, makes his presence felt and portrays himself as the inspirational force behind the images that appear in his film)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n99749c4d6c764bbdb322124ab7004a0db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 160 (The lyrical film postulates the film-maker behind the camera as the first-person protagonist of the film. The images of the film are what he sees, filmed in such a way that we never forget his presence and we know how he is reacting to his vision)"}, "madsrdf:citationSource": "Sitney, P. Adams Visionary film, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n99749c4d6c764bbdb322124ab7004a0db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lyrical: a term used by P. Adams Sitney to describe films that present the subjective eye of the filmmaker: the viewer sees what the filmmaker sees. There is a feeling of gestural motion created by the camera movements and also through the editing)"}, "madsrdf:citationSource": "Moving image genre-form guide online, June 4, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026378"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026379", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMachinima films", "identifiers:lccn": "gf2011026379", "madsrdf:adminMetadata": [{"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb1"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Machinima films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026049"}, "madsrdf:hasSource": [{"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb5"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb6"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb7"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb8"}], "madsrdf:hasVariant": [{"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb9"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb12"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025339"}}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:31:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Machinima films"}}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Machinima, a portmanteau of machine cinema or machine animation, is both a collection of associated production techniques and a film genre.... the term concerns the rendering of computer-generated imagery (CGI) using real-time, interactive (game) 3D engines, as opposed to high-end and complex 3D animation software used by professionals. Engines from first person shooter video games are typically used. ... the rendering can be done in real-time using PCs (either using the computer of the creator or the viewer), rather than with complex 3D engines using huge render farms)"}, "madsrdf:citationSource": "Wikipedia, Aug. 31, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Machinima films, new genre, people shoot films in real-time 3D virtual environments. The actors aren't human, but virtual Avatars or Objects, controlled by user input or scripting and act in a virtual world that is simulated using a computer game. Thus, machinima is a mix of three ways to produce moving images: machine, animation, cinema. The term machinima is constructed from these three words, like this: machine + animation + cinema, pronounced mashinima)"}, "madsrdf:citationSource": "CIANT, Sept. 19, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "3D game-based filmmaking : the art of machinima, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (Machinima is filmmaking within real-time, 3D virtual environments, often appropriated from existing video game engines)"}, "madsrdf:citationSource": "Machinima archive, Aug. 31, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "3D game-based films"}}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "3D game-based films"}}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "3D game-based animated films"}}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "3D game-based animated films"}}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Machinimas (Motion pictures)"}}, {"@id": "_:nd2dfd9dab6c54916993b6df07541d59cb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Machinimas (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2011026379"}
