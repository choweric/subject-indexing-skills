al"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Booklets that provide a description of a performance and its cast and crew, and are typically distributed to audience members. For posters or single-sheet programs advertising a theatrical performance, usually listing the cast, see [Playbills (Posters).]"}, {"@id": "_:n46cec014492940bb83cab11913f18436b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:28:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n46cec014492940bb83cab11913f18436b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n46cec014492940bb83cab11913f18436b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theater programs"}}, {"@id": "_:n46cec014492940bb83cab11913f18436b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Theater programs, BT Programs, RT Playbills; Playbills, BT Broadsides, BT Posters, RT Theater programs)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: Play programs : scrapbook, 1892-1897; Cherry County Playhouse (Traverse City, Mich.). Play programs, 1956, 2003; Bowling Green State University. Theatre Department. Play programs. Southeastern Louisiana University. Department of Music and Dramatic Arts. Drama programs)"}, "madsrdf:citationSource": "OCLC, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill: a program or announcement of a play)"}, "madsrdf:citationSource": "Dictionary.com, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 63 (playbill: poster announcing a play; (US) theatre programme)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Theater programs. Booklets with descriptions of performances and performers. BT Programs. RT Playbills; Playbills. Programs printed on one sheet for plays or theatrical entertainments. BT Broadsides. RT Theater programs, RT Theatrical posters)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill. 1. a poster or circular advertising a play. 2. a program of a play, listing the cast, staff, etc.)"}, "madsrdf:citationSource": "Webster's new world college dictionary, via WWW, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill 1. A poster announcing a theatrical performance. 1.1. North American: A theater program)"}, "madsrdf:citationSource": "Oxford dictionaries website, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill 1 a printed notice advertising a play 2 (North American English) a theatre programme)"}, "madsrdf:citationSource": "Oxford learner's dictionaries website, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill: 1. a poster or bill advertising a play 2. the programme of a play)"}, "madsrdf:citationSource": "Collins English dictionary - complete & unabridged 10th edition, via WWW, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Programme (booklet). A programme or program is a booklet available for patrons attending a live event such as theatre performances, f\u00eates, sports events, etc. It is a printed leaflet outlining the parts of the event scheduled to take place, principal performers and background information. In the case of theatrical performances, the term playbill is also used.)"}, "madsrdf:citationSource": "Wikipedia, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Theater programs. BT Programs. RT Playbills. RT Plays; Playbills. Use for single-sheet items advertising plays, usually announcing the cast. BT Broadsides. RT Cast lists. RT Plays. RT Theater programs)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill: a poster or piece of paper that advertises a play)"}, "madsrdf:citationSource": "Merriam-Webster online, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(playbill: A printed poster or circular advertising the performance of a play, usually indicating the names of the actors and actresses cast in the leading roles. Also, a program for a play or other theatrical entertainment, printed on a single sheet)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, via WWW, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(theater programs. UF programs, theater; theatre programmes; programmes, theatre)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n46cec014492940bb83cab11913f18436b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n46cec014492940bb83cab11913f18436b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Theatrical playbills (Programs)"}}, {"@id": "_:n46cec014492940bb83cab11913f18436b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theatrical playbills (Programs)"}}, {"@id": "_:n46cec014492940bb83cab11913f18436b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n46cec014492940bb83cab11913f18436b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Theater playbills (Programs)"}}, {"@id": "_:n46cec014492940bb83cab11913f18436b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theater playbills (Programs)"}}, {"@id": "_:n46cec014492940bb83cab11913f18436b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n46cec014492940bb83cab11913f184