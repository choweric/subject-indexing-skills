{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026726", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aConductus", "identifiers:lccn": "gf2014026726", "madsrdf:adminMetadata": [{"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b1"}, {"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Conductus"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b5"}, {"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b6"}], "madsrdf:hasVariant": {"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Conductus"}}, {"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Oct. 12, 2001 (conductus (pl. conductus, conducti): medieval song with serious, usually sacred, text in Latin verse; seems to have originated in south of France near end of 12th cent.; taken up by Parisian composers of Notre Dame, flourished with great brilliance ca. 1160-1240; superseded in 2nd half of 13th cent. by the motet; handful of new conductus from 14th cent. are peripheral, chiefly German in origin)", "madsrdf:citationStatus": "found"}, {"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Harvard dict. music (conductus (pl. conductus or conducti): medieval song for one or more voices with serious, most often sacred, text in rhythmical Latin verse)", "madsrdf:citationStatus": "found"}, {"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Conducti"}}, {"@id": "_:ncfa7b599cd2047049faf6b4013ba8e68b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Conducti"}}], "@id": "/authorities/genreForms/gf2014026726"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026727", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCongadas (Music)", "identifiers:lccn": "gf2014026727", "madsrdf:adminMetadata": [{"@id": "_:n184bf150fd194784bea251cc7509d328b1"}, {"@id": "_:n184bf150fd194784bea251cc7509d328b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Congadas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n184bf150fd194784bea251cc7509d328b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}], "madsrdf:hasSource": [{"@id": "_:n184bf150fd194784bea251cc7509d328b5"}, {"@id": "_:n184bf150fd194784bea251cc7509d328b6"}, {"@id": "_:n184bf150fd194784bea251cc7509d328b7"}], "madsrdf:hasVariant": {"@id": "_:n184bf150fd194784bea251cc7509d328b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n184bf150fd194784bea251cc7509d328b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n184bf150fd194784bea251cc7509d328b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n184bf150fd194784bea251cc7509d328b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Congadas (Music)"}}, {"@id": "_:n184bf150fd194784bea251cc7509d328b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "entry for congada (variant of \"congado\") entry for congado (ceremonial Afro-Brazilian dance in which the participants represent the coronation of the king of the Congo)"}, "madsrdf:citationSource": "Michaelis moderno dicionario da lingua portuguesa, c1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n184bf150fd194784bea251cc7509d328b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Congado)"}, "madsrdf:citationSource": "Ouro Preto da Palavra, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n184bf150fd194784bea251cc7509d328b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Afro-Brazilian traditions, page 340 (Dramatic dances...Originating in missionaries' activities during the early colonization of the country, dramatic dances (bailados) have survived in contemporary Afro-Brazilian communities. These dances include processions and actual dramatic representation, with numerous characters, spoken dialogues, songs, and dances, accompanied by small instrumental ensembles. The major themes of such dramatic dances relate to the Iberian medieval catechistic theater, including conversion, resurrection, and battle scenes between Christians and infidels (Moors). Among significant dramatic dances enacted by Afro-Brazilians are the bumba-meu-boi, congada, congo, marujada, and taieira, all known by many different local names.)"}, "madsrdf:citationSource": "Garland encyclopedia of world music. Volume 2, South America, Mexico, Central America and the Caribbean:", "madsrdf:citationStatus": "found"}, {"@id": "_:n184bf150fd194784bea251cc7509d328b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n184bf150fd194784bea251cc7509d328b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Congados (Music)"}}, {"@id": "_:n184bf150fd194784bea251cc7509d328b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Congados (Music)"}}], "@id": "/authorities/genreForms/gf2014026727"}
