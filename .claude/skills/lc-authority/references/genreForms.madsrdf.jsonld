": "Use surveys, Visitor"}}, {"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Use surveys, Visitor"}}, {"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surveys, Visitor"}}, {"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surveys, Visitor"}}, {"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surveys, Visitation"}}, {"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surveys, Visitation"}}, {"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Visitation surveys"}}, {"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Visitation surveys"}}, {"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surveys, Visitor use"}}, {"@id": "_:n66cf9593ec21419fa31e5d07394f2b6db30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surveys, Visitor use"}}], "@id": "/authorities/genreForms/gf2023026095"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026096", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBoys love (Manga)", "identifiers:lccn": "gf2023026096", "madsrdf:adminMetadata": {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b1"}, "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Boys love (Manga)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na968eeb6b565477cbf45ef20825c6e17b2"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026036"}, "madsrdf:hasSource": [{"@id": "_:na968eeb6b565477cbf45ef20825c6e17b4"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b5"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b6"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b7"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b8"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b9"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b10"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b11"}], "madsrdf:hasVariant": [{"@id": "_:na968eeb6b565477cbf45ef20825c6e17b12"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b15"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b18"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b21"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b24"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b27"}], "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-10-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b2", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Boys love (Manga)"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b4", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "back cover (\"June - Yaoi/Comedy/Romance\") (OCoLC)869895138"}, "madsrdf:citationSource": "Junko. Mr. mini mart, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 50 (prior term for BL is \"tanbi\": \"a euphemistic application of the literary term originally coined to refer to authors with signature aesthetic styles\")"}, "madsrdf:citationSource": "Mizoguchi, A. Male-male romance by and for women in Japan : a history and the subgenres of yaoi fictions, in U.S.-Japan women's journal, v. 25 (2003):", "madsrdf:citationStatus": "found"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Boys' love cooked to perfection. Eating around other people is a struggle for salaryman Yutaka, despite his talent for cooking. All that changes when he meets Minoruand Tane -- two brothers, many years apart in age -- who ask him to teach them how to make his delicious food! It's not long before Yutaka finds himself falling hard for the meals they share together -- and falling in love!\") (OCoLC)1130745597"}, "madsrdf:citationSource": "Work cat: Ori, M. Our dining table, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (boys love titles share stylistic elements) like depicting the romantic leads as \"beautiful, stylish male characters,\" also known as \"bish\u014dnen\"; \"BL is only tangentially connected with the lives of actual gay men\") p. 5 (a prior term for BL is \"sh\u014dnen'ai\": \"combines 'boy' (sh\u014dnen) and'love' (ai)\" and has \"largely fallen out of favor\"; another past term is \"yaoi\": a self-mocking \"acronym for yamanashi, ochi nashi, imi nashi (which might be translated as 'no climax, no point, no meaning')\"; \"'boys love' caughton as a generic label over the course of the 1990s, and the term was eventually rendered into katakana as 'b\u014dizurabu' and shortened to 'BL'\"; another past term is \"JUNE\": derived \"from the title of a commercial BL magazine published from the late 1970s to the mid-1990s\") p. 11 (BL plots rely on romance fiction tropes, like the expectation of a happy ending) p. 15 (BL plots don't realistically depict gay men, as protagonists often display \"an exclusive attraction to each other (that is, they are not attracted to men in general)\"; protagonists are presented as androgynous or \"feminized\") (OCoLC)878837806"}, "madsrdf:citationSource": "Boys love manga and beyond, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 135 (\"Boy's love, the literal translation of shonen-ai known by the acronym BL, is the most common and inclusive term, covering all levels of romance and explicitness\"; boys love stories are understood to be a \"subgenre of romance\" and not realistic depictions of gay life) (OCoLC)85898238"}, "madsrdf:citationSource": "Brenner, R. Understanding manga and anime, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"yaoi is largely considered an outdated term and has been primarily replaced with Boy's Love within recent years\"; term sh\u014dnen'ai is also \"outdated\"; \"Boy's Love ... protagonists seldom refer to themselves ortheir partners as homosexual, or gay, queer, ... nor do they typically explore the realities of living life as a queer person\"; BL stories contain a \"strict focus on the romance and sexual escapades of the leads\" to further the plot, with plot tensions deriving from emotional and psychological obstacles within the relationship, rather than physical or external conflicts)"}, "madsrdf:citationSource": "Pagan, A. Beginner's guide to LGBTQ+ manga, Jun. 17, 2019, via the New York Public Library blog, viewed Jun.21, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xv-xvi (BL titles are traditionally \"written by women,\" \"aimed at a female audience\" and do not depict \"realistic representations of homosexual life\"; not all BL love romances are sexually focused; like other romance stories, they \"range in content from mild and extremely fluffy to explicit\") (OCoLC)729344485"}, "madsrdf:citationSource": "Kalen, E.F.S. Mostly manga, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)65423867"}, "madsrdf:citationSource": "Hawke, M. Tempestuous : a Shounen-ai fantasy, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na968eeb6b565477cbf45ef20825c6e17b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "JUNE manga"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "JUNE manga"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na968eeb6b565477cbf45ef20825c6e17b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sh\u014dnen-ai manga"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sh\u014dnen-ai manga"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na968eeb6b565477cbf45ef20825c6e17b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yaoi manga"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yaoi manga"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na968eeb6b565477cbf45ef20825c6e17b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tanbi manga"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tanbi manga"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na968eeb6b565477cbf45ef20825c6e17b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "BL manga"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "BL manga"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na968eeb6b565477cbf45ef20825c6e17b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shounen-ai manga"}}, {"@id": "_:na968eeb6b565477cbf45ef20825c6e17b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shounen-ai manga"}}], "@id": "/authorities/genreForms/gf2023026096"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026101", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRigaudons (Dance)", "identifiers:lccn": "gf2023026101", "madsrdf:adminMetadata": [{"@id": "_:ne395c892dd874a6cabb4c404c818ac4db1"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rigaudons (Dance)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne395c892dd874a6cabb4c404c818ac4db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026008"}], "madsrdf:hasSource": [{"@id": "_:ne395c892dd874a6cabb4c404c818ac4db5"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db6"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db7"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db8"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db9"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db10"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db11"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db12"}], "madsrdf:hasVariant": [{"@id": "_:ne395c892dd874a6cabb4c404c818ac4db13"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db16"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db19"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db22"}], "madsrdf:historyNote": "[Established February 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-10-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "new"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-02-04T11:18:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rigaudons (Dance)"}}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 258 (The rigaudon (also rigadoon, rigadone, or rigadon), a springy solo or capricious couples quickstep in 2/2 or 4/4 time, dates to Mediterranean sailors or the agrarian French from 1485 at the village of Gap (or Gavots), Dauphin\u00e9, in southeastern France. Peasant performance featured sentimental tunes and gestures of head and arms to taps on the tambourine, a relief from the more sober gavotte. Dancers accentuated diagonal and lateral capers in the style of the Hungarian czardas; the standard rigaudon (...). The rigaudon flourished in Paris after 1643 in a more aristocratic style of Louis XIV, the father of classical ballet, and became a standard part, along with the minuet, of aristocratic children's education in the arts.)"}, "madsrdf:citationSource": "The encyclopedia of world folk dance, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rigaudon; also spelled Rigadoon; sprightly 17th-century French folk dance for couples. Its hopping steps were adopted by the skillful dancers of the French and English courts, where it remained fashionable through the 18th century. Conjecture assigns its origins to Proven\u00e7al sailors and its name to a Marseille dance master, Rigaud, who reputedly introduced the dance to Parisian society in 1630. As a court dance, it was performed by dancers who ran, turned, and repeated in place a series of jumping steps)"}, "madsrdf:citationSource": "Britannica online, viewed October 18, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (Engraven in characters & figures for ye use of masters writ by Mr. de la Garde dancing master) (OCoLC)728418142"}, "madsrdf:citationSource": "Work cat: The rigadoon royal Mr. Isaac's new dance made for Her Majestys birth day 1711, 1711?:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rigaudon, rigodon [Fr., Eng., rigadoon]. A cheerful Baroque dance movement in duple meter)"}, "madsrdf:citationSource": "Harvard dictionary of music (4th ed.), via Credo reference, viewed October 10, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rigaudon; also spelled rigadon or rigadoon in English usage; [dance] popular at the French court of Louis XIV from about the 1670s; from there it spread to other European courts and cities, especially in England and Germany; enjoyed both as a social dance and as a ballet entr\u00e9e, and in the form of both instrumental and vocal music, reflecting the elegance of the court in a lively though controlled manner)"}, "madsrdf:citationSource": "The international encyclopedia of dance, via Oxford Reference, viewed October 4, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rigaudon; rigadon; rigadoon; a French folkdance, court dance and instrumental form popular in France and England in the 17th and 18th centuries; as a folk dance it was traditionally associated with southern France, especially the provinces of Vavarais, Languedoc, Dauphin\u00e9 and Provence, although the term is now used to refer to a wide variety of folkdances from several regions; it is not certain that any of the folk rigaudons were related to the court dance that gained popularity during the reign of Louis XIV)"}, "madsrdf:citationSource": "Grove music online, viewed October 17, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 80 (Rigadon by Mr. Kellom; danced by Mrs. Scholding in the Island princess May 10th 1716)"}, "madsrdf:citationSource": "A work book by Kellom Tomlinson, \u00a91992:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rigaudon: A couple dance in lively duple time, dating from 15th-century Provence and named after a dancing master from Marseilles. It became popular at the court of Louis XIV from the 1670s and spread to most of the courts of Europe. Couples dance side by side without holding hands, executing at certain moments the distinctive, springing step, the pas de rigaudon)"}, "madsrdf:citationSource": "The Oxford dictionary of dance (2 ed.), via Oxford reference, viewed October 4, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne395c892dd874a6cabb4c404c818ac4db14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rigadones (Dance)"}}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rigadones (Dance)"}}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne395c892dd874a6cabb4c404c818ac4db17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rigadons (Dance)"}}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rigadons (Dance)"}}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne395c892dd874a6cabb4c404c818ac4db20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rigodons (Dance)"}}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rigodons (Dance)"}}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne395c892dd874a6cabb4c404c818ac4db23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rigadoons (Dance)"}}, {"@id": "_:ne395c892dd874a6cabb4c404c818ac4db23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rigadoons (Dance)"}}], "@id": "/authorities/genreForms/gf2023026101"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026105", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSatirical fiction", "identifiers:lccn": "gf2023026105", "madsrdf:adminMetadata": [{"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b1"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Satirical fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026377"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026525"}], "madsrdf:hasSource": [{"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b5"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b6"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b7"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b8"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b9"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b10"}], "madsrdf:hasVariant": [{"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b11"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b14"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b17"}], "madsrdf:historyNote": "[Established February 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-02-22T14:17:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-10-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical fiction"}}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a satirical novel) (OCoLC)43227336"}, "madsrdf:citationSource": "Work cat.: Monahan, William. Light house, \u00a92000", "madsrdf:citationStatus": "found"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(satire, artistic form, chiefly literary and dramatic, in which human or individual vices, follies, abuses, or shortcomings are held up to censure by means of ridicule, derision, burlesque, irony, parody, caricature, or other methods, sometimes with an intent to inspire social reform; Jonathan Swift's excoriation of all civilized institutions in Gulliver's Travels; the fictions of Nikolay Gogol and of Jane Austen and the satirical utopias of Yevgeny Zamyatin, Aldous Huxley, and George Orwell)"}, "madsrdf:citationSource": "Britannica online, Oct. 9, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Satirical Fiction Genre: stories that target and attack bad habits and vices through humor; the stories contain irony, wit, and sarcasm while bringing to light the vices, follies, abuses, and shortcomings in human nature)"}, "madsrdf:citationSource": "The book genre dictionary, via WWW, Oct. 9, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(To be satire, a novel has to use humor, irony, and exaggeration to critique something or someone; satiric novels can have so, so many different subjects. They can criticize politics, academia, a particular social class, or certain attitudes about race. They can critique widely known subcultures, such as sports, schools, political campaigns, or workplaces; satiric novels all excel at making readers think while they laugh and laugh while they think. Even if the laughter is more of a pained wince, satires are comedic in nature. They set out to surprise and delight with their insights into the absurdity of humans; Oreo by Fran Ross; The Sellout by Paul Beatty; Temporary by Hilary Leichter; Moo by Jane Smiley: notable subcategory within satiric fiction: the academic satire; Straight Man by Richard Russo; Cold Comfort Farm by Stella Gibbons; Interior Chinatown by Charles Yu: satirizes Hollywood, pop culture, and racial stereotypes; Northanger Abbey by Jane Austen: satire of gothic literature and those dangerously obsessed with it)"}, "madsrdf:citationSource": "Hussey, Rebecca. 8 great satiric novels, via Book riot website, posted Nov. 4, 2021, viewed Oct. 9, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Satire is loosely defined as art that ridicules a specific topic in order to provoke readers into changing their opinion of it. By attacking what they see as human folly, satirists usually imply their own opinions on how the thing being attacked can be improved. Perhaps the most famous work of British satire is Jonathan Swift's Gulliver's Travels (1726), where the inhabitants of the different lands Gulliver visits embody what Swift saw as the prominent vices and corruptions of his time. Like Gulliver's Travels, George Orwell's Animal Farm is a satirical novel in which Orwell, like Swift, attacks what he saw as some of the prominent follies of his time)"}, "madsrdf:citationSource": "What is a satirical novel?, via CliffsNotes website, Oct. 9, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Monahan's satirical first novel )"}, "madsrdf:citationSource": [{"@id": "https://www.publishersweekly.com/978-1-57322-158-0"}, "Publishers weekly review of Light house, viewed online Oct. 9, 2023"], "madsrdf:citationStatus": "found"}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric fiction"}}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric fiction"}}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satires (Fiction)"}}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satires (Fiction)"}}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satirical novels"}}, {"@id": "_:n965869fa27ce4f4491beab9cd7616ed2b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical novels"}}], "@id": "/authorities/genreForms/gf2023026105"}
