:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legal fiction (Literature)"}}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCGFT, Oct. 22, 2014 (Legal films. UF Courtroom films; Law films; Lawyer films; Trial films)", "madsrdf:citationStatus": "found"}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 141 (Legal thrillers are crime stories featuring a lawyer, law student, or judge as the main character. Although they include some detective work, typically these courtroom dramas involve the ingenuity of the attorney in extricating himself or/ herself from a setup or significant legal troubles threatening his or her law firm and personal integrity.)"}, "madsrdf:citationSource": "Herald, D. Genreflecting, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Legal stories: Use for novels that deal with the law, legal procedure, lawyers, judges, etc. UF Courtroom fiction, Courtroom stories.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trial fiction"}}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trial fiction"}}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Law fiction (Literature)"}}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Law fiction (Literature)"}}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Courtroom fiction"}}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Courtroom fiction"}}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Legal thrillers (Fiction)"}}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legal thrillers (Fiction)"}}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lawyer fiction"}}, {"@id": "_:n90a12f2e9bf14e3b9ccfc6115ade770eb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lawyer fiction"}}], "@id": "/authorities/genreForms/gf2014026406"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026407", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLegends", "identifiers:lccn": "gf2014026407", "madsrdf:adminMetadata": [{"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b1"}, {"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Legends"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026342"}, "madsrdf:hasSource": [{"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b5"}, {"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b6"}, {"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Traditional narratives that are popularly regarded as historical and that generally feature famous or heroic people."}, {"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:34:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legends"}}, {"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Legend: A story, part fact and part fiction, about the life and deeds of a saint, folk hero, or historical figure, that is handed down from generation to generation and is popularly accepted as true. A legend differs from a myth in concerning itself less with the supernatural.)"}, "madsrdf:citationSource": "Morner, K. NTC's dictionary of literary terms, c1991", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Legend: an anonymous tale about a famous and heroic man or woman that has been handed down as part of oral tradition. The truth behind the story is impossible to affirm and the stories would be changed according to the imagination and interest of the storyteller. As time progressed, these legends became exaggerated and farfetched)"}, "madsrdf:citationSource": "Ruse, C. The Cassell dictionary of literary and language terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0bff4fa1b23491893a5304d47e636d6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Legends. Use for works of traditional narrative, especially those handed down from early times and popularly regarded as historical. Legends are generally about an individual figure, e.g. Robin Hood, the Flying Dutchman, Faust.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026407"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026408", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLenong plays", "identifiers:lccn": "gf2014026408", "madsrdf:adminMetadata": [{"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b1"}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lenong plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, "madsrdf:hasSource": [{"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b5"}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b6"}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b7"}], "madsrdf:hasVariant": [{"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b8"}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b11"}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Folk plays of the Betawi people of Jakarta, Indonesia."}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-13T15:33:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lenong plays"}}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 1-2 (The language of the Betawi people, Jakarta Malay, still exists independently of the modern forms of 'Jakarta Indonesian', with which it is sometimes popularly identified; this language became the medium for a distinct form of community theatre, known as lenong; Traditionally, performances were all night affairs, held to enliven the atmosphere of community or family rituals. The musical accompaniment to the play was provided by the distinctive Betawi gambang kromong orchestra. The stories performed were either historical tales known in Betawi folklore, or original compositions) p. 4 (lenong plays)"}, "madsrdf:citationSource": "Foulcher, K. Community and the metropolis : lenong, Nyai Dasima, and the new New Order, 2004, viewed online Nov. 16, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lenong Theater: This type of folk theater is among the most popular Betawi art forms. There are two kinds of lenong: lenong dedes and lenong preman. The stories of lenong dedes are about royalty and are told in polite language. Lenong preman stories are about ordinary people and told in everyday language. They are therefore more popular because the audience can easily relate to them. Lenong stories usually have a moral.)"}, "madsrdf:citationSource": "Betawi culture for dummies, via Jakarta globe, June 20, 2009, viewed online Nov. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lenong plays)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lenong dedes drama"}}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lenong dedes drama"}}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lenong drama"}}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lenong drama"}}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lenong preman drama"}}, {"@id": "_:ndd01fc92304b4b158be53a20b3aad4b6b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lenong preman drama"}}], "@id": "/authorities/genreForms/gf2014026408"}
