madsrdf:variantLabel": {"@language": "en", "@value": "Clogging music"}}, {"@id": "_:nca7df5ae62194541b566a154af3fcf56b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Clogging music"}}], "@id": "/authorities/genreForms/gf2014026720"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026721", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCommunion service music", "identifiers:lccn": "gf2014026721", "madsrdf:adminMetadata": [{"@id": "_:nae800cabfc1a44ef9e810f6a51deb8c4b1"}, {"@id": "_:nae800cabfc1a44ef9e810f6a51deb8c4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Communion service music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nae800cabfc1a44ef9e810f6a51deb8c4b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasSource": {"@id": "_:nae800cabfc1a44ef9e810f6a51deb8c4b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music composed for the Anglican or Episcopalian communion service."}, {"@id": "_:nae800cabfc1a44ef9e810f6a51deb8c4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:00:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nae800cabfc1a44ef9e810f6a51deb8c4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nae800cabfc1a44ef9e810f6a51deb8c4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Communion service music"}}, {"@id": "_:nae800cabfc1a44ef9e810f6a51deb8c4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Anglican and Episcopalian music (...the Act of Uniformity (1549) imposed a uniform service book in English, the Book of Common Prayer, for use throughout the country. Two Offices, Matins and Evensong, replaced the eight of monastic tradition, while the Mass was revised as a Communion service... Many of the texts of pre-Reformation polyphony - graduals, alleluias, tracts, sequences, antiphons, responsories - disappeared almost without trace, but much remained in translated form.)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026721"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026722", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCompline music", "identifiers:lccn": "gf2014026722", "madsrdf:adminMetadata": [{"@id": "_:n406c851d70054e85adaaf647f5455715b1"}, {"@id": "_:n406c851d70054e85adaaf647f5455715b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Compline music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n406c851d70054e85adaaf647f5455715b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026769"}, "madsrdf:hasSource": [{"@id": "_:n406c851d70054e85adaaf647f5455715b5"}, {"@id": "_:n406c851d70054e85adaaf647f5455715b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n406c851d70054e85adaaf647f5455715b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n406c851d70054e85adaaf647f5455715b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n406c851d70054e85adaaf647f5455715b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Compline music"}}, {"@id": "_:n406c851d70054e85adaaf647f5455715b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kurtzmann, Geoffrey G. Vesper and Compline music for eight principal voices, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:n406c851d70054e85adaaf647f5455715b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Compline; one of the services of the Divine Office; traditionally performed at the end of the day)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026722"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026723", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aConcert etudes", "identifiers:lccn": "gf2014026723", "madsrdf:adminMetadata": [{"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb1"}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Concert etudes"}, "madsrdf:elementList": {"@list": [{"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb3"}]}, "madsrdf:exampleNote": "Note under [Studies (Music)]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027115"}, "madsrdf:hasSource": [{"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb5"}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb6"}], "madsrdf:hasVariant": [{"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb7"}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb10"}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Instrumental pieces designed for performance in order to exploit a facet of performing technique. For musical works and exercises designed for practice with the aim of perfecting a facet of performing technique see [Studies (Music).]"}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-19T14:19:33"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Concert etudes"}}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Etude (the French equivalent of 'study', widely adopted for fairly short pieces whose principal aim is the development or exploitation of a particular aspect of performing technique; the term was also used as a title by some 20th-century composers, usually to indicate a piece exploring a specific aspect of the composer's craft) Study (The concert study attempts to combine the utility of a technical exercise with musical invention equivalent to that of other genres in the concert repertory)"}, "madsrdf:citationSource": "Grove music online, viewed April 1, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(concert \u00e9tude; a particularly brilliant instrumental composition evolved from a single technical motive)"}, "madsrdf:citationSource": "Merriam-Webster WWW site, viewed April 1, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Studies, Concert"}}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Studies, Concert"}}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Etudes, Concert"}}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Etudes, Concert"}}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Concert studies"}}, {"@id": "_:nee1408e5c8a64ef192a3ec44f8c8b0ebb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Concert studies"}}], "@id": "/authorities/genreForms/gf2014026723"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026724", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aConcerti grossi", "identifiers:lccn": "gf2014026724", "madsrdf:adminMetadata": [{"@id": "_:n9dfacb3977874ef09049f6fd5fbbd09eb1"}, {"@id": "_:n9dfacb3977874ef09049f6fd5fbbd09eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Concerti grossi"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9dfacb3977874ef09049f6fd5fbbd09eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026725"}, "madsrdf:hasSource": {"@id": "_:n9dfacb3977874ef09049f6fd5fbbd09eb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9dfacb3977874ef09049f6fd5fbbd09eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n9dfacb3977874ef09049f6fd5fbbd09eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9dfacb3977874ef09049f6fd5fbbd09eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Concerti grossi"}}, {"@id": "_:n9dfacb3977874ef09049f6fd5fbbd09eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Concerto grosso. Generally, a type of concerto in which a large group (known as the 'ripieno' or the 'concerto grosso') alternates with a smaller group (the 'concertino')."}, "madsrdf:citationSource": "Grove music online, viewed August 9, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026724"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026725", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aConcertos", "identifiers:lccn": "gf2014026725", "madsrdf:adminMetadata": [{"@id": "_:n4466bd178a98429088089c28e89cc13fb1"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Concertos"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4466bd178a98429088089c28e89cc13fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026724"}, "madsrdf:hasSource": [{"@id": "_:n4466bd178a98429088089c28e89cc13fb5"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb6"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb7"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb8"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb9"}], "madsrdf:hasVariant": [{"@id": "_:n4466bd178a98429088089c28e89cc13fb10"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb13"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb16"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb19"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb22"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb25"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb28"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb31"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb34"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb37"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-06-23T12:31:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "revised"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Concertos"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Symphonie concertante (A concert genre of the late 18th and early 19th centuries for solo instruments--usually two, three or four, but on occasion as many as seven or even nine--with orchestra; Attempts at explicating the term 'symphonie concertante' have foundered on two counts: first, on the confusion between the adjective 'concertante', loosely employed in the 18th century, and the noun-complex 'symphonie concertante', which refers to a specific genre; and secondly, on the difference between works called 'symphonie concertante' and those, also with more than one solo instrument, called 'concerto for two [three, four] instruments')"}, "madsrdf:citationSource": "Grove music online, March 8, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(concerto plural concerti or concertos: a piece for one or more soloists and orchestra with three contrasting movements)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Apr. 13, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Symphonie concertante (sinfonia concertante; in the 18th and early 19th centuries, a type of concerto for two or more solo instruments (normally strings or winds) and orchestra)"}, "madsrdf:citationSource": "The Harvard dictionary of music, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Janssens, R. Concerti, p2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Concerto. An instrumental work that maintains contrast between an orchestral ensemble and a smaller group or a solo instrument, or among various groups of an undivided orchestra)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4466bd178a98429088089c28e89cc13fb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Symphonies concertantes"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Symphonies concertantes"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4466bd178a98429088089c28e89cc13fb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sinfonie concertante"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sinfonie concertante"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4466bd178a98429088089c28e89cc13fb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sinfonie concertanti"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sinfonie concertanti"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4466bd178a98429088089c28e89cc13fb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Simphonies concertantes"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Simphonies concertantes"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4466bd178a98429088089c28e89cc13fb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Symphonie concertante"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Symphonie concertante"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4466bd178a98429088089c28e89cc13fb26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Simphonie concertante"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Simphonie concertante"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4466bd178a98429088089c28e89cc13fb29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sinfonies concertantes"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sinfonies concertantes"}}, {"@id": "_:n4466bd178a98429088089c28e89cc13fb31", "@