Value": {"@language": "en", "@value": "Reproaches (Chants)"}}, {"@id": "_:n3481bc4a7f4d4779a709786847c60eafb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Marshall, W. The passion of Christ : reflections on the Good Friday reproaches, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3481bc4a7f4d4779a709786847c60eafb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Cath. encyc.: v. 7, p. 407 (Improperia)", "madsrdf:citationStatus": "found"}, {"@id": "_:n3481bc4a7f4d4779a709786847c60eafb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Feb. 24, 2011: Reproaches [Improperia] (A series of chants sung on Good Friday during the Veneration of the Cross, the texts of which tell of God's generosity to his chosen people and man's faithlessness.)", "madsrdf:citationStatus": "found"}, {"@id": "_:n3481bc4a7f4d4779a709786847c60eafb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3481bc4a7f4d4779a709786847c60eafb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Improperia"}}, {"@id": "_:n3481bc4a7f4d4779a709786847c60eafb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Improperia"}}], "@id": "/authorities/genreForms/gf2014027047"}
