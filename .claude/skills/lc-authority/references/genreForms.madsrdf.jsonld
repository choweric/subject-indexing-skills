Info", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb1b3fd1b202d45e2bf232de273548d5cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Beauty contest television programs"}}, {"@id": "_:nb1b3fd1b202d45e2bf232de273548d5cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Beauty contests)"}, "madsrdf:citationSource": "LCSH, April 7, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1b3fd1b202d45e2bf232de273548d5cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beauty contest: a competition in which the entrants, usually women, are judged as to physical beauty and sometimes personality and talent, with the winners awarded prizes or titles)"}, "madsrdf:citationSource": "Dictionary.com website, April 7, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1b3fd1b202d45e2bf232de273548d5cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beauty contest; beauty pageant: a competition based mainly, though not always entirely, on the physical beauty of its contestants, and often incorporating personality, talent demonstration, and question responses as judged criteria)"}, "madsrdf:citationSource": "Wikipedia website, April 7, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1b3fd1b202d45e2bf232de273548d5cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 30 (Beauty contests: use for nonfiction coverage and commentary on beauty contests such as the Miss America Pageant)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb1b3fd1b202d45e2bf232de273548d5cb9", 