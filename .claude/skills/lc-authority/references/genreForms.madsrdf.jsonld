s": "new"}, {"@id": "_:nebcd489caee74d579a6f5600bea46b58b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Divine Office (Music)"}}, {"@id": "_:nebcd489caee74d579a6f5600bea46b58b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 93160841: Villar, M.C. Liturgia de las horas, c1991.", "madsrdf:citationStatus": "found"}, {"@id": "_:nebcd489caee74d579a6f5600bea46b58b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Divine Office; a series of worship services performed in the course of each day and night in the Roman Catholic Church)"}, "madsrdf:citationSource": "Grove music online, viewed August 29, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026769"}
