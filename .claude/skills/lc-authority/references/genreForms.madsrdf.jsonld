{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026092", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBlaxploitation films", "identifiers:lccn": "gf2011026092", "madsrdf:adminMetadata": [{"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b1"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Blaxploitation films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b5"}, "madsrdf:hasSource": [{"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b8"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b9"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b10"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b11"}], "madsrdf:hasVariant": [{"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b12"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b15"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b18"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b21"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b24"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026567"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025025"}]}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-23T16:11:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blaxploitation films"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shaft films"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shaft films"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(blaxploitation: A genre of American film of the 1970s featuring African-American actors in lead roles and often having antiestablishment plots, frequently criticized for stereotypical characterization and glorification of violence)"}, "madsrdf:citationSource": "Amer. Heritage dict. of the Eng. lang., c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 9, p. 259 (black action, or blaxploitation film; one of three exploitation genres) pp. 261-262 ([after Shaft] the next blaxploitation landmark was Superfly; black action films) p. 264 (blaxploitation parody)"}, "madsrdf:citationSource": "History of the American cinema, c1990 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(blaxploitation film, blacksploitation film: A film made with black performers and aimed at a black audience, though generally made by white producers. These films were especially popular in the early 1970s and took the form of nearly every established genre, though perhaps the most prominent were the violent and sensationalistic crime films such as Shaft (1971), which was certainly one of the best of this group.)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dict., 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Black films and programs. UF Black exploitation films and programs, Black karate thrillers, Blaxploitation films, Black westerns. Scope note: In general use for films designed for a black audience. Include ... black exploitation films of the 70's about black heroes, e.g. detectives or devotees of the martial arts)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Action films, Black"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action films, Black"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Blacksploitation films"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blacksploitation films"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shaft films"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shaft films"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Exploitation films, Black"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Exploitation films, Black"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Black exploitation films"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Black exploitation films"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Black action films"}}, {"@id": "_:n3c491e97df884e0b89d49d4984cc88d3b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Black action films"}}], "@id": "/authorities/genreForms/gf2011026092"}
