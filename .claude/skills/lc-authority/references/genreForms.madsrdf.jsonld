{"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n79ebcf7bb1ec4786a15e8e0d38092959b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indexes"}}, {"@id": "_:n79ebcf7bb1ec4786a15e8e0d38092959b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(indexes (reference sources). UF indices. Systematic guides to the contents of texts, files, or documents, presented as a list, usually in alphabetical order, of persons and/or subjects referred to in documents, with location of references thereto.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n79ebcf7bb1ec4786a15e8e0d38092959b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 49 (index: list at end of book)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n79ebcf7bb1ec4786a15e8e0d38092959b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Indexes. BT Reference works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n79ebcf7bb1ec4786a15e8e0d38092959b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(index: An alphabetically arranged list of headings consisting of the personal names, places, and subjects treated in a written work, with page numbers to refer the reader to the point in the text at which information pertaining to the heading is found. In single-volume works of reference and nonfiction, any indexes appear at the end of the back matter. In a multivolume work, they are found at the end of the last volume. In very large multivolume reference works, the last volume may be devoted entirely to indexes. Alternate plural: indices. Also refers to an open-end finding guide to the literature of an academic field or discipline (example: Philosopher's Index), to works of a specific literary form (Biography Index) or published in a specific format (Reader's Guide to Periodical Literature), or to the analyzed contents of a serial publication (New York Times Index). Indexes of this kind are usually issued in monthly or quarterly paperback supplements, cumulated annually.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n79ebcf7bb1ec4786a15e8e0d38092959b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n79ebcf7bb1ec4786a15e8e0d38092959b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indices"}}, {"@id": "_:n79ebcf7bb1ec4786a15e8e0d38092959b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indices"}}], "@id": "/authorities/genreForms/gf2014026112"}
