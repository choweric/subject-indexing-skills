pe": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Industrial television programs"}}, {"@id": "_:n9ccf59ae2ae94ee9a24aac4f6a69dd9bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Industrial: Nonfiction work concerned with illustrating and explaining industrial and manufacturing processes or issues. Generally distributed nontheatrically and designed for in-house educational or promotional purposes, many such works are sponsored by a concerned business or organization)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 10, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n9ccf59ae2ae94ee9a24aac4f6a69dd9bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 57 (Industrial films and video: use for nonfiction films and video designed to be used in an industrial setting; BT Documentaries and factual works; RT Instruction)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026330"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026331", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aInfomercials", "identifiers:lccn": "gf2011026331", "madsrdf:adminMetadata": [{"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b1"}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Infomercials"}, "madsrdf:elementList": {"@list": [{"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b3"}]}, "madsrdf:exampleNote": "Note under [Home shopping television programs]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026471"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026318"}, "madsrdf:hasSource": [{"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b5"}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b6"}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b7"}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b8"}], "madsrdf:hasVariant": {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Program-length television commercials that are devoted to one product, and that usually include a discussion or demonstration. For live television programs that purvey a wide variety of goods that can be purchased by viewers see [Home shopping television programs.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025201"}}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T09:51:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Infomercials"}}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Infomercials are program length TV commercials devoted solely to one product; contrasted with home shopping programs, which are ongoing programs, some of which are broadcast 24 hours a day, purvey a wide variety of goods, and are broadcast on network, cable, and satellite television)"}, "madsrdf:citationSource": "Home shopping in the United States, April 2005 via Research and Markets WWW Home page, Aug. 27, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Infomercial: any television commercial longer than two minutes, typically just under 30 minutes)"}, "madsrdf:citationSource": "Infomercial.tv glossary, Aug. 27, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(infomercial: a television program that is an extended advertisement often including a discussion or demonstration)"}, "madsrdf:citationSource": "Merriam-Webster online dictionary, Aug. 27, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(informercial: An advertising film (usu. shown on television) which promotes a product, service, etc. in an informative and purportedly objective and spontaneous style; informercial SEE ALSO infomercial)"}, "madsrdf:citationSource": "OED online, Aug. 27, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Informercials"}}, {"@id": "_:n87c7f23ddb81421bb2db2830da7fdb03b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Informercials"}}], "@id": "/authorities/genreForms/gf2011026331"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026332", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aInspirational radio programs", "identifiers:lccn": "gf2011026332", "madsrdf:adminMetadata": [{"@id": "_:nca35459e66f54429aa173efa26318d76b1"}, {"@id": "_:nca35459e66f54429aa173efa26318d76b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Inspirational radio programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nca35459e66f54429aa173efa26318d76b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026506"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026527"}, "madsrdf:hasSource": [{"@id": "_:nca35459e66f54429aa173efa26318d76b5"}, {"@id": "_:nca35459e66f54429aa173efa26318d76b6"}], "madsrdf:hasVariant": {"@id": "_:nca35459e66f54429aa173efa26318d76b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Radio programs that are designed to uplift, inspire, or motivate listeners and are often of a religious nature.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025616"}}, {"@id": "_:nca35459e66f54429aa173efa26318d76b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T06:45:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nca35459e66f54429aa173efa26318d76b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nca35459e66f54429aa173efa26318d76b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Inspirational radio programs"}}, {"@id": "_:nca35459e66f54429aa173efa26318d76b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Radio form/genre terms guide", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nca35459e66f54429aa173efa26318d76b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(inspirational radio: 2,120,000 hits; web sites found for inspirational radio stations including Inspirational Radio, Inspirational Family Radio, Achieve Radio; examples of inspirational radio programs found: Insight for living; Abundant life inspirational radio; Inspirational grooves; Lynn Johnson motivational radio show; many stations and programs have Christian focus)"}, "madsrdf:citationSource": "Google search, Dec. 5, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nca35459e66f54429aa173efa26318d76b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nca35459e66f54429aa173efa26318d76b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Motivational radio programs"}}, {"@id": "_:nca35459e66f54429aa173efa26318d76b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motivational radio programs"}}], "@id": "/authorities/genreForms/gf2011026332"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026333", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aInstructional films", "identifiers:lccn": "gf2011026333", "madsrdf:adminMetadata": [{"@id": "_:n7d62c060bf9047bfbb02a19bf8b571b0b1"}, {"@id": "_:n7d62c060bf9047bfbb02a19bf8b571b0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Instructional films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7d62c060bf9047bfbb02a19bf8b571b0b3"}]}, "madsrdf:exampleNote": "Note under [Educational films]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026423"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026329"}, "madsrdf:hasSource": [{"@id": "_:n7d62c060bf9047bfbb02a19bf8b571b0b5"}, {"@id": "_:n7d62c060bf9047bfbb02a19bf8b571b0b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that use a structured format to teach or train the audience. For films that are intended to impart knowledge and information, including those for classroom viewing, see [Educational films.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025615"}}, {"@id": "_:n7d62c060bf9047bfbb02a19bf8b571b0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n7d62c060bf9047bfbb02a19bf8b571b0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-05T15:28:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7d62c060bf9047bfbb02a19bf8b571b0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Instructional films"}}, {"@id": "_:n7d62c060bf9047bfbb02a19bf8b571b0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(instructional: nonfiction work designed to impart skills or techniques to general audiences, typically in a \"how-to\" manner; UF Exercise; RT: Industrial; Social guidance)"}, "madsrdf:citationSource": "Moving image genre/form guide via WWW, June 6, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n7d62c060bf9047bfbb02a19bf8b571b0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(instruction: use for nonfiction films and video designed to teach, instruct, or train; UF Televised instruction; Training works; RT Eductational/cultural works; Industrial works)"}, "madsrdf:citationSource": "Moving image materials, 1988", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026333"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026334", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aInstructional radio programs", "identifiers:lccn": "gf2011026334", "madsrdf:adminMetadata": [{"@id": "_:n184aac1753bb420ba467ba9e42fa7538b1"}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Instructional radio programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n184aac1753bb420ba467ba9e42fa7538b3"}]}, "madsrdf:exampleNote": "Note under [Educational radio programs]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026424"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026560"}, "madsrdf:hasSource": [{"@id": "_:n184aac1753bb420ba467ba9e42fa7538b5"}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b6"}], "madsrdf:hasVariant": [{"@id": "_:n184aac1753bb420ba467ba9e42fa7538b7"}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b10"}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b13"}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b16"}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b19"}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Radio programs that use a structured format to teach or train the audience. For radio programs intended to impart knowledge and information see [Educational radio programs.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025648"}}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-04T15:58:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Instructional radio programs"}}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Instructional programs: Nonfictional programs designed to instruct or train using a structured format; UF College courses, Pedagogy, Training; RT Educational programs, Informational programs; Examples: Music appreciation hour; Dancing on air; Band lessons; American school of the air; You are an artist)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Dec. 12, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ch. 2, The effectiveness of instructional media (Beginning in the 1920s instructional radio was widely used in the U.S. and Britain, but with the advent of television its use dwindled in the U.S. although it has continued to be widely used by the BBC schools services ... proved to be an effective instructional medium ... in 1937, end-of-term examinations showed that pupils taught by 15-minute radio science lessons did as well as those taught by conventional methods)"}, "madsrdf:citationSource": "Spencer, K.A. Media & technology in education, 1996, pdf file via WWW, Dec. 12, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n184aac1753bb420ba467ba9e42fa7538b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Informational radio programs"}}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Informational radio programs"}}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n184aac1753bb420ba467ba9e42fa7538b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lessons, Radio"}}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lessons, Radio"}}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n184aac1753bb420ba467ba9e42fa7538b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio instructional programs"}}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio instructional programs"}}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n184aac1753bb420ba467ba9e42fa7538b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio training programs"}}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio training programs"}}, {"@id": "_:n184aac1753bb420ba467ba9e42fa7538b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n184aac1753bb420ba467ba9e42fa7538b20"}]}, "mad