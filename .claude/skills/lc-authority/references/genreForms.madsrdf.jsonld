cordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nde38941b928e4678be9c9c290a8286d8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Woodcuts"}}, {"@id": "_:nde38941b928e4678be9c9c290a8286d8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Type of relief print and the process by which it is made. The term 'woodcut' is often used loosely for any printmaking technique that employs a wooden block. Strictly speaking, however, the term applies only to cuts made on planks of wood. The precise term for the method that involves cutting the design on the end-grain of the block is wood-engraving. The term 'xylography' is sometimes used to refer to both processes.)"}, "madsrdf:citationSource": "Grove art online, Oxford art online, August 27, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nde38941b928e4678be9c9c290a8286d8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 330 (woodcut: a relief printing process that uses a side-grain wooden block; the carving is usually done with gouges and chisels.)"}, "madsrdf:citationSource": "Benson, R. The printed picture, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nde38941b928e4678be9c9c290a8286d8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Woodcuts; UF Wood cuts; BT Relief prints; NT Chiaroscuro woodcuts; RT Wood engravings; scope note: Relief prints made from wood blocks incised on the plank side.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, August 27, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nde38941b928e4678be9c9c290a8286d8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Wood-engraving; UF Wood-cut; Wood-cuts; Wood-cutting (Engraving); Wood-engravings [Former heading]; Woodcut; Woodcuts; Woodcutting (Engraving); Xylography; BT Engravings; Prints; RT Block books; Block printing; NT Erotic wood-engraving; Photoxylography)"}, "madsrdf:citationSource": "LCSH, August 27, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nde38941b928e4678be9c9c290a8286d8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(woodcuts (prints); variants: woodcut (print); wood cuts (prints); woodblock prints; prints, woodblock; wood-block prints; prints, wood-block; xylographs (woodcuts); note: Prints made using the process of woodcut, which is a relief process in which the design is cut into and printed from the plank side of a wood block; distinct from \"wood engraving (process),\" which is a relief process using the grain end of a wood block.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, August 27, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nde38941b928e4678be9c9c290a8286d8b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde38941b928e4678be9c9c290a8286d8b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Xylographs"}}, {"@id": "_:nde38941b928e4678be9c9c290a8286d8b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Xylographs"}}, {"@id": "_:nde38941b928e4678be9c9c290a8286d8b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde38941b928e4678be9c9c290a8286d8b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wood-block prints"}}, {"@id": "_:nde38941b928e4678be9c9c290a8286d8b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wood-block prints"}}, {"@id": "_:nde38941b928e4678be9c9c290a8286d8b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde38941b928e4678be9c9c290a8286d8b17"}]}, "ma