{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026160", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aReaders (Publications)", "identifiers:lccn": "gf2014026160", "madsrdf:adminMetadata": [{"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b1"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Readers (Publications)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026191"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026044"}, "madsrdf:hasSource": [{"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b5"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b6"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b7"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b8"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b9"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b10"}], "madsrdf:hasVariant": {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works containing material intended for instruction and practice in reading."}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:35:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Readers (Publications)"}}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Readers. BT Textbooks. RT Anthologies)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(readers (textbooks, instructional materials, ... Visual and Verbal Communication). Works containing material for instruction and practice in reading; primers (books). Elementary books for teaching children to read.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(reader 3. A book containing extracts of a particular author's work or passages of text designed to give learners of a language practice in reading.)"}, "madsrdf:citationSource": "Oxford dictionaries website, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(reader. Also refers to a textbook containing reading exercises, especially one intended for young schoolchildren. Synonymous in this sense with primer; primer: Originally, a Book of Hours. Later, a book, often illustrated, written for young children to teach them how to read and spell. Synonymous in this sense with Dick and Jane book. In a more general sense, any book that gives the first principles of a subject or basic instruction for beginners )"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(reader: a book that is used to learn how to read or to practice reading in your own language or in a foreign language)"}, "madsrdf:citationSource": "Merriam-Webster online, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 68 (reader: book containing passages for instruction, anthology)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Primers (Readers)"}}, {"@id": "_:nf53ed1b81d154994b8ae7115e3f41826b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Primers (Readers)"}}], "@id": "/authorities/genreForms/gf2014026160"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026161", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRebuses", "identifiers:lccn": "gf2014026161", "madsrdf:adminMetadata": [{"@id": "_:na7449984df234757a62aa1643ea42b8bb1"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rebuses"}, "madsrdf:elementList": {"@list": [{"@id": "_:na7449984df234757a62aa1643ea42b8bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026169"}, "madsrdf:hasSource": [{"@id": "_:na7449984df234757a62aa1643ea42b8bb5"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb6"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb7"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb8"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb9"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb10"}], "madsrdf:hasVariant": [{"@id": "_:na7449984df234757a62aa1643ea42b8bb11"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb14"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb17"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rebuses"}}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rebus: a riddle or puzzle made up of letters, pictures, or symbols whose names sound like the parts or syllables of a word or phrase)"}, "madsrdf:citationSource": "Merriam-Webster online, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rebus 1. A puzzle in which words are represented by combinations of pictures and individual letters; for instance, apex might be represented by a picture of an ape followed by a letter X. 1.1. HISTORICAL An ornamental device associated with a person to whose name it punningly alludes.)"}, "madsrdf:citationSource": "Oxford dictionaries website, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 68 (rebus: representation of phrase, text by pictures, symbols etc.)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rebus. A rebus is an allusional device that uses pictures to represent words or parts of words; rebuses)"}, "madsrdf:citationSource": "Wikipedia, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rebus puzzles. They are essentially little pictures, often made with letters and words, which cryptically represent a word, phrase, or saying.)"}, "madsrdf:citationSource": "What are rebus puzzles?, via fun-with-words.com, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rebus, representation of a word or syllable by a picture of an object the name of which resembles in sound the represented word or syllable. Several rebuses may be combined--in a single device or successively--to make a phrase or sentence. Literary rebuses use letters, numbers, musical notes, or specially placed words to make sentences. Complex rebuses combine pictures and letters. Rebuses may convey direct meanings, especially to inform or instruct illiterate people; or they may deliberately conceal meanings, to inform only the initiated or to puzzle and amuse. In Europe, literary rebuses often appeared on family mottoes, personal seals, ciphers, bookplates, and ultimately in games or riddles. Popular in the United States after the mid-19th century were rebus picture puzzles in which the indicated addition or subtraction of letters in illustrated words produced another word or name. Such picture riddles have been widely used in advertising promotional contests.)"}, "madsrdf:citationSource": "Britannica online, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7449984df234757a62aa1643ea42b8bb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Literary rebuses"}}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Literary rebuses"}}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7449984df234757a62aa1643ea42b8bb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rebus puzzles"}}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rebus puzzles"}}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7449984df234757a62aa1643ea42b8bb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Puzzles, Rebus"}}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puzzles, Rebus"}}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7449984df234757a62aa1643ea42b8bb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rebus picture puzzles"}}, {"@id": "_:na7449984df234757a62aa1643ea42b8bb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rebus picture puzzles"}}], "@id": "/authorities/genreForms/gf2014026161"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026162", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRecipes", "identifiers:lccn": "gf2014026162", "madsrdf:adminMetadata": [{"@id": "_:n73384053045a4fed87737d86d446e935b1"}, {"@id": "_:n73384053045a4fed87737d86d446e935b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Recipes"}, "madsrdf:elementList": {"@list": [{"@id": "_:n73384053045a4fed87737d86d446e935b3"}]}, "madsrdf:exampleNote": "Note under [Cookbooks]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}], "madsrdf:hasSource": [{"@id": "_:n73384053045a4fed87737d86d446e935b5"}, {"@id": "_:n73384053045a4fed87737d86d446e935b6"}, {"@id": "_:n73384053045a4fed87737d86d446e935b7"}], "madsrdf:hasVariant": {"@id": "_:n73384053045a4fed87737d86d446e935b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Instructions listing ingredients and procedures to prepare something, especially food. For collections of recipes in book form see [Cookbooks.]"}, {"@id": "_:n73384053045a4fed87737d86d446e935b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:27:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n73384053045a4fed87737d86d446e935b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n73384053045a4fed87737d86d446e935b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Recipes"}}, {"@id": "_:n73384053045a4fed87737d86d446e935b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(receipt: A written document stating that something has been received, usually in exchange for payment of an amount noted in the acknowledgment. Also used synonymously with recipe, as in receipt book.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n73384053045a4fed87737d86d446e935b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(recipes. Sets of directions with a list of ingredients for making or preparing something, especially food. UF receipts (recipes))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n73384053045a4fed87737d86d446e935b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 68 (receipt 1 = recipe, 1c formula of a preparation, 3b written acknowledgement of payment; recipe: 1 formula for remedy, prescription, 3 statement on ingredients required)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n73384053045a4fed87737d86d446e935b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n73384053045a4fed87737d86d446e935b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Receipts (Recipes)"}}, {"@id": "_:n73384053045a4fed87737d86d446e935b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Receipts (Recipes)"}}], "@id": "/authorities/genreForms/gf2014026162"}
