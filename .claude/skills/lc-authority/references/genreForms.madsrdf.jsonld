:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surfing films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na71cd18d02e34ade93f354b720729c16b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Wrestling films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wrestling films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na71cd18d02e34ade93f354b720729c16b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tennis films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tennis films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na71cd18d02e34ade93f354b720729c16b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Horse racing films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horse racing films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na71cd18d02e34ade93f354b720729c16b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Curling films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Curling films"}}, {"@id": "_:na71cd18d02e34ade93f354b720729c16b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na71cd18d02e34ade93f354b720729c16b27"}]}, "madsrdf:variantLabel":