{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027265", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVideo art", "identifiers:lccn": "gf2017027265", "madsrdf:adminMetadata": [{"@id": "_:n591739f69a264e07b760a5f0d96ed103b1"}, {"@id": "_:n591739f69a264e07b760a5f0d96ed103b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Video art"}, "madsrdf:elementList": {"@list": [{"@id": "_:n591739f69a264e07b760a5f0d96ed103b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027218"}, "madsrdf:hasSource": [{"@id": "_:n591739f69a264e07b760a5f0d96ed103b5"}, {"@id": "_:n591739f69a264e07b760a5f0d96ed103b6"}, {"@id": "_:n591739f69a264e07b760a5f0d96ed103b7"}, {"@id": "_:n591739f69a264e07b760a5f0d96ed103b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works of art that employ video technology."}, {"@id": "_:n591739f69a264e07b760a5f0d96ed103b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n591739f69a264e07b760a5f0d96ed103b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n591739f69a264e07b760a5f0d96ed103b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Video art"}}, {"@id": "_:n591739f69a264e07b760a5f0d96ed103b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Thesaurus for graphic materials, December 13, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n591739f69a264e07b760a5f0d96ed103b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(video art; variants: art, video; note: Works of art that employ video technology, especially videotapes. For the study and practice of the art of producing such works, use \"video.\" Works of art that employ video technology, especially videotapes. For the study and practice of the art of producing such works, use \"video.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, December 13, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n591739f69a264e07b760a5f0d96ed103b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Video made by visual artists; it originated in 1965 when the Korean Fluxus artist Nam June Paik made his first tapes on the newly available Sony portable video camera and showed them a few hours later at the Caf\u00e9 a Go Go in Greenwich Village, New York. Video is a medium, not a style, and embraces an extremely wide range of activity and level of achievement.)"}, "madsrdf:citationSource": "The concise Oxford dictionary of art terms, Oxford reference, viewed December 13, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n591739f69a264e07b760a5f0d96ed103b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Video art; UF Electronic art; Experimental television; BT Art, Modern-20th century; Art, Modern-21th century; Performance; Television; RT Experimental films; NT Video installations (Art))"}, "madsrdf:citationSource": "LCSH, December 13, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027265"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027266", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVisual works", "identifiers:lccn": "gf2017027266", "madsrdf:adminMetadata": [{"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb1"}, {"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Visual works"}, "madsrdf:elementList": {"@list": [{"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb3"}]}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026530"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026723"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026116"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026147"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026588"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026040"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027218"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027231"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027238"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027245"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027249"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027251"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027254"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027255"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026040"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026045"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026080"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026028"}], "madsrdf:hasSource": [{"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb5"}, {"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb6"}, {"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-24T10:11:18"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Visual works"}}, {"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(visual works (works); Note: Works of art and any objects that occupy space, are perceived by the sense of sight, and are created, rather than naturally occurring. Of special interest are those objects conveying a symbolic or expressive meaning or an aesthetic experience, although visual works are not limited only to such works. Visual works include pictorial and sculptural works, as well as time-based works such as performance art. They also include utilitarian objects of the type collected or valued by museums or individuals. Visual works do not include the performing arts.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, March 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"(Visual works)\" used as qualifier on Scrolls (Visual works), Studies (Visual works), Marines (Visual works), Pastels (Visual works), etc.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, March 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n72fb7be89dcc46f3a494200fc7ef7f4eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Visual Works (hierarchy name); Note: The Visual Works hierarchy contains terms for items, including works of art and any objects that occupy space, are perceived by the sense of sight, and are created, rather than naturally occurring. This hierarchy focuses especially on works conveying a symbolic or expressive meaning or an aesthetic experience, such as pictorial and sculptural works, and time-based works such as performance art."}, "madsrdf:citationSource": "Art & architecture thesaurus online, March 20, 2017", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027266"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027267", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWatercolors", "identifiers:lccn": "gf2017027267", "madsrdf:adminMetadata": [{"@id": "_:nd584037f31d44813bf718465726c38afb1"}, {"@id": "_:nd584037f31d44813bf718465726c38afb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Watercolors"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd584037f31d44813bf718465726c38afb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027231"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027246"}], "madsrdf:hasSource": [{"@id": "_:nd584037f31d44813bf718465726c38afb5"}, {"@id": "_:nd584037f31d44813bf718465726c38afb6"}, {"@id": "_:nd584037f31d44813bf718465726c38afb7"}], "madsrdf:hasVariant": [{"@id": "_:nd584037f31d44813bf718465726c38afb8"}, {"@id": "_:nd584037f31d44813bf718465726c38afb11"}, {"@id": "_:nd584037f31d44813bf718465726c38afb14"}, {"@id": "_:nd584037f31d44813bf718465726c38afb17"}, {"@id": "_:nd584037f31d44813bf718465726c38afb20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works in which images are formed primarily of pigment suspended in water, generally on paper or other two-dimensional surface."}, {"@id": "_:nd584037f31d44813bf718465726c38afb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd584037f31d44813bf718465726c38afb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd584037f31d44813bf718465726c38afb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Watercolors"}}, {"@id": "_:nd584037f31d44813bf718465726c38afb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Watercolors; UF Watercolor drawings; Watercolor paintings; NT Gouaches; RT Drawings; Paintings)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, March 26, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nd584037f31d44813bf718465726c38afb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(watercolors (paintings); Note: Refers to two-dimensional works of art, usually on a paper support, to which pigment suspended in water is applied with a brush to create an image or design.; UF watercolor (painting); watercolor drawings; watercolor paintings (paintings); water-colors (paintings); water-colours (paintings))"}, "madsrdf:citationSource": "Art & architecture thesaurus online, March 26, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nd584037f31d44813bf718465726c38afb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Watercolor painting; UF Water-color painting; Water-color paintings; Water-colors; BT Painting)"}, "madsrdf:citationSource": "LCSH, March 26, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nd584037f31d44813bf718465726c38afb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd584037f31d44813bf718465726c38afb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Watercolor drawings"}}, {"@id": "_:nd584037f31d44813bf718465726c38afb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Watercolor drawings"}}, {"@id": "_:nd584037f31d44813bf718465726c38afb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd584037f31d44813bf718465726c38afb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Water-colors"}}, {"@id": "_:nd584037f31d44813bf718465726c38afb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Water-colors"}}, {"@id": "_:nd584037f31d44813bf718465726c38afb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd584037f31d44813bf718465726c38afb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Watercolor paintings"}}, {"@id": "_:nd584037f31d44813bf718465726c38afb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Watercolor paintings"}}, {"@id": "_:nd584037f31d44813bf718465726c38afb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd584037f31d44813bf718465726c38afb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Water-color drawings"}}, {"@id": "_:nd584037f31d44813bf718465726c38afb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Water-color drawings"}}, {"@id": "_:nd584037f31d44813bf718465726c38afb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd584037f31d44813bf718465726c38afb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Water-color paintings"}}, {"@id": "_:nd584037f31d44813bf718465726c38afb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Water-color paintings"}}], "@id": "/authorities/genreForms/gf2017027267"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027268", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWood engravings", "identifiers:lccn": "gf2017027268", "madsrdf:adminMetadata": [{"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b1"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Wood engravings"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027256"}, "madsrdf:hasSource": [{"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b5"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b6"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b7"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b8"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b9"}], "madsrdf:hasVariant": [{"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b10"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Relief prints made from wood blocks incised on the end grain."}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wood engravings"}}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 330 (wood engraving: a relief printing process that uses an end-grain wooden block; the carving on a wood engraving is usually done with a burin.)"}, "madsrdf:citationSource": "Benson, R. The printed picture, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Wood-engraving; Type of relief print related to the woodcut, and the process by which it is made. The two processes are, however, quite distinct, despite the terms 'woodcut' and 'wood-engraving' having been used synonymously to refer to any image printed from a wooden surface. Although it was probably used first in the 17th century, it was not until the 18th that wood-engraving could be identified confidently as a distinct engraving process ... The boxwood block is made from roundels cut across the grain, so that the closely formed growth rings of the tree are clearly apparent on the surface of the prepared block. By working against this grain the wood-engraver is able to execute very fine work.)"}, "madsrdf:citationSource": "Grove art online, Oxford art online, September 5, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Wood-engraving; UF Wood-cut; Wood-cuts; Wood-cutting (Engraving); Wood-engravings [Former heading]; Woodcut; Woodcuts; Woodcutting (Engraving); Xylography; BT Engravings; Prints; RT Block books; Block printing; NT Erotic wood-engraving; Photoxylography)"}, "madsrdf:citationSource": "LCSH, September 5, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Wood engravings; UF Engravings, Wood; Xylographs; BT Relief prints; RT Woodcuts; scope note: Relief prints made from wood blocks incised on the end grain.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, September 5, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wood engravings (prints); variants: wood engraving (print); engravings, wood (print); xylographs (wood engravings); wood-engravings (prints); wood-engraving (print); note: Prints made using the process of wood engraving, which is a relief process in which the design is cut into and printed from the grain end of a wood block; distinct from \"woodcut (process),\" which is a relief process using the plank side of a wood block.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, September 5, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Xylographs"}}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Xylographs"}}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Engravings, Wood"}}, {"@id": "_:n2edc94b73f9d40a5996237405b34f0c5b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Engravings, Wood"}}], "@id": "/authorities/genreForms/gf2017027268"}
