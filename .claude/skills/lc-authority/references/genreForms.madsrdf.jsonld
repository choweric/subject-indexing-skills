{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026543", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRomance films", "identifiers:lccn": "gf2011026543", "madsrdf:adminMetadata": [{"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb1"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Romance films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026545"}, "madsrdf:hasSource": [{"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb5"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb6"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb7"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb8"}], "madsrdf:hasVariant": [{"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb9"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb12"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb15"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb18"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb21"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb24"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb27"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb30"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature the development of love between the main characters.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025261"}}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T14:58:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romance films"}}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(results include: Romantic films; romantic movies)"}, "madsrdf:citationSource": "Google search, April 12, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Romance films; loosely defined as any film in which the central plot revolves around the romantic involvement of the story's protagonists. Another prerequisite is that the film has a happy ending although this second prerequisite is admittedly disputable; Chick flicks; weepy films)"}, "madsrdf:citationSource": "Wikipedia, April12, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 227 (romance, that film in which development of love between the two main characters is the main story line; romance films often seem to be hybrids) p. 229 (referred to in popular reference sources as: Hollywood romance films, romance films)"}, "madsrdf:citationSource": "Film genre 2000, c2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(romance: Fictional work focusing on an affectionate relationship between two people, whether in courtship or marriage, and set in modern or historical times; romances concentrate on the love story as the main conflict; used for: Love)"}, "madsrdf:citationSource": "Moving image genre-form guide online, April 27, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romance movies"}}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romance movies"}}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hollywood romance films"}}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hollywood romance films"}}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romance (Motion pictures)"}}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romance (Motion pictures)"}}, {"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4bdcb1b460ff4c31a2228777dbf746ddb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Love films"}}, {"@id": "_:n4bdcb1b460ff4c31a2228777