 {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-10-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-02-22T14:17:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical drama"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)45305175"}, "madsrdf:citationSource": "Ogden, Alan. Johnny, don't jump : a satirical comedy, \u00a92000.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Satirical plays; subcategory: Political satire plays)"}, "madsrdf:citationSource": "Wikipedia, Oct. 9, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (a dramatic satire in five acts) (OCoLC)6558189"}, "madsrdf:citationSource": "Woodman, H. Rea. The clever doctor, \u00a91912:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)84623865"}, "madsrdf:citationSource": "Ransom, Shirley Farley. Myth and ritual in Ben Jonson's earlier dramatic satires, 1971.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)33836532"}, "madsrdf:citationSource": "Bean, Keith F. Eternal footman : a satiric drama, 1931.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)54188249"}, "madsrdf:citationSource": "Coleman, C. B. Soviet dramatic satire in the twenties : a critical anthology of three plays by Bulgakov, Erdman and Mayakovsky, 1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Satirical plays. UF Dramatic satires; Satiric comedies (Drama); Satirical comedies (Drama); Satirical drama. BT Drama; Satire)"}, "madsrdf:citationSource": "LCSH, Oct. 9, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(satire, artistic form, chiefly literary and dramatic, in which human or individual vices, follies, abuses, or shortcomings are held up to censure by means of ridicule, derision, burlesque, irony, parody, caricature, or other methods, sometimes with an intent to inspire social reform; The drama has provided a favourable environment for satire ever since it was cultivated by Aristophanes, working under the extraordinarily open political conditions of 5th-century Athens. In a whole series of plays--Clouds, Frogs, Lysistrata, and many others--Aristophanes lampoons the demagogue Cleon by name, violently attacks Athenian war policy, derides the audience of his plays for their gullible complacency, pokes fun at Socrates as representative of the new philosophical teaching, stages a brilliantly parodic poetic competition between the dramatists Aeschylus and Euripides in Hades, and in general lashes out at contemporary evils with an uninhibited and unrivalled inventiveness; In Elizabethan England, Ben Jonson wrote plays that he called \"comicall satyres\"--Every Man out of His Humour, Poetaster; The 17th-century comedy of Moli\u00e8re sometimes deepens into satire, as with the exposure of religious hypocrisy in Tartuffe or the railing against social hypocrisy by Alceste in The Misanthrope; the 20th-century German playwright Bertolt Brecht, whose anatomizing of social injustice cuts deep)"}, "madsrdf:citationSource": "Britannica online, Oct. 9, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)3775140"}, "madsrdf:citationSource": "Work cat.: Luce, Clare Boothe. Margin for error : satirical melodrama in 2 acts, 1940.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)26708701"}, "madsrdf:citationSource": "Wilder, Thornton. Queens of France : a satiric comedy in one act, \u00a91959.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)762296"}, "madsrdf:citationSource": "Bantleman, Lawrence. The award : a satirical drama in two acts, \u00a91972.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)744781480"}, "madsrdf:citationSource": "Weinshall, Zina. My million : a satirical play in three acts, \u00a92010.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satirical comedies (Drama)"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical comedies (Drama)"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric drama"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric drama"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satires (Drama)"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satires (Drama)"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramatic satires"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramatic satires"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric comedies (Drama)"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric comedies (Drama)"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satirical melodramas"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical melodramas"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satirical plays"}}, {"@id": "_:nd0bb5fac641b4ec896ac770c5427b989b36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical plays"}}], "@id": "/authorities/genreForms/gf2023026106"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026107", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSatirical operas", "identifiers:lccn": "gf2023026107", "madsrdf:adminMetadata": [{"@id": "_:n9de83233db304282877fe03dacf93bc3b1"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Satirical operas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9de83233db304282877fe03dacf93bc3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026976"}, "madsrdf:hasSource": [{"@id": "_:n9de83233db304282877fe03dacf93bc3b5"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b6"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b7"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b8"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b9"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b10"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b11"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b12"}], "madsrdf:hasVariant": [{"@id": "_:n9de83233db304282877fe03dacf93bc3b13"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b16"}], "madsrdf:historyNote": "[Established February 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-10-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-02-22T14:17:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical operas"}}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Guy de Maupassant's tragic-satirical tale was the plot for film adaptations with Fernandel and later Bourvil, among others, and was adapted for the opera stage in 1947 by Benjamin Britten and Eric Crozier under the title Albert Herring; In the apparent guise of a comedy, Benjamin Britten tells the oppressive story of a mothered misfit in a small-town provincial setting: the outsider, ridiculed by everyone and subjected to malicious mockery, receives the financially highly endowed \"virtue prize\", thus achieving fame and honors - but then runs away with his prize money and returns home an alcoholic wreck)"}, "madsrdf:citationSource": "Tragic & satirical: Benjamin Britten's Albert Herring, via Mozarteum University website, Oct. 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(audio recording of a satirical opera) (OCoLC)973325786"}, "madsrdf:citationSource": "Work cat.: Britten, Benjamin. Albert Herring, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)53171122"}, "madsrdf:citationSource": "T\u00fcz\u00fcn, Ferit. Midas'in kulaklari : satirik opera = The ears of Midas : satiric opera, 1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Weiss, Hedy. A repressed mother's boy breaks free in Benjamin Britten's satirical opera \"Albert Herring\", WTTW News website, posted Jan. 28, 2023, viewed on Oct. 10, 2023.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "added t.p. (satirical opera in 2 acts, 7 scenes, op. 57) (OCoLC)13203598"}, "madsrdf:citationSource": "Levitin, I\ufe20U\ufe21ri\u012d. Personal\u02b9ny\u012d pami\ufe20a\ufe21tnik : satiricheskai\ufe20a\ufe21 opera v 2 de\u012dstvii\ufe20a\ufe21kh, 7 kartinakh soch. 57, 1984:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Dressel, Erwin: he began a long-lasting collaboration for the stage with the poet Arthur Zweiniger. Their first success was the satirical opera Der arme Columbus; under Erevan: the first opera to have its premi\u00e8re in Erevan, Step'anyan's satirical opera K'adj Nazar; under Rinaldo di Capua: the satirical opera La commedia in commedia)"}, "madsrdf:citationSource": "Grove music online, Oct. 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)222473144"}, "madsrdf:citationSource": "Stanbury, Dennis. The parody : a grand satirical opera in 5 scenes loosely adapted from the verse drama attributed to Archilochus, \u00a91994.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Kurt Weill: German composer, who developed a new genre of satirical opera in collaboration with Bertolt Brecht)"}, "madsrdf:citationSource": "Oxford reference website, Oct. 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9de83233db304282877fe03dacf93bc3b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satires (Operas)"}}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satires (Operas)"}}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9de83233db304282877fe03dacf93bc3b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric operas"}}, {"@id": "_:n9de83233db304282877fe03dacf93bc3b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric operas"}}], "@id": "/authorities/genreForms/gf2023026107"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026110", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFolk dances", "identifiers:lccn": "gf2023026110", "madsrdf:adminMetadata": [{"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b1"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Folk dances"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026091"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026101"}, "madsrdf:hasSource": [{"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b5"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b6"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b7"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b8"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b9"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b10"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b11"}], "madsrdf:hasVariant": [{"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b12"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b15"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b18"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b21"}], "madsrdf:historyNote": "[Established February 2025.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-10-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "new"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-02-04T11:18:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folk dances"}}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "volume 1, title page (containing 23 very easy dances; other more difficult folk dances published in volumes II & III)"}, "madsrdf:citationSource": "Work cat: Folk dances of different nations, 1926:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 36 (ethnic dance: the dance of a group \"which holds in common genetic, linguistic, and cultural ties with special emphasis on cultural tradition; said of every dance form and argued to include ballet) page 37 (folk dance: dance in a society which is, in contrast to a so-called primitive society, not autonomous but one which is in symbiotic relationship with the larger society with which it constantly interacts) page 38 (folk dance: dance performed for recreational and social purpose; traditional dance; said to have three types in England: the Morris, the word dance, and the country dance)"}, "madsrdf:citationSource": "Dance words, 1995:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "opening frames (This DVD holds a variety of dances; the list includes a variety of dancing styles among which many were performed during the closing ceremony of the Pan African Dance Festival (FESPAD); most of these dances are performed on the beats of drums)"}, "madsrdf:citationSource": "Rwanda traditional dance [VR], 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk dance: Recreational dance of the common people of a country or region. The term refers specifically to the traditional dances of European peoples. For characteristic dances of other cultures, such as those indigenous to Africa, Asia, North and South America, Oceania, and Australia, the term \"ethnic dance\" or \"traditional dance\" is preferred)"}, "madsrdf:citationSource": "Oxford music online, viewed October 17, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk dance; also known as: traditional dance; ethnic dance; \u0441horeographic folklore; folkloric dance)"}, "madsrdf:citationSource": "Wikidata, viewed October 3, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Folk dance; Term denoting any kind of dance which has been developed within a traditional community, rather than being created by a choreographer or teacher. Steps and patterns are passed on from one generation to another, gradually undergoing change. Many folk dances have their origins in ritual--fertility, marriage, religious, or war--and express the character of the community who dance them. The term was coined in the 18th century to distinguish 'peasant' dance forms from those of the upper classes, but the distinction itself dates back to the 15th century when ballroom dances first began to emerge as separate forms)"}, "madsrdf:citationSource": "Oxford dictionary of dance (2 ed.), via Oxford reference, viewed October 17, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(folk-dance; A dance of popular origin; the music for such a dance)"}, "madsrdf:citationSource": "Oxford English dictionary, viewed January 4, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Traditional dances"}}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Traditional dances"}}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ethnic dances"}}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnic dances"}}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Choreographic folklore"}}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Choreographic folklore"}}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Folkloric dances"}}, {"@id": "_:nfd3ce2715dd44549b13d0cefe6bd2837b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Folkloric dances"}}], "@id": "/authorities/genreForms/gf2023026110"}
