": "revised"}, {"@id": "_:nfe9ccfcf9f1c4a28ad35f91c47d47810b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bible comics"}}, {"@id": "_:nfe9ccfcf9f1c4a28ad35f91c47d47810b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel adaptation of the entire book of Genesis, translated by Robert Alter, illustrated by R. Crumb)"}, "madsrdf:citationSource": "2009014303: 1300 Bible. Genesis. English. Alter-Crumb. 2009. The book of Genesis, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe9ccfcf9f1c4a28ad35f91c47d47810b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subj. hdg.: Bible stories, English--Gospels--Comic books, strips, etc.)"}, "madsrdf:citationSource": "2010290695: Classic Bible stories, 2010-", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe9ccfcf9f1c4a28ad35f91c47d47810b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the retelling in comics form of nine biblical stories that present Chester Brown's fascinating and startling thesis about biblical representations of prostitution; polemical interpretation of the Bible that will be one of the most controversial and talked-about graphic novels of 2016; stories about Ruth, Bathsheba, Tamar, Job, and, of course, Mary of Bethany)"}, "madsrdf:citationSource": "Drawn & Quarterly web page for Mary wept over the feet of Jesus, by Chester Brown, viewed on Sept. 12, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe9ccfcf9f1c4a28ad35f91c47d47810b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (a \"graphic novel\" containing adaptations of certain Biblical stories)"}, "madsrdf:citationSource": "Work cat.: Brown, Chester. Mary wept over the feet of Jesus, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe9ccfcf9f1c4a28ad35f91c47d47810b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "2