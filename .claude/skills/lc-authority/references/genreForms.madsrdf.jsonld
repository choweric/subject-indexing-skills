ri:recordStatus": "new"}, {"@id": "_:n2940ae82cb2b4645b56a59b6002e3d1db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Funk (Music)"}}, {"@id": "_:n2940ae82cb2b4645b56a59b6002e3d1db5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 95032678: Funk, 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2940ae82cb2b4645b56a59b6002e3d1db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "funk (style of Black American popular music which developed in the 1960s out of soul music)"}, "madsrdf:citationSource": "New Grove dict. of jazz:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2940ae82cb2b4645b56a59b6002e3d1db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "jazz (Jazz-rock; \"a style of music, initiated in the 1960s, which combined the harmonic resources and improvising techniques of modern jazz with the instrumentation, rhythms, and idioms of rock music and funk ... By the late 1970s 'jazz-rock' had largely been replaced by the term 'fusion,' which was also used to describe the blending of jazz with any other type of music ... However ... fusion is still most often thought of as a highly amplified mixture of jazz with rock and funk, and the terms ... may be used interchangeably. From the late 1980s the term 'electric jazz' was also often used\")"}, "madsrdf:citationSource": "Grove music online WWW site, Mar. 7, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2940ae82cb2b4645b56a59b6002e3d1db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "funk (style of Black popular music which began in the 1960s characterized by vamping and heavy syncopation)"}, "madsrdf:citationSource": "New Grove dict. of Amer. music:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026823"}
