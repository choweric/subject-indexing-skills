v/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:neded90b0a1994e358e04fcf84448035cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T07:05:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:neded90b0a1994e358e04fcf84448035cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Live-action/animation films"}}, {"@id": "_:neded90b0a1994e358e04fcf84448035cb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Who framed Roger Rabbit?, 1988.", "madsrdf:citationStatus": "found"}, {"@id": "_:neded90b0a1994e358e04fcf84448035cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(live-action/animated film: motion picture that features a combination of real actors or elements: live-action and animated elements, typically interacting)"}, "madsrdf:citationSource": "Wikipedia, Oct. 26, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:neded90b0a1994e358e04fcf84448035cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(live-action/animation films: 157,000 hits; live-action/animated films: 23,300 hits; hybrid animation-live action: 7,860 hits; hybrid live-action/animation: 33,100 hits; hybrid live-action/animated: 11,500 hits; hybrid animated/live-action: 4,370 hits; animation/live-action films: 434,000 hits, most irrevalent)"}, "madsrdf:citationSource": "Google, Oct. 26, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:neded90b0a1994e358e04fcf84448035cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Live-action/ani