ementValue": {"@language": "en", "@value": "Submarine films"}}, {"@id": "_:n0c36bdb7f35c4c05b9c2ad5b7eb16335b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(submarine drama SEE Naval combat drama; Naval combat drama: use for fictional genre films and programs in which the protagonists are sailers engaged in warfare on or beneath the sea; BT War drama)"}, "madsrdf:citationSource": "Moving image materials : genre terms, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c36bdb7f35c4c05b9c2ad5b7eb16335b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Submarine War Films, see War films; under War films: Submarine War Films. Underwater warfare has always been a major topic of war films)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c36bdb7f35c4c05b9c2ad5b7eb16335b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c36bdb7f35c4c05b9c2ad5b7eb16335b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Submarine movies"}}, {"@id": "_:n0c36bdb7f35c4c05b9c2ad5b7eb16335b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Submarine movies"}}, {"@id": "_:n0c36bdb7f35c4c05b9c2ad5b7eb16335b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c36bdb7f35c4c05b9c2ad5b7eb16335b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Submarine war films"}}, {"@id": "_:n0c36bdb7f35c4c05b9c2ad5b7eb16335b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Submarine war films"}}], "@id": "/authorities/genreForms/gf2011026620"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026621", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSuperhero films", "identifiers:lccn": "gf2011026621", "madsrdf:adminMetadata": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb1"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Superhero films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026242"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026556"}], "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb5"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb8"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb11"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb14"}], "madsrdf:hasSource": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb17"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb18"}], "madsrdf:hasVariant": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb19"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb22"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb25"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb28"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb31"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb34"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb37"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026082"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026285"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026598"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026623"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025365"}]}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:15:23"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Superhero films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Batman films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Batman films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Flash Gordon films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flash Gordon films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Superman films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Superman films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spider-Man films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spider-Man films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under category Fantasy Film (Comic Strip Superheroes Films (Superhero Films). From Buck Rogers to Flash Gordon, Superman, and a host of others, these comic strip or comic book superheroes (better known as \"long-underwear heroes\" by their creators) have invaded the worlds of science fiction and fantasy alike. With a fluctuating degree of success, fantasy films have frequently sought to transpose to the screen their adventures. These films already form a sizeable group. Examples: Batman, Superman, Supergirl, The Rocketeer)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Superhero drama. Use for fictional genre films and programs in which the protagonist has superhuman powers, often derived from imaginary technology. BT Science fiction)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spider-Man films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spider-Man films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comic strip superhero films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comic strip superhero films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Superman films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Superman films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Superheroes films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Superheroes films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comic strip superheroes films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comic strip superheroes films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Batman films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Batman films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd4cb69d3362468084767df5cd8a40deb38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Flash Gordon films"}}, {"@id": "_:ncd4cb69d3362468084767df5cd8a40deb38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flash Gordon films"}}], "@id": "/authorities/genreForms/gf2011026621"}
