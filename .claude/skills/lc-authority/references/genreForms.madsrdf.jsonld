{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026871", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHymnals", "identifiers:lccn": "gf2014026871", "madsrdf:adminMetadata": [{"@id": "_:n424655620d1443ae85cef75c18a2d928b1"}, {"@id": "_:n424655620d1443ae85cef75c18a2d928b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hymnals"}, "madsrdf:elementList": {"@list": [{"@id": "_:n424655620d1443ae85cef75c18a2d928b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027085"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027087"}, "madsrdf:hasSource": {"@id": "_:n424655620d1443ae85cef75c18a2d928b5"}, "madsrdf:hasVariant": [{"@id": "_:n424655620d1443ae85cef75c18a2d928b6"}, {"@id": "_:n424655620d1443ae85cef75c18a2d928b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n424655620d1443ae85cef75c18a2d928b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n424655620d1443ae85cef75c18a2d928b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n424655620d1443ae85cef75c18a2d928b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hymnals"}}, {"@id": "_:n424655620d1443ae85cef75c18a2d928b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Liturgy & liturgical books (The most familiar liturgical book in modern churches is undoubtedly the hymnal. Although Anglican service books have mostly remained separate from the hymnal, many denominations have adopted a combined 'hymnal and service book'. Contents and arrangement differ but, in addition to the main corpus of hymns, there will usually be found various items of service music, an abridged psalter, rites for morning and evening prayer, and the text of occasional services (baptism, a burial Office). )"}, "madsrdf:citationSource": "Grove music online, viewed August 29, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n424655620d1443ae85cef75c18a2d928b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n424655620d1443ae85cef75c18a2d928b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hymnbooks"}}, {"@id": "_:n424655620d1443ae85cef75c18a2d928b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hymnbooks"}}, {"@id": "_:n424655620d1443ae85cef75c18a2d928b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n424655620d1443ae85cef75c18a2d928b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hymn books"}}, {"@id": "_:n424655620d1443ae85cef75c18a2d928b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hymn books"}}], "@id": "/authorities/genreForms/gf2014026871"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026872", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHymns", "identifiers:lccn": "gf2014026872", "madsrdf:adminMetadata": [{"@id": "_:n109f980ca9474f099587ef42f91e8242b1"}, {"@id": "_:n109f980ca9474f099587ef42f91e8242b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hymns"}, "madsrdf:elementList": {"@list": [{"@id": "_:n109f980ca9474f099587ef42f91e8242b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026621"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026713"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026838"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027181"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026077"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026007"}], "madsrdf:hasSource": {"@id": "_:n109f980ca9474f099587ef42f91e8242b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Sacred songs that are normally associated with worship services and are typically suitable for singing by a full assembly. For texts of hymns that appear without a musical setting see [Hymn texts.] For instrumental hymn music that appears without accompanying sung text, see [Hymn tunes.]"}, {"@id": "_:n109f980ca9474f099587ef42f91e8242b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n109f980ca9474f099587ef42f91e8242b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-05T13:55:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n109f980ca9474f099587ef42f91e8242b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hymns"}}, {"@id": "_:n109f980ca9474f099587ef42f91e8242b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Hymn II, Monophonic Latin (The Latin hymn is a strophic composition, sung in the Divine Office, with a metrical poetic text and a predominantly syllabic melody. 'Hymn' here designates compositions for the Office, as distinguished from other liturgical poetry) under Hymn IV, Protestant (Metrical hymns have been an important and distinctive part of Protestant worship since the Reformation. Today the word 'hymn' has the general meaning 'sacred lyric for use in worship')"}, "madsrdf:citationSource": "Grove music online, viewed August 9, 2014:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026872"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026873", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIncidental music", "identifiers:lccn": "gf2014026873", "madsrdf:adminMetadata": [{"@id": "_:nd4b5ef5b838045d384e070b7220b5b4fb1"}, {"@id": "_:nd4b5ef5b838045d384e070b7220b5b4fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Incidental music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd4b5ef5b838045d384e070b7220b5b4fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026888"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026965"}], "madsrdf:hasSource": {"@id": "_:nd4b5ef5b838045d384e070b7220b5b4fb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music performed as part of a predominantly spoken-word drama (e.g., a play) without being an integral part of it."}, {"@id": "_:nd4b5ef5b838045d384e070b7220b5b4fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:31:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd4b5ef5b838045d384e070b7220b5b4fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd4b5ef5b838045d384e070b7220b5b4fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Incidental music"}}, {"@id": "_:nd4b5ef5b838045d384e070b7220b5b4fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In the theatre, music performed as part of the performance of a spoken drama)"}, "madsrdf:citationSource": "Grove music online, viewed August 9, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026873"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026874", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIndustrial music", "identifiers:lccn": "gf2014026874", "madsrdf:adminMetadata": [{"@id": "_:ne924fa39e027467aace95b717ca1a497b1"}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Industrial music"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne924fa39e027467aace95b717ca1a497b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026759"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026062"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026020"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026070"}], "madsrdf:hasSource": [{"@id": "_:ne924fa39e027467aace95b717ca1a497b5"}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b6"}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b7"}], "madsrdf:hasVariant": [{"@id": "_:ne924fa39e027467aace95b717ca1a497b8"}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Popular music that arose in the 1970s and contains elements of punk rock, electronic music, and machinery sounds."}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:31:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Industrial music"}}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 5 (Generic industrial; New musick)"}, "madsrdf:citationSource": "Industrial culture handbook, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Industrial music)"}, "madsrdf:citationSource": "Hennepin", "madsrdf:citationStatus": "found"}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"... characterized by heavy percussion, synthesized or electronic melodies, distorted and/or manipulated vocals, and cut-and-paste construction. It is often the product of angry white young men; resonating primarily with themes of alienation, anger, pain, oppression, and control. Often danceable, industrial music has noticeable repetitive rhythms and chant-like choruses, which are often played out in variations of a traditional AABA song structure\"; may include \"found sounds\" from metal objects or tools such as a power drill or moving apparatus in a factory)"}, "madsrdf:citationSource": "\"Dark Industrial Zone\", URL:http://ieva05.lanet.lv/ \u0303sd50031/raksti.html", "madsrdf:citationStatus": "found"}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne924fa39e027467aace95b717ca1a497b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "New musick (Industrial music)"}}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "New musick (Industrial music)"}}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne924fa39e027467aace95b717ca1a497b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Generic industrial music"}}, {"@id": "_:ne924fa39e027467aace95b717ca1a497b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Generic industrial music"}}], "@id": "/authorities/genreForms/gf2014026874"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026875", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIntelligent dance music", "identifiers:lccn": "gf2014026875", "madsrdf:adminMetadata": [{"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb1"}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Intelligent dance music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153"}, "madsrdf:hasSource": [{"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb5"}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb6"}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb7"}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb8"}], "madsrdf:hasVariant": {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-07-13T13:04:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "revised"}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intelligent dance music"}}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Intelligent Dance Music)"}, "madsrdf:citationSource": "International Index to Music Periodicals, Jan. 24, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Intelligent dance music [ER] 2000?", "madsrdf:citationStatus": "found"}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xi (IDM (Intelligent Dance Music); born in the late 1980s, the sound grew out of a fusion between the hard-edged dance music heard on the main floor at raves and larger club events, and the more downtempo music of the nearby chill rooms)"}, "madsrdf:citationSource": "All music guide to electronica, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. 179 (IDM (Intelligent Dance Music); stylist variants of DJ-programmed, mediated dance music)"}, "madsrdf:citationSource": "Continuum encyclopedia of popular music of the world, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "IDM (Intelligent dance music)"}}, {"@id": "_:n015911a31f6a41a3b65ee5c59c3b593bb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "IDM (Intelligent dance music)"}}], "@id": "/authorities/genreForms/gf2014026875"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026876", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aInterludes (Music)", "identifiers:lccn": "gf2014026876", "madsrdf:adminMetadata": [{"@id": "_:n37e7994490584957ae2e4a249256447bb1"}, {"@id": "_:n37e7994490584957ae2e4a249256447bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Interludes (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n37e7994490584957ae2e4a249256447bb3"}]}, "madsrdf:exampleNote": "Note under [Intermezzos (Instrumental music)]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026787"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027065"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027141"}], "madsrdf:hasSource": [{"@id": "_:n37e7994490584957ae2e4a249256447bb5"}, {"@id": "_:n37e7994490584957ae2e4a249256447bb6"}, {"@id": "_:n37e7994490584957ae2e4a249256447bb7"}, {"@id": "_:n37e7994490584957ae2e4a249256447bb8"}], "madsrdf:hasVariant": {"@id": "_:n37e7994490584957ae2e4a249256447bb9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music performed between parts of other works. For short, instrumental musical works that are performed independently of other works, see [Intermezzos (Instrumental music).]"}, {"@id": "_:n37e7994490584957ae2e4a249256447bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T08:47:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n37e7994490584957ae2e4a249256447bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n37e7994490584957ae2e4a249256447bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Interludes (Music)"}}, {"@id": "_:n37e7994490584957ae2e4a249256447bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Interlude (act music, entr'acte); in church services, organ interludes in psalms and hymns; in a theatrical performance, an instrumental item between acts; in instrumental music, usually a short connecting episode between movements)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Aug. 3, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n37e7994490584957ae2e4a249256447bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP t.p. (orchestral interludes)"}, "madsrdf:citationSource": "Work cat.: 2001043313: Morris, C. Reading opera between the lines, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n37e7994490584957ae2e4a249256447bb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Harvard dict. of music.", "madsrdf:citationStatus": "found"}, {"@id": "_:n37e7994490584957ae2e4a249256447bb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove dict. of opera.", "madsrdf:citationStatus": "found"}, {"@id": "_:n37e7994490584957ae2e4a249256447bb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n37e7994490584957ae2e4a249256447bb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Entracte (Music)"}}, {"@id": "_:n37e7994490584957ae2e4a249256447bb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Entracte (Music)"}}], "@id": "/authorities/genreForms/gf2014026876"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026877", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIntroits (Music)", "identifiers:lccn": "gf2014026877", "madsrdf:adminMetadata": [{"@id": "_:n3fa5e2dd477a40079a2ba1b8bee6b3c5b1"}, {"@id": "_:n3fa5e2dd477a40079a2ba1b8bee6b3c5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Introits (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3fa5e2dd477a40079a2ba1b8bee6b3c5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027020"}, "madsrdf:hasSource": {"@id": "_:n3fa5e2dd477a40079a2ba1b8bee6b3c5b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3fa5e2dd477a40079a2ba1b8bee6b3c5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3fa5e2dd477a40079a2ba1b8bee6b3c5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n3fa5e2dd477a40079a2ba1b8bee6b3c5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Introits (Music)"}}, {"@id": "_:n3fa5e2dd477a40079a2ba1b8bee6b3c5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Introit (i) (from Lat. introitus). The first of the Proper or variable chants of the Mass. It is sung, as its name suggests, during the entrance of the celebrant and his ministers at the beginning of the Mass)"}, "madsrdf:citationSource": "Grove music online, viewed May 28, 2014 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026877"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026878", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJarigan", "identifiers:lccn": "gf2014026878", "madsrdf:adminMetadata": [{"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b1"}, {"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jarigan"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026961"}], "madsrdf:hasSource": {"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b5"}, "madsrdf:hasVariant": {"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jarigan"}}, {"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Bengali music III. Local traditions. 3. Narrative and dramatic genres (J\u0101rig\u0101n, a narrative genre of the Muslim community, began as a commemoration of the Karbala massacre (680 ce), in which one of the grandsons of Hazrat Muhammad was killed. Present-day j\u0101rig\u0101n also comprises secular stories (mythological and historical) as well as religious and political themes. The music unfolds through solo narrative and strophic singing by the bay\u0101ti ('leader'), and at the end of each section the chorus (doh\u0101r) sings a refrain in a faster tempo. The j\u0101ri ensemble is led by a double-headed drum and includes a harmonium, small brass cymbals and bells, all played by members of the chorus. The doh\u0101r stand around the leader, who sways, crouches and swings both hands to signal their entry.)"}, "madsrdf:citationSource": "Grove music online, viewed August 10, 2014 :", "madsrdf:citationStatus": "found"}, {"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "J\u0101r\u012bg\u0101na"}}, {"@id": "_:nc2a014acf2cc4e4dbbbc0d32c47febe7b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "J\u0101r\u012bg\u0101na"}}], "@id": "/authorities/genreForms/gf2014026878"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026879", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJazz", "identifiers:lccn": "gf2014026879", "madsrdf:adminMetadata": [{"@id": "_:n1a8723c5aa7441feba43cb860486b302b1"}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jazz"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1a8723c5aa7441feba43cb860486b302b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026670"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026730"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026770"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026816"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026880"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026903"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026971"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027119"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027137"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027169"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026169"}], "madsrdf:hasSource": [{"@id": "_:n1a8723c5aa7441feba43cb860486b302b5"}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b6"}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b7"}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b8"}], "madsrdf:hasVariant": [{"@id": "_:n1a8723c5aa7441feba43cb860486b302b9"}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-03-05T07:21:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jazz"}}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jazz; 1) a musical tradition rooted in performing conventions that were introduced and developed early in the 20th century by African Americans; 2) a set of attitudes and assumptions brought to music-making, chief among them the notion of performance as a fluid creative process involving improvisation; and 3) a style characterized by syncopation, melodic and harmonic elements derived from the blues, cyclical formal structures and a supple rhythmic approach to phrasing known as swing)"}, "madsrdf:citationSource": "Grove music online, Dec. 10, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(jazz: A term, which came into general use c.1913-15, for a type of music that developed in the Southern States of USA in the late 19th cent. and came into prominence at the turn of the century in New Orleans, chiefly (but not exclusively) among black musicians. Elements that contributed to jazz were the rhythms of W. Africa, Eur. harmony, and Amer. gospel singing. Before the term jazz was used, ragtime was the popular name for this genre. About 1900 also, the blues craze began. Although mainly a vocal style, the predominant instrs of instr blues were tpt, cornet, cl, sax, or tb. A leading figure of this era was the black composer W. C. Handy whose Memphis Blues (1909) and St Louis Blues (1914) are jazz classics; subsequent history of jazz has embraced a diversity of styles, e.g. Dixieland, swing, be-bop, cool jazz, free jazz)"}, "madsrdf:citationSource": "The Oxford dictionary of music, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(jazz: A popular music of black American origin, distinguished by its characteristic rhythms and harmonies and typically involving improvisation. The word originally signified liveliness, and may have had particular reference to sexual excitement. Although many elements went into the making of jazz--ragtime, field hollers, work songs, spirituals, vaudeville songs, street marches, the blues, and so on--it developed its own distinctive character by about 1900; the \"classic\" jazz style, born of and in New Orleans, is essentially a linear, melodic music, played on trumpet, trombone, and clarinet with piano, drums, banjo or guitar, and bass (brass at first, string later))"}, "madsrdf:citationSource": "The Oxford companion to music, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "2005571120: The collection of jazz music, \u00a92004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a8723c5aa7441feba43cb860486b302b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jive"}}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jive"}}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1a8723c5aa7441feba43cb860486b302b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jazz music"}}, {"@id": "_:n1a8723c5aa7441feba43cb860486b302b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jazz music"}}], "@id": "/authorities/genreForms/gf2014026879"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026880", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJazz-rock (Music)", "identifiers:lccn": "gf2014026880", "madsrdf:adminMetadata": [{"@id": "_:n158b07d4736f402aa9c10af2cc968928b1"}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jazz-rock (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n158b07d4736f402aa9c10af2cc968928b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026879"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}], "madsrdf:hasSource": [{"@id": "_:n158b07d4736f402aa9c10af2cc968928b5"}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b6"}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b7"}], "madsrdf:hasVariant": [{"@id": "_:n158b07d4736f402aa9c10af2cc968928b8"}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b11"}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jazz-rock (Music)"}}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Jazz-rock: the term \"first emerged during the late '60s as an attempt to fuse the visceral power of rock with the musical complexity and improvisational fireworks of jazz\"; under Fusion: \"the word ... has been so liberally used since the late '60s that it's become almost meaningless. Fusion's original definition was best: a mixture of jazz improvisation with the power and rhythms of rock\")"}, "madsrdf:citationSource": "All music guide WWW site, Mar. 7, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "jazz (Jazz-rock; \"a style of music, initiated in the 1960s, which combined the harmonic resources and improvising techniques of modern jazz with the instrumentation, rhythms, and idioms of rock music and funk ... By the late 1970s 'jazz-rock' had largely been replaced by the term 'fusion,' which was also used to describe the blending of jazz with any other type of music ... However ... fusion is still most often thought of as a highly amplified mixture of jazz with rock and funk, and the terms ... may be used interchangeably. From the late 1980s the term 'electric jazz' was also often used\")"}, "madsrdf:citationSource": "Grove music online WWW site, Mar. 7, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Nicholson, S. Jazz-rock, c1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n158b07d4736f402aa9c10af2cc968928b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Electric jazz"}}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Electric jazz"}}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n158b07d4736f402aa9c10af2cc968928b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jazz-rock fusion (Music)"}}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jazz-rock fusion (Music)"}}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n158b07d4736f402aa9c10af2cc968928b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fusion (Music)"}}, {"@id": "_:n158b07d4736f402aa9c10af2cc968928b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fusion (Music)"}}], "@id": "/authorities/genreForms/gf2014026880"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026881", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJigs (Dance music)", "identifiers:lccn": "gf2014026881", "madsrdf:adminMetadata": [{"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b1"}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jigs (Dance music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b3"}]}, "madsrdf:exampleNote": "Note under [Jiggs (Ballad operas)]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b5"}, "madsrdf:hasSource": {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b8"}, "madsrdf:hasVariant": [{"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b9"}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "A dance genre popular in the British Isles from the 16th century onward. For stage entertainments popular in England and Continental Europe during the 16th-18th centuries that combined drama, music, and dance, see [Jiggs (Ballad operas).]"}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:45:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jigs (Dance music)"}}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jigs (Music)"}}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jigs (Music)"}}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jig. A vigorous dance popular in the British Isles from the 16th century onward.)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gigues (Music)"}}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gigues (Music)"}}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jigs (Music)"}}, {"@id": "_:nf2dca3343fb04b3b85865b7faadfa893b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jigs (Music)"}}], "@id": "/authorities/genreForms/gf2014026881"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026882", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJingles (Advertising songs)", "identifiers:lccn": "gf2014026882", "madsrdf:adminMetadata": [{"@id": "_:n9f0c559dfd1f4815869233318afac926b1"}, {"@id": "_:n9f0c559dfd1f4815869233318afac926b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jingles (Advertising songs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9f0c559dfd1f4815869233318afac926b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:n9f0c559dfd1f4815869233318afac926b5"}, {"@id": "_:n9f0c559dfd1f4815869233318afac926b6"}, {"@id": "_:n9f0c559dfd1f4815869233318afac926b7"}, {"@id": "_:n9f0c559dfd1f4815869233318afac926b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9f0c559dfd1f4815869233318afac926b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9f0c559dfd1f4815869233318afac926b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n9f0c559dfd1f4815869233318afac926b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jingles (Advertising songs)"}}, {"@id": "_:n9f0c559dfd1f4815869233318afac926b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Stone, A. Jingles, c1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9f0c559dfd1f4815869233318afac926b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Harvard dict. of music", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n9f0c559dfd1f4815869233318afac926b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jingle)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n9f0c559dfd1f4815869233318afac926b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(jingle)"}, "madsrdf:citationSource": "New Grove dict. of Amer. music", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026882"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026883", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJiuta", "identifiers:lccn": "gf2014026883", "madsrdf:adminMetadata": [{"@id": "_:n0c5a36e5144944a38d84c71430db9511b1"}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jiuta"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0c5a36e5144944a38d84c71430db9511b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": [{"@id": "_:n0c5a36e5144944a38d84c71430db9511b5"}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b6"}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b7"}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b8"}], "madsrdf:hasVariant": {"@id": "_:n0c5a36e5144944a38d84c71430db9511b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jiuta"}}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 56 (Ikuta Kengyo (1656-1715) devised the style of performing Ji-uta, a Shamisen music, together with the Koto)"}, "madsrdf:citationSource": "Kishibe, S. The traditional music of Japan, 1982:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 9, p. 530 (Japan, IV, 2. instruments, koto. d) The Ikuta-ryu. In this context the term jiuta ('regional songs') refers to predominantly lyrical songs composed to contemporary texts in a flexible musical form.)"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Ji-uta\" corresponds to the two characters (Ji and uta) that comprise this term, but it is usually spelled Jiuta without hyphenation.)"}, "madsrdf:citationSource": "E-mail from Yoshitaka Terada, National Museum of Ethnology, Osaka, Japan, Feb. 29, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(jiuta)"}, "madsrdf:citationSource": "Mizu no hentai [SR] 1961", "madsrdf:citationStatus": "found"}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0c5a36e5144944a38d84c71430db9511b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ji-uta"}}, {"@id": "_:n0c5a36e5144944a38d84c71430db9511b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ji-uta"}}], "@id": "/authorities/genreForms/gf2014026883"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026884", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJongos (Music)", "identifiers:lccn": "gf2014026884", "madsrdf:adminMetadata": [{"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb1"}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jongos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb5"}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb6"}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb7"}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb8"}], "madsrdf:hasVariant": [{"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb9"}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jongos (Music)"}}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "4 Afro-Brazilian folk music traditions (The most common traits of jongo songs include two-bar repeated isometric phrases, prevailing conjunct motion, parallel singing and syncopated percussion accompaniment)"}, "madsrdf:citationSource": "Grove Music online, accessed on April 4, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Garland Encyclopedia of World music, v. 10, 1998;Wikipedia, viewed April 12, 2012", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 3, pp. 1195-1196 (Jongo. It originated from the dances performed by slaves who worked at coffee plantations in the Para\u00edba Valley between Rio de Janeiro and S\u00e3o Paulo, and also at farms in some areas of Minas Gerais and Esp\u00edrito Santo. Jongo is a member of a larger group of Afro-Brazilian dances ... Jongos usually takes place during a nightlong party in which several people dance in pairs or in a circle, to the sound of two or more drums, while a soloist sings short phrases answered by the group ... Jongo songs, also called pontos, are sung in Portuguese but may include words of African origin ... Today, jongos continues to be performed by descendants of slaves in at least a dozen communities, in rural settings as well as in the periphery of cities. Since the 1990s jongo has experienced a revival and become more widely known as a hallmark of Afro-Brazilian culture.)"}, "madsrdf:citationSource": "Encyclopedia of African-American culture and history, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ch. 5 (eighty-one tracks were grouped in the same order that they appeared on the reel, with the exception of some pontos de jongo that in the original appeared separately, which would seem to indicate that they were recorded at two different sessions)"}, "madsrdf:citationSource": "Work cat.: Cangoma calling: spirits and rhythms of freedom in Brazilian jongo slavery songs, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poritos de jongo (Music)"}}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poritos de jongo (Music)"}}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pontos"}}, {"@id": "_:nbe33bf4de5a74f6dbacad9fa1cbc681cb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pontos"}}], "@id": "/authorities/genreForms/gf2014026884"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026885", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJoropos (Music)", "identifiers:lccn": "gf2014026885", "madsrdf:adminMetadata": [{"@id": "_:n72273fb86ca04a64ae3e5434d340d856b1"}, {"@id": "_:n72273fb86ca04a64ae3e5434d340d856b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Joropos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n72273fb86ca04a64ae3e5434d340d856b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n72273fb86ca04a64ae3e5434d340d856b5"}, {"@id": "_:n72273fb86ca04a64ae3e5434d340d856b6"}, {"@id": "_:n72273fb86ca04a64ae3e5434d340d856b7"}, {"@id": "_:n72273fb86ca04a64ae3e5434d340d856b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n72273fb86ca04a64ae3e5434d340d856b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n72273fb86ca04a64ae3e5434d340d856b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n72273fb86ca04a64ae3e5434d340d856b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Joropos (Music)"}}, {"@id": "_:n72273fb86ca04a64ae3e5434d340d856b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Venezuela: Folk music: Hispano-Venezuelan music: Social entertainment music: joropo, Venezuela's national dance; more recently the name \"joropo\" has been given to a type of composition by academically trained musicians using melodies and rhythms of a creole character)"}, "madsrdf:citationSource": "Grove music online WWW site, June 6, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n72273fb86ca04a64ae3e5434d340d856b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 539-540 (To most Venezuelans, the epitome of folk dance is the joropo, a music and dance influenced by both Africa and Europe and known as the national dance of Venezuela. The term joropo refers to more than just dance. It also denotes a genre of music and the event in which the music and dance are performed. A person can attend a joropo (event), request the performance of a particular joropo (musical piece), and then execute a joropo (dance). The texts, sung in Spanish, relate to Spanish genres of early colonial days)"}, "madsrdf:citationSource": "Garland encyc. world mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n72273fb86ca04a64ae3e5434d340d856b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2005372898: Romero, A. El joropo llanero y el joropo central, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n72273fb86ca04a64ae3e5434d340d856b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Venezuela: joropo: the national dance rhythm and song, imitative of the rhythm of horseback riding)"}, "madsrdf:citationSource": "White, D. Dict. pop. mus. styles of the world", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026885"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026886", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJotas (Music)", "identifiers:lccn": "gf2014026886", "madsrdf:adminMetadata": [{"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb1"}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jotas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb5"}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb6"}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb7"}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb8"}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jotas (Music)"}}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(jota: A national dance song of northern Spain, dating to the 17th century)"}, "madsrdf:citationSource": "Baker's dict. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 8, p. 594 (Spain's dances include the jota, the \"mother dance\" of the culture, with many variants; it has an instrumental introduction, followed by octosyllabic quatrains of coplas interspersed with refrains and instrumental interludes)"}, "madsrdf:citationSource": "Garland encyc. world mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Spain, sec. II, 4: Traditional and popular music: Dance and instrumental music: The jota, regarded as primarily Aragonese, is nevertheless common in Navarre, Old and New Castile, Murcia and in Valencia (where the local variant is sufficiently differentiated to merit the name jota valenciana); it also occurs in local versions in most of the other Spanish regions. The jota is invariably in rapid triple time, with four-bar phrases. Its core section [is] called copla, whose text is an octosyllabic quatrain)"}, "madsrdf:citationSource": "Grovemusic.com WWW site, Feb. 7, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jota: a Spanish folk dance in 3/4 time performed by a man and a woman to intricate castanet and heel rhythms; the music of the jota)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e532ee6441549918ae2d3c139aeab3cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jota: A genre of song and dance especially characteristic of Arag\u00f3n, but widely disseminated through the Spanish peninsula. Its existence cannot be firmly documented before the second half of the 17th century. As a quintessentially Spanish form of folk music, it has often been taken over into art music)"}, "madsrdf:citationSource": "New Harvard dict. mus.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026886"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026887", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJungle (Music)", "identifiers:lccn": "gf2014026887", "madsrdf:adminMetadata": [{"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb1"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jungle (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026065"}, "madsrdf:hasSource": [{"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb5"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb6"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb7"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb8"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb9"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb10"}], "madsrdf:hasVariant": {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-07-13T13:04:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "revised"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jungle (Music)"}}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jungle music guide 4 Southern California)"}, "madsrdf:citationSource": "Jungle Breakz web site, June 18, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(supplier of quality underground dance music: includes drum & bass)"}, "madsrdf:citationSource": "WWW.elevatorrecords.com WWW site, Arp. 18, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 76 (jungle; emerged from British rave culture in 1994, combining reggae, hip-hop rhythms and techno)"}, "madsrdf:citationSource": "Mitchell, T. Popular music and local identity, 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xi (a combination of timestretched breakbeats playing at approximately 160 beats per minute with bass lines lifted from Reggae, running at 80 bpm and the metronomic 4/4 bass drum removed)"}, "madsrdf:citationSource": "James, M. State of bass : jungle, the story so far, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jungle/Drum'n'bass: Based almost entirely in England, Jungle (also known as drum'n'bass) is a permutation of hardcore techno that emerged in the early '90s.)"}, "madsrdf:citationSource": "WWW All-music guide", "madsrdf:citationStatus": "found"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Rolling Stone encyc. rock & roll, 1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Drum 'n' bass (Music)"}}, {"@id": "_:n651f6eee3b1748ef9b4d7ab16c9f26dbb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drum 'n' bass (Music)"}}], "@id": "/authorities/genreForms/gf2014026887"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026888", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKabuki music", "identifiers:lccn": "gf2014026888", "madsrdf:adminMetadata": [{"@id": "_:n5a2586c5dc5547618adf31af359149f1b1"}, {"@id": "_:n5a2586c5dc5547618adf31af359149f1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kabuki music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5a2586c5dc5547618adf31af359149f1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026873"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026061"}, "madsrdf:hasSource": {"@id": "_:n5a2586c5dc5547618adf31af359149f1b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5a2586c5dc5547618adf31af359149f1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-03-11T09:58:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5a2586c5dc5547618adf31af359149f1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5a2586c5dc5547618adf31af359149f1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kabuki music"}}, {"@id": "_:n5a2586c5dc5547618adf31af359149f1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Japan VI: Theatre music. 3: Kabuki music (Japanese theatrical form popular since the Edo period (1603-1868) and the source of many major musical genres.) iii. Functions of the music (Offstage music, like film music, may give sound effects, set the mood, support stage actions or imply unspoken thoughts... Onstage music is generally direct narrative commentary or dance accompaniment.)"}, "madsrdf:citationSource": "Grove music online, viewed August 10, 2014 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026888"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026889", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKacapi-suling", "identifiers:lccn": "gf2014026889", "madsrdf:adminMetadata": [{"@id": "_:n74628318c1584afcb7aa3edcda9e283ab1"}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kacapi-suling"}, "madsrdf:elementList": {"@list": [{"@id": "_:n74628318c1584afcb7aa3edcda9e283ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n74628318c1584afcb7aa3edcda9e283ab5"}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab6"}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab7"}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab8"}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kacapi-suling"}}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kacapi suling is a form of Sundanese music from West Java, essentially tembang Sunda minus vocals)"}, "madsrdf:citationSource": "Wikipedia, viewed 17 Feb. 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 715 (Kacapi-suling, recent urban offshoot of tembang Sunda, is the instrumental performance of the fixed-meter songs (panambih) of tembang Sunda, and includes the usual tembang Sunda instrumentation of Kacapi, rincik, and suling)"}, "madsrdf:citationSource": "Garland world music, v. 4, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Kacapi: kacapi-suling ensemble is a derived recorded genre, featuring the metrical songs of tembang Sunda but without the vocal component) (under Indonesia, West Java, Sunda: metrical panambih songs are performed without singing in the genre kacapi suling)"}, "madsrdf:citationSource": "Grove Music Online, viewed 17 Feb. 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert (Kacapi suling, played on two box zithers (kacapi) and a flute (suling), is one of the main styles of music found in the Sunda areas of western Java)"}, "madsrdf:citationSource": "Work cat.: Jaya, S. Java [SR] p2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74628318c1584afcb7aa3edcda9e283ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 35 (current type of purely instrumental music, kacapi-suling, with kacapi indung, suling, and (one or two) kacapi rincik, instruments also used to accompany the singing in tembang Sunda)"}, "madsrdf:citationSource": "Zanten, W.V. Sundanese music, 1989:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026889"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026890", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKagok", "identifiers:lccn": "gf2014026890", "madsrdf:adminMetadata": [{"@id": "_:n6d4938b71a5242e89dc8ef7cfb823c64b1"}, {"@id": "_:n6d4938b71a5242e89dc8ef7cfb823c64b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kagok"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6d4938b71a5242e89dc8ef7cfb823c64b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": {"@id": "_:n6d4938b71a5242e89dc8ef7cfb823c64b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6d4938b71a5242e89dc8ef7cfb823c64b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6d4938b71a5242e89dc8ef7cfb823c64b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6d4938b71a5242e89dc8ef7cfb823c64b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kagok"}}, {"@id": "_:n6d4938b71a5242e89dc8ef7cfb823c64b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(local music is another important facet of the Korean tradition. One of the longest and rarest older forms is the kagok, which consists of 26 five-section solo songs and one duet. Accompaniments and interludes are provided by a small ensemble that usually consists of a k\u014fmungo (six-stringed zither), a se'piri (a small double-reed aerophone), a taeg\u016dm (large bamboo flute), a haeg\u016dm (two-stringed fiddle), and a changgo (hourglass drum)"}, "madsrdf:citationSource": "Britannica academic edition WWW site, viewed June 6, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026890"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026891", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKanto (Popular music)", "identifiers:lccn": "gf2014026891", "madsrdf:adminMetadata": [{"@id": "_:n74f0054888c04540b5f8d75b8882953ab1"}, {"@id": "_:n74f0054888c04540b5f8d75b8882953ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kanto (Popular music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n74f0054888c04540b5f8d75b8882953ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n74f0054888c04540b5f8d75b8882953ab5"}, {"@id": "_:n74f0054888c04540b5f8d75b8882953ab6"}, {"@id": "_:n74f0054888c04540b5f8d75b8882953ab7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n74f0054888c04540b5f8d75b8882953ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n74f0054888c04540b5f8d75b8882953ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n74f0054888c04540b5f8d75b8882953ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kanto (Popular music)"}}, {"@id": "_:n74f0054888c04540b5f8d75b8882953ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Turkey: Operetta and Kanto: The history of kanto was intimately connected with that of operetta. While operetta was initially cultivated by and for the self-consciously westernizing non-Muslim bourgeoisie, kanto emerged in the 'old' city's theaters, notably around today's \u015eehzadeba\u015f\u0131 Caddesi (formerly known as Direkleras\u0131, 'the arcades'). Humorous and evidently bawdy dramatic skits were interspersed with songs, which adapted Western instruments and orchestration and elements of harmonic and contrapuntal technique to the late Ottoman 'fa\u015f\u0131l' chamber orchestra and a monophonic, voice-based aesthetic. The early stars of this genre in its music theater context included Istanbul Greeks and Armenians)"}, "madsrdf:citationSource": "Continuum encyclopedia of popular music of the world, 2003. Vol. 6, Africa and the Middle East", "madsrdf:citationStatus": "found"}, {"@id": "_:n74f0054888c04540b5f8d75b8882953ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (kantolar) insert (kanto, kantolar (Turkish); kanto (English); musical style popular in the late 19th and early 20th centuries in the Istanbul entertainment district)"}, "madsrdf:citationSource": "Work cat.: Variete oriental, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74f0054888c04540b5f8d75b8882953ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Turkey, Popular music: The history of Turkish popular music is very much set in Istanbul. In the early 20th century the Muslim bourgeoisie frequented popular entertainment districts such as \u015eehzadeba\u015f\u0131 Caddesi (also known as Direkleras\u0131: 'Arcades') and Beyo\u011flu, where theatres produced a popular song genre known as kanto. Its lyrics reflected many new aspects of the changing city.)"}, "madsrdf:citationSource": "Grove music online, Feb. 6, 2013", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026891"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026892", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKaraoke", "identifiers:lccn": "gf2014026892", "madsrdf:adminMetadata": [{"@id": "_:n5ffc849a964144c99094f7f12b768623b1"}, {"@id": "_:n5ffc849a964144c99094f7f12b768623b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Karaoke"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5ffc849a964144c99094f7f12b768623b3"}]}, "madsrdf:exampleNote": "Note under [Recorded accompaniments]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027041"}], "madsrdf:hasSource": [{"@id": "_:n5ffc849a964144c99094f7f12b768623b5"}, {"@id": "_:n5ffc849a964144c99094f7f12b768623b6"}, {"@id": "_:n5ffc849a964144c99094f7f12b768623b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Recordings of popular songs without the main vocal parts, intended to be sung along with for recreational or competitive purposes. For accompaniments issued without the principal part or parts, or that have been provided for music that is normally monophonic, see [Recorded accompaniments.]"}, {"@id": "_:n5ffc849a964144c99094f7f12b768623b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5ffc849a964144c99094f7f12b768623b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:44:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5ffc849a964144c99094f7f12b768623b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Karaoke"}}, {"@id": "_:n5ffc849a964144c99094f7f12b768623b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(karaoke singing)"}, "madsrdf:citationSource": "MAGS, 1-24-95", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ffc849a964144c99094f7f12b768623b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Random House;Am. heritage dict.;Web. 3;Barnhart dict.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n5ffc849a964144c99094f7f12b768623b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(karaoke; singing popular songs to prerecorded accompaniments originally usually on cassette; originated in Japan)"}, "madsrdf:citationSource": "Work cat.: 93-79026: Gonda, T.A. Karaoke, the bible, 1993", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026892"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026893", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKaskawi (Music)", "identifiers:lccn": "gf2014026893", "madsrdf:adminMetadata": [{"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b1"}, {"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kaskawi (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b5"}, {"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b6"}, {"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b7"}, {"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kaskawi (Music)"}}, {"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "archives, under The beating heart of Suriname (kaskawi, a recent fusion of kawina and kaseko, popularized by Ai Sa Si)"}, "madsrdf:citationSource": "Caribbean Beat WWW site, Jun. 19, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Ai Sa Si, the masters of kaskawi)"}, "madsrdf:citationSource": "Work cat.: 2001068261: Ai Sa Si (Musical group). Druppels van--, p1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Surinam (3. Rural and urban creoles: a new urban variant called kaskawi developed, incoporating electric guitars and keyboards along with elements of urban kaseko and other Afro-Caribbean styles. This remains one of the most popular urban styles among the young)"}, "madsrdf:citationSource": "New Grove dict. mus., 2nd ed. WWW site, June 19, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf410f4fac5504f10a3835c4674e5e0e3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 223 (the latest trend is a fusion of kawina with kaseko music, called kaskawi, which blends the roots sound of kawina drums and vocals with electric instrumentation and high-tech studio wizardry)"}, "madsrdf:citationSource": "Manuel, P. Caribbean currents, 1995:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026893"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026894", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKeroncong", "identifiers:lccn": "gf2014026894", "madsrdf:adminMetadata": [{"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb1"}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Keroncong"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb5"}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb6"}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb7"}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb8"}], "madsrdf:hasVariant": [{"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb9"}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Keroncong"}}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(keyword search \"keroncong\" yields 82 hits; keyword search \"kroncong not k650 kroncong\" yields 16 hits."}, "madsrdf:citationSource": "LC Database, Nov. 19, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Aneka langgam dan keroncong, 1984.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(kroncong, keroncong)"}, "madsrdf:citationSource": "Grove Music Online, Nov. 19, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sanusi dengan Orkes Kerontjong Sinar Djakarta; appears on sound recording label as: kerontjong)"}, "madsrdf:citationSource": "Free Music Archive WWW site, Nov. 19, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kerontjong"}}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kerontjong"}}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kroncong"}}, {"@id": "_:n5e78d0a7ecae41d79ffa6d71c33039cfb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kroncong"}}], "@id": "/authorities/genreForms/gf2014026894"}
