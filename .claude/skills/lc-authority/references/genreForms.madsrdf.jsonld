df:elementValue": {"@language": "en", "@value": "Live-action/animated television programs"}}, {"@id": "_:n912ec777dd6e40088ebcd1714b346bedb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n912ec777dd6e40088ebcd1714b346bedb34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hybrid animation/live-action television programs"}}, {"@id": "_:n912ec777dd6e40088ebcd1714b346bedb34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hybrid animation/live-action television programs"}}, {"@id": "_:n912ec777dd6e40088ebcd1714b346bedb36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n912ec777dd6e40088ebcd1714b346bedb37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Animation/live-action television programs, Hybrid"}}, {"@id": "_:n912ec777dd6e40088ebcd1714b346bedb37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Animation/live-action television programs, Hybrid"}}], "@id": "/authorities/genreForms/gf2011026757"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026760", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:nc4b97a0733674b34bde589be9e31c9cfb1"}, {"@id": "_:nc4b97a0733674b34bde589be9e31c9cfb2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is coverd by the genre/form terms {Comedy sketches} (DLC)gf2014026265 and {Filmed performances} (DLC)gf2011026276"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc4b97a0733674b34bde589be9e31c9cfb3"}]}, "madsrdf:hasLaterEstablishedForm": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026276"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026265"}], "madsrdf:note": "Films that record the performances of comedy sketches.", "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed comedy sketches"}}, {"@id": "_:nc4b97a0733674b34bde589be9e31c9cfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-24T10:11:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:nc4b97a0733674b34bde589be9e31c9cfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-10-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc4b97a0733674b34bde589be9e31c9cfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed comedy sketches"}}], "@id": "/authorities/genreForms/gf2011026760"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026761", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n85b1b52855714e989e0c75ac8d612073b1"}, {"@id": "_:n85b1b52855714e989e0c75ac8d612073b2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is covered by the genre/form term {Sports films} (gf2011026601)."}, "madsrdf:elementList": {"@list": [{"@id": "_:n85b1b52855714e989e0c75ac8d612073b3"}]}, "madsrdf:useInstead": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026601"}, "madsrdf:variantLabel": {"@language": "en", "@value": "Curling films"}}, {"@id": "_:n85b1b52855714e989e0c75ac8d612073b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-07-16T13:30:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n85b1b52855714e989e0c75ac8d612073b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-11-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n85b1b52855714e989e0c75ac8d612073b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Curling films"}}], "@id": "/authorities/genreForms/gf2011026761"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026769", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n9abaf2f6cad94d098bed3888e2d4c8c2b1"}, {"@id": "_:n9abaf2f6cad94d098bed3888e2d4c8c2b2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is covered by the genre/form term {Sports films} (gf2011026601)."}, "madsrdf:elementList": {"@list": [{"@id": "_:n9abaf2f6cad94d098bed3888e2d4c8c2b3"}]}, "madsrdf:useInstead": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026601"}, "madsrdf:variantLabel": {"@language": "en", "@value": "Horse racing films"}}, {"@id": "_:n9abaf2f6cad94d098bed3888e2d4c8c2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-07-16T13:30:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n9abaf2f6cad94d098bed3888e2d4c8c2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-11-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9abaf2f6cad94d098bed3888e2d4c8c2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horse racing films"}}], "@id": "/authorities/genreForms/gf2011026769"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026774", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMachinima television programs", "identifiers:lccn": "gf2011026774", "madsrdf:adminMetadata": [{"@id": "_:n2990effa405f4cdfab93c2c58fa08833b1"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Machinima television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2990effa405f4cdfab93c2c58fa08833b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026050"}, "madsrdf:hasSource": [{"@id": "_:n2990effa405f4cdfab93c2c58fa08833b5"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b6"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b7"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b8"}], "madsrdf:hasVariant": [{"@id": "_:n2990effa405f4cdfab93c2c58fa08833b9"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b12"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-11-15T11:28:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-08-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Machinima television programs"}}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Machinima films, new genre, people shoot films in real-time 3D virtual environments. The actors aren't human, but virtual Avatars or Objects, controlled by user input or scripting and act in a virtual world that is simulated using a computer game)"}, "madsrdf:citationSource": "CIANT, Sept. 19, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Machinima is the use of real-time 3D computer graphics rendering engines to create a cinematic production. Most often, video games are used to generate the computer animation; machinima [has now] appeared in mainstream media, including television series and advertisements; Rooster Teeth sells DVDs of their Red vs. Blue series and, under sponsorship from Electronic Arts, helped to promote The Sims 2 by using the game to make a machinima series, The Strangerhood)"}, "madsrdf:citationSource": "Wikipedia, June 8, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Red vs. Blue, often abbreviated as RvB, is a set of related comic science fiction video series created by Rooster Teeth Productions and distributed through the Internet and on DVD; series is primarily produced using the machinima technique of synchronizing video footage from a game to pre-recorded dialogue and other audio; has been credited with bringing new popularity to machinima, helping it to gain more mainstream exposure, and attracting more people to the art form)"}, "madsrdf:citationSource": "Wikipedia, June 8, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Red vs. blue (Television program). Season 6-8. Redvsblue. The recollection, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2990effa405f4cdfab93c2c58fa08833b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "3D game-based television programs"}}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "3D game-based television programs"}}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2990effa405f4cdfab93c2c58fa08833b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "3D game-based animated television programs"}}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "3D game-based animated television programs"}}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2990effa405f4cdfab93c2c58fa08833b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Machinimas (Television programs)"}}, {"@id": "_:n2990effa405f4cdfab93c2c58fa08833b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Machinimas (Television programs)"}}], "@id": "/authorities/genreForms/gf2011026774"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026775", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDadaist films", "identifiers:lccn": "gf2011026775", "madsrdf:adminMetadata": [{"@id": "_:n720ab7d9922246babd614232f981c409b1"}, {"@id": "_:n720ab7d9922246babd614232f981c409b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dadaist films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n720ab7d9922246babd614232f981c409b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026235"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026625"}, "madsrdf:hasSource": [{"@id": "_:n720ab7d9922246babd614232f981c409b5"}, {"@id": "_:n720ab7d9922246babd614232f981c409b6"}, {"@id": "_:n720ab7d9922246babd614232f981c409b7"}, {"@id": "_:n720ab7d9922246babd614232f981c409b8"}, {"@id": "_:n720ab7d9922246babd614232f981c409b9"}, {"@id": "_:n720ab7d9922246babd614232f981c409b10"}, {"@id": "_:n720ab7d9922246babd614232f981c409b11"}, {"@id": "_:n720ab7d9922246babd614232f981c409b12"}, {"@id": "_:n720ab7d9922246babd614232f981c409b13"}, {"@id": "_:n720ab7d9922246babd614232f981c409b14"}, {"@id": "_:n720ab7d9922246babd614232f981c409b15"}], "madsrdf:hasVariant": {"@id": "_:n720ab7d9922246babd614232f981c409b16"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films produced in the 1920s that juxtapose seemingly nonsensical, incoherent, or unrelated images and vignettes, giving the appearance of spontaneous thought."}, {"@id": "_:n720ab7d9922246babd614232f981c409b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:09:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n720ab7d9922246babd614232f981c409b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-10-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n720ab7d9922246babd614232f981c409b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dadaist films"}}, {"@id": "_:n720ab7d9922246babd614232f981c409b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 13-14 (\"... examining why Hans Richter believed the films he made in the early 1920s, Rhythm 21 (1921), Rhythm 23 (1923), and Rhythm 25 (1924), to be Dadaist. The status of these films as Dadaist has always been somewhat uncertain, because they are very different from the canonical Dadaist film, Ren\u00e9 Clair and Picabia's Entr'acte (1923). Entr'acte is considered by most commentators to be the quintessential Dadaist film due to its parodic subversion of narrative structure, its mocking of high art forms such as ballet and other \"bourgeois\" phenomena (funerals), and its mimicking of irrational mental processes. Certainly, it is the film most often privileged in commentaries on Dadaist film.\")"}, "madsrdf:citationSource": "Turvey, M. Dada between Heaven and Hell : abstraction and universal language in the rhythm films of Hans Richter, in October, summer 2003, via WWW, viewed Aug. 10, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n720ab7d9922246babd614232f981c409b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ballet M\u00e9canique (Ballet M\u00e9canique (1924) was a project by the American composer George Antheil and the filmmaker/artists Fernand L\u00e9ger and Dudley Murphy; Ballet M\u00e9canique was originally written to accompany a Dadaist film of the same name, directed by Dudley Murphy and Fernand L\u00e9ger, with cinematography by Man Ray)"}, "madsrdf:citationSource": "Wikipedia, Aug. 10, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n720ab7d9922246babd614232f981c409b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Film Exhibitions: Dada on Film, June 24-September 4, 2006. \"Dada was a provocative and irreverent art movement, founded in Switzerland in the early twentieth century, in which a seemingly chaotic, spontaneous, and pessimistic aesthetic influenced painting, sculpture, theater, literature, and film. The movement's name is a willfully nonsensical word, intended to punctuate the meaninglessness artists saw in their contemporaneous worldview. Dada filmmakers such as Hans Richter, Man Ray, and Viking Eggeling were challenged by the developing technology of filmmaking in the 1920s. This confluence of technology and aesthetic experimentation suited the Dadaists' passion for the machine-made object. The visual disruption created by the Dada filmmakers in the 1920s provided a legacy of aesthetic language for the cinematic experiments of future generations of avant-garde artists. The landmark films in this program--all produced between 1921 and 1928--are also on view within the context of other works in other mediums by the same artists in the Dada exhibition on the sixth floor of the Museum. All films are drawn from MoMA's collection and are silent.\")"}, "madsrdf:citationSource": "Museum of Modern Art website, Aug. 10, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n720ab7d9922246babd614232f981c409b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(includes: Entr'acte (1924); Ballet m\u00e9canique (1924))"}, "madsrdf:citationSource": "Work cat.: Anthology of surreal cinema. Volume one [VR], c2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n720ab7d9922246babd614232f981c409b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "sound, music & movies (Ren\u00e9 Clair and Francis Picabia: Entr'acte (1924); Man Ray: L'\u00c9toile de Mer (1928), Retour \u00e0 la Raison (1923); Emak Bakia (1926))"}, "madsrdf:citationSource": "Dada and dadaism website, Aug. 10, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n720ab7d9922246babd614232f981c409b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 10 (\"The difference between Dada and Surrealist films ... lies in their different strategies of defamiliarizing social reality. Surrealist filmmakers largely rely on conventional cinematography (narratives, optical realism, characters) as a means to draw the viewer into the reality produced by the film. The incoherent, non-narrative, illogical nature of Dada films, which constantly defamiliarize the familiar world through cinematic manipulations, never let the viewer enter the world of the film.\")"}, "madsrdf:citationSource": "Dada and surrealist film, 1996, via Google books, viewed Aug. 10, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n720ab7d9922246babd614232f981c409b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n720ab7d9922246babd614232f981c409b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dada: Work following the Dada art movement aesthetic of juxtaposing seemingly nonsensical or unrelated images and vignettes, giving the appearance of spontaneous thought without necessarily having a deep \"meaning.\" Such work often uses trick photography. Example: Entr'acte)"}, "madsrdf:citationSource": "Taves, B. The moving image genre-form guide, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n720ab7d9922246babd614232f981c409b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(includes: Le retour \u00e0 la raison (1923); Emak-Bakia (1926); Rhythmus 21 (1921); Ballet m\u00e9canique (1924))"}, "madsrdf:citationSource": "Avant-garde [VR] : experimental cinema of the 1920s and '30s, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n720ab7d9922246babd614232f981c409b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dada, Dadaism see Surrealist Film; listed as subcategory under Surrealist Film (Surrealism): Dada (Dadaism): artistic and literary movement that rejected form and traditional art; believed in \"accidental\" creation, automatic writing and drawing and the use of ready-mades for exhibition as works of art; it produced few filmic manifestations, the movement being superseded by the more vigorous and optimistic surrealist venture. Examples: Le retour \u00e0 la raison (1923, Man Ray); Entr'acte (1924, Ren\u00e9 Clair; Emak Bakia (1926, Man Ray))"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n720ab7d9922246babd614232f981c409b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dada: A literary/art movement founded in 1916 in Zurich; to negate the traditional relationship between calculation and creativity in the arts by approaching expression in a more playful, aleatory manner; was a stepping-stone to surrealism, which developed in the 1920s; Man Ray, working in France in the 1920s, is frequently referred to as a \"Dadaist filmmaker.\" Ray used collage techniques in his films, spreading materials on the emulsion and then processing the film for whatever results occurred (Le retour \u00e0 la raison, 1923; Emak Bakia, 1927). The early free-flowing, rhythmic films of Ren\u00e9 Clair were also inspired by the playful interests of the Dada movement)"}, "madsrdf:citationSource": "Beaver, F.E. Dictionary of film terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n720ab7d9922246babd614232f981c409b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n720ab7d9922246babd614232f981c409b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dada films"}}, {"@id": "_:n720ab7d9922246babd614232f981c409b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dada films"}}], "@id": "/authorities/genreForms/gf2011026775"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026779", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n1522503cbc1f440b92fde4250385f9c3b1"}, {"@id": "_:n1522503cbc1f440b92fde4250385f9c3b2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is not a valid genre/form term."}, "madsrdf:elementList": {"@list": [{"@id": "_:n1522503cbc1f440b92fde4250385f9c3b3"}]}, "madsrdf:note": "This heading is used as a genre/form heading for European films produced from 1919 through approximately 1933 that are highly stylized, atmospheric, somber, and symbolic, and that empoy dramatic lighting, stylized acting, the symbolic use of objects, etc., to create meaning and atmospheric tensions.", "madsrdf:variantLabel": {"@language": "en", "@value": "Expressionist films"}}, {"@id": "_:n1522503cbc1f440b92fde4250385f9c3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-04T16:51:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n1522503cbc1f440b92fde4250385f9c3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-10-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n1522503cbc1f440b92fde4250385f9c3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Expressionist films"}}], "@id": "/authorities/genreForms/gf2011026779"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026784", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aApocalyptic television programs", "identifiers:lccn": "gf2011026784", "madsrdf:adminMetadata": [{"@id": "_:n87d391354b5343128f0c392ae5bcae3bb1"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Apocalyptic television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n87d391354b5343128f0c392ae5bcae3bb3"}]}, "madsrdf:exampleNote": "Note under [Dystopian television programs]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026558"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026627"}], "madsrdf:hasSource": [{"@id": "_:n87d391354b5343128f0c392ae5bcae3bb5"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb6"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb7"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb8"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb9"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb10"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb11"}], "madsrdf:hasVariant": [{"@id": "_:n87d391354b5343128f0c392ae5bcae3bb12"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb15"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb18"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb21"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb24"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs set in a world or civilization after a catastrophic event (e.g., nuclear war, an alien invasion), sometimes also including the period immediately preceding the event. For television programs set in an uncertain future, in a society ruled by an ineffectual, corrupt, or oppressive regime or by aliens, robots, etc., see [Dystopian television programs.]"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:19:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-10-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Apocalyptic television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Post-Apocalyptic landscape is one of the staples of blockbuster sci-fi adventure films and, surprisingly frequently, television series, including the most current series, The Walking Dead, which features a zombified post-apocalyptic setting ... In movies and tv, in particular, there's a growing sub-genre of pre-apocalyptic storytelling. Generally these are stories that give us glimpses of the results of worldwide devastation and then, through the wonders of time travel, give our heroes the opportunity to prevent the oncoming devastation)"}, "madsrdf:citationSource": "Post-apocalyptic TV series and shows, via WWW, Dec. 2, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Category: Post-apocalyptic television series (television-related post-apocalyptic fiction which includes television series, television movies and pilots) List of apocalyptic films (apocalyptic films; All films within this list feature either the end of the world, a prelude to such an end, and/or a post-apocalyptic wasteland setting) Apocalyptic and post-apocalyptic fiction (Apocalyptic fiction is a sub-genre of science fiction that is concerned with the end of civilization due to a catastrophic event such as nuclear war, pandemic, impact event, alien invasion, dysgenics, Cybernetic revolt, economic collapse, Supernatural phenomena, ecological disaster, resource depletion, or some other general disaster. Post-apocalyptic fiction is set in a world or civilization after such a disaster. The time frame may be immediately after the catastrophe, focusing on the travails or psychology of survivors, or considerably later, often including the theme that the existence of pre-catastrophe civilization has been forgotten (or mythologized). Post-apocalyptic stories often take place in an agrarian, non-technological future world, or a world where only scattered elements of technology remain. There is a considerable degree of blurring between this form of science fiction and that which deals with false utopias or dystopic societies.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 2, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subcategory under Science Fiction Film: SF Disaster Films. The two main species of SF disaster movies are the end-of-the-world films, involving some catastrophic upheaval due to natural, man-made, or extraterrestrial causes, and films dealing with post-holocaust situations in which remnants of Earth's population strive to make a go of it.)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Jeremiah (Jeremiah is an American television series ... The series takes place in a post-apocalyptic future where most of the adult population has been wiped out by a deadly virus.) Survivors (Survivors is a British post-apocalyptic fiction television series) Dark Angel (Dark Angel is an American biopunk/cyberpunk science fiction television series ... Set in a post-apocalyptic Seattle) Thunderstone (Thunderstone is a 1999 Australian children's television series ... set in a post-apocalyptic world after Earth is hit by a comet)"}, "madsrdf:citationSource": "Wikipedia, Dec. 2, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yee, M.M. Moving image materials: genre terms, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Jeremiah (Television program). Season 1. Jeremiah. The complete first season [VR] c2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "in book review of Homer Simpson marches on Washington (the short-lived postapocalyptic television series Jericho)"}, "madsrdf:citationSource": "Mitchell, C.P. A guide to apocalyptic cinema, 2001, via Choice reviews online, Dec. 2, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87d391354b5343128f0c392ae5bcae3bb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Doomsday television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Doomsday television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87d391354b5343128f0c392ae5bcae3bb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Post-apocalyptic science fiction television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Post-apocalyptic science fiction television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87d391354b5343128f0c392ae5bcae3bb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "End-of-the-world television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "End-of-the-world television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87d391354b5343128f0c392ae5bcae3bb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Postapocalyptic television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Postapocalyptic television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87d391354b5343128f0c392ae5bcae3bb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Postapocalyptic science fiction television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Postapocalyptic science fiction television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n87d391354b5343128f0c392ae5bcae3bb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Post-apocalyptic television programs"}}, {"@id": "_:n87d391354b5343128f0c392ae5bcae3bb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Post-apocalyptic television programs"}}], "@id": "/authorities/genreForms/gf2011026784"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026785", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDystopian television programs", "identifiers:lccn": "gf2011026785", "madsrdf:adminMetadata": [{"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b1"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dystopian television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b3"}]}, "madsrdf:exampleNote": "Note under [Apocalyptic television programs]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026558"}, "madsrdf:hasSource": [{"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b5"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b6"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b7"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b8"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b9"}], "madsrdf:hasVariant": [{"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b10"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b13"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b16"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs set in an uncertain future, in a society ruled by an ineffectual, corrupt, or oppressive regime or by aliens, robots, etc. For television programs set in a world or civilization after a catastrophic event (e.g., nuclear war, an alien invasion), sometimes also including the period immediately preceding the event see [Apocalyptic television programs.]"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-10-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:20:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopian television programs"}}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dystopian television; dystopian television programmes; dystopian television series; dystopian television shows; dystopian television movie; dystopian science fiction television series; dystopian science fiction TV shows; dystopian science fiction TV series; dystopian TV series; dystopic television; dystopic television series; dystopic television show; dystopic TV show; dystopic TV game show)"}, "madsrdf:citationSource": "Google search, June 13, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subcategory under Science Fiction Film: Dystopian Films)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "list of dystopian music, TV programs, and games (Dark Angel, Fox, 2000-2002. A dystopian world set in Seattle after terrorists have set off an electromagnetic bomb which caused all electronic devices to stop working, disrupting life as we know it; Cold Lazarus, BBC, Channel 4 1996. A miniseries set in dystopian England; Jericho, CBS, 2006-2008. It is a dystopian series set in a fictional small town in Kansas called Jericho after a nationwide nuclear disaster plunged the entire country and the town into mass anarchy; The Twilight Zone, 1959-1964. Many episodes are set in futuristic and dystopian settings) Apocalyptic and post-apocalyptic fiction (There is a considerable degree of blurring between this form of science fiction and that which deals with false utopias or dystopic societies.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 2, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Dark angel. The complete first season [VR] c2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yee, M.M. Moving image materials: genre terms, 1988.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dystopic science fiction television programs"}}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopic science fiction television programs"}}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dystopic television programs"}}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopic television programs"}}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dystopia television programs"}}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopia television programs"}}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dystopian science fiction television programs"}}, {"@id": "_:nf26c2f30666b44ed9ec80f2666705c27b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopian science fiction television programs"}}], "@id": "/authorities/genreForms/gf2011026785"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026786", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKinescope films", "identifiers:lccn": "gf2011026786", "madsrdf:adminMetadata": [{"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b1"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kinescope films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}], "madsrdf:hasSource": [{"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b5"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b6"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b7"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b8"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b9"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b10"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b11"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b12"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b13"}], "madsrdf:hasVariant": [{"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b14"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b17"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b20"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b23"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-10-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:24:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kinescope films"}}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kinescope: Copy (in 16mm) of an early black-and-white television program; it was made by filming the live images directly off a TV screen. Before the use of videotape, this was the only way to preserve a copy of what was broadcast on television. Kinescope was the trade name for the cathode-ray (picture) tube on which the images were displayed. Also called a Kinescope recording or Kine.)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dictionary, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kinescope Recording (Kine, Kinescope, Kinnie, Telerecording). A film record of a live television show or television program before videotape became operational. Kinescope films are made by photographing from the TV tube the images shot by television cameras, thus preserving them for storage or later use. In Britain, kinescope recordings are known as telerecordings. Kinescopes are still in use)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Taves, B. The moving image genre-form guide, 1998;Yee, M.M. Moving image materials, 1988;Beaver, F.E. Dictionary of film terms, c2006", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(kinescope, kinescope recording, kine: A film recording of material originally appearing on a television tube. The television image, either live or from a videotape, appears enhanced on a monitor from which it is photographed. In a newer system an electron beam directly records on the film emulsion. Kinescope was originally employed for recording television programs and for delayed transmission, but ultimately was replaced for such functions by videotape.)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dictionary, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Goldbergs (Television program). The ultimate Goldbergs [VR] 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kinescope, shortened to kine, also known as telerecording in Britain, is a recording of a television program made by filming the picture from a video monitor. The newer telecine has replaced the kinescope in the post-production process; term can refer to the process itself, the equipment used for the procedure (a 16 mm or 35 mm movie camera mounted in front of a video monitor, and synchronized to the monitor's scanning rate), or a film made using the process. A small number of theatrically released feature films have also been produced as kinescopes; the recordings were known in full as kinescope films)"}, "madsrdf:citationSource": "Wikipedia, Aug. 19, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(kinescope 2: a motion picture made from a kinescope image)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Kinescopes of the original live productions)"}, "madsrdf:citationSource": "Work cat.: The golden age of television [VR] 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(kinescope 1. See picture tube. 2. A film of a transmitted television program.)"}, "madsrdf:citationSource": "The American heritage dict. of the English language, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Recordings, Kinescope"}}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Recordings, Kinescope"}}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Telerecordings (Kinescope films)"}}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telerecordings (Kinescope films)"}}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kines"}}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kines"}}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kinnies"}}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kinnies"}}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kinescope recordings"}}, {"@id": "_:nce6e4470e04e49c8bb72d1d0acb0a5c0b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kinescope recordings"}}], "@id": "/authorities/genreForms/gf2011026786"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026787", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDigital elevation models", "identifiers:lccn": "gf2011026787", "madsrdf:adminMetadata": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b1"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Digital elevation models"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026525"}, "madsrdf:hasSource": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b5"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b6"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b7"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b8"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b9"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b10"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b11"}], "madsrdf:hasVariant": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b12"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b15"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b18"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b21"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b24"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b27"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b30"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b33"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-12-09T14:26:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-09-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Digital elevation models"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (Presented in this report are 27 digital elevation model (DEM) datasets for the crater area of Mount St. Helens; DEMs)"}, "madsrdf:citationSource": "Messerich, J.A. Digital elevation models of the pre-eruption 2000 crater and 2004-07 dome-building eruption at Mount St. Helens, Washington, USA, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(geospatial online catalog that links to web-published digital elevation models (DEMs); DEMs may be bathymetric, topographic, or a merged combination of both. They also range from high-resolution coastal DEMs for local studies to coarser DEMs with global coverage)"}, "madsrdf:citationSource": "Digital elevation model (DEM) discovery portal, via National Geophysical Data Center website, Aug. 31, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Chirico, P. Void-filled SRTM digital elevation model of Afghanistan [ER], 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A digital elevation model (DEM) is a digital file consisting of terrain elevations for ground positions at regularly spaced horizontal intervals. The USGS produces five different digital elevation products. Although all are identical in the manner the data are structured, each varies in sampling interval, geographic reference system, areas of coverage, and accuracy; with the primary differing characteristic being the spacing, or sampling interval, of the data. Over the years, the USGS has collected digital elevation data using a number of production strategies including manual profiling from photogrammetric stereomodels; stereomodel digitizing of contours; digitizing topographic map contour plates; converting hypsographic and hydrographic tagged vector files; and performing autocorrelation via automated photogrammetric systems. Of these techniques, the derivation of DEM's from vector hypsographic and hydrographic data produces the most accurate model, and is the preferred method.)"}, "madsrdf:citationSource": "USGS digital elevation model information, via WWW, Aug. 31, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Digital elevation model (A digital elevation model is a digital model or 3-D representation of a terrain's surface--commonly for a planet (including Earth), moon, or asteroid--created from terrain elevation data. There is no common usage of the terms digital elevation model (DEM), digital terrain model (DTM) and digital surface model (DSM) in scientific literature. In the most cases the term digital surface model represents the earth's surface and includes all objects on it. In contrast to a DSM, the digital terrain model represents the bare ground surface without any objects like plants and buildings. The term Digital Elevation Model is often used as a generic term for DSMs and DTMs, only representing height information without any further definition about the surface. Other definitions equalise the terms DEM and DTM, or define the DEM as a subset of the DTM, which is also representing other morphological elements. There are also definitions which equalise the terms DEM and DSM. A DEM can be represented as a raster (a grid of squares, also known as a heightmap when representing elevation) or as a triangular irregular network (TIN). The TIN DEM dataset is also referred as a primary (measured) DEM, whereas the Raster DEM is referred as a secondary (computed) DEM. DEMs are commonly built using remote sensing techniques, but they may also be built from land surveying. DEMs are used often in geographic information systems, and are the most common basis for digitally-produced relief maps. The DEM could be acquired through techniques such as photogrammetry, LiDAR, IfSAR, land surveying, etc.)"}, "madsrdf:citationSource": "Wikipedia, Aug. 31, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A Digital Elevation Model (DEM) is a digital cartographic/geographic dataset of elevations in xyz coordinates. The terrain elevations for ground positions are sampled at regularly spaced horizontal intervals. DEMs are derived from hypsographic data (contour lines) and/or photogrammetric methods using USGS 7.5-minute, 15-minute, 2-arc-second (30- by 60-minute), and 1-degree (1:250,000-scale) topographic quadrangle maps.)"}, "madsrdf:citationSource": "Digital elevation model (DEM), via USGS Lake Tahoe Data Clearinghouse website, Aug. 31, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"10-meter DEMs of Western Washington from USGS Jan, 1999 production (lots 1 and 2)\"; public domain data from USGS that has been processed for the University of Washington Map Library)"}, "madsrdf:citationSource": "Geological Survey (U.S.). Washington DEMs [ER], 1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Elevation models, Digital"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Elevation models, Digital"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Digital surface models"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Digital surface models"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Digital terrain models"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Digital terrain models"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "DSMs (Digital surface models)"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "DSMs (Digital surface models)"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "DEMs (Digital elevation models)"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "DEMs (Digital elevation models)"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Surface models, Digital"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Surface models, Digital"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "DTMs (Digital terrain models)"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "DTMs (Digital terrain models)"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Terrain models, Digital"}}, {"@id": "_:n2d153e9ad271429f9903f79d53c10aa2b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Terrain models, Digital"}}], "@id": "/authorities/genreForms/gf2011026787"}
