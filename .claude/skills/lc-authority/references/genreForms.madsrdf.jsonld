cabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Coming-of-age films"}}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n673fb1047a1b49e492f49635bf22ae85b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Andy Hardy films"}}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Andy Hardy films"}}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Malick's depiction of violence, I would argue, is not used in the service of discourses of heroism, or in the construction of a bildungsfilm that traces the bloody rites of passage of an individual soldier.\")"}, "madsrdf:citationSource": "Lucas, R. Theatres of extremity : war and subjectivity in The thin red line, via WWW, Jun 24, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 59 (Coming-of-age movie: the stage through which one must pass to attain adulthood and be socially responsible is frequently labeled coming-of-age. It may be a traumatic or sweet moment; it is always a momentous occasion as childhood dreams are left behind and new realities take over. The coming-of-age picture focuses on growing up or, in other words, reaching maturity.)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Coming-of-age films; UF Bildungsfilms; Rite of passage films)"}, "madsrdf:citationSource": "LCSH, June 25, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category: Coming-of-age films: This is a category for films that portray Coming of age themes. This might also include Rite of passage themes involving young and adolescent characters.)"}, "madsrdf:citationSource": "Wikipedia, June 25, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n673fb1047a1b49e492f49635bf22ae85b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rite of passage films"}}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rite of passage films"}}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n673fb1047a1b49e492f49635bf22ae85b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bildungsfilms"}}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bildungsfilms"}}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n673fb1047a1b49e492f49635bf22ae85b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Andy Hardy films"}}, {"@id": "_:n673fb1047a1b49e492f49635bf22ae85b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Andy Hardy films"}}], "@id": "/authorities/genreForms/gf2011026148"}
