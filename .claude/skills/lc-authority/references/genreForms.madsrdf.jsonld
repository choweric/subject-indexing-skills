ttp://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Synthpop (Music)"}}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online, May 14, 2010", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Synthpop. genre of pop music in which the synthesizer is the dominant musical instrument; has its own stylistic tendencies which differentiate it from other music produced by the same means. These include the exploitation of artificiality where the synthesizers are not used to imitate acoustic instruments, the use of mechanical sounding rhythms, vocal arrangements as a counterpoint to the artificiality of the instruments, and ostinato patterns as an effect. Synthpop song structures are generally similar to those of other popular music. (Electropop, technopop. Electronic music made with synthesizers, fl. 1978-1983, shortened form of electronic pop))"}, "madsrdf:citationSource": "Wikipedia, May 14, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP galley (synth-pop; synthpop)"}, "madsrdf:citationSource": "Work cat.: 2010019842: Kraftwerk, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. ix (synth-pop)"}, "madsrdf:citationSource": "All music guide to electronica, c2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Electronic pop (Music)"}}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Electronic pop (Music)"}}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Technopop (Music)"}}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Technopop (Music)"}}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Electropop (Music)"}}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Electropop (Music)"}}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Synth-pop (Music)"}}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Synth-pop (Music)"}}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Techno-pop (Music)"}}, {"@id": "_:nf5d5ea282c744d95808d7baf3634d9fbb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Techno-pop (Music)"}}], "@id": "/authorities/genreForms/gf2014027122"}
