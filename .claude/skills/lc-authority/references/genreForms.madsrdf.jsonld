/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4876dd4f6cfb4f8490084a0348a69fc5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Art criticism"}}, {"@id": "_:n4876dd4f6cfb4f8490084a0348a69fc5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anthology of Russian contemporary art writing)"}, "madsrdf:citationSource": "Work cat.: Cosmic shift : Russian contemporary art writing, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4876dd4f6cfb4f8490084a0348a69fc5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. xi (James' essays on art) v. 1, p. 1 (art criticism)"}, "madsrdf:citationSource": "James, H. The complete writings of Henry James on art and drama, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4876dd4f6cfb4f8490084a0348a69fc5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection of critical art writings)"}, "madsrdf:citationSource": "Fusco, M. Give up art, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4876dd4f6cfb4f8490084a0348a69fc5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Art criticism. UF Art--Analysis, interpretation, appreciation; Art--Criticism; Arts--Criticism. BT Criticism)"}, "madsrdf:citationSource": "LCSH, Aug. 20, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n4876dd4f6cfb4f8490084a0348a69fc5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Art criticism (Art criticism, the analysis and evaluation of works of art. More subtly, art criticism is often tied to theory; it is interpretive, involving the effort to understand a particular work of art from a theoretical perspective and to establish its significance in the history of art)"}, "madsrdf:citationSource": "Britannica online, Aug. 20, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4876dd4f6cfb4f8490084a0348a69fc5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(art criticism. The study or practice of the analytical description, interpretation, and evaluation of visual art works and exhibitions)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 20, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n4876dd4f6cfb4f8490084a0348a69fc5b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4876dd4f6cfb4f8490084a0348a69fc5b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Criticism, Art"}}, {"@id": "_:n4876dd4f6cfb4f8490084a0348a69fc5b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Criticism, Art"}}], "@id": "/authorities/genreForms/gf2018026112"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026113", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChristmas pantomimes", "identifiers:lccn": "gf2018026113", "madsrdf:adminMetadata": [{"@id": "_:ne5caf52926954495a8c85d3822ad7a56b1"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Christmas pantomimes"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne5caf52926954495a8c85d3822ad7a56b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026061"}, "madsrdf:hasSource": [{"@id": "_:ne5caf52926954495a8c85d3822ad7a56b5"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b6"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b7"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b8"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b9"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b10"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b11"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b12"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b13"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b14"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b15"}], "madsrdf:hasVariant": [{"@id": "_:ne5caf52926954495a8c85d3822ad7a56b16"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b19"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Christmas entertainments for children that are embellished fairy tales, and feature a male playing the principal female role and a female playing the principal male role."}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-11-07T14:04:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Christmas pantomimes"}}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Fuller, I.M. Love's victory : a pantomime play in three scenes, \u00a91914.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cupid and Psyche, or, Colombine-Courtezan : a dramatic pantomime entertainment : interspers'd with ballad tunes, 1734.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LC subj. hdg.: Pantomimes)"}, "madsrdf:citationSource": "41011414: Jones, W.M. Nine mime plays, 1940", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Clinton-Baddeley, V.C. Cinderella : a cynical pantomime in three scenes, 1935.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pantomime (abbr. Panto) Somewhat bizarre traditional British Christmas entertainment, loosely based upon a well-known fairy tale, involving singing and dancing, humorous cross-dressing, slapstick, elaborate scenery and special effects, and much interaction with the audience)"}, "madsrdf:citationSource": "Winslow, C. The Oberon glossary of theatrical terms, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection of pantomime texts)"}, "madsrdf:citationSource": "Work cat.: Literarische Pantomimen : eine Anthologie stummer Dichtungen, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pantomime (Christmas entertainment). UF Christmas pantomime; Panto. BT Christmas plays; Pantomime; Vaudeville. SN Here are entered works on those traditional British Christmas entertainments based on certain nursery or popular tales dramatized in a manner deriving from the European commedia dell'arte and harlequinade with a free admixture of music-hall comedy routines, song, dance, melodrama, opulent tableaux, and audience participation)"}, "madsrdf:citationSource": "LCSH, Aug. 23, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hunt, A. A visit from Mother Goose and her family : a descriptive pantomime play, \u00a91895.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pantomime: English theatrical form; traditionally a Christmas entertainment intended particularly for children; plots usually based loosely on fairy tales, are embellished with music, dancing, transformation scenes, slapstick, audience participation, and topical references. A woman in tights usually plays the part of the principal boy, while a man plays the part of the dame; Traditional subjects include Aladdin, Ali Baba, Babes in the Wood, Cinderella, Jack and the Beanstalk, and Dick Whittington)"}, "madsrdf:citationSource": "The Methuen Drama dictionary of the theatre, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pantomime. A traditional Christmas entertainment in England; often simply called panto; extravaganza based on a fairy tale, such as Cinderella or Aladdin, and interpolating popular songs, topical references, ballet, and acrobatics; requires role of principal boy to be played by a young, pretty girl and the dame to be played by a man, often a famous comedian)"}, "madsrdf:citationSource": "Mobley, J.P. NTC's dictionary of theatre and drama terms, c1992", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pantomime: English theatrical form derived from the harlequinade; traditionally a Christmas entertainment with a special appeal for younger audiences; inherited its fairytale and comic elements from the harlequinade; together with music, trickwork, audience participation, topical references, dancing, and transformation scenes, features of the genre conventionally include the playing of the principal boy by a woman and the casting of a man as the dame, while the productions themselves are often exceedingly lavish; most popular traditional pantomimes include Cinderella, Aladdin, Red Riding Hood, Babes in the Wood, The Sleeping Beauty, Mother Goose, Jack and the Beanstalk, and Dick Whittington; The term pantomime has also been used of mime and of melodrama (when performed as a dumb show))"}, "madsrdf:citationSource": "The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5caf52926954495a8c85d3822ad7a56b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pantos (Christmas pantomimes)"}}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pantos (Christmas pantomimes)"}}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5caf52926954495a8c85d3822ad7a56b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mime plays (Christmas pantomimes)"}}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mime plays (Christmas pantomimes)"}}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5caf52926954495a8c85d3822ad7a56b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pantomime plays (Christmas pantomimes)"}}, {"@id": "_:ne5caf52926954495a8c85d3822ad7a56b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pantomime plays (Christmas pantomimes)"}}], "@id": "/authorities/genreForms/gf2018026113"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026115", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n14128004027a4cbfb565a00327d34aefb1"}, {"@id": "_:n14128004027a4cbfb565a00327d34aefb2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the genre/form term is covered by the genre/form terms {Humorous fiction} (DLC)gf2014026377 and {Satirical literature} (DLC)gf2014026525"}, "madsrdf:elementList": {"@list": [{"@id": "_:n14128004027a4cbfb565a00327d34aefb3"}]}, "madsrdf:useInstead": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026377"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026525"}], "madsrdf:variantLabel": {"@language": "en", "@value": "Satirical fiction"}}, {"@id": "_:n14128004027a4cbfb565a00327d34aefb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n14128004027a4cbfb565a00327d34aefb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-05-13T14:01:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n14128004027a4cbfb565a00327d34aefb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical fiction"}}], "@id": "/authorities/genreForms/gf2018026115"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026116", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMagic realist plays", "identifiers:lccn": "gf2018026116", "madsrdf:adminMetadata": [{"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb1"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Magic realist plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb5"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb6"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb7"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb8"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb9"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb10"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb11"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb12"}], "madsrdf:hasVariant": [{"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb13"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb16"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-11-07T14:04:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magic realist plays"}}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 73 (Jose Rivera's magic-realist drama The Promise)"}, "madsrdf:citationSource": "American theatre, v. 5 (1988):", "madsrdf:citationStatus": "found"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jos\u00e9 Rivera's \"Cloud Tectonics\"; After An\u00edbal offers Celestina shelter for the night, it gradually becomes evident that she is from the land of magic realism: she doesn't think of time the way most people do, and time doesn't treat her the way it does others. (For one thing, she has been pregnant for two years.))"}, "madsrdf:citationSource": "Genzlinger, N. Time stands still, selectively, in \"Cloud tectonics\", in New York times, July 20, 2006, viewed online Aug. 23, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rivera has successfully mixed two styles in which he previously dabbled, realism and magical realism, to produce a naturalistic play interlaced with symbols and magical occurrences)"}, "madsrdf:citationSource": "Winer, L. Theater review: Jose Rivera weaves his magical spell in \"Cloud tectonics\". in Los Angeles times, June 27, 1995, viewed online Aug. 23, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 107 (Rivera's apocalyptic play, Marisol; characteristically magic realist play)"}, "madsrdf:citationSource": "Maufort, M. Labyrinth of hybridities, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 217 (Tony Kushner's Broadway hit Angels in America; Kushner's magic-realist play)"}, "madsrdf:citationSource": "Film and sexual politics, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Rivera, Jos\u00e9. Cloud tectonics, \u00a91997.", "madsrdf:citationStatus": "found"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Cloud Tectonics,\" a play by Jose Rivera; phenomena are magical realities; idea of magical realism is one of the current Big Deals in theater, but it's really nothing new; definition of magical realism: when extraordinary things happen and they are just accepted by the people in the story as a part of normal life; magical realism defies scientific logic, although there is a certain logic to it; presenting magical realism onstage)"}, "madsrdf:citationSource": "Pixler, J. Some enchanted evening : Goodman's \"Cloud tectonics\" explores magical realism, in Chicago tribune, Sept. 17, 1995, viewed online Aug. 23, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Category:Plays by genre > Magic realism plays (Magic realism plays: Angels in America; Cloud Tectonics; Florencia en el Amazonas; The Man Who Turned Into A Stick; Orphans (Lyle Kessler play); Prelude to a Kiss (play); Rafts and Dreams; References to Salvador Dal\u00ed Make Me Hot; The Story of the Man Who Turned into a Dog)"}, "madsrdf:citationSource": "Wikipedia, Aug. 23, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magical realist drama"}}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magical realist drama"}}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magical realist plays"}}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magical realist plays"}}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magic realist drama"}}, {"@id": "_:nfdd20418ede2434284493d5ae7d4dc9eb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magic realist drama"}}], "@id": "/authorities/genreForms/gf2018026116"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026117", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMime plays", "identifiers:lccn": "gf2018026117", "madsrdf:adminMetadata": [{"@id": "_:n68251efeba3e4576845d7b3cd36f7135b1"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mime plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n68251efeba3e4576845d7b3cd36f7135b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n68251efeba3e4576845d7b3cd36f7135b5"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b6"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b7"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b8"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b9"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b10"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b11"}], "madsrdf:hasVariant": [{"@id": "_:n68251efeba3e4576845d7b3cd36f7135b12"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b15"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b18"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays or entertainments in which the performers express themselves by mute gestures, often to the accompaniment of music."}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-24T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-11-07T14:04:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mime plays"}}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mime (or dumb show). A form of theatrical performance in which no words are spoken and meaning is conveyed through movement and gesture alone. The modern silent mime show is descended from the commedia dell'arte, which itself borrowed from the Roman tradition)"}, "madsrdf:citationSource": "The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Mime (Forms of Mime: A mime play builds up a story around a series of gestural episodes, linking up with the narrative structure of comedy or tragedy) Mime Play (Play that uses only the body language of mime. It is, however, to be distinguished from pantomime: \"Their starting point was the same, but not their point of arrival: in pantomime, the body was not sufficient in itself, and other elements of the performance were called for; in the mime play, the body is all there is\". Today, parts of a spoken drama can become a mime play.)"}, "madsrdf:citationSource": "Pavis, P. Dictionary of the theatre, c1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ewert, E.M. A prince shall come : pantomime play, with music and feature dances, \u00a91933.", "madsrdf:citationStatus": "found"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dumb show: A dramatic device whereby events in a play are mimed rather than acted out in dialogue; Mime: (b) a silent performance in which the actor, generally working alone with a few simple props, imitates human or animal behaviour by highly skilled and controlled movements of body and face; Pantomime: A silent play using mime, music and spectacle to communicate a mythical story; second form of pantomime was created by John Weaver in 1716; interwove comic, mimed episodes from a Harlequin story with a serious fable, and spiced the result with spectacular stage tricks and transformation scenes; nowadays term refers to the Christmas entertainment which derives from the harlequinade, consisting of fairy tale and burlesque elements, with strong emphasis on spectacle, dance and song)"}, "madsrdf:citationSource": "Hodgson, T. The drama dictionary, c1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "introd. (Movement should be as rhythmic as possible, and synchronization with the beat of the music adds greatly to the success of the mime.) p. 8 (directions for the mime)"}, "madsrdf:citationSource": "Work cat.: Sayce, L.I. Three mime plays, c1934:", "madsrdf:citationStatus": "found"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Howard, V.L. Puppet and pantomime plays, 1962.", "madsrdf:citationStatus": "found"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pantomime. UF Dumb shows. BT Drama; Musical theater. RT Ballet; Mime. SN Here are entered works on plays or entertainments in which the performers express themselves by mute gestures, often to the accompaniment of music. Collections of pantomimes are entered under Pantomimes.)"}, "madsrdf:citationSource": "LCSH, Aug. 23, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n68251efeba3e4576845d7b3cd36f7135b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pantomime plays (Mime plays)"}}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pantomime plays (Mime plays)"}}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n68251efeba3e4576845d7b3cd36f7135b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mime shows"}}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mime shows"}}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n68251efeba3e4576845d7b3cd36f7135b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pantomimes (Mime plays)"}}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pantomimes (Mime plays)"}}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n68251efeba3e4576845d7b3cd36f7135b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dumb shows (Mime plays)"}}, {"@id": "_:n68251efeba3e4576845d7b3cd36f7135b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dumb shows (Mime plays)"}}], "@id": "/authorities/genreForms/gf2018026117"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026118", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aImpromptus (Drama)", "identifiers:lccn": "gf2018026118", "madsrdf:adminMetadata": [{"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b1"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Impromptus (Drama)"}, "madsrdf:elementList": {"@list": [{"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026434"}, "madsrdf:hasSource": [{"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b5"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b6"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b7"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b8"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b9"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b10"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b11"}], "madsrdf:hasVariant": {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Scripted plays that are presented as if they are improvised and the actors behave as if they are inventing the plot."}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-11-07T14:04:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Impromptus (Drama)"}}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 145 (the impromptu, a primarily, and peculiarly French genre that originated in the seventeenth century; was at first improvised and composed for a particular circumstance such as a wedding. Yet these \"improvised\" pieces, like their musical counterparts, eventually became entirely written texts; the genre flourished in the seventeenth and eighteenth centuries, became moribund in the nineteenth century, and was revived in the twentieth; Moli\u00e8re's Impromptu de Versailles served as inspiration and intertext for a number of twentieth- and twenty-first-century impromptus) p. 167 (Cocteau's impromptus; his approach to breaking through the fourth wall between actors and audience stems from Pirandello; the impromptus of Copeau and Giraudoux take the form of theater in theater while Anouilh's presents theater in a courtroom)"}, "madsrdf:citationSource": "Witt, M.A.F. Metatheater and modernity, \u00a92013:", "madsrdf:citationStatus": "found"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 119 (the impromptus of Moli\u00e8re, Giraudoux, Ionesco, Ferron, Filion, and Tremblay) p. 120 (the impromptu, this un-improvised improvisation)"}, "madsrdf:citationSource": "French seventeenth-century literature, \u00a92009:", "madsrdf:citationStatus": "found"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 261 (Les trois \"Impromptus\": Moli\u00e8re, Giraudoux et Ionesco face \u00e0 leurs critiques [The three \"Impromptus\": Moli\u00e8re, Giraudoux and Ionesco face their criticisms]; Moli\u00e8re seems to have been the first to use the word \"impromptu\" in the title of a play; most impromptus refer, in one way or another, to the things of the theater)"}, "madsrdf:citationSource": "Revue d'histoire du th\u00e9\u00e2tre, 32e ann\u00e9e, no 3 (juillet-septembre 1980):", "madsrdf:citationStatus": "found"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Winslow, C. The Oberon glossary of theatrical terms, 2011;The Methuen Drama dictionary of the theatre, 2011;The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "notfound"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Impromptu. Fr.: impromptu; Ger.: Stegreifspiel; Sp.: madrigal. An impromptu play is improvised, or at least presented as such by simulating improvised theatre creation; actors behave as if they were inventing a story and representing their characters, i.e., as if they were really improvising. One of the first and most famous plays in this genre was Moli\u00e8re's L'Impromptu de Versailles; the genre of the impromptu reappeared in the twentieth century with Questa era si recita a soggeto (1930) by Pirandello and the series of Impromptus de Paris (Giraudoux 1937), Impromptus de l' Alma (Ionesco 1956), Impromptus du Palais-Royal (Cocteau 1962); a self-referential genre that refers to itself and creates itself in the very act of enunciation, the impromptu stages the playwright, involves him in the action and embeds his creation, introducing a kind of play within a play)"}, "madsrdf:citationSource": "Pavis, P. Dictionary of the theatre, c1998", "madsrdf:citationStatus": "found"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 210 (impromptu plays from Moli\u00e8re, Corneille, and of R\u00e9gnard to Marivaux, Musset, Goldoni, and Pirandello to Giraudoux, Ionesco, Claudel, and Beckett)"}, "madsrdf:citationSource": "New queries in aesthetics and metaphysics, \u00a91991:", "madsrdf:citationStatus": "found"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Moli\u00e8re. La critique de l'\u00e9cole des femmes ; L'impromptu de Versailles, 1926.", "madsrdf:citationStatus": "found"}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Impromptu plays"}}, {"@id": "_:naeb9ff0b28fc4bcba2404c5ae80cb6a1b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Impromptu plays"}}], "@id": "/authorities/genreForms/gf2018026118"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026119", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aData sets", "identifiers:lccn": "gf2018026119", "madsrdf:adminMetadata": [{"@id": "_:n52e6749f27b34e0abed2a1305fbac223b1"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Data sets"}, "madsrdf:elementList": {"@list": [{"@id": "_:n52e6749f27b34e0abed2a1305fbac223b3"}]}, "madsrdf:exampleNote": "Note under [Databases]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2019026083"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026005"}], "madsrdf:hasSource": [{"@id": "_:n52e6749f27b34e0abed2a1305fbac223b5"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b6"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b7"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b8"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b9"}], "madsrdf:hasVariant": [{"@id": "_:n52e6749f27b34e0abed2a1305fbac223b10"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b13"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b16"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Collections of similar or related data that are usually assembled as a matter of record or for research. For electronic systems that allow data to be easily accessed, manipulated, and updated see [Databases.]"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-01T10:01:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-09-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "new"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Data sets"}}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page of PDF accompanying zip file (Data documentation for data set 3910)"}, "madsrdf:citationSource": "Data set 3910, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Data set (A data set is a collection of related, discrete items of related data that may be accessed individually or in combination or managed as a whole entity)"}, "madsrdf:citationSource": "What is? via TechTarget, viewed January 4, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "opening screen (LAPOP datasets home)"}, "madsrdf:citationSource": [{"@id": "http://datasets.americasbarometer.org/database/index.php"}, "Latin American Public Opinion Project, viewed January 4, 2019:"], "madsrdf:citationStatus": "found"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "data set (definition: any organized collection of data; context: Within SDMX, a data set can be understood as a collection of similar data, sharing a structure, which covers a fixed period of time. A data set is any permanently stored collection of information usually containing either case level data, aggregation of case level data, or statistical manipulations of either the case level or aggregated survey data, for multiple survey instances. The terms database and data set are often used interchangeably.)"}, "madsrdf:citationSource": "OECD Glossary of statistical terms online, March 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "data set (A logically meaningful collection or grouping of similar or related data, usually assembled as a matter of record or for research, for example, the American FactFinder Data Sets provided online by the U.S. Census Bureau or the National Elevation Dataset available from the U.S. Geological Survey. Also spelled dataset)"}, "madsrdf:citationSource": "Online dictionary of library and information science, March 11, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n52e6749f27b34e0abed2a1305fbac223b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Databanks"}}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Databanks"}}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n52e6749f27b34e0abed2a1305fbac223b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Data banks"}}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Data banks"}}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n52e6749f27b34e0abed2a1305fbac223b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Raw data sets"}}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Raw data sets"}}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n52e6749f27b34e0abed2a1305fbac223b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Datasets"}}, {"@id": "_:n52e6749f27b34e0abed2a1305fbac223b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Datasets"}}], "@id": "/authorities/genreForms/gf2018026119"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026120", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVerbatim theater", "identifiers:lccn": "gf2018026120", "madsrdf:adminMetadata": [{"@id": "_:n45294eb145e941139f0b892f2e05f882b1"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Verbatim theater"}, "madsrdf:elementList": {"@list": [{"@id": "_:n45294eb145e941139f0b892f2e05f882b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n45294eb145e941139f0b892f2e05f882b5"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b6"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b7"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b8"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b9"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b10"}], "madsrdf:hasVariant": [{"@id": "_:n45294eb145e941139f0b892f2e05f882b11"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b14"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays in which the primary source for the script is the words of real people as recorded in documentary materials such as interviews, reports, etc."}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:23:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-09-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verbatim theater"}}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Verbatim theatre; form of documentary theatre which is based on the spoken words of real people. In its strictest form, verbatim theatre-makers use real people's words exclusively, and take this testimony from recorded interviews; There is an overlap between verbatim theatre and documentary theatre, and other kinds of fact-based drama, such as testimonial theatre (in which an individual works with a writer to tell their own story) and tribunal theatre (edited from court transcripts); the first verbatim play was Peter Cheeseman's Fight for Shelton Bar (1974))"}, "madsrdf:citationSource": "Drama online website, Sept. 17, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "unnum. prelim. p. (verbatim theatre show; monologues from the trans male community) p. iv (verbatim theatre)"}, "madsrdf:citationSource": "Work cat.: Bridgeman, L. There is no word for it, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "introd. (The term \"verbatim\" refers to the origins of the text spoken in the play. The words of real people are recorded or transcribed by a dramatist during an interview or research process, or are appropriated from existing records such as the transcripts of an official enquiry. They are then edited, arranged or recontextualised to form a dramatic presentation, in which actors take on the characters of the real individuals whose words are being used; verbatim play)"}, "madsrdf:citationSource": "Verbatim, verbatim : contemporary documentary theatre, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Verbatim theatre; a way of incorporating the words of real people, as spoken in private interview or public record, into drama; verbatim has even acquired sufficient status to be satirised in Dennis Kelly's Taking Care of Baby, a caustically funny send-up of the genre; verbatim drama; verbatim plays)"}, "madsrdf:citationSource": "Michael Billington's A to Z of modern drama, via WWW, Sept. 17, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 24 (verbatim theatre; verbatim play; verbatim monologues) p. 25 (genre called verbatim drama) p. 28 (Verbatim theatre uses the actual words of people, often in direct first-person address or testimonial style, to raise issues relevant to a particular community and to activate broader social engagement)"}, "madsrdf:citationSource": "Theatre research in Canada, v. 33, no. 1 (2012):", "madsrdf:citationStatus": "found"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(12,500 results for \"verbatim play\"; 13,800 results for \"verbatim plays\"; 9,310 results for \"verbatim drama\"; 6,690 results for \"verbatim theater\"; 63,800 results for \"verbatim theatre\")"}, "madsrdf:citationSource": "Google search, Sept. 17, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n45294eb145e941139f0b892f2e05f882b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Verbatim drama"}}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verbatim drama"}}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n45294eb145e941139f0b892f2e05f882b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Verbatim theatre"}}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verbatim theatre"}}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n45294eb145e941139f0b892f2e05f882b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Verbatim plays"}}, {"@id": "_:n45294eb145e941139f0b892f2e05f882b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verbatim plays"}}], "@id": "/authorities/genreForms/gf2018026120"}
