"ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n009c89699a8447d79606f3b8137c15b0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:28:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n009c89699a8447d79606f3b8137c15b0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television news programs"}}, {"@id": "_:n009c89699a8447d79606f3b8137c15b0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 70 (News: use for nonfiction films and programs which report and comment on recent events)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n009c89699a8447d79606f3b8137c15b0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(News: nonfiction television relating topical events and background stories on matters contemporary with their broadcast date, usually organized in reports from correspondents on specific news stories.)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 17, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n009c89699a8447d79606f3b8137c15b0b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: CBS news. 2000-01-01. Evening, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n009c89699a8447d79606f3b8137c15b0b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n009c89699a8447d79606f3b8137c15b0b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television newscasts"}}, {"@id": "_:n009c89699a8447d79606f3b8137c15b0b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@lan