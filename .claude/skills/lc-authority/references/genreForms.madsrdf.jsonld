{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026963", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNew wave music", "identifiers:lccn": "gf2014026963", "madsrdf:adminMetadata": [{"@id": "_:n65500906e87e4f02afed4d6706314dc2b1"}, {"@id": "_:n65500906e87e4f02afed4d6706314dc2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "New wave music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n65500906e87e4f02afed4d6706314dc2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026632"}, "madsrdf:hasSource": [{"@id": "_:n65500906e87e4f02afed4d6706314dc2b5"}, {"@id": "_:n65500906e87e4f02afed4d6706314dc2b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n65500906e87e4f02afed4d6706314dc2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n65500906e87e4f02afed4d6706314dc2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n65500906e87e4f02afed4d6706314dc2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "New wave music"}}, {"@id": "_:n65500906e87e4f02afed4d6706314dc2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(alternative rock/alternative music: broad label and loose genre/style, used since late 1960s for popular music seen as less commercial and mainstream, and more authentic and \"uncompromising\"; present scene builds on remains of punk; late 1970s punk/new wave bands and post-punk/new wave performers also cited as part of the alternative scene)"}, "madsrdf:citationSource": "Shuker, R. Key concepts in popular music, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n65500906e87e4f02afed4d6706314dc2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(originally intended to cover punk and new wave)"}, "madsrdf:citationSource": "Strong, M.C. The great alternative & indie discography, 1999", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026963"}
