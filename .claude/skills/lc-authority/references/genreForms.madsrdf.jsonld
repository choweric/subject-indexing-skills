{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026402", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMonster films", "identifiers:lccn": "gf2011026402", "madsrdf:adminMetadata": [{"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b1"}, {"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Monster films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026380"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026716"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026733"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026749"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026321"}, "madsrdf:hasSource": [{"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b5"}, {"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b6"}], "madsrdf:hasVariant": {"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025215"}}, {"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T13:17:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monster films"}}, {"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(monster movie (creature feature): the term is interchangable with that of horror film. However, in a stricter sense, monster movies, as the name indicates, deal exclusively with monsters which have in most cases malevolent intentions and prey on human life and property. Besides, not all horror movies include monsters. There are all sorts of monsters: supernatural, extraterrestrial, man-made, nature-made and god-made)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(monster drama: use for fictional genre films and programs which focus on an animate being, part human or nonhuman, with supernatural or prodigious powers, which threatens human life. Monsters include atomic mutants, monstrous throwbacks, monsters made and/or controlled by mad scientists, animal-man combinations, scientists who transform themselves into monsters, the various species of resurrected dead, and creatures from outer space, including alien parasites)"}, "madsrdf:citationSource": "Yee, M.  Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Creature features (Motion pictures)"}}, {"@id": "_:n2676b9bf215a4ea3ab81887fb54aff57b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Creature features (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2011026402"}
