{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026449", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPlotting charts", "identifiers:lccn": "gf2011026449", "madsrdf:adminMetadata": [{"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b1"}, {"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Plotting charts"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026034"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026418"}], "madsrdf:hasSource": [{"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b5"}, {"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b6"}, {"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025064"}}, {"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T13:34:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plotting charts"}}, {"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(plotting chart: a chart designed primarily for plotting and dead reckoning or lines of position from celestial observations or radio aids. Relief, culture, and drainage are shown as necessary)"}, "madsrdf:citationSource": "Glossary of mapping, charting, and geodetic terms, 1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Plotting charts)"}, "madsrdf:citationSource": "LCSH, Dec. 1, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4d3de8c4faa4de49c15685000bcefe1b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Glossary of the mapping sciences, 1994.", "madsrdf:citationStatus": "notfound"}], "@id": "/authorities/genreForms/gf2011026449"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026450", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPodcasts", "identifiers:lccn": "gf2011026450", "madsrdf:adminMetadata": [{"@id": "_:n1577b876806d4cc994e9ff94837272cfb1"}, {"@id": "_:n1577b876806d4cc994e9ff94837272cfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Podcasts"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1577b876806d4cc994e9ff94837272cfb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026723"}], "madsrdf:hasSource": [{"@id": "_:n1577b876806d4cc994e9ff94837272cfb5"}, {"@id": "_:n1577b876806d4cc994e9ff94837272cfb6"}, {"@id": "_:n1577b876806d4cc994e9ff94837272cfb7"}, {"@id": "_:n1577b876806d4cc994e9ff94837272cfb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025055"}}, {"@id": "_:n1577b876806d4cc994e9ff94837272cfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n1577b876806d4cc994e9ff94837272cfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-11T12:18:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "revised"}, {"@id": "_:n1577b876806d4cc994e9ff94837272cfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Podcasts"}}, {"@id": "_:n1577b876806d4cc994e9ff94837272cfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "podcast (series of digital media files (either audio or video) that are released episodically and downloaded through web syndication)"}, "madsrdf:citationSource": "Wikipedia, Nov. 10, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1577b876806d4cc994e9ff94837272cfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "podcast (a program (as of music or talk) made available in digital format for automatic download over the Internet)"}, "madsrdf:citationSource": "Merriam Webster online dictionary, Nov. 10, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1577b876806d4cc994e9ff94837272cfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Podcasts)"}, "madsrdf:citationSource": "LCSH, Nov. 10, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1577b876806d4cc994e9ff94837272cfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Podcasts (\"In its simplest form, a podcast is a digital audio recording. This audio recording can be created in multiple ways, can be stored and distributed through a variety of mechanisms, and can be used for many purposes ; \"While the earliest podcasts were audio only, it wasn't long before enhanced podcasts and even video podcasts were developed to take advantage of the increased capability and functionality of the various devices for which they were produced. Enhanced podcasts include synchronized text, photographs, drawings, or other visual media. Video podcasts, as the name implies, are in video format\") (OCoLC)951221119"}, "madsrdf:citationSource": "SAGE encyclopedia of online education, 2016:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026450"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026451", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPolice films", "identifiers:lccn": "gf2011026451", "madsrdf:adminMetadata": [{"@id": "_:n63e2beeee12547dcb3423c316e942ec9b1"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Police films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n63e2beeee12547dcb3423c316e942ec9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026177"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026195"}, "madsrdf:hasSource": [{"@id": "_:n63e2beeee12547dcb3423c316e942ec9b5"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b6"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b7"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b8"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b9"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b10"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b11"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b12"}], "madsrdf:hasVariant": [{"@id": "_:n63e2beeee12547dcb3423c316e942ec9b13"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b16"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b19"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b22"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025518"}}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:13:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Police films"}}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(law-and-order film. A film that emphasizes the triumph of law over crime, or when the law seems incapacitated, the victory of right over wrong; generally appear during periods that seem to have an unusual amount of crime and violence; recent years have featured films such as Dirty Harry (1971) and Death Wish (1974); the most recent trend in this type of motion picture has been the buddy law-and-order film, where two seemingly different character types join together, with a good deal of humor and violence, to fight corruption (even though they may be a bit corrupt themselves)--e.g., Lethal Weapon (1987))"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dictionary, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(policier: A film based on a police novel, portraying crime and its detection by police)"}, "madsrdf:citationSource": "Oxford English dictionaries website, Sept. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 78 (Police films and programs: use for fictional genre films and programs which focus on the fight against crime conducted by official law enforcement agencies such as the Police Dept., or the FBI. Include here semidocumentaries and procedurals which re-enact actual cases and/or attempt to protray actual crime fighting techniques. BT: Crime films and programs; RT: Detective films and programs; Film noir; UF: Cop films and programs; Law enforcement films and programs; Policiers)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(policier: a novel, TV drama, or, esp., film focusing on a realistic depiction of the work of the police in investigating a crime or crimes)"}, "madsrdf:citationSource": "Webster's new world college dictionary, c2010, via yourdictionary.com, Sept. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(policier \u200e(plural policiers) - English: (film, often italicized) A police movie, particularly one based on a police novel)"}, "madsrdf:citationSource": "Wiktionary, Sept. 30, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Police Film (Police Film (Cop Movie, Investigative Film, Law Enforcement Drama, Police Procedural, Policier). Cop movies emphasize, or focus on, the policeman rather than the criminal; cover quite an extensive range, but as a rule they may be subdivided into three general sections: cops in uniform or policemen on the beat; the police commissioner, inspector, detective, or lieutenant in Homicide, the Drug Squad, or any other section of a Police Department; and the sheriff in townships or small rural communities carrying out the same duties as his counterparts in the cities. Subcategories: Buddy-Cop Films; Copper Films; Federal Agent Films; Police Comedies; Police Department Films; Police Detective Films; Sheriff Films) Copper Films (deal with the uniformed representatives of the law: men on the beat, rookie policemen or patrolmen carrying out their functions. It is, generally speaking, a less glamorized role than that of the police detective) Police Department Films (A few police films do not place their emphasis on catching the criminal; instead, they try to show the working day or routine happenings inside a police precinct; present the many problems encountered in the efficient running of the department, or the corruptible elements that may exist therein)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Police: fictional work portraying the activities and personalities of official law enforcement officers and agencies (from municipal police to F.B.I. to G-men) in tracking criminals. Police stories offer many of the same elements as the Crime and Mystery genres, but with an added concentration on the procedures of police work and characterizations of police officers)"}, "madsrdf:citationSource": "Moving image genre-form guide online, January 28, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: The Big Easy, 1987.", "madsrdf:citationStatus": "found"}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n63e2beeee12547dcb3423c316e942ec9b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Procedurals, Police (Motion pictures)"}}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Procedurals, Police (Motion pictures)"}}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n63e2beeee12547dcb3423c316e942ec9b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Investigative films (Police films)"}}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Investigative films (Police films)"}}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n63e2beeee12547dcb3423c316e942ec9b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Law enforcement films (Police films)"}}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Law enforcement films (Police films)"}}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n63e2beeee12547dcb3423c316e942ec9b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Policiers (Motion pictures)"}}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Policiers (Motion pictures)"}}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n63e2beeee12547dcb3423c316e942ec9b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cop films"}}, {"@id": "_:n63e2beeee12547dcb3423c316e942ec9b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cop films"}}], "@id": "/authorities/genreForms/gf2011026451"}
