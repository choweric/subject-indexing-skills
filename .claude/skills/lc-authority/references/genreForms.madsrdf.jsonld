f6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 427 (taarab; lyric poetry sung in Swahili, most characteristically at weddings, by up to ten singers and instrumental ensembles including both Arabic and Western instruments; closely related to the Egyptian firqah orchestra of the 1930's and 1940's; strongly influenced by Indian film music and East African ngoma rhythms)"}, "madsrdf:citationSource": "Garland encyc. of world music:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3bf8a768707423ca6138e884941e8f6b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nb3bf8a768707423ca6138e884941e8f6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert (taarab; vocal-instrumental popular music of the Swahili, generally Muslim peoples of the East African coast between Somalia and Mozambique)"}, "madsrdf:citationSource": "Work cat.: Ikhwani Safaa Musical Club. Music of Zanzibar, p1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3bf8a768707423ca6138e884941e8f6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 18, p. 568 (taarab; urban vocal genre with instrumental acc. which may include ud, harmonium and drums)"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027123"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027124", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNh\u1ea1\u0323c t\u00e0i t\u1eed", "identifiers:lccn": "gf2014027124", "madsrdf:adminMetadata": [{"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b1"}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nh\u1ea1\u0323c t\u00e0i t\u1eed"}, "madsrdf:elementList": {"@list": [{"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b5"}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b6"}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b7"}], "madsrdf:hasVariant": [{"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b8"}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nh\u1ea1\u0323c t\u00e0i t\u1eed"}}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2002356211: H\u00f2a t\u00e1\u0302u nh\u1ea1c t\u00e0i t\u1eed Nam B\u1ed9, 2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\u0110\u1eddn ca t\u00e0i t\u1eed or t\u00e0i t\u1eed (music of skilled amateurs): This music, found in the south, belongs to the same tradition as Hu\u00e9\u0302 music. The instruments of t\u00e0i t\u1eed music are basically the same as those of the Hu\u00e9\u0302 tradition. In addition, the modified European guitar (ghi-ta), violin (vi\u00f4-l\u00f4ng) and steel guitar (ghi-ta ha-oai-en) are used in all t\u00e0i t\u1eed and c\u1ea3i l\u01b0\u01a1ng repertories)"}, "madsrdf:citationSource": "Grove music online, WWW site, February 17, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 483 (Nh\u1ea1\u0323c t\u00e0i t\u1eed (also called d\u00f3n ca t\u00e0i t\u1eed) may be translated in two ways, both requiring explanation: 'music and songs of talented persons' or 'amatuers' music'. Both terms express something of the nature of this music: it is chamber music performed by artists of great talent (first meaning) and not for profit (second meaning). It was born in southern Vietnam at the beginning of the twentieth century. Its relation to the music of Hu\u00e9\u0302 can be heard in some ca hu\u00e9\u0302 songs and nh\u1ea1c t\u00e0i t\u1eed instrumental pieces)"}, "madsrdf:citationSource": "Garland encyc. of world music, v. 4, Southeast Asia, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "T\u00e0i t\u1ee9"}}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "T\u00e0i t\u1ee9"}}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "\u0110\u1eddn ca t\u00e0i t\u1eed"}}, {"@id": "_:na0d36ba5f56245d1a35bfd86a778fe83b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "\u0110\u1eddn ca t\u00e0i t\u1eed"}}], "@id": "/authorities/genreForms/gf2014027124"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027125", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTamboras (Music)", "identifiers:lccn": "gf2014027125", "madsrdf:adminMetadata": [{"@id": "_:nf716bdfed0eb49bdb5d1f5c92af062bab1"}, {"@id": "_:nf716bdfed0eb49bdb5d1f5c92af062bab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tamboras (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf716bdfed0eb49bdb5d1f5c92af062bab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:nf716bdfed0eb49bdb5d1f5c92af062bab5"}, {"@id": "_:nf716bdfed0eb49bdb5d1f5c92af062bab6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf716bdfed0eb49bdb5d1f5c92af062bab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nf716bdfed0eb49bdb5d1f5c92af062bab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf716bdfed0eb49bdb5d1f5c92af062bab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tamboras (Music)"}}, {"@id": "_:nf716bdfed0eb49bdb5d1f5c92af062bab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tambora: double-headed drum of Latin America)"}, "madsrdf:citationSource": "New Grove dict. of musical instruments", "madsrdf:citationStatus": "found"}, {"@id": "_:nf716bdfed0eb49bdb5d1f5c92af062bab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "subtitle (la tambora) glossary (Tambora in the region of the Momp\u00f3s depression in Colombia can refer to a dance, the dance music, the festival where tambora is performed, the accompanying ensemble which includes the drum called tambora, and rhythmic terminology such as tambora alegre, tambora redoblada, etc.) p. 93 ff. (tambora festivals coincide with various festivals, events, etc. of the Catholic Church; the music is essentially vocal, typically comprising a soloist, mixed choir, and 2 drums: tambora and currulao)"}, "madsrdf:citationSource": "Work cat.: 2004374689: Carb\u00f3 Ronderos, G. Musique et danse traditionnelles en Colombie, c2003:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027125"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027126", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTan singing", "identifiers:lccn": "gf2014027126", "madsrdf:adminMetadata": [{"@id": "_:n01ca95634abc40399fc477db5c8d3432b1"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tan singing"}, "madsrdf:elementList": {"@list": [{"@id": "_:n01ca95634abc40399fc477db5c8d3432b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, "madsrdf:hasSource": [{"@id": "_:n01ca95634abc40399fc477db5c8d3432b5"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b6"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b7"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b8"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b9"}], "madsrdf:hasVariant": [{"@id": "_:n01ca95634abc40399fc477db5c8d3432b10"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b13"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b16"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b19"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b22"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b25"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions from the Caribbean that incorporate musical conventions typical of various regions in India."}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:00:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tan singing"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(t\u0101n-singing; term did not come into common usage in Trinidad and Guyana until around the 1960s; continues to be used only in alternation with other terms, including tent-singing (referring to the tents erected at weddings), local-classical music, t\u0101n-sangit (\"t\u0101n-music\"), and most commonly of all, classical music; term is not used by the Hindi-speaking Surinamese, who call their corresponding genre baithak g\u0101na (\"sitting music\"); roots lie in Bhojpuri-speaking region of northern India; one might think the term would imply the singing of t\u0101ns (fast melodic runs), but it seems to derive instead from the custom of referring to singers as \"Tan Sens,\" after the legendary Mughal-era singer; \"Tan Sen\" was corrupted to \"Tan Singh,\" and further to \"t\u0101n-singer\"; although related to amateur folk song genres, it is performed by semi-professional specialists; despite the decline of Hindi, t\u0101n-singing remains text-oriented, with most lyrics consisting of devotional verse in standard Hindi, Braj Bhasha, or Urdu; resembles North Indian folk music more than North Indian classical (Hindustani) music, but some of its subgenres have names derived from Hindustani musical forms)"}, "madsrdf:citationSource": "Work cat.: 99053448: Manuel, P.L. East Indian music in the West Indies, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Trinidad & Tobago (tan singing, the singing of old East Indian folk tunes; tan songs, old East Indian folk tunes)"}, "madsrdf:citationSource": "White, D. Dict. of pop. mus. styles of the world, c1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (Baitaak gana)"}, "madsrdf:citationSource": "Roving chutney calypso tent, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 86 (classical singing (tan) is performed by Asian Indians in Trinidad during their celebrations after wedding rituals, especially the dinner, when hired musicians with beaters (dantal), a dholak, and a harmonium accompany the singing of tan)"}, "madsrdf:citationSource": "Garland encyc. of world music, 1998 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tan singing: Indo-Caribbean \"local classical\" music; mixture of old folk songs from the Bhojpuri-speaking area of North India, somewhat garbled elements of North Indian classical music, and some features unique to Indo-Caribbean culture, all reinterpreted by local musicians who stress original composition and creation)"}, "madsrdf:citationSource": "Manuel, P.L. Caribbean currents, 1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01ca95634abc40399fc477db5c8d3432b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Baithak g\u0101na"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Baithak g\u0101na"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01ca95634abc40399fc477db5c8d3432b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "T\u0101n-sangit"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "T\u0101n-sangit"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01ca95634abc40399fc477db5c8d3432b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tan songs"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tan songs"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01ca95634abc40399fc477db5c8d3432b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Classical music (Tan singing)"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Classical music (Tan singing)"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01ca95634abc40399fc477db5c8d3432b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Baitaak gana"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Baitaak gana"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01ca95634abc40399fc477db5c8d3432b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tent-singing (Tan singing)"}}, {"@id": "_:n01ca95634abc40399fc477db5c8d3432b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tent-singing (Tan singing)"}}], "@id": "/authorities/genreForms/gf2014027126"}
