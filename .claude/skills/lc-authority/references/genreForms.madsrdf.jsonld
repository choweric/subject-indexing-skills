ype": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Coutumes (This heading is used as a genre/form heading for compilations and collections of French medieval customary law, i.e. local and provincial customs and privileges observed in the pays de coutume of central and northern France, codified in 1453 by order of Charles VII and revised continually until the Revolution.)"}, "madsrdf:citationSource": "Genre/form terms for law materials [report prepared by the Technical Services Special Interest Section of AALL], 2010:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026175"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026176", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCredit titles", "identifiers:lccn": "gf2011026176", "madsrdf:adminMetadata": [{"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b1"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Credit titles"}, "madsrdf:elementList": {"@list": [{"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026723"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b5"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b6"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b7"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b8"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b9"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b10"}], "madsrdf:hasVariant": [{"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b11"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b14"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b17"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b20"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b23"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b26"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b29"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b32"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025050"}}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-04T15:32:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Credit titles"}}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Motion picture credits: opening credits, in a television program, motion picture or videogame, are shown at the beginning of a show and list the most important members of the production...usually mention the major actors, guest stars, producers and director, as opposed to closing credits...which lists the entire production crew [and] come at the end of a show)"}, "madsrdf:citationSource": "Wikipedia website, July 21, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 46 (Credits; credit titles: the names of persons responsible for the artistic development of the film, such as actors, writers, directors, cinematographers, set and dress designers, sound engineers, etc. which appear on the screen)"}, "madsrdf:citationSource": "Oakey, V. Dictionary of film and television terms, c1983:", "madsrdf:citationStatus": "found"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Glossary, p. 7 (Credits: The names and functions of persons and corporate bodies responsible for the artistic or intellectual content of a moving image work)"}, "madsrdf:citationSource": "Archival moving image materials : a cataloging manual, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 211 (Credit title: title which lists those creatively responsible for the film or TV programme to which it is attached. Credit titles may be placed at the start or finish, and when at the start are now often preceded by an introductory sequence)"}, "madsrdf:citationSource": "The Focal encyclopedia of film & television techniques, 1981:", "madsrdf:citationStatus": "found"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "credit (def. 13d: Theater, Cinematography, Broadcasting, etc. The acknowledgement by name, with details of the service rendered, of each individual contributor (actor, producer, etc.) to a production or the like, usually published in a programme or on the screen; freq. in pl. Hence credit line, list, etc.; credit title)"}, "madsrdf:citationSource": "OED online, May 28, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 163 (Credits, properly credit titles: the titles at the beginning or end of a film, listing the actors and technicians who have worked on it, often fulfilling by their design, layout, and backgrounds the subsidiary function of establishing style or atmosphere)"}, "madsrdf:citationSource": "Bawden, L., ed. The Oxford companion to film, 1976:", "madsrdf:citationStatus": "found"}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Credits, Film"}}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Credits, Film"}}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Film credits"}}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film credits"}}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Opening credits"}}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Opening credits"}}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television credits"}}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television credits"}}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Credits, Closing"}}, {"@id": "_:n967d01168d7140dfa6e3e1aac8c77586b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Credits, Closing"}}, {"@id": "_:n967d01168d7140dfa6e3