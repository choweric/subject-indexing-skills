{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026088", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aManuscripts", "identifiers:lccn": "gf2022026088", "madsrdf:adminMetadata": [{"@id": "_:nc8b6247f10bc4da385f94516877632e2b1"}, {"@id": "_:nc8b6247f10bc4da385f94516877632e2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Manuscripts"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc8b6247f10bc4da385f94516877632e2b3"}]}, "madsrdf:hasSource": [{"@id": "_:nc8b6247f10bc4da385f94516877632e2b5"}, {"@id": "_:nc8b6247f10bc4da385f94516877632e2b6"}], "madsrdf:historyNote": "[Established March 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc8b6247f10bc4da385f94516877632e2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-08T09:05:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc8b6247f10bc4da385f94516877632e2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-10-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc8b6247f10bc4da385f94516877632e2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Manuscripts"}}, {"@id": "_:nc8b6247f10bc4da385f94516877632e2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(manuscript: as a noun: 1a. A book, document, etc., written by hand, esp. one written before the general adoption of printing in a country; a handwritten copy of an ancient text; 1b. gen. A written composition which has not been printed; unprinted or unpublished written material. In later use frequently: an author's written, typed, or word-processed copy of a work, as distinguished from the print of the same)."}, "madsrdf:citationSource": "Oxford English Dictionary, online, viewed October 16, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nc8b6247f10bc4da385f94516877632e2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hebrew manuscript) (DLC)2022397713"}, "madsrdf:citationSource": "Work cat.: [Hagadah shel Pesa\u1e25], [late 14th century or early 15 century]", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2022026088"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026092", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKetubahs", "identifiers:lccn": "gf2022026092", "madsrdf:adminMetadata": [{"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab1"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ketubahs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026168"}, "madsrdf:hasSource": [{"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab5"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab6"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab7"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab8"}], "madsrdf:hasVariant": [{"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab9"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab12"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab15"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab18"}], "madsrdf:historyNote": "[Established March 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-10-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ketubahs"}}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ketubahs: Traditional Jewish marriage contracts, traditionally written in Aramaic and signed by witnesses, setting out reciprocal duties of husband and wife, including the husband's obligation to pay the wife a certain sum in the event of divorce, and the wife's property rights upon his death; partial hierarchy: legal instruments > agreements > contracts <contracts by party> ketubahs)"}, "madsrdf:citationSource": "AAT, February 27, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 10 p. 930 (hdg.: \"Illuminated Ketubbot; Most Jewish communities have followed th custom of decorating the ketubbah ... However, the best-known illuminated ketubbot [plural form of ketubbah], ...)"}, "madsrdf:citationSource": "Encyclopaedia Judaica, 1972 :", "madsrdf:citationStatus": "found"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(marriage contract) (DLC)2021667669"}, "madsrdf:citationSource": "Work cat: Ketubah, [1300 to 1499]", "madsrdf:citationStatus": "found"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 10 p. 926 (hdg.: \"Ketubbah; a document recording the financial obligations which the husband undertakes toward his wife in respect of, and consequent to their marriage...Most Jewish communities have followed the custom of decorating the ketubbah.\")"}, "madsrdf:citationSource": "Encyclopaedia Judaica, 1972 :", "madsrdf:citationStatus": "found"}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jewish marriage contracts"}}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jewish marriage contracts"}}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ketubbahs"}}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ketubbahs"}}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ketubbot"}}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ketubbot"}}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ketubot"}}, {"@id": "_:nb46fb344f478483eb44fa8f6bb88c21ab19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ketubot"}}], "@id": "/authorities/genreForms/gf2022026092"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026093", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTransit maps", "identifiers:lccn": "gf2022026093", "madsrdf:adminMetadata": [{"@id": "_:naacad8a8875743f9b3341b7c2f16d262b1"}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Transit maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:naacad8a8875743f9b3341b7c2f16d262b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:naacad8a8875743f9b3341b7c2f16d262b5"}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b6"}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b7"}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b8"}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b9"}], "madsrdf:historyNote": "[Established March 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-08T09:05:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-10-25T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "new"}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transit maps"}}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Transit maps of the world, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A transit map is a topological map in the form of a schematic diagram used to illustrate the routes and stations within a public transport system--whether this be bus, tram, rapid transit, commuter rail or ferry routes. The main components are color-coded lines to indicate each route or service, with named icons to indicate stations or stops)"}, "madsrdf:citationSource": "Wikipedia, viewed Oct. 31, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Chicago transit map : showing Chicago Transit Authority Lines ... street car, motor bus, trolley bus, elevated and subway ... and connecting suburban bus routes, 1953.", "madsrdf:citationStatus": "found"}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A transit map is a representation of a public transportation network focusing on the connectivity of stations via transit lines, such as railway networks, bus lines, and ferry routes. Among these examples, metro maps, subway maps, or tube maps are typical transit maps of metropolitan railways.)"}, "madsrdf:citationSource": [{"@id": "https://doi.org/10.1111/cgf.14030"}, "Wu, H.-Y., Niedermann, B., Takahashi, S., Roberts, M.J. and N\u00f6llenburg, M. (2020), A Survey on Transit Map Layout -- from Design, Machine, and Human Perspectives. Computer Graphics Forum, 39: 619-646, on Wiley Online Library"], "madsrdf:citationStatus": "found"}, {"@id": "_:naacad8a8875743f9b3341b7c2f16d262b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(in titles: transit map; metro maps, tube map, subway map; bus map)"}, "madsrdf:citationSource": "OCLC, Oct. 31, 2022", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2022026093"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026094", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPhonetic transcriptions", "identifiers:lccn": "gf2022026094", "madsrdf:adminMetadata": [{"@id": "_:n27325255abb843f4af01e6c9790d1ffbb1"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Phonetic transcriptions"}, "madsrdf:elementList": {"@list": [{"@id": "_:n27325255abb843f4af01e6c9790d1ffbb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}], "madsrdf:hasSource": [{"@id": "_:n27325255abb843f4af01e6c9790d1ffbb5"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb6"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb7"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb8"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb9"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb10"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb11"}], "madsrdf:hasVariant": [{"@id": "_:n27325255abb843f4af01e6c9790d1ffbb12"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb15"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb18"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb21"}], "madsrdf:historyNote": "[Established March 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Textual representations of speech, text, or words using symbols to represent sounds."}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-10-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-08T09:05:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Phonetic transcriptions"}}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)844215611"}, "madsrdf:citationSource": "Saunders, Neville. Tu rait meit : phonetic transcriptions for Australians, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Phonetic transcription represents the phonetic properties of an actual or potential utterance in a written form; Phonetic transcription is the deployment of phonetic notation to represent an analysis of the phonetic content of actual or potential utterances. Common places to encounter phonetic transcriptions are dictionaries, language teaching and learning materials, linguistic descriptions of languages and language varieties, materials for learning and teaching phonetics, and phonetic analyses of speakers' behaviors, whether for speech research, or for clinical or forensic purposes. ... there are different types of transcriptions depending on what the transcriber's purposes are. Transcriptions can also have different functions. A transcription can be a (purportedly) objective descriptive record of an utterance, or it can have a prescriptive function in providing a model for pronunciation as, for example, in a dictionary for language-learners. Transcriptions can also be performance scores in dictation and production exercises for students)"}, "madsrdf:citationSource": "Brierley, C. Phonetic transcription and the International Phonetic Alphabet, published online 23 Mar. 2022 via Oxford research encyclopedia of linguistics, viewed on Oct. 26, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (with phonetic transcriptions, literal and idiomatic English translations) (OCoLC)166322490"}, "madsrdf:citationSource": "Shostakovich, Dmitri\u012d Dmitrievich. Shostakovich's complete song texts : Russian texts of the complete songs of Dmitri Dmitrievich Shostakovich, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A phonetic transcription looks quite unlike a regular ('orthographic') transcription. The transcriber notes the way the spoken words are pronounced, using a special alphabet of phonetic symbols. The most common is the international phonetic alphabet (IPA); Phonetic vs. Phonemic Transcription: 'Narrow' phonetic transcription notes the words a speaker says as a series of sounds. Every sound has its own symbol. This can lead to a very complex transcription document. There is a simpler way to transcribe these sounds: phonemic ('broad') transcription. With phonemic transcription, two similar sounds may share the same symbol if the difference between the sounds does not change the word's meaning. Thus, a phonemic transcription is less nuanced than a phonetic one)"}, "madsrdf:citationSource": "What is phonetic transcription?, via Rev.com, viewed Oct. 26, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)65510750"}, "madsrdf:citationSource": "Work cat.: Holman, Eugene. Singing in Finnish : a manual for singers and vocal coaches : 75 Finnish songs phonetically transcribed with translations, 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Phonetic transcription (also known as phonetic script or phonetic notation) is the visual representation of speech sounds (or phones) by means of symbols. The most common type of phonetic transcription uses a phonetic alphabet, such as the International Phonetic Alphabet)"}, "madsrdf:citationSource": "Wikipedia, Oct. 26, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivision --Phonetic transcriptions. UF --Transcriptions, Phonetic. SN Use as a form subdivision under individual languages and groups of languages.)"}, "madsrdf:citationSource": "LCSH, Oct. 26, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n27325255abb843f4af01e6c9790d1ffbb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Phonetic notations"}}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Phonetic notations"}}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n27325255abb843f4af01e6c9790d1ffbb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Phonetically transcribed texts"}}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Phonetically transcribed texts"}}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n27325255abb843f4af01e6c9790d1ffbb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Notations, Phonetic"}}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Notations, Phonetic"}}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n27325255abb843f4af01e6c9790d1ffbb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Transcriptions, Phonetic"}}, {"@id": "_:n27325255abb843f4af01e6c9790d1ffbb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transcriptions, Phonetic"}}], "@id": "/authorities/genreForms/gf2022026094"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026095", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIncunabula", "identifiers:lccn": "gf2022026095", "madsrdf:adminMetadata": [{"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb1"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Incunabula"}, "madsrdf:elementList": {"@list": [{"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb3"}]}, "madsrdf:hasSource": [{"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb5"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb6"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb7"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb8"}], "madsrdf:hasVariant": [{"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb9"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb12"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb15"}], "madsrdf:historyNote": "[Established March 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Materials printed before 1501 with movable metal type."}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-08T09:05:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-10-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Incunabula"}}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(incunabula) (DLC)2018751250"}, "madsrdf:citationSource": "Work cat: Adret, Solomon ben Abraham, 1235-1310. Teshuvot She'elot le-\u1e25adesh ba, [[between 1469-1473]", "madsrdf:citationStatus": "found"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(historians refer to books printed between 1455 and 1501 as incunabula, the Latin word for \"in the cradle\"; incunabulum (singular) / incunabula (plural) / incunable (the widely used anglicized singular form))"}, "madsrdf:citationSource": "Library of Congress website, March 2, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Incunabula: variants: Cradle books, Fifteeners, Incunables; Scope Note: Use for materials printed before 1501 with movable metal type)"}, "madsrdf:citationSource": "RBMS vocabulary website, March 2, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Since the 18th century, the term has applied to the earliest printed books, and is now used to refer to those printed between Johann Gutenberg's invention of printing at Mainz, circa 1450, through to 1501. 'Incunabula' is the plural; the singular is 'incunabulum'. It's often anglicised to incunable or incunables.\")"}, "madsrdf:citationSource": "Christie's website, Collecting guide: incunabula page, viewed October 27, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Incunables"}}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Incunables"}}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cradle books (Incunabula)"}}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cradle books (Incunabula)"}}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fifteeners (Incunabula)"}}, {"@id": "_:n84fd417f9eb743ba9f5cb65487129aebb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fifteeners (Incunabula)"}}], "@id": "/authorities/genreForms/gf2022026095"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026098", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEtymological dictionaries", "identifiers:lccn": "gf2022026098", "madsrdf:adminMetadata": [{"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b1"}, {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Etymological dictionaries"}, "madsrdf:elementList": {"@list": [{"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026086"}, "madsrdf:hasSource": [{"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b5"}, {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b6"}, {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b7"}], "madsrdf:hasVariant": {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b8"}, "madsrdf:historyNote": "[Established March 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-08T09:05:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Etymological dictionaries"}}, {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a Swedish etymological dictionary) publisher's summary (etymologisk ordbok [= etymological dictionary]) (OCoLC)1263758611"}, "madsrdf:citationSource": "Work cat.: Fridell, Staffan. Ordklok : svenska ords sl\u00e4ktskap och ursprung, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(etymology: specialized etymological dictionaries provide the most complete description of the evolution of words; \"etymology\" concerns the origin of a word traced back as far as possible in time, usually by the methods of comparative linguistics; most language dictionaries provide some information about word derivation but often differ in how far back origin is traced and the amount of historical detail; the Oxford English Dictionary (OED) is the leading example of an English-language dictionary constructed on historical principles; another example: The Oxford Dictionary of English Etymology edited by C.T. Onions)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, February 27, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)934298"}, "madsrdf:citationSource": "Weekley, Ernest. An etymological dictionary of modern English, 1967.", "madsrdf:citationStatus": "found"}, {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Etymology dictionaries"}}, {"@id": "_:na0b1666866084ceeb9b6d65cdde5ae01b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Etymology dictionaries"}}], "@id": "/authorities/genreForms/gf2022026098"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026099", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAutographs", "identifiers:lccn": "gf2022026099", "madsrdf:adminMetadata": [{"@id": "_:n091e3d5cc2714976a844cb538b148f39b1"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Autographs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n091e3d5cc2714976a844cb538b148f39b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026163"}, "madsrdf:hasSource": [{"@id": "_:n091e3d5cc2714976a844cb538b148f39b5"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b6"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b7"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b8"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b9"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b10"}], "madsrdf:hasVariant": [{"@id": "_:n091e3d5cc2714976a844cb538b148f39b11"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b14"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b17"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b20"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b23"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b26"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b29"}], "madsrdf:historyNote": "[Established March 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Resources consisting of or containing autographs (names of persons written in their own hand) or reproductions of autographs."}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-08T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-08T09:05:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autographs"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(title translates as: Autographs on the walls of the Reichstag : about the soldiers of the Red Army, whose names entered the history of the Reichstag; contains reproductions of the autographs) subj. hdg. (Soldiers--Soviet Union--Autographs.)"}, "madsrdf:citationSource": "Ignatenko, Leonid. Avtografy na stenakh Re\u012dkhstaga : o voinakh Krasno\u012d Armii, ch\u02b9i imena voshli v istorii\ufe20u\ufe21 Re\u012dkhstaga, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "autograph albums (UF autograph books. SN Books, loose-leaf binders, or other volumes containing blank leaves, on which persons have written sentiments, quotations, or signatures. BT albums (books)) autographs (manuscripts) (UF autograph documents. SN Documents written in, and usually signed with, the writer's own hand; in certain legal instances, prefer \"holographs.\" BT manuscripts (documents)) signatures (names) (UF autographs (signatures). SN Persons' names written in their own hand. BT inscriptions)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Nov. 8, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (\"Maenni Ruben was a Danish graphic artist, musician and violinist, born in 1922, who was, unluckily, one of the 476 Danish Jews captured and deported by the Nazi regime during the Second World War. Virtually all of these Danish prisoners were sent to the concentration camp/ghetto in the Czech fortified town of Terezin (the German occupiers called it Theresienstadt) and most of the Danes incarcerated there survived the war. In the period just before and then after the liberation of the camp on May 8th 1945, an autograph book was created for Maenni, who by that time had already been able to leave the camp on the White Buses. While Maenni died in 1976 in Copenhagen, his book was kept by his wife Susi, and only came to light in Victoria BC Canada in 2018 ... This website features the book, the poster exhibit spearheaded by Janna Ginsberg Bleviss, and some additional resources related to the content and context of the autograph book.\") subj. hdgs. (Nazi concentration camp inmates--Czech Republic--Terez\u00edn (\u00dasteck\u00fd kraj)--Autographs; Jewish musicians--Czech Republic--Terez\u00edn (\u00dasteck\u00fd kraj)--Autographs) (OCoLC)1184673041"}, "madsrdf:citationSource": "Work cat.: Ruben, M\u00e6nni. M\u00e6nni Ruben's Theresienstadt 1945 autograph book, via WWW, viewed Nov. 8, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autographs. SN Names of people written in their own hand; stamped or printed signatures are not included. BT Inscriptions. NT Artists' signatures)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Nov. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "autograph (An original manuscript written entirely in the hand of the author (or composer) or dictated by the author, often highly prized by rare book collectors. Compare with holograph. See also: autograph score. Also refers to a person's own signature. See also: autograph book, autographed copy, and autographed edition.) autograph book: A book with blank pages intended for the collection of signatures of friends and/or famous people, with or without accompanying inscriptions. The value of an autograph book in the collectors' market depends on the rarity of the signatures it contains.) autograph document signed (ADS) (A document written and signed by its author.) autographed copy (A copy of a book or other published work signed by the author. Autographed copies may be of considerable value to collectors if the author is very well known and signed copies rare, as in the case of a small limited edition. Compare with inscribed copy.) autographed edition (An edition of a work in which all the copies are personally signed by the author, possible only in comparatively small editions.)"}, "madsrdf:citationSource": "Reitz, Joan M. Online dictionary for library and information science, Nov. 8, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivision --Autographs; UF --Handwriting; --Signatures (Writing). SN Use as a form subdivision under names of individual persons, classes of persons, and ethnic groups for collections of autographs of those persons. Also use under individual wars for collections of autographs of persons associated with the war.)"}, "madsrdf:citationSource": "LCSH, Nov. 8, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n091e3d5cc2714976a844cb538b148f39b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Signatures (Autographs)"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Signatures (Autographs)"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n091e3d5cc2714976a844cb538b148f39b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Collections of autographs"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Collections of autographs"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n091e3d5cc2714976a844cb538b148f39b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Albums, Autograph"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Albums, Autograph"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n091e3d5cc2714976a844cb538b148f39b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autograph albums"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autograph albums"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n091e3d5cc2714976a844cb538b148f39b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autograph books"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autograph books"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n091e3d5cc2714976a844cb538b148f39b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Autograph collections"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Autograph collections"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n091e3d5cc2714976a844cb538b148f39b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Autograph"}}, {"@id": "_:n091e3d5cc2714976a844cb538b148f39b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Autograph"}}], "@id": "/authorities/genreForms/gf2022026099"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026100", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBlackout sketches", "identifiers:lccn": "gf2022026100", "madsrdf:adminMetadata": [{"@id": "_:n6993af05394e4023947c93fe52b38f3db1"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Blackout sketches"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6993af05394e4023947c93fe52b38f3db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026265"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027050"}], "madsrdf:hasSource": [{"@id": "_:n6993af05394e4023947c93fe52b38f3db5"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db6"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db7"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db8"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db9"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db10"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db11"}], "madsrdf:hasVariant": [{"@id": "_:n6993af05394e4023947c93fe52b38f3db12"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db15"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db18"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db21"}], "madsrdf:historyNote": "[Established April 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-04-14T13:44:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blackout sketches"}}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1396957"}, "madsrdf:citationSource": "Huber, Louis J. Fun for everyone : a collection of short blackout sketches, 1963.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (At head of title: Skits and blackouts) (OCoLC)336070"}, "madsrdf:citationSource": "Work cat.: Taggart, Tom. For women only, 1947:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)5254426"}, "madsrdf:citationSource": "Provence, Jean. \"The vaudeville stunt book\" : a collection of snappy skits and blackouts, \u00a91937.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)5109912"}, "madsrdf:citationSource": "Huber, Louis J. Four minutes of fun : a collection of short blackout sketches, \u00a91949.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(blackout sketch: A short performance, usually comic, requiring instantaneous darkening of the entire stage to punctuate the punchline. Commonly used in burlesque)"}, "madsrdf:citationSource": "Mobley, J.P. NTC's dictionary of theatre and drama terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(black-out skit: A skit building up to end in a blackout on the curtain line--U.S. Revue and Vaudeville. British: Variety turn, etc.)"}, "madsrdf:citationSource": "Bowman, W.P. Theatre language, \u00a91961", "madsrdf:citationStatus": "found"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Blackout sketch: Short comic playlet building to a final gag-line followed immediately by a sudden blackout for emphasis. Very popular in revue)"}, "madsrdf:citationSource": "Winslow, C. The Oberon glossary of theatrical terms, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6993af05394e4023947c93fe52b38f3db13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Black-out sketches"}}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Black-out sketches"}}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6993af05394e4023947c93fe52b38f3db16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Blackout skits"}}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blackout skits"}}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6993af05394e4023947c93fe52b38f3db19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Blackouts (Drama)"}}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Blackouts (Drama)"}}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6993af05394e4023947c93fe52b38f3db22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Black-out skits"}}, {"@id": "_:n6993af05394e4023947c93fe52b38f3db22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Black-out skits"}}], "@id": "/authorities/genreForms/gf2022026100"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026101", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKonpa (Music)", "identifiers:lccn": "gf2022026101", "madsrdf:adminMetadata": [{"@id": "_:nd69b56823352476c95ea889f8347d2a9b1"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Konpa (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd69b56823352476c95ea889f8347d2a9b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nd69b56823352476c95ea889f8347d2a9b5"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b6"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b7"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b8"}], "madsrdf:hasVariant": [{"@id": "_:nd69b56823352476c95ea889f8347d2a9b9"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b12"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b15"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b18"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b21"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b24"}], "madsrdf:historyNote": "[Established April 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-04-14T13:44:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Konpa (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 1004 (Konpa-dir\u00e8k: Haitian popular dance modeled on the Dominican merengue)"}, "madsrdf:citationSource": "The Garland encyclopedia of world music (Music online), Vol. 2, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc label (Kaskad compas: les tubes des stars du compas) (DLC)94755855"}, "madsrdf:citationSource": "Work cat: Kaskad compas, not after 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Konpa (Konpa; \"A popular dance music genre that rose to prominence in Haiti during the mid-1950s and which remains at the forefront of the Haitian music scene, both in Haiti and in the Haitian diaspora\"; origins are either in the Dominican merengue t\u00edpico or Haitian folkloric music (which includes European and African influences); \"Early ensembles typically comprised vocals, saxophones, accordion, acoustic guitar, string bass, drum set, and various percussion instruments. From the 1960s, band composition decreased in size and shifted to include more electronic instruments (guitar, bass, and synthesizers). During the 1970s, konpa bands began widely incorporating trumpets, trombones, and congas or tambou (a drum similar to the conga) and reflected the popular sounds of jazz, funk, and soul. Konpa music today often bears the influence of hip-hop, reggae, ragga, and R&B\"; lyrics have \"ranged broadly from themes of love to political and social critique\" )"}, "madsrdf:citationSource": "Grove music online, December 6, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Compas (Compas; also known as compas direct or compas direk; in Haitian Creole: konpa, kompa, or kompa dir\u00e8k; \"modern m\u00e9ringue dance music genre of Haiti\"; origin can be traced to the mid-1950s; has spread throughout the Caribbean due to the touring of Haitian bands)"}, "madsrdf:citationSource": "Wikipedia, December 6, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd69b56823352476c95ea889f8347d2a9b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Compas direk (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Compas direk (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd69b56823352476c95ea889f8347d2a9b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Konpa-dir\u00e8k (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Konpa-dir\u00e8k (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd69b56823352476c95ea889f8347d2a9b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kompa-dir\u00e8k (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kompa-dir\u00e8k (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd69b56823352476c95ea889f8347d2a9b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kompa (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kompa (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd69b56823352476c95ea889f8347d2a9b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Compas (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Compas (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd69b56823352476c95ea889f8347d2a9b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Compas direct (Music)"}}, {"@id": "_:nd69b56823352476c95ea889f8347d2a9b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Compas direct (Music)"}}], "@id": "/authorities/genreForms/gf2022026101"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026102", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLookbooks", "identifiers:lccn": "gf2022026102", "madsrdf:adminMetadata": [{"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb1"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lookbooks"}, "madsrdf:elementList": {"@list": [{"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026144"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026038"}], "madsrdf:hasSource": [{"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb5"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb6"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb7"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb8"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb9"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb10"}], "madsrdf:hasVariant": {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb11"}, "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "A collection of photographs, generally in book format, compiled to present a model, photographer, style, stylist, designer, product, or clothing line, oftentimes to a client."}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-31T11:18:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/nnmm"}, "ri:recordStatus": "new"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lookbooks"}}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Look Book Printing (Look books are essential to businesses in the fashion industry interested in showcasing their collections to potential clients, serving as a printed portfolio or catalog of a company's offerings)"}, "madsrdf:citationSource": "Digital City Printing web site, viewed on December 6, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A lookbook is a collection of photographs compiled to show off a model, photographer, style, stylist, or clothing line. . .Lookbooks take a special place in the fashion industry, as they are used to present the product to the client)"}, "madsrdf:citationSource": "Wikipedia, viewed on December 6, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "What Is a Lookbook? (A lookbook is a design collection that started in fashion but has applications for designers and photographers as well. A lookbook is essentially a portfolio, that's formatted and updated in a diary-style with frequent changes and updates)"}, "madsrdf:citationSource": "Design Shack web site, viewed on December 6, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OcoLC)778840750"}, "madsrdf:citationSource": "Work cat: Look books, 1997-2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "What is a Fashion Lookbook and How to Create one? (A fashion lookbook is a fashion catalogue of well-styled images that convey the essence of your brand through creative storytelling)"}, "madsrdf:citationSource": "Fashion Insiders web site, viewed on December 6, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Fashion A-Z (Look-books are a collection of photographs compiled by a designer to present their complete collection of clothing, accessories or footwear in a flick book)"}, "madsrdf:citationSource": "Business of Fashion web site, viewed on December 6, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Look books"}}, {"@id": "_:n53b7e009a4a34cd8b50b4f490aadc92bb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Look books"}}], "@id": "/authorities/genreForms/gf2022026102"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026103", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOnline discussion forums", "identifiers:lccn": "gf2022026103", "madsrdf:adminMetadata": [{"@id": "_:n4d984224caa14323aa415ca253c2f097b1"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Online discussion forums"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4d984224caa14323aa415ca253c2f097b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:n4d984224caa14323aa415ca253c2f097b5"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b6"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b7"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b8"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b9"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b10"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b11"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b12"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b13"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b14"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b15"}], "madsrdf:hasVariant": [{"@id": "_:n4d984224caa14323aa415ca253c2f097b16"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b19"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b22"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b25"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b28"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b31"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b34"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b37"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b40"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b43"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b46"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b49"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b52"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b55"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b58"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b61"}], "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Online discussion groups and mailing lists, either moderated or unmoderated, consisting of messages posted by subscribers, as well as resources that archive the messages or republish them in another format."}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-11T12:18:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Online discussion forums"}}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Electronic discussion groups. SN Here are entered works on services, commonly called newsgroups and LISTSERV lists, that allow a computer user to post messages to, and read messages from, a group of people who have a common interest, usually by means of the Internet, a commercial online service, or electronic mail)"}, "madsrdf:citationSource": "LCSH, May 30, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(form subdivision --Electronic discussion groups. SN Use as a form subdivision under subjects for electronic discussion groups on those subjects.)"}, "madsrdf:citationSource": "LCSH, May 30, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Listserv 1. Trademark: the brand name for one of the most common internet list servers. 2. listserv: any similar software program. 3. listserv: an email discussion group; an online mailing list)"}, "madsrdf:citationSource": "Dictionary.com, Dec. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)933038154"}, "madsrdf:citationSource": "Phillips, Cynthia E. Motivation to participate in electronic discussion forums for professional development, \u00a92007.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 128 (LISTSERV discussion group; LISTSERV groups; discussion list)"}, "madsrdf:citationSource": "The public-access computer systems review, v. 2, no. 1 (1991), viewed Dec. 12, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(An Internet forum, or message board, is an online discussion site where people can hold conversations in the form of posted messages)"}, "madsrdf:citationSource": "Wikipedia, July 26, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "LISTSERV (Mailing list management software that runs on a variety of platforms, designed to scan incoming e-mail messages for the words \"subscribe,\" \"unsubscribe,\" and other housekeeping commands and update the subscriber list automatically. Also used as a general term for any mailing list that runs on LISTSERV software. Tile.Net/Lists is a online directory of e-mail newsletters and discussion lists) mailing list (An e-mail discussion forum that allows individuals to subscribe and automatically receive messages posted to the list by other subscribers. Participants may also post their own messages and replies for distribution to the other subscribers to the list. A mailing list may be moderated or unmoderated)"}, "madsrdf:citationSource": "Reitz, J.M. Online dictionary for library and information science, Dec. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)226076353"}, "madsrdf:citationSource": "Scholar (New York, N.Y.). Scholar : an online listserv for text analysis and natural language applications, 1992-", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (the free, electronic, international\u00a0forum for Occupational & Environmental Medicine) (OCoLC)180161571"}, "madsrdf:citationSource": "Occ-Env-Med-L, 1993- , via WWW, Dec. 12, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 178 (online discussion groups) (OCoLC)1257957196"}, "madsrdf:citationSource": "G\u00f3mez Jaimes, D. R. Analyzing social construction of knowledge and social networks in online discussion forums in Spanish, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(listserv: a service on the internet that provides an electronic mailing to subscribers with similar interests; listservs)"}, "madsrdf:citationSource": "Collins English dictionary online, Dec. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d984224caa14323aa415ca253c2f097b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Discussion forums, Email"}}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Discussion forums, Email"}}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d984224caa14323aa415ca253c2f097b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Listserv discussion groups"}}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Listserv discussion groups"}}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d984224caa14323aa415ca253c2f097b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Discussion groups, Online"}}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Discussion groups, Online"}}, {"@id": "_:n4d984224caa14323aa415ca253c2f097b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d984224caa14323aa415ca253c2f097b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Discussion forums, Electronic"}}, {"@id": "_:n4d984224ca