:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n3880802d54f04006a6cea94ee3aa9a0fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sketch comedy television programs"}}, {"@id": "_:n3880802d54f04006a6cea94ee3aa9a0fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sketch comedy TV shows)"}, "madsrdf:citationSource": "Yahoo directory, Nov. 12, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3880802d54f04006a6cea94ee3aa9a0fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sketch comedy: comedy show which is predominantly short sketches, often related; also known as a sketch show; descendent of the variety show)"}, "madsrdf:citationSource": "Tvtropes WWW site, Nov. 12, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3880802d54f04006a6cea94ee3aa9a0fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sketch comedy: a series of short comedy scenes or vignettes, called \"sketches,\" commonly between one and ten minutes long; moved to television with such shows as Monty Python's flying circus and Not the nine o'clock news; lists over five dozen \"television sketch comedy shows\")"}, "madsrdf:citationSource": "Wikipedia, Nov. 12, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3880802d54f04006a6cea94ee3aa9a0fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sketch comedy/skit show (TV))"}, "madsrdf:citationSource": "Fancast WWW site, Nov. 12, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3880802d54f04006a6cea94ee3aa9a0fb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3880802d54f04006a6cea94ee3aa9a0fb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Skit shows (Televi