"], "madsrdf:elementList": {"@list": [{"@id": "_:n55eaff0c396344cc8e299de6c392e95db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comedies, Radio"}}, {"@id": "_:n55eaff0c396344cc8e299de6c392e95db12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedies, Radio"}}, {"@id": "_:n55eaff0c396344cc8e299de6c392e95db14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n55eaff0c396344cc8e299de6c392e95db15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Situation comedies, Radio"}}, {"@id": "_:n55eaff0c396344cc8e299de6c392e95db15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Situation comedies, Radio"}}, {"@id": "_:n55eaff0c396344cc8e299de6c392e95db17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n55eaff0c396344cc8e299de6c392e95db18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comedy programs, Radio"}}, {"@id": "_:n55eaff0c396344cc8e299de6c392e95db18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedy programs, Radio"}}, {"@id": "_:n55eaff0c396344cc8e299de6c392e95db20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n55eaff0c396344cc8e299de6c392e95db21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio situation comedies"}}, {"@id": "_:n55eaff0c396344cc8e299de6c392e95db21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio situation comedies"}}, {"@id": "_:n55eaff0c396344cc8e299de6c392e95db23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n55eaff0c396344cc8e299de6c392e95db24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio comedy programs"}}, {"@id": "_:n55eaff0c396344cc8e299de6c392e95db24", "@type": "madsrdf:GenreFor