ce", "madsrdf:citationNote": {"@language": "en", "@value": "Christian media article (Christian media refers to various aspects of mass media which is primarily targeting the Christian demographic [and takes various forms including] Christian television, which may include broadcast television or cable television channels whose entire programming schedule is comprised of programs directly related to Christianity)"}, "madsrdf:citationSource": "Wikipedia website, February 25, 2008:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026130"}
