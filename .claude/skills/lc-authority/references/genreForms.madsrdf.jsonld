{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2020026059", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRosh ha-Shanah poetry", "identifiers:lccn": "gf2020026059", "madsrdf:adminMetadata": [{"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab1"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rosh ha-Shanah poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026503"}, "madsrdf:hasSource": [{"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab5"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab6"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab7"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab8"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab9"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab10"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab11"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab12"}], "madsrdf:hasVariant": [{"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab13"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab16"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab19"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab22"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab25"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab28"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab31"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab34"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab37"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab40"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab43"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab46"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-07-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-09-04T13:09:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rosh ha-Shanah poetry"}}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Yom HaDin. Alternate spelling: Yom Ha-Din, Yom ha-Din. \"Day of Judgement;\" alternate name for Rosh HaShanah; Yom T'ruah: \"Day of Shofar Blowing;\" alternate name for Rosh HaShanah)"}, "madsrdf:citationSource": "Jewish glossary, via ReformJudaism.org website, July 2, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Religious poetry in Ladino for Rosh Hashana and Yom Kippur, 1976.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free translation of Hebrew Rosh Hashana and Yom Kippur poems into Ladino)"}, "madsrdf:citationSource": "Work cat.: Israel, R.E. Traducsion libera de las poezias ebraicas de Ro\u015f A\u015fana i Kipur, 1910", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(verses for Rosh ha-Shanah)"}, "madsrdf:citationSource": "Le-\u02bbOlam H. devarekha nitsav ba-shamayim, between 1884 and 1892", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rosh Hashana, (Hebrew: \"Beginning of the Year\"), Hashana also spelled Hashanah or Ha-shanah, also called Day of Judgment or Day of Remembrance, a major Jewish observance now accepted as inaugurating the religious New Year on Tishri 1 (September or October))"}, "madsrdf:citationSource": "Britannica online, July 2, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Plumley, B.R. Poems for Rosh-hashanah, Jewish New Year, 5636-5638, 1876?", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rosh Hashanah is the Jewish New Year; most common name for this holiday is Rosh Hashanah; the Torah refers to this day as Yom Teruah (Day of Shofar Blowing); in our prayers, we often call it Yom Hazikaron (Day of Remembrance) and Yom Hadin (Day of Judgement);"}, "madsrdf:citationSource": "What is Rosh Hashanah?, via Chabad.org website, July 2, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rosh Hashanah, the Jewish new year, is a fall holiday, taking place at the beginning of the month of Tishrei; also known as Yom Hadin or the Day of Judgment)"}, "madsrdf:citationSource": "Rosh Hashanah 101, via My Jewish learning website, July 2, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yom Hazikaron poetry"}}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yom Hazikaron poetry"}}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Day of Judgement poetry"}}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Day of Judgement poetry"}}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jewish New Year poetry"}}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jewish New Year poetry"}}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Day of Remembrance poetry"}}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Day of Remembrance poetry"}}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Day of Judgment poetry"}}, {"@id": "_:n5ed7d29c3e854a3fa04869106c08d0bab26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Day of Judgment poetry"}}, {"@id": "_