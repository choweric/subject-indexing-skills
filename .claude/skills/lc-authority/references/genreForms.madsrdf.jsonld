"@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-12T14:21:23"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n9b8d0a4a806d48e0845b84540f47ff4fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television adaptations"}}, {"@id": "_:n9b8d0a4a806d48e0845b84540f47ff4fb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Pride and prejudice : the stunning BBC TV dramatisation of a classic romance, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b8d0a4a806d48e0845b84540f47ff4fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 25 (Adaptations: use for a work which has been created by the modification of another work in order to transpose it from one medium to another)"}, "madsrdf:citationSource": "Yee, Martha M. Moving image materials : genre terms, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b8d0a4a806d48e0845b84540f47ff4fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dramatization: The act of making a play out of a story in another genre; from a chronicle, novel, short story and so forth; it is a practice by no means extinct, as television and recent theatrical history amply demonstrate)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b8d0a4a806d48e0845b84540f47ff4fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(notes: A BBC Television dramatization of Shakespeare's play entitled, Hamlet; Television dramatization of the Chinese classic Dream of the Red Chamber, which tells the saga of four wealthy families in the heyday of the Ch\u02bbing dynasty; A made-for-television dramatization of William Shakespeare's play about power, assassination and revenge; A television dramatization of the children's book Kaitangata twitch by Margaret Mahy; Television dramatization of William Shakespeare's play: Love's labour's lost; A made-for-television dramatization of F. Scott Fitzgerald's Tender is the night; Television dramatisation of the romance between Queen Victoria and her German-born consort Prince Albert, from 1837 to 1861; New TV dramatisation of the post-apocalyptic drama, based on the John Wyndham novel)"}, "madsrdf:citationSource": "OCLC, Jan. 19, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b8d0a4a806d48e0845b84540f47ff4fb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Middlemarch : the magnificent BBC TV dramatisation of the epic story of love, politics and frustrated passion in 19th century England, 1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b8d0a4a806d48e0845b84540f47ff4fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Adaptation: fiction or nonfiction work taken from a work already existing in another medium, such as a book, short story, comic strip, radio program, or play)"}, "madsrdf:citationSource": "Moving image genre-form guide online, August 20, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b8d0a4a806d48e0845b84540f47ff4fb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Television adaptations)"}, "madsrdf:citationSource": "LCSH, Aug. 20, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b8d0a4a806d48e0845b84540f47ff4fb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9b8d0a4a806d48e0845b84540f47ff4fb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dramatizations"}}, {"@id": "_:n9b8d0a4a806d48e0845b84540f47ff4fb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dramatizations"}}, {"@id":