://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nef84ba689299436f8e2ede5388dc0715b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thesauri (Dictionaries)"}}, {"@id": "_:nef84ba689299436f8e2ede5388dc0715b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Thesauri. BT Wordbooks)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nef84ba689299436f8e2ede5388dc0715b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(thesaurus, plural thesauri or thesauruses: 1: treasury, storehouse. 2a: a book of words or of information about a particular field or set of concepts; especially : a book of words and their synonyms. 2b: a list of subject headings or descriptors usually with a cross-reference system for use in the organization of a collection of documents for reference and retrieval)"}, "madsrdf:citationSource": "Merriam-Webster online, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nef84ba689299436f8e2ede5388dc0715b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(thesaurus: A book of synonyms and near-synonyms in a written language, usually arranged conceptually, although dictionary arrangement is not uncommon. Also refers to an alphabetically arranged lexicon of terms comprising the specialized vocabulary of an academic discipline or field of study, showing the logical and semantic relations among terms, particularly a list of subject headings or descriptors used as preferred terms in indexing the literature of the field. Plural: thesauri)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nef84ba689299436f8e2ede5388dc0715b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Thesauri. Synonym - Instead of this term use: Reference Materials)"}, "madsrdf:citationSource": "ERIC thesaurus, via WWW, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nef84ba689299436f8e2ede5388dc0715b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nef84ba689299436f8e2ede5388dc0715b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Thesauruses (Dictionaries)"}}, {"@id": "_:nef84ba689299436f8e2ede5388dc0715b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thesauruses (Dictionaries)"}}, {"@id": "_:nef84ba689299436f8e2ede5388dc0715b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nef84ba689299436f8e2ede5388dc0715b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Synonym dictionaries"}}, {"@id": "_:nef84ba689299436f8e2ede5388dc0715b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Synonym dictionaries"}}], "@id": "/authorities/genreForms/gf2014026195"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026196", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aToasts (Speeches)", "identifiers:lccn": "gf2014026196", "madsrdf:adminMetadata": [{"@id": "_:n25d1819beb794969b8cb9af2a6c623aab1"}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Toasts (Speeches)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n25d1819beb794969b8cb9af2a6c623aab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026363"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026064"}], "madsrdf:hasSource": [{"@id": "_:n25d1819beb794969b8cb9af2a6c623aab5"}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab6"}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab7"}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab8"}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Toasts (Speeches)"}}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(toast: a salutation or a few words of congratulation, good wishes, appreciation, remembrance, etc., uttered immediately before drinking to a person, event, etc.)"}, "madsrdf:citationSource": "Dictionary.com, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(toast: A call to a gathering of people to raise their glasses and drink together in honor of a person or thing, or an instance of drinking in this way)"}, "madsrdf:citationSource": "Oxford dictionaries website, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 83 (toast: call to company to drink in honour of person, institution etc.)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(toast: an occasion when people all drink together and say someone's name in order to express their admiration or their good wishes)"}, "madsrdf:citationSource": "Macmillan dictionary website, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n25d1819beb794969b8cb9af2a6c623aab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Toast (honor). A toast is a ritual in which a drink is taken as an expression of honor or goodwill. The term may be applied to the person or thing so honored, the drink taken, or the verbal expression accompanying the drink.)"}, "madsrdf:citationSource": "Wikipedia, July 28, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026196"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026197", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aToy and movable books", "identifiers:lccn": "gf2014026197", "madsrdf:adminMetadata": [{"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab1"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Toy and movable books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026104"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026105"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026107"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026123"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026143"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026150"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026171"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026177"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026179"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026192"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026204"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026206"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026144"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026021"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026082"}], "madsrdf:hasSource": [{"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab5"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab6"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab7"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab8"}], "madsrdf:hasVariant": [{"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab9"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab12"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab15"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab18"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Toy and movable books"}}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(toy books. Children's picture books produced primarily in Britain in the mid-19th century. Typically comprising six or eight large, nearly square pages printed on one side only with color illustrations accompanied by a minimum of text. BT picture books)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Toy books. Scope Note: Use for 19th-century illustrated children's books intended to entertain or amuse, rather than instruct. UF Books, toy. BT Illustrated works; Juvenile literature)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Toy and movable books. UF Manipulative books; Movable books; Moveable books; Novelty books; Participation books; Slide-and-peek books. BT Illustrated children's books)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(toy book: A small, illustrated book for young children, published in 19th-century England and America, usually consisting of eight leaves of vivid, hand-colored pictures with very little text (alphabets and simple tales were popular). Originally issued in paper covers, later variations included cloth books printed on sturdy fabric, pop-up books, and flicker books.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novelty books"}}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novelty books"}}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Moveable books"}}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Moveable books"}}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Movable and toy books"}}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Movable and toy books"}}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Movable books"}}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Movable books"}}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Toy books"}}, {"@id": "_:n2e59dff7780f402b8daa050a1f3aee5ab22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Toy books"}}], "@id": "/authorities/genreForms/gf2014026197"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026198", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrade catalogs", "identifiers:lccn": "gf2014026198", "madsrdf:adminMetadata": [{"@id": "_:n66412cb91aef42b491514eda51ad202bb1"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trade catalogs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n66412cb91aef42b491514eda51ad202bb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027257"}], "madsrdf:hasSource": [{"@id": "_:n66412cb91aef42b491514eda51ad202bb5"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb6"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb7"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb8"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb9"}], "madsrdf:hasVariant": [{"@id": "_:n66412cb91aef42b491514eda51ad202bb10"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb13"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Catalogs that are published by manufacturers or dealers in order to present lines of products for sale, generally to people or businesses in a specific profession."}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:46:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trade catalogs"}}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trade catalogs: Use for sales catalogs directed at people or businesses in a specific trade)"}, "madsrdf:citationSource": "RBMS genre terms, viewed online, Feb. 12, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trade catalogs. UF trade catalogues; commercial catalogs; trade lists; commercial catalogues. Catalogs designed to present lines of products and to supply sufficient information to facilitate the purchasing process; may be issued by manufacturers or by dealers, often including or accompanied by price information. A catalogue designed to present a line of products and to provide information to facilitate the ordering process)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Manufacturers' catalogs, BT Sales catalogs; Trade catalogs, UF Commercial catalogs, BT Sales catalogs)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Commercial catalogs. UF Commercial products--Catalogs; Mail-order catalogs; Trade catalogs. BT Catalogs)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trade catalog 1. A catalog designed to present a line of products or various sizes and models of a product, and to supply sufficient technical information to facilitate the purchasing process. (Z39.6) 2. A catalog issued by a manufacturer, a dealer, or a group of manufacturers, describing (and sometimes illustrating) their products, and sometimes including or accompanied by a price list. Synonymous with manufacturer's catalog, trade list)"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66412cb91aef42b491514eda51ad202bb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Manufacturers' catalogs"}}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Manufacturers' catalogs"}}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66412cb91aef42b491514eda51ad202bb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Commercial catalogs"}}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Commercial catalogs"}}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n66412cb91aef42b491514eda51ad202bb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trade lists"}}, {"@id": "_:n66412cb91aef42b491514eda51ad202bb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trade lists"}}], "@id": "/authorities/genreForms/gf2014026198"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026199", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrademark lists", "identifiers:lccn": "gf2014026199", "madsrdf:adminMetadata": [{"@id": "_:n360c1f07f45149c48a347c085ae8e1acb1"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trademark lists"}, "madsrdf:elementList": {"@list": [{"@id": "_:n360c1f07f45149c48a347c085ae8e1acb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasSource": [{"@id": "_:n360c1f07f45149c48a347c085ae8e1acb5"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb6"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb7"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb8"}], "madsrdf:hasVariant": [{"@id": "_:n360c1f07f45149c48a347c085ae8e1acb9"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb12"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb15"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trademark lists"}}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trademarks. See also subdivision Trademarks under individual industries and under products and articles that may be trademarked, e.g. Construction industry--Trademarks; Automobiles--Trademarks. UF Merchant marks; Trade-marks; Trade names; --Trademarks. UF --Trade-marks. Use as a form subdivision under individual industries and under products and articles that may be trademarked for works listing trademarks.)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trademark (TM): A letter, numeral, word, phrase, logo, device, design, sound, or symbol (or combination of these) used in connection with a product or service to signify, directly or by association, the identity of the maker, usually a commercial enterprise that has reserved to itself the use of the distinctive mark by registering it with the U.S. Patent and Trademark Office. Also spelled trade mark; brand name: The part of the name or logo associated with a specific product or service, which can be vocalized, usually letters, words, and/or numerals identifying and distinguishing it from varieties of the same product or service marketed by competing companies (example: Coca-Cola versus Pepsi-Cola). When registered with the U.S. Patent and Trademark Office, a brand or part of a brand is known as a trademark.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trademark 1: a device (as a word) pointing distinctly to the origin or ownership of merchandise to which it is applied and legally reserved to the exclusive use of the owner as maker or seller. Synonym: brand. 2: a distinguishing characteristic or feature firmly associated with a person or thing; brand name 1: an arbitrarily adopted name that is given by a manufacturer or merchant to an article or service to distinguish it as produced or sold by that manufacturer or merchant and that may be used and protected as a trademark)"}, "madsrdf:citationSource": "Merriam-Webster online, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trademarks. UF marks, merchant; merchant marks; trade-marks. The names, symbols, figures, letters, words, or other marks adopted and used by a manufacturer or merchant in order to designate his goods and to distinguish them from any others; usually registered with a governmental agency to assure its use exclusively by the owner of the mark. For devices similarly used but identifying services rather than products, use \"service marks.\" For specific graphic images derived from trademarks, use \"logotypes\" or \"logos.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n360c1f07f45149c48a347c085ae8e1acb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trade-mark lists"}}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trade-mark lists"}}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n360c1f07f45149c48a347c085ae8e1acb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trade name lists"}}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trade name lists"}}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n360c1f07f45149c48a347c085ae8e1acb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lists of trademarks"}}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lists of trademarks"}}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n360c1f07f45149c48a347c085ae8e1acb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Merchant mark lists"}}, {"@id": "_:n360c1f07f45149c48a347c085ae8e1acb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Merchant mark lists"}}], "@id": "/authorities/genreForms/gf2014026199"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026200", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTravel writing", "identifiers:lccn": "gf2014026200", "madsrdf:adminMetadata": [{"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb1"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Travel writing"}, "madsrdf:elementList": {"@list": [{"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026074"}, "madsrdf:hasSource": [{"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb5"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb6"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb7"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb8"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb9"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb10"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb11"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb12"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb13"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb14"}], "madsrdf:hasVariant": [{"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb15"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb18"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb21"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Nonfiction travel writing, often presented in narrative form or as memoirs, focusing either on specific destinations or on the journeys themselves."}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T17:50:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Travel writing"}}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "The best women's travel writing : true stories from around the world, 2005-", "madsrdf:citationStatus": "found"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Travelers' writings. UF Travelogues (Travelers' writings); Writings of travelers. Here are entered collections of works written by travelers from several countries. Collections of works written by travelers from a specific country are entered under Travelers' writings qualified by the nationality of the travelers, e.g. Travelers' writings, American. ... Works on the authorship of writings by travelers that are often presented in narrative form or as memoirs are entered under Travel writing.)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "The best American travel writing, 2000-", "madsrdf:citationStatus": "found"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "The best travel writing, c2005-", "madsrdf:citationStatus": "found"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(number of books tagged with term: travel-writing, 4033; travelogues, 1639; travel-literature, 1244; travel-nonfiction, 15; travelers'-writings/travelers-writings: 0)"}, "madsrdf:citationSource": "Goodreads, Nov. 14, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Travel literature. The genre of travel literature includes outdoor literature, exploration literature, adventure literature, mountain literature, nature writing, and the guide book, as well as accounts of visits to foreign countries. The sub-genre of travel journals, diaries and direct records of a traveler's experiences, dates back to Pausanias in the 2nd century AD and James Boswell's 1786 Journal of a Tour to the Hebrides.)"}, "madsrdf:citationSource": "Wikipedia, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ch. 2 (travel writing often said to have originated in the fifth century B.C.E. with Herodotus; in the heyday of travel and exploration in the nineteenth century, writers focused on both the geographical descriptions and adventurous aspects of their travel; this is less true in today's \"smaller\" world but travel books highlighting new and exotic locales still exist; recent travelogues and travel narratives feature more subjective, memoir-like approaches; travel writers' widespread use and expected use of exaggeration, drama, and hyperbole, and their selective use and organization of facts add to their narrative appeal and the quickness of their pacing; travel subgenres include: armchair travel (focus on details of destination); adventures (emphasis on storytelling, related to true adventure genre); journey narratives; expatriate life; travel humor)"}, "madsrdf:citationSource": "Cords, S.S. The real story: a guide to nonfiction reading interests, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 19 (the increasing popularity of travelogues in the context of mass tourism; travel writing remains popular because it feeds on images of otherness)"}, "madsrdf:citationSource": "The global politics of contemporary travel writing, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 84 (travelogue: film or illustrated lecture about places)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(travel book: A work of nonfiction in which the author describes, for the enjoyment and consideration of the reader, his or her travel experiences, usually in a specific region or country (a modern example: Travels with Charley: In Search of America by John Steinbeck). Travel books became popular in the 19th century when railroads and steamships made long-distance travel more accessible to writers.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Travel literature"}}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Travel literature"}}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Travelogs"}}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Travelogs"}}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Travel narratives"}}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Travel narratives"}}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Travelogues"}}, {"@id": "_:n83f1dac68f1f45aea9f575d694f1c57bb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Travelogues"}}], "@id": "/authorities/genreForms/gf2014026200"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026201", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrivia and miscellanea", "identifiers:lccn": "gf2014026201", "madsrdf:adminMetadata": [{"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b1"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trivia and miscellanea"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasSource": [{"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b5"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b6"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b7"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b8"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b9"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b10"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b11"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b12"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b13"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b14"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b15"}], "madsrdf:hasVariant": [{"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b16"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b19"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trivia and miscellanea"}}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "O'Neill, M. The best bar trivia book ever, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Chute, T. The Ohio State University trivia book, c2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lang, J.S. The complete book of presidential trivia, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bergstrom, S. The ultimate Jewish trivia book, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trivia a. With pl. and sing. concord. Trivialities, trifles, things of little consequence. b. Useless information or (knowledge of) matters of little importance. Freq. attrib., as trivia game, trivia question, etc. Chiefly U.S.; miscellanea 1a. As a mass noun: miscellaneous items, esp. literary compositions, that have been collected together, regarded collectively. b. A miscellaneous collection of items, esp. literary compositions, notes, or the like; a miscellany. Obs. 2. In pl. Literary materials of various kinds. Obs. rare.)"}, "madsrdf:citationSource": "Oxford English dictionary website, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Pastan, A. The Smithsonian book of air & space trivia, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Harry, L. The biggest trivia book ever, c2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Adams, D. The great American trivia book, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hoey, J. Minnesota Twins trivia, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trivia, noun plural but singular or plural in construction: unimportant facts or details; facts about people, events, etc., that are not well-known; miscellanea: a collection of miscellaneous objects or writings)"}, "madsrdf:citationSource": "Merriam-Webster online, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(--Miscellanea. UF --Questions and answers. Use as a form subdivision under subjects for compilations of unusual or miscellaneous facts about the subject without continuous text as well as for works in a question and answer format.)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trivia books"}}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trivia books"}}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Miscellaneous facts"}}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Miscellaneous facts"}}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Miscellanea"}}, {"@id": "_:n0e8911f7e0e34e8f9df6b2911065d8b0b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Miscellanea"}}], "@id": "/authorities/genreForms/gf2014026201"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026202", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrue adventure stories", "identifiers:lccn": "gf2014026202", "madsrdf:adminMetadata": [{"@id": "_:n1ced5a238fa2491392e15939607ace41b1"}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "True adventure stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1ced5a238fa2491392e15939607ace41b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026074"}, "madsrdf:hasSource": [{"@id": "_:n1ced5a238fa2491392e15939607ace41b5"}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b6"}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b7"}], "madsrdf:hasVariant": [{"@id": "_:n1ced5a238fa2491392e15939607ace41b8"}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b11"}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b14"}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Nonfiction accounts of exciting and/or dangerous pursuits or situations."}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T17:50:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "True adventure stories"}}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 25 (the men of adventure nonfiction; nonfiction adventure texts shape historical events into coherent, linear narrative; they legitimate their discourse with evidence; their authors necessarily intervene into the historical world, through interviews with people involved in the events the books recount and, sometimes, through participation in the events themselves; contemporary adventure nonfiction shows allegiance to a relatively narrow set of facts: verifiable locations, acts of nature, and people's visible responses to life-threatening situations) p. 21 (examples: Sebastian Junger's The perfect storm; Jon Krakauer's Into thin air; Mark Bowden's Black hawk down)"}, "madsrdf:citationSource": "Gallagher, M. Action figures, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ch. 1 (early travel narratives such as those by Marco Polo are precursors of what developed into the true adventure genre; true adventure subgenres: survival and disaster stories; cons and card games; war stories; intrigue and espionage; historical and exploration adventure)"}, "madsrdf:citationSource": "Cords, S.S. The real story: a guide to nonfiction reading interests, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(number of books tagged with term: true-adventure, 631; adventure-nonfiction, 161)"}, "madsrdf:citationSource": "Goodreads, Nov. 14, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ced5a238fa2491392e15939607ace41b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Adventure stories, True"}}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Adventure stories, True"}}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ced5a238fa2491392e15939607ace41b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Non-fiction adventure stories"}}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Non-fiction adventure stories"}}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ced5a238fa2491392e15939607ace41b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nonfiction adventure stories"}}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonfiction adventure stories"}}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ced5a238fa2491392e15939607ace41b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Adventure stories, Nonfiction"}}, {"@id": "_:n1ced5a238fa2491392e15939607ace41b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Adventure stories, Nonfiction"}}], "@id": "/authorities/genreForms/gf2014026202"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026203", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrue crime stories", "identifiers:lccn": "gf2014026203", "madsrdf:adminMetadata": [{"@id": "_:n44b33ca211454d3c8767ac0f79c76260b1"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "True crime stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n44b33ca211454d3c8767ac0f79c76260b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026074"}, "madsrdf:hasSource": [{"@id": "_:n44b33ca211454d3c8767ac0f79c76260b5"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b6"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b7"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b8"}], "madsrdf:hasVariant": [{"@id": "_:n44b33ca211454d3c8767ac0f79c76260b9"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b12"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b15"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b18"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b21"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b24"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Nonfiction crime narratives that are written in a novelistic style for popular audiences."}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T17:51:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "True crime stories"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 122 (True crime literature first flourished during the Elizabethan era with simple pamphlets detailing the exploits of local murders) pp. 123-24 (Thomas Duke's 1910 Celebrated criminal cases of America established true crime as a national genre in the Unites States--describing such events as the assassinations of Presidents Lincoln, Garfield and McKinley, the killing by a mob of Mormon leader Joseph Smith, the Haymarket riots of Chicago, the draft riots in New York City; Truman Capote's In cold blood led to the development of what we now know as true crime books-- thick paperbacks featuring the inevitable photo insert; the label of \"true\" crime gives the material in these books the aura of fact--an air of authority enhanced by the journalistic, \"non-literary\" style in which they are written, by the thick description of events, and by the inclusion of supporting photographic and other documentary evidence) pp. 125-26 (true crime books in the 1960s generally presented violence and evil as a threat from without, rather than within, the family; since the seventies, a greater number concern murders committed by those men who are entrusted with protecting and caring for women; in true crime books, fathers, and sometimes mothers, kill their children, and children kill their parents; most of all, women who are duped by the promise of romance are killed by their erstwhile lovers; true crime books are a popular arena for metaphysical discussions about the nature of evil)"}, "madsrdf:citationSource": "Cambridge companion to American crime fiction, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(true crime story: A nonfiction narrative in which the subject is an actual crime (murder, abduction, theft, etc.) so serious, bizarre, or inexplicable as to excite popular interest and curiosity. Unusual serial murders and murderers often receive book-length treatment.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xvi (True Crime)"}, "madsrdf:citationSource": "British crime writing : an encyclopedia, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(True crime stories. UF Crime narratives, Nonfiction; Crime narratives, True; Crime stories, True; Nonfiction crime narratives; True crime narratives. Here are entered works on nonfiction crime narratives, written in a novelistic style for a popular audience, frequently focusing on biography, criminal psychology, police investigations, and trial procedures.)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44b33ca211454d3c8767ac0f79c76260b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Non-fiction crime narratives"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Non-fiction crime narratives"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44b33ca211454d3c8767ac0f79c76260b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crime narratives, True"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crime narratives, True"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44b33ca211454d3c8767ac0f79c76260b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nonfiction crime narratives"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonfiction crime narratives"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44b33ca211454d3c8767ac0f79c76260b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "True crime literature"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "True crime literature"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44b33ca211454d3c8767ac0f79c76260b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crime stories, True"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crime stories, True"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44b33ca211454d3c8767ac0f79c76260b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crime narratives, Nonfiction"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crime narratives, Nonfiction"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44b33ca211454d3c8767ac0f79c76260b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "True crime narratives"}}, {"@id": "_:n44b33ca211454d3c8767ac0f79c76260b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "True crime narratives"}}], "@id": "/authorities/genreForms/gf2014026203"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026204", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTunnel books", "identifiers:lccn": "gf2014026204", "madsrdf:adminMetadata": [{"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb1"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tunnel books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026197"}, "madsrdf:hasSource": [{"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb5"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb6"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb7"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb8"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb9"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb10"}], "madsrdf:hasVariant": [{"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb11"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb14"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works bound at both sides, with accordion-style pages that are viewed through an opening in the cover."}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T17:51:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tunnel books"}}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tunnel books. UF Peep show books; Peepshow books. BT Toy and movable books)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Dance of the tunnel book (Tunnel books or peep shows are a series of cut-paper panels placed one behind the other, creating the illusion of depth and perspective)"}, "madsrdf:citationSource": "Smithsonian Libraries website search, 22 July 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tunnel book: A novelty book in which the pages are bound at both sides and separable accordion-style, allowing the user to look through an opening in the front page to view, as if in three dimensions, a scene depicted on subsequent pages. Synonymous with peepshow book. See also: carousel book; carousel book: A type of tunnel book that opens in a circle to reveal, in three dimensions, several scenes in the story)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "About us (tunnel books; inspired by Victorian paper toys, have intricately-cut layers attached to accordion sides)"}, "madsrdf:citationSource": "Tunnel Vision Books website, 22 July 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Pop-up book (under Pop-up types: Tunnel books (also called peepshow books) consist of a set of pages bound with two folded concertina strips on each side and viewed through a hole in the cover; the term \"tunnel book\" derives from the fact that many of these books were made to commemorate the building of the tunnel under the Thames River in London in the mid-19th century)"}, "madsrdf:citationSource": "Wikipedia, 22 July 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tunnel books; Peter Haining includes these \"toy books\" in Movable Books; peep shows; peepshows; peep show book; the tunnel or peep show book format)"}, "madsrdf:citationSource": "Hutchins, E.H. Exploring tunnel books, via WWW (Google cached site), July 22, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Peepshow books"}}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Peepshow books"}}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Carousel books"}}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Carousel books"}}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Peep-show books"}}, {"@id": "_:n91955ca467f44e5ca7df40d99c04cb1bb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Peep-show books"}}], "@id": "/authorities/genreForms/gf2014026204"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026205", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aUnion catalogs", "identifiers:lccn": "gf2014026205", "madsrdf:adminMetadata": [{"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb1"}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Union catalogs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026003"}, "madsrdf:hasSource": [{"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb5"}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb6"}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb7"}], "madsrdf:hasVariant": [{"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb8"}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb11"}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:13:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Union catalogs"}}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(union catalog: A list of the holdings of all the libraries in a library system, or of all or a portion of the collections of a group of independent libraries, indicating by name and/or location symbol which libraries own at least one copy of each item. When the main purpose of a union catalog is to indicate location, the bibliographic description provided in each entry may be reduced to a minimum, but when it also serves other purposes, description is more complete. The arrangement of a union catalog is normally alphabetical by author or title; union list: A complete list of the holdings of a group of libraries of materials (1) of a specific type, (2) on a certain subject, or (3) in a particular field, usually compiled for the purpose of resource sharing. The entry for each bibliographic item includes a list of codes representing the libraries owning at least one copy. Union lists are usually printed, but some have been converted into online databases)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(union catalogs. UF union catalogues. Catalogs the collections of all the libraries or other collections in a geographical area, group, or library system, presented in alphabetical sequence.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Union catalogs. See also subdivisions Union lists under types of printed or non-book materials, e.g. Italian imprints--Union lists; and Bibliography--Union lists under subjects, e.g. Technology--Bibliography--Union lists. UF Bibliography--Union lists; Catalogs, Union; Library catalogs--Union catalogs; Union lists. BT Library catalogs. Here are entered catalogs of materials held in two or more libraries.)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Union lists"}}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Union lists"}}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Union catalogues"}}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Union catalogues"}}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Union finding lists"}}, {"@id": "_:n8433a0e17d7f4bc0905abb5357fead3cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Union finding lists"}}], "@id": "/authorities/genreForms/gf2014026205"}
