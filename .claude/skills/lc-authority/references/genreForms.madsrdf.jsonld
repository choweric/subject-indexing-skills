.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n597af837fc9543a786929c6332a8948db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wine lists"}}, {"@id": "_:n597af837fc9543a786929c6332a8948db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wine list: a list of wines that are available to be served at a restaurant)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Aug. 18, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n597af837fc9543a786929c6332a8948db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Wine lists. UF Winelists. BT Lists. BT Menus)"}, "madsrdf:citationSource": "LCSH, Aug. 18, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n597af837fc9543a786929c6332a8948db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wine list: A list of the wines available in a restaurant)"}, "madsrdf:citationSource": "Oxford dictionaries website, Aug. 18, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n597af837fc9543a786929c6332a8948db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Menu and wine list for an event put on by the Wine and Food Society of San Francisco at the Jai Alai Basque Cafe on March 13, 1951)"}, "madsrdf:citationSource": "Work cat.: Wine and Food Society of San Francisco. La Sociedad de Vino y Comida, San Francisco, California, 1951", "madsrdf:citationStatus": "found"}, {"@id": "_:n597af837fc9543a786929c6332a8948db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(wine list: a list of the wines available in a particular restaurant, wine bar, etc)"}, "madsrdf:citationSource": "Collins English dictionary online, Aug. 18, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n597af837fc9543a786929c6332a8948db10", "@type": "madsrdf:Source", "madsrdf:citationSource": "81018117: Fellman, L.F. Merchandising by design : developing effective menus & wine lists, \u00a91981.", "madsrdf:citationStatus": "found"}, {"@id": "_:n597af837fc9543a786929c6332a8948db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(LCSH assigned: 1. Dinners and dining. 2. Wine lists.)"}, "madsrdf:citationSource": "97033781: Finigan, R. Which wine? : at-a-glance listings of the three best wines for every menu, every occasion, every budget, \u00a91997", "madsrdf:citationStatus": "found"}, {"@id": "_:n597af837fc9543a786929c6332a8948db12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n597af837fc9543a786929c6332a8948db13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Winelists"}}, {"@id": "_:n597af837fc9543a786929c6332a8948db13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Winelists"}}, {"@id": "_:n597af837fc9543a786929c6332a8948db15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n597af837fc9543a786929c6332a8948db16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lists of wines"}}, {"@id": "_:n597af837fc9543a786929c6332a8948db16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lists of wines"}}], "@id": "/authorities/genreForms/gf2017026086"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026087", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSongsters", "identifiers:lccn": "gf2017026087", "madsrdf:adminMetadata": [{"@id": "_:ndf44220a2efd474787afe7bcbf41e9eab1"}, {"@id": "_:ndf44220a2efd474787afe7bcbf41e9eab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Songsters"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndf44220a2efd474787afe7bcbf41e9eab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026005"}, "madsrdf:hasSource": [{"@id": "_:ndf44220a2efd474787afe7bcbf41e9eab5"}, {"@id": "_:ndf44220a2efd474787afe7bcbf41e9eab6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ndf44220a2efd474787afe7bcbf41e9eab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-08-03T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ndf44220a2efd474787afe7bcbf41e9eab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-13T11:41:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndf44220a2efd474787afe7bcbf41e9eab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Songsters"}}, {"@id": "_:ndf44220a2efd474787afe7bcbf41e9eab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Songster (i); (An anthology of secular song lyrics, popular, traditional or topical (occasionally with melody lines), designed to fit in the pocket)"}, "madsrdf:citationSource": "Grove music online, Aug. 8, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf44220a2efd474787afe7bcbf41e9eab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2017411506: Idishe re\u1e7folutsyonere lider. New York, N.Y. : Red Star Publicity Service, 1932.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026087"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026088", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDrawing-room drama", "identifiers:lccn": "gf2017026088", "madsrdf:adminMetadata": [{"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb1"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Drawing-room drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026294"}, "madsrdf:hasSource": [{"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb5"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb6"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb7"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb8"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb9"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb10"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb11"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb12"}], "madsrdf:hasVariant": {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb13"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that take place in a domestic setting such as a drawing or living room and examine middle-class concerns and values."}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-03T13:39:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-08-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drawing-room drama"}}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Drawing-room play. Fr.: com\u00e9die de salon; Ger.: Salonst\u00fcck, Konversationsst\u00fcck; Sp.: comedia de sal\u00f3n. The drawing-room play shows characters talking, often in a middle-class living room. Its comedy is verbal, subtle and witty, with authorial interventions. The action is confined to an exchange of agreeably formulated ideas, arguments or nasty remarks (for example, Wilde, Maugham, Schnitzler).)"}, "madsrdf:citationSource": "Pavis, P. Dictionary of the theatre, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Besant, W. The charm and other drawing-room plays, 1897?", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "drawing-room drama (A late Victorian genre characterized by respectable domestic settings and the examination of middle-class concerns and values. Similar works written by Tom Robertson became known as cup-and-saucer drama. Other British playwrights associated with the genre included Arthur Wing Pinero and H.A. Jones) cup-and-saucer drama (In the late 19th century, a realistic drawing-room drama that dealt with contemporary social issues. The term was first applied to the works of Tom Robertson, whose play Society (1865) introduced a new realism to the London stage in the era of melodrama. The popularity of his Caste (1867) helped to ensure that a more naturalistic style of acting would permanently replace the bombastic delivery and sweeping gestures of the earlier Victorian stage)"}, "madsrdf:citationSource": "The Methuen Drama dictionary of the theatre, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wills, W.G. Drawing room dramas, 1873.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(drawing-room drama: A play that takes place largely in a genteel domestic setting, typically examining middle-class values)"}, "madsrdf:citationSource": "The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "drawing-room drama (Dramas, collectively or individually, which depict the social life of well-to-do persons in a drawing-room or similar setting) cup-and-saucer drama (A drawing-room drama, typically marked by the serving of tea and consequently by very little bustling stage movement; also collectively. Usually derogatorily, as originally of Robertson's plays of the 1860s)"}, "madsrdf:citationSource": "Bowman, W.P. Theatre language, 1961:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xxxi (natural acting which completely revolutionized the then existing methods; \"tea-cup-and-saucer\" and \"bread-and-butter\" school; its influence has never diminished; Pinero and other prominent dramatists of to-day gladly owe their indebtedness to Robertson)"}, "madsrdf:citationSource": "Work cat.: Robertson, T.W. Society ; and Caste, 1905:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sketchley, A. Money makes the man : a drawing-room drama in one act, 191-?", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cup-and-saucer drama"}}, {"@id": "_:n1e72992935c544a8a5d09e0fe864e82cb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cup-and-saucer drama"}}], "@id": "/authorities/genreForms/gf2017026088"}
