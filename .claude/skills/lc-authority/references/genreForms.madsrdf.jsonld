{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026811", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGazetteers", "identifiers:lccn": "gf2011026811", "madsrdf:adminMetadata": [{"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab1"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gazetteers"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026113"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}], "madsrdf:hasSource": [{"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab5"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab6"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab7"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab8"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab9"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab10"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab11"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab12"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab13"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab14"}], "madsrdf:hasVariant": [{"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab15"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab18"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab21"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab24"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab27"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab30"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026608"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-02-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-10T10:52:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gazetteers"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A gazetteer is a geographical dictionary or directory, an important reference for information about places and place names, used in conjunction with a map or a full atlas. It typically contains information concerning the geographical makeup of a country, region, or continent as well as the social statistics and physical features, such as mountains, waterways, or roads. Examples of information provided by gazetteers include the location of places, dimensions of physical features, population, GDP, literacy rate, etc. This information is generally divided into overhead topics with entries listed in alphabetical order. ... Gazetteers are often categorized by the type, and scope, of the information presented. World gazetteers usually consist of an alphabetical listing of countries, with pertinent statistics for each one, with some gazetteers listing information on individual cities, towns, villages, and other settlements of varying sizes. Short-form gazetteers, often used in conjunction with computer mapping and GIS systems, may simply contain a list of place-names together with their locations in latitude and longitude or other spatial referencing systems (e.g. British National Grid reference). Short-form gazetteers appear as a place-name index in the rear of major published atlases. Descriptive gazetteers may include lengthy textual descriptions of the places they contain, including explanation of industries, government, geography, together with historical perspectives, maps and/or photographs. Thematic gazetteers list places or geographical features by theme; for example fishing ports, nuclear power stations, or historic buildings.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 30, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Gazetteer of Yukon, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cambridge world gazetteer : a geographical dictionary, c1988.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gazetteers. Historically, gazetteers served as indexes to place names on map sheets or maps in atlases; in its digital incarnation, a gazetteer serves a similar role as an aid for information retrieval; one of the most widely used and known gazetteers in the U.S. is the Geographic Names Information System (GNIS) - a digital gazetteer; in their digital form, gazetteers are extremely useful for a range of geospatial search functions)"}, "madsrdf:citationSource": "Encyclopedia of geography, c2010", "madsrdf:citationStatus": "found"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(gazetteer 3: a geographical dictionary in which names and descriptions of places are usu. given in alphabetical order)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(gazetteer 1. A geographic dictionary or index. 2. Archaic. A writer for a gazette; a journalist)"}, "madsrdf:citationSource": "The American heritage dict. of the Engl. lang., c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Collins Britain atlas and gazetteer, c1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Domestic and Antarctic names - state and topical gazetteer download files, via U.S. Board on Geographic Names website, Nov. 30, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Clark, A.N. The Penguin dict. of geog., 2003;Witherick, M. A modern dict. of geog., 2001", "madsrdf:citationStatus": "notfound"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab14", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Columbia gazetteer of the world, c1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographic dictionaries (Gazetteers)"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographic dictionaries (Gazetteers)"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographical dictionaries (Gazetteers)"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographical dictionaries (Gazetteers)"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indexes, Geographical (Gazetteers)"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indexes, Geographical (Gazetteers)"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dictionaries, Geographical (Gazetteers)"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dictionaries, Geographical (Gazetteers)"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographic indexes (Gazetteers)"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographic indexes (Gazetteers)"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographical indexes (Gazetteers)"}}, {"@id": "_:ne23e80b0879a4f57b50dfada8f21d88ab31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographical indexes (G