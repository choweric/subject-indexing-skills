, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-09-23T11:19:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epicedia (Music)"}}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epicedium pl. epicedia: a funeral ode or hymn; dirge"}, "madsrdf:citationSource": "Yourdictionary.com, Oct. 1, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "92217265: The pseudo-Ovidian Ad Liviam de morte Drusi (Consolatio ad Liviam, Epicedium Drusi), c1992.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: In obitum ornatissimi viri, D. Georgii Campbelli, S.S. theologi\u00e6 professoris apud Edinburgenses, epicedium, 1701.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "77030423: Donne, J. The epithalamions, anniversaries, and epicedes, 1978.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epicedium (plural epicedia): a funeral ode; originally in the anglicized form epicede)"}, "madsrdf:citationSource": "Oxford dictionaries website, Oct. 1, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Chapman, G. An epicede or funerall song : on the most disastrous death, of the high-borne prince of men, Henry Prince of Wales, &c., 1612.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "75550014: Hankins, O.B. Leibniz as baroque poet : an interpretation of his German epicedium on the death of Queen Sophie Charlotte, 1973.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Zab\u0142ocki, S. Polsko-\u0142acinskie epicedium renesansowe na tle europejskim, 1968.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epicedium. A song of mourning in praise of the dead, sung in the presence of the corpse and distinguished from threnos, a dirge, which was not limited by time or place. The word does not occur before the Alexandrian period, or in Lat. before Statius (1st c. CE), although the lamentations over the bodies of Hector and Achilles in Homer are, properly speaking, epicedia. The epicedium became very popular in the Hellenistic period and was widely imitated in Lat. lit. It was accompanied by a solemn dance with music provided by a flute in the Lydian mode. Written originally in a variety of meters, it was confined after the cl. period entirely to elegiac distichs and hexameters. Epicedia also included lamentations in verse for pet animals and birds.)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "95125945: Epic\u00e9dium a Balassi fiv\u00e9rek, B\u00e1lint \u00e9s Ferenc hal\u00e1l\u00e1ra, 1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "jacket (the neglected genre of the epicedium (funeral poem))"}, "madsrdf:citationSource": "Linton, A. Poetry and parental bereavement in early modern Lutheran Germany, c2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b16", "@type": "madsrdf:Source", "madsrdf:citationSource": "96110076: Epicedia Universitatis Oxoniensis in obitum illustrissimae principis Annae Ducissae Eboracensis, 1671.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b17", "@type": "madsrdf:Source", "madsrdf:citationSource": "Niccols, R. Expicedium [sic] : a funeral oration, vpon the death of the late deceased Princesse of famous memorye, Elizabeth by the grace of God, Queen of England, France and Ireland, 1603.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Epicedium (Latin) is a funeral song directed to and read before the corpse. Originally it was written in elegiac couplets but with time, the epicedium was written using other frames. It is the theme that identifies the genre, the tone is mournful.)"}, "madsrdf:citationSource": "Poetry magnum opus website, Oct. 1, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(epicedium plural epicedia: a funeral song; dirge. Related forms: epicedial, epicedian, adjective)"}, "madsrdf:citationSource": "Dictionary.com, Oct. 1, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5334b55f483a42d4a2152fa212602519b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epicediums (Music)"}}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epicediums (Music)"}}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5334b55f483a42d4a2152fa212602519b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epicedes (Music)"}}, {"@id": "_:n5334b55f483a42d4a2152fa212602519b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epicedes (Music)"}}], "@id": "/authorities/genreForms/gf2014026789"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026790", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEpic songs", "identifiers:lccn": "gf2014026790", "madsrdf:adminMetadata": [{"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b1"}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Epic songs"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026961"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026780"}, "madsrdf:hasSource": {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b5"}, "madsrdf:hasVariant": [{"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b6"}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b9"}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Lengthy narrative songs, generally from an oral tradition, involving specialist bards."}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:02:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epic songs"}}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Garland encyclopedia of world music. Vol. 8, Europe (epic. a long narrative poem recounting the feats of a historical or legendary hero and usually sung in formal settings)", "madsrdf:citationStatus": "found"}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oral epics (Songs)"}}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oral epics (Songs)"}}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Heroic songs"}}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heroic songs"}}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epics (Songs)"}}, {"@id": "_:ncde41a8501fe47bc8dbeab1121cc8203b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epics (Songs)"}}], "@id": "/authorities/genreForms/gf2014026790"}
