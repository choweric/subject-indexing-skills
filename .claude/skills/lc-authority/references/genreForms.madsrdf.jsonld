n", "@value": "Medical statistics"}}, {"@id": "_:n7388c498c922427c83e426064cb31c12b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Biostatistics: a narrow definition is 'the branch of science which applies statistical method to biological problems'. More commonly, however, also includes statistics applied to medicine and health science)"}, "madsrdf:citationSource": "Cambridge Dictionary of Statistics, online, viewed May 28, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7388c498c922427c83e426064cb31c12b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Medical statistics. UF Health statistics. BT Statistics)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n7388c498c922427c83e426064cb31c12b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Medical statistics deals with applications of statistics to medicine and the health sciences, including epidemiology, public health, forensic medicine, and clinical research)"}, "madsrdf:citationSource": "\"Medical statistics\" in Wikipedia, viewed June 3, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n7388c498c922427c83e426064cb31c12b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(WHO's annual World Health Statistics reports present the most recent health statistics for the WHO Member States)"}, "madsrdf:citationSource": [{"@id": "https://www.who.int/gho/publications/world_health_statistics/en/"}, "Work cat: World health statistics"], "madsrdf:citationStatus": "found"}, {"@id": "_:n7388c498c922427c83e426064cb31c12b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7388c498c922427c83e426064cb31c12b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Health statistics"}}, {"@id": "_:n7388c498c922427c83e426064cb31c12b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Health statistics"}}], "@id": "/authorities/genreForms/gf2019026082"}
