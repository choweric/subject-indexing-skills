{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026231", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEthnic television programs", "identifiers:lccn": "gf2011026231", "madsrdf:adminMetadata": [{"@id": "_:n854cd262f46c42678ecd2f99972e6be9b1"}, {"@id": "_:n854cd262f46c42678ecd2f99972e6be9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ethnic television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n854cd262f46c42678ecd2f99972e6be9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasSource": [{"@id": "_:n854cd262f46c42678ecd2f99972e6be9b5"}, {"@id": "_:n854cd262f46c42678ecd2f99972e6be9b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that are made by or intended for a specific ethnic audience and that often feature ethnic experiences.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025609"}}, {"@id": "_:n854cd262f46c42678ecd2f99972e6be9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n854cd262f46c42678ecd2f99972e6be9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T13:45:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n854cd262f46c42678ecd2f99972e6be9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnic television programs"}}, {"@id": "_:n854cd262f46c42678ecd2f99972e6be9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(archives article, Newscasts in Tagaglog and songs in Gaelic: Ethnic television programming has grown tremendously in recent years, accounting for 10 percent of all new cable networks that have been announced since 1993)"}, "madsrdf:citationSource": "New York times online, December 3, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n854cd262f46c42678ecd2f99972e6be9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ethnic (Nonfiction): work that focuses on issues and individuals relating to the American ethnic experience. Ethnic: Fictional work typically made for viewing by ethnic audiences, most prominently African American, Yiddish, and Latino. Similar work has also been made in much smaller quantities for such groups as Ukrainian, Armenian, Italian, Greek, Polish, Japanese, Chinese, Vietnamese, and Native Americans...Fictional narratives typically present situations unique to the specific group, and are often based on classical ethnic plays and stories, or feature performers who are stars within their community, but may not be as well known to a broader public...The designation of this genre term does not necessarily connote the veracity of the portrayals, but rather, indicates the main focus of the subject matter)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 3, 2007", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026231"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026232", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEthnographic films", "identifiers:lccn": "gf2011026232", "madsrdf:adminMetadata": [{"@id": "_:ne530214537084157a83bbcb5427fcb4db1"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ethnographic films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne530214537084157a83bbcb5427fcb4db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026205"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026013"}], "madsrdf:hasSource": [{"@id": "_:ne530214537084157a83bbcb5427fcb4db5"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db6"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db7"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db8"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db9"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db10"}], "madsrdf:hasVariant": [{"@id": "_:ne530214537084157a83bbcb5427fcb4db11"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025002"}}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-16T09:48:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnographic films"}}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (\"A film about a Dogon funeral and enthronement ritual.\")"}, "madsrdf:citationSource": "A l'ombre du soleil [VR] 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Describes a photographic and ethnographic study which was sponsored by the Peabody Museum from Feb. 1961 to Nov. 1963 of the Dani, a people dwelling in the Grand Valley of the Baliem, high in the mountains of West New Guinea)"}, "madsrdf:citationSource": "Work cat.: Dead birds [VR] 199-, c1964", "madsrdf:citationStatus": "found"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ethnographic. Nonfiction work documenting specific cultures or types of peoples, including field footage by cultural anthropologists or researchers and edited, analytical work seeking to understand the beliefs, customs, and social systems of various cultures or ethnic groups. Note: Do not use for general histories or analyses of man. For superficial appearances of cultures in work focusing on travel and places, use Travelogue. Not necessary to also use Documentary, since that is implied by the term Ethnographic. Film examples: The ax fight; The holy ghost people; Nanook of the North; The Nuer)"}, "madsrdf:citationSource": "Taves, B. The moving image genre-form guide, via WWW, Mar. 27, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 79 (subcategory Ethnographic Film (Anthropological Film, Nature Film) in category Documentary. Ethnographic films deal with the cultural and sociological aspects of different peoples. They may focus on primitive or modern societies, but they always seek to fathom the beliefs and societal systems by which the societies operate so that others may learn to understand them. In this respect, they are different from most travel films which concentrate superficially on a cultural group or on its most glamorous aspects)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anthropological works. Use for nonfiction film or video whose subject is or prominently includes the study of man, his physical character, races, environmental and social relations, and culture. Use to describe field footage generated by anthropologists for study and research purposes. UF Ethnographic works. BT Documentaries and factual works)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (\"An ethnographic film about the observance of Shi\u02bbite Muharram rites on the island of Trinidad\")"}, "madsrdf:citationSource": "Hosay Trinidad [VR] 1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne530214537084157a83bbcb5427fcb4db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anthropological films"}}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anthropological films"}}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne530214537084157a83bbcb5427fcb4db15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ethnological films"}}, {"@id": "_:ne530214537084157a83bbcb5427fcb4db15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnological films"}}], "@id": "/authorities/genreForms/gf2011026232"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026233", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aEthnographic television programs", "identifiers:lccn": "gf2011026233", "madsrdf:adminMetadata": [{"@id": "_:ne7538ab0f176441e841878fb7a6647ddb1"}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ethnographic television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne7538ab0f176441e841878fb7a6647ddb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026207"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026013"}], "madsrdf:hasSource": [{"@id": "_:ne7538ab0f176441e841878fb7a6647ddb5"}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb6"}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb7"}], "madsrdf:hasVariant": [{"@id": "_:ne7538ab0f176441e841878fb7a6647ddb8"}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025291"}}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-16T09:48:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnographic television programs"}}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ethnographic. Nonfiction work documenting specific cultures or types of peoples, including field footage by cultural anthropologists or researchers and edited, analytical work seeking to understand the beliefs, customs, and social systems of various cultures or ethnic groups. Note: Do not use for general histories or analyses of man. For superficial appearances of cultures in work focusing on travel and places, use Travelogue. Not necessary to also use Documentary, since that is implied by the term Ethnographic. TV examples: An American family; Bushmen of the Kalahari)"}, "madsrdf:citationSource": "Taves, B. The moving image genre-form guide, via WWW, Mar. 27, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 79 (subcategory Ethnographic Film (Anthropological Film, Nature Film) in category Documentary. Ethnographic films deal with the cultural and sociological aspects of different peoples. They may focus on primitive or modern societies, but they always seek to fathom the beliefs and societal systems by which the societies operate so that others may learn to understand them. In this respect, they are different from most travel films which concentrate superficially on a cultural group or on its most glamorous aspects)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Anthropological works. Use for nonfiction film or video whose subject is or prominently includes the study of man, his physical character, races, environmental and social relations, and culture. Use to describe field footage generated by anthropologists for study and research purposes. UF Ethnographic works. BT Documentaries and factual works)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7538ab0f176441e841878fb7a6647ddb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ethnological television programs"}}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnological television programs"}}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7538ab0f176441e841878fb7a6647ddb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anthropological television programs"}}, {"@id": "_:ne7538ab0f176441e841878fb7a6647ddb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anthropological television programs"}}], "@id": "/authorities/genreForms/gf2011026233"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026234", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExecutive orders", "identifiers:lccn": "gf2011026234", "madsrdf:adminMetadata": [{"@id": "_:n9905546bbd7544a19d80a587404738c7b1"}, {"@id": "_:n9905546bbd7544a19d80a587404738c7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Executive orders"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9905546bbd7544a19d80a587404738c7b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026351"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasReciprocalAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026030"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026432"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026467"}], "madsrdf:hasSource": {"@id": "_:n9905546bbd7544a19d80a587404738c7b5"}, "madsrdf:hasVariant": {"@id": "_:n9905546bbd7544a19d80a587404738c7b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025105"}}, {"@id": "_:n9905546bbd7544a19d80a587404738c7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9905546bbd7544a19d80a587404738c7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T13:48:18"}, "ri:recordCont