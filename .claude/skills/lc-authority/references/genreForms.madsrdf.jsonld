ordStatus": "revised"}, {"@id": "_:n847c8b7d96a74e99ae6f6311a11531b9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television pilot programs"}}, {"@id": "_:n847c8b7d96a74e99ae6f6311a11531b9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 75 (Pilot programs: use for the first program in a series or serial, so-called because the pilot program is broadcast as a trial to see if the series or serial will be watched. May be longer than later episodes)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n847c8b7d96a74e99ae6f6311a11531b9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Television pilot: Initial episode of a possible series, designed to showcase the show's possibilities for audiences and sponsors)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 6, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n847c8b7d96a74e99ae6f6311a11531b9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 426-427 (Pilot: a sample program on film or tape, of a projected TV series, usually created as a first episode, but in any case establishing the continuing characters, the character relationships, the essential situations, and the style of the proposed series)"}, "madsrdf:citationSource": "Brown, L. Encyclopedia of television, 3rd ed., c1992:", "madsrdf:citationStatus": "found"}, {"@id": "_:n847c8b7d96a74e99ae6f6311a11531b9b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n847c8b7d96a74e99ae6f6311a11531b9b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pilots (Television programs)"}}, {"@id": "_:n847c8b7d96a74e99ae6f6311a11531b9b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pilots (Television programs)"}}, {