{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026548", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRubble films", "identifiers:lccn": "gf2011026548", "madsrdf:adminMetadata": [{"@id": "_:n00e6dc5824e44dd7a4c126229cbdecfab1"}, {"@id": "_:n00e6dc5824e44dd7a4c126229cbdecfab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rubble films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n00e6dc5824e44dd7a4c126229cbdecfab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n00e6dc5824e44dd7a4c126229cbdecfab5"}, {"@id": "_:n00e6dc5824e44dd7a4c126229cbdecfab6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films produced in the years after World War II that often feature exteriors in bombed-out cities.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025550"}}, {"@id": "_:n00e6dc5824e44dd7a4c126229cbdecfab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n00e6dc5824e44dd7a4c126229cbdecfab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:04:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n00e6dc5824e44dd7a4c126229cbdecfab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {