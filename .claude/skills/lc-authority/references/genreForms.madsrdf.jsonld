{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026049", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aComics journalism", "identifiers:lccn": "gf2023026049", "madsrdf:adminMetadata": [{"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb1"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Comics journalism"}, "madsrdf:elementList": {"@list": [{"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb3"}]}, "madsrdf:exampleNote": "Note under [Documentary comics]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026453"}, "madsrdf:hasSource": [{"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb5"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb6"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb7"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb8"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb9"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb10"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb11"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb12"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb13"}], "madsrdf:hasVariant": [{"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb14"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb17"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb20"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb23"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb26"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb29"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb32"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb35"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb38"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb41"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb44"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb47"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb50"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb53"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb56"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb59"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb62"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb65"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb68"}], "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that employ journalistic techniques, such as interviews, to report on news or nonfiction topics. For comics intended to document reality to instruct, educate, or maintain a historical record, see [Documentary comics.]"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-11T12:18:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-05-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comics journalism"}}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "back cover (The brilliant first collection of graphic journalism by artist and activist Victoria Lomasko. Lomasko illuminates the inequality and injustice at the heart of contemporary Russian society. She interviews sex workers in foundering industrial towns; teaching art to children at juvenile prisons--all while drawing their stories\") (OCoLC)978349453"}, "madsrdf:citationSource": "Work cat: Lomasko, V. Other Russias, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 42 (journalistic comics \"are sometimes wrongly equated with 'documentary comics.' But while documentary 'is about the presentation of evidence' ... the journalistic form of reportage negotiates between 'artistically reshaped journalism and journalistically legitimized art'\") (OCoLC)126374326"}, "madsrdf:citationSource": "Schlichting, L. Authorship in comics journalism, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Comics has also been fruitfully employed to materialize the experiences of others, often from marginalized groups. Graphic narrative forms a long-standing tradition of addressing 'realities' that precedes the current format of the graphic reportage. Comics have been analyzed and theorized as works of documentary ..., history ... and journalism\")"}, "madsrdf:citationSource": "Schlichting, L. Introduction to graphic realities : comics as documentary, history, and journalism, in ImageText v. 11, iss. 1, 2019, viewed May 18, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Comics journalism 37%; Graphic journalism 16%; Graphic reportage 6%; Journalistic comics 4%; Cartoon journalism 1%)"}, "madsrdf:citationSource": "Google Books NGram Viewer, viewed May 4, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Still alive documents the conditions, experiences and deprivations of Australia's system of mandatory and indefinite detention for asylum seekers and refugees.\") (OCoLC)1338300517"}, "madsrdf:citationSource": "Ahmed, S. Still alive : graphic reportage from Australia's immigration detention system, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"A journalistic collection in comic book format from the sidelines of wars around the world) (OCoLC)711052145"}, "madsrdf:citationSource": "Sacco, J. Journalism, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"The Washington Post illustrated reporting page gathers past and present graphic stories from the paper\"; \"The Washington Post created a page on their website dedicated to comics journalism\")"}, "madsrdf:citationSource": "Degg, D.D. WaPo has new illustrated reporting page, May 17, 2023, via The daily cartoonist, viewed May 19, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Comics journalism (Other terms for the practice include 'graphic journalism,' 'comic strip journalism,' 'cartoon journalism,' 'cartoon reporting,' 'comics reportage,' 'journalistic comics' and 'sketchbook reports'\")"}, "madsrdf:citationSource": "Wikipedia, viewed May 4, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 65 (\"the term comics journalism (also referred to as 'graphic journalism' or 'graphic reporting/reportage') was first used in the mid-1990s by Maltese American cartoonist Joe Saco\"; \"this genre has become an increasingly popular way to bear witness to a range of socio-political events and circumstances, with a focus on the experiences of ordinary, subaltern people in crisis situations\"; \"most graphic journalists include themselves as a character, thus emphasizing the interpretative nature of all journalistic processes\")"}, "madsrdf:citationSource": "Key Terms in comics studies, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Journalism, Graphic (Comics)"}}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Journalism, Graphic (Comics)"}}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cartoon reporting"}}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cartoon reporting"}}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graphic reportage (Comics)"}}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic reportage (Comics)"}}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cartoon journalism"}}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb24", "@type": "m