//id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n93d2f6e69f114448975df16b3527e1ccb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n93d2f6e69f114448975df16b3527e1ccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Disaster films"}}, {"@id": "_:n93d2f6e69f114448975df16b3527e1ccb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Disaster Film (Catastrophe Film); disaster movies. In the disaster film proper, the disaster (earthquake, fire, volcanic eruption, air crash, shipwreck) is the core of the film. Disaster films examine human character and behavior in situations of extreme danger and stress. Two subgenres listed: Man-Made Disaster Films; Natural Disaster Films)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n93d2f6e69f114448975df16b3527e1ccb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "genre list (disaster drama)"}, "madsrdf:citationSource": "Moving image materials:", "madsrdf:citationStatus": "found"}, {"@id": "_:n93d2f6e69f114448975df16b3527e1ccb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Disaster films)"}, "madsrdf:citationSource": "LCSH, May 1, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n93d2f6e69f114448975df16b3527e1ccb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "index (Disaster films)"}, "madsrdf:citationSource": "NYT encyc. of film, 1984:", "madsrdf:citationStatus": "found"}, {"@id": "_:n93d2f6e69f114448975df16b3527e1ccb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(disaster film)"}, "madsrdf:citationSource": "Beaver, F. Dict. of film terms, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n93d2f6e69f114448975df16b3527e1ccb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n93d2f6e69f114448975df16b3527e1ccb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Disaster movies"}}, {"@id": "_:n93d2f6e69f114448975df16b3527e1ccb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Disaster movies"}}, {"@id": "_:n93d2f6e69f114448975df16b3527e1ccb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n93d2f6e69f114448975df16b3527e1ccb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Catastrophe films"}}, {"@id": "_:n93d2f6e69f114448975df16b3527e1ccb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Catastrophe films"}}], "@id": "/authorities/genreForms/gf2011026200"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026201", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDisaster television programs", "identifiers:lccn": "gf2011026201", "madsrdf:adminMetadata": [{"@id": "_:nf72ae1639e414767a0c762b16b664376b1"}, {"@id": "_:nf72ae1639e414767a0c762b16b664376b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Disaster television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf72ae1639e414767a0c762b16b664376b3"}]}, "madsrdf:exampleNote": "Note under [Survival television programs]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026627"}, "madsrdf:hasSource": {"@id": "_:nf72ae1639e414767a0c762b16b664376b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that feature a man-made or natural calamity that places people in imminent danger. For television programs that feature individuals or groups struggling for their lives in a harsh setting see [Survival television programs.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025224"}}, {"@id": "_:nf72ae1639e414767a0c762b16b664376b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T09:36:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf72ae1639e414767a0c762b16b664376b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nf72ae1639e414767a0c762b16b664376b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Disaster television programs"}}, {"@id": "_:nf72ae1639e414767a0c762b16b664376b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(disaster: Fictional work depicting a large-scale natural or man-made calamity, such as an airplane crash or a wreck at sea, that isolates a group of people in imminent danger. They must devise at least part of their method of escape (sometimes outside assistance awaits) with only minimal materials at hand; related term: survival)"}, "madsrdf:citationSource": "Moving image genre-form guide online, May 1, 2007:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026201"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026202", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDisc jockey radio programs", "identifiers:lccn": "gf2011026202", "madsrdf:adminMetadata": [{"@id": "_:n23222e935e32441daf8c9dbbe6549f58b1"}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Disc jockey radio programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n23222e935e32441daf8c9dbbe6549f58b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026506"}, "madsrdf:hasSource": [{"@id": "_:n23222e935e32441daf8c9dbbe6549f58b5"}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b6"}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b7"}], "madsrdf:hasVariant": [{"@id": "_:n23222e935e32441daf8c9dbbe6549f58b8"}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b11"}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Radio programs in which a host introduces and plays recorded music.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025635"}}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T13:40:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Disc jockey radio programs"}}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Disc jockey programs: Music programs in which a radio host plays records; these do not feature live music. Examples: Music you want when you want it, Caravana tropical, To be perfectly Frank)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Dec. 7, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "disc jockey (\"Disc jockey programs became the economic base of many radio stations ... after World War II. The format generally involves one person, the disc jockey, introducing and playing phonograph records and chatting informally and usually extemporaneously in the intervals.\")"}, "madsrdf:citationSource": "Encyc. Britannica online, Dec. 7, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(disk jockey radio: 383 hits; disc jockey radio: 774 hits; hits on disc jockey, disk jockey, DJ radio, deejay radio)"}, "madsrdf:citationSource": "Google, March 28, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n23222e935e32441daf8c9dbbe6549f58b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "DJ radio programs"}}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "DJ radio programs"}}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n23222e935e32441daf8c9dbbe6549f58b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Deejay radio programs"}}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Deejay radio programs"}}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n23222e935e32441daf8c9dbbe6549f58b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Disk jockey radio programs"}}, {"@id": "_:n23222e935e32441daf8c9dbbe6549f58b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Disk jockey radio programs"}}], "@id": "/authorities/genreForms/gf2011026202"}
