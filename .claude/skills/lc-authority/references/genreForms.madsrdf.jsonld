"madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4a84666fd6e4f609950d196e820f6c9b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "LaRue, C.C. Making it big : sex stars, porn films, and me, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4a84666fd6e4f609950d196e820f6c9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sex exploitation film (Porn film/Pornie/Porno film/Pornographic film/Skin flick/Skinpic/Sexploitation film/Sexploiter). The sex exploitation film is a type of exploitation movie that, as the name indicates, exploits the subject of sex for monetary gain)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4a84666fd6e4f609950d196e820f6c9b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the San Fernando Valley, where many porn films are produced)"}, "madsrdf:citationSource": "Enforcing condoms in porn films won't be easy, L.A. supervisors say, in Los Angeles times online, July 11, 2012, viewed on July 13, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4a84666fd6e4f609950d196e820f6c9b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pornography: Work representing persons engaged in explicit, usually unfaked, sexual acts with a primary intent of arousing viewers; RT erotic)"}, "madsrdf:citationSource": "Moving image genre-form guide online, Jan. 7, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4a84666fd6e4f609950d196e820f6c9b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pornographic films; adult films)"}, "madsrdf:citationSource": "Medina, J. Los Angeles vote to decide on condoms in sex films, in New York times online, Dec. 28, 2011, viewed on July 13, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4a84666fd6e4f609950d196e820f6c9b14", "@ty