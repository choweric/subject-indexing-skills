{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027219", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aArtist files", "identifiers:lccn": "gf2017027219", "madsrdf:adminMetadata": [{"@id": "_:na7603ccca5094339a712c371e87e6ca8b1"}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Artist files"}, "madsrdf:elementList": {"@list": [{"@id": "_:na7603ccca5094339a712c371e87e6ca8b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026163"}], "madsrdf:hasSource": [{"@id": "_:na7603ccca5094339a712c371e87e6ca8b5"}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b6"}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b7"}], "madsrdf:hasVariant": [{"@id": "_:na7603ccca5094339a712c371e87e6ca8b8"}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Collections of materials relating primarily to individual artists, artist collectives, collectors, art historians, curators, cultural institutions, art events, etc."}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Artist files"}}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(artist files; variants: artist file; artists files; files, artist; note: Materials relating primarily to individual visual artists, artist collectives, collectors, art historians, and curators, including announcements, architectural drawings, photographs, auction catalogs, biographical information, books, brochures, correspondence, exhibition catalogs, institutional publications, interviews, invitations, manuscripts, memorabilia, negatives, newspapers, official records, oral histories, pamphlets, postcards, posters, press releases, price lists, and any number of other types of materials related to artists.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, August 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 4 (collections of small-sized documents related to the visual arts that are collected and arranged for the purpose of research. Artist files consist of the following variety of materials: announcements, architectural drawings, artist statements, artworks, auction catalogs, brochures, checklists, commercial gallery catalogs, clippings, cultural artifacts, diaries, digital files, exhibition catalogs, institutional publications, interviews, invitations, journals, mail art, manifestos, manuscripts, maps, memorabilia, microform, negatives, oral histories, pamphlets, photographs, postcards, posters, press releases, price lists, prints, private view cards, resumes, scripts, serials, slides, and transcripts.)"}, "madsrdf:citationSource": "Artist files revealed, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCSH, August 14, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7603ccca5094339a712c371e87e6ca8b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Artists' files"}}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Artists' files"}}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7603ccca5094339a712c371e87e6ca8b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Files, Artist"}}, {"@id": "_:na7603ccca5094339a712c371e87e6ca8b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Files, Artist"}}], "@id": "/authorities/genreForms/gf2017027219"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027220", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aArtists' books", "identifiers:lccn": "gf2017027220", "madsrdf:adminMetadata": [{"@id": "_:n951f066397b04b3caa434727defdfdecb1"}, {"@id": "_:n951f066397b04b3caa434727defdfdecb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Artists' books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n951f066397b04b3caa434727defdfdecb3"}]}, "madsrdf:exampleNote": "Note under [Book objects]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027218"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026021"}, "madsrdf:hasSource": [{"@id": "_:n951f066397b04b3caa434727defdfdecb5"}, {"@id": "_:n951f066397b04b3caa434727defdfdecb6"}], "madsrdf:hasVariant": [{"@id": "_:n951f066397b04b3caa434727defdfdecb7"}, {"@id": "_:n951f066397b04b3caa434727defdfdecb10"}, {"@id": "_:n951f066397b04b3caa434727defdfdecb13"}, {"@id": "_:n951f066397b04b3caa434727defdfdecb16"}, {"@id": "_:n951f066397b04b3caa434727defdfdecb19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Books that are produced by artists and intended as visual art objects. For sculptural works that mimic the format or structure of the book, see [Book objects.]"}, {"@id": "_:n951f066397b04b3caa434727defdfdecb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n951f066397b04b3caa434727defdfdecb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n951f066397b04b3caa434727defdfdecb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Artists' books"}}, {"@id": "_:n951f066397b04b3caa434727defdfdecb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Artists' books; UF Artist books; Book art; Book works (Art); Books, Artists'; Bookworks (Art); BT Art, Modern--20th century; Books; Conceptual art; Here are entered books that are produced by artists and intended as visual art objects, and general works about such books)"}, "madsrdf:citationSource": "LCSH, May 10, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n951f066397b04b3caa434727defdfdecb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(artists' books (books); variants: artist's books (books); artists books (books); artist books (books); books, artists'; Books, whether unique items or multiples, made or conceived by artists, including commercial publications (usually in limited editions), as well as unique items formed or arranged by the artist. For texts written by artists for the sake of their informational content, use \"writings.\" For artists' books that emphasize the physical book as a work of art rather than the content, use \"bookworks.\" For works that look like or incorporate books but do not communicate in the ways characteristic of books, see \"book objects\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, May 10, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n951f066397b04b3caa434727defdfdecb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951f066397b04b3caa434727defdfdecb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Book art (Artists' books)"}}, {"@id": "_:n951f066397b04b3caa434727defdfdecb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Book art (Artists' books)"}}, {"@id": "_:n951f066397b04b3caa434727defdfdecb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951f066397b04b3caa434727defdfdecb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Book works (Art)"}}, {"@id": "_:n951f066397b04b3caa434727defdfdecb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Book works (Art)"}}, {"@id": "_:n951f066397b04b3caa434727defdfdecb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951f066397b04b3caa434727defdfdecb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Artist books"}}, {"@id": "_:n951f066397b04b3caa434727defdfdecb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Artist books"}}, {"@id": "_:n951f066397b04b3caa434727defdfdecb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951f066397b04b3caa434727defdfdecb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Artists'"}}, {"@id": "_:n951f066397b04b3caa434727defdfdecb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Artists'"}}, {"@id": "_:n951f066397b04b3caa434727defdfdecb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n951f066397b04b3caa434727defdfdecb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bookworks (Art)"}}, {"@id": "_:n951f066397b04b3caa434727defdfdecb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bookworks (Art)"}}], "@id": "/au