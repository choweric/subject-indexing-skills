f12bd8503904d5aa28f11cd379478b3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(usage: hymn tunes)"}, "madsrdf:citationSource": "Grove Music online, October 25, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nff12bd8503904d5aa28f11cd379478b3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hymn tunes)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nff12bd8503904d5aa28f11cd379478b3b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Busarow, D. Three hymn settings, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:nff12bd8503904d5aa28f11cd379478b3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hymn tunes; the melody of a musical composition to which a hymn text is sung; many were not considered sacred music until associated with a sacred text)"}, "madsrdf:citationSource": "Wikipedia, October 25, 2017", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026134"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026135", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aInstrumental settings", "identifiers:lccn": "gf2017026135", "madsrdf:adminMetadata": [{"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb1"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Instrumental settings"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026084"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}], "madsrdf:hasSource": [{"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb5"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb6"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb7"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb8"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb9"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb10"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb11"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb12"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb13"}], "madsrdf:hasVariant": {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb14"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Arrangements of vocal music for one or more instruments without voice."}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-30T09:50:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Instrumental settings"}}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Beilharz, Kirsty. Between five bells : an instrumental setting of Kenneth Slessor's poem Five bells, 1996.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Virtuosic instrumental settings of madrigals and chansons from 16th century Italy, 2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Carols--Instrumental settings; Folk songs--Instrumental settings; Hymns--Instrumental settings; Songs--Instrumental settings; Spirituals (Songs)--Instrumental settings)"}, "madsrdf:citationSource": "LCSH, Oct. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Borrowing. Section 7, Renaissance secular music: \"Another genre originally derived from vocal models was the instrumental setting of chant or other melody in cantus-firmus style, apparently not intended for liturgical use. Most striking is the English tradition of In Nomine compositions for consort or keyboard\"; under Borrowing. Section 8, The Baroque era: \"Dances, vocal and instrumental settings, and variations continued to be composed on bass patterns and melodies inherited from the 16th century\"; under Sources of instrumental ensemble music to 1630: \"Trent, Biblioteca Comunale, 1947-4 (north Italy, beginning of 16th century). German songs and chansons, without the words. One of the compositions is apparently an instrumental setting a 3 of the chanson J'ay prins amours\"; under Romance: \"From the 15th century, romance in Spain and romanza in Italy have nearly always signified a ballad; the narrative romance was, next to the villancico, the most popular song type in Spanish-speaking countries. ... Since the 18th century vocal and instrumental settings entitled 'romance' have continued to express these 'romantic' and lyrical qualities\")"}, "madsrdf:citationSource": "Grove music online, Oct. 30, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grafulla, C. S. The star spangled banner : an instrumental setting in E\u266d, \u00a91962.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (arranged by Will Sudmeier)"}, "madsrdf:citationSource": "Mendelssohn-Bartholdy, Felix. Four hymns for 4 part trombone choir, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(instrumental setting of folk songs)"}, "madsrdf:citationSource": "Walker, Gwyneth. Shady grove and other songs from the Appalachian Mountains : for piano solo, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(instrumental setting of eleven carols)"}, "madsrdf:citationSource": "Vaughan Williams, Ralph. Eleven Christmas carols : for 4 part trombone choir, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(instrumental setting of the spiritual Swing low, sweet chariot)"}, "madsrdf:citationSource": "Work cat.: Larsen, Libby. Sorrow song and jubilee : for string quartet, 2016?", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Settings, Instrumental"}}, {"@id": "_:nbb7b6e0c17f940b0afdd56918bba2defb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Settings, Instrumental"}}], "@id": "/authorities/genreForms/gf2017026135"}
