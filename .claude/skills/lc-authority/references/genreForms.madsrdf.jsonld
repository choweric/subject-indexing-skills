": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-03T13:39:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Educational games"}}, {"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Instructional games are software developed to motivate students' learning through competition and student developed games; learning games)"}, "madsrdf:citationSource": "Instructional games, via Minnesota STEM Teacher Center website, Aug. 27, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Educational Games. SN Individual or group games that have cognitive, social, behavioral, and/or emotional, etc., dimensions which are related to educational objectives. UF Academic Games; Classroom Games; Heuristic Games; Reading Games. RT Computer Games; Instructional Materials; Learning Activities; Puzzles; Simulation)"}, "madsrdf:citationSource": "ERIC thesaurus online, Aug. 27, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (\"our educational games are the perfect balance of learning and play\")"}, "madsrdf:citationSource": "Educational games for kids, via Education.com website, viewed Aug. 27, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(board game designed to help parents and young people talk to each other about underage alcohol use, why it's not smart, and how to prevent it)"}, "madsrdf:citationSource": "Work cat.: Ready, set, listen, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(An educational game is a game designed to teach humans about a specific subject and to teach them a skill. As educators, governments, and parents realize the psychological need and benefits of gaming have on learning, this educational tool has become mainstream)"}, "madsrdf:citationSource": "Educational games, via Teaching and learning resources wiki, Aug. 27, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(board game; \"Test your ability to travel to Mars and back while avoiding dangerous radiation hazards\"; published by National Aeronautics and Space Administration)"}, "madsrdf:citationSource": "Space travel hazards : how safely can you travel through space?, 2009?", "madsrdf:citationStatus": "found"}, {"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Educational games. UF Instructive games; Training games. BT Education--Simulation methods. BT Games)"}, "madsrdf:citationSource": "LCSH, Aug. 27, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Learning games"}}, {"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Learning games"}}, {"@id": "_:nda440e2ddb7c4dc8afeacd6db7f8b6d4b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nda440e2