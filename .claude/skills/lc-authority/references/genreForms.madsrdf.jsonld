, "@value": "Organa"}}, {"@id": "_:n37985d9f08b548d6a6f9e1ea5136d573b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Organum (a type of medieval polyphony)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Mar. 21, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n37985d9f08b548d6a6f9e1ea5136d573b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Encarta world English dict., 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n37985d9f08b548d6a6f9e1ea5136d573b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Organum (medieval polyphony most often based on a cantus firmus)"}, "madsrdf:citationSource": "New Harvard dict. of mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n37985d9f08b548d6a6f9e1ea5136d573b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n37985d9f08b548d6a6f9e1ea5136d573b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Organums"}}, {"@id": "_:n37985d9f08b548d6a6f9e1ea5136d573b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Organums"}}], "@id": "/authorities/genreForms/gf2014026978"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026979", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOrthros (Music)", "identifiers:lccn": "gf2014026979", "madsrdf:adminMetadata": [{"@id": "_:nfeadcd128283428898877c5b43f137cfb1"}, {"@id": "_:nfeadcd128283428898877c5b43f137cfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Orthros (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfeadcd128283428898877c5b43f137cfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026947"}, "madsrdf:hasSource": [{"@id": "_:nfeadcd128283428898877c5b43f137cfb5"}, {"@id": "_:nfeadcd128283428898877c5b43f137cfb6"}, {"@id": "_:nfeadcd128283428898877c5b43f137cfb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfeadcd128283428898877c5b43f137cfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nfeadcd128283428898877c5b43f137cfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfeadcd128283428898877c5b43f137cfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Orthros (Music)"}}, {"@id": "_:nfeadcd128283428898877c5b43f137cfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A morning Office in the Greek Orthodox Church, equivalent to Matins and Lauds of the Roman rite. Together with Hesperinos, the evening Office, it is one of the principal hours in both the urban and monastic rites)"}, "madsrdf:citationSource": "Grove music online, viewed May 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nfeadcd128283428898877c5b43f137cfb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2004567909: Orthodox Eastern Church. Heirmologion, 11-", "madsrdf:citationStatus": "found"}, {"@id": "_:nfeadcd128283428898877c5b43f137cfb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online, Mar. 5, 2004 (Heirmologion (hirmologion). A liturgical book containing the heirmoi for the o-dai (odes) of the kano-nes, used at the Byzantine Office of Orthros. Orthros. A morning Office in the Greek Orthodox Church, equivalent to Matins and Lauds of the Roman rite.)", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026979"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026980", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOvertures", "identifiers:lccn": "gf2014026980", "madsrdf:adminMetadata": [{"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db1"}, {"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Overtures"}, "madsrdf:elementList": {"@list": [{"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db3"}]}, "madsrdf:exampleNote": "Note under [Preludes (Music)]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db5"}, {"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db6"}], "madsrdf:hasVariant": {"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions that are intended to introduce a dramatic vocal work or spoken drama, and also for independent works with the word \"overture\" in the composer's title."}, {"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-22T12:06:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Overtures"}}, {"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "booklet p. 2 (An American port of call was written in 1985; concert overture in sonata-allegro form)"}, "madsrdf:citationSource": "Hailstork, A.C. An American port of call, \u21172012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Overture. 1. A composition for orchestra intended as an introduction to an opera or other dramatic vocal work... 2. A composition of the 19th and 20th centuries similar to a dramatic overture but intended for independent concert performance. A preliminary stage in the development of the concert overture is represented by the overture to a spoken drama and the overture written for a specific occasion (e.g. Beethoven's Coriolan and Coronation of the house overtures). Other composers wrote pieces entitled only \"Overture\"... The most characteristic concert overtures, however, were works with generalized programs inspired by literature, history, nature, and the like.)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Concert overtures"}}, {"@id": "_:nef2ba7731eed492eb2122c0d92de6c2db8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Concert overtures"}}], "@id": "/authorities/genreForms/gf2014026980"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026981", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPachangas (Music)", "identifiers:lccn": "gf2014026981", "madsrdf:adminMetadata": [{"@id": "_:nc6dcd3a303ae41c798517141e30bd231b1"}, {"@id": "_:nc6dcd3a303ae41c798517141e30bd231b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pachangas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc6dcd3a303ae41c798517141e30bd231b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:nc6dcd3a303ae41c798517141e30bd231b5"}, {"@id": "_:nc6dcd3a303ae41c798517141e30bd231b6"}, {"@id": "_:nc6dcd3a303ae41c798517141e30bd231b7"}, {"@id": "_:nc6dcd3a303ae41c798517141e30bd231b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc6dcd3a303ae41c798517141e30bd231b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc6dcd3a303ae41c798517141e30bd231b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc6dcd3a303ae41c798517141e30bd231b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pachangas (Music)"}}, {"@id": "_:nc6dcd3a303ae41c798517141e30bd231b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (pachanga)"}, "madsrdf:citationSource": "Work cat.: Santiago, V. Juancito Trucupey [SR] 196-:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6dcd3a303ae41c798517141e30bd231b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Glossary of Latin American musical terms (Pachanga; a rage among New York Latin teenagers around 1961, as played by the then hugely popular charangas. There is some dispute as to its origins. It seems to be Cuban, but it never reached the popularity there that it enjoyed in the eastern U.S. It had a fast, syncopated ta-tum ta-tum pulse. The pachanga died out because the dance involved proved to be too energetic for most)"}, "madsrdf:citationSource": "Latin Jazz Club WWW site, July 13, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6dcd3a303ae41c798517141e30bd231b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Dance History Archive; dance (Pachanga; pachanga music was a hybrid rhythm conceived of elements of both the merengue and the conga (merenconga), which began its song hits in Colombia, Cuba in 1955 and arriving with some success in the U.S. around 1959)"}, "madsrdf:citationSource": "Streetswing WWW site, July 13, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6dcd3a303ae41c798517141e30bd231b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Rhythms & styles (Pachanga; 1960s incarnation of the chachacha, still played by the charanga bands. Its signature is a conga pattern called \"caballo\" (literally meaning \"horse\")"}, "madsrdf:citationSource": "Salsa & Merengue Society WWW site, July 13, 2010:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026981"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026982", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aP'ansori", "identifiers:lccn": "gf2014026982", "madsrdf:adminMetadata": [{"@id": "_:n2af1198d3b194767af8d3b14f386927eb1"}, {"@id": "_:n2af1198d3b194767af8d3b14f386927eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "P'ansori"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2af1198d3b194767af8d3b14f386927eb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026961"}], "madsrdf:hasSource": {"@id": "_:n2af1198d3b194767af8d3b14f386927eb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2af1198d3b194767af8d3b14f386927eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2af1198d3b194767af8d3b14f386927eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2af1198d3b194767af8d3b14f386927eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "P'ansori"}}, {"@id": "_:n2af1198d3b194767af8d3b14f386927eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Korean operatic form probably dating from the early 18th century) under Korea II, 2 (In a genre such as the narrative p'ansori, there is a complex interaction between the dramatic and emotional qualities of melodic modes and rhythmic patterns, together with types of ornamentation.) under Korea II, 5. Theatre music (In addition to the narrative p'ansori described above...)"}, "madsrdf:citationSource": "Grove music online, viewed August 27, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026982"}
