{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026087", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLitanies", "identifiers:lccn": "gf2015026087", "madsrdf:adminMetadata": [{"@id": "_:n0010ac18d70d4741a78d714bcb1fd4d9b1"}, {"@id": "_:n0010ac18d70d4741a78d714bcb1fd4d9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Litanies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0010ac18d70d4741a78d714bcb1fd4d9b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026039"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026049"}], "madsrdf:hasSource": {"@id": "_:n0010ac18d70d4741a78d714bcb1fd4d9b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0010ac18d70d4741a78d714bcb1fd4d9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-09-28T10:54:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0010ac18d70d4741a78d714bcb1fd4d9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-09-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n0010ac18d70d4741a78d714bcb1fd4d9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Litanies"}}, {"@id": "_:n0010ac18d70d4741a78d714bcb1fd4d9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "litany (def. 1a: a liturgical prayer consisting of a series of invocations and supplications either read or sung usually with alternate responses by clergy and congregation 1b: a liturgical procession during which clergy and congregation sing or chant prayers; def. 2: a ritualistic repetition of prayers usually of praise and supplication)"}, "madsrdf:citationSource": "Merriam Webster online, Sept. 15, 2015:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026087"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026088", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAfrobeat", "identifiers:lccn": "gf2015026088", "madsrdf:adminMetadata": [{"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb1"}, {"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Afrobeat"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb5"}, {"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb6"}, {"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-04T07:53:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Afrobeat"}}, {"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online, viewed Aug. 13, 2014 (A style of African popular music. The term was coined in 1967 by fela Kuti, who was known as 'the king of Afrobeat'...His awareness of the political power of music is reflected in his subsequent development of Afrobeat, a fusion of jazz, soul and African musics with lyrics in Pidgin and Yoruba. He consciously highlighted the Africanness of his own music, claiming that he played African music since jazz was originally an African form of music. The characteristics of Afrobeat include repetitiveness, pattern-structure, call and response, sudden breaks and solo passages. There is a clear emphasis on the role of percussion, and the highly politicized lyrics are highlighted with powerful horn riffs. At least five (often more) horns are featured on stage along with 15 other musicians and ten dancers. Fela sang and played tenor and alto saxophones and the electric piano.)", "madsrdf:citationStatus": "found"}, {"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(highlife-funk-jazz fusion called \"afrobeat\")"}, "madsrdf:citationSource": "Work cat: 99052605: Veal, M.E. Fela, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n5f0f54bc27544a798d78728b2b8ecabfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Afrobeat ... combines West African and U.S. black music, soul, jazz, and call-and-response vocals)"}, "madsrdf:citationSource": "White, D. Dict. of popular music styles of the world, c1998", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026088"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026089", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBrunettes (Songs)", "identifiers:lccn": "gf2015026089", "madsrdf:adminMetadata": [{"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b1"}, {"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Brunettes (Songs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": [{"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b5"}, {"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b6"}, {"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-09-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-04T07:53:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Brunettes (Songs)"}}, {"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A species of song popular in France during the late 17th century and the 18th. It has been claimed that the name derives from the refrain ('Ah, petite Brunette! Ah, tu me fais mourir') of the song Le beau berger Tirsis, which became very popular... Such airs, usually in bipartite form (generally for one to three voices with or without accompaniment), are characterized by tender sentiments and references to young brunettes, although the latter are not mentioned in every piece of this name. Melodic variations, often introduced into the later verses, were sometimes included in publications... The brunette bore the same relationship to the Italian Baroque aria as did the romance to the lied in the 19th century; in its simplicity and elegance it was regarded as quintessentially French. Its many champions (including Mont\u00e9clair and L'Affilard) regarded it as the perfect means of developing 'taste' because of the sensitivity demanded from the performer. A number of brunettes were also reworked as instrumental pieces, especially for teaching purposes. The brunette remained popular until well into the second half of the 18th century."}, "madsrdf:citationSource": "Grove music online, viewed Aug. 12, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: 2004560026: Brunettes, ou, Petit airs, 2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f02d05d6ed24aaa869f202968aaf4c0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Brunette: a type of French song of the 17th and 18th centuries for one to three voices, with or without accompaniment, and with pastoral or amorous texts; the name perhaps derives from the refrain Ah petite brunette in the song Le beau berger Tirsis)"}, "madsrdf:citationSource": "Harvard dict. of music", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026089"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026090", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGaitas (Music)", "identifiers:lccn": "gf2015026090", "madsrdf:adminMetadata": [{"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb1"}, {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gaitas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb5"}, {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb6"}, {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb7"}], "madsrdf:hasVariant": {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-04T07:53:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-09-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gaitas (Music)"}}, {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Gaita zuliana (Gaita is a style of Venezuelan folk music from Maracaibo in Zulia State. According to Joan Corominas, it may come from gaits, the Gothic word for \"goat\", which is the skin generally used for the membrane of the furro instrument. Other instruments used in gaita include maracas, cuatro, charrasca and tambora (Venezuelan drum). Song themes range from humorous and love songs to protest songs. The style became popular throughout Venezuela in the 1960s, and it fused with other styles such as salsa and merengue in the 1970s..."}, "madsrdf:citationSource": "Wikipedia, viewed Aug. 11, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: 2009520589: Rodr\u00edguez Balestrini, H., Hablemos de gaitas y gaiteros, 2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "South America, Central America, and the Caribbean. Part 3, Nations and musical traditions. Venezuela (The traditional gaita of the state of Zulia is accompanied by a friction drum (furruco) and drums called tambora s, which can be of the standard double-headed type or small barrel-type or bongolike drums. Quite evident is how these drums are played: the drummer performs with a stick in each hand, one of which beats the side of the drum. Tambora s can be played between the legs while the player is sitting or supported by a strap while the player is standing. Standard secondary instruments, such as maraca s and charrascas, also accompany gaitas. Many gaitas heard today use electronic keyboard s and other modern instruments in addition to the standard percussion instruments. The rapid beats of the tambora, though, and the growling of the furruco, make this kind of music easy to distinguish from other genres.)"}, "madsrdf:citationSource": "Garland encyclopedia of world music. Vol. 2:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gaitas zulianas"}}, {"@id": "_:nc0aaa78d50c947ef91ca730027002bbeb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gaitas zulianas"}}], "@id": "/authorities/genreForms/gf2015026090"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026091", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMatachines (Music)", "identifiers:lccn": "gf2015026091", "madsrdf:adminMetadata": [{"@id": "_:n5efccb50c2b440f7a491a1fddbb52296b1"}, {"@id": "_:n5efccb50c2b440f7a491a1fddbb52296b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Matachines (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5efccb50c2b440f7a491a1fddbb52296b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n5efccb50c2b440f7a491a1fddbb52296b5"}, {"@id": "_:n5efccb50c2b440f7a491a1fddbb52296b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5efccb50c2b440f7a491a1fddbb52296b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-09-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5efccb50c2b440f7a491a1fddbb52296b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-04T07:53:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5efccb50c2b440f7a491a1fddbb52296b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Matachines (Music)"}}, {"@id": "_:n5efccb50c2b440f7a491a1fddbb52296b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Sanches, J. Matachines [SR] 1991.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5efccb50c2b440f7a491a1fddbb52296b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online, viewed Aug. 12, 2015: under Tewa (The Matachines dance reached Mexico from Spain and spread through the Pueblo cultures (and even into southern Plains cultures) to gain a place in the Pueblo ceremonial calendar... It is performed in many villages at Christmas or New Year's Day or on saints' days, and is often part of the Tewa Puye Cliffs Ceremonial in July. Although basically a line dance, the dancers also portray characters (Montezuma, his mistress, and two clowns). Many of the matachine elements, such as the line dance itself and the clowns, are of Old World origin, but have been altered to resemble a Pueblo dance style. The accompanying music is performed on guitar, violin, and drum and consists of simple tunes of one or two phrases that are repeated continuously or with variation. The dancers carry and play gourd rattles (as in traditional dances) and slap their sandals against the ground while dancing to create additional percussive sounds. These rhythmic effects and the dance steps may vary from village to village. Among the San Juan the songs contain from two to six tones with the first and last songs using fewer tones than those that intervene. The songs, like the instruments of European origin, exemplify the assimilation of foreign forms of music and dance into the complex Pueblo tradition.)", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026091"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026092", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aModinhas", "identifiers:lccn": "gf2015026092", "madsrdf:adminMetadata": [{"@id": "_:nb3465c1c6398456ba036b59855403bf7b1"}, {"@id": "_:nb3465c1c6398456ba036b59855403bf7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Modinhas"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb3465c1c6398456ba036b59855403bf7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:nb3465c1c6398456ba036b59855403bf7b5"}, {"@id": "_:nb3465c1c6398456ba036b59855403bf7b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb3465c1c6398456ba036b59855403bf7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-04T07:53:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb3465c1c6398456ba036b59855403bf7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-09-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb3465c1c6398456ba036b59855403bf7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Modinhas"}}, {"@id": "_:nb3465c1c6398456ba036b59855403bf7b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Calado, M.A. A modinha em Vila Boa de Goi\u00e1s, 1982.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb3465c1c6398456ba036b59855403bf7b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online, viewed Aug. 12, 2015 (A Portuguese and Brazilian sentimental art song cultivated in the 18th and 19th centuries. From the early 1700s it competed with the lundu to be the first truly Brazilian music form. Moda is a generic term applied vaguely to any song or melody. Particularly common in the 18th century were the modas a duo, for two sopranos, sung in parallel motion with harpsichord accompaniment and a possible doubling of the bass line by a low string instrument. In practice most printed modinhas in Portugal were accompanied by the guitar. During the Second Empire in Brazil the modinha acquired the character of the Italian opera aria, while in Portugal the same occurred about 1800. Under such influences the modinha began to lose its original simplicity, acquiring elaborate melodic lines with typically superficial ornamentation. Aspects of the opera aria were retained in the popularization of the modinha and came to be identified later in the 19th century as 'national' traits. Eventually the Brazilian modinha became a strongly lyrical folksong incarnating Brazilian romantic spirit. As a love song it was closely related to another popular genre, the lundu, a song and dance born of African origin which, together with the modinha, became the most important salon genre in Portugal and Brazil.)", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026092"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026093", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTechnical reports", "identifiers:lccn": "gf2015026093", "madsrdf:adminMetadata": [{"@id": "_:n3bae8e371b264597b472d0665d36c9c7b1"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Technical reports"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3bae8e371b264597b472d0665d36c9c7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026076"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027236"}], "madsrdf:hasSource": [{"@id": "_:n3bae8e371b264597b472d0665d36c9c7b5"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b6"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b7"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b8"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b9"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b10"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b11"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b12"}], "madsrdf:hasVariant": [{"@id": "_:n3bae8e371b264597b472d0665d36c9c7b13"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b16"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-09-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-01-09T09:18:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Technical reports"}}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(technical report: A scientific paper or article describing research or other significant developments in a field of the applied sciences. When submitted to a military agency, such a report may be classified or subject to other restrictions on access. See also: e-print, National Technical Information Service, preprint, and Standard Technical Report Number)"}, "madsrdf:citationSource": "Reitz, J.M. Online dictionary for library and information science, viewed Sept. 28, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A technical report (also: scientific report) is a document that describes the process, progress, or results of technical or scientific research or the state of a technical or scientific research problem. It might also include recommendations and conclusions of the research. Unlike other scientific literature, such as scientific journals and the proceedings of some academic conferences, technical reports rarely undergo comprehensive independent peer review before publication. They may be considered as grey literature. Where there is a review process, it is often limited to within the originating organization. Similarly, there are no formal publishing procedures for such reports, except where established locally)"}, "madsrdf:citationSource": "Wikipedia, Sept. 28, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (PRB technical research report; PRB technical reports)"}, "madsrdf:citationSource": "Johnson, Cecil D. Prediction of the combat proficiency of infantrymen, 1955:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A technical report is a document written by a researcher detailing the results of a project and submitted to the sponsor of that project. Many of Georgia Tech's reports are government sponsored and are on microfiche. DOE, NASA and the Department of Defense are top sponsors. A number of U.S. Government sponsors now make technical reports available full image via the internet. Although technical reports are very heterogeneous, they tend to possess the following characteristics: technical reports may be published before the corresponding journal literature; content may be more detailed than the corresponding journal literature, although there may be less background information since the sponsor already knows it; technical reports are usually not peer reviewed unless the report is separately published as journal literature; classified and export controlled reports have restricted access; obscure acronyms and codes are frequently used)"}, "madsrdf:citationSource": "What is a technical report?, via Georgia Tech Library website, Sept. 28, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Technical Report. Annotation: this heading is used as a Publication Type. Scope Note: Work consisting of a formal report giving details of the investigation and results of a medical or other scientific problem. When issued by a government agency or comparable official body, its contents may be classified, unclassified, or declassified with regard to security clearance. This publication type may also cover a scientific paper or article that records the current state or current position of scientific research and development. If so labeled by the editor or publisher, this publication type may be properly used for journal articles)"}, "madsrdf:citationSource": "MeSH browser, Sept. 28, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Sept. 28, 2015", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(technical reports. Hierarchy: information forms (objects) - document genres - <document genres by function> - reports - technical reports. Scope note: Reports giving details and results of a specific investigation of a scientific or technical problem. UF reports, scientific; reports, technical; scientific reports)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Sept. 28, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. verso (\"This publication and all Office of Aerospace Medicine technical reports are available in full-text from the Civil Aerospace Medical Institute's publications Web site.\") p. i (\"Technical report documentation page\"; Report No. DOT/FAA/AM-06/5)"}, "madsrdf:citationSource": "Work cat.: Aeromedical aspects of findings from aircraft-assisted pilot suicides in the United States, 1993-2002, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3bae8e371b264597b472d0665d36c9c7b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reports, Technical"}}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reports, Technical"}}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3bae8e371b264597b472d0665d36c9c7b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scientific reports"}}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scientific reports"}}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3bae8e371b264597b472d0665d36c9c7b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reports, Scientific"}}, {"@id": "_:n3bae8e371b264597b472d0665d36c9c7b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reports, Scientific"}}], "@id": "/authorities/genreForms/gf2015026093"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026095", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNature fiction", "identifiers:lccn": "gf2015026095", "madsrdf:adminMetadata": [{"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb1"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nature fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb3"}]}, "madsrdf:exampleNote": "Note under [Ecofiction]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026067"}, "madsrdf:hasSource": [{"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb5"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb6"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb7"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb8"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb9"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb10"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb11"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb12"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that depicts the natural world and its phenomena. For fiction that depicts the interconnectedness of the human and natural worlds, and especially the impact of human activities on nature, see [Ecofiction.]"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:34:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nature fiction"}}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nature stories. UF Natural history--Fiction; Natural history--Juvenile fiction; Nature--Fiction; Nature--Juvenile fiction. BT Fiction)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover flap (anthology of nature writing; selections range from scientific observations to poetry, from diary entry to novel extract) p. 31 (extract from Charlotte Bront\u00eb's novel Jane Eyre) p. 87 (extract from Herman Melville's novel Moby Dick) p. 104 (extract from Herman Melville's novel Mardi, and a voyage thither) p. 112 (extract from Thomas Hardy's novel The return of the native) p. 144 (extract from Edmund Gosse's novel Father and son) p. 148 (extract from Grey Owl's children's novel The adventures of Sajo and her beaver people) p. 181 (extract from Lewis Carroll's Through the looking glass and what Alice found there)"}, "madsrdf:citationSource": "Pleasures of nature : a literary anthology, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Blackwood, A. Pan's garden : a volume of nature stories, 1971.", "madsrdf:citationStatus": "found"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (Fiction: Outdoor Adventure/Nature)"}, "madsrdf:citationSource": "Work cat.: Domico, T. The last thylacine, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. ix (the first comprehensive anthology of nature writing in the Caribbean from 1492 to the present; the genres of poetry and of fiction, which include some of the finest writing about nature in Caribbean literature, are also represented here)"}, "madsrdf:citationSource": "The islands and the sea : five centuries of nature writing from the Caribbean, 1991:", "madsrdf:citationStatus": "found"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Williamson, H. Collected nature stories, 1970.", "madsrdf:citationStatus": "found"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 165 (Mary Wilkins Freeman's nature fiction; human relationship with the rest of nature becomes the theme)"}, "madsrdf:citationSource": "Beyond nature writing, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 11 (Most of the fourteen stories gathered together here are written by writers who aren't known for being overtly environmentally oriented. The write about wildness because they write about human nature; one doesn't exist without the other; their stories vary in setting, character, and voice, but they share an intensity of feeling and implicit questioning of our perception of ourselves as the planet's dominant species; characters both fear and cherish wildness, yet many become aware of their feelings for nature only after witnessing the death of a much-admired animal or suffering the loss of a favorite wild place or way of life) p. 4 of cover (short stories ... evoke our perception of nature and the conflict between wildness and civilization within each of us)"}, "madsrdf:citationSource": "In our nature : stories of wildness, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n173a7ffc59a54a9faea2cb67e76648acb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Tisdall, C. Australian nature stories for children, 1904.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026095"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026097", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGrindcore (Music)", "identifiers:lccn": "gf2015026097", "madsrdf:adminMetadata": [{"@id": "_:ne2c12e3b19fe4dfd80a18bef3e31b4bcb1"}, {"@id": "_:ne2c12e3b19fe4dfd80a18bef3e31b4bcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Grindcore (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne2c12e3b19fe4dfd80a18bef3e31b4bcb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026850"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027138"}], "madsrdf:hasSource": [{"@id": "_:ne2c12e3b19fe4dfd80a18bef3e31b4bcb5"}, {"@id": "_:ne2c12e3b19fe4dfd80a18bef3e31b4bcb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne2c12e3b19fe4dfd80a18bef3e31b4bcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne2c12e3b19fe4dfd80a18bef3e31b4bcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-07-13T14:28:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne2c12e3b19fe4dfd80a18bef3e31b4bcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Grindcore (Music)"}}, {"@id": "_:ne2c12e3b19fe4dfd80a18bef3e31b4bcb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: 2014018706: Overell, R., Affective intensities in extreme music scenes, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2c12e3b19fe4dfd80a18bef3e31b4bcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Grindcore: an extreme genre of music; originated in the early- to mid-1980s; draws inspiration from some of the most abrasive-sounding music genres -- including thrash metal, industrial music, noise music and the more extreme varieties of hardcore punk, such as crust punk; characterized by a noise-filled sound that uses heavily distorted, down-tuned guitars, grinding overdriven bass, high speed tempo, blast beats, and vocals which consist of growls and high-pitched shrieks)"}, "madsrdf:citationSource": "Wikipedia, July 15, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026097"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026098", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKrautrock (Music)", "identifiers:lccn": "gf2015026098", "madsrdf:adminMetadata": [{"@id": "_:n81de0ea9a5804084ad1619558e564701b1"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Krautrock (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n81de0ea9a5804084ad1619558e564701b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027018"}, "madsrdf:hasSource": [{"@id": "_:n81de0ea9a5804084ad1619558e564701b5"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b6"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b7"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b8"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b9"}], "madsrdf:hasVariant": [{"@id": "_:n81de0ea9a5804084ad1619558e564701b10"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-09-09T08:51:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Krautrock (Music)"}}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Krautrock (A mildly patronizing term coined by the British press in the early 1970s to describe the new wave of experimental bands emanating from Germany in the late 1960s. After the critical success of Julian Cope's book Krautrocksampler (London, 1995), the term has now lost most of its pejorative connotations and has come to describe an important musical movement. The Krautrock bands were united by the common ideology of wanting to create a uniquely German pop culture after those decades post-World War II when Anglo-American culture was pre-eminent. Much of this new music was underpinned by a violent catharsis, a sometimes unacknowledged sense of wanting to purge the past and to establish a new youth cultural formation through experimental music... the experimental Krautrock groups presaged many of the future directions of pop. Rap, hip hop, ambient, industrial and techno music are all indebted to the Krautrock movement.)"}, "madsrdf:citationSource": "Grove music online, viewed Aug. 12, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Krautrock and Kosmishce Musik bands such as Can, Faust, Kraftwerk and Neu!)"}, "madsrdf:citationSource": "Kraturock directory", "madsrdf:citationStatus": "found"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 12 (the new rock 'n' roll in West Germany was not rock 'n' roll at all. It was a meltdown music-form which defied all categories but that which the W. German musicians called it - Kosmische music) p. 13 (the british rock press [called it] Krautrock)"}, "madsrdf:citationSource": "Work cat: Cope, J. Krautrocksampler, 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "The Krautrock pages (late 1960s and 70s... band in Germany... term Krautrock broad and cannot be defined)"}, "madsrdf:citationSource": "Spaceship Mark's Wierd Vibe Web Pages, WWW site, 15 May 200:", "madsrdf:citationStatus": "found"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Lexikon (mainly electronic music, later described as \"kraut-Rock\" (more an insult than a striking description or label), such as Amon Duul, Krafterwek, Can, Tangerine)"}, "madsrdf:citationSource": "Germanrock WWW site, May 15, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n81de0ea9a5804084ad1619558e564701b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kraut-Rock (Music)"}}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kraut-Rock (Music)"}}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n81de0ea9a5804084ad1619558e564701b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Kosmische Musik"}}, {"@id": "_:n81de0ea9a5804084ad1619558e564701b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kosmische Musik"}}], "@id": "/authorities/genreForms/gf2015026098"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026100", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aKwaya", "identifiers:lccn": "gf2015026100", "madsrdf:adminMetadata": [{"@id": "_:n9eb7559dd28d4a368ea30dcba51dd254b1"}, {"@id": "_:n9eb7559dd28d4a368ea30dcba51dd254b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Kwaya"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9eb7559dd28d4a368ea30dcba51dd254b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n9eb7559dd28d4a368ea30dcba51dd254b5"}, {"@id": "_:n9eb7559dd28d4a368ea30dcba51dd254b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9eb7559dd28d4a368ea30dcba51dd254b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n9eb7559dd28d4a368ea30dcba51dd254b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9eb7559dd28d4a368ea30dcba51dd254b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Kwaya"}}, {"@id": "_:n9eb7559dd28d4a368ea30dcba51dd254b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "documentation (kwaya)"}, "madsrdf:citationSource": "Work cat.: Perullo, A.I. Tanzania, Dar es Salaam, 2000-2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9eb7559dd28d4a368ea30dcba51dd254b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "((Kiswahili: 'choir'). East African choral music. The source for contemporary kwaya music in East Africa is the homophonic vocal music introduced by Protestant missions in the 19th century. Other origins include Roman Catholic missions employing unaccompanied monophonic melodies for congregational singing. Today the kwaya music of the Evangelical Lutheran Church of Tanzania best exemplifies the richness of historic and contemporary kwaya music in East Africa....In the 1920s and 30s changes occurred in Tanzanian Christian music; missionaries and local composers began to modify European texts more freely, adopt local melodies and involve local traditions to a greater extent. After independence, Tanzanian kwaya music developed along with new and growing cultural identities. Radio Tanzania of Dar es Salaam initiated frequent broadcasts of kway music, and political kwayas were established that drew heavily on the musical repertories of pre-existing religious kwaya traditions... Tanzania's colonial past and independent present co-exist in contemporary kwaya music. Early kwaya music developed into several contemporary performance genres: kwaya ya matarumbeta (brass bands playing traditional kwaya repertories), kwaya ya maombolezo (singing bereavement communities drawing on traditional kwaya repertories), institutional and parastatal kwayas working closely with composers of religious kwaya music, as well as the daily service kwayas of the Christian churches. While kwayas are obliged to maintain and preserve older music traditions, they are also expected to participate in the formation and development of the newer more popular kwaya traditions as well. The emergence of kwaya music as a contemporary Tanzanian popular genre is a direct result of processes of technology, transmission and modernization of mass media: radio, improved recording facilities, affordable prices of audio cassettes access to dubbing equipment for the mass produciton of kwaya cassettes and the greater availability of electronic instruments and equipment)"}, "madsrdf:citationSource": "Grove music online, viewed Aug. 12, 2015", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026100"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026101", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNew Year music", "identifiers:lccn": "gf2015026101", "madsrdf:adminMetadata": [{"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b1"}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "New Year music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026103"}, "madsrdf:hasSource": [{"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b5"}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b6"}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b7"}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b8"}], "madsrdf:hasVariant": {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-07-13T14:28:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "New Year music"}}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sullivan, Arthur, Sir. The last night of the year, 1863?", "madsrdf:citationStatus": "found"}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Williams, A. (Aaron). An ode or anthem for the New Year, approximately 1775.", "madsrdf:citationStatus": "found"}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Ireland, John. A new year carol, c1942.", "madsrdf:citationStatus": "found"}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(New Year songs)"}, "madsrdf:citationSource": "Newyear.com WWW site, viewed Sept. 1, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "New Year's Eve music"}}, {"@id": "_:n98dd91d424ae4b20ba5b5e39215f6575b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "New Year's Eve music"}}], "@id": "/authorities/genreForms/gf2015026101"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026102", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPalos (Music)", "identifiers:lccn": "gf2015026102", "madsrdf:adminMetadata": [{"@id": "_:nf31ae297223f4025aa7db98186155d6eb1"}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Palos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf31ae297223f4025aa7db98186155d6eb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasSource": [{"@id": "_:nf31ae297223f4025aa7db98186155d6eb5"}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb6"}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb7"}], "madsrdf:hasVariant": [{"@id": "_:nf31ae297223f4025aa7db98186155d6eb8"}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb11"}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Palos (Music)"}}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Palos is considered the true Dominican rural roots/pop religious type music and an extremely important genre; played on drums for saints' festivals or cofrad\u00edas, for more personal vow type festivals and for the dead; variants, Atabales, Bambula, Quiyombo)"}, "madsrdf:citationSource": "Colonial Zone Dominican Republic WWW site, Oct. 18, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(palos, sacred popular drum music associated with Afro-Dominican religious brotherhoods, or cofrad\u00edas)"}, "madsrdf:citationSource": "Davis, M.E. A survey of Afro-Dominican palos sacred drum music, viewed online at the LAMECA, Ethnomusicologie carib\u00e9enne, WWW site, Oct. 18, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(on palos, or atabales, traditional Dominican sacred music, played primarily on drums)"}, "madsrdf:citationSource": "Work cat.: Fiestas de palos, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf31ae297223f4025aa7db98186155d6eb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Atabales (Music)"}}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Atabales (Music)"}}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf31ae297223f4025aa7db98186155d6eb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quiyombo (Music)"}}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quiyombo (Music)"}}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf31ae297223f4025aa7db98186155d6eb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bambula (Music)"}}, {"@id": "_:nf31ae297223f4025aa7db98186155d6eb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bambula (Music)"}}], "@id": "/authorities/genreForms/gf2015026102"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026103", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRosh ha-Shanah music", "identifiers:lccn": "gf2015026103", "madsrdf:adminMetadata": [{"@id": "_:n8c25e4c20a3d4fab81eb5f8ff3fc910fb1"}, {"@id": "_:n8c25e4c20a3d4fab81eb5f8ff3fc910fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rosh ha-Shanah music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8c25e4c20a3d4fab81eb5f8ff3fc910fb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026857"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026101"}], "madsrdf:hasSource": [{"@id": "_:n8c25e4c20a3d4fab81eb5f8ff3fc910fb5"}, {"@id": "_:n8c25e4c20a3d4fab81eb5f8ff3fc910fb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8c25e4c20a3d4fab81eb5f8ff3fc910fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-07-13T14:28:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8c25e4c20a3d4fab81eb5f8ff3fc910fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8c25e4c20a3d4fab81eb5f8ff3fc910fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rosh ha-Shanah music"}}, {"@id": "_:n8c25e4c20a3d4fab81eb5f8ff3fc910fb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Janowski, Max. Rosh ha-Shana service, 1991.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8c25e4c20a3d4fab81eb5f8ff3fc910fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Rituals & revelations : a cantata for Rosh Hashana)"}, "madsrdf:citationSource": "Kaplan, Amelia S. Rituals & revelations, 1997:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026103"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026104", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSampler albums (Sound recordings)", "identifiers:lccn": "gf2015026104", "madsrdf:adminMetadata": [{"@id": "_:nf0a94288b54d4636a850515d692753f2b1"}, {"@id": "_:nf0a94288b54d4636a850515d692753f2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sampler albums (Sound recordings)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf0a94288b54d4636a850515d692753f2b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}], "madsrdf:hasSource": {"@id": "_:nf0a94288b54d4636a850515d692753f2b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Sound recording compilations of various performers, or of specific musical genres or styles that are taken from a number of previously issued sound recordings, that are generally issued by record labels to introduce or otherwise promote the artist, genres, or new issues."}, {"@id": "_:nf0a94288b54d4636a850515d692753f2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-03T13:39:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf0a94288b54d4636a850515d692753f2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nf0a94288b54d4636a850515d692753f2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sampler albums (Sound recordings)"}}, {"@id": "_:nf0a94288b54d4636a850515d692753f2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sampler album: a type of compilation album generally offered at a reduced price to showcase a selection of artists signed to a particular record label. The format became popular in the late 1960s as record labels sought to gain exposure through singles-dominated radio airplay. Most samplers showcased already-released material so that as well as sampling the artist they sampled the albums from which the tracks were drawn)"}, "madsrdf:citationSource": "Wikipedia, August 27, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026104"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026105", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSchrammelmusik", "identifiers:lccn": "gf2015026105", "madsrdf:adminMetadata": [{"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb1"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Schrammelmusik"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, "madsrdf:hasSource": [{"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb5"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb6"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb7"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb8"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb9"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-03T13:39:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Schrammelmusik"}}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Schrammel (A style of music popular in the Heurigen, the taverns where the Viennese drink new wines. It owes its name to the violinist brothers Johann Schrammel(1850--93) and Joseph (1852--95), who formed a quartet with two friends playing the clarinet and guitar. The tradition they established was carried on later with the clarinet replaced by piano accordion, though in the 1960s there was a dedicated revival of the original instrumentation. The brothers wrote much of their own music, and Johann's march Wien bleibt Wien (1887) became a classic)"}, "madsrdf:citationSource": "Grove music online, viewed Aug. 31, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Schrammelmusik)"}, "madsrdf:citationSource": "MGG", "madsrdf:citationStatus": "found"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Schrammelmusik)"}, "madsrdf:citationSource": "New Harvard dict.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Schrammelmusik)"}, "madsrdf:citationSource": "Brockhaus-Riemann", "madsrdf:citationStatus": "found"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Klassisches Wiener Schrammel-Quartett. Die Schrammeln am W\u00e4scherm\u00e4del-Ball [SR] p1983.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf51b1fc6e14f4889ae6fb50a76291e8cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Schrammelmusik is a style of Viennese folk music originating in the late nineteenth century and still performed in present-day Austria. The style is named for the prolific folk composers Johann and Josef Schrammel... A typical Schrammelmusik ensemble consists of two violins or fiddles, a double-necked contraguitar, and a G clarinet... Often a button accordion, called a Schrammelharmonika, is included. Performers strive for a melancholy, \"crying\", but melodious sound. The style is influenced by folk music from Austria, Slovenia, Moravia and Bavaria)"}, "madsrdf:citationSource": "Wikpedia, viewed Aug. 31, 2015", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026105"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026106", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGhazals (Music)", "identifiers:lccn": "gf2015026106", "madsrdf:adminMetadata": [{"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb1"}, {"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ghazals (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": {"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb5"}, "madsrdf:hasVariant": {"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:40:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghazals (Music)"}}, {"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Ghazal [also: ghazel] (Poetic form widely used in West, Central and South Asia and in other Muslim cultures, particularly associated with Persian and Urdu, but applied in other languages; composed of several independent couplets with a unified rhyme scheme: aa, ba, ca, etc.) Under India/II. History of classical music/2. To the mid-16th century: (In the decades before and after 1300 [whether or not] the Indo-Persian poet Amir Khusrau ... introduced the singing of ghazal, he certainly established and legitimized them as South Asian musical items.) Under Islamic religious music/6. Prayers and devotional songs: (an elevated form of love song treating secular and/or divine love, is used throughout Muslim Asia)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Apr. 20, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ghazels (Music)"}}, {"@id": "_:ndb6a9a9fb54f4435ac379d607456bc6bb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghazels (Music)"}}], "@id": "/authorities/genreForms/gf2015026106"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026107", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aK\u0101f\u012b (Music)", "identifiers:lccn": "gf2015026107", "madsrdf:adminMetadata": [{"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b1"}, {"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "K\u0101f\u012b (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b5"}, {"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b6"}, {"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-07-13T14:28:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "K\u0101f\u012b (Music)"}}, {"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Kafi... is a classical form of Sufi poetry, mostly in Punjabi and Sindhi languages and originating from the Punjab and Sindh regions of the South Asia... In musical terms, kafi refers to the genre of Punjabi and Sindhi classical music which utilizes the verses of kafi poets such as Bulleh Shah and Shah Hussain. Kafi music is devotional music, normally associated with the Sufi orders or Tariqah of Islam in South Asia, and was sung by dervishes or fakirs (Islamic mendicants), solo or in groups, as an offering to their murshid, spiritual guide.)"}, "madsrdf:citationSource": "Wikipedia, viewed Aug. 24, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (Although rooted in the classical traditions of Islamic mysticism, Sufism found wide acceptance in India in turn, the Sufi saints were influenced by the cultural traditions of the subcontinent) p. 2 (Sufiana Qalam refers to the writings of the Sufis. Their lyrical verses, called \"Kafis\" constitute a very old form of poetic composition. K\u0101f\u012b\u0304 is an Arabic word equivalent to the Sanskrit word \"sthai\")."}, "madsrdf:citationSource": "Found on Sept. 19, 2007 on the official site of Sikh heritage:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a31cad1d1bb41b99de651a429d81f51b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 7 (K\u0101f\u012b) Eng. summary (K\u0101f\u012b, sufic form of poetry)"}, "madsrdf:citationSource": "Work cat: J\u016b\u1e47ejo, \u02bbAbduljabb\u0101ru. K\u0101fiy\u0101n\u0332, 2003:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026107"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026108", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBergerettes (Songs)", "identifiers:lccn": "gf2015026108", "madsrdf:adminMetadata": [{"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb1"}, {"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bergerettes (Songs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": [{"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb5"}, {"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb6"}, {"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-13T09:38:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-11-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bergerettes (Songs)"}}, {"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bergerette: 1. 156th cent. poetic form; 2. (rare) 16th-cent. instrumental dance in quick triple time; 3. 18th-cent. French air with frequent pastoral references)"}, "madsrdf:citationSource": "New Harv dict. of music", "madsrdf:citationStatus": "found"}, {"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bergerette: name sometimes given to a tender French air of the 18th cent. in which constant reference was made to shepherds and shepherdesses; virtually indistinguishable from a brunette; title was also very occasionally used in 16th cent. for instrumental dances similar to the salterello)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n28083bcd1fe74f24afd31f333fb4f04fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Bergerette (i) ((1) A kind of song in the 15th century, first found in a text manuscript (GB-Lbl Add.15224 (c1430)), which gives the heading 'Bergerete chantee' to 13 poems with no apparent common features; the heading 'Bergerette' appears in another manuscript (F-Pn fr.2230 and fr.19182) for virelais. Descriptions of the term in several literary treatises of the 15th century show no clear consistency of meaning. (2) In common parlance the word is often used to denote a virelai setting from the second half of the 15th century, in the erroneous belief that its single-stanza form is not found among virelais of the 14th century. In this sense it is treated as a forme fixe (see Formes fixes); and the word appears to lie at the root of the Italian word Barzelletta, which does (in music) denote a forme fixe.) under Bergerette (ii) (In the 18th century the word, alongside 'bergerie', is given to folksong-like airs of a pastoral and amorous nature.) under Bergerette (iii) (A shepherd-dance, the title given to four dances in Susato's Het derde musyck boexken(Antwerp, 1551); that three of them are in triple time but the other in duple, and that their formal designs have nothing in common, suggests that the title is just a broad characterization.)"}, "madsrdf:citationSource": "Grove music online, viewed, Aug. 12, 2015", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026108"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026109", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAlternative histories (Television programs)", "identifiers:lccn": "gf2015026109", "madsrdf:adminMetadata": [{"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b1"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Alternative histories (Television programs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026252"}, "madsrdf:hasSource": [{"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b5"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b6"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b7"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b8"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b9"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b10"}], "madsrdf:hasVariant": [{"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b11"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b14"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b17"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fictional television programs in which the plot or setting assumes an alternative outcome of an historical event."}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-04T16:49:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternative histories (Television programs)"}}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Man in the high castle (Television program). The man in the high castle, 2015-", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "The Man in the High Castle (TV series) (The Man in the High Castle is an American dystopian alternate history television series produced by Amazon Studios, Scott Free, Headline Pictures and Electric Shepherd Productions. The series is based on the 1962 novel of the same name by American science fiction author Philip K. Dick)"}, "madsrdf:citationSource": "Wikipedia, Dec. 6, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Man in the High Castle (2015-); TV series; A glimpse into an alternate history of North America. What life after WWII may have been like if the Nazis had won the war)"}, "madsrdf:citationSource": "IMDb, Dec. 6, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category: Alternate history television series; lists Barna Hedenh\u00f6s uppfinner julen; Cavemen (TV series); Crossbones (TV series); An Englishman's Castle; The Man in the High Castle (TV series); Princess Hours; Singing All Along; Sliders; Sound of the Desert (TV series); SS-GB (miniseries); Scarlet Heart; The West Wing; Xena: Warrior Princess)"}, "madsrdf:citationSource": "Wikipedia, Dec. 6, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Alternate History. A type of Speculative Fiction (sometimes called \"Uchronia\" or \"Anachronism\") set in a world where one or more historical events unfolded differently than they did in the real world. Often set some time after the event (called a \"point of divergence\", or PoD, by fans of the genre), such stories typically describe a Present Day world vastly changed by the difference, or follow another major historical event in light of the change. Sometimes linked with a Time Travel story--the point of divergence is often caused by travelers from \"our\" timeline (OTL in Alt-history parlance) seeking to effect a desired change. The protagonists may be original characters or actual historical figures. Lampshade Hanging occurs often in these types of stories (an Allohistorical Allusion); often, a character will stop to muse on what the world would be like if history had gone the way it did in the real world; Examples of alternate history can be found in literature as far back as the 1st century BC; The genre has become increasingly popular since the late 20th century, perhaps because it was a tumultuous century rich in \"what if\" opportunities, though TV and movie versions are less common.) The setting of an alternate history is often described as a What If?)"}, "madsrdf:citationSource": "TV tropes website, Dec. 6, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Uchronia refers to a hypothetical or fictional time-period of our world, in contrast to altogether fictional lands or worlds. A concept similar to alternate history but different in the manner that uchronic times are not easily defined (mainly placed in some distant or unspecified point before current times), sometimes reminiscent of a constructed world. Some, however, do use uchronia to refer to an alternate history. Robert E. Howard's Hyborian Age is an example of an explicit uchronian period, while Tolkien's first three ages of Middle-earth may or may not be located in the same world as the modern Earth. In the uchronian interpretation of Middle-earth, this and other fantasy-genre fiction takes place during uchronian periods, set roughly in the prehistoric times. The alternative interpretation of an entirely separate mythology divorced from real history and taking place in another universe says that these stories are not uchronian.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 6, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Allohistories (Television programs)"}}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Allohistories (Television programs)"}}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Histories, Alternative (Television programs)"}}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Histories, Alternative (Television programs)"}}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Alternate histories (Television programs)"}}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Alternate histories (Television programs)"}}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Uchronias (Television programs)"}}, {"@id": "_:n1bfd7bed02184404ad26a22863d9b9f2b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Uchronias (Television programs)"}}], "@id": "/authorities/genreForms/gf2015026109"}
