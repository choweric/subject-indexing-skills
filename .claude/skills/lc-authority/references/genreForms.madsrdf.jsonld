{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026059", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aZombie drama", "identifiers:lccn": "gf2018026059", "madsrdf:adminMetadata": [{"@id": "_:nfd3d635a02ba4716b972a8487028887ab1"}, {"@id": "_:nfd3d635a02ba4716b972a8487028887ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Zombie drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfd3d635a02ba4716b972a8487028887ab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026044"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026128"}], "madsrdf:hasSource": [{"@id": "_:nfd3d635a02ba4716b972a8487028887ab5"}, {"@id": "_:nfd3d635a02ba4716b972a8487028887ab6"}, {"@id": "_:nfd3d635a02ba4716b972a8487028887ab7"}, {"@id": "_:nfd3d635a02ba4716b972a8487028887ab8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfd3d635a02ba4716b972a8487028887ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:25:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nfd3d635a02ba4716b972a8487028887ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-05-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nfd3d635a02ba4716b972a8487028887ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zombie drama"}}, {"@id": "_:nfd3d635a02ba4716b972a8487028887ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 194 (zombie plays)"}, "madsrdf:citationSource": "The written dead : essays on the literary zombie, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd3d635a02ba4716b972a8487028887ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kelly, T. The zombie : a stage thriller in three acts, \u00a91983.", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd3d635a02ba4716b972a8487028887ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 38 (zombie stage plays)"}, "madsrdf:citationSource": "Kee, C. Not your average zombie, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfd3d635a02ba4716b972a8487028887ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a comedy play) p. 4 of cover (\"London, 1599. Shakespeare's 'Henry V' opens the Globe Playhouse, but while the actors strut and fret, an excess of bile plagues the populace outside. ... when the company's costumer is bitten by a plague-ridden madman, and the Queen and her men arrive seeking safety, life in the playhouse takes a turn for the worse. As the affliction spreads through London, the Globe is placed in quarantine and the survivors within must fight for their lives. Can they escape? Is there a cure? Is artistic integrity ever worth dying for? A true and accurate account of the Elizabethan zombie plague.\")"}, "madsrdf:citationSource": "Work cat.: Heimbuch, J. William Shakespeare's land of the dead : a true and accurate account of the 1599 zombie plague, \u00a92012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026059"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026060", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCommedia erudita", "identifiers:lccn": "gf2018026060", "madsrdf:adminMetadata": [{"@id": "_:n806684726a0745549b560c23aa1c4941b1"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Commedia erudita"}, "madsrdf:elementList": {"@list": [{"@id": "_:n806684726a0745549b560c23aa1c4941b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, "madsrdf:hasSource": [{"@id": "_:n806684726a0745549b560c23aa1c4941b5"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b6"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b7"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b8"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b9"}], "madsrdf:hasVariant": {"@id": "_:n806684726a0745549b560c23aa1c4941b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n806684726a0745549b560c23aa1c4941b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-03T13:39:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-05-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Commedia erudita"}}, {"@id": "_:n806684726a0745549b560c23aa1c4941b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(commedia erudita: In 16th-century Italy, a more scholarly version of the commedia dell'arte; representative play is Machiavelli's La Mandragola (1520); other writers in the genre were Bernardo Bibbiena, Pietro Aretino, Giambattista Della Porta, and Lodovico Ariosto)"}, "madsrdf:citationSource": "The Methuen Drama dictionary of the theatre, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(commedia erudita: An Italian theatrical form of the 16th century, a more scholarly counterpart to the commedia dell'arte. Unlike the commedia dell'arte, the commedia erudita was based upon written scripts (derived largely from the comedies of Plautus and Terence) and was intended for performance before educated audiences)"}, "madsrdf:citationSource": "The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Commedia erudita; 16th-century Italian dramatic form; unlike its theatrical contemporary, the vernacular and improvisational commedia dell'arte, it followed scripts written in Latin or Italian that were based on the scholarly works of earlier Italian and ancient Roman authors; language used in the commedia erudita was not easily comprehensible to the general public)"}, "madsrdf:citationSource": "Encyclop\u00e6dia Britannica online, May 10, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an example of commedia erudita)"}, "madsrdf:citationSource": "Work cat.: Machiavelli, N. Mandragola. English (Shawn). The mandrake, 1978", "madsrdf:citationStatus": "found"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Commedia erudita. 'Learned comedy'. The written comedy of Italy in the early sixteenth century, as compared with the improvised Commedia dell'Arte. A realistic and sardonic form of comedy, best represented perhaps by La Mandragola (c. 1518) by Machiavelli and I Suppositi (1509) by Ariosto)"}, "madsrdf:citationSource": "Hodgson, T. The drama dictionary, \u00a91988", "madsrdf:citationStatus": "found"}, {"@id": "_:n806684726a0745549b560c23aa1c4941b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n806684726a0745549b560c23aa1c4941b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Erudita, Commedia"}}, {"@id": "_:n806684726a0745549b560c23aa1c4941b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Erudita, Commedia"}}], "@id": "/authorities/genreForms/gf2018026060"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026061", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNagauta", "identifiers:lccn": "gf2018026061", "madsrdf:adminMetadata": [{"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb1"}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nagauta"}, "madsrdf:elementList": {"@list": [{"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026888"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}], "madsrdf:hasSource": [{"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb5"}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb6"}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb7"}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb8"}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-03T13:39:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-05-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nagauta"}}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (shamisen music form; art music form) p. 16, etc. (kabuki nagauta; kabuki dance-form; nagauta music; major division of nagauta is between compositions that are primarily dance pieces and those which are lyric works; in 19th century there was a movement toward concert music, ozashiki-nagauta, that was not composed for kabuki but for separate non-dance performances)"}, "madsrdf:citationSource": "Malm, W.P. Nagauta : the heart of kabuki music, 1963:", "madsrdf:citationStatus": "found"}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nagauta. BT Ballads, Japanese. BT Songs, Japanese)"}, "madsrdf:citationSource": "LCSH, May 11, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nagauta (Japanese: \"long song\"), basic lyric musical accompaniment of Japanese Kabuki and classical dances (buy\u014d). The genre is found in the Kabuki plays by the mid-17th century; standard complete instrumentation of a nagauta piece consists of singers; players of the three-stringed, plucked samisen; and performers on the three drums and flute found in the hayashi ensemble of the earlier N\u014d theatre. In nagauta the flute player may also use a second bamboo flute (take-bue) derived from folk traditions. The drums play both the stereotyped patterns found in the N\u014d style and more direct imitations of the rhythmic phrases of the samisen)"}, "madsrdf:citationSource": "Encyclop\u00e6dia Britannica online, May 11, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Kineya, Yashichi. Echigo-jishi : nagauta, 1952.", "madsrdf:citationStatus": "found"}, {"@id": "_:n889bc5321865437cbaaf57ca97a75d8eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nagauta; type of vocal music with shamisen accompaniment; the nagauta \"long song\" genre; The terms nagauta (\"long songs\") and kouta were used in earlier periods for a variety of poetic forms but eventually became specific genre names. Both terms were connected with early forms of shamisen music in the new kabuki theatre, edo nagauta eventually becoming its predominant genre)"}, "madsrdf:citationSource": "Grove music online, May 11, 2018", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026061"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026062", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBisexual comics", "identifiers:lccn": "gf2018026062", "madsrdf:adminMetadata": [{"@id": "_:na90e619f46b34a058fff3df1085fd6ebb1"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bisexual comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:na90e619f46b34a058fff3df1085fd6ebb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026162"}, "madsrdf:hasSource": [{"@id": "_:na90e619f46b34a058fff3df1085fd6ebb5"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb6"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb7"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb8"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb9"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb10"}], "madsrdf:hasVariant": {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics featuring bisexual characters or addressing bisexual themes."}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-05-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "revised"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bisexual comics"}}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic memoir; LCSH assigned: Fitzgerald, Meags, 1987- --Childhood and youth--Comic books, strips, etc.; Bisexual youth--Canada--Biography--Comic books, strips, etc.)"}, "madsrdf:citationSource": "Fitzgerald, M. Long red hair, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a graphic memoir)"}, "madsrdf:citationSource": "Work cat.: Beier, E. The big book of bisexual trials and errors, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (\"From confessional, personal accounts to erotic flights of fancy to undersea identity politics, this collection of comics invites the reader to step outside of the categories and explore the wild and wonderful uncharted territory between 'gay' and 'straight'\"; LCSH assigned: Bisexuals--Comic books, strips, etc.; Bisexual women--Comic books, strips, etc.; Bisexual men--Comic books, strips, etc.)"}, "madsrdf:citationSource": "Anything that loves : comics beyond \"gay\" and \"straight\", July 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a comic book)"}, "madsrdf:citationSource": "Wallace, M. J. (Comic artist). Bi the way, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 188 (bisexual comics)"}, "madsrdf:citationSource": "Arizona journal of Hispanic cultural studies, v. 1 (1997), viewed via JSTOR, May 15, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 48 (lesbian/bi comics)"}, "madsrdf:citationSource": "Deneuve, v. 4 (1994), via Google books, viewed May 15, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na90e619f46b34a058fff3df1085fd6ebb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bi comics"}}, {"@id": "_:na90e619f46b34a058fff3df1085fd6ebb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bi comics"}}], "@id": "/authorities/genreForms/gf2018026062"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026063", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTransgender comics", "identifiers:lccn": "gf2018026063", "madsrdf:adminMetadata": [{"@id": "_:n12d3feb08310455581fb011b64e6660bb1"}, {"@id": "_:n12d3feb08310455581fb011b64e6660bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Transgender comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n12d3feb08310455581fb011b64e6660bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026162"}, "madsrdf:hasSource": [{"@id": "_:n12d3feb08310455581fb011b64e6660bb5"}, {"@id": "_:n12d3feb08310455581fb011b64e6660bb6"}, {"@id": "_:n12d3feb08310455581fb011b64e6660bb7"}], "madsrdf:hasVariant": {"@id": "_:n12d3feb08310455581fb011b64e6660bb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics featuring transgender characters or addressing transgender themes."}, {"@id": "_:n12d3feb08310455581fb011b64e6660bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-05-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n12d3feb08310455581fb011b64e6660bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "revised"}, {"@id": "_:n12d3feb08310455581fb011b64e6660bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transgender comics"}}, {"@id": "_:n12d3feb08310455581fb011b64e6660bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (\"Transposes separates gender from sexuality and illustrates six fascinating true stories of transgender men who also happen to be queer.\")"}, "madsrdf:citationSource": "Work cat.: Edwards, Dylan (Cartoonist). Transposes, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n12d3feb08310455581fb011b64e6660bb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "We're still here : an all-trans comics anthology, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:n12d3feb08310455581fb011b64e6660bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. 4 of cover (\"Shuichi Nitori and his new friend Yoshino Takatsuki ... share a secret that further complicates a time of life that is awkward for anyone: Shuichi is a boy who wants to be a girl, and Yoshino is a girl who wants to be a boy.\") publisher's web page for v. 2 (\"In the second volume of Shimura Takako's superb coming-of-age story, our transgendered protagonists, Shuichi and Yoshino, have entered the sixth grade.\") publisher's web page for v. 5 (\"In this volume of the acclaimed series about transgendered kids exploring their unfolding identities, we've reached a big event; the junior high school entrance ceremony.\")"}, "madsrdf:citationSource": "Shimura, Takako. H\u014dr\u014d musuko. English. Wandering son, 2011- :", "madsrdf:citationStatus": "found"}, {"@id": "_:n12d3feb08310455581fb011b64e6660bb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n12d3feb08310455581fb011b64e6660bb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trans comics"}}, {"@id": "_:n12d3feb08310455581fb011b64e6660bb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trans comics"}}], "@id": "/authorities/genreForms/gf2018026063"}
