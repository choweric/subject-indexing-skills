{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026709", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrick films", "identifiers:lccn": "gf2011026709", "madsrdf:adminMetadata": [{"@id": "_:n037108c94655474eaccf446e40903a74b1"}, {"@id": "_:n037108c94655474eaccf446e40903a74b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trick films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n037108c94655474eaccf446e40903a74b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n037108c94655474eaccf446e40903a74b5"}, {"@id": "_:n037108c94655474eaccf446e40903a74b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Heading for short films from the early years of cinema that emphasize apparent transformations through the use of trick photography or special optical effects.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025210"}}, {"@id": "_:n037108c94655474eaccf446e40903a74b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:05:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n037108c94655474eaccf446e40903a74b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n037108c94655474eaccf446e40903a74b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trick films"}}, {"@id": "_:n037108c94655474eaccf446e40903a74b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trick film; trick films are essentially special effects films, although the term trick film is usually restricted to films which make extensive use of trick photography or special optical effects such as stop motion, fast and slow motion, multiple exposure and the use of mattes)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n037108c94655474eaccf446e40903a74b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trick films; use for films made during the period of early cinema, up to ca. 1907, in which apparent transformations occur, primarily through the use of camera techniques)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026709"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026710", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrigger films", "identifiers:lccn": "gf2011026710", "madsrdf:adminMetadata": [{"@id": "_:n1f7d18a52b4846e79ac2fea74605e780b1"}, {"@id": "_:n1f7d18a52b4846e79ac2fea74605e780b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trigger films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1f7d18a52b4846e79ac2fea74605e780b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026570"}, "madsrdf:hasSource": [{"@id": "_:n1f7d18a52b4846e79ac2fea74605e780b5"}, {"@id": "_:n1f7d18a52b4846e79ac2fea74605e780b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Open-ended films that are designed to spark a discussion on a controversial or difficult problem or issue.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025372"}}, {"@id": "_:n1f7d18a52b4846e79ac2fea74605e780b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n1f7d18a52b4846e79ac2fea74605e780b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:05:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1f7d18a52b4846e79ac2fea74605e780b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trigger films"}}, {"@id": "_:n1f7d18a52b4846e79ac2fea74605e780b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trigger film SEE factual film-- trigger film: Trigger films are open-ended dramatic shorts meant to start a discussion by stimulating the viewers into finding a possible answer to some vital issue or problem of difficult solution. The concept of the trigger film was initiated in the 1960s at the University of Michigan)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1f7d18a52b4846e79ac2fea74605e780b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trigger: Nonfiction short work that is open-ended and designed to spark a discussion on a controversial or difficult problem or issue, predominantly sponsored and educational in nature)"}, "madsrdf:citationSource": "Moving image genre-form guide via WWW, July 19, 2007:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026710"}
