: {"@language": "en", "@value": "(Passacaglia: continuous variation form, principally of the Baroque, whose basso ostinato formulas originally derived from ritornellos to early 17th-century songs; developed in a way quite similar to the chaconne)"}, "madsrdf:citationSource": "New Harvard dict. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:n937df1be34a14ba98e0c8071d329e87db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Passacaglia: in 19th- and 20th-century music, a set of ground-bass or ostinato variations, usually of a serious character; in the earliest sources, a short, improvised ritornello between the strophes of a song; the term is sometimes used interchangeably with \"chaconne\")"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Nov. 15, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n937df1be34a14ba98e0c8071d329e87db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(passacaglia: through-composed variation form constructed over formal harmonic progressions, used widely in the Baroque era but with origins in the Spanish street dance, the pasacalle; like the chaconne, which also used specific basso ostinato formulas, the passacaglia became a separately identifiable extended late Baroque form; in both French and German music the term was often confounded with \"chaconne,\" in spite of attempts by several theorists to distinguish the two)"}, "madsrdf:citationSource": "Oxf. comp. mus., 2002", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026989"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026990", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPassamezzos (Music)", "identifiers:lccn": "gf2014026990", "madsrdf:adminMetadata": [{"@id": "_:n4fc157794d104de68efd334caa12784db1"}, {"@id": "_:n4fc157794d104de68efd334caa12784db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Passamezzos (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4fc157794d104de68efd334caa12784db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:n4fc157794d104de68efd334caa12784db5"}, "madsrdf:hasVariant": [{"@id": "_:n4fc157794d104de68efd334caa12784db6"}, {"@id": "_:n4fc157794d104de68efd334caa12784db9"}, {"@id": "_:n4fc157794d104de68efd334caa12784db12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4fc157794d104de68efd334caa12784db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n4fc157794d104de68efd334caa12784db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4fc157794d104de68efd334caa12784db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Passamezzos (Music)"}}, {"@id": "_:n4fc157794d104de68efd334caa12784db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Passamezzo [also passing measures, passy-measures], pass'e mezzo [also pass'e mezzo, passo e mezo, passomezo]. An Italian dance of the 16th and early 17th centuries similar to a pavana.)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4fc157794d104de68efd334caa12784db6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fc157794d104de68efd334caa12784db7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Passing measures (Music)"}}, {"@id": "_:n4fc157794d104de68efd334caa12784db7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Passing measures (Music)"}}, {"@id": "_:n4fc157794d104de68efd334caa12784db9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fc157794d104de68efd334caa12784db10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pass'e mezzi (Music)"}}, {"@id": "_:n4fc157794d104de68efd334caa12784db10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pass'e mezzi (Music)"}}, {"@id": "_:n4fc157794d104de68efd334caa12784db12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4fc157794d104de68efd334caa12784db13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Passy-measures (Music)"}}, {"@id": "_:n4fc157794d104de68efd334caa12784db13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Passy-measures (Music)"}}], "@id": "/authorities/genreForms/gf2014026990"}
