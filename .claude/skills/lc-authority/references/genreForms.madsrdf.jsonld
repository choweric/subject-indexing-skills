{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026134", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCin\u00e9ma v\u00e9rit\u00e9 films", "identifiers:lccn": "gf2011026134", "madsrdf:adminMetadata": [{"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb1"}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cin\u00e9ma v\u00e9rit\u00e9 films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026205"}, "madsrdf:hasSource": [{"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb5"}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb6"}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb7"}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb8"}], "madsrdf:hasVariant": [{"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb9"}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025001"}}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-23T16:13:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cin\u00e9ma v\u00e9rit\u00e9 films"}}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cin\u00e9ma v\u00e9rit\u00e9: (French: \"truth cinema\"), French film movement of the 1960s that showed people in everyday situations with authentic dialogue and naturalness of action)"}, "madsrdf:citationSource": "Britannica online, July 24, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cinema Verit\u00e9. Literally: Cinema Truth. A documentary style in which no directorial control is exerted. The term is frequently misused to describe new-wave \"handheld\" camera techniques.)"}, "madsrdf:citationSource": "Internet movie database film glossary, via WWW, Jan. 22, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mamber, S. Cinema verite in America : studies in uncontrolled documentary, 1974.", "madsrdf:citationStatus": "found"}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pkg. (The cin\u00e9ma v\u00e9rit\u00e9 (or direct cinema) movement of the '50s and '60s was driven by a group of rebel filmmakers tired of stilted documentaries. They wanted to show life as it really is: raw, gritty, dramatic.)"}, "madsrdf:citationSource": "Work cat.: Cin\u00e9ma v\u00e9rit\u00e9 [VR] : defining the moment, c1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nab9a03e891ee4b7c9761ddb3484c76fcb10