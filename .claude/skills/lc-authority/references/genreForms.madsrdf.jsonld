15afd2283b7efb48"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Books intended for travelers that provide information about a particular geographical location, often including descriptions of lodgings, restaurants, and places of interest."}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:25:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Guidebooks"}}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Index, points of interest listed in AAA tour books, 1964.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(series: Frommer's driving tour guides)"}, "madsrdf:citationSource": "America's best-loved driving tours, 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(travel guidebooks. Guidebooks aimed particularly at tourists or other leisure travelers. UF travel guides; holiday guides)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(travel guide: A handbook designed for persons interested in touring a foreign country or an unfamiliar city, state, province, or region of their own country. In addition to describing major attractions, most travel guides include maps and directions, information about dining and overnight accommodations, and advice about currency exchange, immunizations, personal safety, and communication with the local inhabitants. Some guides specialize in a particular type of travel, such as bicycle touring or ecotourism.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Frommer's touring guides. Hong Kong, Singapore, and Macau, 1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(series: Australian tourguides)"}, "madsrdf:citationSource": "Accommodation guide, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lewensohn, A. Israel tourguide, 1979.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Tourbook. Ontario, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "South African Tourism Board. Tourist guide : directory South Africa, 1996.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Frommer's touring guides. Turkey, 1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(--Guidebooks. UF --Guide-books. Use as a form subdivision under names of countries, cities, etc., individual corporate bodies and parks, etc., and under topical headings.)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb16", "@type": "madsrdf:Source", "madsrdf:citationSource": "Tourbook guide. Arizona & New Mexico, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 47 (guide: manual on a specified subject; manual on a city; guide book: book for the guidance of visitors)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tour guides (Publications)"}}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tour guides (Publications)"}}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tourbooks"}}, {"@id": "_:nd11a9e55bb1e411d86f15afd2283b7efb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tourbooks"}}, {"@id": 