{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026946", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMornas (Music)", "identifiers:lccn": "gf2014026946", "madsrdf:adminMetadata": [{"@id": "_:nbeeccdf579044e1ab0ea459ac9344479b1"}, {"@id": "_:nbeeccdf579044e1ab0ea459ac9344479b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mornas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbeeccdf579044e1ab0ea459ac9344479b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nbeeccdf579044e1ab0ea459ac9344479b5"}, {"@id": "_:nbeeccdf579044e1ab0ea459ac9344479b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbeeccdf579044e1ab0ea459ac9344479b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbeeccdf579044e1ab0ea459ac9344479b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbeeccdf579044e1ab0ea459ac9344479b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mornas (Music)"}}, {"@id": "_:nbeeccdf579044e1ab0ea459ac9344479b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2011562960: Silva, A. Quejas, Tchufe, e Lobo, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbeeccdf579044e1ab0ea459ac9344479b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cape Verde. 1. European-influenced music and dance forms. Morna; music and dance genre; defining characteristics: a moderate tempo in quadruple time; a strophic structure; a sustained, legato melody sung or played by a soloist, usually a violinist; syncopated rhythmic accompaniment figures played by a small four-string guitar (cavaquinho); melodic variations and rhythmic support played on the violin and guitar; and a bass line played on the guitar)"}, "madsrdf:citationSource": "New Grove online, July 18, 2011", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026946"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026947", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMorning service music", "identifiers:lccn": "gf2014026947", "madsrdf:adminMetadata": [{"@id": "_:n161be6d9818f431e9ebd42fd586e65bdb1"}, {"@id": "_:n161be6d9818f431e9ebd42fd586e65bdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Morning service music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n161be6d9818f431e9ebd42fd586e65bdb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026906"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026979"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n161be6d9818f431e9ebd42fd586e65bdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n161be6d9818f431e9ebd42fd586e65bdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n161be6d9818f431e9ebd42fd586e65bdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Morning service music"}}], "@id": "/