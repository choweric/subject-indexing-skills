{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026290", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGangster films", "identifiers:lccn": "gf2011026290", "madsrdf:adminMetadata": [{"@id": "_:nc9be7e865a654a9bac207bd460724cffb1"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gangster films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc9be7e865a654a9bac207bd460724cffb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026177"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:nc9be7e865a654a9bac207bd460724cffb5"}, "madsrdf:hasSource": [{"@id": "_:nc9be7e865a654a9bac207bd460724cffb8"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb9"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb10"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb11"}], "madsrdf:hasVariant": [{"@id": "_:nc9be7e865a654a9bac207bd460724cffb12"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb15"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb18"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb21"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb24"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb27"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb30"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb33"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb36"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb39"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb42"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb45"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb48"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026301"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025236"}]}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-03-04T16:57:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gangster films"}}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9be7e865a654a9bac207bd460724cffb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Godfather films"}}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Godfather films"}}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gangster; RT: Caper, Crime, Film noir, Mystery, Police, and Thriller)"}, "madsrdf:citationSource": "Moving image genre-form guide online, February 11, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gangster drama. Use for fictional genre films and programs which tend to be set in the city and focus on organized crime. However, include fictional genre films on the so-called \"rural bandits\" who drive about the countryside, e.g. robbing banks. UF Gangster films, Hoodlum drama, Mafia drama, Organized crime drama, Rural bandit drama. BT Crime drama. RT Film noir, Yakuza-eiga)"}, "madsrdf:citationSource": "Yee, M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Yakuza Film (Yakuza-Eiga). The yakuza-eiga are contemporary Japanese gangster films, a new genre that appeared in 1964 with the film Bakuto/Gambler, acknowledged as being the first genuine yakuza film. The yakuza films evolved from the samurai films; Yakuza movies are different from Western gangster films. The Japanese gangster film is a strictly regulated and formulaic genre, and the gangsters are motivated by a code of behavior which all too often is responsible for the internal conflict of the yakuza)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 124-128 (Gangster Film (Gang Film). A violent, well-documented genre. The gangster movie is rich in iconography and populated by well-defined gangster variants, e.g., the bootlegger, the racketeer, the hitman, or complementary characters--the moll, the shyster, the G-man, the hoodlum; subgenres: Black Gangster Films; Boxing Gangster Films; Cop Movies; Expos\u00e9 Films; Film Noir; Gangster Biographies; Gangster Comedies; Gangster Musicals; G-Man Films; Heist Films (Caper Films); Hostage-Holding Gangster Movies; Outlaw Gangster Films (Bandit Gangster Films, Outlaw-Couple Films); Prison Films; Syndicate Films (Gangland Films, Organized-Crime Films, Syndicate-Oriented Films); Vigilante Films) pp. 173-174 (Mafia Films; usually included in the gangster genre)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9be7e865a654a9bac207bd460724cffb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Organized crime films"}}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Organized crime films"}}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9be7e865a654a9bac207bd460724cffb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Outlaw-couple films"}}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Outlaw-couple films"}}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9be7e865a654a9bac207bd460724cffb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Yakuza films"}}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yakuza films"}}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9be7e865a654a9bac207bd460724cffb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Syndicate-oriented films"}}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Syndicate-oriented films"}}, {"@id": "_:nc9be7e865a654a9bac207bd460724cffb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9be7e865a654a9bac207bd460724cffb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Godfather films"}}, {"@id":