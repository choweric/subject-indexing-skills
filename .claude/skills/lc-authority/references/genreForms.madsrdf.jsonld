{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026037", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPolitical posters", "identifiers:lccn": "gf2017026037", "madsrdf:adminMetadata": [{"@id": "_:n85faac4761614883aec4e765343c3fd3b1"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Political posters"}, "madsrdf:elementList": {"@list": [{"@id": "_:n85faac4761614883aec4e765343c3fd3b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026152"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026038"}], "madsrdf:hasSource": [{"@id": "_:n85faac4761614883aec4e765343c3fd3b5"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b6"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b7"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b8"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b9"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b10"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b11"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b12"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b13"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b14"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b15"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b16"}], "madsrdf:hasVariant": [{"@id": "_:n85faac4761614883aec4e765343c3fd3b17"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b20"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b23"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b26"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b29"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T12:54:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-02-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Political posters"}}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "H\u00ecnh t\u01b0\u1ee3ng ph\u1ee5 n\u1eef Vi\u1ec7t Nam trong tranh c\u1ecf\u0302 \u0111\u1ed9ng giai \u0111o\u1ea1n 1954-1975 = Images of Vietnamese women in propaganda posters (1954-1975), 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Gosudarstvennai\ufe20a\ufe21 biblioteka SSSR imeni V.I. Lenina. The Soviet political poster, 1917-1980, 1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Decade of protest : political posters from the United States, Viet Nam, Cuba 1965-1975, 1996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(39 posters in the Bancroft Library, University of California, Berkeley)"}, "madsrdf:citationSource": "British political campaign posters, ca. 1935-ca. 1945", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(approximately 175 posters advertising local, state, and national election campaigns in the New York City area from 1898 to 1976; in the New York Public Library)"}, "madsrdf:citationSource": "Election campaign posters, 1898-1976", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Political posters. UF Campaign posters. BT Political collectibles; Posters)"}, "madsrdf:citationSource": "LCSH, Feb. 19, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Make art not war : political protest posters from the twentieth century, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(100 posters 44 x 28 cm, in box 46 x 31 x 2 cm; published by Justseeds Artists' Cooperative) Justseeds Artists' Cooperative website, Aug. 4, 2016 (\"This cloth-bound box set documents the first 18 years and 100 posters in the Celebrate People's History Poster series. The posters are rooted in the do-it-yourself tradition of mass-produced and distributed political propaganda, but detourned to embody principles of democracy, inclusion, and group participation in the writing and interpretation of history. It's rare today that a political poster is celebratory, and when it is, it almost always focuses on a small canon of male individuals: MLK, Ghandi, Che, or Mandela. Rather than create another exclusive set of heroes, I've generated a diverse set of posters that bring to life successful moments in the history of social justice struggles. To that end, I've asked artists and designers to find events, groups, and people who have moved forward the collective struggle of humanity to create a more equitable and just world. The posters tell stories from the subjective position of the artists, and are often the stories of underdogs, those written out of history. The goal of this project is not to tell a definitive history, but to suggest a new relationship to the past\")"}, "madsrdf:citationSource": "Work cat.: MacPhee, Josh. Celebrate people's history : 100 posters, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(political posters. Note: Posters promoting election campaigns or other political publicity. UF campaign posters. BT Posters)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Feb. 19, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Political posters. Scope note: Includes election campaign posters as well as posters about such social-political issues as the environment, health care, and civil rights. Also includes propaganda posters. UF Campaign posters; Election posters; Propaganda posters. BT Posters. NT Protest posters. RT War posters)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Feb. 19, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Chinese propaganda posters, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b16", "@type": "madsrdf:Source", "madsrdf:citationSource": "Library of Congress. Presidential campaign posters from the Library of Congress, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n85faac4761614883aec4e765343c3fd3b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Political campaign posters"}}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Political campaign posters"}}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n85faac4761614883aec4e765343c3fd3b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Campaign posters"}}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Campaign posters"}}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n85faac4761614883aec4e765343c3fd3b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Election campaign posters"}}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Election campaign posters"}}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n85faac4761614883aec4e765343c3fd3b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Political propaganda posters"}}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Political propaganda posters"}}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n85faac4761614883aec4e765343c3fd3b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Election posters"}}, {"@id": "_:n85faac4761614883aec4e765343c3fd3b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Election posters"}}], "@id": "/authorities/genreForms/gf2017026037"}
