1-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nea99c8650b8046bbb82ed34653229a2ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Religious films"}}, {"@id": "_:nea99c8650b8046bbb82ed34653229a2ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 82 (Religious films and video: use for films and programs (both fiction and nonfiction) clearly designed to promote a religious point of view)"}, "madsrdf:citationSource": "Yee, Martha M. Moving image materials : genre terms, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nea99c8650b8046bbb82ed34653229a2ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 250 (Religious films: The label religious films has two broad acceptations...it is a motion picture which revolves around an easily recognizable religious subject...the label obviously applies to any established religion...a religious film is also understood as being a film of religious inspiration and fervor, not necessarily on an obvious religious subject)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nea99c8650b8046bbb82ed34653229a2ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Religious: fictional work designed to demonstrate the positive (and, less often, negative) power of spirituality and redemption through religious faith; Religion: non-dramatized work such as lectures or discussions on religious topics, or worship services, ministries, sermons, revivals, miracles, or interpretations of contemporary issues, such as creationism. The \"nonfiction\" label refers simply to style of presentation and is not evaluative, referring purely to the technique used)"}, "madsrdf:citationSource": "Moving image genre-form guide online, Apr. 20, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nea99c8650b8046bbb82ed34653229a2ab8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nea99c8650b8046bbb82ed34653229a2ab9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Religion films"}}, {"@id": "_:nea99c8650b8046bbb82ed34653229a2ab9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Religion films"}}], "@id": "/authorities/genreForms/gf2011026526"}
