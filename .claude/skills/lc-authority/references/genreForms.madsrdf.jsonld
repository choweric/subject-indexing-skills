alue": "2015-12-07T16:29:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nafe6b174aac741bcbb871cdea383a6afb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Personal narratives"}}, {"@id": "_:nafe6b174aac741bcbb871cdea383a6afb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(--Personal narratives. Use as a form subdivision under names of events and wars.)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nafe6b174aac741bcbb871cdea383a6afb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Personal Narratives. Scope Note: Verbal accounts, usually in the first person, of an individual's experiences, thoughts, and feelings. UF Personal Accounts (Narratives). BT Reports)"}, "madsrdf:citationSource": "ERIC thesaurus, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nafe6b174aac741bcbb871cdea383a6afb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Narratives. Scope Note: Use for works containing an account of events, experiences, etc., whether true or fictitious. BT Literary forms (Gathering term; do not assign). NT Captivity narratives; Conversion narratives; Epics; Maritime journals; Miracle narratives; Overland journals; Slave narratives; Survivors' narratives)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nafe6b174aac741bcbb871cdea383a6afb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nafe6b174aac741bcbb871cdea383a6afb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Narratives, Personal"}}, {"@id": "_:nafe6b174aac741bcbb871cdea383a6afb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Narratives, Personal"}}, {"@id": "_:nafe6b174aac741bcbb871cdea383a6afb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nafe6b174aac741bcbb871cdea383a6afb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Personal accounts (Narratives)"}}, {"@id": "_:nafe6b174aac741bcbb871cdea383a6afb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Personal accounts (Narratives)"}}], "@id": "/authorities/genreForms/gf2014026142"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026143", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPhoticular books", "identifiers:lccn": "gf2014026143", "madsrdf:adminMetadata": [{"@id": "_:nd2dedf41b19f4d0d87eb90d3731f96afb1"}, {"@id": "_:nd2dedf41b19f4d0d87eb90d3731f96afb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Photicular books"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd2dedf41b19f4d0d87eb90d3731f96afb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026197"}, "madsrdf:hasSource": [{"@id": "_:nd2dedf41b19f4d0d87eb90d3731f96afb5"}, {"@id": "_:nd2dedf41b19f4d0d87eb90d3731f96afb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that use a lenticular-based technology to transfer fluid four-color movies onto a book."}, {"@id": "_:nd2dedf41b19f4d0d87eb90d3731f96afb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd2dedf41b19f4d0d87eb90d3731f96afb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:29:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd2dedf41b19f4d0d87eb90d3731f96afb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photicular books"}}, {"@id": "_:nd2dedf41b19f4d0d87eb90d3731f96afb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (Photicular imaging is an old technology--\"lenticular\" or \"integrated\" photography, done in a new way. Individual video frames are sliced into very thin, adjacent strips to create one master-image. On its own, it just looks blurry, as if all the images were overlapped, but slide a sheet of thin lenses over the master-image--and it comes alive in fluid, film-like motion.)"}, "madsrdf:citationSource": "Safari : a photicular book , 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd2dedf41b19f4d0d87eb90d3731f96afb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Photicular books. BT Toy and movable books)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026143"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026144", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPhotobooks", "identifiers:lccn": "gf2014026144", "madsrdf:adminMetadata": [{"@id": "_:n441e4815b4c04de3b27498dbf14a2242b1"}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Photobooks"}, "madsrdf:elementList": {"@list": [{"@id": "_:n441e4815b4c04de3b27498dbf14a2242b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026102"}, "madsrdf:hasSource": [{"@id": "_:n441e4815b4c04de3b27498dbf14a2242b5"}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b6"}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b7"}], "madsrdf:hasVariant": [{"@id": "_:n441e4815b4c04de3b27498dbf14a2242b8"}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works illustrated by reproduced or original photographs, with or without text, in which the essential information is conveyed by the images."}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:29:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photobooks"}}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(photobooks. UF photo books; photo-books. A book with or without text where the essential information is conveyed through a collection of photographic images. This may be authored by one or more artists or photographers, or arranged by an editor. Generally the images in a photobook are meant to be viewed in context, as parts of a larger whole. Most often used to refer to mechanically reproduced and commercially distributed works. For albums made up of mounted photographic prints, with or without identifying information, use \"photograph albums.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Photobooks. UF Photo-books. BT Illustrated books. RT Photograph albums)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, introd. (a book, with or without text, where the work's primary message is carried by photographs)"}, "madsrdf:citationSource": "The photobook : a history, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n441e4815b4c04de3b27498dbf14a2242b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photo-books"}}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photo-books"}}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n441e4815b4c04de3b27498dbf14a2242b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photograph books"}}, {"@id": "_:n441e4815b4c04de3b27498dbf14a2242b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photograph books"}}], "@id": "/authorities/genreForms/gf2014026144"}
