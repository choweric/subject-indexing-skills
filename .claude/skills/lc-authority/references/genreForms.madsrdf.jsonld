1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:34:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quotations"}}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: The essential book of quotations; The Yale book of quotations; The archaeologist's book of quotations; The Margaret Thatcher book of quotations; The Oxford dictionary of quotations; A treasury of Jewish quotations; Familiar quotations; The movie quote book; The librarian's book of quotes; The Indiana book of quotes; Tea wisdom : inspirational quotes and quips about the world's most celebrated beverage; The educator's book of quotes; A book of misquotations; What they didn't say : a book of misquotations; Common misquotations; They never said it : a book of fake quotes, misquotes, and misleading attributions; Brewer's famous quotations; A dictionary of famous quotations; Famous quotes from 100 great people; 101 famous quotes from Alice in wonderland; Bloomsbury treasury of quotations; Oxford treasury of sayings and quotations; Phillips' treasury of humorous quotations; Lee's treasury of music quotations; A treasury of biblical quotations; A treasury of memorable quotations; Memorable quotations of Franklin D. Roosevelt; Memorable quotations : American women writers of the past; Memorable quotations : humorists, wits, and satirists of the past)"}, "madsrdf:citationSource": "OCLC, Aug. 7, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(quotation: Words or passages reproduced from a written work or repeated verbatim from an oral statement. A passage quoted incorrectly is a misquotation. Collections of literary quotations are available in the reference section of most libraries. In printing, brief quotations are set in the text, enclosed in \"quotation marks.\" Long quotations, called block quotations, are set apart from the main text by indention and/or printed in a smaller type size without quotation marks, preceded and followed by a blank line. A very long quotation is an excerpt. Synonymous with quote.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 7, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Quotations. BT Reference works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(quotations (texts). Excerpts of parts of a literary composition, as into another book or writing; use also for statements of market price of one or more securities; quotations (visual concepts). References to past visual art in another work of visual art.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 67 (quotation: quoted passage or remark)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf25a6d9e858946e884fa344913e5fc89b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Famous quotations"}}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Famous quotations"}}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf25a6d9e858946e884fa344913e5fc89b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Treasuries of quotations"}}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Treasuries of quotations"}}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf25a6d9e858946e884fa344913e5fc89b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quotation treasuries"}}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quotation treasuries"}}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf25a6d9e858946e884fa344913e5fc89b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Misquotes"}}, {"@id": "_:nf25a6d9e858946e884fa344913e5fc89b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Misquotes"}}, {"