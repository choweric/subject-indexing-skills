bulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n8d8470060c97466cb79bf96f574d4c95b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Beach party films"}}, {"@id": "_:n8d8470060c97466cb79bf96f574d4c95b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beach films (Beach-blanket films, beach blanket party pictures, beach-bunny films, beach party movies, sand-and-surf movies, sun-and-sand flicks). Most of the action in these movies takes place in or around the beach, and films are peopled with beautiful teenagers who are mostly dedicated to gambolling with each other or eyeing the opposite sex)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d8470060c97466cb79bf96f574d4c95b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d8470060c97466cb79bf96f574d4c95b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sun-and-sand films"}}, {"@id": "_:n8d8470060c97466cb79bf96f574d4c95b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sun-and-sand films"}}, {"@id": "_:n8d8470060c97466cb79bf96f574d4c95b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d8470060c97466cb79bf96f574d4c95b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sand-and-surf films"}}, {"@id": "_:n8d8470060c97466cb79bf96f574d4c95b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sand-and-surf films"}}, {"@id": "_:n8d8470060c97466cb79bf96f574d4c95b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d8470060c97466cb79bf96f574d4c95b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Beach-blanket films"}}, {"@id": "_:n8d8470060c97466cb79bf96f574d4c95b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Beach-blanket films"}}, {"@id": "_:n8d8470060c97466cb79bf96f574d4c95b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d8470060c97466cb79bf96f574d4c95b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Beach-bunny films"}}, {"@id": "_:n8d8470060c97466cb79bf96f574d4c95b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Beach-bunny films"}}], "@id": "/authorities/genreForms/gf2011026083"}
