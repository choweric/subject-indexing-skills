{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026697", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTopographic maps", "identifiers:lccn": "gf2011026697", "madsrdf:adminMetadata": [{"@id": "_:nffb62beda0ed4d36973525fe6150850eb1"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Topographic maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:nffb62beda0ed4d36973525fe6150850eb3"}]}, "madsrdf:exampleNote": "Note under [Physical maps]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026081"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2012025032"}], "madsrdf:hasSource": [{"@id": "_:nffb62beda0ed4d36973525fe6150850eb5"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb6"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb7"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb8"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb9"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb10"}], "madsrdf:hasVariant": [{"@id": "_:nffb62beda0ed4d36973525fe6150850eb11"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb14"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb17"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb20"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Maps that represent the horizontal and vertical locations of natural and man-made features. For maps that represent the surface of the land or floor of the ocean without man-made structures or vegetation see [Physical maps.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025020"}}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:17:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topographic maps"}}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "map, topographic (1. a map showing the horizontal and vertical locations of the natural and man-made features represented. Also called a relief map. Uses numbered contour lines or comparable symbols to show mountains, valleys and plains; 2. a map whose principle purpose is to portray and identify the natural and artificial features on the Earth's surface as faithfully as possible within the limitations imposed by scale)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Search Map (Firm). Singapore topo map 1:30,000, 1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "hypsographic map (a map showing land or submarine bottom relief in terms of height above, or below, a datum by any method, such as contours, hachures, shading, or tinting; also called hypsometric map; SEE FROM relief map)"}, "madsrdf:citationSource": "Glossary of mapping, charting, and geodetic terms, 1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "DeLorme Mapping Company. North Dakota atlas & gazetteer : topo maps of the entire state, back roads, outdoor recreation, c1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: topographic maps)"}, "madsrdf:citationSource": "LCSH, Jan. 9, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(topographic[al] map)"}, "madsrdf:citationSource": "Mayhew, S. The concise Oxford dict. of geography, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffb62beda0ed4d36973525fe6150850eb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hypsographic maps"}}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hypsographic maps"}}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffb62beda0ed4d36973525fe6150850eb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Topo maps"}}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topo maps"}}, {"@id": "_:nffb62beda0ed4d36973525fe6150850eb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n