T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n6828a8aa27aa44bcbdc3459251236c33b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Wordless comics"}}, {"@id": "_:n6828a8aa27aa44bcbdc3459251236c33b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: This silent graphic novel...)"}, "madsrdf:citationSource": "Tan, S. The arrival, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6828a8aa27aa44bcbdc3459251236c33b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (\"Pictures speak in comics without words : pictorial principles in the work of Milt Gross, Hendrik Dorgathen, Eric Drooker, and Peter Kuper) p. 20 (wordless comics; lack traditional text and word balloons; \"the artist has to insure a clear flow of the narrative and the reader has to discern more intently all the elements in each panel or page in order to follow the story clearly\") p. 38 (wordless comics require \"a pictorial vocabulary\" and extra time to understand the pictorial information in each panel)"}, "madsrdf:citationSource": "Varnum, R. The language of comics : word and image, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6828a8aa27aa44bcbdc3459251236c33b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 79 (comics without words; wordless comics)"}, "madsrdf:citationSource": "Zanettin, F. Comics in translation, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6828a8aa27aa44bcbdc3459251236c33b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 201 (silent comics, also known as wordless comics; comics without text; not strictly silent, as they often include sound effects in various forms such as pictographs, or images including words like newspaper headlines, street signs, etc.)"}, "madsr