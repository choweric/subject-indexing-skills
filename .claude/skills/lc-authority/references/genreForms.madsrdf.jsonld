dStatus": "revised"}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pop-up books"}}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "McCarthy, C.W. Gaudi pop-ups, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pop-up book: A type of novelty children's book, manufactured as early as the 19th century, containing cut-out illustrations ingeniously designed to spring up in three dimensions from the surface of the page when the book is opened or a tab is pulled, and to fold back down when the page is turned or the tab is pushed in. Synonymous with stand-up book.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pop-up book: A book (usually for children) that contains one or more pages such that a three-dimensional structure rises up when a page is opened; also called pop-up)"}, "madsrdf:citationSource": "WordWeb online, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Henny Penny popup story book, 1950.", "madsrdf:citationStatus": "found"}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pop-up books. BT Toy and movable books)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Popup books"}}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Popup books"}}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stand-up books"}}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stand-up books"}}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pop-ups (Books)"}}, {"@id": "_:n181f0a377c934dd29c3fc9471565b2d5b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pop-ups (Books)"}}], "@id": "/authorities/genreForms/gf2014026150"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026151", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPostcards", "identifiers:lccn": "gf2014026151", "madsrdf:adminMetadata": [{"@id": "_:nde0342a0ccf94805baf844fd3999d509b1"}, {"@id": "_:nde0342a0ccf94805baf844fd3999d509b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Postcards"}, "madsrdf:elementList": {"@list": [{"@id": "_:nde0342a0ccf94805baf844fd3999d509b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}], "madsrdf:hasSource": [{"@id": "_:nde0342a0ccf94805baf844fd3999d509b5"}, {"@id": "_:nde0342a0ccf94805baf844fd3999d509b6"}, {"@id": "_:nde0342a0ccf94805baf844fd3999d509b7"}, {"@id": "_:nde0342a0ccf94805baf844fd3999d509b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nde0342a0ccf94805baf844fd3999d509b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nde0342a0ccf94805baf844fd3999d509b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nde0342a0ccf94805baf844fd3999d509b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Postcards"}}, {"@id": "_:nde0342a0ccf94805baf844fd3999d509b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Postcards. UF Cards, Postal; Picture postcards; Post cards; Postal cards. BT Postal stationery. Here are entered works both on cards sold by post offices with stamps already printed on them, usually mailable at rates lower than those for letters in envelopes, as well as on commercially printed cards, usually having a picture printed on one side, to which a stamp must be affixed for mailing.)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nde0342a0ccf94805baf844fd3999d509b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(postcard: A picture, photograph, or collage of images, with or without accompanying text or caption, printed on card stock and intended for delivery by post without an envelope, with blank space on the back for the sender to fill in the name and street address of the recipient and add a brief message. Compare with mailing card and postal card; mailing card: Beginning in 1898, publishers in the United States were permitted to print and sell cards bearing the inscription \"Private Mailing Card, Authorized by Act of Congress on May 19, 1898\". Private mailing cards were to be posted with one cent stamps and, like government-issued postal cards, writing was permitted only on the front. In 1901, the U.S. Government allowed the words \"Post Card\" to be printed on the undivided back of privately printed cards and publishers were permitted to drop the authorization inscription, but writing was still limited to the front, although by then other countries permitted a divided back, enabling the front to be used exclusively for a picture or design; postal card: A postcard bearing preprinted postage. Some postal cards are pictorial.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nde0342a0ccf94805baf844fd3999d509b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 64 (postcard: card conveyed by post without envelope)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nde0342a0ccf94805baf844fd3999d509b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Postcards. Scope Note: Cards on which a message may be written or printed for mailing without an envelope; often include a pictorial, comic, or other scene on one side. UF Mailing cards; Post cards. BT Cards)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026151"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026152", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPosters", "identifiers:lccn": "gf2014026152", "madsrdf:adminMetadata": [{"@id": "_:nae7a9b07dce0472f910a23ea3785b326b1"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Posters"}, "madsrdf:elementList": {"@list": [{"@id": "_:nae7a9b07dce0472f910a23ea3785b326b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026148"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026035"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026036"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026037"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026078"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026079"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026092"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026094"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026096"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026111"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026118"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026123"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026124"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026004"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026096"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026033"}], "madsrdf:hasSource": [{"@id": "_:nae7a9b07dce0472f910a23ea3785b326b5"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b6"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b7"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b8"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b9"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b10"}], "madsrdf:hasVariant": [{"@id": "_:nae7a9b07dce0472f910a23ea3785b326b11"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Posters"}}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(posters. UF bills (posters). Notices, usually decorative or pictorial, intended to be posted to advertise, promote, or publicize an activity, cause, product, or service; also, decorative, mass-produced prints intended for hanging. For small printed notices or advertisements intended for distribution by hand, use \"handbills.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Nov. 17, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Posters. Single or multi-sheet notices made to attract attention to events, activities, causes, goods, or services; also, purely decorative posters. For posting, usually in a public place; chiefly pictorial. Intended to make an immediate impression from a distance. BT Pictures. RT Broadsides; Ephemera; Signs (Notices))"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Nov. 17, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Posters. BT Broadsides; Illustrated works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Posters. UF Picture posters)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 64 (poster: notice displayed in public place as an announcement or advertisement)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(poster: A large single sheet of heavy paper or cardboard, usually printed on one side only, with or without illustration, advertising a product/service or publicizing a forthcoming event (meeting, concert, dramatic performance, etc.). Posters are intended to make an immediate impression from a distance when displayed on a bulletin board, kiosk, wall, or other suitable surface. Synonymous with placard)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nae7a9b07dce0472f910a23ea3785b326b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Picture posters"}}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picture posters"}}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nae7a9b07dce0472f910a23ea3785b326b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bills (Posters)"}}, {"@id": "_:nae7a9b07dce0472f910a23ea3785b326b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bills (Posters)"}}], "@id": "/authorities/genreForms/gf2014026152"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026153", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPress releases", "identifiers:lccn": "gf2014026153", "madsrdf:adminMetadata": [{"@id": "_:n52a60cb57a7943ad82de24cec0130567b1"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Press releases"}, "madsrdf:elementList": {"@list": [{"@id": "_:n52a60cb57a7943ad82de24cec0130567b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:n52a60cb57a7943ad82de24cec0130567b5"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b6"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b7"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b8"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b9"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b10"}], "madsrdf:hasVariant": [{"@id": "_:n52a60cb57a7943ad82de24cec0130567b11"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Press releases"}}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(press release. An official statement giving information for publication in newspapers or periodicals.)"}, "madsrdf:citationSource": "Harrod, L.M. The librarians' glossary of terms used in librarianship and the book crafts and reference book, 1971", "madsrdf:citationStatus": "found"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(press release: An official or authoritative statement of news or other information intended for publication in a newspaper or news broadcast or for dissemination via some other news medium, usually written and issued by a press secretary or public relations office, giving the point of view of a person, company, or organization on a current event or situation. Synonymous with news release.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(press release: An official or authoritative statement of information for publication in newspapers or other media. Synonymous with news release.)"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Press releases. BT Ephemera)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Press release. A press release, news release, media release, press statement or video release is a written or recorded communication directed at members of the news media for the purpose of announcing something ostensibly newsworthy. Typically, they are mailed, faxed, or e-mailed to assignment editors at newspapers, magazines, radio stations, television stations, or television networks.)"}, "madsrdf:citationSource": "Wikipedia, July 24, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 65 (press release: official statement offered to newspaper)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n52a60cb57a7943ad82de24cec0130567b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Press statements"}}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Press statements"}}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n52a60cb57a7943ad82de24cec0130567b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "News releases"}}, {"@id": "_:n52a60cb57a7943ad82de24cec0130567b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "News releases"}}], "@id": "/authorities/genreForms/gf2014026153"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026154", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProblems and exercises", "identifiers:lccn": "gf2014026154", "madsrdf:adminMetadata": [{"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab1"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Problems and exercises"}, "madsrdf:elementList": {"@list": [{"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab3"}]}, "madsrdf:exampleNote": "Note under [Study guides]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, "madsrdf:hasSource": [{"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab5"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab6"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab7"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab8"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab9"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab10"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab11"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab12"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab13"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab14"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab15"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab16"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab17"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab18"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab19"}], "madsrdf:hasVariant": [{"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab20"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Practice problems and exercises designed to develop and improve skills in an area of study. For works designed to help prepare for examinations or courses of study, see [Study guides.] For works that consist wholly or chiefly of puzzles, word games, coloring pages, instructions for simple science or craft projects, etc., see [Activity books.]"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-07-13T14:04:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dgpo"}, "ri:recordStatus": "revised"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Problems and exercises"}}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Princeton problems in physics, with solutions, c1991.", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Writing Exercises. Scope Note: Activities designed to aid students in attaining proficiency in handwriting or composition)"}, "madsrdf:citationSource": "ERIC thesaurus, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kenkel, J. Basic chemistry concepts and exercises, c2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Westhoff, F. Problems and exercises for intermediate microeconomics, c2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(--Problems, exercises, etc. UF --Exercises, problems, etc.; --Workbooks. Use as a form subdivision under topical headings for compilations of practice problems or exercises pertinent to the study of the topic)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 65 (problem: 1 puzzle, riddle; 2 question proposed for discussion)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(workbook: A separately published learning resource containing exercises, sample problems, worksheets, review questions, and other practice materials, usually with blank space for recording answers ... When published in conjunction with a textbook, a workbook is usually bound in softcover, sometimes in a spiral or comb binding)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Apr. 17, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cadwallader, Allen Clayton. Student workbook to accompany Analysis of tonal music, 2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(exercises. Things made, usually visual works or writings, chiefly in order to practice or display a specific technical point or aspect, especially by students)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Greiner, W. Theoretical physics : text and exercise books, c1989-", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ouellette, R.J. Organic chemistry study guide : key concepts, problems, and solutions, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab16", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cowden, D.J. Exercises and problems in business statistics, 1940.", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab17", "@type": "madsrdf:Source", "madsrdf:citationSource": "Exercises in astronomy, c1987.", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab18", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sterling, M.J. 1001 algebra I practice problems for dummies, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab19", "@type": "madsrdf:Source", "madsrdf:citationSource": "King, A.R. Physics with answers : 500 problems and solutions, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Exercises and problems"}}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Exercises and problems"}}, {"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n62ae156a8bde48b1b2fc66edcdf4bffab24"}]}, "madsrdf:variantLabel": 