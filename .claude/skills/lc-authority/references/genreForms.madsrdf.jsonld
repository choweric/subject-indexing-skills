GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfd819d91493c4b59926385911eead0a4b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Old Testament stories"}}, {"@id": "_:nfd819d91493c4b59926385911eead0a4b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Old Testament stories"}}], "@id": "/authorities/genreForms/gf2014026242"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026243", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBildungsromans", "identifiers:lccn": "gf2014026243", "madsrdf:adminMetadata": [{"@id": "_:n0ab34c58daa24c0693889347e5893e9db1"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bildungsromans"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0ab34c58daa24c0693889347e5893e9db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n0ab34c58daa24c0693889347e5893e9db5"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db6"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db7"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db8"}], "madsrdf:hasVariant": [{"@id": "_:n0ab34c58daa24c0693889347e5893e9db9"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db12"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db15"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db18"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db21"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db24"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db27"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db30"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db33"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db36"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction depicting the development of a character from youth to adulthood."}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T12:50:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bildungsromans"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bildungsromans: Use for novels in which the theme is the development of a character from youth to adulthood. An example is Charles Dickens' Great expectations. UF Apprenticeship novels, Bildungsromane, Coming of age stories.)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bildungsromans. UF Apprenticeship novels; Bildungsromane; Coming-of-age novels; Entwicklungsromane; Erziehungsromane. BT Fiction)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bildungsroman: class of novel that deals with the maturation process, with how and why the protagonist develops as he does, both morally and psychologically. The German word Bildungsroman means \"novel of education\" or \"novel of formation\"; a common variation of the bildungsroman is the K\u00fcnstlerroman, a novel dealing with the formative years of an artist. Such other variations as the Erziehungsroman (\"novel of upbringing\") and the Entwicklungsroman (\"novel of [character] development\") differ only slightly from the bildungsroman, and these terms are sometimes used interchangeably)"}, "madsrdf:citationSource": "Britannica online, Dec. 18, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bildungsroman: German for \"novel of growth and development,\" the Bildungsroman is a subgenre that originated in eighteenth-century German fiction and spread across Europe and the United States. Sometimes called an apprenticeship novel, it depicts a youth who struggles toward maturity, forming a worldview or philosophy of life and leaving behind the concerns of adolescence; Coming-of-age story, see Initiation story; Initiation story: Also called Coming-of-age story, an initiation story is a narrative in which the main character, usually a child or adolescent, undergoes an important experience or rite of passage--often a difficult or disillusioning one--that prepares him or her for adulthood.)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ab34c58daa24c0693889347e5893e9db10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "K\u00fcnstlerromans"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "K\u00fcnstlerromans"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ab34c58daa24c0693889347e5893e9db13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Apprenticeship novels"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Apprenticeship novels"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ab34c58daa24c0693889347e5893e9db16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Initiation stories"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Initiation stories"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ab34c58daa24c0693889347e5893e9db19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Erziehungsromans"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Erziehungsromans"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ab34c58daa24c0693889347e5893e9db22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Entwicklungsromans"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Entwicklungsromans"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ab34c58daa24c0693889347e5893e9db25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Erziehungsromane"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Erziehungsromane"}}, {"@id": "_:n0ab34c58daa24c0693889347e5893e9db27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ab34c58daa24c0693889347e5893e9db28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "K\