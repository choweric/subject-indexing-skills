423bb7db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T06:42:33"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical films"}}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5b4d098f64ba40baa523115d9423bb7db6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Niskavouri films"}}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Niskavouri films"}}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5b4d098f64ba40baa523115d9423bb7db9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ang\u00e9lique films"}}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ang\u00e9lique films"}}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(historical: Fictionalized work set in a certain specified time in the past; UF docudrama)"}, "madsrdf:citationSource": "Moving image genre form guide via WWW, July 18, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The historical drama is a film genre in which stories are based upon historical events and famous people. Some historical dramas are docudramas, which attempt an accurate portrayal of a historical event or biography, to the degree that the available historical research will allow. Other historical dramas are fictionalized tales that are based on an actual person and their deeds, such as Braveheart, which is loosely based on the 13th-century knight William Wallace's fight for Scotland's independence.)"}, "madsrdf:citationSource": "List of historical drama films, via Wikipedia, Mar. 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hollywood's best history films, via The History Place website, Mar. 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Genre: History; history feature films)"}, "madsrdf:citationSource": "IMDb, Mar. 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5b4d098f64ba40baa523115d9423bb7db16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Historical dramas (Motion pictures)"}}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Historical dramas (Motion pictures)"}}, {"@id": "_:n5b4d098f64ba40baa523115d9423bb7db18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5b4d098f64ba40baa523115d9423bb7db19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Drama films, 