{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026509", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRadio quiz shows", "identifiers:lccn": "gf2011026509", "madsrdf:adminMetadata": [{"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b1"}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Radio quiz shows"}, "madsrdf:elementList": {"@list": [{"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b3"}]}, "madsrdf:exampleNote": "Note under [Radio game shows]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026506"}, "madsrdf:hasSource": [{"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b5"}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b6"}], "madsrdf:hasVariant": [{"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b7"}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b10"}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Radio programs that feature a question-and-answer format. For radio programs that feature contestants participating in various types of competitive activities for prizes see [Radio game shows.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025599"}}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:06:18"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio quiz shows"}}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "quiz and game shows page (prior to the quiz show scandals in 1958 no differentiation existed between quiz shows and game shows; all shows that deal with competitions between individuals or groups, and based primarily on the display of factual knowledge will be considered quiz shows; shows dealing with human knowledge (knowledge of people or of individuals) or that are based primarily on gambling or on physical performances fall in the category of game shows; The gong show or Double dare are not considered quiz shows since they rely primarily or completely on physical talents; Family feud and The newlywed game rely entirely on knowledge of people or of individuals and would therefore also be considered game shows; Jeopardy!, with its focus on academic, factual knowledge, is clearly a quiz show)"}, "madsrdf:citationSource": "Museum of Broadcast Communications WWW site, March 28, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Quiz shows: Programs on which a group of people (experts, celebrities, and/or members of the audience) compete in answering questions or partake in some other competitive activity, following certain rules, usually for prizes; UF Contests, Game shows, Panel game shows; Examples: NBC spelling bee; Truth or consequences; What's my name?; Information please)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Nov. 28, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio contests"}}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio contests"}}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quiz shows (Radio programs)"}}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quiz shows (Radio programs)"}}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Contests, Radio"}}, {"@id": "_:na5b482fb039643eab4e6302f4b2c3f08b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Contests, Radio"}}], "@id": "/authorities/genreForms/gf2011026509"}
