{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026957", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMusicals", "identifiers:lccn": "gf2014026957", "madsrdf:adminMetadata": [{"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb1"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Musicals"}, "madsrdf:elementList": {"@list": [{"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb3"}]}, "madsrdf:exampleNote": "Note under [Revues; Music theater]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}, "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb5"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb8"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026414"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026666"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026030"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026002"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026003"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026004"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026045"}], "madsrdf:hasSource": [{"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb11"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb12"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb13"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb14"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb15"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb16"}], "madsrdf:hasVariant": [{"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb17"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb20"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb23"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb26"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb29"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb32"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb35"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb38"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb41"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music for theatrical productions consisting of musical numbers integrated into a dramatic framework. For theatrical productions from around the end of the 18th century that feature a series of songs, dances, and other entertainments without any unifying dramatic element see Revues. For musical works, often small in scale and primarily of the 20th century, that combine elements of music, drama, and sometimes dance in unconventional ways that result in works distinct from traditional forms see Music theater.", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026272"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026644"}]}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-05-26T14:29:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "revised"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musicals"}}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised musicals"}}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised musicals"}}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed musicals"}}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed musicals"}}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Musical (comedy))"}, "madsrdf:citationSource": "New Harvard dict. of music", "madsrdf:citationStatus": "found"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Musical theater (what was called light opera and musical comedy in the 19th and earlier 20th centuries has since the 1960s been most commonly referred to as the \"musical,\" a genre which is often neither light nor an opera nor a comedy (though it can be all or none of these))"}, "madsrdf:citationSource": "Grove music online, February 14, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lloyd Webber, A. The phantom of the Opera [SR] p1987.", "madsrdf:citationStatus": "found"}, {"@id": "_:n10fd4eede04d4808b3883d95c99b51ddb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Musical)"}, "madsrdf:citationSource": "New Grove dict. of American music", "madsrdf:citationStatus": "found"}, {"@id": "_:n10fd4eede04d4808b3883d9