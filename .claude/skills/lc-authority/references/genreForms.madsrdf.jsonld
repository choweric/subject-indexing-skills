{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026949", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMotets", "identifiers:lccn": "gf2014026949", "madsrdf:adminMetadata": [{"@id": "_:n66688f96e49f4cc3a160334668243809b1"}, {"@id": "_:n66688f96e49f4cc3a160334668243809b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Motets"}, "madsrdf:elementList": {"@list": [{"@id": "_:n66688f96e49f4cc3a160334668243809b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026984"}, "madsrdf:hasSource": {"@id": "_:n66688f96e49f4cc3a160334668243809b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n66688f96e49f4cc3a160334668243809b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n66688f96e49f4cc3a160334668243809b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n66688f96e49f4cc3a160334668243809b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motets"}}, {"@id": "_:n66688f96e49f4cc3a160334668243809b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(One of the most important forms of polyphonic music from about 1220 to 1750; no single set of characteristics serves to define it generally, except in particular historical or regional contexts; after the 16th century has been defined as a sacred polyphonic composition with Latin text, which may or may not have colla voce or independent instrumental accompaniment.)"}, "madsrdf:citationSource": "New Grove dict. of mus. online, Apr. 3, 2002", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026949"}
