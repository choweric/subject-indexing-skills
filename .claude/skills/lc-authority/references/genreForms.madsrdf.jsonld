i:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "revised"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay drama"}}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay erotic drama"}}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay erotic drama"}}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "78070671: Gay plays : the first collection, \u00a91979.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "2016008180: Clum, J.M. Terrence McNally and fifty years of American gay drama, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 486 (Lesbian and gay drama / Jill Dolan. \"Some believe this genre derives its power and definition from identity, infusing its content with preoccupations, styles, and concerns 'true' and 'authentic' to lesbian, gay, bisexual, transgendered, and/or queer communities. Other theorists and artists believe 'lesbian and gay drama' is already an archaic category, no longer necessary because such work has gradually assimilated into mainstream theatre and performance.\") p. 487 (\"Mae West's play The Drag (1927), one of the earliest expressions of openly homosexual content on a public stage, described two gay men, one married, involved in a love triangle that ends in murder and stages, in the process, a drag ball\") p. 490 (gay plays)"}, "madsrdf:citationSource": "A companion to twentieth-century American drama, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 16 (\"Homosexual plays became either scathing indictments of American society's failure to adequately respond to the AIDS crisis, as in the plays of Larry Kramer, or dark depictions of the oppressions of gays, as in Martin Sherman's Bent (1978)\")"}, "madsrdf:citationSource": "Tony Kushner : new essays on the art and politics of the plays, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Gay plays : an international anthology, 1989.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "85151443: Gay plays, 1984-1994.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "97013548: O'Connor, S. Straight acting : popular gay drama from Wilde to Rattigan, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "2006497082: Perfectly abnormal : seven gay plays, 2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b16", "@type": "madsrdf:Source", "madsrdf:citationSource": "2013002759: Gay drama now : an anthology, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 603 (homosexual drama in the 20th century)"}, "madsrdf:citationSource": "Reader's guide to lesbian and gay studies, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Homosexual drama"}}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Homosexual drama"}}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay erotic drama"}}, {"@id": "_:ndf049f290a4240a2a6d70c0867154cd3b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay erotic drama"}}], "@id": "/authorities/genreForms/gf2018026007"}
