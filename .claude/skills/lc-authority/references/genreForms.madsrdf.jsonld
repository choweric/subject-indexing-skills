{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026039", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPharmacopoeias", "identifiers:lccn": "gf2017026039", "madsrdf:adminMetadata": [{"@id": "_:n31c2545dc8eb460792de975d43d11f7ab1"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pharmacopoeias"}, "madsrdf:elementList": {"@list": [{"@id": "_:n31c2545dc8eb460792de975d43d11f7ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasSource": [{"@id": "_:n31c2545dc8eb460792de975d43d11f7ab5"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab6"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab7"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab8"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab9"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab10"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab11"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab12"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab13"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab14"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab15"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab16"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab17"}], "madsrdf:hasVariant": {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab18"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:34:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-02-24T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pharmacopoeias"}}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pharmacopoeia or pharmacopeia: a book published usually under the jurisdiction of the government and containing a list of drugs, their formulas, methods for making medicinal preparations, requirements and tests for their strength and purity, and other related information)"}, "madsrdf:citationSource": "Dictionary.com unabridged, Feb. 24, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "The pharmacopoeia of the United States of America, 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pharmacopoeia or pharmacopeia: a book describing drugs, chemicals, and medicinal preparations; especially : one issued by an officially recognized authority and serving as a standard)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Feb. 24, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pharmacopoeia: A book or online resource that lists drugs, chemical compounds, and biological substances, providing information on molecular structure and properties, therapeutic uses, derivatives, and sometimes formulas for manufacture, with tests for establishing identity, purity, strength, etc. (example: The Merck Index or PDR: Physicians' Desk Reference). Most libraries keep the current edition of at least one modern pharmacopoeia in the reference section)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, viewed Feb. 24, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Izquierdo, J.J. Origins and development of Mexican pharmacopoei\u00e6, 1952.", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pharmacopoeias. Scope Note: Use for works having the contemporary status of a standard. When in doubt, use \"Medical formularies.\" BT Reference works. BT Scientific works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Feb. 24, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pharmacopoeia, pharmacopeia, or pharmacopoea (literally, \"drug-making\"), in its modern technical sense, is a book containing directions for the identification of compound medicines, and published by the authority of a government or a medical or pharmaceutical society. Descriptions of preparations are called monographs. In a broader sense it is a reference work for pharmaceutical drug specifications)"}, "madsrdf:citationSource": "Wikipedia, Feb. 24, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(note in catalog record: Originally published in 1945 with title: Preliminary list of official and recognized pharmacopoeiae)"}, "madsrdf:citationSource": "Pharmacopoeias, official and recognized for each country, listed by continents, 1945", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (The two pharmacopoeias that have legal status within the UK are the British Pharmacopoeia (BP), including the BP (Veterinary), and the European Pharmacopoeia (Ph. Eur.). The BP provides the only comprehensive collection of authoritative official standards for UK pharmaceutical substances and medicinal products. The BP is a vital reference tool for all individuals and organisations involved in pharmaceutical: research; development; manufacture; quality control and analysis. The BP includes: general notices (providing general information applicable to all texts); general monographs (apply to all dosage forms); specific monographs providing mandatory standards for: active pharmaceutical ingredients; excipients; formulated preparations (licensed and unlicensed products); herbal drugs, herbal drug products and herbal medicinal products; materials for use in the manufacture of homoeopathic preparations; blood-related products; immunological products; radiopharmaceutical preparations; infrared reference spectra; appendices; supplementary chapters (providing additional guidance))"}, "madsrdf:citationSource": "British pharmacopoeia, via WWW, Feb. 24, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(in entries: pharmacopoeias; pharmacopoeiae; pharmacopeias; pharmacopeiae; pharmacopoeas)"}, "madsrdf:citationSource": "PubMed database, Mar. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Pharmacopoeia of the People's Republic of China, 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pharmacopoeias. Annotation: This heading is used as a Publication Type. Scope note: Authoritative works containing lists of drugs and preparations, their description, formulation, analytic composition, main chemical properties, standards for strength, purity, and dosage, chemical tests for determining identity, etc. They have the status of a standard)"}, "madsrdf:citationSource": "Medical subject headings, 2017, via WWW, Feb. 24, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pref. (The International Pharmacopoeia (Ph.Int.) comprises a collection of recommended procedures for analysis and specifications for the determination of \"pharmaceutical substances\" (active pharmaceutical ingredients), excipients and \"dosage forms\" (general texts and individual finished pharmaceutical products) that is intended to serve as source material for reference or adaptation by any World Health Organization (WHO) Member State wishing to establish pharmaceutical requirements) home page (Compared to other pharmacopoeias, priority is given to medicines included in the WHO Model List of Essential Medicines and to medicines which are important for WHO health programmes and for which other pharmacopoeias do not offer any test specifications)"}, "madsrdf:citationSource": "The international pharmacopoeia, Sixth edition, 2016, via World Health Organization website, Feb. 24, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n31c2545dc8eb460792de975d43d11f7ab19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pharmacopeias"}}, {"@id": "_:n31c2545dc8eb460792de975d43d11f7ab19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pharmacopeias"}}], "@id": "/authorities/genreForms/gf2017026039"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026040", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSocial problem fiction", "identifiers:lccn": "gf2017026040", "madsrdf:adminMetadata": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb1"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Social problem fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb5"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb6"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb7"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb8"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb9"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb10"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb11"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb12"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb13"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb14"}], "madsrdf:hasVariant": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb15"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb18"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb21"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb24"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb27"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb30"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb33"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb36"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb39"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb42"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features a specific social ill, or contemporary political issue, to draw attention to it."}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-06-17T13:42:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-02-27T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social problem fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Social-problem novels\" (also known as \"industrial,\" \"social,\" or \"condition-of-England\" novels) are a group of mid-19th-century fictions concerned with the condition of the working classes in the new industrial age. Largely written by middle-class writers, the novels highlight poverty, dirt, disease, and industrial abuses such as sweated labor, child workers, and factory accidents but also exhibit anxiety about working-class irreligion and a fear of (potentially violent) collective action such as Chartism and trade unionism. The genre roughly spans the period between the Reform Acts of 1832 and 1867, and the backdrop includes the \"Hungry Forties,\" debates over the franchise, Chartist demonstrations, the exponential growth of the new cities, and campaigns around sanitation and factory conditions)"}, "madsrdf:citationSource": "Carney, B. Social-problem novel, 2015, via Oxford bibliographies Victorian literature website, Feb. 27, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. verso (Upton Sinclair's muckraking novel, first published in 1906, follows the misadventures of a family of Lithuanian immigrants, drawing attention to the exploitation of Chicago's workers and the health violations of the early 20th century meatpacking industry)"}, "madsrdf:citationSource": "Sinclair, U. The jungle, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 771 (the muckraking fiction of the twentieth-century social realist tradition)"}, "madsrdf:citationSource": "Perspectives on politics, Sept. 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (Kobb\u00e9's hilarious social novel)"}, "madsrdf:citationSource": "Work cat.: Kobb\u00e9, Montague. On the way back, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(propaganda novel See thesis novel; sociological novel See thesis novel; thesis novel: One which treats of a social, political or religious problem with a didactic and, perhaps, radical purpose. It certainly sets out to call people's attention to the shortcomings of a society)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Social problem novel (Social problem novel, also called problem novel or social novel, work of fiction in which a prevailing social problem, such as gender, race, or class prejudice, is dramatized through its effect on the characters of a novel. The type emerged in Great Britain and the United States in the mid-19th century. An early example is Elizabeth Gaskell's Ruth (1853), which portrays a humane alternative to the \"fallen woman's\" usual progress to social ostracism and prostitution during the period. If the work is strongly weighted to convert the reader to the author's stand on a social question, as is the case with Harriet Beecher Stowe's antislavery novel Uncle Tom's Cabin (1852), it is sometimes called a propaganda novel. Usually a social problem novel limits itself to exposure of a problem. A personal solution may be arrived at by the novel's characters, but the author does not insist that it can be applied universally or that it is the only one. Most social problem novels derive their chief interest from their novelty or timeliness. For example, in 1947 Laura Z. Hobson's Gentleman's Agreement, revealing the unwritten code of anti-Semitism upheld in American middle-class circles, created a stir among a public freshly shocked by the Holocaust)"}, "madsrdf:citationSource": "Britannica online, Feb. 27, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 160 (\"Imin gakuen\" (A School for \u00c9migr\u00e9s, 1899), the second of these two works and [Shimizu] Shikin's final piece, falls into the category of social issue fiction--particularly fiction treating the prejudices and marginalization experienced by the burakumin, the so-called outcasts)"}, "madsrdf:citationSource": "Copeland, R.L. Lost leaves, \u00a92000:", "madsrdf:citationStatus": "found"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Muckrakers (A group of American writers who between 1902 and 1911 worked to expose the dishonest methods and unscrupulous motives in big business and city, state, and national government; Upton Sinclair's novel The Jungle and some of the novels of Winston Churchill and D.G. Phillips are muckraking books) Sociological novel (The Muckrakers at the turn of the century produced a number of sociological novels, the most successful being Upton Sinclair's The Jungle)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Problem Novel (A narrative that derives its chief interest from working out some central problem. The term is sometimes applied to those novels written for a deliberate purpose or thesis, which are better called Propaganda Novels) Propaganda Novel (A novel dealing with a special social, political, economic, or moral issue or problem and possibly advocating a doctrinaire solution. If the propagandistic purpose dominates the work so as to dwarf or eclipse all other elements, such as plot and character, then the novel belongs to the realm of the didactic and probably cannot be understood or appreciated for its own sake as a work of art. It may be good propaganda and bad literature at the same time. See Problem Novel) Sociological Novel (A form of the Problem Novel that concentrates on the nature, function, and effect of the society in which characters live. Usually, the sociological novel presents a thesis as a resolution to a social problem, but it is by no means always a Propaganda Novel. The serious examination of social issues grew important with the Industrial Revolution and scrutinized the condition of laborers and their families. The result was such novels as Dickens's Hard Times, Kingsley's Yeast, and Gaskell's Mary Barton ... Stowe's Uncle Tom's Cabin ... the novels of Richard Wright and Ralph Ellison; John Steinbeck, John Dos Passos, Erskine Caldwell, and James T. Farrell all wrote novels whose central issues were sociological) Thesis Novel (A novel that deals with some problems so as to suggest a thesis, usually in the form of a solution to the problem. Among the types of novels that are called thesis novels are sociological novels, political novels, problem novels, and propaganda novels. The French \"roman \u00e0 th\u00e8se\" is sometimes used instead of \"thesis novel.\")"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(All five of his novels, which were published between 1929 and 1934, are expos\u00e9s that reveal the corruption, the criminality and the hypocrisy of life in the U.S.; Red Harvest is pure Hammett and muckraking fiction at its very best)"}, "madsrdf:citationSource": "Raskin, J. The muckraking novelist Dashiell Hammett, via CounterPunch website, posted Feb. 22, 2019, viewed Feb. 25, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sociological fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sociological fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Social fiction (Social problem fiction)"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social fiction (Social problem fiction)"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romans \u00e0 th\u00e8se"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romans \u00e0 th\u00e8se"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Propaganda fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Propaganda fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Industrial fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Industrial fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Social protest fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social protest fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Problem fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Problem fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Muckraking fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Muckraking fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Social issue fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social issue fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb42", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb43"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Thesis fiction"}}, {"@id": "_:na944c0524b7149fe96ebf6bde2c904eeb43", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thesis fiction"}}], "@id": "/authorities/genreForms/gf2017026040"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026041", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHornbooks (Primers)", "identifiers:lccn": "gf2017026041", "madsrdf:adminMetadata": [{"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b1"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hornbooks (Primers)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026191"}, "madsrdf:hasSource": [{"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b5"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b6"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b7"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b8"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b9"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b10"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b11"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b12"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b13"}], "madsrdf:hasVariant": [{"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b14"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b17"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:34:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hornbooks (Primers)"}}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "horn-book (n. 1. a. A leaf of paper containing the alphabet (often with the addition of the ten digits, some elements of spelling, and the Lord's Prayer) protected by a thin plate of translucent horn, and mounted on a tablet of wood with a projecting piece for a handle. A simpler and later form of this, consisting of the tablet without the horn covering, or a piece of stiff cardboard varnished, was also called a battledore n. b. A treatise on the rudiments of a subject; a primer.) battledore (1. A beetle or wooden 'bat' used in washing, also (when made cylindrical) for smoothing out or 'mangling' linen clothes. 2. a. An instrument like a small racket used in playing with a shuttlecock. b. The game played with this by two persons who strike the shuttlecock to and from each other. 3. (more fully battledore-book): A horn-book; so called from its usual shape. Hence battledore boy, an abecedarian)"}, "madsrdf:citationSource": "OED online, Mar. 2, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Mar. 2, 2017", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: The new royal battledore, between 1830 and 1850.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hornbooks. UF horn-books. BT primers (books). Note: Children's primers consisting typically of a sheet of parchment or layer of paper mounted on a thin wooden board and protected by a sheet of transparent horn and having on it the alphabet and other rudiments such as the digits and often the Lord's Prayer.; battledores (primers). Primers of cardboard or wood, consisting of two or three pages with the alphabet, numbers, simple text, and sometimes pictures printed or impressed upon them and often varnished for protection. Distinguish from their predecessors, \"hornbooks,\" which are primers consisting typically of a sheet of parchment or layer of paper mounted on a thin wooden board and protected by a sheet of transparent horn.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Mar. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Battledore (1 folded sheet) with two panels and a cover flap; includes upper and lower case alphabet)"}, "madsrdf:citationSource": "Work cat.: The British battledore, or, First lessons, approximately 1830", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hornbook: 1 : a child's primer consisting of a sheet of parchment or paper protected by a sheet of transparent horn. 2 : a rudimentary treatise)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Mar. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hornbooks. Use for hand-held teaching devices typically consisting of a piece of parchment or paper protected by a sheet of transparent horn and mounted to a thin wooden board with a handle. BT Textbooks)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Mar. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Primers (A primer, originally the name for a prayer-book, was used to describe simple books for teaching children their letters, prayers, and, later, other simple subjects. Primers were given to children at least as early as the middle ages ... Primers usually began with the alphabet, followed by an illustrated alphabet with a verse for each letter ... The hornbook was the earliest form of children's primer, common in both England and America from the late 16th to the late 18th century. A sheet containing the letters of the alphabet, simple words, and a Bible verse was mounted on a wooden frame and protected with thin, transparent plates of horn. The frame was shaped like a paddle, had a handle, and was usually hung at the child's belt. ... Considered a cheaper ABC learning tool than the hornbook, a battledoor consisted of a folded sheet of stiff paper. ... The name \"battledoor\" came into use because children often used the stiff paper covers as a game paddle for hitting a shuttlecock into the air, in a game similar to badminton)"}, "madsrdf:citationSource": "World of the child : two hundred years of children's books, via University of Delaware Library website, Mar. 2, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(horn book: A type of child's primer used in England and America from the 15th to the 18th century, consisting of a sheet of parchment or paper bearing the letters of the alphabet, usually the first 10 numerals, basic spelling rules, the Lord's Prayer, and sometimes a hand-colored illustration, protected by a thin, transparent sheet of cattle horn, mounted on an oblong bat of wood or leather with a projecting handle by which it could be fastened to a child's girdle. Its paddle shape suggests that it may have been used in playing the game shuttlecock. Also spelled hornbook. See also: abecedary and battledore; battledore: A type of school primer used in the late 18th century, made of folded paper varnished on the inside, resembling a horn book when opened but sometimes lacking a handle. Also spelled battledoor; abecedary: A book containing the letters of the alphabet and basic rules of spelling and grammar, used in Europe as a primer before the invention of the printing press. Early printed examples (sometimes in the form of a broadsheet) displayed the alphabet in uppercase and lowercase letters in both roman and gothic type, with separate lists of vowels, dipthongs, and consonants. By 1700, some ABC books included children's rhymes. Synonymous with abecedarium (plural: abecedarii))"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Mar. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Battledores (Primers)"}}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Battledores (Primers)"}}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Horn books (Primers)"}}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horn books (Primers)"}}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Battledoors (Primers)"}}, {"@id": "_:n8b2f5c5ce2054e71bc8d60ec1f5626f2b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Battledoors (Primers)"}}], "@id": "/authorities/genreForms/gf2017026041"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026042", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNovelizations", "identifiers:lccn": "gf2017026042", "madsrdf:adminMetadata": [{"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b1"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Novelizations"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026041"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026020"}], "madsrdf:hasSource": [{"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b5"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b6"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b7"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b8"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b9"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b10"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b11"}], "madsrdf:hasVariant": {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Adaptations in novel form of any kind of original format, including films, true stories, plays, etc."}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-22T15:58:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novelizations"}}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novelize or novelise: to convert (a true story, film, etc) into a novel. Derived forms: novelization or novelisation)"}, "madsrdf:citationSource": "Collins English dictionary online, Mar. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novelization, n. a. The process of novelizing something; conversion of a narrative into a novel. b. concr. The novel resulting from such a process; a novelized version of a play, film, etc.)"}, "madsrdf:citationSource": "OED online, Mar. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Hiller, B.B. Teenage Mutant Ninja Turtles : a novelization, \u00a91990.", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Movie novels. Use for fiction based on movies. UF Film novelizations; Motion picture novelizations; Movie novelizations; Movie tie-ins. RT Radio and television novels; Radio and television novels. Use for fiction based on radio or television programs. UF Radio novels; Television novels. RT Movie novels)"}, "madsrdf:citationSource": "Guidelines on subject access to individual works of fiction, drama, etc., 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (based on the teleplay written by Vince Gilligan)"}, "madsrdf:citationSource": "Work cat.: Royce, Easton. Dark matter : a novelization, \u00a91999:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novelization: A novel based on a literary work originally created in another form, often as a dramatic work, for example, The Wave by Morton Rhue, based on a teleplay by Johnny Dawkins that was based on a short story by Ron Jones.)"}, "madsrdf:citationSource": "ODLIS : online dictionary for library and information science, Mar. 2, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novelize: to convert into the form of a novel; e.g., novelize a play; --novelization noun)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Mar. 2, 2107", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novelisations"}}, {"@id": "_:nfbfaafdaec6c4b22bc81e88a24394936b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novelisations"}}], "@id": "/authorities/genreForms/gf2017026042"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026043", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n2352b25b265d46aabff276d4ccc952e4b1"}, {"@id": "_:n2352b25b265d46aabff276d4ccc952e4b2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the genre/form term is covered by the genre/form terms {Adaptations} (DLC)gf2014026041 and {Operas} (DLC)gf2014026976"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2352b25b265d46aabff276d4ccc952e4b3"}]}, "madsrdf:useInstead": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026041"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026976"}], "madsrdf:variantLabel": {"@language": "en", "@value": "Opera adaptations"}}, {"@id": "_:n2352b25b265d46aabff276d4ccc952e4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-11-23T12:02:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n2352b25b265d46aabff276d4ccc952e4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2352b25b265d46aabff276d4ccc952e4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Opera adaptations"}}], "@id": "/authorities/genreForms/gf2017026043"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026044", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aParanormal drama", "identifiers:lccn": "gf2017026044", "madsrdf:adminMetadata": [{"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b1"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Paranormal drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026356"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026058"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026059"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026129"}], "madsrdf:hasSource": [{"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b5"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b6"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b7"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b8"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b9"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b10"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b11"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b12"}], "madsrdf:hasVariant": [{"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b13"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b16"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that feature human characters that are often involved in the occult, witchcraft, spiritualism, psychic phenomena, vodou, etc., interacting with supernatural beings."}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-03-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-06-08T09:24:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paranormal drama"}}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(After 18 years of marriage Richard and Jennifer Crawford are finally about to become parents and have moved from the city to an old farmhouse, which they are trying to restore before the baby arrives. He still commutes each day, while she stays in the country supervising the shambling handyman and cook who work for them. At first it is mostly the slow pace of restoration that nags them, but a general sense of unease begins to build as the old house seems to be resisting their intrusion. The lights fail, the plumbing malfunctions, a fey neighbor stops by with an odd gift (a prayerbook for the burial of the dead), and her poet husband ominously warns Jennifer that she should go back to the city before it is too late. Further complications arise when they are joined by Richard's ne'er-do-well brother and his fiancee, but it is the silent little girl whom Jennifer claims she has seen swinging in the backyard who brings on the chilling climax of the play--in which the real and the supernatural clash with disturbing and breath-stopping results.)"}, "madsrdf:citationSource": "Dramatists Play Service web page for Hide and seek, viewed Mar. 7, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Gregory, Lady. The wonder and supernatural plays of Lady Gregory, 1970.", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. x (The terms occultism and occult are used here principally to describe the many ways that human beings have sought to fathom a secret knowledge intuited to exist but held to be inaccessible through normal means; turning to other possibilities, humans have sought the aid of supernatural agencies through alchemy, angelology, asceticism, astrology, demonolatry, divination, ecstasy, magic, necromancy, possession, santeria, seances, voudoun, witchcraft, and so on) p. xi (plays in which occultism is central to the theme or is an important element therein) p. 137 (drama of the occult; drama through the twentieth century that focus on one or more of the numerous manifestations of what is termed occultism: alchemy, angelology, asceticism, astrology, demonolatry, magic, divination, ecstasy, magic, necromancy, possession, santeria, seances, voudoun, witchcraft, and the like, whether feigned or \"real\")"}, "madsrdf:citationSource": "Lima, R. Dark prisms : occultism in Hispanic drama, \u00a91995:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(plays based on plots and characters of the works of H.P. Lovecraft)"}, "madsrdf:citationSource": "Minch, S. Lovecraftian ceremonies : seven occult dramas for the magickal performer, \u00a91979", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a paranormal play)"}, "madsrdf:citationSource": "Work cat.: Havard, L. Hide and seek, \u00a91980", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Van Poppel, E.W. Oleander : the writing of the contemporary supernatural drama, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 72 (In The Shawl by David Mamet (1985), the play follows encounters between a medium and their client) p. 186 (paranormal drama) p. 217 (paranormal dramas)"}, "madsrdf:citationSource": "The Ashgate research companion to paranormal cultures, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Selfishness, or, The echo devil & the wizard's curse : a supernatural drama in 2 acts, 1856.", "madsrdf:citationStatus": "found"}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supernaturalist drama"}}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supernaturalist drama"}}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Occult drama"}}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Occult drama"}}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supernatural drama"}}, {"@id": "_:ncb6ac005372640cdbfdf797b0dfbea60b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supernatural drama"}}], "@id": "/authorities/genreForms/gf2017026044"}
