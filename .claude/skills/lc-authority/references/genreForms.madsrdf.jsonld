{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026017", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMarginalia", "identifiers:lccn": "gf2023026017", "madsrdf:adminMetadata": [{"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b1"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Marginalia"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}, "madsrdf:hasSource": [{"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b5"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b6"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b7"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b8"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b9"}], "madsrdf:hasVariant": [{"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b10"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b13"}], "madsrdf:historyNote": "[Established October 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-11T14:07:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-24T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Marginalia"}}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Notes, commentary, or other matter written, printed, or inserted in the margins of a book or MS...Though there is a continuing history of comments and glosses written in religious works (sometimes forming a continuous argument with the text involved), secular forms of written marginalia have predominated since the 18th century)"}, "madsrdf:citationSource": "Oxford companion to the book online, viewed September 16, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(marginalia: Latin for \"things in the margin.\" Headings or notes printed in the margins of a page, usually in type of a size or style distinct from that of the text. Marginalia include footnotes, side notes, corrections, shoulder notes, glosses, annotations, diagrams, doodles, etc., added by a commentator or reader. In medieval manuscripts and incunabula, the term includes notes and commentary written in the margins but not ornamental borders and other marginal decoration. Synonymous with marginal note)"}, "madsrdf:citationSource": "Reitz, J.M. Online dictionary for library and information science, Jan. 24, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "marginalia (annotations) (marginalia (annotations). SN Notes or symbols written or printed in the margins of pages)"}, "madsrdf:citationSource": "Art & architecture thesaurus, Apr. 12, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tommaso Magistro's marginal notes to Pindar's Pythian odes, revised and with additional notes by Demetrius Triclinius; subjs. assigned include: Th\u014dmas, Magistros, active 1310-1327--Library-Marginal notes; Triclinius, Demetrius--Library--Marginal notes.) (OCoLC)1145182674"}, "madsrdf:citationSource": "Work cat.: Th\u014dmas, Magistros. Glosse alle Pitiche I-IV, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivision --Library--Marginal notes; UF --Marginal notes. SN Use this subdivision combination as a form subdivision under names of individual persons for marginal notes in works belonging to the person, whether written by the person or by others.)"}, "madsrdf:citationSource": "LCSH, Jan. 24, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Notes, Marginal"}}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Notes, Marginal"}}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Marginal notes"}}, {"@id": "_:n3d85362efcf04c1d89e390693a17d2d0b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Marginal notes"}}], "@id": "/authorities/genreForms/gf2023026017"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026019", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIncantations", "identifiers:lccn": "gf2023026019", "madsrdf:adminMetadata": [{"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b1"}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Incantations"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026026"}, "madsrdf:hasSource": [{"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b5"}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b6"}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b7"}], "madsrdf:hasVariant": [{"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b8"}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b11"}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b14"}], "madsrdf:historyNote": "[Established July 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T14:52:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Incantations"}}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Seduction through witchcraft; sound recording of instruction for magical practice and incantations by Louise Huebner, officially named \"Witch of Los Angeles\")"}, "madsrdf:citationSource": "Work cat: Louise Huebner's Seduction through witchcraft, 1970", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Incantations (\"An incantation, a spell, a charm, an enchantment or a bewitchery, is a magical formula intended to trigger a magical effect on a person or objects. The formula can be spoken, sung or chanted. An incantation can also be performed during ceremonial rituals or prayers.\")"}, "madsrdf:citationSource": "Wikipedia, viewed Feb. 2, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Incantations (\"The use of a formula of words spoken or chanted to produce a magical effect; the utterance of a spell or charm; more widely, The use of magical ceremonies or arts; magic, sorcery, enchantment\")"}, "madsrdf:citationSource": "Oxford English Dictionary, searched Feb. 2, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Charms"}}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Charms"}}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spells"}}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spells"}}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Enchantments"}}, {"@id": "_:n9a98f38283334e6d81624cfc3b6ae1c9b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Enchantments"}}], "@id": "/authorities/genreForms/gf2023026019"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026020", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMemorial books", "identifiers:lccn": "gf2023026020", "madsrdf:adminMetadata": [{"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab1"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Memorial books"}, "madsrdf:elementList": {"@list": [{"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026064"}, "madsrdf:hasSource": [{"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab5"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab6"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab7"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab8"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab9"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab10"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab11"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab12"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab13"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab14"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab15"}], "madsrdf:hasVariant": {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab16"}, "madsrdf:historyNote": "[Established October 2024.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Books compiled by and about survivors of genocides and ethnic cleansings about the history, culture, and destruction of their communities."}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-11T14:07:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Memorial books"}}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Holocaust) Memorial Books (During the interwar period Jewish communities began documenting their losses via memorial books known as yizker bikher, yizkor bikher, sifre zikaron, or pinkeysim, they are written monuments commemorating the life and death of a place and its people; The books tend to have a four-part structure: (1) a description of the town and its people from its Jewish beginning to the 20th-century interwar period, (2) a description of the town and its people during the Nazi era, (3) a description of the town and its people during the postwar time, and (4) a necrology. The earliest Holocaust memorial books (c. 1943--1950) came out in numerous countries (the United States, postwar Germany, Argentina, France, and Israel))"}, "madsrdf:citationSource": [{"@id": "https://www.oxfordbibliographies.com/display/document/obo-9780199840731/obo-9780199840731-0145.xml"}, "Oxford bibliographies, viewed online February, 16, 2023:"], "madsrdf:citationStatus": "found"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page iv (Published as part of the Yizkor Books Project of JewishGen, Inc.; Yizkor (Memorial) Books were written by survivors and former residents of Jewish communities throughout the world; The JewishGen Yizkor Book Project takes these works, primarily in Hebrew and Yiddish, and translates them into English) (DLC)2019937360"}, "madsrdf:citationSource": "Work cat: Memorial Book of the communities Dobrzyn-Gollob, Poland, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCSH (Memorial books (Holocaust); Yizkor books; Holocaust memorial books; Jewish memorial books (Holocaust); Memorial volumes (Holocaust); Sifre zikaron (Holocaust); Yisker bikher (Holocaust); Yizker-bikher (Holocaust); Yizkor books (Holocaust)", "madsrdf:citationStatus": "found"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Houshamadyan, a project to reconstruct Ottoman Armenian town and village life)"}, "madsrdf:citationSource": [{"@id": "https://www.houshamadyan.org/"}, "houshamadyan.org website, viewed on September 7, 2023"], "madsrdf:citationStatus": "found"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Reimagining Home: Armenian Memorial Books at the Library of Congress, November 17, 2021; The destruction of the Ottoman Empire's Armenian population during World War I severed the connection of survivors and their descendants from their ancestral homes in what is today the Republic of Turkey. Scattered around the globe, Armenians strove to keep the memory of their hometowns alive in the minds of subsequent generations. The literary genre of the hushamatean (memorial book) emerged as an enduring legacy of this effort)"}, "madsrdf:citationSource": [{"@id": "https://blogs.loc.gov/international-collections/2021/11/reimagining-home-armenian-memorial-books-at-the-library-of-congress/"}, "International-collections website, viewed on September 7, 2023"], "madsrdf:citationStatus": "found"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Title page (\u1e24ushamatean Mets Eghe\u1e5bn [Memorial book of the Great Catastrophe/Calamity i.e. Armenian Genocide]) (OCoLC)25392119"}, "madsrdf:citationSource": "\u1e24ushamatean Mets Eghe\u1e5bni, 1915-1965,", "madsrdf:citationStatus": "found"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hushamatyan Eghe\u1e5bni, 1915-1965, published in Beirut, Lebanon, for the commemoration of the 60th anniversary of the Armenian Genocide)"}, "madsrdf:citationSource": [{"@id": "https://hy.wikipedia.org/wiki/%D5%80%D5%B8%D6%82%D5%B7%D5%A1%D5%B4%D5%A1%D5%BF%D5%B5%D5%A1%D5%B6_%D5%84%D5%A5%D5%AE_%D5%A5%D5%B2%D5%A5%D5%BC%D5%B6%D5%AB,_1915-1965"}, "Wikipedia in Armenian, viewed on September 11, 2023"], "madsrdf:citationStatus": "found"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (\u05e1\u05e4\u05e8\u05be\u05d9\u05d6\u05db\u05d5\u05e8 \u05d0\u05d5\u05e1\u05d8\u05e8\u05d5\u05d1\u05be\u05dc\u05d5\u05d1\u05dc\u05e1\u05e7\u05d9 = Sefer-yizkor Os\u1e6drov-Lubels\u1e33i ; \u05d9\u05d6\u05db\u05d5\u05e8\u05be\u05d1\u05d5\u05da \u05d0\u05e1\u05d8\u05e8\u05d5\u05d5\u05d5\u05be\u05dc\u05d5\u05d1\u05e2\u05dc\u05e1\u05e7\u05d9 = Yizkor-bukh Os\u1e6dru\u1e7f-Lubels\u1e33i; Memorial-book Ostrow-Lubelski [in rom.])"}, "madsrdf:citationSource": "Sefer-yizkor Os\u1e6drov-Lubels\u1e33i = \u05e1\u05e4\u05e8\u05be\u05d9\u05d6\u05db\u05d5\u05e8 \u05d0\u05d5\u05e1\u05d8\u05e8\u05d5\u05d1\u05be\u05dc\u05d5\u05d1\u05dc\u05e1\u05e7\u05d9, 1987:", "madsrdf:citationStatus": "found"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (\u1e24ushamatean [memorial book]) (OCoLC)34678937"}, "madsrdf:citationSource": "Mataghchean, T\u02bboros M. \u1e24ushamatean T\u02bbomarzayi, 1959", "madsrdf:citationStatus": "found"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Yizkor book (A book commemorating a European Jewish community that was destroyed during the HOLOCAUST; Generally, a Yizkor book will concentrate on a large community, but may include chapters on smaller communities located nearby; Most Yizkor books cover the Jewish communities in Eastern Europe; There have also been Yizkor books written about the Jewish communities in Western Europe, especially those that thrived in GERMANY before the Nazi rise to power; Yizkor books generally include articles on a community's history from before the war, but mainly focus on the war years, including details about life in the ghettos and the camps, resistance activities, Nazi collaborators and RIGHTEOUS AMONG THE NATIONS, and the annihilation of the community members; They also include articles about the post-war years, and may provide information about victims and survivors; books may also include personal diaries, poems, and other documents written by Jews during the Holocaust)"}, "madsrdf:citationSource": "Encyclopedia of the Holocaust, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page (\u1e24ushamatean Kutinahayeru [Memorial book of the Kutina (i.e. K\u00fctahya, Turkey)Armenians]) (OCoLC)35316169"}, "madsrdf:citationSource": "\u1e24ushamatean kutinahayeru, 1961", "madsrdf:citationStatus": "found"}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Memorial volumes"}}, {"@id": "_:nac734444b8f64b5f96dab5f8c8e5a33ab17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Memorial volumes"}}], "@id": "/authorities/genreForms/gf2023026020"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026021", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBenga (Music)", "identifiers:lccn": "gf2023026021", "madsrdf:adminMetadata": [{"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb1"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Benga (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb5"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb6"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb7"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb8"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb9"}], "madsrdf:hasVariant": {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb10"}, "madsrdf:historyNote": "[Established July 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-02-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "new"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-27T14:43:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Benga (Music)"}}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 136 (Developed in Kenya in the 1970s, a new style called benga began to emerge. Developed in the western regions among the Luo people, benga has come to be seen as the definitive Kenyan pop, regardless of language or regional identification)"}, "madsrdf:citationSource": "Garland handbook of African music, 2008, Jan. 9, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Benga; Term used in Kenya to refer to a variety of popular music forms. It is used in particular to refer to a style of music that emerged in the 1960s among the Luo people in the area surrounding Lake Victoria in western Kenya. Kikuyu and Kamba musicians also developed regional variations of benga. The benga guitar-based style became nationally recognized during the 1970s. The roots of the guitar-playing style may be found in nyatiti (lyre) playing; Benga is characterized by a tight blend of vocals and lead and bass guitars, with the bass guitar providing a strong rhythmic pulsation throughout; Benga was preserved as an older guitar-band tradition in western Kenya, but also influenced the development of emergent musical traditions during the last two decades of the 20th century)"}, "madsrdf:citationSource": "Grove music online, Jan. 12, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Wapako ratigo : benga ; J. Ogola Wakili : benga)"}, "madsrdf:citationSource": "Work cat: Ochuka, Festo. Wapako ratigo, 197-?:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(benga (uncountable [noun with no plural form]); genre of Kenyan popular music in an urban style associated with stringed instrumentation)"}, "madsrdf:citationSource": "Wiktionary, Jan. 12, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Benga; Kenyan genre known as benga. Translated as \"beautiful thing\" in the Luo language, benga's roots as a rhythmic, incisive style lie in Cuban music and Congolese rumba. The genre first developed in East Africa in the early 1970s, unifying various characteristics of Kenya's musical past, and it quickly helped crystallize poetic traditions of the country's disparate communities, with lyrics conveying powerful political messages alongside more carefree lines of love and longing)"}, "madsrdf:citationSource": [{"@id": "https://daily.redbullmusicacademy.com/2018/02/tracing-the-roots-of-kenyan-benga"}, "Red Bull Music Academy WWW site, Jan. 12, 2023"], "madsrdf:citationStatus": "found"}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Benga songs"}}, {"@id": "_:n4f0b77aabe004df8aa82fdb7a06eb18eb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Benga songs"}}], "@id": "/authorities/genreForms/gf2023026021"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026025", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFairy tale comics", "identifiers:lccn": "gf2023026025", "madsrdf:adminMetadata": [{"@id": "_:n81e2cc959b9d48c7969866381de6ae99b1"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fairy tale comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n81e2cc959b9d48c7969866381de6ae99b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026331"}, "madsrdf:hasSource": [{"@id": "_:n81e2cc959b9d48c7969866381de6ae99b5"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b6"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b7"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b8"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b9"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b10"}], "madsrdf:hasVariant": {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b11"}, "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that adapt, retell, or are inspired by fairy tales or folklore."}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-31T11:18:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fairy tale comics"}}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"One of the world's greatest fairy tales is re-told in a graphic-novel format. When their mother sends them packing, the Three Little Pigs are forced to build houses of their own. They had better be sturdy and strong because the Big Bad Wolf is on the prowl, and he's ready to huff and puff his way inside. Will they survive against this hungry beast? Or will the pigs become his next tasty treat?\") (OCoLC)1152006657"}, "madsrdf:citationSource": "Trumbauer, L. The three little pigs : the graphic novel, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"For over two hundred years the powerful stories of the Brothers Grimm have enchanted millions around the world, but there has never been an adaptation as intriguing or provocative as this. Grimm Fairy Tales Volume 1 explores a much darker side of the infamous fables you heard as a child as these classic tales are retold and re-imagined with a terrifying twist you'll simply love as an adult\") (OCoLC)973690197"}, "madsrdf:citationSource": "Tyler, J. Grimm fairy tales, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Modern twists on traditional favorites add characters from \"Spider-Man\" to fairy tales and folktales, including \"Little Red Riding Hood,\" \"Cinderella,\" \"Anansi the Spider-God,\" and \"Tsuchigumo the Japanese Spider Spirit.\") (OCoLC)187914797"}, "madsrdf:citationSource": "Cebulski, C. B. Spider-Man fairy tales, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p.173 (\"cartoonists have created revealing images that place the perfect world of classical fairy tales in striking contrast with imperfect reality. They usually ignore the positive ending of traditional tales and instead concentrate on special scenes interpreted as signs of a troubled society.\") p. 423 (Graphic novels and comic books treat folktales and fairy tales in three categories: retellings, adaptations, and pastiches) (OCoLC)936547995"}, "madsrdf:citationSource": "Folktales and fairy tales : traditions and texts from around the world, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: In this new feminist, queer fairy tale collection, the princesses, mermaids, barmaids, children, and wise old women who have been forced to sit on the sidelines in classic stories take center stage to fulfill their own dreams and find the love, power, and happiness they deserve) (OCoLC)1286676394"}, "madsrdf:citationSource": "Work cat: Gillman, M. Other ever afters : new queer fairy tales, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"This study discusses such topics as Fables' status as a contemporary adaptation of folk and fairy tales; its use of conventional genres like sword-and-sorcery, crime and romance; its portrayal of social and political relationships; and its self-referential moments\") (OCoLC)932578458"}, "madsrdf:citationSource": "Gordon, N. A tour of Fabletown : patterns and plots in Bill Willingham's Fables, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n81e2cc959b9d48c7969866381de6ae99b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fairytale comics"}}, {"@id": "_:n81e2cc959b9d48c7969866381de6ae99b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fairytale comics"}}], "@id": "/authorities/genreForms/gf2023026025"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026026", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSoundies (Motion pictures)", "identifiers:lccn": "gf2023026026", "madsrdf:adminMetadata": [{"@id": "_:n66dff1d4b3764d329fb83ea806931a74b1"}, {"@id": "_:n66dff1d4b3764d329fb83ea806931a74b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Soundies (Motion pictures)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n66dff1d4b3764d329fb83ea806931a74b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026570"}, "madsrdf:hasSource": [{"@id": "_:n66dff1d4b3764d329fb83ea806931a74b5"}, {"@id": "_:n66dff1d4b3764d329fb83ea806931a74b6"}, {"@id": "_:n66dff1d4b3764d329fb83ea806931a74b7"}, {"@id": "_:n66dff1d4b3764d329fb83ea806931a74b8"}], "madsrdf:historyNote": "[Established July 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n66dff1d4b3764d329fb83ea806931a74b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n66dff1d4b3764d329fb83ea806931a74b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-27T14:43:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n66dff1d4b3764d329fb83ea806931a74b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soundies (Motion pictures)"}}, {"@id": "_:n66dff1d4b3764d329fb83ea806931a74b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 310 (Soundies; musical shorts of three minutes' duration featuring jazz numbers or popular music with well- and lesser-known personalities that could be heard and viewed by putting a nickel in a jukebox equipped with a 24 by 18 inch plastic screen; first introduced in 1940; popularity faded after World War II)"}, "madsrdf:citationSource": "Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66dff1d4b3764d329fb83ea806931a74b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 191 (Soundies; the name given to a film jukebox presentation popular in the early forties; patrons could view a three-minute musical short on a 24-by-18 inch plastic screen; the film was projected by mirrors within the jukebox, called a Panoram, and thus required that the film be printed in reverse; they lost their appeal by the end of WWII)"}, "madsrdf:citationSource": "Slide, A. The new historical dictionary of the American film industry, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66dff1d4b3764d329fb83ea806931a74b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(DLC)2023602000"}, "madsrdf:citationSource": "Work cat: Chicken Shack shuffle, 1943:", "madsrdf:citationStatus": "found"}, {"@id": "_:n66dff1d4b3764d329fb83ea806931a74b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Appendix 1, Directory of Black-cast Soundies (Chicken Shack shuffle, 1943)"}, "madsrdf:citationSource": "Delson, S. Soundies and the changing image of Black Americans on screen, 2021:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2023026026"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026027", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTarot cards", "identifiers:lccn": "gf2023026027", "madsrdf:adminMetadata": [{"@id": "_:ne7eccd3e524f465587403ff4ce158124b1"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tarot cards"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne7eccd3e524f465587403ff4ce158124b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027252"}, "madsrdf:hasSource": [{"@id": "_:ne7eccd3e524f465587403ff4ce158124b5"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b6"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b7"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b8"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b9"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b10"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b11"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b12"}], "madsrdf:hasVariant": [{"@id": "_:ne7eccd3e524f465587403ff4ce158124b13"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b16"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b19"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b22"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b25"}], "madsrdf:historyNote": "[Established July 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Set of cards used for fortune-telling or to play tarot games."}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-27T14:43:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tarot cards"}}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tarot cards are a divination tool consisting of 78 cards, 22 Major Arcana, 56 Minor Arcana with four suits and court cards)"}, "madsrdf:citationSource": "What is the difference between tarot, oracle cards, and angel cards?, via Jerusalem Post, Mar. 31, 2021, viewed online Mar. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Tarot (The tarot (first known as trionfi and later as tarocchi or tarocks) is a pack of playing cards, used from at least the mid-15th century in various parts of Europe to play card games such as Tarocchini. From their Italian roots, tarot playing cards spread to most of Europe evolving into a family of games that includes German Grosstarok and modern games such as French Tarot and Austrian K\u00f6nigrufen. In the late 18th century, French occultists made elaborate, but unsubstantiated, claims about their history and meaning, leading to the emergence of custom decks for use in divination via tarot card reading and cartomancy. Thus there are two distinct types of tarot pack: those used for card games and those used for divination; like the common playing cards, tarot has four suits which vary by region)"}, "madsrdf:citationSource": "Wikipedia, Mar. 13, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(78-card tarot deck) (OCoLC)1372192240"}, "madsrdf:citationSource": "Work cat.: Cullinane, MJ. Crow tarot, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Divination cards (tarot vs. oracle vs. Lenormand; all are types of divination cards for different purposes)"}, "madsrdf:citationSource": "Green witch living, viewed July 12, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tarot cards. SN Pictorial playing cards made specifically for forecasting the future and as trumps in tarok games. Issued in sets of 22; depict such characters and forces as the the fool and the tower. UF Tarots. BT Fortune telling cards)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, Mar. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tarot, playing card; tarot, any of a set of cards used in tarot games and in fortune-telling. Tarot decks were invented in Italy in the 1430s by adding to the existing four-suited pack a fifth suit of 21 specially illustrated cards called trionfi (\"triumphs\") and an odd card called il matto (\"the fool\"))"}, "madsrdf:citationSource": "Britannica online, Mar. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tarot cards. BT fortune-telling cards. RT playing cards)"}, "madsrdf:citationSource": "AFS Ethnographic thesaurus, via LC Linked Data Service, Mar. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tarot card. BT game equipment)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Mar. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7eccd3e524f465587403ff4ce158124b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tarot decks"}}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tarot decks"}}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7eccd3e524f465587403ff4ce158124b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tarot playing cards"}}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tarot playing cards"}}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7eccd3e524f465587403ff4ce158124b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tarots"}}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tarots"}}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7eccd3e524f465587403ff4ce158124b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Decks, Tarot"}}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Decks, Tarot"}}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne7eccd3e524f465587403ff4ce158124b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Divination cards (Tarot cards)"}}, {"@id": "_:ne7eccd3e524f465587403ff4ce158124b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Divination cards (Tarot cards)"}}], "@id": "/authorities/genreForms/gf2023026027"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026028", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOracle cards", "identifiers:lccn": "gf2023026028", "madsrdf:adminMetadata": [{"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb1"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Oracle cards"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026111"}], "madsrdf:hasSource": [{"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb5"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb6"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb7"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb8"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb9"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb10"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb11"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb12"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb13"}], "madsrdf:hasVariant": [{"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb14"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb17"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb20"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb23"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb26"}], "madsrdf:historyNote": "[Established July 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Set of cards used for divination and often customized by the user."}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-27T14:43:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oracle cards"}}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Cullinane, MJ. Urban crow oracle, 2022 (deck of 54 oracle cards) (OCoLC)1372192710"}, "madsrdf:citationSource": "Work cat.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(oracle card decks; Tarot follows a predictable structure: While you'll find a lot of different tarot card designs, most decks based on the Rider-Waite system (the most common one today) contain the same 78 cards, with meanings that broadly remain consistent across all decks; When we say \"oracle cards,\" however, we're referring to pretty much every other type of spiritual card deck. With these, there are no rules. The number of cards, themes, artwork, and messaging usually varies widely from deck to deck; Tarot cards offer the deepest level of detail and storytelling out of all the card types. Each card represents a certain aspect of the human experience, and readers often create spreads of several cards to help shed light on the inner workings of people and situations; oracle cards include: Spirit animal cards; Angel cards; Affirmation cards)"}, "madsrdf:citationSource": "Magner, E. Big deck energy : how to choose the best tarot or oracle cards for you, via Well+Good website, Dec. 25, 2018, viewed Mar. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A follow up to MJ Cullinane's best-selling Crow Tarot, this oracle deck offers readers a way to connect and learn from these highly intelligent, captivating birds; Each card in this oracle deck offers a message to the reader from the fascinating behavior of these birds, from the sacred space of a nest to the community of a murder of crows, from the gift of a shiny trinket to the curiosity of a city crow peering into a human home)"}, "madsrdf:citationSource": "Hay House web page for Urban crow oracle, viewed Mar. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(oracle cards, a set of divinatory cards that are used for personal exploration and ritual; unlike tarot decks, which always have 78 cards, divided into major and minor arcana, oracle cards aren't defined by any kind of set structure)"}, "madsrdf:citationSource": "Oracle cards are the spiritual tool you've probably been missing out on, via In style website, Dec. 30, 2021, viewed Mar. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(deck of 66 cards) (OCoLC)1371467636"}, "madsrdf:citationSource": "Robinson, Kiki. The living altar : an oracle & spell deck for the radical witch, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "oracle cards vs tarot cards (Oracle cards differentiate themselves from the standard Tarot deck in that their symbolism is often channeled through the artist or creator. While Tarot relies on 78 cards that use specific symbolism to tell a story, Oracle cards have varied meanings and uses, all depending on the deck)"}, "madsrdf:citationSource": "Astrology.com website, Mar. 13, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Divination cards (tarot vs. oracle vs. Lenormand; all are types of divination cards for different purposes)"}, "madsrdf:citationSource": "Green witch living, viewed July 12, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Oracle cards are cards with specific messages meant to be used solo as a daily message for spiritual guidance but can be used in a spread or combination with a Tarot card reading. Deck volume varies, and they can consist of 12 or more cards. Most decks tend to be around 30-44 cards. The first kind of Oracle deck created is considered the Lenormand deck, which came to be in the 18th century, known back then as the \"Game of Hope,\" these decks are traditionally 36 cards with well-defined symbology and messaging. Still, many modern decks have deviated from this tradition and have developed their thematic imagery and messages)"}, "madsrdf:citationSource": "What is the difference between tarot, oracle cards, and angel cards?, via Jerusalem post, Mar. 31, 2021, viewed online Mar. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Oracle card decks are closely related to Tarot cards, but they don't follow as many rules. Oracle cards differ because every deck is completely unique, with its own meanings and messages. There is no traditional amount of cards, traditional suits, or traditional imagery. The structure, meanings, and interpretations of the cards are entirely up to the creator of the deck)"}, "madsrdf:citationSource": "19 best oracle card decks listed and ranked in 2023, via Little spark of joy website, Dec. 12, 2022, viewed Mar. 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oracle card decks"}}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oracle card decks"}}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Decks, Oracle"}}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Decks, Oracle"}}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Divination cards (Oracle cards)"}}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Divination cards (Oracle cards)"}}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Oracle decks"}}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Oracle decks"}}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Card decks, Oracle"}}, {"@id": "_:n9800f6ef412f4246aa8bbd4756d68cebb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Card decks, Oracle"}}], "@id": "/authorities/genreForms/gf2023026028"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026030", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRubrics (Liturgical books)", "identifiers:lccn": "gf2023026030", "madsrdf:adminMetadata": [{"@id": "_:n7317ce164f0144ada4557dbb85a7c810b1"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rubrics (Liturgical books)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7317ce164f0144ada4557dbb85a7c810b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026039"}, "madsrdf:hasSource": [{"@id": "_:n7317ce164f0144ada4557dbb85a7c810b5"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b6"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b7"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b8"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b9"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b10"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b11"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b12"}], "madsrdf:hasVariant": [{"@id": "_:n7317ce164f0144ada4557dbb85a7c810b13"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b16"}], "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Directions in liturgical books for the conduct of liturgical services."}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-30T11:35:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rubrics (Liturgical books)"}}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rubric 2: a direction for the conduct of divine service or the administration of the sacraments, inserted in liturgical books)"}, "madsrdf:citationSource": "Dictionary.com, Mar. 20, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)9227580"}, "madsrdf:citationSource": "Rubrics for celebrating Mass, 1965.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)754186276"}, "madsrdf:citationSource": "Catholic Church. The general instruction of the Roman Missal : including norms for the distribution and reception of Holy Communion under both kinds in the dioceses of the United States of America and Universal norms on the liturgical year and the general Roman calendar, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. vii (Historically, ceremonial instruction for Anglican worship has taken two forms. The first is the directions (sometimes called rubrics, because they have often been printed in red) contained in the Book of Common Prayer). The second form is ceremonial guidelines which expand upon the rubrics.) p. v-vi (The rubrics of The Book of Common Prayer supplied the ritual framework--one might say the ritual minimum--of each liturgical action; the rubrics are clearly intended as minimalist indications of the shape of a particular rite) p. viii (Rubrical directions in the Prayer Book are generally of three kinds. 1. Normative rubrics generally in the present indicative: \"is, reads, stand, sit, kneel\", words or phrases such as \"shall, is directed, is required\" or a form of \"be\" with the infinitive. 2. Rubrics which recommend a certain action generally use such words or phrases as \"it is customary; it is fitting; it is desirable; it is recommended; where practicable; where appropriate.\" 3. Permissive rubrics are usually indicated by the word \"may.\" They indicate options without making a requirement or recommendation.)"}, "madsrdf:citationSource": "Stuhlman, Byron D. Prayer book rubrics expanded, \u00a91987:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rubric: 1 a: an authoritative rule, especially : a rule for conduct of a liturgical service)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Mar. 20, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1078966578"}, "madsrdf:citationSource": "The new rubrics of the Roman Breviary and Missal, 1960.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rubric A.I.1.a. A direction in a liturgical book as to how a church service should be conducted, traditionally written or printed in red ink.)"}, "madsrdf:citationSource": "Oxford English dictionary online, Mar. 20, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivision --Liturgy--Texts--Rubrics. UF --Rubrics in liturgical texts. SN Use this subdivision combination as a form subdivision under individual Christian denominations.)"}, "madsrdf:citationSource": "LCSH, Mar. 20, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7317ce164f0144ada4557dbb85a7c810b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rubrical directions (Liturgical books)"}}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rubrical directions (Liturgical books)"}}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7317ce164f0144ada4557dbb85a7c810b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Directions, Rubrical (Liturgical books)"}}, {"@id": "_:n7317ce164f0144ada4557dbb85a7c810b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Directions, Rubrical (Liturgical books)"}}], "@id": "/authorities/genreForms/gf2023026030"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026031", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChoral novels", "identifiers:lccn": "gf2023026031", "madsrdf:adminMetadata": [{"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb1"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Choral novels"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026020"}, "madsrdf:hasSource": [{"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb5"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb6"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb7"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb8"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb9"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb10"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb11"}], "madsrdf:hasVariant": [{"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb12"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb15"}], "madsrdf:historyNote": "[Established November 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "new"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Choral novels"}}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 1 of cover flap (roman choral)"}, "madsrdf:citationSource": "Work cat: Et par le pouvoir d'un mot, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wikidata, viewed March 21, 2023 (choral novel; instance of: novel genre; subclass of: novel)", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(roman choral; single story told by several characters; the chapters are linked with different points of view)"}, "madsrdf:citationSource": "Monde Fantasy website, viewed September 7, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "volume 1, page 4 of cover (choral novel; Somewhere in sub-Saharan Africa, four women successively address the same man. To those who do not hear them, they all reveal their intimate lives, sometimes relating the same episodes from a different point of view)"}, "madsrdf:citationSource": "Cr\u00e9puscule du tourment, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(choral novel; \"romance coral\"; multiple voices fiction; refers above all to a certain narrative construction that multiplies the characters in such a way that the reader is confronted with a proliferation of points of view; the accumulation of focalizations provides the narrative with a diversity of characters, portraits and voices that enriches it and complexifies the portrayal and reading of reality)"}, "madsrdf:citationSource": "Instituto de Literatura Comparada Margarida Losa website, viewed March 21, 2023)", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "The Oxford dictionary of literary term online;The book of literary terms, 2020;The Bedford glossary of critical and literary terms, 2003;The Routledge dictionary of literary terms, 2006", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 39 (roman choral; The choral novel functions more according to a principle that might be called polyscopy - multiplicity of points of view - than that of polyphony, understood as multiplicity of voices. The choral novel corresponds to a certain mode of construction and alternation of focalizations, while the polyphonic novel corresponds to a certain mode of narration where the narrators are multiplied and where it is the characters who are responsible for telling their story themselves)"}, "madsrdf:citationSource": "La polyphonie romanesque au XXe si\u00e8cle, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romans chorals"}}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romans chorals"}}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Multiple voices fiction"}}, {"@id": "_:n3c349e238e8d4e23bcfc3770d75b7e7eb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Multiple voices fiction"}}], "@id": "/authorities/genreForms/gf2023026031"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026034", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAmusement park music", "identifiers:lccn": "gf2023026034", "madsrdf:adminMetadata": [{"@id": "_:nd4b8067259b1403f89068992afd8ff17b1"}, {"@id": "_:nd4b8067259b1403f89068992afd8ff17b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Amusement park music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd4b8067259b1403f89068992afd8ff17b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasSource": [{"@id": "_:nd4b8067259b1403f89068992afd8ff17b5"}, {"@id": "_:nd4b8067259b1403f89068992afd8ff17b6"}, {"@id": "_:nd4b8067259b1403f89068992afd8ff17b7"}], "madsrdf:hasVariant": {"@id": "_:nd4b8067259b1403f89068992afd8ff17b8"}, "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd4b8067259b1403f89068992afd8ff17b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-30T11:35:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd4b8067259b1403f89068992afd8ff17b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-04-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd4b8067259b1403f89068992afd8ff17b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Amusement park music"}}, {"@id": "_:nd4b8067259b1403f89068992afd8ff17b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Yo Ho (A Pirate's Life for Me)\" is the theme song for the Pirates of the Caribbean attractions at Disney theme parks)"}, "madsrdf:citationSource": "Wikipedia, April 4, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4b8067259b1403f89068992afd8ff17b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Amusement parks; composers timed their works precisely to be broadcast over the complex systems of speakers installed throughout the rides and later throughout the park to create immersive soundscapes; daily staged and parade performances; today, both background music and live performances are integral to the amusement park experience)"}, "madsrdf:citationSource": "Grove music online, April 4, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4b8067259b1403f89068992afd8ff17b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "caption (Pirates ride) (DLC)2023560010"}, "madsrdf:citationSource": "Work cat: Bruns, George. Yo ho (a pirates life for me), 1967:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd4b8067259b1403f89068992afd8ff17b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd4b8067259b1403f89068992afd8ff17b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Theme park music"}}, {"@id": "_:nd4b8067259b1403f89068992afd8ff17b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theme park music"}}], "@id": "/authorities/genreForms/gf2023026034"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026035", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVerse hagiographies", "identifiers:lccn": "gf2023026035", "madsrdf:adminMetadata": [{"@id": "_:n0ee05e2f250b475692ea5c04e383482ab1"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Verse hagiographies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0ee05e2f250b475692ea5c04e383482ab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026247"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026503"}], "madsrdf:hasSource": [{"@id": "_:n0ee05e2f250b475692ea5c04e383482ab5"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab6"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab7"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab8"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab9"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab10"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab11"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab12"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab13"}], "madsrdf:hasVariant": {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab14"}, "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-04-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verse hagiographies"}}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the period following the collapse of the Soviet Union can in many respects be viewed as a golden age for the composition and circulation of Islamic hagiographies; a good example of these sorts of post-Soviet peculiarities of Turkmen hagiography is a poem composed and published evidently in the mid-1990s during the rule of Saparmyrat Niyazov devoted to the life and deeds of the Teke saint Ak Ishan (1788-1861))"}, "madsrdf:citationSource": "Frank, A. A Turkmen verse hagiography of the Niyazov Era, by Allen J. Frank, via Hypotheses website, Apr. 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(book is a hagiography in verse of the Turkish Sufi saint Yahya bin \u00d6mer el-Arabi)"}, "madsrdf:citationSource": "Work cat.: Mehmet D\u00e2\u0131\u0302. Mehmed D\u00e2'\u00ee's manaq\u0131b of Be\u015fikta\u015fl\u0131 Yahya Efendi, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pub. desc. (Gonzalo de Berceo's mid-thirteenth-century hagiographical poem, the Vida de Santa Oria)"}, "madsrdf:citationSource": "Berceo, Gonzalo de. Berceo's Vida de Santa Oria, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)11389956"}, "madsrdf:citationSource": "Bridges, Margaret. Generic contrast in Old English hagiographical poetry, 1984.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 497 (hagiographical verse)"}, "madsrdf:citationSource": "International journal of Hindu studies, v. 22 (2018):", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(821 results for \"hagiographical poem\"; 604 results for \"hagiographical poems\"; 907 results for \"hagiographical poetry\"; 127 results for \"hagiographical verse\"; 2,310 results for \"verse hagiography\"; 313 results for \"verse hagiographies\")"}, "madsrdf:citationSource": "Google search, Apr. 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(verse hagiography is considered for devotional purposes, while prose hagiography is for historical or liturgical purposes)"}, "madsrdf:citationSource": "Michelle of Heavenfield. Verse hagiography, via Heavenfield website, Apr. 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(this thesis reappraises Venantius Fortunatus's Life of St. Martin of Tours (Vita S. Martini) as an epic poem which displays close links with late Latin panegyrics in prose and verse: themes and imagery of secular praise literature are redeployed and spiritualized in order to portray Martin as a powerful patron saint for a sixth-century Merovingian audience)"}, "madsrdf:citationSource": "Livorsi, L. Verse hagiography between epic and panegyric, via University of Bristol website, Apr. 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 361 (article title: Exordial tradition and poetic individuality in five OE Hagiographical poems)"}, "madsrdf:citationSource": "English studies, v. 60, no. 4 (1979):", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ee05e2f250b475692ea5c04e383482ab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hagiographical poetry"}}, {"@id": "_:n0ee05e2f250b475692ea5c04e383482ab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hagiographical poetry"}}], "@id": "/authorities/genreForms/gf2023026035"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026037", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:nb88ec279e82e48fd98a8a66460657607b1"}, {"@id": "_:nb88ec279e82e48fd98a8a66460657607b2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This record"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb88ec279e82e48fd98a8a66460657607b3"}]}, "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:variantLabel": {"@language": "en", "@value": "Prefaces"}}, {"@id": "_:nb88ec279e82e48fd98a8a66460657607b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-04-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb88ec279e82e48fd98a8a66460657607b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-05-22T12:29:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:nb88ec279e82e48fd98a8a66460657607b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prefaces"}}], "@id": "/authorities/genreForms/gf2023026037"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026045", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCartonera books", "identifiers:lccn": "gf2023026045", "madsrdf:adminMetadata": [{"@id": "_:n46d76183a7ac4ed48ac10daf09412255b1"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cartonera books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n46d76183a7ac4ed48ac10daf09412255b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}], "madsrdf:hasSource": [{"@id": "_:n46d76183a7ac4ed48ac10daf09412255b5"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b6"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b7"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b8"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b9"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b10"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b11"}], "madsrdf:hasVariant": {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b12"}, "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Books with covers of salvaged cardboard, painted and bound by hand"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-11T12:18:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-05-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/cty"}, "ri:recordStatus": "new"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cartonera books"}}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cartonera: a hand-made literary phenomenon. Libros cartoneros are books made from salvaged cardboard with a hand-painted or collage cover. Produced in limited editions and sold for a fraction of the cost of a professionally produced book, cartonera have become popular across Latin America since the founding of Elo\u00edsa Cartonera in Buenos Aires in 2003.)"}, "madsrdf:citationSource": "British Library, Americas and Oceania Collections blog, May 11, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cartonera books; composed of photocopies that are bound by hand into cardboard covers. Each cover is hand embellished, making every copy a unique object in itself. Their name comes from the Spanish word cartoneros (cardboard pickers))"}, "madsrdf:citationSource": "Cartonera Publishers/Editoriales Cartoneras: Research Help and Resources, via University of Wisconsin Libraries webpage, May 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cartonera' books are accessible, diverse and sustainable for they are made of materials such as cardboard, recycled paper and their pages are often printed on a borrowed printing machine. Their very nature is ephemeral, since they are meant to be disseminated until the materials they are made of disintegrate and disappear. They are a true celebration of literacy, books and reading, because anyone can make and own their 'cartonera' book from scratch)"}, "madsrdf:citationSource": "University of London website, July 20, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cartonera books; BT Small press books)"}, "madsrdf:citationSource": "LCSH, May 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "([cataloger's translation] Livros cartoneros; from the Spanish \"cart\u00f3n\" meaning cardboard; books made in small print shops with covers of re-used cardboard painted and sewn by hand)"}, "madsrdf:citationSource": "Magnolia Cartonera website, May 11, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page verso ([cataloger's translation] Each cartonera book is unique, made with covers of salvaged cardboard, painted and bound by hand one by one) (OCoLC)1121052617"}, "madsrdf:citationSource": "Work cat: Eu dizendo, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Make a Cartonera: Cartoneras are hand-painted books with cardboard covers that appeared in the early 2000s as a response to an economic crisis in Argentina.)"}, "madsrdf:citationSource": "Library of Congress Blogs, May 11, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n46d76183a7ac4ed48ac10daf09412255b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cartoneras"}}, {"@id": "_:n46d76183a7ac4ed48ac10daf09412255b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cartoneras"}}], "@id": "/authorities/genreForms/gf2023026045"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026046", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnime (Motion pictures)", "identifiers:lccn": "gf2023026046", "madsrdf:adminMetadata": [{"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab1"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Anime (Motion pictures)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026049"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026126"}, "madsrdf:hasSource": [{"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab5"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab6"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab7"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab8"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab9"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab10"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab11"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab12"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab13"}], "madsrdf:hasVariant": [{"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab14"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab17"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab20"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab23"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab26"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab29"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab32"}], "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Animated motion pictures employing a set of Japanese stylistic conventions."}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-05-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anime (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Original animation video & Original video animation (OAV / OVA) are interchangeable terms used in Japan to refer to animation that is released directly to the video market without first going through a theatrical release or television broadcast. In the beginning OAV was used in Japan. However, due to confusion with Adult Video and Audio/Video electronics this acronym was gradually abandoned in favor of OVA.\")"}, "madsrdf:citationSource": "Anime News Network, viewed May 8, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"One of the most distinctive characteristics of anime resides in the characters' faces. While anime characters may possess bodies with relatively proportional body parts, the heads, hair, and facial expressions are usually exaggerated and brightly colored. In fact, most of anime's exaggerated elements occur in regards to the faces, actions, expressions, and colors used... Anime is a type of traditional animation that is often produced by a 2D animation studio. However, it differs from other forms of animation in that it utilizes what is called limited animation. This animation technique involves using pieces from each scene that are the same in the next scene\")"}, "madsrdf:citationSource": "Show me the animation, website viewed May 8, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Originally released as an OAV (Original animation video) in 1998 as a sequel to the Japanese anime series, Saber Marionette J.\") (OCoLC)549769613"}, "madsrdf:citationSource": "Work cat.: SaBer MaRionette J again", "madsrdf:citationStatus": "found"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anime: \"A genre of Japanese or Japanese-style animated film or television entertainment, characterized by a distinctive visual style involving stylized action sequences and usually featuring characters with distinctive large, staring eyes, and typically having a science-fiction or fantasy theme, sometimes including violent or sexually explicit material; a film or television programme of this genre\")"}, "madsrdf:citationSource": "Oxford English dictionary, viewed May 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 29 (\"Outside Japan, the term [anime] most popularly refers to animation originating in Japan. to the West, not all animation is considered anime, and anime is considered a subset of animation. The word 'Japanimation' is neologism that is made by two words, Japan+animation\")"}, "madsrdf:citationSource": "Won, Kang-Sik. A study of anime's success factors in USA and its suggestions, in International journal of contents, v. 3, no. 1, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 27 (\"There are three basic formats for anime. The best quality can be found in the feature films, more often likely to be standalone stories, which receive cinema releases. Then there are the OVA, effectively the direct-to-video anime. TV anime makes up the rest of the market. A significant proportion of TV anime is derived from manga as the source material\") (OCoLC)858690477"}, "madsrdf:citationSource": "Odell, C. Anime, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Catwoman, aka Selina Kyle, has no qualms about risking her nine lives when a prize like the world's most valuable emerald is the reward... Suit up and steal a moment with this anime-style DC movie!\") (OCoLC)1300408169"}, "madsrdf:citationSource": "Catwoman : hunted, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 5 (\"The stylistic distinctiveness of anime as both a cinematographical medium and a pictorial art has traditionally resided with its tendency to foreground the eminently hand-drawn quality of the animated image\") (OCoLC)144547871"}, "madsrdf:citationSource": "Cavallaro, D. Anime intersections, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Anime (genre) (\"A genre of animated film or television entertainment distinctively Japanese or in Japanese-style, characterized by a visual style involving stylized action sequences and usually featuring characters with distinctive large, staring eyes, and typically having a having themes of science-fiction, fantasy, violence, or sexually explicit material\")"}, "madsrdf:citationSource": "Art and architecture thesaurus, viewed May 5, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "OVA (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "OVA (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Japanimation (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Japanimation (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anime-style motion pictures"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anime-style motion pictures"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "OAV (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "OAV (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Direct-to-video anime (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Direct-to-video anime (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Original animation video (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Original animation video (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Original video animation (Motion pictures)"}}, {"@id": "_:ne848cdcae0084a078cb1ee6faa4ccc3ab33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Original video animation (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2023026046"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026047", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAnime (Television programs)", "identifiers:lccn": "gf2023026047", "madsrdf:adminMetadata": [{"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b1"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Anime (Television programs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026050"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026124"}, "madsrdf:hasSource": [{"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b5"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b6"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b7"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b8"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b9"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b10"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b11"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b12"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b13"}], "madsrdf:hasVariant": [{"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b14"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b17"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b20"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b23"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b26"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b29"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b32"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b35"}], "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Animated television programs employing a set of Japanese stylistic conventions."}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-05-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anime (Television programs)"}}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Original animation video & Original video animation (OAV / OVA) are interchangeable terms used in Japan to refer to animation that is released directly to the video market without first going through a theatrical release or television broadcast. In the beginning OAV was used in Japan. However, due to confusion with Adult Video and Audio/Video electronics this acronym was gradually abandoned in favor of OVA\")"}, "madsrdf:citationSource": "Anime News Network, viewed May 8, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"One of the most distinctive characteristics of anime resides in the characters' faces. While anime characters may possess bodies with relatively proportional body parts, the heads, hair, and facial expressions are usually exaggerated and brightly colored. In fact, most of anime's exaggerated elements occur in regards to the faces, actions, expressions, and colors used... Anime is a type of traditional animation that is often produced by a 2D animation studio. However, it differs from other forms of animation in that it utilizes what is called limited animation. This animation technique involves using pieces from each scene that are the same in the next scene\")"}, "madsrdf:citationSource": "Show me the animation, website viewed May 8, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 27 (\"There are three basic formats for anime. The best quality can be found in the feature films, more often likely to be standalone stories, which receive cinema releases. Then there are the OVA, effectively the direct-to-video anime. TV anime makes up the rest of the market. A significant proportion of TV anime is derived from manga as the source material\") (OCoLC)858690477"}, "madsrdf:citationSource": "Odell, C. Anime, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Anime (genre) (\"A genre of animated film or television entertainment distinctively Japanese or in Japanese-style, characterized by a visual style involving stylized action sequences and usually featuring characters with distinctive large, staring eyes, and typically having a having themes of science-fiction, fantasy, violence, or sexually explicit material\")"}, "madsrdf:citationSource": "Art and architecture thesaurus, viewed May 5, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 5 (\"The stylistic distinctiveness of anime as both a cinematographical medium and a pictorial art has traditionally resided with its tendency to foreground the eminently hand-drawn quality of the animated image\") (OCoLC)144547871"}, "madsrdf:citationSource": "Cavallaro, D. Anime intersections, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anime: \"A genre of Japanese or Japanese-style animated film or television entertainment, characterized by a distinctive visual style involving stylized action sequences and usually featuring characters with distinctive large, staring eyes, and typically having a science-fiction or fantasy theme, sometimes including violent or sexually explicit material; a film or television programme of this genre\")"}, "madsrdf:citationSource": "Oxford English dictionary, viewed May 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 29 (\"Outside Japan, the term [anime] most popularly refers to animation originating in Japan. To the West, not all animation is considered anime, and anime is considered a subset of animation. The word 'Japanimation' is neologism that is made by two words, Japan+animation\")"}, "madsrdf:citationSource": "Won, Kang-Sik. A study of anime's success factors in USA and its suggestions, in International journal of contents, v. 3, no. 1, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Jackie Chan teams up in this anime-style adventure with his 11-year-old niece, Jade, traveling the globe to locate a dozen magical talismans before the sinister Dark Hand does) (OCoLC)794688877"}, "madsrdf:citationSource": "Jackie Chan adventures, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Japanese television anime series, originally broadcast in 2007\") (OCoLC)436097233"}, "madsrdf:citationSource": "Work cat: Lucky star OVA (original visual animation), 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Japanimation (Television programs)"}}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Japanimation (Television programs)"}}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Original animation video (Television programs)"}}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Original animation video (Television programs)"}}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Direct-to-video anime (Television programs)"}}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Direct-to-video anime (Television programs)"}}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "TV anime"}}, {"@id": "_:n33d769e8de0647dfb9e8a313f2d0dfe9b24", "@type": "mads