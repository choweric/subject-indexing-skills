loging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-12-14T12:43:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lobby cards"}}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(reproductions of lobby cards)"}, "madsrdf:citationSource": "Kobal, J Foyer pleasure : the golden age of cinema lobby cards, 1982", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lobby cards. BT Display cards. RT Motion picture posters. SN Motion picture advertisements intended for display in a theater lobby or showcase window. Often small versions of movie posters. The standard size established by the Motion Pictures Patent Company in 1909 is 11 x 14 inches)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Oct. 4, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(reproductions of lobby cards)"}, "madsrdf:citationSource": "Work cat.: Scott, K.L. Lobby cards : the classic comedies, \u00a91988", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lobby cards. UF Cards, Lobby; Display cards (Motion picture advertising); Scene cards (Motion picture advertising); Title cards (Motion picture advertising); Title lobby cards. BT Advertising--Motion pictures. BT Film posters. SN Here are entered works on posters printed on card stock advertising motion pictures, meant to be displayed in movie theater lobbies)"}, "madsrdf:citationSource": "LCSH, Oct. 4, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "National Film Archive (Australia). Australian feature films 1970+ : stills, posters, lobby cards, 1981.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (movie posters & colorful theater lobby cards)"}, "madsrdf:citationSource": "Matetsky, A.M. The films of Elvis, 1982:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 26 (Lobby card; standard lobby cards were 11 x 14 in., jumbo lobby cards were 14 x 17 in., and mini lobby cards were 8 x 14 in.; cards generally came in sets of eight numbered cards, which may include a title card, several scene cards, and a dead card)"}, "madsrdf:citationSource": "Poole, E.E. Collecting movie posters, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lobby cards. BT posters. SN Cards displayed in movie theater lobbies to advertise motion pictures; usually 11 by 14 inches and issued in sets of eight)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Oct. 4, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3194633e30b4e1a8e803cb295875209b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cinema lobby cards"}}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cinema lobby cards"}}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd3194633e30b4e1a8e803cb295875209b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cards, Lobby"}}, {"@id": "_:nd3194633e30b4e1a8e803cb295875209b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cards, Lobby"}}], "@id": "/authorities/genreForms/gf2017026119"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026121", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSports writing", "identifiers:lccn": "gf2017026121", "madsrdf:adminMetadata": [{"@id": "_:na7802746acd549039b5f0cd51e416ac3b1"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sports writing"}, "madsrdf:elementList": {"@list": [{"@id": "_:na7802746acd549039b5f0cd51e416ac3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026074"}, "madsrdf:hasSource": [{"@id": "_:na7802746acd549039b5f0cd51e416ac3b5"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b6"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b7"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b8"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b9"}], "madsrdf:hasVariant": [{"@id": "_:na7802746acd549039b5f0cd51e416ac3b10"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b13"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-05T13:53:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sports writing"}}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 11 (prize-winning stories of 1953) p. 15 (three classifications: news coverage; news features; and magazines; the efforts of sports writers) 1966 ed., bk. jkt. (the top sports writing of today--with action reporting and behind-the-scenes portraits; vivid reporting of all aspects of the sports world of 1965) p. 7 (Best News-Coverage Story; Best News-Feature Story; Best Magazine Story)"}, "madsrdf:citationSource": "Work cat.: Best sports stories, 1954 ed.:", "madsrdf:citationStatus": "found"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sportswriting: the work of a sports writer)"}, "madsrdf:citationSource": "Collins English dictionary online, Oct. 10, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "introd. (\"The best sports stories are based not on interviews but on conversations--conversations with people who are sometimes reluctant, sometimes in the orneriest mood, often not the most glib or polished conversationalists\")"}, "madsrdf:citationSource": "The best American sports writing, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sportswriter: a person who writes about sports especially for a newspaper; --sportswriting)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Oct. 10, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sports writing is a form of journalism or creative nonfiction in which a sporting event, individual athlete, or sports-related issue serves as the dominant subject)"}, "madsrdf:citationSource": "Nordquist, R. Sports writing as a form of creative nonfiction, via ThoughtCo. website, posted June 28, 2017, viewed on Oct. 10, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7802746acd549039b5f0cd51e416ac3b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sportswriting"}}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sportswriting"}}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7802746acd549039b5f0cd51e416ac3b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sports stories (Nonfiction)"}}, {"@id": "_:na7802746acd549039b5f0cd51e416ac3b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sports stories (Nonfiction)"}}], "@id": "/authorities/genreForms/gf2017026121"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026122", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGay fiction", "identifiers:lccn": "gf2017026122", "madsrdf:adminMetadata": [{"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b1"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gay fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026063"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b5"}, "madsrdf:hasSource": [{"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b8"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b9"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b10"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b11"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b12"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b13"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b14"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b15"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b16"}], "madsrdf:hasVariant": [{"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b17"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction featuring gay characters or addressing gay themes.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026352"}}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-11T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ic"}, "ri:recordStatus": "revised"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay fiction"}}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay erotic fiction"}}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay erotic fiction"}}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xiii (before the 1970's there had been \"mainstream\" gay fiction. James Baldwin's Giovanni's Room is one good example; Sanford Friedman's Totempole is another. But, in general, fiction that dealt with homosexuality fell into one of three categories: pornography, problem novels, and \"high\" literature)"}, "madsrdf:citationSource": "Canning, R. Gay fiction speaks, \u00a92000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Homosexual fiction, 1958?", "madsrdf:citationStatus": "found"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gay fiction, while certainly a genre, has most often been a means of self-expression, within which gay men have written tales of their search for identity and community; their novels delved into the very heart of what it means to be gay: how our familial relationships may change as a result of living authentically, how the disapproval from society can shape self-esteem, how the gay male's search for love and sex may differ from others, and how the AIDS epidemic altered the framework and communities many of us live within; there have certainly been well-known female authors of gay male fiction, most prominently Patricia Nell Warren and Mary Renault; gay fiction has splintered, with genres within sub-genres blurring the lines; with the explosion of the male/male romance genre (m/m for short), I'm seeing more and more authors not only using pseudonyms but actually trying to pass themselves off as gay men in their media interviews and online marketing efforts; Traditional gay male literature has focused on gay men attempting to find their own truth, charting both struggle and success in living out and open lives. There is no preconceived formula, resulting in stories that often mirror the life experiences of both writer and readers)"}, "madsrdf:citationSource": "Edwards-Stout, K. Gender of novelists in gay fiction: does it matter?, via HuffPost website, posted Nov 04, 2012, viewed on Oct. 11, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bradley, M.Z. A complete cumulative checklist of lesbian, variant, and homosexual fiction, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Arobateau, R.J. Homosexual stories, \u00a91977.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 8 (writing gay fiction) p. 9 (the gay male voice; gay fiction is not only alive and well, but exciting and new; the aspect of sexuality is attacked, deconstructed, manipulated, or even dismissed; voices portraying a tale of a fractured community) pp. 299-305 (authors are both men and women)"}, "madsrdf:citationSource": "Work cat.: Cool thing : the best new gay fiction from young American writers, \u00a92008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Best American gay fiction, c1996-", "madsrdf:citationStatus": "found"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(During this century, a few lonely voices--not all of them gay males--have created landmark fiction about the homosexual experience; gay literature has broadened into a general, if controversial, category with clearly definable patterns. To oversimplify the matter, we could say that gay writing has changed since World War II from a literature of guilt and apology to one of political defiance and celebration of sexual difference. But in the last few years it has eased into more private matters, family relations and the search for domestic contentment; gay stories and novels; gay fiction; Nowadays, a gay novel rarely explains, complains or apologizes. It assumes that ignorance about homosexuality is a thing of the past and that bigotry signifies either a poor education or a retrograde conscience; finding a family of sorts has become the chief interest of characters in much gay fiction; the sexual outlaw, long a staple of gay fiction (the phrase was the title of a book by John Rechy, one of the pioneers in the genre), is giving way to the sexual in-law)"}, "madsrdf:citationSource": "Hall, R. Gay fiction comes home, in New York times books section, June 19, 1988, viewed online Oct. 11, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(works of fiction that heavily feature queer themes; works listed include works by straight authors)"}, "madsrdf:citationSource": "Coates, T. 50 essential works of LGBT fiction, via Flavorwire website, posted Aug. 21, 2013, viewed Oct. 11, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay erotic fiction"}}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay erotic fiction"}}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Homosexual fiction"}}, {"@id": "_:n2006fb05b1ac415a86665f994bbc2c29b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Homosexual fiction"}}], "@id": "/authorities/genreForms/gf2017026122"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026123", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSports posters", "identifiers:lccn": "gf2017026123", "madsrdf:adminMetadata": [{"@id": "_:n26b723730cfc473a818aa0cdd359d462b1"}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sports posters"}, "madsrdf:elementList": {"@list": [{"@id": "_:n26b723730cfc473a818aa0cdd359d462b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026152"}, "madsrdf:hasSource": [{"@id": "_:n26b723730cfc473a818aa0cdd359d462b5"}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b6"}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b7"}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b8"}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b9"}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b10"}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b11"}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b12"}], "madsrdf:hasVariant": [{"@id": "_:n26b723730cfc473a818aa0cdd359d462b13"}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b16"}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-10-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n26b723730cfc473a818aa0cdd359d462b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"