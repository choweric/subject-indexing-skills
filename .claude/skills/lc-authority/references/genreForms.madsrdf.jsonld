{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026355", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGhazals (Poetry)", "identifiers:lccn": "gf2014026355", "madsrdf:adminMetadata": [{"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb1"}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ghazals (Poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb5"}, "madsrdf:hasSource": [{"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb8"}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb9"}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb10"}], "madsrdf:hasVariant": [{"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb11"}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems consisting of at least five couplets that are linked by rhyme and/or repetition, in which the final couplet generally mentions the poet by name."}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-14T11:42:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghazals (Poetry)"}}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ghazals"}}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghazals"}}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ghazal: A poetic form of Persian origin, consisting of five or more syntactically complete couplets linked by rhyme and the repetition of a closing word or phrase)"}, "madsrdf:citationSource": "American heritage dictionary of the English language, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ghazal; Persian poetry form; a poem of five to twelve couplets, all using the same rhyme, with the poet putting his name in the final stanza; in its contemporary form, the ghazal doesn't usually rhyme, poets don't sign their name in the last couplet, and it isn't very often about love or drinking; the two important features of the contemporary ghazal are the long-lined couplets (sometimes unrhymed) and the often mystical thoughts that are expressed)"}, "madsrdf:citationSource": "The Teachers & Writers handbook of poetic forms, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Ghazal: song, elegy of love, often also the erotico-elegiac genre. The term is Arabic, but passed into Persian, Turkish and Urdu and acquired a special sense in these languages; amatory elegy; amatory elegiac genre; ghazals; under Na\u1e93m\u012b, Me\u1e25med: ghazels)"}, "madsrdf:citationSource": "The encyclopaedia of Islam, via WWW, Feb. 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ghazals"}}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghazals"}}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ghazels (Poetry)"}}, {"@id": "_:n265d9cdcb17b4bf085790bf5bfb86e3cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghazels (Poetry)"}}], "@id": "/authorities/genreForms/gf2014026355"}
