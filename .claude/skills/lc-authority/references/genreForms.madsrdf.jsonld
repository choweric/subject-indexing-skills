:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd306b021e3154c6fb98c15d017e5102bb37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Association, Articles of"}}, {"@id": "_:nd306b021e3154c6fb98c15d017e5102bb37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Association, Articles of"}}, {"@id": "_:nd306b021e3154c6fb98c15d017e5102bb39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd306b021e3154c6fb98c15d017e5102bb40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Articles of organization"}}, {"@id": "_:nd306b021e3154c6fb98c15d017e5102bb40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Articles of organization"}}], "@id": "/authorities/genreForms/gf2011026119"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026120", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChase films", "identifiers:lccn": "gf2011026120", "madsrdf:adminMetadata": [{"@id": "_:n1e0923277c994b5f9fe4343114df0f46b1"}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Chase films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1e0923277c994b5f9fe4343114df0f46b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026570"}, "madsrdf:hasSource": [{"@id": "_:n1e0923277c994b5f9fe4343114df0f46b5"}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b6"}], "madsrdf:hasVariant": [{"@id": "_:n1e0923277c994b5f9fe4343114df0f46b7"}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short films, primarily from the early period of cinema, in which an incident results in someone being chased, usually by a steadily-growing group of people.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025577"}}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T11:29:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chase films"}}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Chase: short, early work, generally made before 1912, in which an incident, often the result of a misunderstanding, results in someone, who may or may not be guilty of a misdeed, being chased. An outraged, motley, steadily-growing group pursues the individual from one location to another until finally an event brings the chase to a sudden end. The conclusion may range from the capture of the pursued to a comical catastrophe for the pursuers)"}, "madsrdf:citationSource": "Moving image genre-form guide online, November 15, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 42 (Chase film; chaser: any film in which a prolonged chase is included as a major element of its plot...chase films or runaway films were a popular form of entertainment in the silent era....Besides being used for comic effect, the chase has also great suspense value, and many genre films such as adventure films, gangster films, westerns and thrillers employ it...today the chase is a very important addition in action and suspense pictures)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1e0923277c994b5f9fe4343114df0f46b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chaser films"}}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chaser films"}}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1e0923277c994b5f9fe4343114df0f46b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Runaway films"}}, {"@id": "_:n1e0923277c994b5f9fe4343114df0f46b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Runaway films"}}], "@id": "/authorities/genreForms/gf2011026120"}
