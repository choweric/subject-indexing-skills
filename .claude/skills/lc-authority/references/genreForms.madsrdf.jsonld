n", "@value": "Theater adaptations"}}], "@id": "/authorities/genreForms/gf2016026007"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026008", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRondeaux (Formes fixes)", "identifiers:lccn": "gf2016026008", "madsrdf:adminMetadata": [{"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b1"}, {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rondeaux (Formes fixes)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027103"}, "madsrdf:hasSource": [{"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b5"}, {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b6"}, {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b7"}], "madsrdf:hasVariant": {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "French songs composed in rondeau form during the 13th-15th centuries."}, {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-04-12T14:20:19"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-01-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rondeaux (Formes fixes)"}}, {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rondeau; an important form of medieval French poetry and music; one of the three formes fixes; either monophonic or polyphonic)"}, "madsrdf:citationSource": "Harvard dict. of music", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Rondeau. One of the three formes fixes (the others are the ballade and the virelai) that dominated French song and poetry in the 14th and 15th centuries. Unlike the ballade and the virelai, the rondeau had taken on its definitive structure by the early 13th century, when it was already a dance-song form of importance... earliest rondeaux... conform to a six-line type with music on the pattern I--I--I--II--I--II; ...the next stage was to introduce the refrain at the opening of the composition as well, resulting in the overall musical form that was to remain the basis of the rondeau thereafter: I--II--I--I--I--II--I--II. The resultant eight-line type is the most common in the late 13th century and the 14th.)"}, "madsrdf:citationSource": "Grove music online, viewed August 4, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(rondeau, pl. rondeaux; medieval monophonic French song characterized by the many repetitions of its two themes or sections)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rondeaus (Formes fixes)"}}, {"@id": "_:nbd0f4c661ae74d9b932a7e74d9e487d9b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rondeaus (Formes fixes)"}}], "@id": "/authorities/genreForms/gf2016026008"}
