atus": "revised"}, {"@id": "_:n4c43edfa38e246a99808fa475e9554bdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "One-act operas"}}, {"@id": "_:n4c43edfa38e246a99808fa475e9554bdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(4 One Act Operas; Barber's The Hand of Bridge; Menotti's The Old Maid and the Thief; Mozart's The Impresario; Puccini's Sister Angelica)"}, "madsrdf:citationSource": "One Act Opera Festival 2005 website, Aug. 18, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c43edfa38e246a99808fa475e9554bdb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Donizetti, Gaetano. Betly : opera comica in un atto = opera comica in one act, \u00a92010.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c43edfa38e246a99808fa475e9554bdb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sheng, Bright. The song of Majnun : opera in one act, \u21171997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c43edfa38e246a99808fa475e9554bdb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Menotti, Gian Carlo. The boy who grew too fast : a one-act opera for young people, 2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c43edfa38e246a99808fa475e9554bdb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Life & work > Biography > 1918-1927 > One-Act operas (Hindemith's triptych of one-act operas M\u00f6rder, Hoffnung der Frauen, Op. 12 (based on Oskar Kokoschka), Das Nusch-Nuschi, Op. 20 (based on Franz Blei) and Sancta Susanna, Op. 21 (based on August Stramm) are considered the epitome of his Expressionism)"}, "madsrdf:citationSource": "Paul Hindemith website, Aug. 18, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c43edfa38e246a99808fa475e9554bdb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category: One-act operas. This category contains operas which are specified in their libretto as having only one act. However, the number of acts is not necessarily an indication of the length of the opera. While most one-act operas have a relatively short running time (under 90 minutes), this is not always the case. For example, the one-act opera Das Rheingold has an approximate running time of 2 hours, 35 minutes)"}, "madsrdf:citationSource": "Wikipedia, Aug. 18, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c43edfa38e246a99808fa475e9554bdb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Moravec, Paul. The king's man : an opera in one act, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4c43edfa38e246a99808fa475e9554bdb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4c43edfa38e246a99808fa475e9554bdb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Single-act operas"}}, {"@id": "_:n4c43edfa38e246a99808fa475e9554bdb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Single-act operas"}}], "@id": "/authorities/genreForms/gf2017026090"}
