4843399e2fce30091c6ca0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gangster television programs"}}, {"@id": "_:n27e03f072d4843399e2fce30091c6ca0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gangster drama. Use for fictional genre films and programs which tend to be set in the city and focus on organized crime. However, include fictional genre films on the so-called \"rural bandits\" who drive about the countryside, e.g. robbing banks. UF Gangster films, Hoodlum drama, Mafia drama, Organized crime drama, Rural bandit drama. BT Crime drama. RT Film noir, Yakuza-eiga)"}, "madsrdf:citationSource": "Yee, M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n27e03f072d4843399e2fce30091c6ca0b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n27e03f072d4843399e2fce30091c6ca0b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Organized crime television programs"}}, {"@id": "_:n27e03f072d4843399e2fce30091c6ca0b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Organized crime television programs"}}, {"@id": "_:n27e03f072d4843399e2fce30091c6ca0b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n27e03f072d4843399e2fce30091c6ca0b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mafia television programs"}}, {"@id": "_:n27e03f072d4843399e2fce30091c6ca0b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mafia television programs"}}, {"@id": "_:n27e03f072d4843399e2fce30091c6ca0b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n27e03f072d4843399e2fce30091c6ca0b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rural bandit television programs"}}, {"@id": "_:n27e03f072d4843399e2fce30091c6ca0b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rural bandit television programs"}}, {"@id": "_:n27e03f072d4843399e2fce30091c6ca0b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n27e03f072d4843399e2fce30091c6ca0b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hoodlum television programs"}}, {"@id": "_:n27e03f072d4843399e2fce30091c6ca0b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hoodlum television programs"}}], "@id": "/authorities/genreForms/gf2011026291"}
