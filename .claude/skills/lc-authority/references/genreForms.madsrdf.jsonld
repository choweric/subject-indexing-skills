: {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfe818bc955b74a97baffba59b7159cb3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Intaglio prints"}}, {"@id": "_:nfe818bc955b74a97baffba59b7159cb3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 323 (intaglio: a process using a plate whose low portions carry the ink. The most common intaglio processes are copper and steel engraving, etching, and photogravure.)"}, "madsrdf:citationSource": "Benson, R. The printed picture, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe818bc955b74a97baffba59b7159cb3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(intaglio prints; variants: intaglio print; prints, intaglio; note: Prints made using the process of intaglio printing.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, November 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe818bc955b74a97baffba59b7159cb3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Intaglio: in visual arts, one of the four major classes of printmaking techniques, distinguished from the other three methods (relief printing, stenciling, and lithography) by the fact that the ink forming the design is printed only from recessed areas of the plate; among intaglio techniques are engraving, etching, drypoint, aquatint, and mezzotint.)"}, "madsrdf:citationSource": "Britannica academic, viewed November 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe818bc955b74a97baffba59b7159cb3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Intaglio printing; BT Printing; scope note: Here are entered works on the printing process in which the design is cut into a metal plate which then holds the ink for the making of the print. Use only if a narrower term does not apply (e.g., \"Collagraph printing\").)"}, "madsrdf:citationSource": "Art full text thesaurus via EBSCOhost reference databases, November 26, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe818bc955b74a97baffba59b7159cb3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(intaglio printing; note: Printing processes in which the image prints from ink held in the recessed areas of the plate or block, which have been cut or etched away.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, November 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe818bc955b74a97baffba59b7159cb3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Intaglio prints; UF Mixed method intaglio prints; BT Prints; NT Aquatints; Carborundum prints; Crayon manner prints; Drypoints; Engravings; Etchings; Inkless intaglio prints; Mezzotints; RT A la poup\u011b prints ; Cellocuts; Chine coll \u030cprints; Collagraphs)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, November 6, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe818bc955b74a97baffba59b7159cb3b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfe818bc955b74a97baffba59b7159cb3b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mixed method intaglio prints"}}, {"@id": "_:nfe818bc955b74a97baffba59b7159cb3b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mixed method intaglio prints"}}], "@id": "/authorities/genreForms/gf2017027239"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027240", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLinocuts", "identifiers:lccn": "gf2017027240", "madsrdf:adminMetadata": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b1"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Linocuts"}, "madsrdf:elementList": {"@list": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027256"}, "madsrdf:hasSource": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b5"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b6"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b7"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b8"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b9"}], "madsrdf:hasVariant": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b10"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b13"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b16"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b19"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b22"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b25"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b28"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b31"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b34"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Prints made from a design cut into linoleum-faced blocks."}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Linocuts"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Linocuts; UF Linoleum cut prints; BT Relief prints; scope note: Prints made from linoleum blocks. Can be difficult to distinguish from cellocuts.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, August 27, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Linocut (linoleum cut, linoleum block print); Type of relief print in which linoleum is used as the printing surface. Using gouges and knives, the artist cuts the design into linoleum, a man-made sheet flooring composed primarily of oxidized linseed oil and ground cork.)"}, "madsrdf:citationSource": "Grove art online, Oxford art online, August 27, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(linocuts (prints); variants: linotype (print); linocut (print); linoleum prints; linocut prints; lino-cuts (prints); linoleum block prints; linoleum cut prints; linoleum cuts; prints, linocut; note: Prints made from a design cut in linoleum-faced blocks on which a knife or gouge has been used to recess the non-printing area and leave the image to be printed in relief.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, August 27, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Linoleum block printing; BT Block printing)"}, "madsrdf:citationSource": "LCSH, August 27, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Benson, R. The printed picture, 2008.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Linoleum cuts"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Linoleum cuts"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Linoleum block prints"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Linoleum block prints"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Linoleum prints"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Linoleum prints"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cuts, Linoleum"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cuts, Linoleum"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Block prints, Linoleum"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Block prints, Linoleum"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Linocut prints"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Linocut prints"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Linoleum cut prints"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Linoleum cut prints"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lino-cuts"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lino-cuts"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na7720b8cd1894d93bda41736fce47386b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cut prints, Linoleum"}}, {"@id": "_:na7720b8cd1894d93bda41736fce47386b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cut prints, Linoleum"}}], "@id": "/authorities/genreForms/gf2017027240"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027241", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLithographs", "identifiers:lccn": "gf2017027241", "madsrdf:adminMetadata": [{"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b1"}, {"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lithographs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027255"}, "madsrdf:hasSource": [{"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b5"}, {"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b6"}, {"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b7"}, {"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Prints made using a process in which a design is deposited onto a stone or plate with a greasy substance that will accept ink."}, {"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lithographs"}}, {"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lithographs; variant: lithograph; note: Prints made using the process of lithography, which is a planographic printing process in which a design is deposited on the stone or plate with a greasy substance which will accept ink.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, August 21, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lithography; UF Lithographs [Former heading]; BT Prints; NT Algraphy; Chromolithography; Extreme ultraviolet lithography; Holographic lithography; Ion beam lithography; Jigsaw puzzle art; Lithographic workshops; Microlithography; Nanolithography; Offset printing; Photolithography; X-ray lithography; Zincography)"}, "madsrdf:citationSource": "LCSH, August 21, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lithograph; a planographic method of printmaking based on the antipathy of grease and water. Invented in Munich in 1798 by Aloys Senefelder, lithography involves drawing or brushing the design with a greasy, lithographic ink on to a specially prepared and smoothed limestone which is kept moist. The stone (lithography means 'drawing on stone') is then inked with lithographic ink which only adheres to those areas of the stone previously fixed with lithographic ink, the rest of the ink is repelled by the water. The stone is then printed from in a flat-bed lithographic press.)"}, "madsrdf:citationSource": "The concise Oxford dictionary of art terms, Oxford art online, August 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n6ea5ccc2b06e42d492be50859fb897f7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lithographs; BT Planographic prints; NT Chromolithographs; Lithotints; Offset lithographs; Transfer lithographs; Zincographs; RT Chine coll\u00e9 prints; Photolithographs)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, June 10, 2016", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017027241"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027242", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMail art", "identifiers:lccn": "gf2017027242", "madsrdf:adminMetadata": [{"@id": "_:n3f8d0cecdcc14816b660104992178df3b1"}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mail art"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3f8d0cecdcc14816b660104992178df3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027218"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026014"}, "madsrdf:hasSource": [{"@id": "_:n3f8d0cecdcc14816b660104992178df3b5"}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b6"}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b7"}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b8"}], "madsrdf:hasVariant": [{"@id": "_:n3f8d0cecdcc14816b660104992178df3b9"}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Art created by using the postal service to transport a work in progress, so as to incorporate postal markings such as stamps and postmarks into the art."}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-06-12T11:53:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mail art"}}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mail art; UF Art, Mail; Correspondence art; Postal art; BT Art, Modern--20th century; Conceptual art; Postal service in art; scope: Here are entered works on art created collaboratively by using the postal service to transport a work in progress from one artist to another, and usually incorporating postal paraphernalia such as stamps, cancellations, etc. into the work.)"}, "madsrdf:citationSource": "LCSH, June 10, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mail art; UF Art, Mail; Correspondence art; Postal art; BT Modern art; NT Email art; RT Postage stamps; Postal service in art)"}, "madsrdf:citationSource": "Art full text thesaurus via EBSCOhost reference databases, November 26, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "RBMS Controlled vocabularies: Genre terms, June 10, 2016;Thesaurus for graphic materials, June 10, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mail art; UF correspondence art; envois (mail art); postal art; postal sculpture; art, mail; note: Works produced by artists, often in post card format, specifically when intended to be mailed to other artists or to be displayed in an exhibition; may be unique works or multiples.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, June 10, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3f8d0cecdcc14816b660104992178df3b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Postal art"}}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Postal art"}}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3f8d0cecdcc14816b660104992178df3b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Correspondence art"}}, {"@id": "_:n3f8d0cecdcc14816b660104992178df3b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Correspondence art"}}], "@id": "/authorities/genreForms/gf2017027242"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027243", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aManifestos", "identifiers:lccn": "gf2017027243", "madsrdf:adminMetadata": [{"@id": "_:n7f3b20a346564d9882858cb86b70457eb1"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Manifestos"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7f3b20a346564d9882858cb86b70457eb3"}]}, "madsrdf:exampleNote": "Note under [Creeds]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n7f3b20a346564d9882858cb86b70457eb5"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb6"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb7"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb8"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb9"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb10"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb11"}], "madsrdf:hasVariant": {"@id": "_:n7f3b20a346564d9882858cb86b70457eb12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Written statements that describe the goals, opinions, and policies of a person or group. For concise authorized statements of religious doctrine within religions or denominations, see [Creeds.]"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Manifestos"}}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(manifesto; a written statement that describes the policies, goals, and opinions of a person or group; plural: manifestos or manifestoes.)"}, "madsrdf:citationSource": "Merriam-Webster, viewed July 3, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "RBMS Controlled vocabularies: Genre terms, July 3, 2016;Thesaurus for graphic materials, July 3, 2016", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "table of contents (Part 1: Futurist theory and invention: manifestos and polemical writings; contents include The founding and manifesto of futurism; Technical manifesto of Futurist literature.)"}, "madsrdf:citationSource": "Marinetti : selected writings, 1972:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(about 455,000 results from \"manifestos\"; about 297,000 results from \"manifestoes\".)"}, "madsrdf:citationSource": "Google web browser search, July 3, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Architectural manifestos; Literary manifestos; Political manifestoes)"}, "madsrdf:citationSource": "LCSH, July 3, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(manifestoes; UF manifesto; manifestos; note: Formal written declarations, promulgated by a sovereign or by the executive authority of a state or nation, such as to proclaim its reasons and motives for declaring a war, or other international action; also public declarations or proclamations of political, social, artistic, or other principles.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 3, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Manifesto; a manifesto is a published verbal declaration of the intentions, motives, or views of the issuer, be it an individual, group, political party or government; a manifesto usually accepts a previously published opinion or public consensus and/or promotes a new idea with prescriptive notions for carrying out changes the author believes should be made; it often is political or artistic in nature, but may present an individual's life stance. Manifestos relating to religious belief are generally referred to as creeds.)"}, "madsrdf:citationSource": "Wikipedia, July 3, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7f3b20a346564d9882858cb86b70457eb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Manifestoes"}}, {"@id": "_:n7f3b20a346564d9882858cb86b70457eb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Manifestoes"}}], "@id": "/authorities/genreForms/gf2017027243"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027244", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMixed media works", "identifiers:lccn": "gf2017027244", "madsrdf:adminMetadata": [{"@id": "_:n9b552b397a1843a195160003a21a72c9b1"}, {"@id": "_:n9b552b397a1843a195160003a21a72c9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mixed media works"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9b552b397a1843a195160003a21a72c9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027218"}, "madsrdf:hasSource": [{"@id": "_:n9b552b397a1843a195160003a21a72c9b5"}, {"@id": "_:n9b552b397a1843a195160003a21a72c9b6"}, {"@id": "_:n9b552b397a1843a195160003a21a72c9b7"}], "madsrdf:hasVariant": [{"@id": "_:n9b552b397a1843a195160003a21a72c9b8"}, {"@id": "_:n9b552b397a1843a195160003a21a72c9b11"}, {"@id": "_:n9b552b397a1843a195160003a21a72c9b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works combining techniques and materials from two or more graphic or fine art processes, no one of which clearly predominates."}, {"@id": "_:n9b552b397a1843a195160003a21a72c9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9b552b397a1843a195160003a21a72c9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9b552b397a1843a195160003a21a72c9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mixed media works"}}, {"@id": "_:n9b552b397a1843a195160003a21a72c9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mixed media (Art); UF Mixed media crafts; BT Art; Handicraft; NT Mixed media painting; scope note: Here are entered works on single art works made from any combination of a variety of materials. Works on contemporary art works that employ several distinct art forms, such as sculpture and music, are entered under Multimedia (Art).)"}, "madsrdf:citationSource": "LCSH, December 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b552b397a1843a195160003a21a72c9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mixed media; UF Multiple processes; RT Collages; Drawings; Montages; Paintings; Photographs; Prints; scope note: Works combining techniques and materials from two or more graphic or fine art processes no one of which clearly predominates. Examples include prints with large amounts of drawing, and photographs with heavy over-painting.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, December 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b552b397a1843a195160003a21a72c9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mixed media works; variants: media, mixed; mixed mediums; mixed method (materials); note: Any combination of a variety of materials plus the associated techniques, used in the making of a single work of art ... For contemporary works that employ several distinct art forms, such as sculpture and music, use \"multimedia works\" ...)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, December 14, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n9b552b397a1843a19516