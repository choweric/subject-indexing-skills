{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026687", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTest pressings (Sound recordings)", "identifiers:lccn": "gf2011026687", "madsrdf:adminMetadata": [{"@id": "_:nffb1915e8205441fb87730c94cd97312b1"}, {"@id": "_:nffb1915e8205441fb87730c94cd97312b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Test pressings (Sound recordings)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nffb1915e8205441fb87730c94cd97312b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, "madsrdf:hasSource": [{"@id": "_:nffb1915e8205441fb87730c94cd97312b5"}, {"@id": "_:nffb1915e8205441fb87730c94cd97312b6"}, {"@id": "_:nffb1915e8205441fb87730c94cd97312b7"}], "madsrdf:hasVariant": {"@id": "_:nffb1915e8205441fb87730c94cd97312b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Pressed or molded disc sound recordings, usually with plain, typed or handwritten labels, that are frequently either rough, first off the press recordings made to assist in judging whether a recording or take is suitable for issue, or recordings pressed by special order.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025556"}}, {"@id": "_:nffb1915e8205441fb87730c94cd97312b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nffb1915e8205441fb87730c94cd97312b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:01:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nffb1915e8205441fb87730c94cd97312b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Test pressings (Sound recordings)"}}, {"@id": "_:nffb1915e8205441fb87730c94cd97312b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(test pressings; electrical recordings of unissued material or of material that was later released; generally made for assessment purposes but also as favors for artists and recording company staff members)"}, "madsrdf:citationSource": "Grove music online, Mar. 17, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb1915e8205441fb87730c94cd97312b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg: Test pressings (Sound recordings))"}, "madsrdf:citationSource": "LCSH, Mar. 17, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb1915e8205441fb87730c94cd97312b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Record collecting (test pressings; five to ten copies of a record pressed in order to check the mix, levels, or die cut on a record; usually meant for the performer, producer, pressing plant, or record label to keep as reference, they are often placed in special packaging (such as a photocopy of the real record sleeve) and given out to friends or devoted fans)"}, "madsrdf:citationSource": "Wikipedia, Mar. 17, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffb1915e8205441fb87730c94cd97312b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffb1915e8205441fb87730c94cd97312b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pressings, Test (Sound recordings)"}}, {"@id": "_:nffb1915e8205441fb87730c94cd97312b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pressings, Test (Sound recordings)"}}], "@id": "/authorities/genreForms/gf2011026687"}
