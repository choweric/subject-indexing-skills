{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026694", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aThrillers (Television programs)", "identifiers:lccn": "gf2011026694", "madsrdf:adminMetadata": [{"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb1"}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Thrillers (Television programs)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026658"}, "madsrdf:hasSource": {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb5"}, "madsrdf:hasVariant": [{"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb6"}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb9"}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb12"}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb15"}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb18"}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb21"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs in which the audience is kept on tenterhooks by plots that feature a build-up of suspense, tension, uncertainty, menace, and anxiety.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025532"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-07T21:30:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thrillers (Television programs)"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Thriller: fictional work frequently related to the crime genre in that the subject is usually some aspect of criminal activity, but with the emphasis away from a detective, gangster, caper, or even the crime itself. Instead, the narrative concentrates on suspense as an individual or group is placed in a dangerous situation whose outcome hinges on sudden reversals of fate. Frequent themes are political conspiracy, terrorism, innocents on the run, romantic triangles leading to murder, and individuals suffering from psychosis. UF: Psychological thriller. RT: Caper, Crime, Film noir, Gangster, Mystery, and Police)"}, "madsrdf:citationSource": "Moving image genre-form guide online, February 11, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Thriller television programs"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thriller television programs"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suspense television programs"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suspense television programs"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suspense thrillers (Television programs)"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suspense thrillers (Television programs)"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psychological thrillers (Television programs)"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psychological thrillers (Television programs)"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television thrillers"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television thrillers"}}, {"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc9dfbeeedee9478bbf183d4777c8678eb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psycho thrillers (Television programs)"}}, {"@id": "_: