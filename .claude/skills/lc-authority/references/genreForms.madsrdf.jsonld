eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "chart, meteorological (a chart giving information about the weather)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5bdf9c05e13d401abcb5fa54eac3725eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Meteorology--Charts, diagrams, etc.)"}, "madsrdf:citationSource": "LCSH, Dec. 8, 2009:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026394"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026395", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMilitary films", "identifiers:lccn": "gf2011026395", "madsrdf:adminMetadata": [{"@id": "_:nf9ba91538b964535b03dc8329666a26ab1"}, {"@id": "_:nf9ba91538b964535b03dc8329666a26ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Military films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf9ba91538b964535b03dc8329666a26ab3"}]}, "madsrdf:exampleNote": "Note under [War films]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026729"}, "madsrdf:hasSource": {"@id": "_:nf9ba91538b964535b03dc8329666a26ab5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature the military lifestyle and loyalty to the armed forces and its codes and are generally set during peacetime. For films that feature military conflicts see [War films.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025341"}}, {"@id": "_:nf9ba91538b964535b03dc8329666a26ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nf9ba91538b964535b03dc8329666a26ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T09:55:15"}, "ri:recordContentSource": {"@id": "ht