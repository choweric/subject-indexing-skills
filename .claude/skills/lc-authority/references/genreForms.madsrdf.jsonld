i:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n933ee23a32f44101b8ea77d9409e6fc5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sales catalogs"}}, {"@id": "_:n933ee23a32f44101b8ea77d9409e6fc5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sales catalogs; Use for catalogs that list and describe items for sale; BT Advertisements; Catalogs; NT Auction catalogs; Booksellers' advertisements; Booksellers' catalogs; Manufacturers' catalogs; Publishers' catalogs; Trade catalogs)"}, "madsrdf:citationSource": "RBMS Controlled vocabularies: Genre terms, May 10, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n933ee23a32f44101b8ea77d9409e6fc5b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "LCSH, May 10, 2015", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n933ee23a32f44101b8ea77d9409e6fc5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sales catalogs; Catalogs that enumerate items that are for sale; UF catalogs, sales; sales catalogues; catalogues, sales; BT catalogs (documents); Catalogs that enumerate items that are for sale.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, May 10, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n933ee23a32f44101b8ea77d9409e6fc5b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n933ee23a32f44101b8ea77d9409e6fc5b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sale catalogs"}}, {"@id": "_:n933ee23a32f44101b8ea77d9409e6fc5b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sale catalogs"}}], "@id": "/authorities/genreForms/gf2017027257"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027258", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aScreen prints", "identifiers:lccn": "gf2017027258", "madsrdf:adminMetadata": [{"@id": "_:n44e510884ea540fba7765921a540b95fb1"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Screen prints"}, "madsrdf:elementList": {"@list": [{"@id": "_:n44e510884ea540fba7765921a540b95fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027255"}, "madsrdf:hasSource": [{"@id": "_:n44e510884ea540fba7765921a540b95fb5"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb6"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb7"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb8"}], "madsrdf:hasVariant": [{"@id": "_:n44e510884ea540fba7765921a540b95fb9"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb12"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb15"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb18"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb21"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Prints made by forcing ink through a fine screen stencil onto paper or another surface."}, {"@id": "_:n44e510884ea540fba7765921a540b95fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:44:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Screen prints"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Serigraphy; UF Screen printing; Serigraphs (Prints) [Former heading]; Silk screen printing; Silk screen process; Silkscreen printing; Silkscreen process; Silkscreens; Stencil printing; BT Color printing; Stencil work; scope note: Here are entered works on the silk screen process as performed by an artist in producing an original print from his own design.)"}, "madsrdf:citationSource": "LCSH, August 21, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Silk-screen printing, or serigraphy, is a technique whereby a cut stencil is attached to a silk screen of very fine mesh stretched on a wooden frame. By the use of an oblong squeegee the ink is forced through the unmasked areas of the screen onto the paper below. The stencil can also be dispensed with, by the substitution of varnish or opaque glue painted onto the screen.)"}, "madsrdf:citationSource": "The Oxford companion to Western art, Oxford art online, August 21, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Screen prints; UF Serigraphs; Silk screen prints; Silkscreen prints; BT Stencils (Images); scope note: Prints made by forcing ink through a fine screen stencil onto paper or another surface. Art applications date from the 1930s; commercial ones from the 1920s.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, August 21, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(screen prints; variants: screen print, prints, screen; screenprints; serigraphs; silk screen prints; silk-screen prints; silkscreen prints; silkscreens (visual works); silk screens (visual works); note: Prints made by exclusively using the process of screen printing, whether originated by hand or photographically.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, August 21, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n44e510884ea540fba7765921a540b95fb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44e510884ea540fba7765921a540b95fb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Silkscreen prints"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Silkscreen prints"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44e510884ea540fba7765921a540b95fb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Screenprints"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Screenprints"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44e510884ea540fba7765921a540b95fb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Silkscreens"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Silkscreens"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44e510884ea540fba7765921a540b95fb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Silk screens"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Silk screens"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44e510884ea540fba7765921a540b95fb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Silk-screen prints"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Silk-screen prints"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44e510884ea540fba7765921a540b95fb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Serigraphs"}}, {"@id": "_:n44e510884ea540fba7765921a540b95fb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Serigraphs"}}], "@id": "/authorities/genreForms/gf2017027258"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017027259", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSculptures", "identifiers:lccn": "gf2017027259", "madsrdf:adminMetadata": [{"@id": "_:ne4139d62a2374457b585cdaa7777b747b1"}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sculptures"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne4139d62a2374457b585cdaa7777b747b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027218"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027223"}, "madsrdf:hasSource": [{"@id": "_:ne4139d62a2374457b585cdaa7777b747b5"}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b6"}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b7"}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b8"}], "madsrdf:hasVariant": [{"@id": "_:ne4139d62a2374457b585cdaa7777b747b9"}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Three-dimensional works of art in which images and forms are produced in relief, in intaglio, or in the round."}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-23T11:19:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-11-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sculptures"}}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sculpture (visual works); UF sculptures (visual works); NOTE Three-dimensional works of art in which images and forms are produced in relief, in intaglio, or in the round. The term refers particularly to art works created by carving or engraving a hard material, by molding or casting a malleable material (which usually then hardens), or by assembling parts to create a three-dimensional object. It is typically used to refer to large or medium-sized objects made of stone, wood, bronze, or another metal. Small objects are typically referred to as \"carvings\" or another appropriate term. \"Sculpture\" refers to works that represent tangible beings, objects, or groups of objects, or are abstract works that have defined edges and boundaries and can be measured. As three-dimensional works become more diffused in space or time, or less tangible, use appropriate specific terms, such as \"mail art\" or \"environmental art.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, October 24, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sculpture; UF Stonework, Decorative; BT Art; RT Bas-relief; Statues; many NTs with style, theme, or material modifiers, e.g., Alabaster sculpture; Animal sculpture; Buddhist sculpture; Butter sculpture)"}, "madsrdf:citationSource": "LCSH, October 24, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sculpture; UF Carvings; Statues; Scope Note: Primarily for representations of figures in the round, sculptured or modeled out of some solid substance, such as wood, stone, marble, or wax. Includes statues and indoor and outdoor sculpture of all kinds. Search under MODELING (SCULPTURE), STONE CARVING and WOOD CARVING for activities. Search also under the subdivision --STATUES used with names of persons (Appendix B).; NT Abstract sculpture; Architectural sculpture; Bas-reliefs; Death masks; etc.; RT Buddhas; Carving; Maquettes; Modeling (Sculpture); Monuments & memorials; Sculpture gardens; Stone carving; Cataloger's Note: When a sculpture and a structure of which it is an integral part are depicted, double index under the appropriate heading; e.g. MONUMENTS & MEMORIALS.)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, October 24, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sculpture: a piece of art that is made by carving or molding clay, stone, metal, etc.; the process or art of carving or molding clay, stone, metal, etc., into a sculpture)"}, "madsrdf:citationSource": "Merriam-Webster online dictionary, October 24, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne4139d62a2374457b585cdaa7777b747b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Statues"}}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Statues"}}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne4139d62a2374457b585cdaa7777b747b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Carvings"}}, {"@id": "_:ne4139d62a2374457b585cdaa7777b747b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Carvings"}}], "@id": "/authorities/genreForms/gf2017027259"}
