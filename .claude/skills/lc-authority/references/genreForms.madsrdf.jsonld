{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026591", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSophisticated comedy films", "identifiers:lccn": "gf2011026591", "madsrdf:adminMetadata": [{"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb1"}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sophisticated comedy films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026147"}, "madsrdf:hasSource": [{"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb5"}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb6"}], "madsrdf:hasVariant": [{"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb7"}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature the lives of the rich and urbane, particularly their marital and romantic relationships.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025361"}}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:22:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sophisticated comedy films"}}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 309 (Sophisticated comedy (High comedy); deals with the quirks, manners, and sometimes eccentric behavior of the very rich, the socialites, and generally speaking, with talented, debonair people; sometimes referred to as social comedies; many deal with situations involving marriage and romance. Entry under Romantic comedy: the following types of comedy also qualify as romantic comedy: Marriage comedy, Screwball comedy, Sophisticated comedy)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sophisticated comedy: fictional work marked by witty and sophisticated dialogue, centering on marital and romantic relationships, and finding humor in the lives and activities of the rich and urbane; implies romance)"}, "madsrdf:citationSource": "Moving image genre-form guide online, May 1, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "High comedy films"}}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "High comedy films"}}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Social comedy films"}}, {"@id": "_:nfbd28b1a82eb40c3bd3a1f6177a831dcb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Social comedy films"}}], "@id": "/authorities/genreForms/gf2011026591"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026592", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSophisticated comedy television programs", "identifiers:lccn": "gf2011026592", "madsrdf:adminMetadata": [{"@id": "_:n553c299fd54843dbbc2b2f5c97cad9ebb1"}, {"@id": "_:n553c299fd54843dbbc2b2f5c97cad9ebb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sophisticated comedy television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n553c299fd54843dbbc2b2f5c97cad9ebb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026654"}, "madsrdf:hasSource": {"@id": "_:n553c299fd54843dbbc2b2f5c97cad9ebb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television comedies that feature the lives of the rich and urbane, particularly their marital and romantic relationships.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025362"}}, {"@id": "_:n553c299fd54843dbbc2b2f5c97cad9ebb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n553c299fd54843dbbc2b2f5c97cad9ebb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:23:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n553c299fd54843dbbc2b2f5c97cad9ebb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sophisticated comedy television programs"}}, {"@id": "_:n553c299fd54843dbbc2b2f5c97cad9ebb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sophisticated comedy: fictional work marked by witty and sophisticated dialogue, centering on marital and romantic relationships, and finding humor in the lives and activities of the rich and urbane; implies romance)"}, "madsrdf:citationSource": "Moving image genre-form guide online, May 1, 2007", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026592"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026593", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSound effects recordings", "identifiers:lccn": "gf2011026593", "madsrdf:adminMetadata": [{"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb1"}, {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sound effects recordings"}, "madsrdf:elementList": {"@list": [{"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026594"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027015"}, "madsrdf:hasSource": [{"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb5"}, {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb6"}, {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb7"}], "madsrdf:hasVariant": {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Prepared recordings of collections of various sounds for use in audio and video production.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025063"}}, {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:00:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sound effects recordings"}}, {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sound effects: Contrived audio, usually prerecorded, incorporated with a video soundtrack to resemble a real occurance)"}, "madsrdf:citationSource": "Videomaker.com WWW page, viewed July 1, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Extreme sound f/x, 1999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Sound effects (sound effects or audio effects are artificially created or enhanced sounds, or sound processes used to emphasize artistic or other content of films, television shows, live performance, animation, video games, music, or othe media ... The term often refers to a process applied to a recording, without necessarily referring to the recording itself. In professional motion picture and television production, dialogue and music recordings are never refered to as sound effects, even though the processes applied to them, such as reverberation or flanging effects, often are called \"sound effects\".)"}, "madsrdf:citationSource": "Wikipedia, Dec. 29, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Audio effects recordings"}}, {"@id": "_:n64498ffa07484fcf99965c0bc068f0fdb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Audio effects recordings"}}], "@id": "/authorities/genreForms/gf2011026593"}
