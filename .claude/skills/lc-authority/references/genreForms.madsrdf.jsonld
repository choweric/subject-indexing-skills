ordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n076772ff9a254c16b372bced73dad213b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Music criticism and reviews"}}, {"@id": "_:n076772ff9a254c16b372bced73dad213b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n076772ff9a254c16b372bced73dad213b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Music reviews"}}, {"@id": "_:n076772ff9a254c16b372bced73dad213b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Music reviews"}}, {"@id": "_:n076772ff9a254c16b372bced73dad213b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Acton, C. Acton's music : reviews of Dublin's musical life, 1955-1985, 1996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n076772ff9a254c16b372bced73dad213b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Rexroth, L. John P. Paynter's new music reviews for the Instrumentalist, 1955-1984, 1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:n076772ff9a254c16b372bced73dad213b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Dougherty, C. Review : music critics reviews set by the composer, c2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:n076772ff9a254c16b372bced73dad213b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(consists chiefly of concert reviews, but also includes book reviews and critical essays about music and musical works, music history, musical culture, study of music, criticism of music, and performance)"}, "madsrdf:citationSource": "Work cat.: Shaw, B. Shaw's music : the complete musical criticism in three volumes, 1989", "madsrdf:citationStatus": "found"}, {"@id": "_:n076772ff9a254c16b372bced73dad213b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Criticism / Fred Everett Maus and 9 others (Music criticism may be defined broadly or narrowly. Understood narrowly, it is a genre of professional writing, typically created for prompt publication, evaluating aspects of music and musical life. Musical commentary in newspapers and other periodical publications is criticism in this sense. More broadly, it is a kind of thought that can occur in professional critical writing but also appears in many other settings. In this broader sense, music criticism is a type of thought that evaluates music and formulates descriptions that are relevant to evaluation; such thought figures in music teaching, conversation about music, private reflection, and various genres of writing including music history, music theory and biography)"}, "madsrdf:citationSource": "Grove music online, Aug. 3, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n076772ff9a254c16b372bced73dad213b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Choral music reviews index, 1986-", "madsrdf:citationStatus": "found"}, {"@id": "_:n076772ff9a254c16b372bced73dad213b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n076772ff9a254c16b372bced73dad213b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Music reviews"}}, {"@id": "_:n076772ff9a254c16b372bced73dad213b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Music reviews"}}, {"@id": "_:n076772ff9a254c16b372bced73dad213b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n076772ff9a254c16b372bced73dad213b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Criticism, Music"}}, {"@id": "_:n076772ff9a254c16b372bced73dad213b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Criticism, Music"}}, {"@id": "_:n076772ff9a254c16b372bced73dad213b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n076772ff9a254c16b372bced73dad213b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reviews, Music"}}, {"@id": "_:n076772ff9a254c16b372bced73dad213b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reviews, Music"}}], "@id": "/authorities/genreForms/gf2014026130"}
