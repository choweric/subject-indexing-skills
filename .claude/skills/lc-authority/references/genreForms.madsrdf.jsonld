Date": {"@type": "xsd:dateTime", "@value": "2011-05-18T10:20:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n61cb810bbb444eed88c668a0b15a32ccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Country music radio programs"}}, {"@id": "_:n61cb810bbb444eed88c668a0b15a32ccb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Radio genre-form guide online, Oct. 1, 2008", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n61cb810bbb444eed88c668a0b15a32ccb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. B-511 (Country music, ranging from older traditional country and western to today's \"Hit Country\" sounds. The amount of news and talk on country stations varies widely from station to station)"}, "madsrdf:citationSource": "Broadcasting & cable yearbook, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n61cb810bbb444eed88c668a0b15a32ccb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Big \"D\" jamboree (Building on the success of country music radio programs like WSM's \"Grand Ole Opry\" (Nashville) and WLS's \"National Barn Dance\" (Chicago), regional barn dances sprouted up across the country throughout the 1940s. By the end of that decade, more than 600 American radio stations tried this live country music format)"}, "madsrdf:citationSource": "Handbook of Texas online, Feb. 1, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n61cb810bbb444eed88c668a0b15a32ccb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n61cb810bbb444eed88c668a0b15a32ccb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Country and western music radio programs"}}, {"@id": "_:n61cb810bbb444eed88c668a0b15a32ccb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Country a