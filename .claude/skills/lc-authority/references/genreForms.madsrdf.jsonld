:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indulgences (Canon law)"}}, {"@id": "_:ndbc3b209e2094b84bcfe676786892636b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Indulgences (Canon law) (This heading is used as a genre/form heading for texts granting remission by the Catholic Church of temporal punishment due for sins that have been forgiven.)"}, "madsrdf:citationSource": "Genre/form terms for law materials [report prepared by the Technical Services Special Interest Section of AALL], 2010:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026328"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026329", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIndustrial films", "identifiers:lccn": "gf2011026329", "madsrdf:adminMetadata": [{"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b1"}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Industrial films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026333"}, "madsrdf:hasSource": [{"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b5"}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b6"}], "madsrdf:hasVariant": [{"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b7"}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025015"}}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:20:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Industrial films"}}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Industrial works. Use for nonfiction films and video designed to be used in an industrial setting; do not include industrial training films. BT Documentaries and factual works)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Industrial. Nonfiction work concerned with illustrating and explaining industrial and manufacturing processes or issues. Generally distributed nontheatrically and designed for in-house educational or promotional purposes, many such works are sponsored by a concerned business or organization. Note: Not necessary to also use Documentary, since that is implied by the term Industrial.)"}, "madsrdf:citationSource": "Taves, B. The moving image genre-form guide, via WWW, Mar. 27, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Business films"}}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Business films"}}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Industry-sponsored films"}}, {"@id": "_:n8d0ddbb72bd04ad7a509507a90fb8cb3b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Industry-sponsored films"}}], "@id": "/authorities/genreForms/gf2011026329"}
