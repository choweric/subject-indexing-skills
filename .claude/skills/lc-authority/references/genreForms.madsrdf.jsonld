bulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-23T11:18:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Audiobooks"}}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "audiobook (an audio recording of a reading of a book (typically a novel), produced commercially)"}, "madsrdf:citationSource": "OED online, April 27, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(audiobook; a recording that is primarily of the spoken word as opposed to music; not intended to be descriptive of the word \"book\" but rather a recorded spoken program in its own right and not always an audio version of a book)"}, "madsrdf:citationSource": "Wikipedia, Mar. 10, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(books on tape)"}, "madsrdf:citationSource": "NetLibrary web site, Mar. 10, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Montana Talking Book Library (cassette books; recorded books)"}, "madsrdf:citationSource": "Montana State Library website, Mar. 10, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg: Audiobooks)"}, "madsrdf:citationSource": "LCSH, Mar. 10, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(audio book; also audiobook; a recording of an oral reading of a book, often in abridged form)"}, "madsrdf:citationSource": "Dictionary.com, Mar. 10, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09fdce24faf044b0979328e4ca78533db12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books on tape"}}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books on tape"}}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09fdce24faf044b0979328e4ca78533db15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Audio"}}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Audio"}}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n09fdce24faf044b0979328e4ca78533db18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Books, Recorded"}}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Books, Recorded"}}, {"@id": "_:n09fdce24faf044b0979328e4ca78533db20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrd