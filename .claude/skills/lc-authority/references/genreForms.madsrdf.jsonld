64914836bbde78fd16dfbf1bb66"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reporting, Graphic (Comics)"}}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb66", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reporting, Graphic (Comics)"}}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb68", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb69"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reportage, Graphic (Comics)"}}, {"@id": "_:neefa79ac64914836bbde78fd16dfbf1bb69", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reportage, Graphic (Comics)"}}], "@id": "/authorities/genreForms/gf2023026049"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026050", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTwo-Spirit comics", "identifiers:lccn": "gf2023026050", "madsrdf:adminMetadata": [{"@id": "_:n6d5a0c13e1f74695bb499460d753f766b1"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Two-Spirit comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6d5a0c13e1f74695bb499460d753f766b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n6d5a0c13e1f74695bb499460d753f766b5"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b6"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b7"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b8"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b9"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b10"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b11"}], "madsrdf:hasVariant": [{"@id": "_:n6d5a0c13e1f74695bb499460d753f766b12"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b15"}], "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics featuring Two-Spirit characters or addressing Two-Spirit themes."}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-11T12:18:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-05-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Two-Spirit comics"}}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Shout Out is an anthology series featuring LGBTQ2S stories, including a Two-Spirit story, called 'The Fisher and The Jeweler'\")"}, "madsrdf:citationSource": "Indigenous comic books, via WeRNative website, viewed May 19, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Dez and Miikwan's stories continue in this sequel to Surviving the City ... On top of everything else, Dez is navigating a new relationship and coming into her identity as a Two-Spirit person ... Elder Linda is doing her best to be supportive, but she doesn't know how to respond when the gendered protocols she's grown up with that are being thrown into question. Will Dez be comfortable expressing her full identity? And will her community relearn the teachings and overcome prejudice to celebrate her for who she is?\") (OCoLC)1131819918"}, "madsrdf:citationSource": "Work cat: Spillett-Sumner, T. Surviving the city. Vol. 2, From the roots up, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 215 (Daniel Heath Justice's comic \"The boys who became the hummingbirds\" from the second volume of \"Moonshot: the Indigenous comics collection\" \"represents one of the first explorations of Indigenous Two-Spiritedness in comics form\")"}, "madsrdf:citationSource": "The LGBTQ+ comics studies reader, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comic with a Two-Spirit protagonist) (OCoLC)840404954"}, "madsrdf:citationSource": "Alba, T. Dos espiritus, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"These pamphlets are intended as a resource for patrons of public libraries to help increase the visibility of Two-Spirit and Indigiqueer publications for children and young adults\"; \"Two-Spirit is an English term that includes a variety of Queer identities within Indigenous cultures\"; book list for teens includes Tasha Spillett-Sumner's \"Surviving the city\" series and volume 2 of the \"Moonshot\" anthology)"}, "madsrdf:citationSource": "Two-Spirit and Indigiqueer Children's and YA Book Lists, via Indigenous Library and Information Studies website, viewed May 19, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(includes a profile of We'Wha, a lhamana (Two-Spirit) Zuni person) (OCoLC)1272895194"}, "madsrdf:citationSource": "Criswell, S. Queer as all get out : 10 people who've inspired me, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 12 (\"Two-Spirit Peoples are individuals whose spirit embodies masculine and feminine traits. Traditionally, they held special roles and privileges in their communities to maintain peace and balance. Many Indigenous people who use Two-Spirit may also identify within the LGBTTQQIAAP+ spectrum. It is important to distinguish that being Two-Spirit is not an identity by itself since it has different meanings for each nation (other stylizations: two spirit, two spirited, 2Spirit, 2S)\"; \"Note: Two-Spirited/two spirited is an outdated term\") p. 13 (\"Although some Indigenous individuals/groups may refer to themselves as 'Two-Spirited,' this is now understood as a misleading grammatical error. In the same way gay or trans individuals do not refer to themselves as 'gayed' or 'transgendered'\")"}, "madsrdf:citationSource": "Beauchamp, Z. Two-Spirit terminology guide, via Two-Spirit Dry Lab, Community-Based Research Centre, viewed May 19, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6d5a0c13e1f74695bb499460d753f766b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "2Spirit comics"}}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "2Spirit comics"}}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6d5a0c13e1f74695bb499460d753f766b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "2S comics"}}, {"@id": "_:n6d5a0c13e1f74695bb499460d753f766b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "2S comics"}}], "@id": "/authorities/genreForms/gf2023026050"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026053", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpecial issues (Serial publications)", "identifiers:lccn": "gf2023026053", "madsrdf:adminMetadata": [{"@id": "_:nc224975668544f60ad32aa0ff5256105b1"}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Special issues (Serial publications)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc224975668544f60ad32aa0ff5256105b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026174"}, "madsrdf:hasSource": [{"@id": "_:nc224975668544f60ad32aa0ff5256105b5"}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b6"}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b7"}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b8"}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b9"}], "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-05-24T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/clu"}, "ri:recordStatus": "new"}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Special issues (Serial publications)"}}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover, etc. (num\u00e9ro special, Automme 2011; a special number of Nijmah, Majallah adabiyah, a literary magazine published in Tangier) (OCoLC)928958829"}, "madsrdf:citationSource": "La parole insoumise, Mohamed Choukri 1935-2003, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Special issues feature specifically aimed and targeted topics of interest contributed by authors responding to a particular Call for Papers or by invitation, edited by the guest editor(s))."}, "madsrdf:citationSource": "Gale literature online, May 17, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover, etc. (a special issue of the al Shinaghah serial, published in United Arab Emirates; the special issue focused on the life of Khalaf Ahmad Al Habtoor ) (OCoLC)1377504771"}, "madsrdf:citationSource": "Work cat: Khalaf A\u1e25mad al-\u1e24abt\u016br, 2012 :", "madsrdf:citationStatus": "found"}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "title page, etc. (Bulletin of Hispanic studies, Special issue) (OCoLC)18685596"}, "madsrdf:citationSource": "The Age of the Catholic monarchs, 1474-1516, 1989:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc224975668544f60ad32aa0ff5256105b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "special issue (An issue of a periodical devoted wholly or substantially to a specific subject or occasion, often the proceedings of a conference in the case of trade journals. A special issue may have its own editor and title and be promoted separately by the publisher)"}, "madsrdf:citationSource": "Online dictionary for library and information science, May 1, 2023:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2023026053"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026054", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPastorellas (Music)", "identifiers:lccn": "gf2023026054", "madsrdf:adminMetadata": [{"@id": "_:n3e6022fad6634dc58b03802536dd9626b1"}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pastorellas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3e6022fad6634dc58b03802536dd9626b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026716"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasSource": [{"@id": "_:n3e6022fad6634dc58b03802536dd9626b5"}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b6"}], "madsrdf:hasVariant": [{"@id": "_:n3e6022fad6634dc58b03802536dd9626b7"}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b10"}], "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-06-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-11T12:18:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastorellas (Music)"}}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "cover (Czech pastorella)"}, "madsrdf:citationSource": "Work cat: Linek, J.I. Pojd'me, brat\u0159e, k Betl\u00e9mu, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pastorella [pastorela, pastoritia]; A church composition for Christmas, found in central Europe from the second half of the 17th century to the 20th century, in Roman Catholic areas. In one or more movements, it is usually for choir or soloists and small orchestra (less often purely instrumental), and usually represents events from a sequence based partly on Luke ii: the announcement of midnight, appearance of angels, awakening and dialogue of shepherds and their offering of gifts (or singing and playing, sometimes of a lullaby) to the Christ child)"}, "madsrdf:citationSource": "Grove music online, June 6, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3e6022fad6634dc58b03802536dd9626b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pastoritias (Music)"}}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastoritias (Music)"}}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3e6022fad6634dc58b03802536dd9626b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pastorelas (Music)"}}, {"@id": "_:n3e6022fad6634dc58b03802536dd9626b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastorelas (Music)"}}], "@id": "/authorities/genreForms/gf2023026054"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026057", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPortal fantasy fiction", "identifiers:lccn": "gf2023026057", "madsrdf:adminMetadata": [{"@id": "_:n08590b489b1d45b2b900fad023ef5834b1"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Portal fantasy fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n08590b489b1d45b2b900fad023ef5834b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026333"}, "madsrdf:hasSource": [{"@id": "_:n08590b489b1d45b2b900fad023ef5834b5"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b6"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b7"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b8"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b9"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b10"}], "madsrdf:hasVariant": [{"@id": "_:n08590b489b1d45b2b900fad023ef5834b11"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b14"}], "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-06-22T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-01-17T15:46:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Portal fantasy fiction"}}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Isekai is a subgenre of fantasy in which a character is suddenly transported from their world into a new or unfamiliar one\"; also called \"'trapped in another world manga.' That phrase hits on the core difference between isekai manga and other adventure stories. In isekai stories, the main protagonist must be either physically/mentally spirited away to another world, or reborn into this new world in a new form more powerful than their previous one.\")"}, "madsrdf:citationSource": "Pagan, A. A beginner's guide to isekai, July 15, 2019, via the New York Public Library blog, viewed July 28, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"In portal fantasy, the characters are typically normal people who have traveled through a doorway of some sort into a fantastic world. The doorway need not be an actual door: the portal could be a book, talisman, or magic mirror. These journeys aren't always by choice, and in some portal fantasies, the quest to find a way to return to the 'real' world may become the story's primary narrative)"}, "madsrdf:citationSource": "Goodreads, site viewed June 22, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Sweeping in scope and timeless in tone, No Place like Home is a middle-grade portal fantasy unlike any other. Lan, a teenager who recently came to Canada from Vietnam, spends every day searching for a sense of belonging.\") (OCoLC)1330404528"}, "madsrdf:citationSource": "Work cat.: Nguyen, L. S. No place like home, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Abstract (\"Portal-quest fantasies are fantasy novels that involve a character from one world traveling through a portal to another, and subsequently going on a quest which often follows the pattern of the hero's journey as described by Joseph Campbell in The Hero with a Thousand Faces. Such narratives are common in young-adult (YA) fiction as metaphors for the process of growing up and learning the responsibilities of adulthood\")"}, "madsrdf:citationSource": "Keaton, A. C. The dragon in the mirror, a novel, with stepping through the mirror, a critical reflection on writing and revising a feminist portal-quest fantasy, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 79 (\"In the portal fantasy a character moves from the mundane world into the fantastic otherworld and proceeds to describe what is witnessed\" ; \"The wider world is always unfamiliar to the protagonists, with the result that quest fantasies function in the same way as portal fantasies. Jones uses the portal-quest fantasy genre\") (OCoLC)57669501"}, "madsrdf:citationSource": "Mendlesohn, F. Diana Wynne Jones : children's literature and the fantastic tradition, 2005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: From an Aurora Award-winning author comes the first book in a new portal fantasy series in which one woman's powers open the way to a labyrinth of new dimensions) (OCoLC)1015811421"}, "madsrdf:citationSource": "Willett, E. Worldshaper, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n08590b489b1d45b2b900fad023ef5834b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Isekai fiction"}}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Isekai fiction"}}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n08590b489b1d45b2b900fad023ef5834b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Portal-quest fantasy fiction"}}, {"@id": "_:n08590b489b1d45b2b900fad023ef5834b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Portal-quest fantasy fiction"}}], "@id": "/authorities/genreForms/gf2023026057"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026059", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aYuri manga", "identifiers:lccn": "gf2023026059", "madsrdf:adminMetadata": [{"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b1"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Yuri manga"}, "madsrdf:elementList": {"@list": [{"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026036"}, "madsrdf:hasSource": [{"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b5"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b6"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b7"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b8"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b9"}], "madsrdf:hasVariant": [{"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b10"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b13"}], "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-06-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Yuri manga"}}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"White lilies have been used since the Romantic era of Japanese literature to symbolize beauty and purity in women, and are a de facto symbol of the yuri genre\" ; \"The wasei-eigo construction 'girls' love' and its abbreviation 'GL' were adopted by Japanese publishers in the 2000s\")"}, "madsrdf:citationSource": "Wikipedia, viewed June 21, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Many new fans will often confuse Boy's Love and Yuri with LGBTQ+ manga, but there are key differences between the two. The focus here is less on how their queer identity affects their lives in real world scenarios and more on the fantasy of living a life where you do not have to think about those things\")"}, "madsrdf:citationSource": "Pagan, A. A beginner's guide to manga 2: genres and subgenres, via New York Public Library blog, viewed Feb. 12, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (\"Characters in yuri texts can be portrayed as lovers, friends or even rivals\") p. 17 (\"In practice, yuri and girls' love are more or less equivalent\") p. 18 (\"Outside Japan and also in some non-Japanese articles, another term can be found as denoting texts about female same-sex intimacy: sh\u014djo ai (literally 'girl love')...Yet in Japan, the expression sh\u014djo ai refers not to female same-sex intimacy but to the love of adults for girls\") p. 92 (\"the yuri genre is commonly associated with 'innocence' and 'spiritual bonds,' and these characteristics can be found in virtually all texts that are (retrospectively) assigned to the genre\")"}, "madsrdf:citationSource": "Maser, V. \"Beautiful and innocent : female same-sex Intimacy in the Japanese yuri genre, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Stand-alone yuri manga about a lonely monster, dwelling in seclusion in the forest, wishes she could live among humans despite her frightening appearance\") (OCoLC)1031676497"}, "madsrdf:citationSource": "Neji. Beauty and the beast girl, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Kindred spirits on the roof is a yuri manga omnibus based on a bestselling visual novel game of the same title\") (OCoLC)949821640"}, "madsrdf:citationSource": "Work cat.: Ito, H. Kindred spirits on the roof : the complete collection, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Girls' love manga"}}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Girls' love manga"}}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "GL manga"}}, {"@id": "_:n27fd4b5a055e409ea837df0a5d7b0781b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "GL manga"}}], "@id": "/authorities/genreForms/gf2023026059"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026060", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSh\u014djo manga", "identifiers:lccn": "gf2023026060", "madsrdf:adminMetadata": [{"@id": "_:na99ecdfefd094d55a70ffe147ae73167b1"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sh\u014djo manga"}, "madsrdf:elementList": {"@list": [{"@id": "_:na99ecdfefd094d55a70ffe147ae73167b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026036"}, "madsrdf:hasSource": [{"@id": "_:na99ecdfefd094d55a70ffe147ae73167b5"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b6"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b7"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b8"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b9"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b10"}], "madsrdf:hasVariant": [{"@id": "_:na99ecdfefd094d55a70ffe147ae73167b11"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b14"}], "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-06-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sh\u014djo manga"}}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"A shojo manga tale of medicine, royal intrigue, and romance in a setting inspired by historical China!) (OCoLC)1375011084"}, "madsrdf:citationSource": "Himuka, T. The eccentric doctor of the Moon Flower Kingdom, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 94 (girls' manga tends to revolve around issues of love and friendship, and is \ufb01lled with unrequited love, love triangles, friendships forged through the trials and tribulations of high school life, and the like. The content and form of sh\u014djo manga re\ufb02ects this general focus on human relations\" ) p. 97 (\"The focus on interiority during the golden years of sh\u014djo manga initiated two important stylistic innovations, a montage style of panels, and big eyes\") (OCoLC)231585266"}, "madsrdf:citationSource": "Manga : an anthology of global and cultural perspectives, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"The shojo rom-com manga classic that inspired the beloved anime\") (OCoLC)1375512541"}, "madsrdf:citationSource": "Work cat.: Yoshizumi, W. Marmalade boy, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Sh\u00f4jo manga is targeted at girls up to the age of 18 and focuses on romance, friendship and comedy. Drawing is idealised, with emotions conveyed through large, expressive eyes and symbols such as flowers\")"}, "madsrdf:citationSource": "Rousmaniere, N. 8 manga genres you need to know, via British Museum blog, viewed Feb. 12, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 61 (Natsume identifies techniques of classic sh\u014djo manga from their heyday in the 1970s and even up to works from the 1990s, establishing the tools of 'panel encapsulations' , 'panel layering', and the use of the white space to 'break') p. 68 (not only can panels be lined up, but they can also be layered and internalized)"}, "madsrdf:citationSource": "Fusanosuke, N. Panel configurations in sh\u014djo manga, in U.S.-Japan women's journal v. 58 (2020):", "madsrdf:citationStatus": "found"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 9 (\"early established sh\u014djo conventions: a girl dressed as a boy, lithe and beautiful heroes and heroines nearly indistinguishable in their beauty, gender-bending romance, giant and multistarred eyes, the exuberant use of flowers, feathers, and other objects to divide panels\") p. 34 (\"Sh\u014djo manga checklist. If a manga contains three or more of the following, then it's likely a sh\u014djo manga: teen girls dealing with teen concerns; lithe, beautiful young men (aka bish\u014dnen); focus on relationships, especially romantic; heroine traits include kindness, determination, empathy, and a girl-next-door beauty; elaborate and detailed outfits\") (OCoLC)85898238"}, "madsrdf:citationSource": "Brenner, R. E. Understanding manga and anime, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na99ecdfefd094d55a70ffe147ae73167b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Girls' manga"}}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Girls' manga"}}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na99ecdfefd094d55a70ffe147ae73167b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shoujo manga"}}, {"@id": "_:na99ecdfefd094d55a70ffe147ae73167b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shoujo manga"}}], "@id": "/authorities/genreForms/gf2023026060"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026061", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSh\u014dnen manga", "identifiers:lccn": "gf2023026061", "madsrdf:adminMetadata": [{"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b1"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sh\u014dnen manga"}, "madsrdf:elementList": {"@list": [{"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026036"}, "madsrdf:hasSource": [{"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b5"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b6"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b7"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b8"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b9"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b10"}], "madsrdf:hasVariant": [{"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b11"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b14"}], "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T15:18:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-06-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/csds"}, "ri:recordStatus": "new"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sh\u014dnen manga"}}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Shonen manga often feature lots of action and comedy, and some sort of coming-of-age camaraderie between characters\"; \"Common themes: action, adventure, friendship, coming of age\")"}, "madsrdf:citationSource": "Pagan, A. \"A beginner's guide to manga,\" via New York Public Library blog, viewed Feb. 12, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 28 (\"A handsome young man with wide eyes, thick eyebrows, an easy smile, and a spiky hairdo is recognizable as the hero of many sh\u014dnen manga\") p. 31 (\"Sh\u014dnen manga checklist. If a manga contains three or more of the following, then it's likely a sh\u014dnen manga: teen guys dealing with teen concerns; action/sports sequences; slapstick humor; protagonist traits include heavy eyebrows, a 'never-say-die' attitude, and a rakish grin; themes of honor, heroism, determination, and teamwork; female characters with hourglass figures, skimpy outfits, and a lot of jiggle, otherwise known as fan service\") (OCoLC)85898238"}, "madsrdf:citationSource": "Brenner, R. E. Understanding manga and anime, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Shogakukan Manga Award for sh\u014dnen manga, 2021\") (OCoLC)1200245354"}, "madsrdf:citationSource": "Fujimoto, T. Chainsaw man, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)231585266"}, "madsrdf:citationSource": "Manga : an anthology of global and cultural perspectives, 2010. p. 62 (\"The largest segment of manga publishing is sh\u014dnen or young boys' manga\")", "madsrdf:citationStatus": "found"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (Shonen manga generally have several traits in common and are known for their action sequences and comedy ; Shonen manga tend to focus on friendships between characters and camaraderie. Often the heroes have goals that involve bettering themselves and becoming the best or some other sort of quest) (OCoLC)729344485"}, "madsrdf:citationSource": "Kalen, E. Mostly manga : a genre guide to popular manga, manhwa, manhua, and anime, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Cover (Shonen Sunday manga) (OCoLC)695400489"}, "madsrdf:citationSource": "Work cat.: Takahashi, R. InuYasha, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Boys' manga"}}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Boys' manga"}}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shounen manga"}}, {"@id": "_:na25768b6a0e9493d8dda52cfdc1d8736b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shounen manga"}}], "@id": "/authorities/genreForms/gf2023026061"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026062", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFarewell speeches", "identifiers:lccn": "gf2023026062", "madsrdf:adminMetadata": [{"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b1"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Farewell speeches"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026113"}, "madsrdf:hasSource": [{"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b5"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b6"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b7"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b8"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b9"}], "madsrdf:hasVariant": [{"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b10"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b13"}], "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-31T11:18:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-06-29T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/uk"}, "ri:recordStatus": "new"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Farewell speeches"}}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Valedictory, an address or oration delivered at the commencement exercises of a college or school on behalf of the graduating class; any farewell address or oration)"}, "madsrdf:citationSource": "Dictionary.com, 28 June 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Farewell speech (a farewell speech or farewell address is a speech given by an individual leaving a position or place; they are often used by public figures such as politicians as a capstone to the preceding career, or as statements delivered by persons relating to reasons for their leaving)"}, "madsrdf:citationSource": "Wikipedia, viewed 28 June 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Farewell address in American English (noun) 1. (caps) U.S. History - a statement that President George Washington published in a Philadelphia newspaper in 1796 to announce that he would not run for a third term and to give his views on foreign and domestic policy; 2. a speech delivered by someone upon leaving a job, post, etc.)"}, "madsrdf:citationSource": "Collins dictionary online, 28 June 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Acts of the Apostles, chapter 20 (Paul's farewell speech at Miletus (17))"}, "madsrdf:citationSource": "United States Conference of Catholic Bishops website, 28 June 2023 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (the farewell speeches of Barack Obama & Michelle Obama)"}, "madsrdf:citationSource": "Obama. B. Be vigilant, but not afraid, 2017 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Valedictories (Farewell speeches)"}}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Valedictories (Farewell speeches)"}}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Farewell addresses"}}, {"@id": "_:n8b4d597e9ab04da8a5e2faae08d3e465b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Farewell addresses"}}], "@id": "/authorities/genreForms/gf2023026062"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026063", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aExperimental comics", "identifiers:lccn": "gf2023026063", "madsrdf:adminMetadata": [{"@id": "_:n9dbaa43ad9a844af86f4280227684961b1"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Experimental comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9dbaa43ad9a844af86f4280227684961b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:n9dbaa43ad9a844af86f4280227684961b5"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b6"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b7"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b8"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b9"}], "madsrdf:hasVariant": {"@id": "_:n9dbaa43ad9a844af86f4280227684961b10"}, "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that emphasize innovative or unconventional technique at the time they were created."}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-06-30T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "new"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-31T11:18:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Experimental comics"}}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(collection of the experimental comic strip Krazy Kat, noted for its visual and verbal creativity, particularly in backgrounds and page layouts) (OCoLC)1241071128"}, "madsrdf:citationSource": "Work cat.: Herriman, G. Krazy & Ignatz. 1922-1924, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 17 (\"Art Spiegelman's avant-garde [comics] anthology Raw\") p. 29 (Winsor McCay's Little Nemo in Slumberland \"known for its experimental use of form, manipulation of panel size, deployment of multiple perspectives, and utilization of detailed architectural drawings\") (OCoLC)1201179081"}, "madsrdf:citationSource": "Keywords for comics studies, 2021:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 101 (Experimental comics: \"Experimental comics find new ways to create expression, and in the process test the conventions and boundaries of comics. The experimentation can be applied in the visual style, formal elements, narration, or material and format\"; experimental comics creators include the French collective Oubapo; other experimental comics include \"Alan Moore and J.H. Williams III's Promethea #2 (2005) for nonlinear narration and the disintegration of page layouts; Richard McGuire's Here (2014) for consistent use of a single space and point of view; and Chris Ware's Building stories (2012) and Jason Shiga's Meanwhile (2010) for making readers assemble a narrative themselves\") (OCoLC)1263785410"}, "madsrdf:citationSource": "Key terms in comics studies, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"British-Canadian artist Martin Vaughn-James' brief foray into comics produced two of the best experimental comics ever made, The Projector and Elephant. These books explored cinema, dreams, urban life, and reflect the uncertainty and instability of the era\") (OCoLC)1127131567"}, "madsrdf:citationSource": "Vaughn-James, M. The projector, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"Fantagraphics' Tops collects both issues of these oversized experimental comics in their entirety\"; \"it includes a chronicle in essay form of experimental, adult comics endeavors throughout the first half of the 20th century\")"}, "madsrdf:citationSource": "Tops : the complete collection of Charles Biro's visionary 1949 comic book series, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9dbaa43ad9a844af86f4280227684961b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Avant-garde comics"}}, {"@id": "_:n9dbaa43ad9a844af86f4280227684961b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Avant-garde comics"}}], "@id": "/authorities/genreForms/gf2023026063"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026065", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBreakcore (Music)", "identifiers:lccn": "gf2023026065", "madsrdf:adminMetadata": [{"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b1"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Breakcore (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026887"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026062"}], "madsrdf:hasSource": [{"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b5"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b6"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b7"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b8"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b9"}], "madsrdf:hasVariant": {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b10"}, "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T16:28:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Breakcore (Music)"}}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Venetian Snares. Winter in the belly of a snake, 2002.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Null Hypothesis. Party music for popular people, 2021.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Breakcore; a style and microgenre of electronic dance music that emerged from jungle, hardcore, and drum and bass in the mid-to-late 1990s. It is characterized by very complex and intricate breakbeats and a wide palette of sampling sources played at high tempos)"}, "madsrdf:citationSource": "Wikipedia, Feb. 2, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 153 (breakcore, a breakbeat-centered genre influenced by jungle, industrial, and hardcore techno)"}, "madsrdf:citationSource": "Whelan, Andrew. Breakcore, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Style; Breakcore Music (Typically fast (180BPM+), loud and distorted breakbeat hardcore. Song structure is often non-linear: the breakbeats don't stay the same throughout the song, like in drum n bass, but rather different breaks are chopped, changed and mashed together. Samples from any spectrum of pop culture (Hollywood movies, anime, video games, pop music) are also common, and Ragga-Breakcore with the reggae samples is a popular sub-genre)"}, "madsrdf:citationSource": "Discogs WWW site, Feb. 2, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Break core (Music)"}}, {"@id": "_:ne2c83940f21f41adab703bb7f6576ea7b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Break core (Music)"}}], "@id": "/authorities/genreForms/gf2023026065"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026066", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChapbooks", "identifiers:lccn": "gf2023026066", "madsrdf:adminMetadata": [{"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b1"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Chapbooks"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, "madsrdf:hasSource": [{"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b5"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b6"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b7"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b8"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b9"}], "madsrdf:hasVariant": {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b10"}, "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Small booklets or pamphlets so called because they were originally sold by chapmen."}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T16:28:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chapbooks"}}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The work is referred to as a chapbook in the foreword) (OCoLC)1356912004"}, "madsrdf:citationSource": "Work cat: Domingo, Lora Noreen. Pagsulang, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nineteenth-century term derived from traveling peddlers known as chapmen who sold, among other items, booklets called chapbooks; many contemporary chapbooks are books of poetry, often publishing the work of emerging poets)"}, "madsrdf:citationSource": "Pace University Zines, Pamphlets, Artists' Publications, and Chapbooks: The World of Self-Publishing & Small Press Research Guide, viewed April 26, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Chapbooks. Small books or pamphlets, usually cheaply printed and containing such texts as popular tales, treatises, ballads, or nursery rhymes, formerly peddled by chapmen. Alternate terms: chap-books)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, viewed April 26, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(chap-book; A modern name applied by book-collectors and others to specimens of the popular literature which was formerly circulated by itinerant dealers or chapmen, consisting chiefly of small pamphlets of popular tales, ballads, tracts, etc.)"}, "madsrdf:citationSource": "Oxford English Dictionary, online, viewed September 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Until 1750, most English chapbooks were printed in London with depots in the provinces to facilitate distribution.)"}, "madsrdf:citationSource": "Oxford companion to the book, viewed September 13, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chap-books"}}, {"@id": "_:n4e7b7d92d86b4de6b3c4c17763a02556b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chap-books"}}], "@id": "/authorities/genreForms/gf2023026066"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026067", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDocumentary poetry", "identifiers:lccn": "gf2023026067", "madsrdf:adminMetadata": [{"@id": "_:nef46e34499fc4e22a890e745463371a9b1"}, {"@id": "_:nef46e34499fc4e22a890e745463371a9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Documentary poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nef46e34499fc4e22a890e745463371a9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nef46e34499fc4e22a890e745463371a9b5"}, {"@id": "_:nef46e34499fc4e22a890e745463371a9b6"}, {"@id": "_:nef46e34499fc4e22a890e745463371a9b7"}], "madsrdf:hasVariant": {"@id": "_:nef46e34499fc4e22a890e745463371a9b8"}, "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nef46e34499fc4e22a890e745463371a9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nef46e34499fc4e22a890e745463371a9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T16:28:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nef46e34499fc4e22a890e745463371a9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentary poetry"}}, {"@id": "_:nef46e34499fc4e22a890e745463371a9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Documentary poetry, or docupoetry, combines primary source material such as interviews, news articles, letters, photographs, dairies, court transcripts, medical records, and a variety of public records, with poetry writing. Documentary poets may arrange lines or phrases from the source texts to create poems, convey their interpretation of the documents through original poetry, or write poems that fall on the continuum between these approaches. Most docupoetry shares a common purpose: seeking social change by breaking silences and bearing witness to injustice)"}, "madsrdf:citationSource": [{"@id": "http://www.poetryriver.org/docupoetry.html"}, "PoetryRiver.com, viewed April 24, 2023"], "madsrdf:citationStatus": "found"}, {"@id": "_:nef46e34499fc4e22a890e745463371a9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(documentary poetry, also known as docupoetry, is described as \"socially engaged poetry that often uses nonliterary texts--news reports, legal documents, and transcribed oral histories.\")"}, "madsrdf:citationSource": [{"@id": "https://www.pw.org/content/docupoetry"}, "Poets & Writers website, viewed April 24, 2023"], "madsrdf:citationStatus": "found"}, {"@id": "_:nef46e34499fc4e22a890e745463371a9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP data view (the collection describes the 19th and early 20th century Filipino communities of St. Malo, Barataria Bay, and New Orleans through documentary poetry, with excerpts from oral histories, diaries, and letters) (DLC) 2023012216"}, "madsrdf:citationSource": "Work cat: Settling St. Malo, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:nef46e34499fc4e22a890e745463371a9b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nef46e34499fc4e22a890e745463371a9b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Docupoetry"}}, {"@id": "_:nef46e34499fc4e22a890e745463371a9b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Docupoetry"}}], "@id": "/authorities/genreForms/gf2023026067"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026068", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHard rock music", "identifiers:lccn": "gf2023026068", "madsrdf:adminMetadata": [{"@id": "_:naafae728f70642c1930c9c414b70d188b1"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Hard rock music"}, "madsrdf:elementList": {"@list": [{"@id": "_:naafae728f70642c1930c9c414b70d188b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}, "madsrdf:hasSource": [{"@id": "_:naafae728f70642c1930c9c414b70d188b5"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b6"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b7"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b8"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b9"}], "madsrdf:hasVariant": {"@id": "_:naafae728f70642c1930c9c414b70d188b10"}, "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:naafae728f70642c1930c9c414b70d188b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T16:28:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hard rock music"}}, {"@id": "_:naafae728f70642c1930c9c414b70d188b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: AC/DC. Back in black, 1980.", "madsrdf:citationStatus": "found"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Style; Hard Rock Music (Hard rock (or heavy rock) is a loosely defined subgenre of rock music which has its earliest roots in mid-1960s garage rock, blues rock and psychedelic rock. It is typified by a heavy use of aggressive vocals, distorted electric guitars, bass guitar, drums, and often accompanied with pianos and keyboards)"}, "madsrdf:citationSource": "Discogs WWW site, Feb. 2, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 30 (These very similar styles [hard rock and heavy metal] nonetheless contain attributes that differentiate them and make it relatively easy to put bands into their proper categories. As a rule, hard rock predates and largely created heavy metal as a separate genre, so while loud, guitar-driven bands prior to 1969 may contain elements of heavy metal, they are essentially hard-rock acts. With regard to the use of volume, hard-rock acts tend to exhibit some degree of control over their dynamic techniques, whereas heavy-metal acts will push the sonic envelope to the brink of chaos; hard-rock acts remain mired in the blues and folk roots, with the wide range of lyrical themes complemented by frequent appearances of instruments such as the organ and acoustic guitar)"}, "madsrdf:citationSource": "Smith, Chris. The Greenwood encyclopedia of rock history. Volume 3, The rise of album rock, 1967-1973, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 148 (I would propose initially that the labels 'hard rock' and 'heavy metal' be thought of as points on a style continuum. Some bands cannot be exclusively categorized, but there are features that clearly differentiate bands along this continuum from those outside it)"}, "madsrdf:citationSource": "Moore, Alan F. Rock: the primary text, 2nd ed., 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Kiss. Destroyer, 1976.", "madsrdf:citationStatus": "found"}, {"@id": "_:naafae728f70642c1930c9c414b70d188b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naafae728f70642c1930c9c414b70d188b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Heavy rock music"}}, {"@id": "_:naafae728f70642c1930c9c414b70d188b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heavy rock music"}}], "@id": "/authorities/genreForms/gf2023026068"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026069", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMagic realist comics", "identifiers:lccn": "gf2023026069", "madsrdf:adminMetadata": [{"@id": "_:nd229d0b0b4254fc4858fb783d524578fb1"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Magic realist comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd229d0b0b4254fc4858fb783d524578fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasSource": [{"@id": "_:nd229d0b0b4254fc4858fb783d524578fb5"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb6"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb7"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb8"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb9"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb10"}], "madsrdf:hasVariant": [{"@id": "_:nd229d0b0b4254fc4858fb783d524578fb11"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb14"}], "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics in which fantastic or mythical elements are included in a narrative that is otherwise realistic."}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T16:28:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magic realist comics"}}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "back cover (\"A brilliantly original debut graphic novel that imagines a fantastical Cairo where wishes really do come true\") (OCoLC)1289615399"}, "madsrdf:citationSource": "Work cat: Mohamed, D. Shubeik lubeik, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Comicology features work by artists who represent an emerging wave of underground comics creators whose fictions are an alchemy of reality and fantasy\")"}, "madsrdf:citationSource": "Comicology : the new magical real : an exhibit of original comic book art in a magical realist vein, via University of Pennsylvania's Slought website, viewed May 16, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fabio Moon's \"De: Tales\" contains \"deeply satisfying realist and magic-realist comics\")"}, "madsrdf:citationSource": "Olson, R. Top 10 graphic novels: 2007, via Booklist website, viewed May 16, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Magical realism is the often overlooked genre of fiction where magical elements are often subtle and observed as mundane and a part of everyday life\"; \"it's generally agreed upon that the point of magical realism is to emphasize elements of reality by introducing magical elements\"; examples of magical realist comics include Gilbert Hernandez's \"Heartbreak soup,\" which includes \"children disappearing during eclipses, ghosts, and strange faces hiding in nature\")"}, "madsrdf:citationSource": "Cadotte, J. So you want to read comics : magical realism edition, via MajorSpoilers website, viewed May 16, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"a partly autobiographical, partly magical-realistic comic\") (OCoLC)1252411283"}, "madsrdf:citationSource": "Vernocke, W. Trinity, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: \"a magical realist graphic novel about a young girl who befriends her town's witch and discovers the strange magic within herself\") (OCoLC)1089265295"}, "madsrdf:citationSource": "Leyh, K. Snapdragon, 2020", "madsrdf:citationStatus": "found"}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd229d0b0b4254fc4858fb783d524578fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magical realist comics"}}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magical realist comics"}}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd229d0b0b4254fc4858fb783d524578fb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magical realistic comic"}}, {"@id": "_:nd229d0b0b4254fc4858fb783d524578fb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magical realistic comic"}}], "@id": "/authorities/genreForms/gf2023026069"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026070", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPower electronics (Music)", "identifiers:lccn": "gf2023026070", "madsrdf:adminMetadata": [{"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b1"}, {"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Power electronics (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026874"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026967"}], "madsrdf:hasSource": [{"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b5"}, {"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b6"}, {"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b7"}, {"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b8"}], "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Popular music consisting of static, feedback noise, and synthesizer effects, often accompanied by screamed and distorted vocals."}, {"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-09-29T16:28:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Power electronics (Music)"}}, {"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)952493761"}, "madsrdf:citationSource": "Whitehouse. The sound of being alive, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Style; Power Electronics Music (Power electronics was originally coined by William Bennett as part of the sleevenotes to the Whitehouse album Psychopathia Sexualis, and is related to the early Industrial Records scene but later became more identified with noise music. It consists of static, screeching waves of feedback, analogue synthesizers making sub-bass pulses or high frequency squealing sounds, and screamed, distorted, often hateful and offensive lyrics. Deeply atonal, there are no conventional melodies or rhythms)"}, "madsrdf:citationSource": "Discogs WWW site, Feb. 2, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (Power electronics is a genre of industrial or 'noise' music that utilises feedback and synthesizers to produce an intense, loud, challenging sound. To match this sonic excess, power electronics also relies heavily upon extreme thematic and visual content-- whether in lyrics, album art, or live performance)"}, "madsrdf:citationSource": "Wallis, Jennifer. Fight your own war, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4049cb9e2a3442ec87e4d40e3633af94b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Shallow. Catalogue 2, 2021.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2023026070"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026071", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSatirical comics", "identifiers:lccn": "gf2023026071", "madsrdf:adminMetadata": [{"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b1"}, {"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Satirical comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026376"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026525"}], "madsrdf:hasSource": {"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b5"}, "madsrdf:hasVariant": [{"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b6"}, {"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b9"}], "madsrdf:historyNote": "[Established September 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-02-22T14:17:36"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satirical comics"}}, {"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP data view (an action satire original graphic novel pitted in the world of conspiracy theory) (DLC) 2023004954"}, "madsrdf:citationSource": "Work cat: Project Monarch, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satires (Comics)"}}, {"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satires (Comics)"}}, {"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Satiric comics"}}, {"@id": "_:n544b0f966b6c426ba7c2a16c98f57a70b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Satiric comics"}}], "@id": "/authorities/genreForms/gf2023026071"}
