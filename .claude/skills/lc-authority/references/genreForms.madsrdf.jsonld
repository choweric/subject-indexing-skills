i:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Werewolf comics"}}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comic books)"}, "madsrdf:citationSource": "Kaji, K. Lycanthrope Leo, \u00a91994-", "madsrdf:citationStatus": "found"}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beginning with the legendary E.C. Comics horror titles from the 1940s and '50s, vampires, zombies, demons, and all other types of creepy creatures have made a major impact on the storytelling medium; 12. Werewolf by Night)"}, "madsrdf:citationSource": "erafino, J. The 15 scariest monsters in comic books, via Complex website, Oct. 31, 2012, viewed on July 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novel)"}, "madsrdf:citationSource": "Jason. Werewolves of Montpellier, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 173 (werewolf comics)"}, "madsrdf:citationSource": "Senn, B. The werewolf filmography, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 91 (werewolves were popular comic book creatures during the 1940s and early 1950s; one of Marvel Comics best-known lycanthropes was Man-Wolf; Werewolf By Night is considered by many readers to be the definitive werewolf comic book; werewolf comics)"}, "madsrdf:citationSource": "Godfrey, L.S. Werewolves, \u00a92008:", "madsrdf:citationStatus": "found"}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(graphic novelization of the author's novel Tantalize, told from a different perspective; summary: Werewolf-in-training Kieren is torn between joining an urban wolf pack and staying to protect his human best friend (and love interest) Quincie, whose restaurant is in danger of morphing into a vampire lair.)"}, "madsrdf:citationSource": "Work cat.: Smith, C.L. Tantalize : Kieren's story, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(10. Werewolf by Night)"}, "madsrdf:citationSource": "Elkin, D. Top 10 monster comics, via Comics bulletin website, posted Apr. 17, 2012, viewed on July 8, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lycanthropic comics)"}, "madsrdf:citationSource": "Gonzalez, E. Wolf Moon #1 [review of Wolf Moon by Cullen Bunn, Jeremy Haun & Lee Loughridge], via All-Comic.com website, 4 Dec. 2014, viewed on Apr. 2, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lycanthropic comics"}}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lycanthropic comics"}}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Werwolf comics"}}, {"@id": "_:naf08b076e8b44eb6a956fbc1daa3be83b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Werwolf comics"}}], "@id": "/authorities/genreForms/gf2018026039"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026040", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAltered books", "identifiers:lccn": "gf2018026040", "madsrdf:adminMetadata": [{"@id": "_:n02a62d8e16d94876a849d9330a196cd2b1"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Altered books"}, "madsrdf:elementList": {"@list": [{"@id": "_:n02a62d8e16d94876a849d9330a196cd2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027266"}, "madsrdf:hasSource": [{"@id": "_:n02a62d8e16d94876a849d9330a196cd2b5"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b6"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b7"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b8"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b9"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b10"}], "madsrdf:hasVariant": {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-05-14T09:20:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Altered books"}}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an altered book is an art object that has been created from an existing, printed book. The book is altered through whatever means and media the artist chooses. This generally means using the book's pages as a canvas on which to apply paint, collage or rubber stamping. It could also mean cutting into the book to create a more sculptural piece)"}, "madsrdf:citationSource": "A crash course on altered books, via Mixed Media Club website, Apr. 2, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(part bookbinding, part bibliovandalism, part mixed-media collage, and part scrapbooking; according to the International Society of Altered Book Artist, it's \"any book, old or new, that has been recycled by creative means into a work of art. They can be ... rebound, painted, cut, burned, folded, added to, collaged in, gold-leafed, rubber stamped, drilled, or otherwise adorned ...\")"}, "madsrdf:citationSource": "Altered books, via Make: website, Apr. 2, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Altered books. UF Altered book art. BT Books. BT Collage)"}, "madsrdf:citationSource": "LCSH, Apr. 2, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(One-of-a-kind sculptural artist's book from an altered notebook with plastic spiral binding. Leaves of various neon colored papers are altered by painting, collaging and burning.)"}, "madsrdf:citationSource": "Work cat.: Straus, Austin. [Constructions], 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (altered book; a book that has been altered in some way; You take an old book and add your own art work. You might cut niches, add pictures or images, draw, paint, chalk, add fiber, ribbon, lace, ephemera, beads - or anything you want. You might opt to incorporate words, text, or images from the existing book, or you might not. It's your choice. There are no rules.)"}, "madsrdf:citationSource": "A cyber home for the altered book artist, Apr. 2, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Art & architecture thesaurus online, Mar. 3, 2021", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n02a62d8e16d94876a849d9330a196cd2b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Altered-book art"}}, {"@id": "_:n02a62d8e16d94876a849d9330a196cd2b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Altered-book art"}}], "@id": "/authorities/genreForms/gf2018026040"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026041", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMotion comics", "identifiers:lccn": "gf2018026041", "madsrdf:adminMetadata": [{"@id": "_:n272eb9a6038d4782b779be016c3be14db1"}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Motion comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n272eb9a6038d4782b779be016c3be14db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026049"}, "madsrdf:hasSource": [{"@id": "_:n272eb9a6038d4782b779be016c3be14db5"}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db6"}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db7"}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db8"}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-04T14:38:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Motion comics"}}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Motion Comics)"}, "madsrdf:citationSource": [{"@id": "http://www.powerhouseanimation.com/motion-comics/"}, "Power House Animation WWW site, viewed April 4, 2018"], "madsrdf:citationStatus": "found"}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Paul Jenkins and Jae Lee's Inhumans getting motion-comic treatment)"}, "madsrdf:citationSource": [{"@id": "https://www.cbr.com/paul-jenkins-and-jae-lees-inhumans-getting-motion-comic-treatment/"}, "Comic book resources WWW site, viewed April 4, 2018"], "madsrdf:citationStatus": "found"}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: 2018600540: Inhumans, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Somewhere between standard cartoon strips and full-blown animated work lies what's known as the 'motion comic.' Motion comics look like traditional comic books, but incorporate voice acting and a musical score. And only certain elements of the 'page' are animated: a zoom-in, a pan, someone raising their arms.)"}, "madsrdf:citationSource": [{"@id": "https://gigaom.com/2008/07/30/the-rise-of-motion-comics-online/"}, "Gigaom WWW site, viewed April 4, 2018"], "madsrdf:citationStatus": "found"}, {"@id": "_:n272eb9a6038d4782b779be016c3be14db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(new kind of web entertainment: a hybrid of comic books and animation that Warner calls 'motion comics')"}, "madsrdf:citationSource": [{"@id": "https://www.wsj.com/articles/SB121634908179464605"}, "The Wall Street journal, WWW site, viewed April 4, 2018"], "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026041"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026042", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPersonals (Advertisements)", "identifiers:lccn": "gf2018026042", "madsrdf:adminMetadata": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb1"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Personals (Advertisements)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027215"}, "madsrdf:hasSource": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb5"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb6"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb7"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb8"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb9"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb10"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb11"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb12"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb13"}], "madsrdf:hasVariant": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb14"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb17"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb20"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb23"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb26"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb29"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb32"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb35"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-07-13T13:01:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-17T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Personals (Advertisements)"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 3 (personal classified ads)"}, "madsrdf:citationSource": "Skins, Jan. 1989:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(personal, noun: def. 1: a short newspaper paragraph relating to the activities of a person or a group or to personal matters; def. 2: a short personal communication in a special column of the classified ads section of a newspaper or periodical)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Apr. 17, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Consists of gay personals for the San Francisco Bay Area)"}, "madsrdf:citationSource": "Work cat.: Adz (San Francisco, Calif.). The adz, 1970", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Personals. UF Advertising, Personal; Agony columns; Newspapers--Sections, columns, etc.--Personals; Personal ads; Personal advertising. BT Advertising, Classified)"}, "madsrdf:citationSource": "LCSH, Apr. 17, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(personal, noun US a. a short, personal communication placed as in a newspaper b. a classified advertisement placed for the purpose of seeking someone to date or have a personal relationship with c. [pl.] a section of such advertisements, as in a newspaper)"}, "madsrdf:citationSource": "Webster's new world college dictionary, via Collins English dictionary online, Apr. 17, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Preston, J. Classified affairs : a gay man's guide to the personal ads, \u00a91984.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Forney, E. Lust : kinky online personal ads from Seattle's The stranger, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(personals, plural noun: The section in a newspaper or magazine that contains messages for individual people and advertisements of a private nature is called the personals. Regional note: in BRIT, usually use personal column)"}, "madsrdf:citationSource": "COBUILD advanced English dictionary, via Collins English dictionary online, Apr. 17, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cocks, H. Classified : the secret history of the personal column, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Personal classified advertisements"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Personal classified advertisements"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Personal ads"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Personal ads"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Personal advertisements"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Personal advertisements"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Classified advertisements, Personal"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Classified advertisements, Personal"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Personal columns"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Personal columns"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Personal classified ads"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Personal classified ads"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Columns, Personal"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Columns, Personal"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne3519bd7378c41dfbef039391ec767ecb36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Classified ads, Personal"}}, {"@id": "_:ne3519bd7378c41dfbef039391ec767ecb36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Classified ads, Personal"}}], "@id": "/authorities/genreForms/gf2018026042"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026044", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aElectro (Music)", "identifiers:lccn": "gf2018026044", "madsrdf:adminMetadata": [{"@id": "_:n479fee3414bc49889523e9ba31832126b1"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Electro (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n479fee3414bc49889523e9ba31832126b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026823"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026156"}], "madsrdf:hasSource": [{"@id": "_:n479fee3414bc49889523e9ba31832126b5"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b6"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b7"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b8"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b9"}], "madsrdf:hasVariant": {"@id": "_:n479fee3414bc49889523e9ba31832126b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n479fee3414bc49889523e9ba31832126b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-06-12T11:53:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "revised"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Electro (Music)"}}, {"@id": "_:n479fee3414bc49889523e9ba31832126b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)659767643"}, "madsrdf:citationSource": "Ice-T. The coldest rap, 1986.", "madsrdf:citationStatus": "found"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)9448874"}, "madsrdf:citationSource": "Work cat: Afrika Bambaataa & the Soul Sonic Force. Planet rock, 1982.", "madsrdf:citationStatus": "found"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 199 (Electro developed initially as an electronic version of hip-hop's rap and break beat dance music during the early 1980s in New York City) p. 200 (When regarded in a wider context than rap, electro is also referred to as electro-funk)"}, "madsrdf:citationSource": "Continuum encyclopedia of popular music of the world, v.8, genres: North America, c2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Open Cultural Studies, 2018:2, p. 124. Paor-Evans, Adam de. The futurism of hip-hop: space, electro, and science fiction in rap (Electro can be traced back to Kraftwerk and Yellow Magic Orchestra (both bands produced significant work during the 1970s), and the Roland TB-303, TR-808, the TR-727 and TR-90)"}, "madsrdf:citationSource": "De Gruyter Open Access, March 3, 2024:", "madsrdf:citationStatus": "found"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Electro [electro-funk]; a genre of Electronic dance music from the early 1980s. Unlike techno's steady \"four on the floor\" pulse (featuring a bass drum kick on every beat), electro tracks are more syncopated, making use of breakbeats. Electro evolved in tandem with early hip-hop, but each genre emphasized different influences. Both were inspired by 1970s funk (\"electro\" is short for \"electro-funk\"), but early hip-hop borrowed heavily from disco, whereas electro artists took Kraftwerk and early synth-pop groups such as Yellow Magic Orchestra as their inspirational touchstone. Despite this divergence, elements of early hip-hop and electro can be found in key tracks such as \"Planet Rock\" (1982) by Afrika Bambaataa and the Soul Sonic Force)"}, "madsrdf:citationSource": "Grove music online, January 25, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n479fee3414bc49889523e9ba31832126b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n479fee3414bc49889523e9ba31832126b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Electro-funk (Music)"}}, {"@id": "_:n479fee3414bc49889523e9ba31832126b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Electro-funk (Music)"}}], "@id": "/authorities/genreForms/gf2018026044"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026045", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aViews", "identifiers:lccn": "gf2018026045", "madsrdf:adminMetadata": [{"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b1"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Views"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026113"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017027266"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026033"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026744"}], "madsrdf:hasSource": [{"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b5"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b6"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b7"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b8"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b9"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b10"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b11"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b12"}], "madsrdf:hasVariant": [{"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b13"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Visual works depicting places or things seen from a distance, in which detail is shown as if projected on an oblique plane."}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T08:45:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Views"}}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "map recto (Vu\u00eb du Cap de Bonne Esperance; 2 maps + 1 view on 1 sheet)"}, "madsrdf:citationSource": "Work cat.: Bellin, J.N. Fort, 1747:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (View. A perspective representation of the landscape in which detail is shown as if projected on an oblique plane. See also Bird's-eye view; Panorama; Perspective view; Worm's-eye view.)"}, "madsrdf:citationSource": "Descriptive cataloging of rare materials (cartographic), 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(view: A unit of extent that is a perspective representation of the landscape in which detail is shown as if projected on an oblique plane. This term applies to cartographic resources. A bird's-eye view, panorama, panoramic drawing, worm's-eye view, etc., are included.)"}, "madsrdf:citationSource": "RDA glossary, viewed online Apr. 20, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Views. Scope Note: Depictions, in any media, usually of places and structures, made from a certain distance, and not necessarily intended to produce detailed information. Distinct from other information such as diagrams, working drawings, maps, and plans. A topographical image, showing a general aspect of a place. UF Topographical views. BT Pictures. NT Aerial views, Bird's-eye views, Cityscapes, Fisheye views, Landscapes (Representations), Marines (Visual works), Panoramic views, Seascapes, Worm's-eye views. RT Viewbooks)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, Apr. 20, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(views (visual works); Depictions of places or things seen from a distance, with a range of sight distinct from other information forms such as diagrams, working drawings, or verbal descriptions. Generally reserved for two-dimensional media such as prints, drawings, paintings, photographs, or bas-reliefs)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Apr. 20, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (View (Cartography): A perspective representation of the landscape in which detail is shown as if projected on an oblique plane (e.g., a bird's-eye view, panorama, panoramic drawing, worm's-eye view). See also Bird's-eye view, Isometric view, Panorama, Perspective view, Worm's-eye view.)"}, "madsrdf:citationSource": "Cartographic materials, 2003, 2005 update:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Views. UF Geography--Views, Natural scenery, Scenery, Voyages and travels--Views. BT Pictures. RT Geography--Pictorial works)"}, "madsrdf:citationSource": "LCSH, Apr. 20, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mayhew, S. A dictionary of geography, 2009, via Oxford reference website, Apr. 20, 2018", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Topographical views"}}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Topographical views"}}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Geographical views"}}, {"@id": "_:n8b3039c0f6d64adca89efb8c9bb51811b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Geographical views"}}], "@id": "/authorities/genreForms/gf2018026045"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026046", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPasticcios (Music)", "identifiers:lccn": "gf2018026046", "madsrdf:adminMetadata": [{"@id": "_:nf5fc635909e04a3992bcf914754841c3b1"}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pasticcios (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf5fc635909e04a3992bcf914754841c3b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}], "madsrdf:hasSource": [{"@id": "_:nf5fc635909e04a3992bcf914754841c3b5"}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b6"}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b7"}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b8"}], "madsrdf:hasVariant": [{"@id": "_:nf5fc635909e04a3992bcf914754841c3b9"}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-04T14:38:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-25T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pasticcios (Music)"}}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pasticcio (plural pasticci or pasticcios : pastiche) pastiche (1. a literary, artistic, musical, or architectural work that imitates the style of previous work. 2a. a musical, literary, or artistic composition made up of selections from different works : potpourri. 2b. hodgepodge)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Apr. 25, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pasticcio (Fr. pastiche); opera made up of various pieces from different composers or sources and adapted to a new or existing libretto; pasticcios; types: i) Revival with substitutions: arias by various composers are substituted for pieces thought unsuitable for the available singers; ii) True pasticcio: a) a patchwork in which singers, librettist or impresario fill out an existing libretto entirely with arie di bagaglio, or b) a composite original, in which diverse arias by several composers are fashioned into a new plot; iii) a composer patchwork: a composer incorporates his own arias, old or new, into another's score; iv) a self-pastiche: an amalgam of a composer's own arias in a new context)"}, "madsrdf:citationSource": "Grove music online, Apr. 25, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Pastiche: In music pastiche is applied to a medley or assembly of various pieces into a single work)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(opera with libretto by Pietro Metastasio) booklet, p. 12 (\"This recording has been structured to contain all of Metastasio's original arias; it is a pasticcio in the sense that the music is by sixteen different composers amongst the many that set the libretto between 1733 and the end of the century.\")"}, "madsrdf:citationSource": "Work cat.: L'Olimpiade, \u00a92012", "madsrdf:citationStatus": "found"}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5fc635909e04a3992bcf914754841c3b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pasticci (Music)"}}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pasticci (Music)"}}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf5fc635909e04a3992bcf914754841c3b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pastiches (Music)"}}, {"@id": "_:nf5fc635909e04a3992bcf914754841c3b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastiches (Music)"}}], "@id": "/authorities/genreForms/gf2018026046"}
