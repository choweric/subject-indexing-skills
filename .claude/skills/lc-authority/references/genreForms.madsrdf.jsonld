:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Swing (Music)"}}, {"@id": "_:n2e6eda06b59e4a0dac5e092e975b159fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(quality attributed to jazz performance ... has resisted concise definition or description; name given to a jazz style and to a related phase of popular music which originated around 1930 ... repertory based largely on Tin Pan Alley songs)"}, "madsrdf:citationSource": "New Grove dict. jazz", "madsrdf:citationStatus": "found"}, {"@id": "_:n2e6eda06b59e4a0dac5e092e975b159fb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2e6eda06b59e4a0dac5e092e975b159fb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2e6eda06b59e4a0dac5e092e975b159fb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jive"}}, {"@id": "_:n2e6eda06b59e4a0dac5e092e975b159fb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jive"}}], "@id": "/authorities/genreForms/gf2014027119"}
