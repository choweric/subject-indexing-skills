nt", "madsrdf:elementValue": {"@language": "en", "@value": "Gabba (Music)"}}, {"@id": "_:n2dc1a647b6ca416aba6bf10569dc7577b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Reynolds. Generation ecstasy, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2dc1a647b6ca416aba6bf10569dc7577b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "table of contents (Marching into madness: gabba and happy hardcore, 1992-97)"}, "madsrdf:citationSource": "Reynolds. Generation ecstasy, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2dc1a647b6ca416aba6bf10569dc7577b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. x (Gabba: most popular in the Netherlands and Scotland, Gabba is the hardest form of hardcore techno, frequently exceeding speeds of over 200 BPM)"}, "madsrdf:citationSource": "All Music guide to electronica, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2dc1a647b6ca416aba6bf10569dc7577b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 69 (by 1997 gabber music dominated the Dutch music scene)"}, "madsrdf:citationSource": "Hunt. Youth, drugs and nightlife, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2dc1a647b6ca416aba6bf10569dc7577b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(gabba)"}, "madsrdf:citationSource": "International Index to Music Periodicals, Sep. 7, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n2dc1a647b6ca416aba6bf10569dc7577b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2dc1a647b6ca416aba6bf10569dc7577b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gabber (Music)"}}, {"@id": "_:n2dc1a647b6ca416aba6bf10569dc7577b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gabber (Music)"}}], "@id": "/authorities/genreForms/gf2014026825"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026826", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGagaku", "identifiers:lccn": "gf2014026826", "madsrdf:adminMetadata": [{"@id": "_:naf5b866555b5414194e4eaad393c7db6b1"}, {"@id": "_:naf5b866555b5414194e4eaad393c7db6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gagaku"}, "madsrdf:elementList": {"@list": [{"@id": "_:naf5b866555b5414194e4eaad393c7db6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026675"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027064"}], "madsrdf:hasSource": {"@id": "_:naf5b866555b5414194e4eaad393c7db6b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:naf5b866555b5414194e4eaad393c7db6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:naf5b866555b5414194e4eaad393c7db6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:naf5b866555b5414194e4eaad393c7db6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gagaku"}}, {"@id": "_:naf5b866555b5414194e4eaad393c7db6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Gagaku (Gagaku. Court music of Japan.) under Japan V, Court music (Gagaku, the ancient traditional music of the Japanese court, today comprises the following repertories: t\u014dgaku, komagaku, saibara, r\u014dei and Shint\u014d ritual music and dance. The two Chinese characters used to write gagaku (literally 'elegant music') were originally used in China to signify Confucian ritual music.)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026826"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026827", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGahu (Music)", "identifiers:lccn": "gf2014026827", "madsrdf:adminMetadata": [{"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb1"}, {"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gahu (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb5"}, {"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb6"}, {"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gahu (Music)"}}, {"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Locke, D. Drum gahu!, 1987.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gahu: traditional African drumming & dance from Ghana; an adaptation of kokosawa, an older African drum and dance style that originated with they Yoruba people of neighboring Nigeria. The Ewe took kokosawa and increased the tempo to more than double its original value; ensemble comprised of gankogui, axatse, boba drum, sogo drum, kidi drum, and kagan drum)"}, "madsrdf:citationSource": "This world music WWW site, viewed November 25, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb84af6cbfe134e2589f8fe51314409cbb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3;New Grove;Harvard dictionary, 2nd ed.;Terminorum musicae", "madsrdf:citationStatus": "notfound"}], "@id": "/authorities/genreForms/gf2014026827"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026828", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGalliards (Music)", "identifiers:lccn": "gf2014026828", "madsrdf:adminMetadata": [{"@id": "_:n22299c961c3142698a0b736279488672b1"}, {"@id": "_:n22299c961c3142698a0b736279488672b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Galliards (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n22299c961c3142698a0b736279488672b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:n22299c961c3142698a0b736279488672b5"}, "madsrdf:hasVariant": [{"@id": "_:n22299c961c3142698a0b736279488672b6"}, {"@id": "_:n22299c961c3142698a0b736279488672b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n22299c961c3142698a0b736279488672b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n22299c961c3142698a0b736279488672b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n22299c961c3142698a0b736279488672b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Galliards (Music)"}}, {"@id": "_:n22299c961c3142698a0b736279488672b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Gagliarda (Gagliarda [It., Fr., gaillarde; Sp. galiarda; Eng. galliard]. A gay rollicking 16-th century court dance of Italian origin. The music is characterized by a predominantly compound duple (6/8) meter occasionally interpsersed with hemiola (3/4 ) measures.)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n22299c961c3142698a0b736279488672b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n22299c961c3142698a0b736279488672b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gaillardes (Music)"}}, {"@id": "_:n22299c961c3142698a0b736279488672b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gaillardes (Music)"}}, {"@id": "_:n22299c961c3142698a0b736279488672b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n22299c961c3142698a0b736279488672b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gagliarde (Music)"}}, {"@id": "_:n22299c961c3142698a0b736279488672b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gagliarde (Music)"}}], "@id": "/authorities/genreForms/gf2014026828"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026829", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGalops (Music)", "identifiers:lccn": "gf2014026829", "madsrdf:adminMetadata": [{"@id": "_:nb74bf622eef74209b3bcdc38c63a467bb1"}, {"@id": "_:nb74bf622eef74209b3bcdc38c63a467bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Galops (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb74bf622eef74209b3bcdc38c63a467bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:nb74bf622eef74209b3bcdc38c63a467bb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb74bf622eef74209b3bcdc38c63a467bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb74bf622eef74209b3bcdc38c63a467bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb74bf622eef74209b3bcdc38c63a467bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Galops (Music)"}}, {"@id": "_:nb74bf622eef74209b3bcdc38c63a467bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Galop. A quick, lively dance in 2/4 time. Together with the waltz, quadrille and polka it was one of the most popular ballroom dances of the 19th century.)"}, "madsrdf:citationSource": "Grove music online, viewed August 9, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026829"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026830", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGangsta rap (Music)", "identifiers:lccn": "gf2014026830", "madsrdf:adminMetadata": [{"@id": "_:ne218c762e5df4453adc622fd88e661a0b1"}, {"@id": "_:ne218c762e5df4453adc622fd88e661a0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gangsta rap (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne218c762e5df4453adc622fd88e661a0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027037"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026031"}, "madsrdf:hasSource": [{"@id": "_:ne218c762e5df4453adc622fd88e661a0b5"}, {"@id": "_:ne218c762e5df4453adc622fd88e661a0b6"}], "madsrdf:hasVariant": {"@id": "_:ne218c762e5df4453adc622fd88e661a0b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne218c762e5df4453adc622fd88e661a0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne218c762e5df4453adc622fd88e661a0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne218c762e5df4453adc622fd88e661a0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gangsta rap (Music)"}}, {"@id": "_:ne218c762e5df4453adc622fd88e661a0b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Gangsta : merchandizing the rhymes of violence, 1996.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne218c762e5df4453adc622fd88e661a0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gangsta (gangster) rap; a style of rap whose texts emphasize the violence of street life)"}, "madsrdf:citationSource": "Grove music online, Oct. 21, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:ne218c762e5df4453adc622fd88e661a0b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne218c762e5df4453adc622fd88e661a0b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gangster rap (Music)"}}, {"@id": "_:ne218c762e5df4453adc622fd88e661a0b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gangster rap (Music)"}}], "@id": "/authorities/genreForms/gf2014026830"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026831", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGarage rock music", "identifiers:lccn": "gf2014026831", "madsrdf:adminMetadata": [{"@id": "_:nb4d008fe21e34128aa69ef430337b456b1"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Garage rock music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb4d008fe21e34128aa69ef430337b456b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}, "madsrdf:hasSource": [{"@id": "_:nb4d008fe21e34128aa69ef430337b456b5"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b6"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b7"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b8"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b9"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b10"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b11"}], "madsrdf:hasVariant": {"@id": "_:nb4d008fe21e34128aa69ef430337b456b12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Garage rock music"}}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Garage bands; garage rock: The garage bands of the late 1960s, so called as exponents made the music in the garage or basement, were especially prominent in the U.S., where they responded to the British invasion of the American market.)"}, "madsrdf:citationSource": "Shuker, R. Key concepts pop. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2001126057: Hall, R. Playing for a piece of the door, c2001.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under United States: Garage rock: Rock music that sounds like it was [sic] recorded in a garage; raw style of rock that began in the 1960s)"}, "madsrdf:citationSource": "White, D. Dict. pop. mus. styles world", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Garage band: Amateur rock or pop group, which rehearses in a garage or in other modest surroundings)"}, "madsrdf:citationSource": "Pickering, D. Cassell comp. 20th-cent. mus.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Garage rock was a simple, raw form of rock & roll created by a number of American bands in the mid-'60s.)"}, "madsrdf:citationSource": "All music guide WWW site, Jan. 27, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Garage rock is considered to have reached its peak in the U.S. during the mid-sixties. For the most part the bands were of high-school age and fed off the musical frenzy generated by the British Invasion groups.)"}, "madsrdf:citationSource": "The Garage WWW site, Jan. 27, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Garage (form of 20th-century club dance music): As \"garage\" rock, the term had earlier been used to denote movement primarily outside the commercial rock mainstream, predominantly in the USA and beginning in the 1960s)"}, "madsrdf:citationSource": "Grovemusic.com WWW site, Jan. 27, 2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb4d008fe21e34128aa69ef430337b456b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Garage band music"}}, {"@id": "_:nb4d008fe21e34128aa69ef430337b456b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Garage band music"}}], "@id": "/authorities/genreForms/gf2014026831"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026832", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGats (Music)", "identifiers:lccn": "gf2014026832", "madsrdf:adminMetadata": [{"@id": "_:n641eb0ef0e02485089e8cecc3b345283b1"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gats (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n641eb0ef0e02485089e8cecc3b345283b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026859"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027180"}], "madsrdf:hasSource": [{"@id": "_:n641eb0ef0e02485089e8cecc3b345283b5"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b6"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b7"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b8"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b9"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b10"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b11"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Gats for melodic instruments."}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:26:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gats (Music)"}}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Khan, V. Sitar, Raga Ghaara, alap, gat Trital, c1979.", "madsrdf:citationStatus": "found"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Khan, A.A. Raga Durga : brief alap, Madhyalaya gat & Rezakhani gat, 198-.", "madsrdf:citationStatus": "found"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gat (Hin.: 'a [manner of] going'). A term used in North Indian art music. (1) A composition for sit\u0101r, sarod or other melody instrument in a particular r\u0101g and t\u0101l. Two common gat types for sit\u0101r, the Mas\u012btkh\u0101n\u012b and Raz\u0101kh\u0101n\u012b, are distinguished by their rhythmic plucking-patterns. (2) A type of composition for the drum tabl\u0101, often characterized by unusual rhythmic devices. (3) A type of dance composition)"}, "madsrdf:citationSource": "Grove music online, Oct. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Indian classical music > Genre (Instrumental Music - Classical Instrumental Music - Hindustani Instrumental Forms - Traditional Instrumental Form - Alap; Jor; Jhala; Masitkhani Gat; Razakhani Gat; Gat in its most general sense means a fixed composition. As such, you find gats for both melodic instruments as well as rhythmic instruments like the tabla. However, the most usual use of the word implies the fixed composition for melodic instruments. Gat is a structure very much like like the sthai in the vocal tradition. It has a fully developed cycle and is invariably accompanied by the tabla. There are two basic approaches; masitkhani and razakhani. The masitkhani gat is the basic slow gat while the razakhani is fast. In recent years, the distinction between the two styles has become blurred. Furthermore, the contemporary structure of both the fast and slow sections seems to have morphed away from the styles developed by Raza Khan and Masit Khan. Other Instrumental Styles: Alap; Jor (Jod); Jhala)"}, "madsrdf:citationSource": "Chandrakantha and David Courtney's homepage, Oct. 9, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Traditionally, most performances of Hindustani music begin with alap--an extensive solo exploration of the raga by the instrumentalist. ... After the alap, the instrumentalist is joined by the accompanying drummer, and together they enter the section of the raga known as the gat. Here we are introduced to the rhythmic basis of Indian music: the tala. A tala is a cycle of a fixed number of beats repeated over and over again, and played as distinct patterns of strokes on the accompanying drums. There are many different talas (6 beats, 7, 10, 12, 14, etc.), and each one has a different rhythmic mood. Except for alap, every piece of Indian classical music is played within a particular tala. The gat begins with the instrumentalist playing a rhythmic/melodic theme within the raga. Through this theme, the soloist thus establishes the tala within which the raga will now progress. Often, the tala will not be announced prior to the performance, and is chosen on the spot by the instrumentalist. Even the accompanying drummer may not know what the rhythmic cycle will be and must infer from the first hearing of the theme what patterns to play on the drums. The gat proceeds with the drummer supporting the soloist while variations are made and the raga is further explored. The two musicians interact rhythmically throughout the performance, always meeting on the first beat of the rhythmic cycle. This dynamic interchange becomes more prevalent as the raga progresses.)"}, "madsrdf:citationSource": "Classical music of India, via Friends of Indian Music and Dance website, Oct. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hindustani music, one of the two principal types of South Asian classical music, found mainly in the northern three-fourths of the subcontinent ... Northern India shares with the south the use of ragas (melodic frameworks for improvisation and composition), the rhythmic principles of tala (cyclic metric patterns sometimes of great complexity), and the practice of nonmetric, rhythmically \"free\" improvisation. Although vocal music plays an important role, instrumental music is more important in Hindustani music than it is in Karnatak; there are some purely instrumental forms, such as the theme with variations known as gat.)"}, "madsrdf:citationSource": "Encyc. Britannica online, Oct. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Classical music of north India [videorecording] : gat in raga pilu : tintal, sixteen-beat rhythmic cycle, 1969?", "madsrdf:citationStatus": "found"}, {"@id": "_:n641eb0ef0e02485089e8cecc3b345283b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gat [Hin.]. (1) A Hindustani composition for melodic instruments. The rhythmic pattern for a gat in a slow meter of 16 beats (vilambit t\u012bnt\u0101l) is fixed and begins on the 12th beat. (2) A type of rhythmic composition for tabl\u0101)"}, "madsrdf:citationSource": "The new Harvard dict. of music, 1986", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026832"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026833", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGavottes (Music)", "identifiers:lccn": "gf2014026833", "madsrdf:adminMetadata": [{"@id": "_:n0b473756e2634e18a4d697a244b389b9b1"}, {"@id": "_:n0b473756e2634e18a4d697a244b389b9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gavottes (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0b473756e2634e18a4d697a244b389b9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:n0b473756e2634e18a4d697a244b389b9b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0b473756e2634e18a4d697a244b389b9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0b473756e2634e18a4d697a244b389b9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n0b473756e2634e18a4d697a244b389b9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gavottes (Music)"}}, {"@id": "_:n0b473756e2634e18a4d697a244b389b9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gavotte [Fr., Ent., Ger; It. gavotta; Sp. gavota]. A gracious Baroque dance movement in duple meter)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026833"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026834", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGhettotech (Music)", "identifiers:lccn": "gf2014026834", "madsrdf:adminMetadata": [{"@id": "_:nc840efa58aea4e04b32a75a113534699b1"}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ghettotech (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc840efa58aea4e04b32a75a113534699b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153"}, "madsrdf:hasSource": [{"@id": "_:nc840efa58aea4e04b32a75a113534699b5"}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b6"}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b7"}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b8"}], "madsrdf:hasVariant": [{"@id": "_:nc840efa58aea4e04b32a75a113534699b9"}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-07-13T13:04:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "revised"}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghettotech (Music)"}}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ghettotech is a hybrid form of Miami bass, Chicago ghetto tracks and Detroit electro all cut and pasted together with battle DJ techniques; although around for years in Detroit, this sound is just beginning to surface on the national and international dance music scenes; some of the main musicians of this genre include DJ Assault and DJ Godfather)"}, "madsrdf:citationSource": "Globaldarkness website, viewed Jan. 24, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: DJ Assault. Belle Isle tech [SR] 1977.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "OCLC #182519146: Mueler, G. Straight up Detroit shit: genre, authenticity, and appropriation in Detroit ghettotech, 2007 [Thesis (M.A.)--Popular Culture, BGSU]", "madsrdf:citationStatus": "found"}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ghettotech or Detroit club music is a form of electronic dance music originating from Detroit; it combines elements of Chicago's ghetto house with electro, hip hop, techno, and grafts from the perceived raunch of Miama Bass as the vocal stamp of the music; it is usually faster than most other dance music genres and features pornographic lyrics)"}, "madsrdf:citationSource": "Wikipedia, viewed Jan. 24, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc840efa58aea4e04b32a75a113534699b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Detroit club music"}}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Detroit club music"}}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc840efa58aea4e04b32a75a113534699b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ghetto tech (Music)"}}, {"@id": "_:nc840efa58aea4e04b32a75a113534699b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghetto tech (Music)"}}], "@id": "/authorities/genreForms/gf2014026834"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026835", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGiustiniane (Villanelle)", "identifiers:lccn": "gf2014026835", "madsrdf:adminMetadata": [{"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b1"}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Giustiniane (Villanelle)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027189"}, "madsrdf:hasSource": [{"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b5"}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b6"}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b7"}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b8"}], "madsrdf:hasVariant": {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Giustiniane (Villanelle)"}}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Giustiniana: 1. Setting of poetry by or in the style of Lorenzo Giustiniani; 4 of these, for 3 voices and in archaic style, found in Petrucci's Frottole libro sexto. 2. Late 16th-cent. comic subgenre of the villanella)"}, "madsrdf:citationSource": "New Harvard dict. music", "madsrdf:citationStatus": "found"}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Giustiniana (justiniana, vinitiana, viniziana): 1. In 15th and early 16th cent., setting of verses by, or ascribed to, the Italian patrician poet and statesman Leonardo Giustiniani; sometimes known as \"l'aere venetiano\" or \"vinitiana\"; normally in 3 parts, for solo voice with instrumental acc. 2. From about 1560, special type of villanella in which text refers to 3 old men still interested in sexual adventures but too aged to find them except in the arms of paid courtesans; plural: giustiniane)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 98706401: Croce, G. Canzonette, arie e giustiniane a 3 voci, 1996.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Justiniana; plural: Justiniane)"}, "madsrdf:citationSource": "MGG, 2., neubearbeitete Ausg.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Justiniane (Villanelle)"}}, {"@id": "_:n4567eaf364894ebf8e6773ca78dd70c6b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Justiniane (Villanelle)"}}], "@id": "/authorities/genreForms/gf2014026835"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026836", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGlitch music", "identifiers:lccn": "gf2014026836", "madsrdf:adminMetadata": [{"@id": "_:n2eeab53c40f74164a35e361b5632aa78b1"}, {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Glitch music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2eeab53c40f74164a35e361b5632aa78b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026952"}, "madsrdf:hasSource": [{"@id": "_:n2eeab53c40f74164a35e361b5632aa78b5"}, {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b6"}, {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b7"}], "madsrdf:hasVariant": {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Glitch music"}}, {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glitch is a term used to describe a genre of experimental electronic music that emerged in the mid to late 1990s; Glitch is characterized by a preoccupation with the sonic artifacts that can result from malfunctioning digital technology, such as those produced by bugs, crashes, system errors, hardware noise, CD skipping, and digital distortion; scratched vinyl records, circuit bending, and other noise-like distortions figure prominently into the creation of rhythm and feeling in glitch)"}, "madsrdf:citationSource": "Wikipedia, Oct. 30, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glitch; as computer-aided composition slowly eclipsed the traditional analog approach to crafting electronica, the palette of possible sounds soon widened immensely, resulting in the advent of the glitch style in the late '90s; first championed by the ideological German techno figure Achim Szepanski; it wasn't long before the glitch aesthetic began being crossbred with existing genres)"}, "madsrdf:citationSource": "670 AllMusic, viewed July 18, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 5-6 (glitch music, an electroacoustic sub-genre; electroacoustic music constructed from sonorities signifying error, especially sounds produced by malfunctioning devices, or corrupted files) p. 23 (Glitches are source from audio devices, e.g. a purposely defaced, skipping, or fast-forwarded CD, the back-tracking lead in groove of a vinyl record, and many difficult-to-identify electronic hiccups. Glitch can also derive from any sampled sound, sliced into fragments, filtered with software like Buzz, and redistributed as gesture or percussive accent) p. 24 (Another term used for glitch music is microsound, but there is a subtle difference: microsound tends to be a product of the university-based and research-oriented composer)"}, "madsrdf:citationSource": "Work cat.: 2008423124: Gard, S. Nasty noises, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2eeab53c40f74164a35e361b5632aa78b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Microsound (Music)"}}, {"@id": "_:n2eeab53c40f74164a35e361b5632aa78b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Microsound (Music)"}}], "@id": "/authorities/genreForms/gf2014026836"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026837", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGo-go (Music)", "identifiers:lccn": "gf2014026837", "madsrdf:adminMetadata": [{"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b1"}, {"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Go-go (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027037"}, "madsrdf:hasSource": [{"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b5"}, {"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b6"}, {"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Go-go (Music)"}}, {"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Enc. of popular music, 2002;Guinness encyc. of popular music, 1992;Virgin encyc. of popular music, 2002;Rap music in the 1980s, 1992;Rolling stone encyc. of rock & roll, 2001;New Grove dict. of American music, c1986", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: The music district, c1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd07dd4543e344163b1cedf8f04a5aa39b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Go-go; bass-heavy, funky variation of hip-hop that was designed for house parties; during the mid-80s, go-go was quite popular within the rap and r&b underground particularly around the DC area where it originated; included in list of rap styles)"}, "madsrdf:citationSource": "All media guide WWW Home page, Nov. 22, 2002", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026837"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026838", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGoigs", "identifiers:lccn": "gf2014026838", "madsrdf:adminMetadata": [{"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b1"}, {"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Goigs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026872"}], "madsrdf:hasSource": {"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b5"}, "madsrdf:hasVariant": {"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Goigs"}}, {"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online, viewed May 29, 2014 : under Spain II: Traditional and popular music (the goigs (in Catalan) or gozos, which praise the life, the miracles and celestial ascension of the Virgin Mary or the local patron saint... the melodies generally use the giusto syllabic metric-rhythmic pattern (except in new compositions) and are often sung in heterophony of parallel 3rds)", "madsrdf:citationStatus": "found"}, {"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gozos"}}, {"@id": "_:n7d2c28bf6a0845b8b75c9d3faa1be245b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gozos"}}], "@id": "/authorities/genreForms/gf2014026838"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026839", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGospel music", "identifiers:lccn": "gf2014026839", "madsrdf:adminMetadata": [{"@id": "_:nfb950dd1d25a478db10e4c2980318547b1"}, {"@id": "_:nfb950dd1d25a478db10e4c2980318547b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gospel music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfb950dd1d25a478db10e4c2980318547b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026811"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026728"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026738"}], "madsrdf:hasSource": {"@id": "_:nfb950dd1d25a478db10e4c2980318547b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfb950dd1d25a478db10e4c2980318547b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nfb950dd1d25a478db10e4c2980318547b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfb950dd1d25a478db10e4c2980318547b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gospel music"}}, {"@id": "_:nfb950dd1d25a478db10e4c2980318547b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "American religious song with texts that reflect aspects of the personal religious experience of Protestant evangelical groups, both white and African-American."}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, June 2, 2005:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026839"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026840", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGothic rock music", "identifiers:lccn": "gf2014026840", "madsrdf:adminMetadata": [{"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db1"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gothic rock music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026632"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026759"}, "madsrdf:hasSource": [{"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db5"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db6"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db7"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db8"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db9"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db10"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db11"}], "madsrdf:hasVariant": {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gothic rock music"}}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gothic Rock)"}, "madsrdf:citationSource": "Wicke, P. Handbuch der popul\u00e4ren Musik", "madsrdf:citationStatus": "found"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db6", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Dec. 30, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(goth rock: offshoot of post-punk that existed primarily during the early to mid-'80s. Its reputation as the darkest and gloomiest form of underground rock is largely deserved, though today that reputation stems more from the visual theatricality of its bands and black-clad followers. Sonically, goth rock took the cold synthesizers and processed guitars of post-punk and used them to construct foreboding, sorrowful, often epic soundscapes. Early on, its lyrics were usually introspective and intensely personal, but its poetic sensibilities soon led to a taste for literary romanticism, morbidity, religious symbolism, and/or supernatural mysticism. By the end of the '80s, the original goth-rock movement had ceased to exist, but the music mutated into new forms and continued to influence many of rock's darker subgenres. During the '90s, the goth sound began to cross-pollinate with industrial music, producing hybrids that appealed to both sides, as well as the darkwave subgenre (which also incorporated '80s synth-pop and dream-pop))"}, "madsrdf:citationSource": "All music guide WWW site, Dec. 30, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gothic rock: angst-driven rock style of the 1980s and 1990s; x-ref. from Goth rock)"}, "madsrdf:citationSource": "White, D. Dict. pop. mus. styles world", "madsrdf:citationStatus": "found"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(gothic: genre of heavy rock music of the 1980s and 1990s, descended from punk rock, which is characterized by unfailing pessimism and the wearing of black clothes)"}, "madsrdf:citationSource": "Pickering, D. Cassell companion to 20th-century music", "madsrdf:citationStatus": "found"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(goth/gothic rock: musical genre and associated subcultural style)"}, "madsrdf:citationSource": "Shuker, R. Key concepts in popular music", "madsrdf:citationStatus": "found"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2002501398: Gothic, c2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Goth rock music"}}, {"@id": "_:n867a2ad44d4947c18f5ba100cb538f5db13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Goth rock music"}}], "@id": "/authorities/genreForms/gf2014026840"}
