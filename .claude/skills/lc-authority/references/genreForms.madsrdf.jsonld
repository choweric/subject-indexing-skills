{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026099", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFacsimiles", "identifiers:lccn": "gf2014026099", "madsrdf:adminMetadata": [{"@id": "_:nf788fb49dd6947319a7b19937e271a85b1"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Facsimiles"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf788fb49dd6947319a7b19937e271a85b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026084"}, "madsrdf:hasSource": [{"@id": "_:nf788fb49dd6947319a7b19937e271a85b5"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b6"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b7"}], "madsrdf:hasVariant": [{"@id": "_:nf788fb49dd6947319a7b19937e271a85b8"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b11"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b14"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b17"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b20"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-03-03T07:38:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Facsimiles"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 44 (facsimile (edition): exact copy, reproduction) p. 88 (xerocopy: photocopy)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Facsimile. 1) A reproduction simulating the physical appearance of the original in addition to reproducing its content exactly. 2) An illustrative content consisting of an exact copy of an original, usually in the same dimensions as the original, especially of books, documents, prints, and drawings. Today often reproduced photographically or digitally; in the past, reproduced by engraving or other printmaking process.)"}, "madsrdf:citationSource": "RDA glossary, viewed July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(facsimile: A reproduction or copy intended to simulate as closely as possible the physical appearance of a previous work, but not intended as a forgery. A facsimile of a handwritten or printed document is an exact replica of the original text, without reduction or enlargement. A facsimile edition duplicates as closely as possible the appearance and content of the original edition.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 18, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf788fb49dd6947319a7b19937e271a85b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Xerocopies"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Xerocopies"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf788fb49dd6947319a7b19937e271a85b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Replicas"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Replicas"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf788fb49dd6947319a7b19937e271a85b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Facsimile editions"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Facsimile editions"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf788fb49dd6947319a7b19937e271a85b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Photocopies"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Photocopies"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf788fb49dd6947319a7b19937e271a85b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reproductions (Facsimiles)"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reproductions (Facsimiles)"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf788fb49dd6947319a7b19937e271a85b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Facsimile copies"}}, {"@id": "_:nf788fb49dd6947319a7b19937e271a85b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Facsimile copies"}}], "@id": "/authorities/genreForms/gf2014026099"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026100", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFamily histories", "identifiers:lccn": "gf2014026100", "madsrdf:adminMetadata": [{"@id": "_:n8526ea708e2b404faae128cb4302caa3b1"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Family histories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8526ea708e2b404faae128cb4302caa3b3"}]}, "madsrdf:exampleNote": "Note under [Genealogical tables]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasSource": [{"@id": "_:n8526ea708e2b404faae128cb4302caa3b5"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b6"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b7"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b8"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b9"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b10"}], "madsrdf:hasVariant": [{"@id": "_:n8526ea708e2b404faae128cb4302caa3b11"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b14"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b17"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b20"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Narrative studies of families and the tracing of their lineages and histories. For lineages of people, or purebred animals in tabular or diagrammatic form see [Genealogical tables.]"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:25:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Family histories"}}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Family histories. Use for narrative family histories. For family trees and other genealogical listings of family members, use \"Genealogies.\" BT Historical works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(family history. The exploration of documentary sources by which to establish and prove the relationships set out in a pedigree (in earlier times usually for legal purposes), the later development of the writing of family history, and more recently the relating of that history to the social and economic history of the time, has been a slow process over a long period.)"}, "madsrdf:citationSource": "The Oxford companion to local and family history, 1996", "madsrdf:citationStatus": "found"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(genealogy plural genealogies 1: an account of the descent of a person, family, or group from an ancestor or from older forms. 2: regular descent of a person, family, or group of organisms from a progenitor or older form : pedigree. 3: the study of family pedigrees. 4: an account of the origin and historical development of something)"}, "madsrdf:citationSource": "Merriam-Webster online, Sept. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(genealogy: The study of the descent from a common ancestor (or ancestors) of a specific individual, family, or group of persons. Also refers to an enumeration of ancestors and their descendants in natural order of succession, usually in the form of a family tree.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Sept. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(genealogies (histories). Accounts or histories of the descent of persons, families, or other groups, from an ancestor or ancestors; enumerations of ancestors and their descendants in the natural order of succession. BT histories (literature genre). NT genealogical tables; pedigrees)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Sept. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Many, including the Society of Genealogists, use the terms genealogy and family history interchangeably. However there are slight differences in definition. Genealogy: Establishment of a Pedigree by extracting evidence, from valid sources, of how one generation is connected to the next. (In essence, this means the discipline of the construction of a valid family tree). Family History: A biographical study of a genealogically proven family and of the community and country in which they lived. (In essence, this means the writing of a biography of a series of related ancestors of common genealogy. Family History incorporates Genealogy))"}, "madsrdf:citationSource": [{"@id": "http://www.sog.org.uk/learn/education-sub-page-for-testing-navigation/guide-ten"}, "Genealogy or family history? What's the difference?, via Society of Genealogists website, Sept. 8, 2014"], "madsrdf:citationStatus": "found"}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8526ea708e2b404faae128cb4302caa3b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Genealogical histories"}}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Genealogical histories"}}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8526ea708e2b404faae128cb4302caa3b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Histories, Genealogical"}}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Histories, Genealogical"}}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8526ea708e2b404faae128cb4302caa3b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Narrative family histories"}}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Narrative family histories"}}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8526ea708e2b404faae128cb4302caa3b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Genealogies (Histories)"}}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Genealogies (Histories)"}}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8526ea708e2b404faae128cb4302caa3b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Histories, Family"}}, {"@id": "_:n8526ea708e2b404faae128cb4302caa3b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Histories, Family"}}], "@id": "/authorities/genreForms/gf2014026100"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026101", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFAQs", "identifiers:lccn": "gf2014026101", "madsrdf:adminMetadata": [{"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb1"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "FAQs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}], "madsrdf:hasSource": [{"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb5"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb6"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb7"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb8"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb9"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb10"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb11"}], "madsrdf:hasVariant": [{"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb12"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb15"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb18"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb21"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb24"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Lists of questions and answers relating to a particular subject."}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:24:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "FAQs"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Q&As)"}, "madsrdf:citationSource": "Official questions and answers (Q&A's) Disadvantaged Business Enterprise program regulation (49 CFR 26), via United States Department of Transportation website, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Frequently asked questions, abbreviated to FAQ, are listed questions and answers, all supposed to be commonly asked in some context, and pertaining to a particular topic. Depending on usage, the term may refer specifically to a single frequently asked question, or to an assembled list of many questions and their answers; FAQs; While the name may be recent, the FAQ format itself is quite old. For instance, Matthew Hopkins wrote The Discovery of Witches in 1647 as a list of questions and answers, introduced as \"Certaine Queries answered\". Many old catechisms are in a question-and-answer (Q&A) format.)"}, "madsrdf:citationSource": "Wikipedia, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Questions and answers. Use for works consisting primarily of a series of questions and answers. BT Discoursive works. RT Catechisms)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(FAQ: a document (as on a Web site) that provides answers to a list of typical questions that users might ask regarding a particular subject <check the FAQ>; also : a question included in such a document <a list of FAQs>)"}, "madsrdf:citationSource": "Merriam-Webster online, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(FAQ: Frequently Asked Questions, a text file available online or in print, containing answers to commonly asked questions about a specific topic, that may serve as a mini-help file for inexperienced users of a computer system or software program. Usually maintained by one or more persons who have an active interest in the subject.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Question-and-Answer documents (Q&As) on a variety of special education topics; Q&A documents)"}, "madsrdf:citationSource": "Compliance and Assistance Q and As, via Minnesota Department of Education website, July 30, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Q & A's for small business employers, via Occupational Safety & Health Administration website, July 30, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Answers and questions"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Answers and questions"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Q & As"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Q & As"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Q and As"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Q and As"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Questions and answers"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Questions and answers"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Q&As"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Q&As"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Frequently asked questions"}}, {"@id": "_:n19ce182e87d740c0ac3dbbcb659afa8eb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Frequently asked questions"}}], "@id": "/authorities/genreForms/gf2014026101"}
