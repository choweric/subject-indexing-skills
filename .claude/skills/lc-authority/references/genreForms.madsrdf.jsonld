@language": "en", "@value": "Autobiographical television programs"}}, {"@id": "_:nfbdcb0e0a312442bb2550a2cd3c4abe0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 29 (Autobiographical films and video: a personal/independent work about a living person's life or an incident in his life, made by the person himself)"}, "madsrdf:citationSource": "Yee, M. M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfbdcb0e0a312442bb2550a2cd3c4abe0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Autobiographical: work using the filmmaker as subject)"}, "madsrdf:citationSource": "Moving image genre-form guide online, November 19, 2007:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026065"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026066", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAviation films", "identifiers:lccn": "gf2011026066", "madsrdf:adminMetadata": [{"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b1"}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Aviation films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b5"}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b6"}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b7"}], "madsrdf:hasVariant": [{"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b8"}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b11"}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025281"}}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-04T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-23T16:10:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Aviation films"}}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Flight of the Phoenix, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Aviation: Fictional work centering on both military and civilian characters who have an overriding love of flying, with an ardent dedication to such tasks as the air mail, test flying, or airplane racing. Flying becomes the guiding force in all aspects of their career and personal life, even at the cost of loss of romantic love, or probable death in a plane crash)"}, "madsrdf:citationSource": "Moving image genre-form guide online, March 28, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Aviation film (Air movie, Airplane film, Flying film): Aircraft have figured in countless pictures, but it is when flying, flyers, or the aircraft itself is at the center of the story that we can speak of the aviation film proper)"}, "madsrdf:citationSource": "Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Airplane films"}}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Airplane films"}}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Flying films"}}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Flying films"}}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Air movies"}}, {"@id": "_:ndb966aa87dd8487ea552a227c906cdd8b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Air movies"}}], "@id": "/authorities/genreForms/gf2011026066"}
