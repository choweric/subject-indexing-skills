{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026365", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLinguistic atlases", "identifiers:lccn": "gf2011026365", "madsrdf:adminMetadata": [{"@id": "_:n91df9621db564f34978391aca0531ec4b1"}, {"@id": "_:n91df9621db564f34978391aca0531ec4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Linguistic atlases"}, "madsrdf:elementList": {"@list": [{"@id": "_:n91df9621db564f34978391aca0531ec4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026058"}, "madsrdf:hasSource": [{"@id": "_:n91df9621db564f34978391aca0531ec4b5"}, {"@id": "_:n91df9621db564f34978391aca0531ec4b6"}, {"@id": "_:n91df9621db564f34978391aca0531ec4b7"}], "madsrdf:hasVariant": {"@id": "_:n91df9621db564f34978391aca0531ec4b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2010025025"}}, {"@id": "_:n91df9621db564f34978391aca0531ec4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T12:53:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n91df9621db564f34978391aca0531ec4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n91df9621db564f34978391aca0531ec4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Linguistic atlases"}}, {"@id": "_:n91df9621db564f34978391aca0531ec4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "linguistic atlas (Collections of maps which plot the geographical distribution of individual linguistic items (e.g. pronunciation features, grammatical inflections, words), and the location of ISOGLOSSes, or languages in multilingual societies)"}, "madsrdf:citationSource": "Dictionary of sociolinguistics, 2004 via Credo reference, March 26, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n91df9621db564f34978391aca0531ec4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "article on linguistics (Dialect atlases are compiled on the basis of investigations of the dialects of a large number of places; a questionnaire provides uniform data; the first large-scale enterprise in linguistic geography was the preparation of the German linguistic atlas, which was begun in the 1880s; the famous French linguistic atlas of Jules Gilli\u00e9ron and Edmond Edmont was published in fascicles from 1902 to 1912 and furnished both a strong stimulus and the basic model for work on linguistic atlases elsewhere in the world; one of the most significant contributions is the linguistic atlas of Italy and southern Switzerland by Karl Jaberg and Jakob Jud; it appeared from 1928 to 1940; dialects of virtually all European languages have been treated in linguistic geography studies; in some countries, data are still being collected and classified and maps are being drawn, but in others a second generation of atlases is already under way)"}, "madsrdf:citationSource": "Britannica online, March 26, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n91df9621db564f34978391aca0531ec4b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cartographic materials, 2002, 2005 update;Form/genre for cartographic materials [draft of LC working group], 1996.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n91df9621db564f34978391aca0531ec4b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n91df9621db564f34978391aca0531ec4b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dialect atlases"}}, {"@id": "_:n91df9621db564f34978391aca0531ec4b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dialect atlases"}}], "@id": "/authorities/genreForms/gf2011026365"}
