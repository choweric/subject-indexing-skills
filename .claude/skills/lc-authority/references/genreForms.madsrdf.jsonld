{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026615", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aA'ak", "identifiers:lccn": "gf2014026615", "madsrdf:adminMetadata": [{"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb1"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "A'ak"}, "madsrdf:elementList": {"@list": [{"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb5"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb6"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb7"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb8"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb9"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb10"}], "madsrdf:hasVariant": [{"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb11"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb14"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-28T13:05:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "revised"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "A'ak"}}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "volume 7, page 861-863 (Aak; Korean pronunciation of two Chinese characters that are pronounced yayue in Chinese and gagaku in Japan, meaning approximately \"elegant music\"; Korean aak is taken from and still retains the melodies of twelfth-century yayue of the Chinese Song dynasty; in traditional royal Korea, played almost exclusively in state sacrificial rites; considered a special type of court music; entire modern repertoire consists of only two melodies)"}, "madsrdf:citationSource": "Garland encyclopedia of world music, 2001:", "madsrdf:citationStatus": "found"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 13 (the general meaning of \"ak\" incorporates instrumental music, song, and dance; according to Confucian music theory, these three factors are required in order to complete \"ak\")"}, "madsrdf:citationSource": "Song, Ji-won. Jongmyo jeryeak, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Korea (aak; Chinese ritual music that came to Korea in 1116; originally performed in a number of formal court ceremonies; stately, rarified music performed by two alternating ensembles of special wind and percussion instruments of Chinese origin)"}, "madsrdf:citationSource": "Grove music online, viewed March 12, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "introd. (Jongmyo jeryeak refers to the \"ak\", or ritual music (including instrumental music, song, and dance) performed at the Jongmyo Shrine, where memorial tablets for the kings and queens of the Joseon Dynasty are enshrined)"}, "madsrdf:citationSource": "Song, Ji-won. Jongmyo jeryeak : the royal ancestral shrine ritual music of Korea:", "madsrdf:citationStatus": "found"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (early sources for Korean ritual music) pref. (\"a bibliographic reference work on sources for ... one important genre of court ceremonial music: aak\")"}, "madsrdf:citationSource": "Work cat.: Provine, R. Essays on Sino-Korean musicology, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 10, p. 201-202 (Korea, 6. Court music. Aak)"}, "madsrdf:citationSource": "New Grove:", "madsrdf:citationStatus": "found"}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ak"}}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ak"}}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chongmyo cheryeak"}}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chongmyo cheryeak"}}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jongmyo jeryeak"}}, {"@id": "_:n719c1989f3134687abb0f8ffbddbf9bcb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jongmyo jeryeak"}}], "@id": "/authorities/genreForms/gf2014026615"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026616", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aAcclamations (Music)", "identifiers:lccn": "gf2014026616", "madsrdf:adminMetadata": [{"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b1"}, {"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Acclamations (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, "madsrdf:hasSource": [{"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b5"}, {"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b6"}, {"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Acclamations (Music)"}}, {"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2007562247: Miller, A.D. Gospel acclamations, c2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acclamation; musical salutation addressed to the Byzantine emperor, his family, the Patriarch, and other dignitaries of church or state)"}, "madsrdf:citationSource": "New Harvard dict. of music, 1986", "madsrdf:citationStatus": "found"}, {"@id": "_:nedfa43bbbfbf4d0abfc752af112bf4b6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Acclamation; corporate shout or public cry of affirmation or assent; common to many political & religious rituals of East & West; some evolved into standard formulae with fixed text & Evently set music; important to medieval Christian worship, especially during Papal coronations; since Second Vatican Council acclamation has become a technical term in the Roman rite & also in some Protestant rituals for specific worship elements)"}, "madsrdf:citationSource": "Grove music online, Nov. 8, 2007", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026616"}
