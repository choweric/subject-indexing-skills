{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026411", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLiederspiels", "identifiers:lccn": "gf2014026411", "madsrdf:adminMetadata": [{"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb1"}, {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Liederspiels"}, "madsrdf:elementList": {"@list": [{"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb5"}, {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb6"}, {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb7"}], "madsrdf:hasVariant": {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Early 19th century dramas in which existing lyrics were set to new music and inserted into a play."}, {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:34:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Liederspiels"}}, {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Liederspiel. Literally 'song-play'. Early 19th century genre in which existing lyrics, often well-known, were set to new music and inserted into a spoken play.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 5, 2012 List of Opera Genres", "madsrdf:citationStatus": "found"}, {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Cuddon, J.A. A dict. of literary terms and literary theory, 1998;The Oxford companion to the theatre, 1983;Baldick, C. The Oxford dict. of literary terms, 2008;Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Liederspiel)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Liederspiele"}}, {"@id": "_:n79d5a2c548ef4dfb80b0c595bca1028eb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Liederspiele"}}], "@id": "/authorities/genreForms/gf2014026411"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026412", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLimericks", "identifiers:lccn": "gf2014026412", "madsrdf:adminMetadata": [{"@id": "_:nf3a4fa4e4909458ead04a574588e23d4b1"}, {"@id": "_:nf3a4fa4e4909458ead04a574588e23d4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Limericks"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf3a4fa4e4909458ead04a574588e23d4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379"}, "madsrdf:hasSource": [{"@id": "_:nf3a4fa4e4909458ead04a574588e23d4b5"}, {"@id": "_:nf3a4fa4e4909458ead04a574588e23d4b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Humorous poems consisting of five lines with an aabba rhyme scheme, the third and fourth lines having two stresses and the others three."}, {"@id": "_:nf3a4fa4e4909458ead04a574588e23d4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf3a4fa4e4909458ead04a574588e23d4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:09:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf3a4fa4e4909458ead04a574588e23d4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Limericks"}}, {"@id": "_:nf3a4fa4e4909458ead04a574588e23d4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Limerick: a type of nonsense verse with a definite pattern: five-line stanza rhyming aabba in which lines one, two, and five have three anapestic feet and lines three and four have two anapestic feet)"}, "madsrdf:citationSource": "Morner, K. NTC's dictionary of literary terms, c1991", "madsrdf:citationStatus": "found"}, {"@id": "_:nf3a4fa4e4909458ead04a574588e23d4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Limerick: an English verse form consisting of five anapaestic lines rhyming aabba, the third and fourth lines having two stresses and the others three; the limerick is almost always a self-contained, humorous poem, and usually plays on rhymes involving the names of people or places.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026412"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026413", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLinked verse", "identifiers:lccn": "gf2014026413", "madsrdf:adminMetadata": [{"@id": "_:n8ac3dca83a724a91a449288ec946dccdb1"}, {"@id": "_:n8ac3dca83a724a91a449288ec946dccdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Linked verse"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8ac3dca83a724a91a449288ec946dccdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026504"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026505"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026506"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026507"}], "madsrdf:hasSource": [{"@id": "_:n8ac3dca83a724a91a449288ec946dccdb5"}, {"@id": "_:n8ac3dca83a724a91a449288ec946dccdb6"}], "madsrdf:hasVariant": {"@id": "_:n8ac3dca83a724a91a449288ec946dccdb7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry in which multiple authors take turns composing lines or stanzas."}, {"@id": "_:n8ac3dca83a724a91a449288ec946dccdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:10:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8ac3dca83a724a91a449288ec946dccdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8ac3dca83a724a91a449288ec946dccdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Linked verse"}}, {"@id": "_:n8ac3dca83a724a91a449288ec946dccdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(linked poetry or linked verse; Usually linked poetry is written by two or more poets working together to create one poetical work. All types involve one or more methods of connecting one part to another, or \"linking\". They also have in common the ideal of including as much of the range of experience as possible. To do this, poets avoid any narrative plot or repetition of images, ideas, or themes; avoiding such things is called \"shifting\". Most of the rules of linked poetry have to do with linking and shifting; There are three main types of linked poetry: 1. renga 2. renku 3. renshi; Sometimes the word renga has been used in English in a generic sense to refer to a wide variety of linked poetry; linked poetry might be better for such general use instead; In all linked poetry based on Japanese styles of linked poems, a major goal is to shift, to move from one topic to another quickly and easily, like the best party conversation, never dwelling on the same subject or mood for more than one or two stanzas. Linked verse poets take pains to avoid repeating material that has already appeared earlier in the poem or sequence; the basic ideas in all this kind of poetry are to work collaboratively with other poets, and to link your contribution to that immediately before, but to shift away from repetition of anything that has already appeared in the work)"}, "madsrdf:citationSource": "Higginson, W.J. What is linked poetry?, via WWW, July 21 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ac3dca83a724a91a449288ec946dccdb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(linked verse: a poetry game of the Chinese T'ang Dynasty played in an impromptu round-robin fashion. After agreeing upon subject and meter, each poet takes a turn at improvising lines toward creating a group poem)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ac3dca83a724a91a449288ec946dccdb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8ac3dca83a724a91a449288ec946dccdb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Linked poetry"}}, {"@id": "_:n8ac3dca83a724a91a449288ec946dccdb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Linked poetry"}}], "@id": "/authorities/genreForms/gf2014026413"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026414", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLiras", "identifiers:lccn": "gf2014026414", "madsrdf:adminMetadata": [{"@id": "_:n9edc00881ada49b49720b429cc5dae26b1"}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Liras"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9edc00881ada49b49720b429cc5dae26b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n9edc00881ada49b49720b429cc5dae26b5"}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b6"}], "madsrdf:hasVariant": [{"@id": "_:n9edc00881ada49b49720b429cc5dae26b7"}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b10"}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b13"}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b16"}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b19"}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Spanish poems with five-line stanzas consisting of lines of seven and eleven syllables and the rhyme scheme ababb."}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:10:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Liras"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lira. A Sp. stanza form of four, five, six, or rarely, more than six Italianate hendecasyllables and heptasyllables, the term denoting loosely any short-strophe canci\u00f3n in Italianate verse; this form is sometimes designated the lira garcilasiana and has also come to be known as estrofa de Fray Luis de Le\u00f3n, lira de Fray Luis de Le\u00f3n, and quintilla de Luis de Le\u00f3n for being popularized through Fray Luis de Le\u00f3n's works)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lira. A five-line Spanish stanza form combining seven-syllable and eleven-syllable lines in the order 7.11.7.7.11, with the standard rhyme scheme ababb.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9edc00881ada49b49720b429cc5dae26b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Estrofas de Fray Luis de Le\u00f3n"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Estrofas de Fray Luis de Le\u00f3n"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9edc00881ada49b49720b429cc5dae26b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Liras garcilasianas"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Liras garcilasianas"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9edc00881ada49b49720b429cc5dae26b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quintillas de Luis de Le\u00f3n"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quintillas de Luis de Le\u00f3n"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9edc00881ada49b49720b429cc5dae26b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Luis de Le\u00f3n quintillas"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Luis de Le\u00f3n quintillas"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9edc00881ada49b49720b429cc5dae26b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fray Luis de Le\u00f3n estrofas"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fray Luis de Le\u00f3n estrofas"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9edc00881ada49b49720b429cc5dae26b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Liras de Fray Luis de Le\u00f3n"}}, {"@id": "_:n9edc00881ada49b49720b429cc5dae26b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Liras de Fray Luis de Le\u00f3n"}}], "@id": "/authorities/genreForms/gf2014026414"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLiterature", "identifiers:lccn": "gf2014026415", "madsrdf:adminMetadata": [{"@id": "_:nc6594bdaa71446548430464fe667bce9b1"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Literature"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc6594bdaa71446548430464fe667bce9b3"}]}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026239"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026242"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026248"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026252"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026274"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026285"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026291"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026323"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026342"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026365"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026389"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026433"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026470"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026498"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026517"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026522"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026525"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026002"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026072"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026049"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026101"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026109"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2021026028"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026045"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026018"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026031"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026086"}], "madsrdf:hasSource": [{"@id": "_:nc6594bdaa71446548430464fe667bce9b5"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b6"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b7"}], "madsrdf:hasVariant": [{"@id": "_:nc6594bdaa71446548430464fe667bce9b8"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b11"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b14"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b17"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b20"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-03-08T09:05:06"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ncu"}, "ri:recordStatus": "revised"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Literature"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Literature: a body of written works. The name has traditionally been applied to those imaginative works of poetry and prose distinguished by the intentions of their authors and the perceived aesthetic excellence of their execution)"}, "madsrdf:citationSource": "Britannica online, Jan. 23, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Literature. UF Belles-lettres.)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "literature (literature, n. 3a. The result or product of literary activity; written works considered collectively; a body of literary works produced in a particular country or period, or of a particular genre. 3b. Without defining word: written work valued for superior or lasting artistic merit) literary (adj., 1. Of or relating to the writing, study, or content of literature, esp. of the kind valued for quality of form; of the nature of literature) belles-lettres (n., elegant or polite literature or literary studies. A vaguely-used term, formerly taken sometimes in the wide sense of 'the humanities,' liter\u00e6 humaniores; sometimes in the exact sense in which we now use 'literature'; in the latter use it has come down to the present time, but it is now generally applied (when used at all) to the lighter branches of literature or the \u00e6sthetics of literary study) creative writing (n., writing which displays imagination or invention (sometimes differentiated from academic, journalistic, or other forms of writing which are more constrained in style or scope); also freq. (orig. U.S.) as a subject of study) anthology (1. A collection of the flowers of verse, i.e. small choice poems, esp. epigrams, by various authors; originally applied to the Greek collections so called. 2. Extended to other literary collections)"}, "madsrdf:citationSource": "OED online, Oct. 20, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc6594bdaa71446548430464fe667bce9b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Collections, Literary"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Collections, Literary"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc6594bdaa71446548430464fe667bce9b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Literary collections"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Literary collections"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc6594bdaa71446548430464fe667bce9b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Creative writing"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Creative writing"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc6594bdaa71446548430464fe667bce9b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Belles-lettres"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Belles-lettres"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc6594bdaa71446548430464fe667bce9b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Literary anthologies"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Literary anthologies"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc6594bdaa71446548430464fe667bce9b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Anthologies, Literary"}}, {"@id": "_:nc6594bdaa71446548430464fe667bce9b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Anthologies, Literary"}}], "@id": "/authorities/genreForms/gf2014026415"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026416", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLiturgical poetry", "identifiers:lccn": "gf2014026416", "madsrdf:adminMetadata": [{"@id": "_:nf029e9d204d441189ec8f5763c7149fcb1"}, {"@id": "_:nf029e9d204d441189ec8f5763c7149fcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Liturgical poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf029e9d204d441189ec8f5763c7149fcb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026503"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026234"}, "madsrdf:hasSource": [{"@id": "_:nf029e9d204d441189ec8f5763c7149fcb5"}, {"@id": "_:nf029e9d204d441189ec8f5763c7149fcb6"}, {"@id": "_:nf029e9d204d441189ec8f5763c7149fcb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems written for public worship."}, {"@id": "_:nf029e9d204d441189ec8f5763c7149fcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:35:28"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf029e9d204d441189ec8f5763c7149fcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf029e9d204d441189ec8f5763c7149fcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Liturgical poetry"}}, {"@id": "_:nf029e9d204d441189ec8f5763c7149fcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Latin poetry emerged in 4 AD most prominently as Liturgical verse, a Latin poetic alternative to the pagan classics. The poetry was most often developed from scripture and the tradition of the Catholic mass. Usually the verse was liturgical, publically interactive with lines for both cleric and congregation. Secular verse was thematic. The sub genres of liturgical verse are: antiphon, anthem, benison or blessing, canticle, charm, curse, dirge, evensong, hymn, imprecation, incantation, invocation, litany, matins or morning songs, nightsong, psalm, requiem, vespers.)"}, "madsrdf:citationSource": "Poetry connection, via WWW, viewed May 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nf029e9d204d441189ec8f5763c7149fcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Liturgical poetry: In the Western world, liturgical poetry has encompassed a vast array of oral and written texts, from the early Latin hymns of Prudentius to the Jewish piyyutim of Palestine and Cairo to the 12th century sequences of Hildegard of Bingen to the liturgical poetics of contemporary writers such as Patrick Prichett. Within many religious traditions, the liturgy consists in considerable part of poetry composed, arranged, and altered to suit the formal demands of ritual practices.)"}, "madsrdf:citationSource": "Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nf029e9d204d441189ec8f5763c7149fcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 354 (Many types of liturgical poems were written throughout the ages for occasions in the religious and national life of the people--prayers, holiday songs, litanies, elegies, etc.)"}, "madsrdf:citationSource": "The modern Hebrew poem itself, c2003:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026416"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026417", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLiving newspapers", "identifiers:lccn": "gf2014026417", "madsrdf:adminMetadata": [{"@id": "_:n3c2454794fed47d998d8dcfee3904c06b1"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Living newspapers"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3c2454794fed47d998d8dcfee3904c06b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n3c2454794fed47d998d8dcfee3904c06b5"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b6"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b7"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b8"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b9"}], "madsrdf:hasVariant": {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that dramatize current social and political issues, and are often intended as propaganda."}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:10:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Living newspapers"}}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Afanas\u02b9eva, A. Pionerskie zhivye gazety, 1928.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Living Newspaper. A form of political propaganda drama which uses topical material and journalistic techniques in the treatment of current social and political issues. It might also be described as a kind of documentary revue. Such plays are usually presented in a series of short scenes and they are often satirical.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "abstr. (The Soviet living newspaper, or zhivaia gazeta began during the Russian Civil War as a method to act out a pro-Soviet version of the news for mainly illiterate Red Army soldiers. During the 1920s, it evolved into an experimental form of agitprop theater that attracted the interest of foreigners, who hoped to develop new methods of political theater in their own countries.)"}, "madsrdf:citationSource": "Mally, L. The Americanization of the Soviet living newspaper, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Arent, A. Power : a living newspaper play, 1937.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Living newspaper. Episodic stage presentation, usually employed to dramatize news events or to instruct.)"}, "madsrdf:citationSource": "McGraw-Hill encyclopedia of world drama, c1972", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c2454794fed47d998d8dcfee3904c06b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Newspapers, Living"}}, {"@id": "_:n3c2454794fed47d998d8dcfee3904c06b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Newspapers, Living"}}], "@id": "/authorities/genreForms/gf2014026417"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026418", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLoas", "identifiers:lccn": "gf2014026418", "madsrdf:adminMetadata": [{"@id": "_:n069d7df32ed546ee9b586046d2778ce4b1"}, {"@id": "_:n069d7df32ed546ee9b586046d2778ce4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Loas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n069d7df32ed546ee9b586046d2778ce4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n069d7df32ed546ee9b586046d2778ce4b5"}, {"@id": "_:n069d7df32ed546ee9b586046d2778ce4b6"}, {"@id": "_:n069d7df32ed546ee9b586046d2778ce4b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short Spanish plays that are presented before longer plays in order to set the mood and capture the interest of the audience."}, {"@id": "_:n069d7df32ed546ee9b586046d2778ce4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n069d7df32ed546ee9b586046d2778ce4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:11:07"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n069d7df32ed546ee9b586046d2778ce4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Loas"}}, {"@id": "_:n069d7df32ed546ee9b586046d2778ce4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A loa is a short theatrical piece used to introduce a comedia in the Spanish Golden Age (Siglo de Oro) tradition for the purpose of setting the mood and capturing the interest of the audience.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n069d7df32ed546ee9b586046d2778ce4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The loa was a genre of the theatre that embraced both secular and religious themes in colonial Spanish America. While most loas preceded full-length plays by colonial, or more frequently, Peninsular playwrights, they rarely by the eighteenth century, served merely as an introduction to the larger piece. Rather, they were independent works of a panegyric nature)"}, "madsrdf:citationSource": "Cambridge history of Latin American literature, 1996", "madsrdf:citationStatus": "found"}, {"@id": "_:n069d7df32ed546ee9b586046d2778ce4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Loa started out as a religious prologue that evolved into a movement that spread out to secular drama in the form of short plays; known for lavishing praise on a wide variety of subjects; originally monologues, they developed into miniature plays to interest early arrivals)"}, "madsrdf:citationSource": "The Oxford companion to Spanish literature, 1978", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026418"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026419", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLove poetry", "identifiers:lccn": "gf2014026419", "madsrdf:adminMetadata": [{"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb1"}, {"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Love poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2016026004"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026040"}], "madsrdf:hasSource": [{"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb5"}, {"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb6"}], "madsrdf:hasVariant": {"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Love poetry"}}, {"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(love poetry; it is necessary to distinguish between erotic poetry and love poetry. Erotic poetry is about sex and sexual love; love poetry tends to avoid sexual details. Erotic poetry tends to concentrate on the more physical aspects of love and passion; while love poetry dwells more on the nobler manifestations of love, the 'higher' feelings.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Love poetry)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romance poetry"}}, {"@id": "_:n5ba0ecfc08414c669397fa1d01127c7eb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romance poetry"}}], "@id": "/authorities/genreForms/gf2014026419"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026420", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aL\u00fc shi", "identifiers:lccn": "gf2014026420", "madsrdf:adminMetadata": [{"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b1"}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "L\u00fc shi"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b5"}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b6"}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b7"}], "madsrdf:hasVariant": [{"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b8"}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b11"}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Chinese poems composed in the 7th-10th centuries that consist of eight lines of five, six, or seven syllables that display strict tonal patterns."}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:11:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "L\u00fc shi"}}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lushi or l\u00fcshi (Wade-Giles: l\u00fc-shih) refers a specific form of Classical Chinese poetry verse form. One of the most important poetry forms of Classical Chinese poetry, the lushi refers to an eight-line regulated verse form with lines made up of five, six, or seven characters; thus: Five-character eight-line regulated verse (wulu): a form of regulated verse with eight lines of five characters each. Six-character eight-line regulated verse is relatively rare. Seven-character eight-line regulated verse (qilu): a form of regulated verse with eight lines of seven characters each. All lushi forms are rhymed on the even lines, with one rhyme being used throughout the poem. Also, and definitionally, the tonal profile of the poem is controlled (that is, \"regulated\").)"}, "madsrdf:citationSource": "Poets Poetry Poems online, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(l\u00fcshi, Wade-Giles romanization l\u00fc-shih, a form of Chinese poetry that flourished in the Tang dynasty (618-907). It consists of eight lines of five or seven syllables, each line set down in accordance with strict tonal patterns.)"}, "madsrdf:citationSource": "Britannica Academic Edition online, Jan. 3, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(L\u00fc shi. UF L\u00fc shih)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "L\u00fcshi"}}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "L\u00fcshi"}}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "L\u00fcshih"}}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "L\u00fcshih"}}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "L\u00fc shih"}}, {"@id": "_:n2a560df16e8845a28ea1b40c9156ed82b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "L\u00fc shih"}}], "@id": "/authorities/genreForms/gf2014026420"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLyric poetry", "identifiers:lccn": "gf2014026422", "madsrdf:adminMetadata": [{"@id": "_:n43bbb250c097485d901b409dadce2a2ab1"}, {"@id": "_:n43bbb250c097485d901b409dadce2a2ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lyric poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n43bbb250c097485d901b409dadce2a2ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026298"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026307"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026431"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026461"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026477"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026495"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026545"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026549"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026004"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026020"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026040"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026005"}, "madsrdf:hasSource": [{"@id": "_:n43bbb250c097485d901b409dadce2a2ab5"}, {"@id": "_:n43bbb250c097485d901b409dadce2a2ab6"}, {"@id": "_:n43bbb250c097485d901b409dadce2a2ab7"}], "madsrdf:hasVariant": {"@id": "_:n43bbb250c097485d901b409dadce2a2ab8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Songlike poetry that is short, subjective, and personal in subject matter."}, {"@id": "_:n43bbb250c097485d901b409dadce2a2ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-04T13:41:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n43bbb250c097485d901b409dadce2a2ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n43bbb250c097485d901b409dadce2a2ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lyric poetry"}}, {"@id": "_:n43bbb250c097485d901b409dadce2a2ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lyric: originally, poetry meant to be sung, accompanied by music from the lyre or lute. the term now refers to a category of poetry (distinct from Narrative poem and Dramatic poetry) that is short in form, concentrated in its expression, subjective in its observations, personal in subject matter, and songlike in quality.)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n43bbb250c097485d901b409dadce2a2ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Pushkin, A.S. Collected narrative and lyrical poetry, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n43bbb250c097485d901b409dadce2a2ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lyric. A type of poetry in which the \"voice\" of the poem (not necessarily that of the poet) records a specific feeling or attitude. In its original form, the lyric was designed for musical accompaniment. As the term evolved, however, it came to embrace a wide range of different poetic forms including the sonnet, ode, elegy, and eclogue.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n43bbb250c097485d901b409dadce2a2ab8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n43bbb250c097485d901b409dadce2a2ab9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lyrical poetry"}}, {"@id": "_:n43bbb250c097485d901b409dadce2a2ab9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lyrical poetry"}}], "@id": "/authorities/genreForms/gf2014026422"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026423", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMacaronic verse", "identifiers:lccn": "gf2014026423", "madsrdf:adminMetadata": [{"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b1"}, {"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Macaronic verse"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b5"}, {"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b6"}], "madsrdf:hasVariant": {"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry that mixes two or more languages."}, {"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T10:18:24"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Macaronic verse"}}, {"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Macaronic Verse. Usually refers to the mixing of words, sometimes whole lines, of more than one lang. in a poem, most often for comic or satiric effect though sometimes (and more recently) with serious intent; macaronic poetry)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(macaronic verse. Poetry in which two or more languages are mixed together. Strictly, the term denotes a kind of comic verse in which words from a vernacular language are introduced into Latin (or other foreign-language) verses and given Latin inflections. More loosely, the term is applied to any verses in which phrases or lines in a foreign language are frequently introduced)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Macaronic poetry"}}, {"@id": "_:n5e6ce1396fd5489b93d9f6f0b5ed2947b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Macaronic poetry"}}], "@id": "/authorities/genreForms/gf2014026423"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026424", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMagic realist fiction", "identifiers:lccn": "gf2014026424", "madsrdf:adminMetadata": [{"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b1"}, {"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Magic realist fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b5"}, {"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b6"}], "madsrdf:hasVariant": {"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Modern fiction in which fantastic or mythical elements are included in a narrative that is otherwise realistic."}, {"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-05T15:48:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magic realist fiction"}}, {"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(magic realism: chiefly Latin-American narrative strategy that is characterized by the matter-of-fact inclusion of fantastic or mythical elements into seemingly realistic fiction)"}, "madsrdf:citationSource": "Britannica online academic edition, Nov. 15, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(magic realism: also magical realism; kind of modern fiction in which fabulous and fantastical events are included in a narrative that otherwise maintains the 'reliable' tone of objective realistic report; associated chiefly with certain leading novelists of Central and South America; term has also been extended to works from very different cultures, designating a tendency of the modern novel to reach beyond the confines of realism and draw upon the energies of fable, folktale and myth while retaining a strong contemporary social relevance)"}, "madsrdf:citationSource": "Oxford dictionary of literary terms, via Oxford reference online, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Magical realist fiction"}}, {"@id": "_:nc6a178a5ae614a9faedbc2a87ee55fd3b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Magical realist fiction"}}], "@id": "/authorities/genreForms/gf2014026424"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026425", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMaq\u0101m\u0101t", "identifiers:lccn": "gf2014026425", "madsrdf:adminMetadata": [{"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b1"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Maq\u0101m\u0101t"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026488"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026479"}, "madsrdf:hasSource": [{"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b5"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b6"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b7"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b8"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b9"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b10"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b11"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b12"}], "madsrdf:hasVariant": [{"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b13"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b16"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b19"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b22"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b25"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b28"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b31"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Medieval Arabic rhymed prose that was imitated in other semitic languages and Persian, and which generally featured picaresque themes."}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:13:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maq\u0101m\u0101t"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 5, pp. 161-164 (Ma\u1e33\u0101ma, a variety of Arabic prose of a highly elaborate and artificial nature; ma\u1e33\u0101m\u0101t; ma\u1e33\u0101mas; the ma\u1e33\u0101ma form; rhymed prose; also imitated in the literatures of other languages--Persian, Hebrew, Syriac; an endeavour to revive this form has been made by writers of the xixth century)"}, "madsrdf:citationSource": "E.J. Brill's first encyclopaedia of Islam, 1913-1936, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(maq\u0101mah (Arabic: \"assembly\"), Arabic literary genre in which entertaining anecdotes, often about rogues, mountebanks, and beggars, written in an elegant, rhymed prose, are presented in a dramatic or narrative context most suitable for the display of the author's eloquence, wit, and erudition.)"}, "madsrdf:citationSource": "Encyclop\u00e6dia Britannica online, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Maqama, UF Maqamah; a picaresque novella genre that arose in Arabic literature of the ninth and tenth centuries and later spread to Persian-Tadzhik and Hebrew literatures)"}, "madsrdf:citationSource": "The free dictionary online, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Maq\u0101ma: An Arabic term for stories in rhymed prose. Most of the tales come into the category of picaresque.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, c1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Maqamah (Arabic rhythmic prose genre, usually translated as \"assembly\" or \"seance,\" commonly compared to the European picaresque genre.)"}, "madsrdf:citationSource": "Oxford dictionary of Islam, Nov. 5, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Hebrew titles: Me\u1e33amot \u02bbivriyot; Yeme-ha-benayim : shirim u-me\u1e33amot; Shalosh ma\u1e33amot \u02bbal ha-nashim; Ma\u1e25berot \u02bbImanu\u02bcel; Ma\u1e25berot \u02bbImanu\u02bcel ha-Romi; Ma\u1e25berot Iti\u02bcel)"}, "madsrdf:citationSource": "OCLC, July 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 11 (maqamas; the maqama (maq\u0101ma) is a typically Arabic genre although it was later imitated, with little success, in Persian and other Islamic languages as well as in Syriac, and, somewhat more successfully, in Hebrew; basically, a maqama is a short narrative written in elaborate language, but it has many subgenres; the most common maqama is the so-called picaresque maqama, a comic story featuring a ragged hero whose eloquence is phenomenal; picaresque maqama, the high point of Mediaeval Arabic prose narrative) p. 65 (singular, maq\u0101ma; plural, maq\u0101m\u0101t) p. 311 (under The Hebrew maqama: Maqamas or Mahberot)"}, "madsrdf:citationSource": "H\u00e4meen-Anttila, J. Maqama : a history of a genre, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "book description (A Maqama (plural, Maqamat) is an Arabic rhymed prose literary form, with short poetic passages.)"}, "madsrdf:citationSource": "Bad\u012b' al-Zam\u0101n al-Hamadh\u0101n\u012b. The maq\u0101m\u0101t of Badi' al-Zam\u0101n al-Ham\u0101dh\u0101ni, 1915, viewed online, May 24, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Maqamas"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maqamas"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Maqamahs"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Maqamahs"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ma\u1e33\u0101mas"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ma\u1e33\u0101mas"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ma\u1e33\u0101m\u0101t"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ma\u1e33\u0101m\u0101t"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Me\u1e33amot"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Me\u1e33amot"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ma\u1e25berot"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ma\u1e25berot"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ma\u1e33amot"}}, {"@id": "_:n9fbf0e923fca47f893cc4b5f8d126873b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ma\u1e33amot"}}], "@id": "/authorities/genreForms/gf2014026425"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026426", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMarsiyas", "identifiers:lccn": "gf2014026426", "madsrdf:adminMetadata": [{"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b1"}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Marsiyas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b5"}, "madsrdf:hasSource": [{"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b8"}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b9"}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b10"}], "madsrdf:hasVariant": [{"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b11"}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Urdu elegies that generally honor the martyring of the Prophet Muhammad's grandson \u1e24usayn and his kinsmen in the 7th century Battle of Karbala."}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:13:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Marsiyas"}}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b5", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Elegies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b6"}]}}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Elegies"}}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under the article \"South Asian arts\": Mars\u012byeh: Mars\u012byeh means \"elegy,\" but in Urdu literature it generally means an elegy on the travails of the family and kinsmen of \u1e24usayn (grandson of Mu\u1e25ammad) and their martyrdom in the field of Karbal\u0101, Iraq; although a large number of mars\u012byehs were written in the Deccan and at Delhi, it was in Lucknow, with the patronage of Sh\u012b\u02bfite elite and royalty, that mars\u0304iyehs gained the tenor and magnitude of epic poetry. The two great masters of that 19th-century period were M\u012br An\u012bs and M\u012brz\u0101 Dab\u012br, who together established musaddas (a six-line stanza with an aaaa bb rhyme scheme) as the preferred form for mars\u012byehs and added several new topics and details to the ranks of associated themes, thus carrying the form beyond a simple lament.)"}, "madsrdf:citationSource": "Britannica academic edition online, May 24, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (Marsiya or elegy, nearly always on the death of Hasan, Husain, and their families, but occasionally on the death of relatives or friends. It is usually in six-lined stanzas with the rhyme aaaabb.)"}, "madsrdf:citationSource": "Bailey, T.G. A history of Urdu literature, 1932:", "madsrdf:citationStatus": "found"}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Urdu poetry: Marsiya literally means \"elegy,\" but in Urdu lit. hist. it chiefly refers to poems that honor the martyrdom of Imam Husain--a grandson of the Prophet Muhammad--and his companions in the battle of Karbala (680 CE). These elegies form an integral part of the ritual of public mourning during certain months for the Shi'a Muslims of South Asia. Initially, a marsiya could be written in any form. But in the early 19th c., both the writing of a marsiya and its public declamation--often accompanied with hand gestures and facial expressions--became profound arts at the hands of several masters, who exclusively used the six-line stanza form called musaddas (aaaabb))"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Marsiyahs"}}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Marsiyahs"}}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Marsiyehs"}}, {"@id": "_:n74b3eca58c3c40b9a8c2e26aadc1ead3b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Marsiyehs"}}], "@id": "/authorities/genreForms/gf2014026426"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026427", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMasnavis", "identifiers:lccn": "gf2014026427", "madsrdf:adminMetadata": [{"@id": "_:n01413324f31549c9bf46941157ed2feab1"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Masnavis"}, "madsrdf:elementList": {"@list": [{"@id": "_:n01413324f31549c9bf46941157ed2feab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n01413324f31549c9bf46941157ed2feab5"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab6"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab7"}], "madsrdf:hasVariant": [{"@id": "_:n01413324f31549c9bf46941157ed2feab8"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab11"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab14"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab17"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab20"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab23"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab26"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Persian, Turkish, and Arabic poems written in rhyming couplets."}, {"@id": "_:n01413324f31549c9bf46941157ed2feab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:14:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Masnavis"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 98 (mathnav\u012b, a series of distichs rhyming in pairs (aa, bb, cc, etc.). It contains the whole of heroic, historic and romantic epic poetry, together with the didactic poetry of more considerable compass.)"}, "madsrdf:citationSource": "Rypka, J. History of Iranian literature, c1968:", "madsrdf:citationStatus": "found"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Masnav\u012b, also mathnav\u012b. Also referred to as muthann\u0101 (doubled), athnayn athnayn (two by two), masnav\u012b is one of the oldest poetic forms in the Persian world. Its most prevalent uses historically have been in epic-narrative, epic-romantic, epic-didactic, and homiletic expressions; masnav\u012bs. Its Ar. counterpart, muzdawij, did not enjoy the general utility and thematic parameters of masnav\u012b in Persian lit.)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mas\u0304nav\u012b, also spelled mas\u0304naw\u012b, a series of distichs (couplets) in rhymed pairs (aa, bb, cc, and so on) that makes up a characteristic type of Persian verse, used chiefly for heroic, historical, and romantic epic poetry and didactic poetry; form originated in the Middle Persian period (roughly from the 3rd century BCE to the 9th century CE). It became a favourite poetic form of the Persians and of those cultures they influenced; Eventually, however, the mas\u0304nav\u012b took root in Arabic literature, where it bore the Arabic name muzdawij. The Persian name is probably a derivative of the Arabic mathna, meaning \"two by two.\")"}, "madsrdf:citationSource": "Britannica academic online, viewed June 7, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n01413324f31549c9bf46941157ed2feab8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01413324f31549c9bf46941157ed2feab9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Athnayn athnayns"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Athnayn athnayns"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01413324f31549c9bf46941157ed2feab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Muthannas"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Muthannas"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01413324f31549c9bf46941157ed2feab15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mathnavis"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mathnavis"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01413324f31549c9bf46941157ed2feab18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Masnawis"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Masnawis"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01413324f31549c9bf46941157ed2feab21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Muzdawij"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Muzdawij"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01413324f31549c9bf46941157ed2feab24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mathnawis"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mathnawis"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01413324f31549c9bf46941157ed2feab27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mesnevis"}}, {"@id": "_:n01413324f31549c9bf46941157ed2feab27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mesnevis"}}], "@id": "/authorities/genreForms/gf2014026427"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026428", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMasques", "identifiers:lccn": "gf2014026428", "madsrdf:adminMetadata": [{"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b1"}, {"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Masques"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026222"}, "madsrdf:hasSource": [{"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b5"}, {"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b6"}], "madsrdf:hasVariant": {"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "The texts of 16th-17th century courtly entertainments that combined poetic drama, music, dance, song, lavish costume, and costly stage effects with a simple mythological or allegorical plot."}, {"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:35:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Masques"}}, {"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(masque (mask). A spectacular kind of indoor performance combining poetic drama, music, dance, song, lavish costume, and costly stage effects, which was favoured by European royalty in the 16th and early 17th centuries, especially to celebrate royal weddings, birthdays and other special occasions. Members of the court would enter disguised, taking the parts of mythological persons alongside professional performers, and enact a simple allegorical plot, concluding with the removal of masks, a dance joined by members of the audience, and a banquet. The parliamentary Revolution of the 1640s brought this form of extravagance to an abrupt end.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(masque. A masque was a fairly elaborate form of courtly entertainment which was particularly popular in the reigns of Elizabeth I, James I and Charles I, as it was in Italy (where the masque first acquired a distinctive form), and in France; combined poetic drama, song, dance, and music; costumes were often sumptuous. A prologue introduced a group of actors known to the audience. They entered in disguise or perhaps in some kind of decorated vehicle. Plot and action were slight. Usually the plot consisted of mythological and allegorical elements. Sometimes there might be a sort of 'debate.' At the end there was a dance of masked figures in which the audience joined. In short, it was a kind of elegant, private pageant.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dict. of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Masks (Drama)"}}, {"@id": "_:nc7c74c24ba7048a89ffe5dfcf310c446b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Masks (Drama)"}}], "@id": "/authorities/genreForms/gf2014026428"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026429", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMedical drama", "identifiers:lccn": "gf2014026429", "madsrdf:adminMetadata": [{"@id": "_:nd76740459b5d464fa89b524c93baf047b1"}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Medical drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd76740459b5d464fa89b524c93baf047b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:nd76740459b5d464fa89b524c93baf047b5"}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b6"}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b7"}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b8"}], "madsrdf:hasVariant": [{"@id": "_:nd76740459b5d464fa89b524c93baf047b9"}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that feature medical personnel and the practice of medicine."}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:14:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Medical drama"}}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Reach, J. Doctors and nurses : a comedy in three acts, c1964.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mersand, J.E. Three plays about doctors, 1961.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(in titles: medical drama; medical dramas; hospital drama; hospital dramas)"}, "madsrdf:citationSource": "OCLC, Mar. 12, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "table of contents (The genre of medical drama--The development of hospital drama in Great Britain, U.S.A. and Germany)"}, "madsrdf:citationSource": "Krajewski, S. Life goes on, and sometimes it doesn't : a comparative study of medical drama in the US, Great Britain, and Germany, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd76740459b5d464fa89b524c93baf047b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hospital drama"}}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hospital drama"}}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd76740459b5d464fa89b524c93baf047b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Doctor drama"}}, {"@id": "_:nd76740459b5d464fa89b524c93baf047b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Doctor drama"}}], "@id": "/authorities/genreForms/gf2014026429"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026430", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMedical fiction", "identifiers:lccn": "gf2014026430", "madsrdf:adminMetadata": [{"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b1"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Medical fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b5"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b6"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b7"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b8"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b9"}], "madsrdf:hasVariant": [{"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b10"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b13"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features medical personnel and the practice of medicine."}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:14:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Medical fiction"}}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Eisenstein, R. Date certain : a medical thriller, c2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Knickerbocker, C.H. The dynasty : a medical novel, 1962.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Medical novels. Use for fiction with a medical setting, including hospitals, and usually involving medical personnel, doctors, nurses, etc. UF Doctor novels; Hospital novels)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Medical fiction; medical fiction writers)"}, "madsrdf:citationSource": "California and western medicine, Apr. 1924, viewed online July 10, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Medical fiction. UF Hospital fiction. BT Fiction)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Doctor fiction"}}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Doctor fiction"}}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Medical novels"}}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Medical novels"}}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hospital fiction"}}, {"@id": "_:n7ee51c2f821c4d1aa8034ad4c579b048b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hospital fiction"}}], "@id": "/authorities/genreForms/gf2014026430"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026431", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMelic poetry", "identifiers:lccn": "gf2014026431", "madsrdf:adminMetadata": [{"@id": "_:n96f429825c504b1d930551ba5cc3159fb1"}, {"@id": "_:n96f429825c504b1d930551ba5cc3159fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Melic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n96f429825c504b1d930551ba5cc3159fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422"}, "madsrdf:hasSource": [{"@id": "_:n96f429825c504b1d930551ba5cc3159fb5"}, {"@id": "_:n96f429825c504b1d930551ba5cc3159fb6"}, {"@id": "_:n96f429825c504b1d930551ba5cc3159fb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Classical Greek lyric poetry that was intended to be sung to a musical accompaniment."}, {"@id": "_:n96f429825c504b1d930551ba5cc3159fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n96f429825c504b1d930551ba5cc3159fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:14:49"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n96f429825c504b1d930551ba5cc3159fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Melic poetry"}}, {"@id": "_:n96f429825c504b1d930551ba5cc3159fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(melic poetry. Lyric poetry to be sung and danced to)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n96f429825c504b1d930551ba5cc3159fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Melic Poetry (Gr. melos, \"member,\" \"song\"). Later called lyric poetry by the Alexandrians, m. p. refers loosely to Gr. poetry composed from the 7th through 5th cs. B.C., exclusive of epic, dramatic, elegiac, and iambic; was sung to the accompaniment of a lyre or woodwinds or both and was divided into two broad categories, monodic and choral)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993, via Literature online, Feb. 15, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n96f429825c504b1d930551ba5cc3159fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. xviii-xxix (More appropriate than lyric, as an exact and comprehensive designation of all poetry that was sung to a musical accompaniment, is melic, the term that was in vogue among the Greeks of the classic age; the term melic was not extended to cover elegiac, iambic, and even epic, poetry because the musical accompaniment was not so vital a feature of these forms as it was in the case of melic verse) p. xx (Originally almost all melic poetry was led by a single voice, while the chorus sang only the refrain)"}, "madsrdf:citationSource": "Smyth, H.W. Greek melic poets, 1900:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026431"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026432", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMelodramas (Drama)", "identifiers:lccn": "gf2014026432", "madsrdf:adminMetadata": [{"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b1"}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Melodramas (Drama)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026449"}, "madsrdf:hasSource": [{"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b5"}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b6"}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b7"}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b8"}], "madsrdf:hasVariant": {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that emphasize plot, action, and exaggerated emotion at the expense of characterization."}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:15:03"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Melodramas (Drama)"}}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The term melodrama refers to a dramatic work that exaggerates plot and characters in order to appeal to the emotions; an alternative English spelling, now obsolete, is \"melodrame\")"}, "madsrdf:citationSource": "Wikipedia, Nov. 6, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Melodrama. Melodramas were stage plays featuring background music and songs to underscore the emotional mood of each scene. Melodramas were weak in characterization and plot but strong in action, suspense, and passion. Characters were stereotyped villains, heroes, and young lovers, and plots followed formulae of good vs. evil, love triumphant, and daring rescues)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(melodrama. A type of drama that highlights suspense and romantic sentiment, with characters who are usually either clearly good or bad. As its name implies, the form frequently uses a musical background to underscore or heighten the emotional tone of a scene; first achieved great popularity on the 19th-century stage; its appeal continues today in many films and television plays)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (Melodrama: Historically, a distinct form of drama popular throughout the nineteenth century which emphasized action, suspense, and spectacular effects; generally melodrama used music to heighten the dramatic mood. Melodrama had stock characters and clearly defined villains and heroes, and it presented unambiguous confrontations between good and evil.)"}, "madsrdf:citationSource": "Wilson, E. The theater experience, c2004, via McGraw-Hill Higher Education online learning center, Nov. 14, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Melodramatic plays"}}, {"@id": "_:n269dea73fb894ea5b4f2f266d5c09ea9b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Melodramatic plays"}}], "@id": "/authorities/genreForms/gf2014026432"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026433", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMemorates", "identifiers:lccn": "gf2014026433", "madsrdf:adminMetadata": [{"@id": "_:n47833fac6d664dce9530e1d11c477a99b1"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Memorates"}, "madsrdf:elementList": {"@list": [{"@id": "_:n47833fac6d664dce9530e1d11c477a99b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026142"}, "madsrdf:hasSource": [{"@id": "_:n47833fac6d664dce9530e1d11c477a99b5"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b6"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b7"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b8"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b9"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b10"}], "madsrdf:hasVariant": [{"@id": "_:n47833fac6d664dce9530e1d11c477a99b11"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b14"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "First-person narratives that describe an encounter with a supernatural being or paranormal event."}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:15:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Memorates"}}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(five bylichki (memorates) that tell of encounters with a supernatural being supposed to have been experienced by the narrator or someone known to the narrator)"}, "madsrdf:citationSource": "Marshall, B. The Snow Maiden and other Russian tales, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(memorates: A technical term for narratives describing how the speaker personally encountered a supernatural being or experienced a paranormal event, which he/she interpreted in terms of traditional beliefs. Some scholars, but not all, extend the term to cover those where it is a close relative or friend of the speaker who had the experience.)"}, "madsrdf:citationSource": "Simpson, J. A dictionary of English folklore, via Oxford reference online, Dec. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 2, p. 615 (Swedish folklorist Carl Wilhelm von Sydow coined the term \"memorate\" in 1934 to refer to a first-person story about a personal supernatural experience to distinguish it from what he called a \"fabulate,\" a traditional folk story told in the third person that is well known and shared in and across communities, the legend being a prime example; currently, \"memorate\" is often generalized to refer to all personal experience narratives, not only to those about the supernatural, and so connects folk narratives to autobiography and memoir)"}, "madsrdf:citationSource": "Greenwood encyclopedia of folktales and fairy tales, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Memorates. UF Memorats, BT Folk literature)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bylichki: Russian tales mainly about the lesser demigods and spirit-beings, wood demons, water nymphs, spirits of the dead, who populated the familiar universe of the Russian peasantry. This form of memorate, or tale about events that had supposedly taken place in real life and were \"remembered\" by the story-teller, shows deeply entrenched patterns of belief about the relationship between the natural and supernatural world in the traditional rural community)"}, "madsrdf:citationSource": "Warner, E. Introduction to Russian myths, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bylichki. UF Byval\u02b9shchiny, BT Tales--Russia (Federation))"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n47833fac6d664dce9530e1d11c477a99b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Byval\u02b9shchiny"}}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Byval\u02b9shchiny"}}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n47833fac6d664dce9530e1d11c477a99b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bylichki"}}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bylichki"}}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n47833fac6d664dce9530e1d11c477a99b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Memorats"}}, {"@id": "_:n47833fac6d664dce9530e1d11c477a99b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Memorats"}}], "@id": "/authorities/genreForms/gf2014026433"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026434", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMetadramas", "identifiers:lccn": "gf2014026434", "madsrdf:adminMetadata": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b1"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Metadramas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026118"}, "madsrdf:hasSource": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b5"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b6"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b7"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b8"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b9"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b10"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b11"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b12"}], "madsrdf:hasVariant": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b13"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b16"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b19"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b22"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b25"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b28"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b31"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b34"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b37"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b40"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b43"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b46"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b49"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b52"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Drama that self-consciously calls attention to its own fictional status as a theatrical pretence, often through the use of a play-within-a-play."}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:15:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Metadramas"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Metadrama and metafiction are modes of writing that comment on their own activities: they are self-reflexive. Metadramatic and metafictional techniques have returned in many recent plays and novels: plays by Tom Stoppard and Peter Shaffer are examples)"}, "madsrdf:citationSource": "The UVic writer's guide, via WWW, Feb. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an inordinate number of plays exercise a self-reflexive interest the possibilities and responsibilities of playwright, actor, and audience; meta-fiction, meta-drama, and meta-theatre; plays within plays; broken narrative frameworks; self-referentiality and self-consciously marked theatrical play; theatrical performances of everyday rituals and performance)"}, "madsrdf:citationSource": "MetaDrama and MetaTheatre : drama, theatre and performance about drama, theatre and performance, via WWW, Feb. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 5 (metadramatic theatre; the term \"metatheater\" was coined in the 1960s by Lionel Abel, who argued that this self-reflective theatre must be seen as a third genre besides comedy and tragedy) p. 6 (Metatheater encompasses all forms of theatrical self-referentiality--not only plays within the play, but also role playing, self-conscious reference the conventions of drama and to other plays as well as the inclusion of ritualistic and ceremonial enactments; metadramatic play)"}, "madsrdf:citationSource": "M\u00fcller-Wood, A. Early modern metadrama, 2007, via WWW, Feb. 20, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Gibson, T. Plays of plays, by plays, and for plays : the self-reflexive drama of the 17th and 18th centuries, via WWW, Feb. 20, 2014.", "madsrdf:citationStatus": "found"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(metatheatre/metatheater: Theatre which draws attention to its unreality, esp. by the use of a play within a play; (also) those particular parts of a drama which exemplify this device.)"}, "madsrdf:citationSource": "OED online, Feb. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(metadrama (plural metadramas) A play that features another play as part of its plot.)"}, "madsrdf:citationSource": "Wiktionary, Feb. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Metatheatre. Self-reflexive drama or performance that reveals its artistic status to the audience. The reflexivity may be embedded in a script's structure by the playwright, when it can be called metadrama, or superimposed in production by the director or designer.)"}, "madsrdf:citationSource": "Oxford encyclopedia of theatre and performance, \u00a92003, via WWW, Feb. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(metadrama or metatheatre, drama about drama, or any moment of self\u2010consciousness by which a play draws attention to its own fictional status as a theatrical pretence. Normally, direct addresses to the audience in prologues, epilogues, and inductions are metadramatic in that they refer to the play itself and acknowledge the theatrical situation; a similar effect may be achieved in asides. In a more extended sense, the use of a play\u2010within\u2010the\u2010play, as in Hamlet, allows a further metadramatic exploration of the nature of theatre, which is taken still further in plays about plays, such as Luigi Pirandello's Sei personaggi in cerca d'autore)"}, "madsrdf:citationSource": "The concise Oxford dictionary of literary terms, \u00a92004, via WWW, Feb. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Metatheater"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Metatheater"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Metatheatrical drama"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Metatheatrical drama"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Self-reflexive drama"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Self-reflexive drama"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Metadrama"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Metadrama"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Meta-dramas"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Meta-dramas"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Meta-theatre"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Meta-theatre"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Drama about drama"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drama about drama"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plays within the play"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plays within the play"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Metadramatic theater"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Metadramatic theater"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b40", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b41"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Meta-theater"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b41", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Meta-theater"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b43", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b44"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plays within plays"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b44", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plays within plays"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b46", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b47"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Metadramatic plays"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b47", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Metadramatic plays"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b49", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b50"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Metatheatre"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b50", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Metatheatre"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b52", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n844098f94e6642a4aea4201a63ab4f06b53"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Meta-drama"}}, {"@id": "_:n844098f94e6642a4aea4201a63ab4f06b53", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Meta-drama"}}], "@id": "/authorities/genreForms/gf2014026434"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026436", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMissionary plays", "identifiers:lccn": "gf2014026436", "madsrdf:adminMetadata": [{"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb1"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Missionary plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026501"}, "madsrdf:hasSource": [{"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb5"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb6"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb7"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb8"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb9"}], "madsrdf:hasVariant": {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that promote the goals of religious missions."}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:16:02"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Missionary plays"}}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Missionary plays. BT Religious drama)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 6 (We all know the attractiveness of missionary dramatics. There is no better way to bring knowledge to the indifferent ones than by giving a missionary pageant or play. The person who refuses to attend a study class or a missionary program will go to see a missionary play. Often a young person who refuses to take part in a program will delight in having part in a pageant. Many instances are known of such young persons who first became interested in this way. We should not underestimate the good results derived from presenting a good missionary play or pageant.)"}, "madsrdf:citationSource": "Luther League review, Dec. 1923, via Google books, viewed on May 13, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1, p. 263 (The missionary theatre that flourished in the mid sixteenth century was the first great artistic product of the encounter of the Spanish and indigenous races. Mixing, as it did, Spanish and native languages, as well as European and indigenous dramatic modes, it may be considered a truly mestizo art form) p. 264 (the Spanish friars were usually the authors (or adaptors) of the dramatic pieces)"}, "madsrdf:citationSource": "The Cambridge history of Latin American literature, 1996, via Cambridge histories online, viewed May 13, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 30 (The first examples of theatre brought by the Spanish were related to Franciscan missionary activity. Missionary drama notably took the form of the presentation of the fundamentals of the Christian gospel in the church-sponsored Corpus Christi celebrations) p. 31 (The important point to be retained from the above is that the early missionary activity as expressed through drama was profoundly assimilationist and synchretistic.)"}, "madsrdf:citationSource": "Hart, S.M. A companion to Latin American literature, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: Short missionary plays; Five missionary plays; A greater vision : a missionary play in three acts; Declare his name : a selection of missionary hero sketches, dramatic readings, and dramas for adults and children; Two masters : a missionary drama; Dramatized missionary stories)"}, "madsrdf:citationSource": "OCLC, May 13, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Missionary drama"}}, {"@id": "_:n3c76d19f04f04c7b96eb828364cfc50bb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Missionary drama"}}], "@id": "/authorities/genreForms/gf2014026436"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026437", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMock-heroic drama", "identifiers:lccn": "gf2014026437", "madsrdf:adminMetadata": [{"@id": "_:n7a7210bbf23a4127a5db561442abd1efb1"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mock-heroic drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7a7210bbf23a4127a5db561442abd1efb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026525"}], "madsrdf:hasSource": [{"@id": "_:n7a7210bbf23a4127a5db561442abd1efb5"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb6"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb7"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb8"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb9"}], "madsrdf:hasVariant": {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Drama that satirically treats a trivial subject in a grand style."}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-06-02T15:20:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mock-heroic drama"}}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mock-heroic. Written in an ironically grand style that is comically incongruous with the 'low' or trivial subject treated; commonly applied to mock epics, but serves also for works or parts of works using the same comic method in various forms other than that of the full-scale mock-epic poem. Theatrical burlesques of heroic drama, such as Henry Fielding's Tom Thumb (1730) are also referred to as mock-heroic.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Beck, T. The triumph of the sons of Belial, or, Liberty vanquished : a mock heroic tragedy in five acts, 1810.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mock-heroic. In the style of mock-epic, but the term has a slightly wider application. The heroic manner is adopted to make a trivial subject seem grand in such a way as to satirize the style, and it is therefore commonly used in burlesque and parody. Fielding's Tom Thumb (1730) is a good example of a mock-heroic play)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Nash, G. Man and his mistress, or Woman's revolt : a mock-heroic melo-drama, 1842.", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Mock Epic (or Mock Heroic) (Terms for a literary form that burlesques the epic by treating a trivial subject in the \"grand style\" or uses the epic formulas to make a trivial subject ridiculous by ludicrously overstating it.)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n7a7210bbf23a4127a5db561442abd1efb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mock-epic drama"}}, {"@id": "_:n7a7210bbf23a4127a5db561442abd1efb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mock-epic drama"}}], "@id": "/authorities/genreForms/gf2014026437"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026438", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMock-heroic poetry", "identifiers:lccn": "gf2014026438", "madsrdf:adminMetadata": [{"@id": "_:nd202950e2760425da9f6d99c1b64b24eb1"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mock-heroic poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd202950e2760425da9f6d99c1b64b24eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026077"}, "madsrdf:hasSource": [{"@id": "_:nd202950e2760425da9f6d99c1b64b24eb5"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb6"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb7"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb8"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb9"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb10"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb11"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb12"}], "madsrdf:hasVariant": [{"@id": "_:nd202950e2760425da9f6d99c1b64b24eb13"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2025-01-27T10:29:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mock-heroic poetry"}}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mock Epic, Mock Heroic. The mock heroic is a literary mode, primarily satiric, in which present realities are juxtaposed to a noble and heroic past, only to be found wanting. Mock epic draws its heroic precedents specifically from the standard repertoire of the epic; in tone, neoclassical mock-heroic/epic satire is sometimes light; but more often, the satire ranges toward ridicule and humiliation of its victims)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Jacob, G. The rape of the smock : an heroi-comical poem, 1736.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mock-epic, or mock-heroic; a satirical form that produces ridicule and humour by the presentation of low characters or trivial subjects in the lofty style of classical epic or heroic poems. Almost invariably a poem in heroic couplets, the mock\u2010epic typically employs elevated poetic diction (which Pope said should generate 'pompous expressions'), focuses on a single 'heroic' incident or action, and incorporates selected elements from the machinery of classical epic)"}, "madsrdf:citationSource": "Concise Oxford companion to English literature, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Pope, A. The rape of the lock : an heroi-comical poem in five cantos, 2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Tassoni, A. La secchia rapita, or, The rape of the bucket : an heroi-comical poem in 12 cantos, 1825.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Jacob, G. The rape of the smock : an heroi-comic poem, 1768.", "madsrdf:citationStatus": "found"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mock-epic, also called mock-heroic: form of satire that adapts the elevated heroic style of the classical epic poem to a trivial subject)"}, "madsrdf:citationSource": "Britannica online academic edition, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mock-heroic; adjective: (of a literary work or its style) imitating the style of heroic literature in order to satirize an unheroic subject; noun: a burlesque imitation of the heroic character or literary styles)"}, "madsrdf:citationSource": "Oxford dictionary of English, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd202950e2760425da9f6d99c1b64b24eb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Heroi-comical poetry"}}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Heroi-comical poetry"}}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd202950e2760425da9f6d99c1b64b24eb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mock-epic poetry"}}, {"@id": "_:nd202950e2760425da9f6d99c1b64b24eb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mock-epic poetry"}}], "@id": "/authorities/genreForms/gf2014026438"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026439", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMonodramas (Literature)", "identifiers:lccn": "gf2014026439", "madsrdf:adminMetadata": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb1"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Monodramas (Literature)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb5"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb8"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026480"}, "madsrdf:hasSource": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb11"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb12"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb13"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb14"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb15"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb16"}], "madsrdf:hasVariant": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb17"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb20"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb23"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb26"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb29"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb32"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb35"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/genreForms/gf2013025006"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-24T10:11:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monodramas (Literature)"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed monodramas"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed monodramas"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Monodramas"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monodramas"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(monodrama: A theatrical entertainment in which there is only one character; monopolylogue: An entertainment in which one performer plays many parts, as in some forms of monodrama)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: A musical mono-drama, The mind's eye; Mono-dramas; Lines to be spoken in The captive : a mono drama; Going it alone : plays by women for solo performers; Solo plays from the repertory of Sydney Thompson; Meaty monologues : the monologues & one-person plays of Jane Shepard; Plays for one person; Troupers & tramps : one-person plays)"}, "madsrdf:citationSource": "OCLC, Oct. 27, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (may be a drama or comedy; may be a story of one person or it may involve a number of other characters that the actor evokes in the audience's imagination--but there is only one actor; one-person productions are popular in theatres all over the country) pp. 3-4 (solo plays; one-person dramas; one-person plays; one-person comedies and dramas; one-man play; solo dramas) p. 7 (the solo theatrical form is what some prefer to call the monodrama) p. 15 (the monodrama is a complete work, in contrast to soliloquies, which must be seen in the context of the entire play)"}, "madsrdf:citationSource": "Catron, L.E. The power of one : the solo play for playwrights, actors, and directors, c2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(monodrama, a drama acted or designed to be acted by a single person. A number of plays by Samuel Beckett, including Krapp's Last Tape (first performed 1958) and Happy Days (1961), are monodramas. The term may also refer to a dramatic representation of what passes in an individual mind, as well as to a musical drama for a solo performer.)"}, "madsrdf:citationSource": "Britannica online, Oct. 27, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(monodrama: A dramatic composition written for one performer; adj. monodramatic)"}, "madsrdf:citationSource": "The American heritage dictionary of the English language, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(monodrama: A play or dramatic scene in which only one character speaks; or a sequence of dramatic monologues all spoken by the same single character. The second sense is rarely used, except of Tennyson's Maud (1855), to which the author attached the subtitle A Monodrama in 1875.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mono-dramas (Literature)"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mono-dramas (Literature)"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Solo plays"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Solo plays"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Monodramas"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monodramas"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed monodramas"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed monodramas"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "One-man plays"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "One-man plays"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "One-person plays"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "One-person plays"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb35", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na9dc01cb6bb74b008fb663a275070eceb36"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Monopolylogues"}}, {"@id": "_:na9dc01cb6bb74b008fb663a275070eceb36", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monopolylogues"}}], "@id": "/authorities/genreForms/gf2014026439"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026440", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMonologues (Drama)", "identifiers:lccn": "gf2014026440", "madsrdf:adminMetadata": [{"@id": "_:na2e742ff36794439986411fa2a6e0bf8b1"}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Monologues (Drama)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na2e742ff36794439986411fa2a6e0bf8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b5"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026378"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026548"}], "madsrdf:hasSource": [{"@id": "_:na2e742ff36794439986411fa2a6e0bf8b8"}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b9"}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b10"}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b11"}], "madsrdf:hasVariant": [{"@id": "_:na2e742ff36794439986411fa2a6e0bf8b12"}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Extended speeches uttered by one speaker, either alone or to others."}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:45:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monologues (Drama)"}}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na2e742ff36794439986411fa2a6e0bf8b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Monologues"}}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monologues"}}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(monologue. A long speech by one speaker. If the speaker is alone such a speech is called a soliloquy. If the speaker addresses someone absent or an abstract idea, it is an apostrophe. If the speech is addressed to someone present, it is a dramatic monologue. An interior monologue represents a character's fleeting thoughts and impressions, or inner speech.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(monologue. An extended speech uttered by one speaker, either to others or as if alone. Significant varieties include the dramatic monologue (a kind of poem in which the speaker is imagined to be addressing a silent audience), and the soliloquy (in which the speaker is supposed to be 'overheard' while alone). Some modern plays in which only one character speaks, are known either as monodramas or as monologues. In prose fiction, the interior monologue is a representation of a character's unspoken thoughts, sometimes rendered in the style known as stream of consciousness.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(monologue. A term used in a number of senses, with the basic meaning of a single person speaking alone--with or without an audience. Most prayers, much lyric verse and all laments are monologues, but, apart from these, four main kinds can be distinguished: (a) monodrama; (b) soliloquy; (c) solo addresses to an audience in a play; (d) dramatic monologue--a poem in which there is one imaginary speaker addressing an imaginary audience)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Majeski, B. 50 great monologs for student actors, c1987.", "madsrdf:citationStatus": "found"}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na2e742ff36794439986411fa2a6e0bf8b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Monologs (Drama)"}}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monologs (Drama)"}}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na2e742ff36794439986411fa2a6e0bf8b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Monologues"}}, {"@id": "_:na2e742ff36794439986411fa2a6e0bf8b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monologues"}}], "@id": "/authorities/genreForms/gf2014026440"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026441", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMonostichs", "identifiers:lccn": "gf2014026441", "madsrdf:adminMetadata": [{"@id": "_:n8dba239385b24ca8ba294ef52add0219b1"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Monostichs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8dba239385b24ca8ba294ef52add0219b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n8dba239385b24ca8ba294ef52add0219b5"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b6"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b7"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b8"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b9"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b10"}], "madsrdf:hasVariant": {"@id": "_:n8dba239385b24ca8ba294ef52add0219b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems consisting of a single line."}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T10:18:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monostichs"}}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Monostich. A poem consisting of a single line; monostichs)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Monostiches; a poem or epigram consisting of but one metrical line)"}, "madsrdf:citationSource": "Shorter Ox. English dict., 1973", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Monostiches; single line poem)"}, "madsrdf:citationSource": "Chambers 20th cent. dict.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Monostich. A poem consisting of one line)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(monostich: 1. a poem or epigram consisting of a single metrical line. 2. a single line of poetry. Related forms: monostichic, adjective)"}, "madsrdf:citationSource": "Dictionary.com, Apr. 10, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Middle, M. Two one line poems, 2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8dba239385b24ca8ba294ef52add0219b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Monostiches"}}, {"@id": "_:n8dba239385b24ca8ba294ef52add0219b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monostiches"}}], "@id": "/authorities/genreForms/gf2014026441"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026442", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMorality plays", "identifiers:lccn": "gf2014026442", "madsrdf:adminMetadata": [{"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b1"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Morality plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026218"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026287"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026501"}], "madsrdf:hasSource": [{"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b5"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b6"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b7"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b8"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b9"}], "madsrdf:hasVariant": {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Late medieval allegorical plays that teach moral lessons by depicting the battle between good and evil in the human soul."}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:17:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Morality plays"}}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Morality Play. Basically, a Morality Play is an allegory in dramatic form. Its dramatic origins are to be found in the Mystery and Miracle Plays of the late Middle Ages; its allegorical origins in the sermon literature, homilies, exempla, romances and works of spiritual edification. In essence a Morality Play was a dramatization of the battle between the forces of good and evil in the human soul. The long-term influence of the Moralities is discernible in the pageant and masque)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A kind of religious drama popular in England, Scotland, France, and elsewhere in Europe in the 15th and early 16th centuries. Morality plays are dramatized allegories, in which personified virtues, vices, diseases, and temptations struggle for the soul of Man as he travels from birth to death. They instill a simple message of Christian salvation, but often include comic scenes; most are anonymous; earliest surviving example in English is Castle of Perseverance (c.1420), and the best-known is Everyman (c.1510))"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(morality play, also called morality, an allegorical drama popular in Europe especially during the 15th and 16th centuries, in which the characters personify moral qualities (such as charity or vice) or abstractions (as death or youth) and in which moral lessons are taught. Together with the mystery play and the miracle play, the morality play is one of the three main types of vernacular drama produced during the Middle Ages. The action of the morality play centres on a hero, such as Mankind, whose inherent weaknesses are assaulted by such personified diabolic forces as the Seven Deadly Sins but who may choose redemption and enlist the aid of such figures as the Four Daughters of God (Mercy, Justice, Temperance, and Truth). Morality plays were an intermediate step in the transition from liturgical to professional secular drama, and combine elements of each.)"}, "madsrdf:citationSource": "Britannica online, Oct. 27, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Morality Play. Late medieval religious drama, performed on a stage in the vernacular, that served a didactic intent, the commendation to the viewing public of a morally upright life. Two main themes: the struggle between the forces of good and evil, each personified and named for the particular virtue or vice it represents, for the salvation or the damnation of man's soul at the moment of death; the depiction of the ages of man, each of which is fraught with the perils of immortality. Usually the presentation is allegorical, and the protagonist is a character symbolic of all of mankind.)"}, "madsrdf:citationSource": "McGraw-Hill encyc. of world drama, c1972", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (Morality play: Medieval drama designed to teach a lesson. The characters were often allegorical and represented virtues or faults, such as good deeds, friendship, or avarice. The most famous example is Everyman.)"}, "madsrdf:citationSource": "Wilson, E. The theater experience, c2004, via McGraw-Hill Higher Education online learning center, Nov. 14, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Morality drama"}}, {"@id": "_:n2c4b4e95dc824255b7964ce413a41dc8b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Morality drama"}}], "@id": "/authorities/genreForms/gf2014026442"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026443", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMu\u02bb\u0101ra\u1e0d\u0101t", "identifiers:lccn": "gf2014026443", "madsrdf:adminMetadata": [{"@id": "_:nfe3b969838844e579afc082886b68817b1"}, {"@id": "_:nfe3b969838844e579afc082886b68817b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mu\u02bb\u0101ra\u1e0d\u0101t"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfe3b969838844e579afc082886b68817b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:nfe3b969838844e579afc082886b68817b5"}, {"@id": "_:nfe3b969838844e579afc082886b68817b6"}, {"@id": "_:nfe3b969838844e579afc082886b68817b7"}, {"@id": "_:nfe3b969838844e579afc082886b68817b8"}, {"@id": "_:nfe3b969838844e579afc082886b68817b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Arabic and Persian poems that deliberately imitate the themes and versification of a famous poem."}, {"@id": "_:nfe3b969838844e579afc082886b68817b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nfe3b969838844e579afc082886b68817b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:17:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfe3b969838844e579afc082886b68817b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mu\u02bb\u0101ra\u1e0d\u0101t"}}, {"@id": "_:nfe3b969838844e579afc082886b68817b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 229 (By mu\u02bb\u0101ra\u1e0d\u0101h, al-Jurj\u0101ni means the imitation of a passage in point of style with a view to outdoing the predecessor. If later critics did not discuss mu\u02bb\u0101ra\u1e0d\u0101h in this sense, however, poets regularly practiced mu\u02bb\u0101ra\u1e0d\u0101h in its more technical meaning: writing a poem in response to an earlier poem in the same meter and rhyme. Examples of this form of imitation can be found throughout the history of Arabic and Persian poetry.)"}, "madsrdf:citationSource": "Reorientations : Arabic and Persian poetry, c1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe3b969838844e579afc082886b68817b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 15 (Mu\u02bb\u0101ra\u1e0d\u0101h: to compose poetry imitating some other poet's poem as far as rhyme and meter (and often subject matter))"}, "madsrdf:citationSource": "An\u1e63\u0101r\u012b, \u02bbAbd al-Wahh\u0101b. An anthology of Arabic poetry, c2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe3b969838844e579afc082886b68817b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 27 (mu\u02bb\u0101ra\u1e0d\u0101h, poems that by following the rhyme and meter of earlier works were meant to vie with the original models or at least invite comparison with them, in the way, but not quite with the same degree of originality as Pope, for instance, imitated Horace, or Johnson Juvenal.)"}, "madsrdf:citationSource": "Badaw\u012b, M. A short history of modern Arabic literature, 1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe3b969838844e579afc082886b68817b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mu\u02bb\u0101ra\u1e0d\u0101h (pl. mu\u02bb\u0101ra\u1e0d\u0101t), a term used for a poem identical in its metre and rhyme (and often in its thematic substance) with a classical model.)"}, "madsrdf:citationSource": "Modern Arabic literature, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:nfe3b969838844e579afc082886b68817b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 31 (Mu\u02bb\u0101ra\u1e0d\u0101h, poems with the same metre and rhyme as famous examples from classical literature on related subjects.)"}, "madsrdf:citationSource": "Brugman, J. An introduction to the history of modern Arabic literature in Egypt, 1984:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026443"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026444", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMummers' plays", "identifiers:lccn": "gf2014026444", "madsrdf:adminMetadata": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b1"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mummers' plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026341"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026057"}, "madsrdf:hasSource": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b5"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b6"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b7"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b8"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b9"}], "madsrdf:hasVariant": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b10"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b13"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b16"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b19"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b22"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b25"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b28"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b31"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b34"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b37"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "English folk plays that usually have a central theme of death and resurrection."}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-10-18T07:01:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mummers' plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mummers' play. A form of early English folk theatre, which probably had its roots in primitive ritual. Also known as the Men's Dramatic Ceremony...some of the more unusual extant variations include the Pace-Egg Play of Yorkshire and the Soul-Cakers Play of Cheshire; other alternative names by which the mummers' play is known include the Jolly Boys' Play and the Tipteerers' Play)"}, "madsrdf:citationSource": "The new Penguin dictionary of the theatre, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(mummers' play/mumming play: A form of folk play performed during Christmas time in English villages in the 16th and 17th centuries. Many of the plays feature the folk hero of the Red Cross, St. George.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mummers Plays (also known as mumming) are seasonal folk plays performed by troupes of actors known as mummers or guisers (or by local names such as rhymers, pace-eggers, soulers, tipteerers, galoshins, guysers, and so on); guisers' plays)"}, "madsrdf:citationSource": "Wikipedia, Oct. 29, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mummers' Play, or Men's Dramatic Ceremony, the best known type of English folk-play; extant texts have been divided into three groups: the Hero-Combat Play, the Sword Play, and the Wooing Ceremony; all-male cast; the mummers' play has a number of alternative names, such as the Johnny Jacks' Play, the Jolly Boys' Play, and the Tipteerers' Play, while the players were sometimes known as Guizards or Guizers, from their disguise.)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "mumming play (A primitive form of folk drama associated with funeral rites and seasonal fertility rites, especially the spring festival; The theme of the mumming play is clearly death and resurrection, which suggests that it may be connected with an pagan spring-festival rite) pace-egging play (A mumming play; usually the play of St George (or Sir George); the Mummers called themselves 'pace-eggers' after the Eastertide custom of staining hard-boiled eggs and rolling them against one another until they broke, after which they were eaten)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mumming plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mumming plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jolly Boys' plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jolly Boys' plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Men's dramatic ceremony"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Men's dramatic ceremony"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Guisers' plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Guisers' plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Johnny Jacks' plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Johnny Jacks' plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mummers' drama"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mummers' drama"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tipteerers' plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tipteerers' plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pace-egging plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pace-egging plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pace-egg plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pace-egg plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Soul-cakers plays"}}, {"@id": "_:nf3fd39f5c8914b80be1ff2c2e1cf7813b38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Soul-cakers plays"}}], "@id": "/authorities/genreForms/gf2014026444"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026445", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMuwashsha\u1e25\u0101t", "identifiers:lccn": "gf2014026445", "madsrdf:adminMetadata": [{"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b1"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Muwashsha\u1e25\u0101t"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b5"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b6"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b7"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b8"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b9"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b10"}], "madsrdf:hasVariant": [{"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b11"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b14"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b17"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Arabic poems consisting of five to seven strophes that are each divided into two parts following differing rhyme patterns."}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:17:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Muwashsha\u1e25\u0101t"}}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 167 (Unlike classical poetry, the muwashshah is made up of strophes, usually five in number, and is polyrhyme. The form is said to owe its name to the wishah, a girdle encircling the body and embroidered with alternating colors; indeed, two elements do alternate regularly through the poem. These are the aghsan (branches: sing. ghusn) whose rhyme is uniform within each strophe but changes from one strophe to another; and the asmat (threads on which pearls are strung; sing. simt), whose rhymes are common to all strophes)"}, "madsrdf:citationSource": "Menocal, M. The literature of Al-Andalus, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 126 (muwassha\u1e25\u0101t, singular muwashsha\u1e25 (masc.) or muwashsha\u1e25a (fem.); girdle poem)"}, "madsrdf:citationSource": "Abu-Haidar, J.A. Hispano-Arabic literature and the early Proven\u00e7al lyrics, 2001, via Google books, July 11, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(muwashsha\u1e25 (Arabic: \"ode\"), an Arabic poetic genre in strophic form developed in Muslim Spain in the 11th and 12th centuries.)"}, "madsrdf:citationSource": "Encyclop\u00e6dia Britannica online, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 165 (Muwashah, pl. tawashih, means literally \"a postclassical form of Arab poetry, arranged in stanzas.\" It is used also to refer to poems which are sung but follow the same meters. Several types of tawashih exist, the religious tawashih and the secular tawashih)"}, "madsrdf:citationSource": "Middle Eastern Muslim women speak, c1977, via Google books, July 11, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Al-Andalus, Poetry of: Ar. The muwashshah consists of five to seven strophes, each in two parts (ghu\u1e63n [pl. agh\u1e63\u0101n] and sim\u1e6d [pl. asm\u0101\u1e6d]). The agh\u1e63\u0101n all have the same metrical and rhyming patterns, but the rhyme sound changes from strophe to strophe; the asm\u0101\u1e6d are uniform in meter and in rhyme sound throughout the poem. The poem tends to begin with an opening sim\u1e6d. The final sim\u1e6d, around which the whole poem was probably composed, is the much-discussed kharja. The kharja is written either in vernacular Ar., in Ibero-Romance, or in some combination of the two; and it is generally believed to be a quotation from vernacular songs otherwise lost; under Hebrew Prosody and Poetics: The muwashsha\u1e25, as it was known in Ar. (Heb. shir ezor, \"girdle poem\"), was usually devoted to the genre of love poetry or, in a secondary devel., to panegyric; muwashsha\u1e25\u0101t; under Kharja: (also xarja; Sp. jarcha); the term kharja, along with its less common variant, markaz, refers to the final segment (Ar. qufl) of the Andalusi poetic form known as the muwashsha\u1e25 (Sp. moaxaj\u00e1))"}, "madsrdf:citationSource": "New Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 252 (the girdle poem (Arabic muwa\u0161\u0161a\u1e25))"}, "madsrdf:citationSource": "Simon, U. Four approaches to the Book of Psalms, 1991, via Google books, July 11, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Taw\u0101sh\u012b\u1e25"}}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Taw\u0101sh\u012b\u1e25"}}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Girdle poems"}}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Girdle poems"}}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Muwashshahs"}}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Muwashshahs"}}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tawsh\u012b\u1e25"}}, {"@id": "_:ndb4a59c1a62b44ff8655f207b58c25c6b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tawsh\u012b\u1e25"}}], "@id": "/authorities/genreForms/gf2014026445"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026446", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMystery and miracle plays", "identifiers:lccn": "gf2014026446", "madsrdf:adminMetadata": [{"@id": "_:n40a671f0b80340659f1c64a8f7d39040b1"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mystery and miracle plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n40a671f0b80340659f1c64a8f7d39040b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026501"}, "madsrdf:hasSource": [{"@id": "_:n40a671f0b80340659f1c64a8f7d39040b5"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b6"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b7"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b8"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b9"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b10"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b11"}], "madsrdf:hasVariant": [{"@id": "_:n40a671f0b80340659f1c64a8f7d39040b12"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b15"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b18"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b21"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b24"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b27"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b30"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Medieval religious plays that present biblical stories or stories of miracles performed by saints."}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:18:15"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mystery and miracle plays"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "miracle play (A kind of medieval religious play representing non-scriptural legends of saints or of the Virgin Mary. The term is often confusingly applied also to the mystery plays, which form a distinct body of drama based on biblical stories) mystery play (A major form of popular medieval religious drama, representing a scene from the Old or New Testament) pageant (A wagon used as a mobile stage on which were performed mystery plays and related dramas in the Middle Ages. The term is sometimes also applied to a play performed on such a moveable stage, usually a mystery play)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sacra rappresentazione, (Italian: \"holy performance\"), in theatre, 15th-century Italian ecclesiastical drama similar to the mystery plays of France and England and the auto sacramental of Spain. Originating and flourishing in Florence, these religious dramas represented scenes from the Old and New Testaments, from pious legends, and from the lives of the saints)"}, "madsrdf:citationSource": "Encyclop\u00e6dia Britannica online, Nov. 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Mystery play (medieval religious play which derives from Liturgical Drama, but differs in being wholly or partly in the vernacular and not chanted but spoken. Also, it was performed out of doors, in front of the church, in the market square, or on perambulating Pageants. The earlier English name for it was Miracle Play, now seldom used, and a better name would be Bible-histories, since each play was really a cycle of plays based on the Bible, from the Creation to the Second Coming) Miracle play (in English medieval times a synonym for Mystery Play; in France the term was used for plays in which the central incident was a miraculous intervention in human affairs by the Virgin Mary or one of the saints, St Nicholas being a favourite subject)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983:", "madsrdf:citationStatus": "found"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: English Corpus Christi cycle drama; The Magi character in the cycle drama; The comic elements in the Corpus Christi drama; The harrowing of hell in the English mystery cycles : perspectives on the Corpus Christi drama; Two Coventry Corpus Christi plays; Period pieces : remnants of mystery drama in Shakespeare; The saint's play in medieval England; The saint play in medieval Europe)"}, "madsrdf:citationSource": "OCLC, Mar. 12, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pageant: Originally the movable stage or platform on which the medieval mystery plays were presented. Later, the term was applied to plays acted on this platform)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Sacra rappresentazione: sacre rappresentazioni; rappresentazioni sacre)"}, "madsrdf:citationSource": "Italian Wikipedia, Nov. 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "mystery plays (Medieval plays that depict scenes from the Bible. The plays were made up of individual episodes that formed a cycle covering the range of biblical history from the story of Adam to the Last Judgment; productions were extraordinary spectacles, performed in cities in connection with certain feast days, particularly the feast of Corpus Christi) miracle play (A form of medieval drama centered on a miracle performed either by the Virgin Mary or a saint. The term miracle play is also sometimes used to describe the English cycle plays more commonly referred to as mystery plays, although the latter term is usually reserved for plays based upon biblical incidents.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n40a671f0b80340659f1c64a8f7d39040b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pageants (Mystery and miracle plays)"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pageants (Mystery and miracle plays)"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n40a671f0b80340659f1c64a8f7d39040b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Miracle plays"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Miracle plays"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n40a671f0b80340659f1c64a8f7d39040b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sacre rappresentazioni"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sacre rappresentazioni"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n40a671f0b80340659f1c64a8f7d39040b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rappresentazioni sacre"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rappresentazioni sacre"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n40a671f0b80340659f1c64a8f7d39040b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bible-histories (Drama)"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bible-histories (Drama)"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n40a671f0b80340659f1c64a8f7d39040b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mystery and miracle drama"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mystery and miracle drama"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n40a671f0b80340659f1c64a8f7d39040b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mysteries (Religious drama)"}}, {"@id": "_:n40a671f0b80340659f1c64a8f7d39040b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mysteries (Religious drama)"}}], "@id": "/authorities/genreForms/gf2014026446"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026447", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMythological plays", "identifiers:lccn": "gf2014026447", "madsrdf:adminMetadata": [{"@id": "_:n77146c9801724a5caf396b777e645872b1"}, {"@id": "_:n77146c9801724a5caf396b777e645872b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mythological plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n77146c9801724a5caf396b777e645872b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:n77146c9801724a5caf396b777e645872b5"}, {"@id": "_:n77146c9801724a5caf396b777e645872b6"}, {"@id": "_:n77146c9801724a5caf396b777e645872b7"}, {"@id": "_:n77146c9801724a5caf396b777e645872b8"}, {"@id": "_:n77146c9801724a5caf396b777e645872b9"}], "madsrdf:hasVariant": [{"@id": "_:n77146c9801724a5caf396b777e645872b10"}, {"@id": "_:n77146c9801724a5caf396b777e645872b13"}, {"@id": "_:n77146c9801724a5caf396b777e645872b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays based on mythological themes."}, {"@id": "_:n77146c9801724a5caf396b777e645872b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n77146c9801724a5caf396b777e645872b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:18:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n77146c9801724a5caf396b777e645872b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mythological plays"}}, {"@id": "_:n77146c9801724a5caf396b777e645872b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Crumpton, M.N. Theseus : a mythological play for parlor and school in five acts, 1892.", "madsrdf:citationStatus": "found"}, {"@id": "_:n77146c9801724a5caf396b777e645872b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Calder\u00f3n de la Barca, P. Three mythological plays of Calder\u00f3n, 1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:n77146c9801724a5caf396b777e645872b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Shelley, M.W. Proserpine & Midas : two unpublished mythological dramas, 1922.", "madsrdf:citationStatus": "found"}, {"@id": "_:n77146c9801724a5caf396b777e645872b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mythological drama; plays based on themes taken from the Sanskrit epics and Hindu or Buddhist mythology; popularly known as mythological plays)"}, "madsrdf:citationSource": "The Oxford companion to Indian theatre, 2004", "madsrdf:citationStatus": "found"}, {"@id": "_:n77146c9801724a5caf396b777e645872b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bishop, C. Mythic plays, c2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n77146c9801724a5caf396b777e645872b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77146c9801724a5caf396b777e645872b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mythological drama"}}, {"@id": "_:n77146c9801724a5caf396b777e645872b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mythological drama"}}, {"@id": "_:n77146c9801724a5caf396b777e645872b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77146c9801724a5caf396b777e645872b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mythic plays"}}, {"@id": "_:n77146c9801724a5caf396b777e645872b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mythic plays"}}, {"@id": "_:n77146c9801724a5caf396b777e645872b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n77146c9801724a5caf396b777e645872b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mythic drama"}}, {"@id": "_:n77146c9801724a5caf396b777e645872b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mythic drama"}}], "@id": "/authorities/genreForms/gf2014026447"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026448", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNarrative poetry", "identifiers:lccn": "gf2014026448", "madsrdf:adminMetadata": [{"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b1"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Narrative poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026310"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026404"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026457"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026511"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026559"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026574"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026038"}], "madsrdf:hasSource": [{"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b5"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b6"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b7"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b8"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b9"}], "madsrdf:hasVariant": [{"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b10"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b13"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that tell a story."}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T16:36:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Narrative poetry"}}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(narrative poetry: Narrative turns the raw material of story--the \"telling\" of a concatenation of events unfolding in linear time--into a (more or less) artful organization of those events that may complicate their chronology, suggest their significance, emphasize their affect, or invite their interpretation; poetic narrative)"}, "madsrdf:citationSource": "New Princeton encyclopedia of poetry and poetics, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(idyll 1 a : a simple descriptive work in poetry or prose that deals with rustic life or pastoral scenes or suggests a mood of peace and contentment. b : a narrative poem (as Tennyson's Idylls of the King) treating an epic, romantic, or tragic theme. Variants of idyll: idyl)"}, "madsrdf:citationSource": "Merriam-Webster online, Feb. 17, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(narrative poem: a nondramatic poem that tells a story)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(idyll: A narrative poem based on a romantic, epic, or tragic theme, for example, Idylls of the King (1859) by Alfred, Lord Tennyson, an episodic retelling of the fables of the Holy Grail, Camelot, Round Table, and Morte d'Arthur; idyl: From the Greek word meaning \"little picture\"--a short poem describing the simplicity and innocence of rural, pastoral, or domestic life. The origin of this literary form can be traced to Theocritus, who described pastoral life in Sicily for readers in Alexandria during the 3rd century B.C. An eclogue is a type of idyl)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Feb. 17, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Narrative poem. A poem that tells a story. Narrative is one of the four traditional modes of poetry, along with lyric, drama, and didactic. Ballads and epics are two common forms of narrative poetry.)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Idyls (Narrative poetry)"}}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Idyls (Narrative poetry)"}}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Idylls (Narrative poetry)"}}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Idylls (Narrative poetry)"}}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poetic narratives"}}, {"@id": "_:nee5eef88a7fd4ea68e8f56387f631c43b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poetic narratives"}}], "@id": "/authorities/genreForms/gf2014026448"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026449", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNautical drama", "identifiers:lccn": "gf2014026449", "madsrdf:adminMetadata": [{"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b1"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nautical drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026432"}, "madsrdf:hasSource": [{"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b5"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b6"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b7"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b8"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b9"}], "madsrdf:hasVariant": [{"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b10"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b13"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b16"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Melodramas of the 18th and 19th centuries that featured a heroic British sailor confronting villains at sea or on land."}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:07:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nautical drama"}}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 309 (The 1820s and 1830s were the 'great age' of nautical melodrama, in which London's theatres produced 'countless' works in the genre; As the self-proclaimed home of the 'tar drama', the Surrey attracted a socially diverse audience that included dockyard labourers and their families. In 1829, it had a great hit with Douglas Jerrold's Black-Eyed Susan; while no subsequent naval play would match its success, all would replicate Black-Eyed Susan's depiction of the honest sailor pitched into violent combat with a villain of the seas, often a pirate or slave trader)"}, "madsrdf:citationSource": "Journal of Victorian Culture, Vol. 16, no 3 (2011):", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 98-99 (Nautical Melodrama. An authentically English, popular, and often radical genre, nautical melodrama flourished especially in the 1820s and 1830s; nautical plays often alluded to specific historical events; nautical melodrama focuses its attention through particular theatrical types and figures--like the Tar and the pirate--as well as through such thematic obsessions as the hierarchical structure of absolute authority on board ship and the traumatic disruptions of the family left on shore; nautical melodrama clearly displays its commitment to loyal service and national pride, but it also emphasizes the oppressive inequalities engendered on the common man and woman; J.T. Cross's The Purse; or The Benevolent Tar (1794) is generally taken to be the first nautical melodrama, but Douglas Jerrold's Black-Ey'd Susan; or, All in The Downs (Surrey, 1829) is always considered to be the canonical example of the genre)"}, "madsrdf:citationSource": "Williams, C. Gilbert and Sullivan, c2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 33 (He is the heroic sailor, Jack Tar ... the most powerful instrument of imperialist ideology on the nineteenth-century stage) p. 39 (the Tar melodramas; many nautical plays involve shadow manifestations of the Tar, as bloodthirsty pirates) p. 47 (the Tar who struck the perfect note of the dockside community was of course William on Black Eye'd Susan; Tar dramas) p. 52 (Tar plays) p. 59 (the Jack Tar melodrama)"}, "madsrdf:citationSource": "Bratton, J. Acts of supremacy, 1991:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(England was a seafaring nation, and in the 1820s and 1830s a mania for nautical drama gripped the London stage. Plays featuring the exploits of brave, patriotic, honest sailors battling at sea or safe in harbour included stirring songs, picturesque hornpipes, nautical jargon, spectacular scenery and effects, and sentimental endings. They presented a hopelessly unrealistic view of life in the British navy, and audiences adored them; Although the craze for nautical drama reached a peak in the 1830s, the Pavilion staged nautical drama well into the 1870s)"}, "madsrdf:citationSource": "Haill, C. Nautical drama, via East London Theatre Archive website, May 17, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nautical Drama, a type of romantic melodrama popular in the late 18th and early 19th centuries, which has as its hero a 'Jolly Jack Tar', a lineal descendant of the sailor characters in the novels of Smollett, who was himself the author of one of the earliest plays of this kind, The Reprisal; or, the Tars of Old England (1757). The Jack Tar was further popularized by the elder Charles Dibdin and by the naval victories of Nelson, before being given its final form in the noble-hearted William, hero of Jerrold's Black-Ey'd Susan; or, All in the Downs (1829). The character continued to flourish in the minor 'transpontine' theatres, particularly at the Surrey, until well into the 1880s. Unlike Aquatic Drama, in which the water itself often seems to have played the chief part, nautical drama usually took place on dry land, and had nothing in common with the naumachiae, or mimic sea-fights, of Roman times, given in an amphitheatre specially built for the purpose by Augustus on the right bank of the Tiber, or with the splendid water-pageants given in Renaissance Italy, often with the help of complicated machinery.)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Jack Tar melodramas"}}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jack Tar melodramas"}}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tar drama"}}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tar drama"}}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tar melodramas"}}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tar melodramas"}}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nautical melodramas"}}, {"@id": "_:nf8bdbab5b7d54a438bf3aa2c0dbb6df9b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nautical melodramas"}}], "@id": "/authorities/genreForms/gf2014026449"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026450", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aN\u014d plays", "identifiers:lccn": "gf2014026450", "madsrdf:adminMetadata": [{"@id": "_:nedfc615faf484aefa8c971695815d502b1"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "N\u014d plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:nedfc615faf484aefa8c971695815d502b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasEarlierEstablishedForm": [{"@id": "_:nedfc615faf484aefa8c971695815d502b5"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b8"}], "madsrdf:hasSource": [{"@id": "_:nedfc615faf484aefa8c971695815d502b11"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b12"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b13"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b14"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b15"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b16"}], "madsrdf:hasVariant": [{"@id": "_:nedfc615faf484aefa8c971695815d502b17"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b20"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b23"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b26"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b29"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Highly ritualized Japanese plays incorporating music, dance, and poetry.", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2013025002"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2013025005"}]}, {"@id": "_:nedfc615faf484aefa8c971695815d502b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-24T10:11:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "N\u014d plays"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nedfc615faf484aefa8c971695815d502b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised n\u014d plays"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised n\u014d plays"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nedfc615faf484aefa8c971695815d502b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed n\u014d plays"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed n\u014d plays"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 6 (n\u00f4gaku (Noh drama))"}, "madsrdf:citationSource": "The noh drama, 1937:", "madsrdf:citationStatus": "found"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (N\u014d: Also spelled noh. Rigidly traditional Japanese drama which in its present form dates back to the fourteenth century. N\u014d plays are short dramas combining music, dance, and lyrics with a highly stylized and ritualistic presentation. Virtually every aspect of a production--including costumes, masks, and a highly symbolic setting--is prescribed by tradition.)"}, "madsrdf:citationSource": "Wilson, E. The theater experience, c2004, via McGraw-Hill Higher Education online learning center, Nov. 14, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 433-434 (n\u014d plays; general tone of n\u014d should be noble; the language is honorific and sonorous, whatever the character for whom it is written; subject matter mainly taken from Japan's classical literature; players are all male; comic interludes called ky\u014dgen ('mad words') were sometimes performed between n\u014d plays)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983:", "madsrdf:citationStatus": "found"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Noh (or N\u014d) Plays. The most important form of Japanese drama; The noh plays are harmonious combinations of dance, poetry, music, mime, and acting. There are 240 noh plays in the standard repertory, all written between 1300 and 1600; originally part of the religious ritual of the Japanese feudal aristocracy; short, one or two acts, usually presented at a festival in programs consisting of one each of the five types of noh plays)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(n\u014d (noh): A traditional form of Japanese drama characterized by highly ritualized chant and gesture, and its use of masked actors. Combining music, dance, and speech in prose and verse, the n\u014d play derives from religious rituals, and is performed by an all-male cast, originally for an aristocratic audience. More than 200 such plays survive from as early as the 14th century, mostly on religious and mythological subjects.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(n\u00f4gaku theatre: N\u00f4gaku encompasses two types of theatre: Noh and Ky\u00f4gen, which are performed in the same space)"}, "madsrdf:citationSource": "UNESCO WWW site, Aug. 6, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nedfc615faf484aefa8c971695815d502b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nedfc615faf484aefa8c971695815d502b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised n\u014d plays"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised n\u014d plays"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nedfc615faf484aefa8c971695815d502b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Noh plays"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noh plays"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nedfc615faf484aefa8c971695815d502b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Noh drama"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noh drama"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nedfc615faf484aefa8c971695815d502b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "N\u014d drama"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "N\u014d drama"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nedfc615faf484aefa8c971695815d502b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed n\u014d plays"}}, {"@id": "_:nedfc615faf484aefa8c971695815d502b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed n\u014d plays"}}], "@id": "/authorities/genreForms/gf2014026450"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026451", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNoir comics", "identifiers:lccn": "gf2014026451", "madsrdf:adminMetadata": [{"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb1"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Noir comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026279"}, "madsrdf:hasSource": [{"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb5"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb6"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb7"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb8"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb9"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb10"}], "madsrdf:hasVariant": {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics about crime and detection that feature violence and treachery and a lack of distinction between criminals and heroes."}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:19:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noir comics"}}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (crime noir - the hottest genre of comics and graphic novels today)"}, "madsrdf:citationSource": "Hart, C. Drawing crime noir for comics and graphic novels, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "series statement (Marvel noir)"}, "madsrdf:citationSource": "Hine, D. Spider-man noir. Eyes without a face, c2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(noir: a kind of crime novel or thriller characterized less by rational investigation (as in the classic detective story) than by violence, treachery, and moral confusion; although noir fiction derives in important ways from the hard-boiled school of detective writing and overlaps with it at some points ... it can be distinguished from most detective stories and from other kinds of thriller by its powerful tendency to dissolve orderly distinctions between the roles of criminal and hero; hard-boiled: a term applied both to a certain kind of detective character, usually a world-weary private investigator, and to a special tradition of American detective story in which these characters are prominent)"}, "madsrdf:citationSource": "Oxford dictionary of literary terms, via Oxford reference online, Nov. 2, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Martinbrough, S. How to draw noir comics, 2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Noir comic books, strips, etc. UF Crime noir comic books, strips, etc. BT Detective and mystery comic books, strips, etc.)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Noir : a collection of crime comics, 2009.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crime noir comics"}}, {"@id": "_:n3ac87c7456af45d8ba6f4c0661c9acafb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crime noir comics"}}], "@id": "/authorities/genreForms/gf2014026451"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026452", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNoir fiction", "identifiers:lccn": "gf2014026452", "madsrdf:adminMetadata": [{"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b1"}, {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Noir fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026280"}, "madsrdf:hasSource": [{"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b5"}, {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b6"}, {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b7"}], "madsrdf:hasVariant": {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features violence and treachery and a lack of distinction between criminals and heroes."}, {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:20:23"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noir fiction"}}, {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(noir: a kind of crime novel or thriller characterized less by rational investigation (as in the classic detective story) than by violence, treachery, and moral confusion; although noir fiction derives in important ways from the hard-boiled school of detective writing and overlaps with it at some points ... it can be distinguished from most detective stories and from other kinds of thriller by its powerful tendency to dissolve orderly distinctions between the roles of criminal and hero; hard-boiled: a term applied both to a certain kind of detective character, usually a world-weary private investigator, and to a special tradition of American detective story in which these characters are prominent)"}, "madsrdf:citationSource": "Oxford dictionary of literary terms, via Oxford reference online, Nov. 2, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Noir fiction. A category of modern crime fiction; use for fiction of crime and detection, often in a grim urban setting, featuring petty, amoral criminals and other down-and-out characters, and permeated by a feeling of disillusionment, pessimism and despair. BT Mystery fiction)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Donnellan, M. El Nino : a crime-noir thriller set between Galway and Mayo, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Crime noir fiction"}}, {"@id": "_:n4f2fb4e9c047443eaf3ce3383127a7b1b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Crime noir fiction"}}], "@id": "/authorities/genreForms/gf2014026452"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026453", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNonfiction comics", "identifiers:lccn": "gf2014026453", "madsrdf:adminMetadata": [{"@id": "_:nd66adca972e1499aab10a58d78e88b47b1"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nonfiction comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:nd66adca972e1499aab10a58d78e88b47b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026244"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026292"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026305"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026385"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026579"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026049"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026049"}], "madsrdf:hasSource": [{"@id": "_:nd66adca972e1499aab10a58d78e88b47b5"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b6"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b7"}], "madsrdf:hasVariant": [{"@id": "_:nd66adca972e1499aab10a58d78e88b47b8"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b11"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b14"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b17"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that are intended to be educational or informational or that present facts or true accounts."}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:24:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonfiction comics"}}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 33-34 (Nonfiction comic books have been around for more than 60 years; historical and contemporary biographies, history, science, and current events; in recent years there has been a rise in nonfiction graphic novels, often from non-comic book publishers; graphic nonfiction)"}, "madsrdf:citationSource": "Serchay, D.S. The librarian's guide to graphic novels for children and tweens, c2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 51 (list of genres includes: nonfiction)"}, "madsrdf:citationSource": "Karp, J. Graphic novels in your school library, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Non-fiction comics (Non-fiction comics, also known as graphic non-fiction, is non-fiction in the comics medium, embracing a variety of formats from comic strips to trade paperbacks)"}, "madsrdf:citationSource": "Wikipedia, Dec. 11, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd66adca972e1499aab10a58d78e88b47b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nonfictional comics"}}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonfictional comics"}}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd66adca972e1499aab10a58d78e88b47b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graphic nonfiction"}}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic nonfiction"}}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd66adca972e1499aab10a58d78e88b47b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Graphic non-fiction"}}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Graphic non-fiction"}}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd66adca972e1499aab10a58d78e88b47b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Non-fictional comics"}}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Non-fictional comics"}}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd66adca972e1499aab10a58d78e88b47b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Non-fiction comics"}}, {"@id": "_:nd66adca972e1499aab10a58d78e88b47b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Non-fiction comics"}}], "@id": "/authorities/genreForms/gf2014026453"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026454", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNonfiction novels", "identifiers:lccn": "gf2014026454", "madsrdf:adminMetadata": [{"@id": "_:nb55154d287d44455b1ca92164a00ba2cb1"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nonfiction novels"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb55154d287d44455b1ca92164a00ba2cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026074"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}], "madsrdf:hasSource": [{"@id": "_:nb55154d287d44455b1ca92164a00ba2cb5"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb6"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb7"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb8"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb9"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb10"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb11"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb12"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb13"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb14"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb15"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb16"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb17"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb18"}], "madsrdf:hasVariant": [{"@id": "_:nb55154d287d44455b1ca92164a00ba2cb19"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb22"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb25"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb28"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb31"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb34"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb37"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction of any length that intentionally blends verifiably factual journalistic research with fictional elements."}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-07-13T14:04:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonfiction novels"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(non-fiction novel/documentary fiction: a novel based on real events and people, which largely draws on documentary evidence such as newspaper articles, official papers, personal letters, and interviews. Elements of the story's narrative, however--in particular the conversations and thoughts of the protagonists--are the author's invention)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 5th ed., via Wiley online, Aug. 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 23 (fictional nonfiction and nonfictional fiction; one of the predominant themes of postmodernism is the blurring of lines between fiction and nonfiction; writers of this genre know that it is obvious to the reader that they are lying to tell the truth; in her essay \"Facts and Fancy: The 'Nonfiction Short Story,'\" Michele Morano explores short stories and essays that blur distinctions between fiction and nonfiction and offer the reader a meta-awareness of \"genre negotiation.\" Morano identifies nonfiction short stories as having the \"reality warp\" of fiction complicated by nonfictional elements that induce \"double vision\" in the reader)"}, "madsrdf:citationSource": "The postmodern short story, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(new journalism: genre of journalism also known as 'faction' or 'non-fiction novel' developed in the United States in the 1960s and 1970s involving a new blend of fictional presentation with journalistic research and reportage; faction: a short\u2010lived portmanteau word denoting works that present verifiably factual contents in the form of a fictional novel; although still sometimes used by journalists, the term suffers from the disadvantage of already meaning something else (i.e. a conspiratorial group within a divided organization), so the preferred term is New Journalism)"}, "madsrdf:citationSource": "Oxford dictionary of literary terms, via Oxford reference online, Nov. 2, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mike, E.C. Words are forever in the heart : fiction and non-fiction short stories, 2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 87-88 (Microhistories and nonfiction short stories; both genres emerged in the 1970s; narrative journalism and the nonfiction short story were reactions against investigative journalism's emphasis on fact finding over prose style; both microhistories and nonfiction short stories tend to concern themselves with the everyday experiences of ordinary people; both genres self-consciously employ the techniques of dramatic fiction, including character development, plotting, and conflict resolution; microhistories are not nonfiction short stories; they are micro in focus, not in length)"}, "madsrdf:citationSource": "Why we write : the politics and practice of writing for social change, \u00a92006:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Nonfiction novel (literary genre; story of actual people and actual events told with the dramatic techniques of a novel) New Journalism (New Journalism, American literary movement in the 1960s and '70s that pushed the boundaries of traditional journalism and nonfiction writing. The genre combined journalistic research with the techniques of fiction writing in the reporting of stories about real-life events. The writers often credited with beginning the movement include Tom Wolfe, Truman Capote, and Gay Talese; writers in the genre immersed themselves in their subjects, at times spending months in the field gathering facts through research, interviews, and observation. Their finished works were very different, however, from the feature stories typically published in newspapers and magazines of the time. Instead of employing traditional journalistic story structures and an institutional voice, they constructed well-developed characters, sustained dialogue, vivid scenes, and strong plotlines marked with dramatic tension. They also wrote in voices that were distinctly their own. Their writing style, and the time and money that their in-depth research and long stories required, did not fit the needs or budgets of most newspapers ... Many of those writers went on to publish their stories in anthologies or to write what became known as \"nonfiction novels\")"}, "madsrdf:citationSource": "Britannica online, Apr. 27, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Non-fiction novel (The non-fiction novel is a literary genre which, broadly speaking, depicts real historical figures and actual events woven together with fictitious conversations and using the storytelling techniques of fiction. The non-fiction novel is an otherwise loosely defined and flexible genre. The genre is sometimes referred to using the slang term \"faction\", a portmanteau of the words fact and fiction)"}, "madsrdf:citationSource": "Wikipedia, Apr. 20, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nonfiction is a genre in literature in which real events are depicted using story-telling techniques. Though the people and situations written about are true, the writer has creative license with how to tell the story. This makes the genre's definition rather flexible. Many nonfiction novels are written in such categories as biographies, historical events, travel, science, religion, philosophy, and art; captures the drama of the novel, only with true life facts)"}, "madsrdf:citationSource": "Nonfiction novel: definition & examples, via Study.com website, Apr. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nonfiction novel. UF Journalistic novel; New journalism. BT Fiction; Reportage literature)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 156 (Mat Johnson is a novelist who sometimes writes other things. He is the author of ... the nonfiction novella The Great Negro Plot)"}, "madsrdf:citationSource": "Black cool : one thousand streams of Blackness, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(short stories about the Holocaust that blur the line between storytelling and reportage; examples of \"nonfiction short stories\" as opposed to \"nonfiction novels\")"}, "madsrdf:citationSource": "Kluge, A. \"Wer ein Wort des Trostes spricht, ist ein Verr\u00e4ter\", 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: The nonfiction novel; The mythopoeic reality : the postwar American nonfiction novel; Fact & fiction : the new journalism and the nonfiction novel)"}, "madsrdf:citationSource": "OCLC, Nov. 2, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Tuba Arshad: I write fictional and non-fictional short stories and novels, along with informative and entertaining articles for magazines; under Joan Mukhwana: An intuitive, innovative and dynamic creative writer who has written several fictional and non-fictional short stories, poetry and is presently working on a novel)"}, "madsrdf:citationSource": "Upwork website, Apr. 20, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (The first part of the book is an in-depth portrait of Barbara Erickson that tells her story and captures her voice ... written by a journalist in a nonfiction novella form)"}, "madsrdf:citationSource": "Arluke, A. Inside animal hoarding : the case of Barbara Erickson and her 552 dogs, \u00a92009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb55154d287d44455b1ca92164a00ba2cb20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Faction (Nonfiction novels)"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Faction (Nonfiction novels)"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb55154d287d44455b1ca92164a00ba2cb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Journalistic novels"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Journalistic novels"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb55154d287d44455b1ca92164a00ba2cb26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fictional non-fiction"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fictional non-fiction"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb55154d287d44455b1ca92164a00ba2cb29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Documentary fiction"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Documentary fiction"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb55154d287d44455b1ca92164a00ba2cb32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Non-fictional fiction"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Non-fictional fiction"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb55154d287d44455b1ca92164a00ba2cb35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fictional nonfiction"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fictional nonfiction"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb55154d287d44455b1ca92164a00ba2cb38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Non-fiction novels"}}, {"@id": "_:nb55154d287d44455b1ca92164a00ba2cb38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Non-fiction novels"}}], "@id": "/authorities/genreForms/gf2014026454"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026455", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNonsense verse", "identifiers:lccn": "gf2014026455", "madsrdf:adminMetadata": [{"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b1"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nonsense verse"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026337"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026391"}], "madsrdf:hasSource": [{"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b5"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b6"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b7"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b8"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b9"}], "madsrdf:hasVariant": [{"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b10"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b13"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Highly rhythmic, humorous, light poetry in which sense is subordinated to sound."}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:24:45"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonsense verse"}}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"The Edward Lear homepage\"; nonsense rhymes)"}, "madsrdf:citationSource": "Nonsenselit WWW site, April 13, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nonsense Verse; the versified instance of nonsense lit., a category of writing that transforms into virtues the vices associated with the pejorative term nonsense: silliness, incomprehensibility, childishness, pointlessness, and triviality, among others; critics have disagreed over whether nonsense is a genre, or something more nebulous; critics treat the works of Edward Lear and Lewis Carroll as the foremost exemplars of the category in Eng.; critics draw a sharp distinction between nonsense and mere gibberish; no just light but willfully unserious: its very point often seems to be pointlessness)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(amphigory: plural amphigories; a nonsense verse or composition; a rigmarole with apparent meaning which proves to be meaningless)"}, "madsrdf:citationSource": "Merriam-Webster online, Aug. 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(amphigory: amphigory (Gk 'circle on both sides') The term has come to mean a kind of burlesque or parody (qq.v.), especially a kind of nonsense verse (q.v.) which appears to be going to make sense but does not. A well-known example is Swinburne's Nephelidia.)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 5th ed., via Wiley online, Aug. 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nonsense verse: a form of light verse that is used to amuse or instruct through the creation of a highly rhythmic, melopoetic, and onomatopoetic verse in which sense is subordinated to sound)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nonsense rhymes"}}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonsense rhymes"}}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Amphigories"}}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Amphigories"}}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nonsense poetry"}}, {"@id": "_:nf7f9ac0b5a6d4da9a334e00520084bc0b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nonsense poetry"}}], "@id": "/authorities/genreForms/gf2014026455"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026456", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNovelle", "identifiers:lccn": "gf2014026456", "madsrdf:adminMetadata": [{"@id": "_:n822525e20c9843b18aa00b9e62fa5522b1"}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Novelle"}, "madsrdf:elementList": {"@list": [{"@id": "_:n822525e20c9843b18aa00b9e62fa5522b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026347"}, "madsrdf:hasSource": [{"@id": "_:n822525e20c9843b18aa00b9e62fa5522b5"}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b6"}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b7"}], "madsrdf:hasVariant": [{"@id": "_:n822525e20c9843b18aa00b9e62fa5522b8"}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short fictional narratives popular during the Renaissance that generally featured ordinary townspeople in realistic settings and were often gathered together in collections unified by a frame tale."}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:25:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novelle"}}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 535-536 (nouvelles from fifteenth- and sixteenth-century France; the nouvelle genre; texts of short fiction; the genre's relation to realism, which has been the main focus of scholarship; the importance of the frames)"}, "madsrdf:citationSource": "Renaissance quarterly, summer 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nouvelle. The French term for a short prose tale (called novella by Italian Renaissance writers) that usually depicts in realistic terms illicit love, ingenious trickery, and sensational adventure, often with an underlying moral. Gaining popularity in the late-Middle Ages, the nouvelle often appears in collections, as in Marguerite de Navarre's Heptameron (ca. 1550) and Giovanni Boccacio's Decameron (ca. 1350))"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the novella is defined as a short, prose narrative, usually realistic and often satiric in tone; the characters in a novella are placed in a realistic setting, complete with the rhythms of everyday life and conversation; unlike medieval romances that present an idealized world peopled with noble characters in grand adventures, novelle narrate common incidents in the lives of ordinary townspeople; the genre of the novella originated in thirteenth-century Italy as a brief, well-structured prose narrative including stories of action, experience, brief anecdotes, and accounts of clever sayings with plots of amorous intrigue, clerical corruption and clever tricks; novelle were often gathered together in collections, using a frame tale to unify the stories with a common theme. While the teller of a novella may claim a moral intention for the story, the underlying purpose of the Renaissance novella is to entertain)"}, "madsrdf:citationSource": "Jones, J.A. Renaissance novelle, via WWW, Nov. 2, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n822525e20c9843b18aa00b9e62fa5522b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novellas (Renaissance form)"}}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novellas (Renaissance form)"}}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n822525e20c9843b18aa00b9e62fa5522b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nouvelles"}}, {"@id": "_:n822525e20c9843b18aa00b9e62fa5522b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nouvelles"}}], "@id": "/authorities/genreForms/gf2014026456"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026457", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNovels in verse", "identifiers:lccn": "gf2014026457", "madsrdf:adminMetadata": [{"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b1"}, {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Novels in verse"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b3"}]}, "madsrdf:exampleNote": "Note under [Stories in rhyme]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026448"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026020"}], "madsrdf:hasSource": [{"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b5"}, {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b6"}, {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b7"}], "madsrdf:hasVariant": {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Novel-length fictional narratives expressed in poetry. For short fictional works written in rhymed text see [Stories in rhyme.]"}, {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:20:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novels in verse"}}, {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Novels in verse. UF Verse novels. BT Fiction; Narrative poetry. Here are entered novel-length fictional narratives expressed in poetry. Short fictional works written in rhymed text are entered under Stories in rhyme.)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(verse novels; verse-novels; novels in verse; novel in verse)"}, "madsrdf:citationSource": "OCLC WorldCat, Aug. 20, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Verse novel. A verse novel is a type of narrative poetry in which a novel-length narrative is told through the medium of poetry rather than prose. Either simple or complex stanzaic verse-forms may be used, but there will usually be a large cast, multiple voices, dialogue, narration, description, and action in a novelistic manner)"}, "madsrdf:citationSource": "Wikipedia, July 11, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Verse novels"}}, {"@id": "_:n8103caf75d2646ad9cd66cecf91d60b7b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Verse novels"}}], "@id": "/authorities/genreForms/gf2014026457"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026458", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNovels of manners", "identifiers:lccn": "gf2014026458", "madsrdf:adminMetadata": [{"@id": "_:nc18217ef088d4701ade256ae966cef0cb1"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Novels of manners"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc18217ef088d4701ade256ae966cef0cb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026020"}, "madsrdf:hasSource": [{"@id": "_:nc18217ef088d4701ade256ae966cef0cb5"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb6"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb7"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb8"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb9"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb10"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb11"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb12"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb13"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb14"}], "madsrdf:hasVariant": [{"@id": "_:nc18217ef088d4701ade256ae966cef0cb15"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Realistic fiction that describes in detail the customs, habits, values, and expectations of a particular society."}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-06-17T10:40:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novels of manners"}}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Georgette Heyer, 1902-1974; she is best known for her Regency novels; she \"writes ... historical novels, set in Regency England, in which people never lose their lives, their virtue, or even their tempers\"; Regency romances)"}, "madsrdf:citationSource": "Women writers of Great Britain and Europe, 2013, via Google books, viewed Mar. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novel of manners: work of fiction that re-creates a social world, conveying with finely detailed observation the customs, values, and mores of a highly developed and complex society; the conventions of the society dominate the story, and characters are differentiated by the degree to which they measure up to the uniform standard, or ideal, of behaviour or fall below it; notable writers of the novel of manners from the end of the 19th century into the 20th include Henry James, Evelyn Waugh, Edith Wharton, and John Marquand)"}, "madsrdf:citationSource": "Britannica online academic edition, Nov. 11, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Georgette Heyer's novels (Cotillion, 1953, [genre] Regency)"}, "madsrdf:citationSource": "Kloester, Jennifer. Georgette Heyer, 2013, via Google books, viewed Mar. 26, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under romantic fiction: Romances with a historical setting, such as the Regency novels of Georgette Heyer; under Heyer, Georgette: British writer of historical novels and detective stories; she was an expert on the Regency period; The most popular of her Regency romances include Devil's Cub (1934), Regency Buck (1935), Faro's Daughter (1941), Venetia (1958), and Lady of Quality (1972))"}, "madsrdf:citationSource": "The Oxford companion to twentieth-century literature in English, 1996", "madsrdf:citationStatus": "found"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 192 (If, as in the writings of Jane Austen, Edith Wharton, and John P. Marquand, a realistic novel focuses on the customs, conversation, and ways of thinking and valuing of a particular social class, it is often called a novel of manners.)"}, "madsrdf:citationSource": "Abrams, M. A glossary of literary terms, c1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a regency novel)"}, "madsrdf:citationSource": "Work cat.: Heyer, G. Cotillion, 1953", "madsrdf:citationStatus": "found"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novel of manners. A type of novel in which the social conventions of a given society--its speech, habits, and values--play significant roles. The American version of the form is best exemplified in the novels of Henry James and Edith Wharton)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(novel of manners: a novel that describes in detail the customs, behaviors, habits, and expectations of a certain social group at a specific time and place; usually these conventions shape the behavior of the main characters, and sometimes even stifle or repress them; often the novel of manners is satiric, and it is always realistic in depiction)"}, "madsrdf:citationSource": "Wheeler, K. Literary terms and definitions, via WWW, Nov. 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Regency romance novel; Regencies; Regency novels; Regency romances; the Regency genre; Regencies, which are typically set in the early 1800s in England, are known for their humor, for their heroines who battle against \"stiff judgments\" of an upper-crust society, and for characters and plot that operate within a strict societal structure; Regencies emphasize themes such as love and values and family--not stressing over things we can't control--which translates to money and titles and property in the Regency world)"}, "madsrdf:citationSource": "Moore, H. Several LDS authors pen Regency romance novels, in Deseret news, July 2, 2012, viewed online Mar. 26, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Genres > Historical > Regency (Regency literature is generally set during the period of the English Regency or early 19th century. Rather than simply being versions of contemporary stories transported to a historical setting, Regency novels are a distinct genre with their own plot and stylistic conventions that derive from the works of Jane Austen and Georgette Heyer, and from the fiction genre known as the novel of manners. In particular, most Regencies feature a great deal of intelligent, fast-paced dialog between the protagonists and (traditionally) very little explicit sex or discussion of sex. Other common elements of Regency romances include mystery or farce elements in the plot; references to the Ton (le bon ton); a secondary romance between another couple in addition to the more serious story involving the main protagonists; mistaken identity (deliberate or otherwise); false engagements; marriages of convenience; depictions of activities common during the social season such as balls, routs, carriage riding, theatre events, fittings, suppers, assemblies, etc.; references to, or descriptions of, leisure activities engaged in by fashionable young men of the period, including riding, driving, boxing, gambling, fencing, shooting, etc.)"}, "madsrdf:citationSource": "Goodreads website, Mar. 26, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc18217ef088d4701ade256ae966cef0cb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Regency fiction"}}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Regency fiction"}}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc18217ef088d4701ade256ae966cef0cb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Manners, Novels of"}}, {"@id": "_:nc18217ef088d4701ade256ae966cef0cb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Manners, Novels of"}}], "@id": "/authorities/genreForms/gf2014026458"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026459", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNursery rhymes", "identifiers:lccn": "gf2014026459", "madsrdf:adminMetadata": [{"@id": "_:n8ea8938ffefd46259564d06336bfb21db1"}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Nursery rhymes"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8ea8938ffefd46259564d06336bfb21db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026212"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026219"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026273"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026092"}], "madsrdf:hasSource": [{"@id": "_:n8ea8938ffefd46259564d06336bfb21db5"}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db6"}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db7"}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db8"}], "madsrdf:hasVariant": {"@id": "_:n8ea8938ffefd46259564d06336bfb21db9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-13T18:11:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nursery rhymes"}}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nursery rhymes; nursery rhymes from Mother Goose; nursery poetry; nursery poems; Mother Goose rhymes; Mother Goose and nursery rhymes; Mother Goose nursery rhymes; Mother Goose verses; Mother Goose poems)"}, "madsrdf:citationSource": "OCLC, July 15, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(nursery rhyme: a short rhyme for children that often tells a story)"}, "madsrdf:citationSource": "Merriam-Webster online, March 6, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nursery Rhymes. Verses, either spoken or sung, often originating in oral trad. and adult sensibilities but preserved in the world of young children; the term nursery rhyme was not coined until the early 19th c.; before then, these verses were known in England as \"songs\" or \"ditties\" and in America as Mother Goose rhymes; nursery rhymes tend to be in accentual verse, often in ballad meter)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Nursery rhymes. BT Juvenile literature; Poems. NT Accumulative rhymes)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 15, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8ea8938ffefd46259564d06336bfb21db10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nursery poetry"}}, {"@id": "_:n8ea8938ffefd46259564d06336bfb21db10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nursery poetry"}}], "@id": "/authorities/genreForms/gf2014026459"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026460", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOccasional verse", "identifiers:lccn": "gf2014026460", "madsrdf:adminMetadata": [{"@id": "_:n4ad1ba573b8147c2825983758b8335a5b1"}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Occasional verse"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4ad1ba573b8147c2825983758b8335a5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026255"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026268"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026311"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026317"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026017"}], "madsrdf:hasSource": [{"@id": "_:n4ad1ba573b8147c2825983758b8335a5b5"}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b6"}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b7"}], "madsrdf:hasVariant": [{"@id": "_:n4ad1ba573b8147c2825983758b8335a5b8"}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poetry written for a particular occasion."}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:25:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Occasional verse"}}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Occasional Poem. Occasional poetry is poetry written for a specific occasion about a particular event, including weddings, funerals, and birthdays. Occasional poems can also celebrate or memorialize military, athletic, and political events. Occasional poems can be long or short, in strict forms or in free verse.)"}, "madsrdf:citationSource": "The Teachers & Writers handbook of poetic forms, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Occasional verse (Poetry written for or prompted by a special occasion, e.g. a wedding, funeral, anniversary, birth, military or sporting victory, or scientific achievement. Poetic forms especially associated with occasional verse are the epithalamion, the elegy, and the ode. Occasional verse may be serious or light) Epideictic poetry (verse for special occasions, such as epithalamia, many odes, and other kinds of poems now usually referred to as occasional verses)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Occasional verse: Poetry written in response to a historical occasion or in commemoration of a public event, such as a national holiday or the death of a celebrated person)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ad1ba573b8147c2825983758b8335a5b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Occasional poetry"}}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Occasional poetry"}}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4ad1ba573b8147c2825983758b8335a5b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Epideictic poetry"}}, {"@id": "_:n4ad1ba573b8147c2825983758b8335a5b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Epideictic poetry"}}], "@id": "/authorities/genreForms/gf2014026460"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026461", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOdes", "identifiers:lccn": "gf2014026461", "madsrdf:adminMetadata": [{"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b1"}, {"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Odes"}, "madsrdf:elementList": {"@list": [{"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422"}, "madsrdf:hasSource": [{"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b5"}, {"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b6"}, {"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Highly formal, ceremonious, and complex lyric poems that display strong feeling."}, {"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:20:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Odes"}}, {"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ode: Pindaric ode tends toward occasional verse; Horatian ode tends to be more meditative and personal; Cowleyan, or irregular ode, is a loose form close to the lyric in its personal and emotional nature and the most common type of ode in English. Typically the ode in its various forms is thought of as a long lyrical poem displaying emotion)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ode: a lyric poem usually marked by exaltation of feeling and style, varying length of line, and complexity of stanza forms)"}, "madsrdf:citationSource": "Merriam-Webster online, July 23, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n65b6f07d3c434ede8ab37fe2d5cef465b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ode: in mod. usage, the term for the most formal, ceremonious, and complexly organized form of lyric poetry, usually of considerable length. The serious tone of the ode calls for the use of a heightened diction and enrichment by poetic device, but this lays it open, more readily than any other lyric form, to burlesque)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026461"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026462", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aOne-act plays", "identifiers:lccn": "gf2014026462", "madsrdf:adminMetadata": [{"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b1"}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "One-act plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026569"}, "madsrdf:hasSource": [{"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b5"}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b6"}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b7"}], "madsrdf:hasVariant": [{"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b8"}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-10-16T11:03:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "One-act plays"}}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "English dictionary (one-act play: a short play consisting of only one act)"}, "madsrdf:citationSource": "Collins dictionaries website, Oct. 30, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "One-act play (A one-act play is a play that has only one act, as distinct from plays that occur over several acts. One-act plays may consist of one or more scenes. In recent years, the 10-minute play known as \"flash drama\" has emerged as a popular sub-genre of the one-act play, especially in writing competitions. The origin of the one-act play may be traced to the very beginning of drama: in ancient Greece, Cyclops, a satyr play by Euripides, is an early example.)"}, "madsrdf:citationSource": "Wikipedia, Oct. 30, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Nield, M. Kill me a dragon : a single-act play, 197-", "madsrdf:citationStatus": "found"}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "One-act drama"}}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "One-act drama"}}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Single-act plays"}}, {"@id": "_:n10dfba93b9f44ce2869a0c5770b47e18b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Single-act plays"}}], "@id": "/authorities/genreForms/gf2014026462"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026464", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPageants", "identifiers:lccn": "gf2014026464", "madsrdf:adminMetadata": [{"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b1"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pageants"}, "madsrdf:elementList": {"@list": [{"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026369"}, "madsrdf:hasSource": [{"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b5"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b6"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b7"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b8"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b9"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "The texts of tableaux, songs, dances, and dramatic scenes that commemorate historical events or traditions."}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:21:23"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pageants"}}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Pageant: Early in the 20th century there arose a passion for elaborate and partly processional open-air shows celebrating the history or legends of a particular town, and these were referred to as 'pageants'. The performers were usually amateurs, directed by a professional who was responsible for the songs, dances, and short interludes of dialogue which made up the whole, including sometimes re-enactments of medieval jousting and tournaments)"}, "madsrdf:citationSource": "The Oxford companion to the theatre, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pageant: Originally the movable stage or platform on which the medieval Mystery Plays were presented. Later, the term was applied to plays acted on this platform. In modern usage it describes any sort of spectacular procession which presents tableaux and includes songs, dances and dramatic scenes. This sort of entertainment was fashionable in the early decades of the 20th c., especially in depicting local history.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pageant: A wagon used as a mobile stage on which were performed mystery plays and related dramas in the Middle Ages. The term is sometimes also applied to a play performed on such a moveable stage, usually a mystery play. In a later sense, a pageant is a public procession displaying tableaux and costumes appropriate to the commemoration of some historical event or tradition, sometimes involving short dramatic scenes.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pageant. 1. An elaborate public dramatic presentation that usually depicts a historical or traditional event.)"}, "madsrdf:citationSource": "The American heritage dictionary of the English language, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pageant: An elaborate spectacle or procession. In the Middle Ages, a pageant was a moveable platform on which Mystery Plays were performed. In the Elizabethan Age, processional pageants, celebrating a visit of the queen or other dignitary, frequently included small dramatic skits.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n67c070d3c6ed446a8e612f6d87b9b350b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pageant. 3. an elaborate drama, often staged outdoors, celebrating a historical event or presenting the history of a community)"}, "madsrdf:citationSource": "Collins dictionaries online, Nov. 6, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026464"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026465", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPalinodes", "identifiers:lccn": "gf2014026465", "madsrdf:adminMetadata": [{"@id": "_:n213088aa528544fd81ae9f13d2473e2db1"}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Palinodes"}, "madsrdf:elementList": {"@list": [{"@id": "_:n213088aa528544fd81ae9f13d2473e2db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n213088aa528544fd81ae9f13d2473e2db5"}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db6"}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db7"}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db8"}], "madsrdf:hasVariant": {"@id": "_:n213088aa528544fd81ae9f13d2473e2db9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems in which the poet renounces or retracts a sentiment expressed in an earlier poem."}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:21:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Palinodes"}}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(palinody: palinode; palinode 1: an ode or song recanting or retracting something in an earlier poem; 2: a formal retraction)"}, "madsrdf:citationSource": "Merriam-Webster online, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(palinode. A poem or song retracting some earlier statement by the poet. A notable example in English is Chaucer's The Legend of Good Women, written to recant his earlier defamation of women in Troilus and Criseyde.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Palinode. A poem or poetic passage in which the poet renounces or retracts an earlier poem or type of subject matter. Palinodes are especially common in love poetry.)"}, "madsrdf:citationSource": "Abrams, M. A glossary of literary terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(palinode. A recantation in song or verse. Usually a poem in which a writer retracts or counter-balances a statement made in an earlier poem. As a theme the palinode is not uncommon in love poetry.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n213088aa528544fd81ae9f13d2473e2db10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Palinodies"}}, {"@id": "_:n213088aa528544fd81ae9f13d2473e2db10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Palinodies"}}], "@id": "/authorities/genreForms/gf2014026465"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026466", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPantoums", "identifiers:lccn": "gf2014026466", "madsrdf:adminMetadata": [{"@id": "_:n447f2579a2654b609088198941f58df8b1"}, {"@id": "_:n447f2579a2654b609088198941f58df8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pantoums"}, "madsrdf:elementList": {"@list": [{"@id": "_:n447f2579a2654b609088198941f58df8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026497"}, "madsrdf:hasSource": [{"@id": "_:n447f2579a2654b609088198941f58df8b5"}, {"@id": "_:n447f2579a2654b609088198941f58df8b6"}, {"@id": "_:n447f2579a2654b609088198941f58df8b7"}], "madsrdf:hasVariant": [{"@id": "_:n447f2579a2654b609088198941f58df8b8"}, {"@id": "_:n447f2579a2654b609088198941f58df8b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems composed of four-line stanzas in which the second and fourth lines of each stanza are repeated as the first and third lines of the next."}, {"@id": "_:n447f2579a2654b609088198941f58df8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n447f2579a2654b609088198941f58df8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:21:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n447f2579a2654b609088198941f58df8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pantoums"}}, {"@id": "_:n447f2579a2654b609088198941f58df8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pantuns: A verse form of Malayan origin. A poem of no determinate length, composed of quatrains with internal assonance and rhyming abab. The second and fourth lines of each stanza become the first and third lines of the next. In the last quatrain the first line of the poem re-appears as the last, and the third line as the second. The form was introduced into Western poetry by Ernest Fouinet in the 19th c. Some distinguished French poets used it, notably Victor Hugo)"}, "madsrdf:citationSource": "Cuddon, J. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n447f2579a2654b609088198941f58df8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pantoum (pantun) A verse form of Malay origin, employing quatrains rhyming abab and repetition of whole lines so that the second and fourth lines of each stanza are repeated as the first and third lines of the next, and in the final quatrain the poem's first line appears as the final line, its third line as the second. Unlike the villanelle and the triolet, which use similar kinds of repetition, it has no fixed number of lines. The form, originally known as the pantun, was discovered and domesticated by French poets of the 19th century, under the spelling 'pantoum', which has become standard in English.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n447f2579a2654b609088198941f58df8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pantun (Eng. and Fr. pantoum or pantoun). In contemp. poetry, the pantun is a poem of indeterminate length composed of quatrains in which the second and fourth lines of each stanza serve as the first and third lines of the next. This pattern breaks in the final stanza, whose second and fourth lines are recurrences of the first and third lines of the first stanza; thus, the pantun begins and ends with the same line. The pattern that Westerners associated with the pantun is highly atypical of the Malay-language verse form. The Malay-lang. pantun can have six to twelve lines, but it is usually in four lines consisting of two end-stopped cross-rhyme couplets.)"}, "madsrdf:citationSource": "The Princeton encyc. of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n447f2579a2654b609088198941f58df8b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n447f2579a2654b609088198941f58df8b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pantouns"}}, {"@id": "_:n447f2579a2654b609088198941f58df8b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pantouns"}}, {"@id": "_:n447f2579a2654b609088198941f58df8b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n447f2579a2654b609088198941f58df8b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pantuns"}}, {"@id": "_:n447f2579a2654b609088198941f58df8b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pantuns"}}], "@id": "/authorities/genreForms/gf2014026466"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026467", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aParables", "identifiers:lccn": "gf2014026467", "madsrdf:adminMetadata": [{"@id": "_:ncd2129f9c81b47729222e79c8c296657b1"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Parables"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncd2129f9c81b47729222e79c8c296657b3"}]}, "madsrdf:exampleNote": "Note under [Fables]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026323"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026218"}, "madsrdf:hasSource": [{"@id": "_:ncd2129f9c81b47729222e79c8c296657b5"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b6"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b7"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b8"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b9"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b10"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b11"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b12"}], "madsrdf:hasVariant": {"@id": "_:ncd2129f9c81b47729222e79c8c296657b13"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short, simple stories that convey a moral lesson, and whose main characters are generally humans. For stories intended to teach moral lessons, and whose main characters are generally animals or inanimate objects that speak and act like human beings, see [Fables.]"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-02-21T10:29:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Parables"}}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "City Pastor. Parables and parabolic stories, 1829.", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(parable (2a): A (usually realistic) story or narrative told to convey a moral or spiritual lesson or insight; esp. one told by Jesus in the Gospels. (Now the usual sense))"}, "madsrdf:citationSource": "OED online, viewed Sept. 19, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(parable. A tale designed to teach a moral lesson. Usually, as in the parables of Jesus in the New Testament, the story involves human beings whose actions are clarified by the concluding moral. The parable differs from allegory, in which the characters represent abstract qualities, and from fable, in which the moral is unstated because it is presumed to be self-evident.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Parables. Use for short, fictitious stories making comparisons from which moral or spiritual truths are drawn)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 17, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(parable. A brief tale intended to be understood as an allegory illustrating some lesson or moral. Adjective: parabolic. See also Fable)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Parable (A parable is a succinct story, in prose or verse, which illustrates one or more instructive principles, or lessons, or (sometimes) a normative principle. It differs from a fable in that fables use animals, plants, inanimate objects, and forces of nature as characters, while parables generally feature human characters. A parable is a short tale that illustrates universal truth, one of the simplest of narratives. It sketches a setting, describes an action, and shows the results)"}, "madsrdf:citationSource": "Wikipedia, May 29, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lyke, L.L. King David and the wise woman of Tekoa : the resonance of tradition in parabolic narrative, c1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In common parlance, a parable is a story or short narrative designed to reveal allegorically some religious principle, moral lesson, psychological reality, or general truth. Rather than using abstract discussion, a parable always teaches by comparison with real or literal occurrences--especially \"homey\" everyday occurrences a wide number of people can relate to; A fable is also a brief story illustrating a moral. Unlike the parables, fables often include talking animals or animated objects as the principal characters. The interaction of these animals or inanimate things reveals general truths about human nature, i.e., a person can learn practical lessons from the fictional antics in a fable. However, the lesson learned is not allegorical. Each animal is not necessarily a symbol for something else. Instead, the reader learns the lesson as an exemplum--an example of what one should or should not do)"}, "madsrdf:citationSource": "Wheeler, K. Parables and fables : from symbolism to allegory?, via WWW, Nov. 14, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ncd2129f9c81b47729222e79c8c296657b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Parabolic stories"}}, {"@id": "_:ncd2129f9c81b47729222e79c8c296657b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Parabolic stories"}}], "@id": "/authorities/genreForms/gf2014026467"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026468", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aParanormal comics", "identifiers:lccn": "gf2014026468", "madsrdf:adminMetadata": [{"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb1"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Paranormal comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026266"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026021"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026037"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026038"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026039"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026129"}], "madsrdf:hasSource": [{"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb5"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb6"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb7"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb8"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb9"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb10"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb11"}], "madsrdf:hasVariant": [{"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb12"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb15"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comics that feature human characters that are often involved with the occult, witchcraft, spiritualism, psychic phenomena, vodou, etc., and interact with supernatural beings."}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:22:04"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paranormal comics"}}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 359 (in chapter entitled Horror: Supernatural Heroes. Heroes can come in all shapes and sizes. Some heroes even are vampires, devils, demons, ghosts, or other beasties from the supernatural world; below are listed titles featuring paranormal fighters who battle against the forces of evil; Mike Mignola's Hellboy series is an excellent example of this genre)"}, "madsrdf:citationSource": "Pawuk, M. Graphic novels : a genre guide to comic books, manga, and more, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 48 (Horror and the Supernatural. While the horror and supernatural genres have long appeared in comics, in books, they have seen resurgence in recent years; vampires; zombies)"}, "madsrdf:citationSource": "Serchay, D.S. The librarian's guide to graphic novels for adults, c2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Comics > Genres > Supernatural/Occult (titles listed include: Angel vs. Frankenstein; Angel: The Curse; Cthulhu Tales Vol. 1; Curse of the Wendigo; Dark Shadows/Vampirella; Doctor Strange: The Oath; Demon's Regret Vol. 1; Divine Intervention; Ghost Rider; The Ghoul; Hellcity; Hellraiser; John Constantine: Hellblazer - City of Demons Vol. 1; Satan's Circus of Hell; Supernatural; This Haunted World; True Blood; Victorian Undead; Werewolves: Call of the Wild; Wizard's Tale)"}, "madsrdf:citationSource": "Comixology website, Dec. 21, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "The paranormal comics and cartoons, via The Cartoonist Group website, Dec. 21, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tag: paranormal comic strip)"}, "madsrdf:citationSource": "Entities-R-Us website, Dec. 21, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Occult is a comic book concept. A blanket term that describes hidden or secret knowledge; refers to knowledge not everyone should or can know. Often bearing the double-meaning of forbidden or taboo knowledge, it is often used to describe 'paths' that are considered better avoided. The word \"Occult\" is often interchangeable with esoteric and arcane; all three have similar meanings, but differ in certain key aspects; Many people believe that the Occult is the 'Paranormal', or the supernatural that exists outside of religion, such as ghosts. There are a few comic creators that use the Occult to create comics.)"}, "madsrdf:citationSource": "Comic vine website, Dec. 21, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (dictionary definition of paranormal is \"beyond the range of normal experience or scientific explanation,\" but this bibliography uses a much more limited definition; included here are works of paranormal romance, fantasy, mystery, and suspense, mostly set in a relatively realistic modern world inhabited by both human and paranormal beings; most take place in real time in the late twentieth or early twenty-first century; all include human characters; this bibliography does not include works set totally in fantasy worlds nor extraterrestrial, futuristic, apocalyptic, dystopic, intergalactic or technology-based science fiction nor horror fiction, i.e., fiction with the primary intent to scare the audience) p. 5 (here are a few of the enhanced humans in these series: psychics, necromancers, witches, sorcerers, warlocks, wizards, ghost busters, demon hunters, voodoo priests; other character groups are the walking dead (vampires, chupacabras, zombies) and shapeshifters, such as werewolves)"}, "madsrdf:citationSource": "Fang-tastic fiction : twenty-first-century paranormal reads, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supernaturalist comics"}}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supernaturalist comics"}}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supernatural comics"}}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supernatural comics"}}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Occult comics"}}, {"@id": "_:n1c5f4f7b27bd4d8b84570a608056eb9bb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Occult comics"}}], "@id": "/authorities/genreForms/gf2014026468"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026469", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aParanormal fiction", "identifiers:lccn": "gf2014026469", "madsrdf:adminMetadata": [{"@id": "_:n47b415014ee54ba3b718cef15220fccbb1"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Paranormal fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n47b415014ee54ba3b718cef15220fccbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026357"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026143"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026019"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026020"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026094"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026063"}], "madsrdf:hasSource": [{"@id": "_:n47b415014ee54ba3b718cef15220fccbb5"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb6"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb7"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb8"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb9"}], "madsrdf:hasVariant": [{"@id": "_:n47b415014ee54ba3b718cef15220fccbb10"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb13"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features human characters that are often involved in the occult, witchcraft, spiritualism, psychic phenomena, vodou, etc., interacting with supernatural beings."}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:25:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paranormal fiction"}}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(occult fiction: use for works dealing with witchcraft, spiritualism, psychic phenomena, voodooism, etc., and for works dealing with the mysterious or secret knowledge and power supposedly attainable only through these and other magical or supernatural means)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 51 (the evolution of the widely read romance genre to include supernatural themes and characters has spawned a relatively new--and increasingly popular and profitable--subgenre of fiction: the paranormal romance; while vampires are currently running rampant among the pages of these tales, other supernatural superstars are also emerging; werewolves, time travelers, shape shifters, ghosts, and even angels are making their way into the imaginations of fans of the genre)"}, "madsrdf:citationSource": "Skeptical inquirer, 34.6 (Nov.-Dec. 2010), via Gale biography in context, Nov. 11, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Paranormal fiction. UF Occult fiction; Occult stories; Paranormal stories)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (dictionary definition of paranormal is \"beyond the range of normal experience or scientific explanation,\" but this bibliography uses a much more limited definition; included here are works of paranormal romance, fantasy, mystery, and suspense, mostly set in a relatively realistic modern world inhabited by both human and paranormal beings; most take place in real time in the late twentieth or early twenty-first century; all include human characters; this bibliography does not include works set totally in fantasy worlds nor extraterrestrial, futuristic, apocalyptic, dystopic, intergalactic or technology-based science fiction nor horror fiction, i.e., fiction with the primary intent to scare the audience) p. 5 (here are a few of the enhanced humans in these series: psychics, necromancers, witches, sorcerers, warlocks, wizards, ghost busters, demon hunters, voodoo priests; other character groups are the walking dead (vampires, chupacabras, zombies) and shapeshifters, such as werewolves)"}, "madsrdf:citationSource": "Fang-tastic fiction : twenty-first-century paranormal reads, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Supernatural fiction (properly, \"supernaturalist fiction\") is a literary genre exploiting or requiring as plot devices or themes some contradictions of the commonplace natural world and materialist assumptions about it. In its broadest definition, supernatural fiction includes examples of weird fiction, horror fiction, fantasy fiction, and such sub-genres as vampire literature and the ghost story; amongst academics, readers and collectors, however, supernatural fiction is often classed as a discrete genre defined by the elimination of \"horror\", \"fantasy\" and elements important to other genres.The one genre supernatural fiction appears to embrace in its entirety is the traditional ghost story; Paranormal fiction)"}, "madsrdf:citationSource": "Wikipedia, Dec. 21, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n47b415014ee54ba3b718cef15220fccbb11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supernatural fiction"}}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supernatural fiction"}}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n47b415014ee54ba3b718cef15220fccbb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Supernaturalist fiction"}}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Supernaturalist fiction"}}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n47b415014ee54ba3b718cef15220fccbb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Occult fiction"}}, {"@id": "_:n47b415014ee54ba3b718cef15220fccbb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Occult fiction"}}], "@id": "/authorities/genreForms/gf2014026469"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026470", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aParodies (Literature)", "identifiers:lccn": "gf2014026470", "madsrdf:adminMetadata": [{"@id": "_:n773051f979d144c69848009a768b0475b1"}, {"@id": "_:n773051f979d144c69848009a768b0475b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Parodies (Literature)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n773051f979d144c69848009a768b0475b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026254"}, "madsrdf:hasSource": [{"@id": "_:n773051f979d144c69848009a768b0475b5"}, {"@id": "_:n773051f979d144c69848009a768b0475b6"}, {"@id": "_:n773051f979d144c69848009a768b0475b7"}, {"@id": "_:n773051f979d144c69848009a768b0475b8"}, {"@id": "_:n773051f979d144c69848009a768b0475b9"}, {"@id": "_:n773051f979d144c69848009a768b0475b10"}, {"@id": "_:n773051f979d144c69848009a768b0475b11"}], "madsrdf:hasVariant": [{"@id": "_:n773051f979d144c69848009a768b0475b12"}, {"@id": "_:n773051f979d144c69848009a768b0475b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Mocking imitations of a particular style, genre, or work."}, {"@id": "_:n773051f979d144c69848009a768b0475b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:26:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n773051f979d144c69848009a768b0475b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n773051f979d144c69848009a768b0475b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Parodies (Literature)"}}, {"@id": "_:n773051f979d144c69848009a768b0475b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Parodies. Use for humorous, sometimes satiric, imitations of other works)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 17, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n773051f979d144c69848009a768b0475b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(parody: A mocking imitation of the style of a literary work or works, ridiculing the stylistic habits of an author or school by exaggerated mimicry. Parody is related to burlesque in its application of serious styles to ridiculous subjects, to satire in its punishment of eccentricities, and even to criticism in its analysis of style. Adjective: parodic; travesty: A mockingly undignified or trivializing treatment of a dignified subject, usually as a kind of parody. Travesty may be distinguished from the mock epic and other kinds of burlesque in that it treats a solemn subject frivolously, while they treat frivolous subjects with mock solemnity. Cervantes's Don Quixote (1605) is a travesty of chivalric romances, and James Joyce's Ulysses (1922) is partly a travesty of Homer's Odyssey.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n773051f979d144c69848009a768b0475b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(parody. Imitation of a particular style or genre for the purposes of satirizing it. The object of satire may be an author with a distinctive style, such as Ernest Hemingway, or a formulaic structure, such as soap opera.)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n773051f979d144c69848009a768b0475b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(parody. The imitative use of the words, style, attitude, tone and ideas of an author in such a way as to make them ridiculous. This is usually achieved by exaggerating certain traits, using more or less the same technique as the cartoon caricaturist. In fact, a kind of satirical mimicry. As a branch of satire its purpose may be corrective as well as derisive. See Burlesque; Lampoon; Mock-epic; Mock-heroic; Skit)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n773051f979d144c69848009a768b0475b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lee, S. A discussion of the parodic ci poetry of Xin Qiji, 2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n773051f979d144c69848009a768b0475b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(parody: a literary work in which the style of an author is closely imitated for comic effect or in ridicule)"}, "madsrdf:citationSource": "Merriam-Webster's encyclopedia of literature, c1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n773051f979d144c69848009a768b0475b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Austin, A.J. Confessions of a heroine addict : women's parodic romance, 1750-1820, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n773051f979d144c69848009a768b0475b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n773051f979d144c69848009a768b0475b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spoofs"}}, {"@id": "_:n773051f979d144c69848009a768b0475b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spoofs"}}, {"@id": "_:n773051f979d144c69848009a768b0475b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n773051f979d144c69848009a768b0475b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Travesties (Parodies)"}}, {"@id": "_:n773051f979d144c69848009a768b0475b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Travesties (Parodies)"}}], "@id": "/authorities/genreForms/gf2014026470"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026471", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aParticipatory drama", "identifiers:lccn": "gf2014026471", "madsrdf:adminMetadata": [{"@id": "_:nbde82247f5e8433a9b48af10f303993bb1"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Participatory drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbde82247f5e8433a9b48af10f303993bb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:nbde82247f5e8433a9b48af10f303993bb5"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb6"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb7"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb8"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb9"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb10"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb11"}], "madsrdf:hasVariant": {"@id": "_:nbde82247f5e8433a9b48af10f303993bb12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays structured to include active involvement by audience members."}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:22:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Participatory drama"}}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an audience participation play; an audience-participation comedy mystery; an interactive play in three acts; the new genre of interactive theatre; a comic Agatha Christie style interactive mystery; Interactive acting : acting, improvisation, and interacting for audience participatory theatre; a murder mystery/comedy with audience interaction)"}, "madsrdf:citationSource": "OCLC, Dec. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 832 (Interactive drama increases student engagement and explores complex issues in management. It features scenes from organizational life being performed live by trained actors before a student audience, stopping at pivotal points so the audience can interact with the actors.)"}, "madsrdf:citationSource": "Journal of management education, Dec. 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Participatory theatre: a type of play in which the audience is involved in the performance)"}, "madsrdf:citationSource": "NTC's dict. of theatre & drama terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Participation theater; theatre for young audiences or for adults; consists of adapted or devised drama with an established story line constructed to involve limited and structured opportunities for active involvement by all or part of the audience; participation may range from simple verbal responses to an active role in the outcome of the drama; participation theater give audiences the opportunity to retell history, by playing the roles of men and women who helped write it)"}, "madsrdf:citationSource": "Childdrama.com website, Jan. 25, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In traditional theatre, performance is limited to a designated stage area and the action of the play unfolds without any interplay with audience members, who function as passive observers. But recent developments in participatory theatre have experimented with approaches where anyone can be an 'actor' and drama does not have to take place in a theatre)"}, "madsrdf:citationSource": "Mayoux, L. Participatory drama for gender transformation, 2012, via WWW, viewed Dec. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(participatory drama; participatory plays; audience participatory plays; audience-participatory plays; children's participatory plays; audience participation plays; audience-participation plays; participation drama; audience interactive drama; audience-interactive drama; a participatory Hanukkah-themed drama; interactive drama)"}, "madsrdf:citationSource": "Google search, Dec. 16, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(participatory drama: 7,000 hits; audience interaction drama: 7 hits; audience participation drama: 502 hits; audience participatory drama: 65 hits; participation drama: 2,540 hits; interactive drama NOT WITH video, online, film, computer, virtual reality: 20,900 hits, first several pages of hits are all for drama as an interactive teaching tool in schools, etc.)"}, "madsrdf:citationSource": "Google search, Aug. 6, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbde82247f5e8433a9b48af10f303993bb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Participation drama"}}, {"@id": "_:nbde82247f5e8433a9b48af10f303993bb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Participation drama"}}], "@id": "/authorities/genreForms/gf2014026471"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026472", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPassion plays", "identifiers:lccn": "gf2014026472", "madsrdf:adminMetadata": [{"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb1"}, {"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Passion plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026241"}, "madsrdf:hasSource": [{"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb5"}, {"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb6"}, {"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays that present the trial, suffering, death, and resurrection of Jesus Christ."}, {"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:23:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Passion plays"}}, {"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(passion play: A play dealing with the suffering, death, and resurrection of Christ. Originating in the Middle Ages, passion plays frequently formed a part of Corpus Christi celebrations in many European countries."}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(passion play. A religious play representing the trials, crucifixion, and resurrection of Jesus of Nazareth. Performances of such plays are recorded in various parts of Europe from the early 13th century onwards, in Latin and in the vernaculars. Some formed part of the cycles of mystery plays, others were performed separately, usually on Good Friday)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n64e11614aa8a4fce9604d460a24a0bbeb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Passion Play. A religious drama presenting the Crucifixion of Christ, usually performed on Good Friday. The first was performed in c. 1200 at Siena. In some places Passion Plays were incorporated in the Corpus Christi cycle; in others they remained separate.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026472"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026473", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPastoral drama", "identifiers:lccn": "gf2014026473", "madsrdf:adminMetadata": [{"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b1"}, {"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pastoral drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b5"}, {"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b6"}, {"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b7"}, {"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Plays with rural settings that idealize rustic, rural, or small-town life."}, {"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:23:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastoral drama"}}, {"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pastoral. Originally a literary form idealizing the lives of shepherds, more recently used to describe celebrations of innocent country or small town life. Implicit in the idea of pastoral is the identification of happiness with simple, natural existence)"}, "madsrdf:citationSource": "Quinn, E. dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pastoral. A highly conventional mode of writing that celebrates the innocent life of shepherds and shepherdesses in poems, plays, and prose romances. Pastoral literature describes the loves and sorrows of musical shepherds, usually in an idealized Golden Age of rustic innocence and idleness; paradoxically, it is an elaborately artificial cult of simplicity and virtuous frugality. Most forms of pastoral literature died out during the 18th century.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pastoral Drama. Form of drama that originated in Renaissance Italy. The form employs rural settings and stylized shepherds in presenting a rustic life that is idyllic and artificial.)"}, "madsrdf:citationSource": "McGraw-Hill encyc. of world drama, c1972", "madsrdf:citationStatus": "found"}, {"@id": "_:ncccddbd18c6748f7af7f13400ae6aec2b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (Pastoral: Idealized dramatization of rural life, often including mythological creatures, popular during the Italian Renaissance.)"}, "madsrdf:citationSource": "Wilson, E. The theater experience, c2004, via McGraw-Hill Higher Education online learning center, Nov. 14, 2012:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026473"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026474", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPastoral elegies", "identifiers:lccn": "gf2014026474", "madsrdf:adminMetadata": [{"@id": "_:nff9362a8460c4fe69bf94e466361ede9b1"}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pastoral elegies"}, "madsrdf:elementList": {"@list": [{"@id": "_:nff9362a8460c4fe69bf94e466361ede9b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "_:nff9362a8460c4fe69bf94e466361ede9b5"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026476"}], "madsrdf:hasSource": [{"@id": "_:nff9362a8460c4fe69bf94e466361ede9b8"}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b9"}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b10"}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Elegies that combine pastoral themes and images with a memorialization of a deceased person."}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:23:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastoral elegies"}}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b5", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Elegies"}, "madsrdf:elementList": {"@list": [{"@id": "_:nff9362a8460c4fe69bf94e466361ede9b6"}]}}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Elegies"}}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under elegy: The major elegies belong to a sub-species known as pastoral elegy; The conventions of pastoral elegy are approximately as follows: (a) The scene is pastoral. (b) The poet begins with an invocation to the Muses and refers to diverse mythological characters during the poem. (c) Nature is involved in mourning the shepherd's death. Nature feels the wound, so to speak. (d) The poet inquires of the guardians of the dead shepherd where they were when death came. (e) There is a procession of mourners. (f) The poet reflects on divine justice and contemporary evils. (g) There is a 'flower' passage, describing the decoration of the bier, etc. (h) At the end there is a renewal of hope and joy, with the idea expressed that death is the beginning of life.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under pastoral: English pastorals were written in several forms. A significant form within this tradition is the pastoral elegy, in which the mourner and the mourned are represented as shepherds in decoratively mythological surroundings: the outstanding English example is John Milton's Lycidas (1637). While most forms of pastoral literature died out during the 18th century, Milton's influence secured for the pastoral elegy a longer life.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Elegy: One kind of elegy that is especially important in English literary history is the pastoral elegy, whose highlights include John Milton's \"Lycidas\" (1637) and Percy Bysshe Shelley's \"Adonais\" (an elegy for the dead John Keats, 1821). Pastoral elegies combine pastoral themes and images--nature deities, seasonal vegetation--with a memorialization of a deceased friend or comrade.)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nff9362a8460c4fe69bf94e466361ede9b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "The pastoral elegy : an anthology, c1939.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026474"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026475", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPastoral fiction", "identifiers:lccn": "gf2014026475", "madsrdf:adminMetadata": [{"@id": "_:n69b3737925d54360be09f29394959de7b1"}, {"@id": "_:n69b3737925d54360be09f29394959de7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pastoral fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n69b3737925d54360be09f29394959de7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n69b3737925d54360be09f29394959de7b5"}, {"@id": "_:n69b3737925d54360be09f29394959de7b6"}, {"@id": "_:n69b3737925d54360be09f29394959de7b7"}, {"@id": "_:n69b3737925d54360be09f29394959de7b8"}], "madsrdf:hasVariant": [{"@id": "_:n69b3737925d54360be09f29394959de7b9"}, {"@id": "_:n69b3737925d54360be09f29394959de7b12"}, {"@id": "_:n69b3737925d54360be09f29394959de7b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction with rural settings that idealize rustic, rural, or small-town life."}, {"@id": "_:n69b3737925d54360be09f29394959de7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n69b3737925d54360be09f29394959de7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:23:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n69b3737925d54360be09f29394959de7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastoral fiction"}}, {"@id": "_:n69b3737925d54360be09f29394959de7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pastoral romances. BT Romances)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 17, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n69b3737925d54360be09f29394959de7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pastoral. A highly conventional mode of writing that celebrates the innocent life of shepherds and shepherdesses in poems, plays, and prose romances. Pastoral literature describes the loves and sorrows of musical shepherds, usually in an idealized Golden Age of rustic innocence and idleness; paradoxically, it is an elaborately artificial cult of simplicity and virtuous frugality. Most forms of pastoral literature died out during the 18th century.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n69b3737925d54360be09f29394959de7b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pastoral. Originally a literary form idealizing the lives of shepherds, more recently used to describe celebrations of innocent country or small town life. Implicit in the idea of pastoral is the identification of happiness with simple, natural existence. In the 20th century the term has undergone considerable expansion ... particularly in American literature where the Western or novels of the rural South create a world in which the natural and the human exist in fragile harmony; another distinctive sub-genre of American pastoral is the writing on baseball, both fiction and nonfiction.)"}, "madsrdf:citationSource": "Quinn, E. dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:n69b3737925d54360be09f29394959de7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pastoral fiction. Use for novels with a rural setting and a tone of romantic nostalgia. UF Bucolic fiction; Pastoral romances)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n69b3737925d54360be09f29394959de7b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n69b3737925d54360be09f29394959de7b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Romances, Pastoral"}}, {"@id": "_:n69b3737925d54360be09f29394959de7b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Romances, Pastoral"}}, {"@id": "_:n69b3737925d54360be09f29394959de7b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n69b3737925d54360be09f29394959de7b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bucolic fiction"}}, {"@id": "_:n69b3737925d54360be09f29394959de7b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bucolic fiction"}}, {"@id": "_:n69b3737925d54360be09f29394959de7b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n69b3737925d54360be09f29394959de7b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pastoral romances"}}, {"@id": "_:n69b3737925d54360be09f29394959de7b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastoral romances"}}], "@id": "/authorities/genreForms/gf2014026475"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026476", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPastoral poetry", "identifiers:lccn": "gf2014026476", "madsrdf:adminMetadata": [{"@id": "_:n00aa4317a027469a9b40777978344df8b1"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pastoral poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:n00aa4317a027469a9b40777978344df8b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026474"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026477"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026504"}], "madsrdf:hasSource": [{"@id": "_:n00aa4317a027469a9b40777978344df8b5"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b6"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b7"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b8"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b9"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b10"}], "madsrdf:hasVariant": [{"@id": "_:n00aa4317a027469a9b40777978344df8b11"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b14"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b17"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b20"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b23"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b26"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b29"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b32"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short poems that idealize rural life."}, {"@id": "_:n00aa4317a027469a9b40777978344df8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:23:55"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastoral poetry"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetic form: Pastoral--Viewed alternately as a genre, mode, or convention in poetry (as well as in literature generally, art, and music), the pastoral tradition refers to a lineage of creative works that idealize rural life and landscapes, while the term \"pastoral\" refers to individual poems or other works in the tradition.)"}, "madsrdf:citationSource": "Poets.org, viewed Dec. 26, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(idyll 1 a : a simple descriptive work in poetry or prose that deals with rustic life or pastoral scenes or suggests a mood of peace and contentment. b : a narrative poem (as Tennyson's Idylls of the King) treating an epic, romantic, or tragic theme. Variants of idyll: idyl)"}, "madsrdf:citationSource": "Merriam-Webster online, Feb. 17, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pastoral: A poem (also called an eclogue, a bucolic, or an idyll) that portrays the simple life of country folk, usually shepherds, as a timeless world of beauty, peace, and contentment. From its beginnings (the Greek Idyls of Theocritus, third century B.C.), pastoral has idealized rural life; poets have used the conventions of this highly artificial form to explore subjects having little to do with any actual countryside. There is also a large subgenre of pastoral elegy)."}, "madsrdf:citationSource": "Norton anthology of poetry online, Nov. 15, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pastoral poems, BT Poems; Eclogues, Use for short poems on rural or pastoral themes, traditionally in the form of a dialogue between shepherds, UF Bucolic poetry, Idyllic poetry, Pastoral poetry, Rural poetry, BT Poems.)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 17, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "idyll (idyl) (A short poem describing an incident of country life in terms of idealized innocence and contentment; or any such episode in a poem or prose work. The term is virtually synonymous with pastoral poem, as in Theocritus' Idylls. The title of Tennyson's Idylls of the King, a sequence of Arthurian romances, bears little relation to the usual meaning. Browning in Dramatic Idyls uses the term in another sense, as a short self-contained poem. Adjective: idyllic. See also bucolic poetry, eclogue) bucolic poetry (bucolics) (Another term for pastoral poetry, especially for Virgil's Eclogues and later imitations. More loosely, any verse on rustic subjects) eclogue (A short pastoral poem, often in the form of a shepherds' dialogue or a soliloquy. Some later poets have extended the term to include non-pastoral poems in dialogue form.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(idyl: From the Greek word meaning \"little picture\"--a short poem describing the simplicity and innocence of rural, pastoral, or domestic life. The origin of this literary form can be traced to Theocritus, who described pastoral life in Sicily for readers in Alexandria during the 3rd century B.C. An eclogue is a type of idyl; idyll: A narrative poem based on a romantic, epic, or tragic theme, for example, Idylls of the King (1859) by Alfred, Lord Tennyson, an episodic retelling of the fables of the Holy Grail, Camelot, Round Table, and Morte d'Arthur.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Feb. 17, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n00aa4317a027469a9b40777978344df8b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n00aa4317a027469a9b40777978344df8b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pastorals"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastorals"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n00aa4317a027469a9b40777978344df8b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rural poetry"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rural poetry"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n00aa4317a027469a9b40777978344df8b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Eclogues"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Eclogues"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n00aa4317a027469a9b40777978344df8b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Idylls (Pastoral poetry)"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Idylls (Pastoral poetry)"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n00aa4317a027469a9b40777978344df8b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Idyls (Pastoral poetry)"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Idyls (Pastoral poetry)"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n00aa4317a027469a9b40777978344df8b27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bucolic poetry"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bucolic poetry"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n00aa4317a027469a9b40777978344df8b30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bucolics"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bucolics"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b32", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n00aa4317a027469a9b40777978344df8b33"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Idyllic poetry"}}, {"@id": "_:n00aa4317a027469a9b40777978344df8b33", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Idyllic poetry"}}], "@id": "/authorities/genreForms/gf2014026476"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026477", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPastourelles", "identifiers:lccn": "gf2014026477", "madsrdf:adminMetadata": [{"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b1"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pastourelles"}, "madsrdf:elementList": {"@list": [{"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026422"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026476"}], "madsrdf:hasSource": [{"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b5"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b6"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b7"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b8"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b9"}], "madsrdf:hasVariant": [{"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b10"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b13"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b16"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Old French lyric poems about the courting of a shepherdess by a noble suitor."}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-21T09:24:12"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastourelles"}}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pastourelle (pastorela): The pastourelle was a medieval lyric genre that took the form of a dialogue between a shepherdess and a noble suitor (a knight or occasionally a cleric). In the classic form of the genre, the knight recounts his meeting with the shepherdess and his attempts to woo her, but she rebuffs his advances and the suitor generally fails in his attempts to seduce her)"}, "madsrdf:citationSource": "Ruud, J. Encyclopedia of medieval literature, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pastourelle (pastorella): A type of medieval lyric in dialogue form in which a knight or a man of equivalent social rank attempts to court a shepherdess. His suit is usually unsuccessful, though the wooing is sometimes terminated only by the arrival of a father or brother.)"}, "madsrdf:citationSource": "Beckson, K. Literary terms, 1989", "madsrdf:citationStatus": "found"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pastourelle. A genre of med. lyric poetry most frequently found in OF. In the \"classical\" type, the narrator, sometimes identified as a knight, recounts his meeting with a shepherdess and his attempt to seduce her)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pastourelle: A short narrative poem of the Middle Ages (in Proven\u00e7al, pastorela) whose typical subject is meeting between a knight and a shepherdess. A kind of 'debate' follows, and the shepherdess may or may not succumb; or she may outwit the knight, or be rescued by shepherds)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1998", "madsrdf:citationStatus": "found"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Pastorelle occitane, c2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pastorelle"}}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastorelle"}}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pastorelas"}}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastorelas"}}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pastorellas"}}, {"@id": "_:n01f71aef5c184e849b5df9a3737b11c5b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pastorellas"}}], "@id": "/authorities/genreForms/gf2014026477"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026478", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPattern poetry", "identifiers:lccn": "gf2014026478", "madsrdf:adminMetadata": [{"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b1"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Pattern poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b3"}]}, "madsrdf:exampleNote": "Note under [Concrete poetry]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026588"}, "madsrdf:hasSource": [{"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b5"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b6"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b7"}], "madsrdf:hasVariant": [{"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b8"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b11"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b14"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems that are arranged to form a recognizable or meaningful shape that usually illustrates the poem's theme. For poems in which graphic effects created by typography replace the conventional verse forms so that the typographical arrangement of text is central to the experience and meaning of the work see [Concrete poetry.]"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T11:27:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pattern poetry"}}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pattern poetry, or shape poetry. Poetry in which the lines of text are used to form an image, usually one that illustrates the poem's subject or theme. A well-known example is the poem Easter Wings by the 17th-century English poet George Herbert, in which the lines are arranged to form wings. Among the earliest surviving examples of pattern poetry are Greek poems written in the 3rd century BC, though the attempt to form verse into descriptive shapes is almost certainly an ancient practice. It became popular in the 17th century, and concrete poetry can be seen as a closely related 20th-century form.)"}, "madsrdf:citationSource": "Hutchinson encyclopedia, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ch. 1 (Pattern poetry is both visual and literary art--visual poetry. The visual poetry of the twentieth century is rather well known, and its subclasses--concrete poetry, poesia visiva, parole in liberta, etc.--are fairly clearly defined. For the moment it will suffice to define pattern poetry in very general terms as visual poetry from before the twentieth century but in any Western literature. Pattern poetry is itself a fairly modern concept; the origin of the term is unknown, but it appeared some time in the nineteenth century, along with the synonymous term, \"shaped poetry.\" There are scattered examples from antiquity through the Middle Ages; shortly after the beginning of the sixteenth century we find the start of the largest body of pattern poetry of all, which continues through the baroque and into the eighteenth century.)"}, "madsrdf:citationSource": "Higgins, D. Pattern poetry : guide to an unknown literature, 1987:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pattern poetry: pattern poetry, also called figure poem, shaped verse, or carmen figuratum, verse in which the typography or lines are arranged in an unusual configuration, usually to convey or extend the emotional content of the words. Of ancient (probably Eastern) origin, pattern poems are found in the Greek Anthology, which includes work composed between the 7th century BC and the early 11th century AD. In the 19th century, the French Symbolist poet St\u00e9phane Mallarm\u00e9 employed different type sizes in Un Coup de d\u00e9s (1897; \"A Throw of Dice\"). Representative poets in the 20th century included Guillaume Apollinaire in France and E.E. Cummings in the United States. In the 20th century, pattern poetry sometimes crossed paths with concrete poetry; a basic distinction between the two types of poetry is the ability of pattern poetry to hold its meaning apart from its typography--i.e., it can be read aloud and still retain its meaning.)"}, "madsrdf:citationSource": "Encyclop\u00e6dia Britannica online, July 29, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Carmina figurata"}}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Carmina figurata"}}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shape poetry"}}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shape poetry"}}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Figure poetry"}}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Figure poetry"}}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shaped poetry"}}, {"@id": "_:nbd8ab0392eef4f5f8ec080630eaa8641b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shaped poetry"}}], "@id": "/authorities/genreForms/gf2014026478"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026479", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPicaresque fiction", "identifiers:lccn": "gf2014026479", "madsrdf:adminMetadata": [{"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b1"}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Picaresque fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026425"}, "madsrdf:hasSource": [{"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b5"}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b6"}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b7"}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b8"}], "madsrdf:hasVariant": {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that consists of episodic narratives that describe the adventures of a resourceful rogue."}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-12-13T15:13:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picaresque fiction"}}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Picaresque literature. Use for episodic accounts of the adventures of an engagingly roguish hero; the adventures are often used to satirize the society of the day)"}, "madsrdf:citationSource": "GSAFD, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Picaresque. A narrative, usually a novel told in the first-person voice, that presents the life and adventures of a likable rogue (picaro, in Spanish) who is at odds with respectable society. Loosely plotted, with adventures unfolding in discrete episodes, the picaresque is part adventure story, part satire, and part realism; the picaresque tends more toward light and low comedy than toward bitter satire)"}, "madsrdf:citationSource": "Kennedy, X.J. The Longman dictionary of literary terms, c2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picaresque: A literary genre in sixteenth and seventeenth-century Spain; the picaresque novel was an episodic first-person narrative that related the adventures (often criminal or sexual) of a shrewd rogue (p\u00edcaro) of humble origin; in this respect it was an antidote to the romance of chivalry, which celebrated the high ideals of aristocratic heroes)"}, "madsrdf:citationSource": "Oxford dictionary of the Renaissance, via Oxford reference online, Nov. 3, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(picaresque: form of novel featuring roguish antiheroes or 'tricksters' that first appeared in 16th century Spain and flourished in 18th and 19th century English literature; nowadays the term is commonly, and loosely, applied to episodic novels ... that describe the adventures of a lively and resourceful hero on a journey)"}, "madsrdf:citationSource": "Oxford companion to English literature, via Oxford reference online, Nov. 3, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Picaresques (Fiction)"}}, {"@id": "_:n705d90f03b25421ca2b3aec03a3b5898b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Picaresques (Fiction)"}}], "@id": "/authorities/genreForms/gf2014026479"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026480", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPing shu", "identifiers:lccn": "gf2014026480", "madsrdf:adminMetadata": [{"@id": "_:n36a24792a0374214860c2067495263d1b1"}, {"@id": "_:n36a24792a0374214860c2067495263d1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Ping shu"}, "madsrdf:elementList": {"@list": [{"@id": "_:n36a24792a0374214860c2067495263d1b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026342"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026439"}], "madsrdf:hasSource": [{"@id": "_:n36a24792a0374214860c2067495263d1b5"}, {"@id": "_:n36a24792a0374214860c2067495263d1b6"}, {"@id": "_:n36a24792a0374214860c2067495263d1b7"}], "madsrdf:hasVariant": [{"@id": "_:n36a24792a0374214860c2067495263d1b8"}, {"@id": "_:n36a24792a0374214860c2067495263d1b11"}, {"@id": "_:n36a24792a0374214860c2067495263d1b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Chinese oral storytelling that is presented by a single performer in local dialect, often with added commentary."}, {"@id": "_:n36a24792a0374214860c2067495263d1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n36a24792a0374214860c2067495263d1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-06-02T12:45:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n36a24792a0374214860c2067495263d1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ping shu"}}, {"@id": "_:n36a24792a0374214860c2067495263d1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(pinghua, p\u02bcing hua. Literally: \"comment talk.\" A type of storytelling (quyi), usually presented by a single performer, which arose c. 7th C; today forms exist in a number of regions including Sichuan and Hubei Provinces, and parts of Jiangsu Province. Most forms are spoken, with little or no singing, in local dialect. The performer is usually seated behind a table, and strikes it with a block of wood at high points in the story. In some areas, called pingshu or p\u02bcing shu, literally \"comment book\")"}, "madsrdf:citationSource": "An international dictionary of theatre language, 1985", "madsrdf:citationStatus": "found"}, {"@id": "_:n36a24792a0374214860c2067495263d1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ping shu. UF Ping hua; Pinghua; Pingshu. BT Chinese drama)"}, "madsrdf:citationSource": "LCSH, Oct. 20, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n36a24792a0374214860c2067495263d1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pingshu (Popular Tales). Pingshu is a Quyi art form of oral storytelling and it includes Pingshu that's popular in northern China and Pinghua in eastern China's Yangzhou; The Pingshu performer wore a gown and sat behind a table, with a folded fan and a gavel (serving as a prop to strike the table as a warning to the audience to be quiet or as a means of attracting attention in order to strengthen the effect of the performance, especially at the beginning or at the intervals). By the mid l920s, these props had all disappeared, with the performer appearing only in a standing position in a gown or any other kind of clothes; The storytellers often added their own commentaries on the subjects and the characters)"}, "madsrdf:citationSource": "ChinaCulture.org website, Nov. 12, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n36a24792a0374214860c2067495263d1b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n36a24792a0374214860c2067495263d1b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ping hua"}}, {"@id": "_:n36a24792a0374214860c2067495263d1b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ping hua"}}, {"@id": "_:n36a24792a0374214860c2067495263d1b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n36a24792a0374214860c2067495263d1b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pinghua"}}, {"@id": "_:n36a24792a0374214860c2067495263d1b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pinghua"}}, {"@id": "_:n36a24792a0374214860c2067495263d1b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n36a24792a0374214860c2067495263d1b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pingshu"}}, {"@id": "_:n36a24792a0374214860c2067495263d1b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pingshu"}}], "@id": "/authorities/genreForms/gf2014026480"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPoetry", "identifiers:lccn": "gf2014026481", "madsrdf:adminMetadata": [{"@id": "_:nb089ece3234d4095a0034f3843586c49b1"}, {"@id": "_:nb089ece3234d4095a0034f3843586c49b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Poetry"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb089ece3234d4095a0034f3843586c49b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026221"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026235"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026236"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026238"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026247"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026249"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026250"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026253"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026257"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026260"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026276"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026277"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026278"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026284"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026289"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026293"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026296"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026304"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026306"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026308"}