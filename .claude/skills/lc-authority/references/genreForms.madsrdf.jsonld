"new"}, {"@id": "_:n9d325f48a35241aaab6abc4909711c3db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Riddles"}}, {"@id": "_:n9d325f48a35241aaab6abc4909711c3db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 72 (riddle)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9d325f48a35241aaab6abc4909711c3db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Riddles. BT Puzzles)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9d325f48a35241aaab6abc4909711c3db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(riddles (document genres). Puzzling questions or statements worded so as to exercise one's ingenuity in answering or discovering their hidden meaning. BT <word and number puzzles and games>)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 31, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9d325f48a35241aaab6abc4909711c3db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Riddles. UF Conundrums; Enigmas. BT Amusements; Literary recreations; Questions and answers; Wit and humor. RT Charades; Puzzles)"}, "madsrdf:citationSource": "LCSH, Nov. 18, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9d325f48a35241aaab6abc4909711c3db9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9d325f48a35241aaab6abc4909711c3db10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Conundrums"}}, {"@id": "_:n9d325f48a35241aaab6abc4909711c3db10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value"