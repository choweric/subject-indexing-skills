{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027141", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTonadillas", "identifiers:lccn": "gf2014027141", "madsrdf:adminMetadata": [{"@id": "_:n780ed1553f4148c1a249ded9e8f4c399b1"}, {"@id": "_:n780ed1553f4148c1a249ded9e8f4c399b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tonadillas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n780ed1553f4148c1a249ded9e8f4c399b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026876"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026976"}], "madsrdf:hasSource": {"@id": "_:n780ed1553f4148c1a249ded9e8f4c399b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n780ed1553f4148c1a249ded9e8f4c399b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n780ed1553f4148c1a249ded9e8f4c399b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n780ed1553f4148c1a249ded9e8f4c399b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tonadillas"}}, {"@id": "_:n780ed1553f4148c1a249ded9e8f4c399b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(An intermezzo sung between the acts of a play or (more rarely) an opera or auto sacramental ... in 18th-century and early 19th-century Spanish theatre; developed into a kind of short comic opera akin to the Neapolitan intermezzo)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, Sept. 27, 2007", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027141"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027142", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrad jazz", "identifiers:lccn": "gf2014027142", "madsrdf:adminMetadata": [{"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db1"}, {"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trad jazz"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026770"}, "madsrdf:hasSource": [{"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db5"}, {"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db6"}, {"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db7"}, {"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trad jazz"}}, {"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trad; a style of traditional jazz current in Britain between the mid-1950s and the early 1960s. The term was applied to a particularly commercial and simplified form of revivalist jazz which was modeled on the serious attempts of Ken Colyer and Christ Barber to re-create New Orleans styles)"}, "madsrdf:citationSource": "New Grove dict. of jazz", "madsrdf:citationStatus": "found"}, {"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "insert (traditional jazz)"}, "madsrdf:citationSource": "Work cat.: Barber, C. Panama! [SR] p1991:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trad jazz; although the term \"traditional jazz\" has been used for everything from Dixieland to the current straight-ahead jazz scene, Trad was the name for the form of New Orleans jazz that flourished in the United Kingdom during the 1950s and 1960s)"}, "madsrdf:citationSource": "All music guide WWW site, Dec. 18, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:ne39c86981ee54ddcb05df37f3debbe7db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trad; an abbreviation of 'traditional jazz' and a curtailment of most of its essential virtues. This peculiarly European form of deviant Dixieland was mainly influenced by British bands)"}, "madsrdf:citationSource": "Carr, I. Jazz, the essential companion, 1988", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027142"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027143", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrance (Electronic dance music)", "identifiers:lccn": "gf2014027143", "madsrdf:adminMetadata": [{"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb1"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trance (Electronic dance music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb3"}]}, "madsrdf:exampleNote": "Note under: [Trance music]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153"}, "madsrdf:hasSource": [{"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb5"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb6"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb7"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb8"}], "madsrdf:hasVariant": [{"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb9"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb12"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb15"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb18"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb21"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Electronic dance music that is characterized by a slow buildup leading to a euphoric peak. For music meant to induce a trance or performed by persons said to be in a trance see [Trance music.]"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-14T11:33:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wimtmla"}, "ri:recordStatus": "revised"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trance (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trance music; a genre of electronic dance music that emerged from the British new-age music scene and the early 1990s German techno and hardcore scenes; a trance is a state of hypnotism and heightened consciousness. This is portrayed in trance music by the mixing of layers with distinctly foreshadowed build-up and release)"}, "madsrdf:citationSource": "Wikipedia, July 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "subtitle (don't techno for an answer)"}, "madsrdf:citationSource": "Work cat.: Save the last trance for me, p1992:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "ecip galley (Psytrance is a movement rooted in the live music scene of the 1970s flourishing in the former Portuguese colony of Goa, India, which had been overtaken by a seasonal DJ-led electronic music scene in the 1980s. Goa had attracted international travellers, artists and spiritual seekers since the 1960s, becoming an exotic outland of experimentation for musicians and expatriates in subsequent decades. It was the birthplace and proving grounds of a mutant dance music culture, which, by the mid-1990s, became marketed as \"Goa trance\". 2 Following aesthetic shifts associated with analog, digital and virtual music technologies along with transitions in taste and demand, Goa trance later developed as \"psychedelic trance\" or \"psytrance\", which splintered into numerous subgenres by the early 2000s)"}, "madsrdf:citationSource": "Global tribe, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trance (psytrance); American genre of electronic dance music that gained popularity in the early 1990s; shares some rhythmic similarities with techno; trance places a stronger emphasis on melody and song structure; vocal samples are often used; tracks are characterized by a slow buildup leading to a euphoric, uplifting peak; several varieties have emerged, including progressive trance, Goa trance, and psychedelic trance; fundamental to all genres and subgenres of trance is the practice of experiencing altered states of consciousness)"}, "madsrdf:citationSource": "Grove music online, viewed July 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trance music (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trance music (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psytrance (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psytrance (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psytrance music (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psytrance music (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psychedelic trance (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psychedelic trance (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Psy trance (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Psy trance (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Goa trance (Electronic dance music)"}}, {"@id": "_:nbb9e0802115f4cae89da60101ce1f7bdb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Goa trance (Electronic dance music)"}}], "@id": "/authorities/genreForms/gf2014027143"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027144", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTransitoria (Music)", "identifiers:lccn": "gf2014027144", "madsrdf:adminMetadata": [{"@id": "_:n35250d48ee9847d984e41cf625adcf7ab1"}, {"@id": "_:n35250d48ee9847d984e41cf625adcf7ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Transitoria (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n35250d48ee9847d984e41cf625adcf7ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027020"}, "madsrdf:hasSource": [{"@id": "_:n35250d48ee9847d984e41cf625adcf7ab5"}, {"@id": "_:n35250d48ee9847d984e41cf625adcf7ab6"}, {"@id": "_:n35250d48ee9847d984e41cf625adcf7ab7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n35250d48ee9847d984e41cf625adcf7ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n35250d48ee9847d984e41cf625adcf7ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n35250d48ee9847d984e41cf625adcf7ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transitoria (Music)"}}, {"@id": "_:n35250d48ee9847d984e41cf625adcf7ab5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online WWW site, Jan. 13, 2005 (Transitorium: A Mass chant in the Ambrosian rite; in article on Ambrosian chants, under Mass chants, Proper chants: It is thought that Mass antiphons were originally sung with a series of psalm verses to accompany liturgical actions: the ingressa, the antiphona post Evangelium, the offertorium, the confractorium, and the transitorium, which, according to an early missal, was sung while the priest \"transferred that book to the other side of the altar\"; the texts of a number of transitoria are known (or believed) to be translations of Greek originals)", "madsrdf:citationStatus": "found"}, {"@id": "_:n35250d48ee9847d984e41cf625adcf7ab6", "@type": "madsrdf:Source", "madsrdf:citationSource": "2003363741: Bailey, T. The transitoria of the Ambrosian Mass, c2003 (The Ambrosian Mass included two communion chants; the transitorium, the second Ambrosian communion chant, appears to be so named because it [was] sung while the priest \"transfers the missal to the other side of the altar\"; the general class of antiphons may be taken to include the transitoria)", "madsrdf:citationStatus": "found"}, {"@id": "_:n35250d48ee9847d984e41cf625adcf7ab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "notfound"}], "@id": "/authorities/genreForms/gf2014027144"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027145", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrinity Sunday music", "identifiers:lccn": "gf2014027145", "madsrdf:adminMetadata": [{"@id": "_:nba0ff6f36b364bb29f912aaa5e34b90bb1"}, {"@id": "_:nba0ff6f36b364bb29f912aaa5e34b90bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trinity Sunday music"}, "madsrdf:elementList": {"@list": [{"@id": "_:nba0ff6f36b364bb29f912aaa5e34b90bb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026795"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Music that is traditionally associated with Trinity Sunday."}, {"@id": "_:nba0ff6f36b364bb29f912aaa5e34b90bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:04:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nba0ff6f36b364bb29f912aaa5e34b90bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nba0ff6f36b364bb29f912aaa5e34b90bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trinity Sunday music"}}], "@id": "/authorities/genreForms/gf2014027145"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027146", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTrip-hop (Music)", "identifiers:lccn": "gf2014027146", "madsrdf:adminMetadata": [{"@id": "_:na08857b78a10456ea6d490f427df308db1"}, {"@id": "_:na08857b78a10456ea6d490f427df308db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Trip-hop (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na08857b78a10456ea6d490f427df308db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026156"}], "madsrdf:hasSource": [{"@id": "_:na08857b78a10456ea6d490f427df308db5"}, {"@id": "_:na08857b78a10456ea6d490f427df308db6"}, {"@id": "_:na08857b78a10456ea6d490f427df308db7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na08857b78a10456ea6d490f427df308db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na08857b78a10456ea6d490f427df308db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-16T09:48:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "revised"}, {"@id": "_:na08857b78a10456ea6d490f427df308db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trip-hop (Music)"}}, {"@id": "_:na08857b78a10456ea6d490f427df308db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trip hop: a form of 20th-century club dance music. It owes part of its sound to hip hop, although it is considerably slower)"}, "madsrdf:citationSource": "Oxford Music online, Jan. 25, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:na08857b78a10456ea6d490f427df308db6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Trip hop nation, 1996.", "madsrdf:citationStatus": "found"}, {"@id": "_:na08857b78a10456ea6d490f427df308db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trip hop)"}, "madsrdf:citationSource": "International Index to Music Periodicals, Jan. 25, 2012", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027146"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027147", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTropes (Music)", "identifiers:lccn": "gf2014027147", "madsrdf:adminMetadata": [{"@id": "_:nfc5778db5d5943b5858a1d81c4ff71c7b1"}, {"@id": "_:nfc5778db5d5943b5858a1d81c4ff71c7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tropes (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfc5778db5d5943b5858a1d81c4ff71c7b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026843"}, "madsrdf:hasSource": [{"@id": "_:nfc5778db5d5943b5858a1d81c4ff71c7b5"}, {"@id": "_:nfc5778db5d5943b5858a1d81c4ff71c7b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nfc5778db5d5943b5858a1d81c4ff71c7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfc5778db5d5943b5858a1d81c4ff71c7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nfc5778db5d5943b5858a1d81c4ff71c7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tropes (Music)"}}, {"@id": "_:nfc5778db5d5943b5858a1d81c4ff71c7b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Harvard dict. (In the Middle Ages, a type of addition to an official liturgical chant of the Latin church.)", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc5778db5d5943b5858a1d81c4ff71c7b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove: under Prosula (Alternative term similarly employed in medieval mss. include \"tropus.\")", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027147"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027148", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTropic\u00e1lia (Music)", "identifiers:lccn": "gf2014027148", "madsrdf:adminMetadata": [{"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b1"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tropic\u00e1lia (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b5"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b6"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b7"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b8"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b9"}], "madsrdf:hasVariant": {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tropic\u00e1lia (Music)"}}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 148, under Brazil (tropicalia, a cover term to describe the musical styles which have a heavy \"tropical\" rhythm as opposed to the \"cool\" light style of the bossa nova and samba; tropical\u00edsmo, the same as \"tropicalia\")"}, "madsrdf:citationSource": "White, D. Dic. of pop. music styles of the world, c1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 236 (the tropicalia movement, begun in the 1960's, was led by Bah\u00edan artists Gilberto Gil, Gaetano Veloso, Maria Bethania, and Gal Costa; tropicalia's principal aesthetic aim was to liberate the musical imagination, remove barriers between genres and create new fusions)"}, "madsrdf:citationSource": "Sweeny, P. The Virgin directory of world music, 1992:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 564-565 (tropicalismo, musical movement that erupted in the late 1960s; it consisted of mixing a large number of regional genres together, stirring in rock influences like electric guitars and elaborate studio production, and topping everything off with extraordinarily dense, oblique lyrics)"}, "madsrdf:citationSource": "World music, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 155 (Tropicalismo; aimed at youth market; use of electric guitars and free and loose lyrics)"}, "madsrdf:citationSource": "Albin, R.C. MPB, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 17 (tropicalismo; tropic\u00e1lia)"}, "madsrdf:citationSource": "Work cat.: 98-831006: Veloso, C. Verdade tropical, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tropicalismo (Music)"}}, {"@id": "_:nffd9ff2a117a454aae400c387f1b8e14b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tropicalismo (Music)"}}], "@id": "/authorities/genreForms/gf2014027148"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027149", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTsapiky (Music)", "identifiers:lccn": "gf2014027149", "madsrdf:adminMetadata": [{"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b1"}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tsapiky (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b5"}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b6"}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b7"}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b8"}], "madsrdf:hasVariant": {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tsapiky (Music)"}}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Music of Madagascar (Tsapika: also tsapiky; an energetic form of dance music)"}, "madsrdf:citationSource": "Wikipedia, Oct. 25, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(tsapiky; tsapik; fast tempo music from southwest Madagascar; based on Bazarsy Groupe's repertoire, but with traditional instruments such as katsa and langoro added and tempo considerably speeded up)"}, "madsrdf:citationSource": "RFI musique www home page, Oct. 20, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Madagascar--Popular music (the tsapiky and kinetsanetsa of the south are other examples of a flourishing dance-music)"}, "madsrdf:citationSource": "New Grove dictionary of music WWW site, Oct. 25, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (Musique moderne, accompagn\u00e9 de figures de danses, de chants aux messages multiples, le Tsapiky est embl\u00e9matique de la r\u00e9gion de Tul\u01cer (sud-ouest de Madagascar))"}, "madsrdf:citationSource": "Work cat.: Le tsapiky, une jeune musique de Madagascar, 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tsapika (Music)"}}, {"@id": "_:nb6bc31a153f648e0a9f5673d6fcad0e9b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tsapika (Music)"}}], "@id": "/authorities/genreForms/gf2014027149"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027150", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTune books", "identifiers:lccn": "gf2014027150", "madsrdf:adminMetadata": [{"@id": "_:nb0eba6c3de754fa3aa9b47196ab3cb5eb1"}, {"@id": "_:nb0eba6c3de754fa3aa9b47196ab3cb5eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tune books"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb0eba6c3de754fa3aa9b47196ab3cb5eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027184"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026872"}, "madsrdf:hasSource": {"@id": "_:nb0eba6c3de754fa3aa9b47196ab3cb5eb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Collections of hymn tunes without words, or with single stanzas of text."}, {"@id": "_:nb0eba6c3de754fa3aa9b47196ab3cb5eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nb0eba6c3de754fa3aa9b47196ab3cb5eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T11:03:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb0eba6c3de754fa3aa9b47196ab3cb5eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tune books"}}, {"@id": "_:nb0eba6c3de754fa3aa9b47196ab3cb5eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tune book. Psalm and hymn tunes, circulated in printed collections since the early Protestant Reformation. Aimed at a variety of users... these collections were widespread in Great Britain and later in America, where they came to be called tune books.)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027150"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027151", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTurbo-folk (Music)", "identifiers:lccn": "gf2014027151", "madsrdf:adminMetadata": [{"@id": "_:n6fb08b80c45d4df4a8194bcd59eee0cdb1"}, {"@id": "_:n6fb08b80c45d4df4a8194bcd59eee0cdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Turbo-folk (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6fb08b80c45d4df4a8194bcd59eee0cdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}, "madsrdf:hasSource": [{"@id": "_:n6fb08b80c45d4df4a8194bcd59eee0cdb5"}, {"@id": "_:n6fb08b80c45d4df4a8194bcd59eee0cdb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6fb08b80c45d4df4a8194bcd59eee0cdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6fb08b80c45d4df4a8194bcd59eee0cdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6fb08b80c45d4df4a8194bcd59eee0cdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Turbo-folk (Music)"}}, {"@id": "_:n6fb08b80c45d4df4a8194bcd59eee0cdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(News, Oct. 6, 2011. Skopje Bans \"Turbo Folk\" on Public Transport; Turbo Folk music emerged in late 1980s and 90s in Serbia as a sub-genre of Balkan folk music blended with dance and pop elements and quasi-meaningful lyrics. Although widely rejected by music critics as plain kitsch, this blend soon became mainstream among the masses in many Balkan states)"}, "madsrdf:citationSource": "Balkan Insight WWW site, Dec. 11, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n6fb08b80c45d4df4a8194bcd59eee0cdb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: Cvoro, U., Turbo-folk music and cultural representations of national identity in former Yugoslavia, 2014.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027151"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027152", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTyroliennes (Music)", "identifiers:lccn": "gf2014027152", "madsrdf:adminMetadata": [{"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b1"}, {"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Tyroliennes (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b5"}, {"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b6"}], "madsrdf:hasVariant": {"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tyroliennes (Music)"}}, {"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Tyrolienne. A fast triple-metre dance and song type, considered a modified form of L\u00e4ndler. The name was first used in English to refer to fashionable ballet music of the early 19th century that attempted to represent the dances of Austrian and Bavarian peasants, whence it was adopted as an evocative title for pedagogical piano pieces; 'tyrolienne' was also applied to 19th-century vocal pieces intended to imitate Alpine folk music ... The 'Tyrolean Business' was frequently introduced as a part of minstrel shows in the 1850s. Vocal tyroliennes, characterized by sentimental or pastoral texts, triple metre, waltz-like rhythms, triadic melodies, harmonies in parallel 3rds, and echo and yodel effects, proliferated in mid-19th-century sheet music on both sides of the Atlantic. Alternate terms: Tyrolese, Tyrolean)"}, "madsrdf:citationSource": "Grove Music online, March 10, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container lid (\"Tyrolienne\" appears above the song title)"}, "madsrdf:citationSource": "Work cat.: Ma berg\u00e9re (Cylindres Edison 17265), 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Tyroleses (Music)"}}, {"@id": "_:n9e1b17cdc15543c2b92cb1bd3fe85cf2b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Tyroleses (Music)"}}], "@id": "/authorities/genreForms/gf2014027152"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027153", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aElectronic dance music", "identifiers:lccn": "gf2014027153", "madsrdf:adminMetadata": [{"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b1"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Electronic dance music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026783"}], "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b5"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026779"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026834"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026865"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026875"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026887"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027130"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027143"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027146"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026062"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026044"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026048"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026066"}], "madsrdf:hasSource": [{"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b8"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b9"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b10"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b11"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b12"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b13"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b14"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b15"}], "madsrdf:hasVariant": [{"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b16"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b19"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b22"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b25"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b28"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-16T09:48:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "revised"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Electronic dance music"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Underground dance music"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Underground dance music"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Rolling stone encyc. of rock & roll, c1995;White, D. Dictionary of popular music styles of the world, c1998.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Electronic dance music (also known as EDM, dance music, club music, or simply dance) is a broad range of percussive electronic music genres made largely for nightclubs, raves, and festivals. EDM is generally produced for playback by disc jockeys (DJs) who create seamless selections of tracks ... By the early 2010s the term 'electronic dance music' and the initialism 'EDM' [were] being pushed by the U.S. music industry and music press in an effort to re-brand American rave culture. Despite the industry's attempt to create a specific EDM brand, the initialism remains in use as an umbrella term for multiple dance genres, including house, techno, trance, drum and bass, dubstep, and their respective subgenres)"}, "madsrdf:citationSource": "Wikipedia, April 24, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Focus and scope (e-journal for the study of electronic dance music culture (EDMC) ... From dancehall to raving, club cultures to sound systems, disco to techno, breakbeat to psytrance, hip hop to dubstep, IDM to noisecore, nortec to bloghouse, global EDMCs are a shifting spectrum of scenes, genres, and aesthetics)"}, "madsrdf:citationSource": [{"@id": "https://dj.dancecult.net/index.php/dancecult/about/editorialPolicies#focusAndScope"}, "Dancecult WWW site, April 24, 2017:"], "madsrdf:citationStatus": "found"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(use of the term 'EDM': While this is conventionally used as a shorthand acronym for all forms of 'electronic dance music' ... in the last ten years 'EDM' has been progressively co-opted and popularized by a live event industry ... in which multiple electronic dance musics are formulated and marketed as 'EDM')"}, "madsrdf:citationSource": "St John, Graham. Weekend societies, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(UDM; as a musical category of the 1980s and 1990s, developed out of the disco phenomenon of the 1970s; based in New York; core audience is predominantly African American and Latino, male, and gay; variously labeled \"underground,\" \"dance music,\" \"underground dance music\" or \"club music\" by its patrons; house music is the main musical category of UDM)"}, "madsrdf:citationSource": "Work cat.: 00009088: Fikentscher, Kai. \"You better work!\" : underground dance music in New York City, c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(title search on \"electronic dance music\": 163 records retrieved; title search on \"underground dance music\": 5 records retrieved"}, "madsrdf:citationSource": "OCLC search, April 24, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(underground dance music; sites in U.S. and U.K.)"}, "madsrdf:citationSource": "AltaVista WWW search, Apr. 14, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(online record store specializing in all kinds of underground dance music: house, techno, garage, trance, HardHouse, and EuroDance)"}, "madsrdf:citationSource": "DanceGrooves WWW site, Apr. 14, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dance music, Electronic"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dance music, Electronic"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Underground dance music"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Underground dance music"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "UDM (Underground dance music)"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "UDM (Underground dance music)"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Club music"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Club music"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "EDM (Electronic dance music)"}}, {"@id": "_:n32d5b73d94104a6d98cb26d5170b8fb5b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "EDM (Electronic dance music)"}}], "@id": "/authorities/genreForms/gf2014027153"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027154", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aUtai", "identifiers:lccn": "gf2014027154", "madsrdf:adminMetadata": [{"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b1"}, {"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Utai"}, "madsrdf:elementList": {"@list": [{"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026707"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026965"}], "madsrdf:hasSource": {"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b5"}, "madsrdf:hasVariant": {"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Utai"}}, {"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Grove music online, viewed August 28, 2014: Under Japan IV, Theatre music. iii. Chant (N\u014d chant (utai) can be divided into three types: melodic (yowagin or wagin), dynamic (tsuyogin or g\u014dgin) and stylized speech (kotoba). )", "madsrdf:citationStatus": "found"}, {"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Y\u014dkyoku"}}, {"@id": "_:n35f1ee2250b24b8c91d311256a1e8cd3b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Y\u014dkyoku"}}], "@id": "/authorities/genreForms/gf2014027154"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027155", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVallenato", "identifiers:lccn": "gf2014027155", "madsrdf:adminMetadata": [{"@id": "_:n234aa55ea8e34f67853501574f151e3db1"}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Vallenato"}, "madsrdf:elementList": {"@list": [{"@id": "_:n234aa55ea8e34f67853501574f151e3db3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n234aa55ea8e34f67853501574f151e3db5"}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db6"}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db7"}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db8"}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vallenato"}}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(vallenato: popular accordion and vocal music of northeastern Colombia; vallenato pop: vallenato music with \"pop\" influence; tecno-vallenato: electronic vallenato music)"}, "madsrdf:citationSource": "White, D. Dict. of popular music styles of the world", "madsrdf:citationStatus": "found"}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2001423950: O\u00f1ate Rivero, R. Vallenatos inmortales, 2000.", "madsrdf:citationStatus": "found"}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A product of Colombia's northern coastal region, vallenato--a folk tradition that originated as recreational music performed by cattle-ranching cowboys--is among the country's most popular and influential musical exports. Created via a combination of three basic musical instruments--most commonly the accordion, bongo, and g\u00fciro--vallenato is also typified by its four basic rhythms: son (the slowest), paseo (the most common and most marketed), merengue (faster and more joyous), and puya (the fastest and most complex of them all). Lyrically, vallenato is chiefly concerned with romance, with most songs detailing either the singer's love of a woman or his affection for his hometown)"}, "madsrdf:citationSource": "All music guide WWW site, Jan. 11, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Colombia, Popular music: Related to the traditional cumbia, vallenato originated in the area around the city of Valledupar in the 1940s and 50s; performed by an ensemble consisting of accordion, vocals, caja (small double-headed drum) and guacharaca (notched gourd scraper). The two principal forms are the merengue (played in 6/8 metre) and the paseo (played in simple duple metre). Texts typically centre on life and heartbreak in the semi-rural regions of the eastern Atlantic coast. Unlike the cosmopolitan m\u00fasica tropical style, vallenato was seen as an unsophisticated, plebeian music through the 1950s and 60s. During the 1970s, vallenato's popularity grew with the addition of electric bass and the incorporation of a more plaintive singing style adopted from Mexican ranchera. A key factor in the national rise of vallenato during this decade was the growing economic power of the marijuana drug cartels around Santa Marta, which patronized vallenato musicians and provided resources for recordings and national distribution. Through the 1980s, the commercial vallenato ensemble was further enlarged, with back-up singers, keyboards and Cuban percussion. By the early 1990s, vallenato had come to replace musica tropical as the new popular Colombian sound)"}, "madsrdf:citationSource": "New Grove, 2nd ed. WWW site, Jan. 11, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:n234aa55ea8e34f67853501574f151e3db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Afro-Colombian traditions: Vallenato emerged early in the 20th cent., influenced by work-related songs (zafras) and the Spanish romance. The term referred to a trio--accordion, caja (small, single-headed drum), and stick rasp (guacharaca)--that performed merengues and paseos. After a time, the term began to be used to describe a style and genre associated with the department of Valledupar. Cumbia and vallenato are the two most popular styles that have evolved out of the traditional music of Colombia. When vallenato spread from its rural context into the cities, its rhythms got simpler and other instruments--bass, guitar, conga, cowbell--joined the accordion-drum-scraper trio, modernizing the sound of the ensemble. By the 1980s, vallenato superseded salsa as the preferred music among blacks throughout much of Colombia)"}, "madsrdf:citationSource": "Garland encyc. of world music", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027155"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027156", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVariations (Music)", "identifiers:lccn": "gf2014027156", "madsrdf:adminMetadata": [{"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b1"}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Variations (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026701"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026807"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026989"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027000"}], "madsrdf:hasSource": {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b5"}, "madsrdf:hasVariant": [{"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b6"}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b9"}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Variations (Music)"}}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Variations. A form founded on repetition, and as such an outgrowth of a fundamental musical and rhetorical principle, in which a discrete theme is repeated several or many times with various modifications. )"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Musical variations"}}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musical variations"}}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Theme with variations"}}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theme with variations"}}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Theme and variations"}}, {"@id": "_:n9718a0626b3a458fb7919b609b9b27e4b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theme and variations"}}], "@id": "/authorities/genreForms/gf2014027156"}
