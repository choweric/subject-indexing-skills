{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026572", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aShow business films", "identifiers:lccn": "gf2011026572", "madsrdf:adminMetadata": [{"@id": "_:n0e9ffcc54d304adbb2574caf63b8e6bdb1"}, {"@id": "_:n0e9ffcc54d304adbb2574caf63b8e6bdb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Show business films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0e9ffcc54d304adbb2574caf63b8e6bdb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n0e9ffcc54d304adbb2574caf63b8e6bdb5"}, {"@id": "_:n0e9ffcc54d304adbb2574caf63b8e6bdb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that feature a behind-the-scenes look at the show business industry.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025579"}}, {"@id": "_:n0e9ffcc54d304adbb2574caf63b8e6bdb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n0e9ffcc54d304adbb2574caf63b8e6bdb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:10:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0e9ffcc54d304adbb2574caf63b8e6bdb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Show business films"}}, {"@id": "_:n0e9ffcc54d304adbb2574caf63b8e6bdb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Show business: fictional work dramatizing the world of performance, both on stage and on screen. The creative and artistic process is depicted, often going behind the scenes of the show, frequently dwelling on an individual tormented artist or the travails of a group producing their project)"}, "madsrdf:citationSource": "Moving image genre-form guide online, November 15, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0e9ffcc54d304adbb2574caf63b8e6bdb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "genre notes (show business: Films in which the milieu of show business is of major importance. Backstage musicals, pictures about the motion picture industry or radio or films in which a famous person's celebrity in one of those areas is central to the plot would all be show business genre films)"}, "madsrdf:citationSource": "AFI online catalog, March 26, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026572"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026573", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aShow business television programs", "identifiers:lccn": "gf2011026573", "madsrdf:adminMetadata": [{"@id": "_:nb482ec6fbbe347ce8a946b04be1d00eeb1"}, {"@id": "_:nb482ec6fbbe347ce8a946b04be1d00eeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Show business television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb482ec6fbbe347ce8a946b04be1d00eeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasSource": [{"@id": "_:nb482ec6fbbe347ce8a946b04be1d00eeb5"}, {"@id": "_:nb482ec6fbbe347ce8a946b04be1d00eeb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that feature a behind-the-scenes look at the show business industry.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025580"}}, {"@id": "_:nb482ec6fbbe347ce8a946b04be1d00eeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T11:09:52"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb482ec6fbbe347ce8a946b04be1d00eeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb482ec6fbbe347ce8a946b04be1d00eeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Show business television programs"}}, {"@id": "_:nb482ec6fbbe347ce8a946b04be1d00eeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Show business: fictional work dramatizing the world of performance, both on stage and on screen. The creative and artistic process is depicted, often going behind the scenes of the show, frequently dwelling on an individual tormented artist or the travails of a group producing their project)"}, "madsrdf:citationSource": "Moving image genre-form guide online, November 15, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb482ec6fbbe347ce8a946b04be1d00eeb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Studio 60 on the Sunset Strip, 2006.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026573"}
