{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026168", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aReviews", "identifiers:lccn": "gf2014026168", "madsrdf:adminMetadata": [{"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab1"}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Reviews"}, "madsrdf:elementList": {"@list": [{"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026052"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026079"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026129"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026190"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026194"}], "madsrdf:hasSource": [{"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab5"}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab6"}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab7"}], "madsrdf:hasVariant": [{"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab8"}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:48"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reviews"}}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(reviews (document genre). Periodicals, reports, or essays giving critical estimates and appraisals of art, a performance, or event. For other critical descriptions and analyses, prefer \"criticism.\")"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(review: An evaluative account of a recent artistic performance or exhibit, or of a newly published literary or scholarly work, usually written and signed by a qualified person, for publication in a current newspaper, magazine, or journal. The account can be descriptive, reportorial, comparative, or critical or serve as a vehicle for a lengthy essay in which the reviewer discusses several recently published works (omnibus review) or a broader topic for which the works reviewed serve as a springboard. Synonymous with critique.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 72 (review: account or criticism of a new book etc.; periodical)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Critiques"}}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Critiques"}}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Critical reviews"}}, {"@id": "_:na8ddc7e0a67a47289293b71a1378ca6ab12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Critical reviews"}}], "@id": "/authorities/genreForms/gf2014026168"}
