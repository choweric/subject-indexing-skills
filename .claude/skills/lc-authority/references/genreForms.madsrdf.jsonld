n", "@value": "Country rock music"}}, {"@id": "_:n2a6ad243fa7c4ac2a49ed471d7c0212eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(country-rock; a style of popular music in which the sound and subject matter of country music are combined with a rock beat and instrumentation)"}, "madsrdf:citationSource": "New Grove dict. of Am. music", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a6ad243fa7c4ac2a49ed471d7c0212eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(country rock; country and rock fusion music by such artists as the Eagles, the Everly Brothers, etc.)"}, "madsrdf:citationSource": "White, D. Dict. of popular music styles of the world", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a6ad243fa7c4ac2a49ed471d7c0212eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (country rock) Introd. (originated in the late 1960s)"}, "madsrdf:citationSource": "Work cat.: 00031572: Einarson, J. Desperados, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2a6ad243fa7c4ac2a49ed471d7c0212eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(country rock)"}, "madsrdf:citationSource": "Shuker, R. Key concepts in popular music", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026740"}
