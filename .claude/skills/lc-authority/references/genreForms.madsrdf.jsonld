{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026029", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCatechisms", "identifiers:lccn": "gf2015026029", "madsrdf:adminMetadata": [{"@id": "_:n714c52e5adb84d669004835bdf6088fbb1"}, {"@id": "_:n714c52e5adb84d669004835bdf6088fbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Catechisms"}, "madsrdf:elementList": {"@list": [{"@id": "_:n714c52e5adb84d669004835bdf6088fbb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026114"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026026"}], "madsrdf:hasSource": [{"@id": "_:n714c52e5adb84d669004835bdf6088fbb5"}, {"@id": "_:n714c52e5adb84d669004835bdf6088fbb6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that provide comprehensive instruction on doctrines and are often structured in question-and-answer form."}, {"@id": "_:n714c52e5adb84d669004835bdf6088fbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-06-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n714c52e5adb84d669004835bdf6088fbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:29:13"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n714c52e5adb84d669004835bdf6088fbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Catechisms"}}, {"@id": "_:n714c52e5adb84d669004835bdf6088fbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(catechism, def. 2: a manual or guide for catechizing (as for moral and religious instruction) sometimes in the form of a comprehensive summary of doctrine and often in the form of questions and answers)"}, "madsrdf:citationSource": "Merriam Webster online, June 2, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n714c52e5adb84d669004835bdf6088fbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Catechisms; Scope note: This heading is used for books of doctrinal instruction, often structured in question and answer form.)"}, "madsrdf:citationSource": "Religion genre/form terms: information gathered on behalf of the Library of Congress... American Theological Library Association, et. al, c2012:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2015026029"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026030", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChirographa (Personal correspondence)", "identifiers:lccn": "gf2015026030", "madsrdf:adminMetadata": [{"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb1"}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Chirographa (Personal correspondence)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026141"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026026"}], "madsrdf:hasSource": [{"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb5"}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb6"}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb7"}], "madsrdf:hasVariant": [{"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb8"}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb11"}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb14"}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Personal letters written by the Roman Catholic pope."}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T17:40:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-06-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chirographa (Personal correspondence)"}}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "chirograph (1: any of various legal instruments formally written or signed: such as a: an indenture formerly made in duplicate on one sheet, the sheet or parchment being divided and often the word chirographum written in where the division was made b: the indenture of a fine of lands; also: one of the counterparts of such an indenture c: an obligation (as a bond or note) given in one's own handwriting; 2: an apostolic letter in the handwriting and with the signature of the pope; plural: chirographs)"}, "madsrdf:citationSource": "Merriam Webster online, Sept. 8, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Documents, Papal (Simple pontifical letters are those addressed by the Holy Father to one or more cardinals, bishops, religious, or lay persons on some personal or social occasion. Autograph letters (chirographi) are ordinarily addressed to a cardinal, written in the hand of the pope. They are disciplinary rather than doctrinal in that they contain suggestions and directions for the conduct of Church affairs. These same letters have been used also to addresd heads of state or certain distinguished members of the hierarchy on special occasions.)"}, "madsrdf:citationSource": "New Catholic encyclopedia, 1981:", "madsrdf:citationStatus": "found"}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Chirographa: Scope note: This heading is used for personal letters written by the Roman Catholic Pope. BT Correspondence; RT Papal documents)"}, "madsrdf:citationSource": "Religion genre/form terms: information gathered on behalf of the Library of Congress... American Theological Library Association, et. al, c2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chirographs (Personal correspondence)"}}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chirographs (Personal correspondence)"}}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Chirographi (Personal correspondence)"}}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chirographi (Personal correspondence)"}}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Letters, Papal"}}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Letters, Papal"}}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Papal letters"}}, {"@id": "_:n21cb9a0982e24865b50ca3c8d4c2452bb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Papal letters"}}], "@id": "/authorities/genreForms/gf2015026030"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2015026031", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCreeds", "identifiers:lccn": "gf2015026031", "madsrdf:adminMetadata": [{"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b1"}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Creeds"}, "madsrdf:elementList": {"@list": [{"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b3"}]}, "madsrdf:exampleNote": "Note under [Manifestos]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026026"}, "madsrdf:hasSource": [{"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b5"}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b6"}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b7"}], "madsrdf:hasVariant": [{"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b8"}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b11"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Concise authorized statements of religious doctrine within religions or denominations. For written statements that describe the goals, opinions, and policies of a person or group see [Manifestos.]"}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-06-02T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-20T15:46:25"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Creeds"}}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Creeds: Scope note: This heading is used for concise authorized statements of religious doctrine used within the confessing tradition. UF Confessions of faith; Creedal statements)"}, "madsrdf:citationSource": "Religion genre/form terms: information gathered on behalf of the Library of Congress... American Theological Library Association, et. al, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "creed (def. 1a: A form of words setting forth authoritatively and concisely the general belief of the Christian Church, or those articles of belief which are regarded as essential; a brief summary of Christian doctrine: usually and properly applied to the three statements of belief known as the Apostles', Nicene, and Athanasian Creeds)"}, "madsrdf:citationSource": "OED online, Sept. 8, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Creed: def. 1: a brief authoritative doctrinal formula beginning with such words as \"Credo\", \"Credimus\", \"I believe\", \"We believe\", intended to define what is held by a Christian congregation, synod, or church to be true and essential and exclude what is held to be false belief)"}, "madsrdf:citationSource": "Merriam Webster online, June 2, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Confessions of faith"}}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Confessions of faith"}}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Faith, Confessions of"}}, {"@id": "_:n03a5bc8ac9cd4a1db73401bcab8076b1b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Faith, Confessions of"}}], "@id": "/authorities/genreForms/gf2015026031"}
