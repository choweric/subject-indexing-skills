srdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gores (Maps)"}}, {"@id": "_:n001375f8b989402bb22c1e173221fffeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Globes--Gores (Triangular or lune-shaped segment that can be fitted to the surface of a sphere with little distortion or deformation)"}, "madsrdf:citationSource": "Form/genre for cartographic materials [draft of LC working group], 1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:n001375f8b989402bb22c1e173221fffeb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "gore (def. 2: a line-shaped part of a map, which may be fitted to the surface of a globe with a neglible amount of distortion; a.k.a. globe gore; A terrestrial or celestial globe may be constructed by covering a sphere with a complete set of gores each having the form of a lune of such narrow width that it may be mounted on the sphere without appreciable stretching or shrinking; def. 3: a map of the narrow region between two meridians close together)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n001375f8b989402bb22c1e173221fffeb7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n001375f8b989402bb22c1e173221fffeb8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Globe gores"}}, {"@id": "_:n001375f8b989402bb22c1e173221fffeb8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Globe gores"}}], "@id": "/authorities/genreForms/gf2011026304"}
