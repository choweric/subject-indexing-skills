3426fb7959b6e57a7ca65b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(also Hula-hula)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n26f7df507423426fb7959b6e57a7ca65b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Harvard dict. of mus.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n26f7df507423426fb7959b6e57a7ca65b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "hula (generic name for Hawaiian dance, sometimes applied loosely to other dances of the Pacific Islands; under Polynesia/Eastern Polynesia/Hawaii/Traditional vocal music: Hula are poetic texts intended for presentation as dance; they are metred and incorporate instrumental accompaniment.)"}, "madsrdf:citationSource": "New Grove dict. of mus. WWW site, June 13, 2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n26f7df507423426fb7959b6e57a7ca65b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n26f7df507423426fb7959b6e57a7ca65b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hula-hulas (Music)"}}, {"@id": "_:n26f7df507423426fb7959b6e57a7ca65b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hula-hulas (Music)"}}], "@id": "/authorities/genreForms/gf2014026868"}
