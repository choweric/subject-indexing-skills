{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2021026032", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelevision criticism and reviews", "identifiers:lccn": "gf2021026032", "madsrdf:adminMetadata": [{"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b1"}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Television criticism and reviews"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026190"}], "madsrdf:hasSource": [{"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b5"}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b6"}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b7"}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b8"}], "madsrdf:hasVariant": [{"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b9"}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b12"}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b15"}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b18"}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b21"}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works that evaluate, study, and discuss television programs of any genre."}, {"@id": "_:n1cf121431b0149e5a3a0ec3b36216aa6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2021-09-15T13:56:14"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1cf121431b0149e5a3a