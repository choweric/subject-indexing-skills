pe": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jungle film (Ape movies, Cannibal films, Safari movies, Tarzan pictures). Adventure stories with a jungle background. Replete with such ingredients as safaris, white hunters, preserve wardens, warring tribes, hidden treasures, white witches, Amazons, goddesses, lost cities)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026344"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026345", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJungle television programs", "identifiers:lccn": "gf2011026345", "madsrdf:adminMetadata": [{"@id": "_:n7cf3b52e2db34a93a516c5edb05cf072b1"}, {"@id": "_:n7cf3b52e2db34a93a516c5edb05cf072b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Jungle television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7cf3b52e2db34a93a516c5edb05cf072b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026006"}, "madsrdf:hasSource": [{"@id": "_:n7cf3b52e2db34a93a516c5edb05cf072b5"}, {"@id": "_:n7cf3b52e2db34a93a516c5edb05cf072b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Adventure television programs that feature a jungle background.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025295"}}, {"@id": "_:n7cf3b52e2db34a93a516c5edb05cf072b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T06:50:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7cf3b52e2db34a93a516c5edb05cf072b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n7cf3b52e2db34a93a516c5edb05cf072b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Jungle television programs"}}, {"@id": "_:n7cf3b52e2db34a93a516c5edb05cf072b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Jungle: Fictional work set in the jungles of South America, Africa, or Asia, relating the adventures of humans against ferocious wild animals, the discovery of lost cities, Westerners against threatening natives, or the competition between rival tribes in an untamed setting)"}, "madsrdf:citationSource": "Moving image genre-form guide online, July 30, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n7cf3b52e2db34a93a516c5edb05cf072b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Jungle television programs)"}, "madsrdf:citationSource": "LCSH, July 30, 2007", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026345"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026346", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJuvenile delinquency films", "identifiers:lccn": "gf2011026346", "madsrdf:adminMetadata": [{"@id": "_:n705d360af9764a23839d7522a58e04b8b1"}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Juvenile delinquency films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n705d360af9764a23839d7522a58e04b8b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026177"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026632"}], "madsrdf:hasSource": [{"@id": "_:n705d360af9764a23839d7522a58e04b8b5"}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b6"}], "madsrdf:hasVariant": [{"@id": "_:n705d360af9764a23839d7522a58e04b8b7"}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b10"}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b13"}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b16"}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b19"}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b22"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025337"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:24:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Juvenile delinquency films"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Juvenile delinquency drama. Use for fictional genre films or programs about gangs of teenagers who dabble in crime. UF Hoodlum drama, Juvenile delinquency films, Troubled youth drama. BT Teen drama. RT Crime drama, Motorcycle gang drama)"}, "madsrdf:citationSource": "Yee, M. Moving image materials, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 163 (Juvenile Delinquency Film (Delinquent Movie, Hoodlum Drama, J. D. Film). A substantial number of youth films deal with delinquency among teenagers. These films form a group by themselves, and have been referred to as a distinct genre. Rebellious youths have figured mainly in expos\u00e9 or exploitation films, in films dealing with delinquency in high schools or reform schools, in films dealing with youngsters' misdeeds or with the rivalries prevailing among street gangs competing for power or territorial rights.) p. 67 (subcategory under Crime Film: Juvenile Delinquent Films. Juvenile or young criminal heroes are found leading street gangs, rebelling against school discipline, committing petty thievery which escalates to major crimes, or they are portrayed as dope addicts, engaged in prostitution, or else incarcerated in penal institutions for the young. It is a very popular type of film, and a major branch of the youth picture as well as of the crime film.) p. 301 (subcategory under Social Consciousness Film: Juvenile Delinquent Films. Juvenile delinquency has often been the subject of the social consciousness film. Juvenile delinquent films have mostly presented the problems of the young, the slum conditions where they grew up and the reform schools they were sent to.) p. 333 (subcategory under Teen Movie: Teen-Violence Films (Teenage-Violence Movies). Another type of film in which violence thrives is the youth gang film, which mostly forms part of the juvenile delinquency genre; Youth Gang Films (Gang Films, Youth Street Films))"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705d360af9764a23839d7522a58e04b8b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hoodlum drama (Motion pictures)"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hoodlum drama (Motion pictures)"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705d360af9764a23839d7522a58e04b8b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Youth street films"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Youth street films"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705d360af9764a23839d7522a58e04b8b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Juvenile delinquent films"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Juvenile delinquent films"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705d360af9764a23839d7522a58e04b8b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "J.D. films"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "J.D. films"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705d360af9764a23839d7522a58e04b8b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gang films"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gang films"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n705d360af9764a23839d7522a58e04b8b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Youth gang films"}}, {"@id": "_:n705d360af9764a23839d7522a58e04b8b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Youth gang films"}}], "@id": "/authorities/genreForms/gf2011026346"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026347", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aJuvenile delinquency television programs", "identifiers:lccn": "gf2011026347", "madsrdf:adminMetadata": [{"@id": "_:n67257f106c9c4c19a0b788a2a4d7ccbab1"}, {"@id": "_:n67257f106c9c4c19a0b788a2a4d7ccbab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Juvenile delinquency television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n67257f106c9c4c19a0b788a2a4d7ccbab3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026633"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026658"}], "madsrdf:hasSource": [{"@id": "_:n67257f106c9c4c19a0b788a2a4d7ccbab5"}, {"@id": "_:n67257f106c9c4c19a0b788a2a4d7ccbab6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025296"}}, {"@id": "_:n67257f106c9c4c19a0b788a2a4d7ccbab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n67257f106c9c4c19a0b788a2a4d7ccbab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:24:16"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n67257f106c9c4c19a0b788a2a4d7ccbab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Juvenile delinquency television programs"}}, {"@id": "_:n67257f106c9c4c19a0b788a2a4d7ccbab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 59 (Juvenile delinquency films and programs: use for fictional genre films or programs about gangs of teenagers who dabble in crime)"}, "madsrdf:citationSource": "Yee, Martha M. Moving image materials : genre terms, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n67257f106c9c4c19a0b788a2a4d7ccbab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Juvenile delinquency: fictional work depicting criminal tendencies and actions among people in their teens and twenties. The setting is often in an urban slum or a school, with the characters becoming members of rival gangs, with events leading to violence. Such work is typically aimed largely at a younger audience, through representations of misunderstood youth rebelling against the perceived restraints and hypocrisies of adults)"}, "madsrdf:citationSource": "Moving image genre-form guide online, August 20, 2007:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026347"}
