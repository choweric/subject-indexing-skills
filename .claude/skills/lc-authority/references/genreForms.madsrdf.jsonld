{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026104", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVideo games", "identifiers:lccn": "gf2022026104", "madsrdf:adminMetadata": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b1"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Video games"}, "madsrdf:elementList": {"@list": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, "madsrdf:hasSource": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b5"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b6"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b7"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b8"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b9"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b10"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b11"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b12"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b13"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b14"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b15"}], "madsrdf:hasVariant": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b16"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b19"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b22"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b25"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b28"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b31"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b34"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b37"}], "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Electronic games in which players control graphics on a video screen, computer monitor, mobile device, etc. by manipulating an input device such as a joystick, controller, keyboard, or motion sensing device."}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-31T11:18:51"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Video games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(video game: an electronic game in which players control images on a video screen)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Dec. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Video games, also known as computer games, are electronic games that involves interaction with a user interface or input device--such as a joystick, controller, keyboard, or motion sensing device--to generate visual feedback; The term \"video game\" was developed to distinguish this class of electronic games that were played on some type of video display rather than on a teletype printer or similar device; \"Computer game\" may also be used as a descriptor, as all these types of games essentially require the use of a computer processor, and in some cases, it is used interchangeably with \"video game\". However, the term \"computer game\" can also be used to more specifically refer to games played primarily on personal computers or other type of flexible hardware systems (also known as a PC game), as a way distinguish them from console games or mobile games. Other terms such as \"television game\" or \"telegame\" had been used in the 1970s and early 1980s, particularly for the home consoles that connect to a television set; \"Electronic game\" may also be used to refer to video games, but this also incorporates devices like early handheld electronic games that lack any video output)"}, "madsrdf:citationSource": "Wikipedia, Dec. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)316535543"}, "madsrdf:citationSource": "Lego Batman : the videogame, \u00a92008.", "madsrdf:citationStatus": "found"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(video game: any of various electronic games that are played by manipulating an input device in response to the graphics on a screen)"}, "madsrdf:citationSource": "Collins English dictionary online, Dec. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1292753761"}, "madsrdf:citationSource": "MXGP 2019 : the official motocross videogame, 2019.", "madsrdf:citationStatus": "found"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(video game or videogame: 1. any of various interactive games played using a specialized electronic gaming device or a computer or mobile device and a television or other display screen, along with a means to control graphic images. 2. any of various games played using a microchip-controlled device, as an arcade machine or handheld toy.)"}, "madsrdf:citationSource": "Dictionary.com, Dec. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(video game: A video game is an electronic or computerized game that you play on your television or on a computer screen)"}, "madsrdf:citationSource": "Collins COBUILD advanced learner's dictionary, via Collins English dictionary website, Dec. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an action adventure video game) (OCoLC)1233208676"}, "madsrdf:citationSource": "Hitman III, 2021", "madsrdf:citationStatus": "found"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "keywords > video game (The video game is a relatively new genre. The first known game on an electronic platform was a computerized version of \"Tic-Tac-Toe named Noughts and Crosses\", though this was limited to the computer it had been built on. In 1962, Spacewar was programmed, and was the first known video game to \"adhere to programming standards\", so it could be played on computers other than the unique machine it had been built on; Early video games were short and based on goal-oriented, real-time action, focusing on the inputs of the player in a controlled, tactile environment; As technology improved, games that crossed genres became more and more common. Games like Donkey Kong and Mario Bros had both action and narrative, while Pacman was one of the first video games with an identifiable main character. With the creation of 3D gaming platforms, the player could have more aesthetically realistic experiences. Today, many video games \"focus on realistically stimulating experiences\"; The video game itself is a mishmash of video, art, and sound multimedia--and much like cinema, conveys to its reader or viewer its fullness in stimulation)"}, "madsrdf:citationSource": [{"@id": "https://lucian.uchicago.edu/blogs/mediatheory/keywords/video-game/"}, "The Chicago School of Media Theory blog, Dec. 12, 2022:"], "madsrdf:citationStatus": "found"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)722392663"}, "madsrdf:citationSource": "Lego Pirates of the Caribbean : the video game, \u00a92011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivision --Computer games. BT --Software. SN Use as a form subdivision under subjects for computer games on those subjects)"}, "madsrdf:citationSource": "LCSH, Dec. 12, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Computer games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Computer games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Console games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Console games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mobile games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mobile games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Television games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Television games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Online games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Online games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Videogames"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Videogames"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Telegames"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telegames"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Electronic games"}}, {"@id": "_:n14f0d7a152dc4e528c678fee97eb5c73b38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Electronic games"}}], "@id": "/authorities/genreForms/gf2022026104"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026107", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPromptbooks", "identifiers:lccn": "gf2022026107", "madsrdf:adminMetadata": [{"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb1"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Promptbooks"}, "madsrdf:elementList": {"@list": [{"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasSource": [{"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb5"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb6"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb7"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb8"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb9"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb10"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb11"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb12"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb13"}], "madsrdf:hasVariant": {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb14"}, "madsrdf:historyNote": "[Established May 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Play texts marked or annotated for cues, cuts, stage movement, etc. by prompter, stage manager, actor, or director for use in a theatrical production."}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-05-02T14:59:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-16T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Promptbooks"}}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Promptbooks. BT Drama; Theater. SN Here are entered texts, or works on texts, of plays marked for cues, cuts, stage movement, etc. by prompter, stage manager, actor or director for use in a theatrical production.)"}, "madsrdf:citationSource": "LCSH, Dec. 16, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1370284"}, "madsrdf:citationSource": "Work cat.: 8 popular plays for amateurs in prompt book style : a practical production anthology, 1948.", "madsrdf:citationStatus": "found"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(promptbook: a copy of the script of a play, containing cues and notes, used by the prompter, stage manager, etc.)"}, "madsrdf:citationSource": "Dictionary.com, Dec. 16, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Prompt book (The prompt book, also called transcript, the bible or sometimes simply \"the book,\" is the copy of a production script that contains the information necessary to create a theatrical production from the ground up. It is a compilation of all blocking, business, light, speech and sound cues, lists of properties, drawings of the set ... As audience expectations for spectacle evolved in the 19th century, prompt books were published to describe the techniques involved in constructing complex scenery and special effects. These prompt books more closely resemble instructional works on how to create scenery, as they often included recommendations for simplification for less well-equipped theatres, than they do a modern prompt book)"}, "madsrdf:citationSource": "Wikipedia, Dec. 16, 2022:", "madsrdf:citationStatus": "found"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (the play abridged and arranged for dramatic production in colleges and secondary schools) (OCoLC)4454131"}, "madsrdf:citationSource": "Bacon, F. L. A modern prompt-book of William Shakespeare's The taming of the shrew, \u00a91935:", "madsrdf:citationStatus": "found"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)2213206"}, "madsrdf:citationSource": "Shaw, G. B. Macbeth onstage : an annotated facsimile of Glen Byam Shaw's 1955 promptbook, 1976.", "madsrdf:citationStatus": "found"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(promptbook: a copy of a play with directions for performance used by a theater prompter)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Dec. 16, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)390723"}, "madsrdf:citationSource": "Shakespeare, W. William Charles Macready's King John : a facsimile prompt-book, 1962.", "madsrdf:citationStatus": "found"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(promptbook: the production script of a play containing notes, cues, etc)"}, "madsrdf:citationSource": "Collins English dictionary online, Dec. 16, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prompt books"}}, {"@id": "_:na3e2a1ee82874e6e91946fe89eeed9bfb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prompt books"}}], "@id": "/authorities/genreForms/gf2022026107"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2022026108", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aNew wave films", "identifiers:lccn": "gf2022026108", "madsrdf:adminMetadata": {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b1"}, "madsrdf:authoritativeLabel": {"@language": "en", "@value": "New wave films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4b129e1416d14d7392a2706742e5bd78b2"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n4b129e1416d14d7392a2706742e5bd78b4"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b5"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b6"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b7"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b8"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b9"}], "madsrdf:hasVariant": [{"@id": "_:n4b129e1416d14d7392a2706742e5bd78b10"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b13"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b16"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b19"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026419"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025204"}]}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-12-20T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b2", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "New wave films"}}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b4", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(new wave cinemas)"}, "madsrdf:citationSource": "Russell, C. Narrative morality, 1995", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Moving image genre form guide via WWW, July 18, 2007;Films by genre, 1993", "madsrdf:citationStatus": "notfound"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (new wave French cinema)"}, "madsrdf:citationSource": "Kline, T.J. Screening the text, 1992:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Bazin, A. Cinema fran\u00e7ais de la liberation a la nouvelle vague, 1983.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(new wave)"}, "madsrdf:citationSource": "Forbes, J. The cinema in France, 1994", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(New wave; French nouvelle vague; 1950s film char. by brilliance of technique; directed preeminently by L. Malle, C. Chabrol, F. Truffaut, J-L. Godard & A. Resnais)"}, "madsrdf:citationSource": "Britannica Micro.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b129e1416d14d7392a2706742e5bd78b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nouvelles vagues (Motion pictures)"}}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nouvelles vagues (Motion pictures)"}}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b129e1416d14d7392a2706742e5bd78b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "New wave cinema"}}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "New wave cinema"}}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b129e1416d14d7392a2706742e5bd78b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "New wave (Motion pictures)"}}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "New wave (Motion pictures)"}}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4b129e1416d14d7392a2706742e5bd78b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nouvelle vague (Motion pictures)"}}, {"@id": "_:n4b129e1416d14d7392a2706742e5bd78b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nouvelle vague (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2022026108"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026002", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGay musicals", "identifiers:lccn": "gf2023026002", "madsrdf:adminMetadata": [{"@id": "_:n91f24b27fd1447118c4c4d638b588b94b1"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gay musicals"}, "madsrdf:elementList": {"@list": [{"@id": "_:n91f24b27fd1447118c4c4d638b588b94b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026957"}, "madsrdf:hasSource": [{"@id": "_:n91f24b27fd1447118c4c4d638b588b94b5"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b6"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b7"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b8"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b9"}], "madsrdf:hasVariant": {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b10"}, "madsrdf:historyNote": "[Established May 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musicals featuring gay characters or addressing gay themes."}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "revised"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay musicals"}}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Lesbian, gay, bisexual, transgender, and queer music in the United States (With the 1970s articulation of gay and lesbian identity, musicals with gay themes or characters arrived, many of them becoming mainstream commercial successes. If Cabaret (Masteroff/Kander/Ebb, 1966) both spectacularized and masked homosexuality, and Applause (Comden/Green/Strauss/Adams, 1970) presented it as pathology, Michael Bennett's A Chorus Line (Hamlisch/Kirkwood/Dante/Kleban, 1975) sentimentalized it in a characteristically liberal way. La cage aux folles (Fierstein/Herman, 1983) affectionately portrays a gay couple, one of whom is a drag queen, and Kiss of the Spider Woman (McNally/Kander/Ebb, 1992) adapted Manuel Puig's novel about the growing attachment between two prisoners, one homosexual and the other heterosexual ... Recent LGBTQ representations in musical theater include those in Hairspray (2002) and The Color Purple (2005))"}, "madsrdf:citationSource": "Grove music online, Jan. 5, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(musicals whose central characters and plots were gay; 1984: La Cage Aux Folles. The most famous and most successful gay musical on Broadway)"}, "madsrdf:citationSource": "Gay musicals, via Queer music heritage website, Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)13654879"}, "madsrdf:citationSource": "Work cat.: Herman, Jerry. La cage aux folles : original cast recording, 1984, \u21171983", "madsrdf:citationStatus": "found"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 134 (Broadway didn't get its first \"gay musical\" until La Cage aux Folles in 1983, but the new genre was popping up Off Broadway by the mid-1970s) p. 135 (Boy Meets Boy reminds one of the 1970s, before the AIDS epidemic, when there was nothing threatening or foreboding about a gay musical) p. 167 (March of the Falsettos established [William] Finn as a major figure in American musical theatre. Not only were his music and lyrics invigorating and fresh, but his subject matter was also innovative. Musicals about homosexuals had been labeled gay musicals and limited themselves to a special worldview. In Finn's works, the gay characters were just a given circumstance. His musicals were not about being gay but about people who happened to be homosexual) (OCoLC)1136298069"}, "madsrdf:citationSource": "Hischak, Thomas S. Off-Broadway musicals since 1919, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(La Cage Aux Folles (1983). The first Broadway musical to put gay characters center stage, La Cage Aux Folles is the fairy godmother of LGBTQ+ musical theater)"}, "madsrdf:citationSource": "Feldman, A. The 10 best gay musicals of all time, via TimeOut website, June 29, 2021, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n91f24b27fd1447118c4c4d638b588b94b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Homosexual musicals"}}, {"@id": "_:n91f24b27fd1447118c4c4d638b588b94b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Homosexual musicals"}}], "@id": "/authorities/genreForms/gf2023026002"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026003", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLesbian musicals", "identifiers:lccn": "gf2023026003", "madsrdf:adminMetadata": [{"@id": "_:n4269a162308247b48d3edbb84668b18eb1"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lesbian musicals"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4269a162308247b48d3edbb84668b18eb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026957"}, "madsrdf:hasSource": [{"@id": "_:n4269a162308247b48d3edbb84668b18eb5"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb6"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb7"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb8"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb9"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb10"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb11"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb12"}], "madsrdf:hasVariant": [{"@id": "_:n4269a162308247b48d3edbb84668b18eb13"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb16"}], "madsrdf:historyNote": "[Established May 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musicals featuring lesbian characters or addressing lesbian themes."}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/npkmc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lesbian musicals"}}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Color Purple (2005). When The Color Purple premiered on Broadway in 2005, the beautiful central journey of its main character, Miss Celie, got somewhat lost in an oversize production that cautiously downplayed Celie's same-sex love affair with the paramour of her abusive husband. But that central aspect of Alice Walker's 1982 novel--as adapted by playwright Marsha Norman and a team of three pop songwriters--emerged more clearly in the musical's smaller-scaled 2015 revival, which intensified The Color Purple to bring out its deeper hues)"}, "madsrdf:citationSource": "Feldman, A. The 10 best gay musicals of all time, via TimeOut website, June 29, 2021, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lesbian musicals are nearly unheard of)"}, "madsrdf:citationSource": "Hetrick, A. Fun Home musical brings life of lesbian cartoonist to Broadway, via Playbill website, Mar. 27, 2015, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Lesbian, gay, bisexual, transgender, and queer music in the United States (With the 1970s articulation of gay and lesbian identity, musicals with gay themes or characters arrived, many of them becoming mainstream commercial successes ... Recent LGBTQ representations in musical theater include those in Hairspray (2002) and The Color Purple (2005))"}, "madsrdf:citationSource": "Grove music online, Jan. 5, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(musical theater adaptation of Alice Walker's novel of the same title) (OCoLC)934509060"}, "madsrdf:citationSource": "Work cat.: Russell, Brenda. The color purple : new Broadway cast recording, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In Blind Faith; a two-act original musical; a slick, well-produced, unapologetically sapphic musical that will appeal to all)"}, "madsrdf:citationSource": "In blind faith (musical review), via Regional news--eyes on Wellington website, viewed Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(several recent musicals have started to explore lesbian, bisexual and pansexual female characters as protagonists. Alice Walker's beautiful novel The Color Purple was turned into a Broadway musical; Bad Girls - The Musical, The Color Purple and Fun Home remain the only three West End and Broadway musicals to have queer female characters written by at least one openly queer female writer, but several other musicals have incorporated lesbian and female bisexual characters into their narratives including Falsettos, Head Over Heels, If/Then, Jagged Little Pill, Mean Girls, The Prom, Rent and The Wild Party. Head Over Heels and The Prom are notable in that they both end with their lesbian protagonists in happy same-sex relationships)"}, "madsrdf:citationSource": "Lesbian characters in musical theatre, via queermusicals.com, viewed Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a search through the back catalogue of musicals reveals a dearth of explicitly lesbian characters; the Tony-award-winning success of Fun Home didn't see an immediate onslaught of more lesbian musicals)"}, "madsrdf:citationSource": "Marsden, M. \"Fun Home\" proves that musical theatre is for lesbians, via Junkee website, 6 May 2021, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 107 (In 1922 \"Lena\" [Marlene Dietrich] joined the Rudolf Nelson Girls, a female troupe presenting risqu\u00e9 lesbian musicals)"}, "madsrdf:citationSource": "Fleming, E.J. The fixers, \u00a92005:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4269a162308247b48d3edbb84668b18eb14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sapphic musicals"}}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sapphic musicals"}}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4269a162308247b48d3edbb84668b18eb17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Homosexual musicals"}}, {"@id": "_:n4269a162308247b48d3edbb84668b18eb17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Homosexual musicals"}}], "@id": "/authorities/genreForms/gf2023026003"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026004", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBiographical musicals", "identifiers:lccn": "gf2023026004", "madsrdf:adminMetadata": [{"@id": "_:n765e69dd53e04407a2a444f505dbbf76b1"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Biographical musicals"}, "madsrdf:elementList": {"@list": [{"@id": "_:n765e69dd53e04407a2a444f505dbbf76b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026957"}, "madsrdf:hasSource": [{"@id": "_:n765e69dd53e04407a2a444f505dbbf76b5"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b6"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b7"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b8"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b9"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b10"}], "madsrdf:hasVariant": [{"@id": "_:n765e69dd53e04407a2a444f505dbbf76b11"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b14"}], "madsrdf:historyNote": "[Established May 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-05-02T14:59:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biographical musicals"}}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Musical [musical comedy, musical play]: Robert Wright and George Forrest in their adaptation of Grieg for their biographical musical of him, Song of Norway (1944, film 1970); The pop world has been represented by bio-musicals of such figures as Buddy Holly; under Brice, Fanny: Funny Girl, a highly successful musical based on her life)"}, "madsrdf:citationSource": "Grove music online, Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the biographical musical \"Fun Home\")"}, "madsrdf:citationSource": "Dunn, P. Touching musical brings \"Fun Home\"' to the Fisher, via The Detroit news website, published Nov. 23, 2016, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fun Home\u00a0is a unique twist on the biographical musical. Lifting its major plot points from the graphic memoir of the same name, we follow the life of cartoonist Alison Bechdel as she grapples with her sexuality, her relationship with her father, and how to navigate life)"}, "madsrdf:citationSource": "Bergman, G. Adam Murphy on Fun Home and becoming Bruce Bechdel, via AussieTheatre.com website, 15 Feb. 2022, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Fun Home,\" the biographical musical based on Alison Bechdel's best-selling graphic memoir of the same name)"}, "madsrdf:citationSource": "Quinn, D. Tony-winning musical \"Fun Home\" closing on Broadway in September, via NBC New York website, published June 21, 2016, updated on June 23, 2016, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(vocal score) t.p. (music by Jeanine Tesori ; book and lyrics by Lisa Kron ; based on the graphic novel by Alison Bechdel) (OCoLC)957130100"}, "madsrdf:citationSource": "Work cat.: Tesori, Jeanine. Fun home : a new Broadway musical, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "slide 20 (types of musicals: autobiographical musicals) slide 23 (jukebox musicals: usually a story made up based on songs, typically one artist's songs and can be used to tribute the band/artist without much plot, and then there are biographic musicals that include a plot) slide 29 (autobiographical musicals: these musicals are influenced by/derived from an event or stories of a person. The life and career of a particular individual will be explored by this style of musical, combining songs into a specially constructed storyline for the musical)"}, "madsrdf:citationSource": "Calvert, Rosie. Musical theatre history, 2022, via Prezi website, viewed Jan. 5, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n765e69dd53e04407a2a444f505dbbf76b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Bio-musicals"}}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bio-musicals"}}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n765e69dd53e04407a2a444f505dbbf76b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Biographic musicals"}}, {"@id": "_:n765e69dd53e04407a2a444f505dbbf76b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Biographic musicals"}}], "@id": "/authorities/genreForms/gf2023026004"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026005", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGay operas", "identifiers:lccn": "gf2023026005", "madsrdf:adminMetadata": [{"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb1"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gay operas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026976"}, "madsrdf:hasSource": [{"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb5"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb6"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb7"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb8"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb9"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb10"}], "madsrdf:hasVariant": {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb11"}, "madsrdf:historyNote": "[Established May 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Operas featuring gay characters or addressing gay themes."}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ic"}, "ri:recordStatus": "revised"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay operas"}}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Gay and lesbian music (Closet dramas or parables abound: Szymanowski's King Roger, Henze's The Bassarids, Britten's Albert Herring, Owen Wingrave and Death in Venice; Britten's Peter Grimes is a powerful allegory of homosexual oppression; \"Real\" gay or lesbian characters are harder to find. Mel and Dov, the interracial couple in Tippett's The Knot Garden (1970), appear to be opera's first \"out\" gay males; Harvey Milk, an opera by Stewart Wallace and Michael Korie on the life and times of a gay activist assassinated in 1978; opera companies marketing to their audience, are more frequently producing gay and lesbian operas, for example Matthias Pintscher's Thomas Chatterton (Dresden) and Paula M. Kimper's Patience and Sarah (New York))"}, "madsrdf:citationSource": "Grove music online, Jan. 5, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(operas on gay themes have proliferated. Since 2010, the crop of gay-oriented works has included Jorge Mart\u00edn's \"Before Night Falls\" and Charles Wuorinen's \"Brokeback Mountain;\" Theodore Morrison's \"Oscar,\" on the life of Wilde; Terence Blanchard's \"Champion,\" about the gay African-American boxer Emile Griffith; two period operas by Gregory Spears, \"Paul's Case\" and \"Fellow Travelers\"; Mark Simpson's \"Pleasure,\" set at a gay night club; Kevin March's \"Les Feluettes,\" based on Michel Marc Bouchard's play \"Lilies\"; Andrea Scartazzini's \"Edward II\"; In the twentieth century, the field of gay opera was dominated by Benjamin Britten; A second wave of gay operas began in the nineteen-nineties; City Opera plans to stage a gay-themed opera each year during pride month; Of the recent gay operas I've seen, those that linger longest in my mind are the two by Spears)"}, "madsrdf:citationSource": "Ross, A. The decline of opera queens and the rise of gay opera, via The New Yorker website, posted July 27, 2017, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Brokeback Mountain; 2014 opera by Charles Wuorinen)"}, "madsrdf:citationSource": "Salazar, F. Pride Month 2017 : a look at the LGBT operas in history, via OperaWire website, posted June 1, 2017, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Operas > Brokeback Mountain (the story of ranch hand Ennis del Mar and rodeo cowboy Jack Twist, two young men who meet and fall in love on the fictional Brokeback Mountain in Wyoming in 1963. Wuorinen says \"It's a story of doomed love, in this case a complex homosexual relationship taking place in a very homophobic society\")"}, "madsrdf:citationSource": "Charles Wuorinen website, Jan. 5, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Brokeback Mountain; Charles Wuorinen ... began to adapt the story, about closeted love in the rural American West, into an opera; The operatic \"Brokeback\" is one of several recent operas on gay themes, from \"Oscar\"--Wilde, that is--at the Santa Fe Opera to \"Champion,\" based on the life of the gay boxer Emile Griffith, at the Opera Theater of St. Louis, and \"Two Boys,\" which had its American premiere at the Metropolitan Opera this fall)"}, "madsrdf:citationSource": "Woolfe, Z. Love that dare not sing its name, in New York times online, Jan. 24, 2014, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (opera in two acts; original story and libretto by Annie Proulx ; music by Charles Wuorinen) (OCoLC)876906458"}, "madsrdf:citationSource": "Work cat.: Wuorinen, Charles. Brokeback Mountain, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Homosexual operas"}}, {"@id": "_:n9c205fd6940e4fa28441e8e32b7dd66fb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Homosexual operas"}}], "@id": "/authorities/genreForms/gf2023026005"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026006", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTransgender operas", "identifiers:lccn": "gf2023026006", "madsrdf:adminMetadata": [{"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb1"}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Transgender operas"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026976"}, "madsrdf:hasSource": [{"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb5"}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb6"}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb7"}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb8"}], "madsrdf:hasVariant": {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb9"}, "madsrdf:historyNote": "[Established May 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Operas featuring transgender characters or addressing transgender themes."}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ic"}, "ri:recordStatus": "revised"}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transgender operas"}}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(America's first transgender opera, As One)"}, "madsrdf:citationSource": "Mack, D. Inside the arts: America's first transgender opera, via WWNO, New Orleans Public Radio website, June 1, 2017, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a transgender opera) t.p. (chamber opera for two singers and string quartet) (OCoLC)929633305"}, "madsrdf:citationSource": "Work cat.: Kaminsky, Laura. As one, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(America's first transgender opera; \"As One\" will premiere this weekend at the Marigny Opera House under the sponsorship of the New Orleans Opera Association; Baritone Luis Orozco and mezzo-soprano Brenda Patterson will musically portray the role of \"Hannah\" as she transitions to living as a woman)"}, "madsrdf:citationSource": "Shapiro, D.M. Worlds collide in opera about the transgender experience, via NOLA.com website, May 30, 2017, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(As One. This is considered the first transgender opera, composed by Laura Kaminsky and written by Mark Campbell and Kimberly Reed. The work was commissioned by American Opera Projects and follows the story of Hannah as she goes through her transformation. The opera is a series of 16 vignettes divided into Hannah Before and Hannah After and is written for a string quartet)"}, "madsrdf:citationSource": "Salazar, F. Pride Month 2017 : a look at the LGBT operas in history, via OperaWire website, posted June 1, 2017, viewed on Jan. 5, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trans operas"}}, {"@id": "_:nc4b73d16bd0f4407b24564b5572151ccb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trans operas"}}], "@id": "/authorities/genreForms/gf2023026006"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026007", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aZemirot", "identifiers:lccn": "gf2023026007", "madsrdf:adminMetadata": [{"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b1"}, {"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Zemirot"}, "madsrdf:elementList": {"@list": [{"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026872"}, "madsrdf:hasSource": [{"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b5"}, {"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b6"}], "madsrdf:hasVariant": {"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b7"}, "madsrdf:historyNote": "[Established May 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-05-02T14:59:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zemirot"}}, {"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. Zemirot (DLC)2022397924"}, "madsrdf:citationSource": "Work cat: Zemirot Kol bo ha-mevo\u02bcar :", "madsrdf:citationStatus": "found"}, {"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "vol. 16, page 987 (Zemirot: 1. term applied to Sephardi, Italian, and eastern communities to the biblical verses, psalms, and doxologies recited before the main part of the morning service. 2. In Ashkenazi usage, the table hymns sung during or directly after Sabbath meals.)"}, "madsrdf:citationSource": "Encyclopedia Judaica, 1972 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Table hymns"}}, {"@id": "_:n32ac5dec92bf4494a5d08ccf112b08f1b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Table hymns"}}], "@id": "/authorities/genreForms/gf2023026007"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026009", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLesbian operas", "identifiers:lccn": "gf2023026009", "madsrdf:adminMetadata": [{"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db1"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Lesbian operas"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026976"}, "madsrdf:hasSource": [{"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db5"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db6"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db7"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db8"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db9"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db10"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db11"}], "madsrdf:hasVariant": [{"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db12"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db15"}], "madsrdf:historyNote": "[Established July 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Operas featuring lesbian characters or addressing lesbian themes."}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ic"}, "ri:recordStatus": "revised"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lesbian operas"}}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lulu. Composed in 1935, \"Lulu\" is recognized for its challenging subject matter and its complex characters. It is also recognized for having one of the first openly lesbian characters in opera; Patience and Sarah. The opera is seen as the first mainstream gay-themed opera. Composed by\u00a0Paula M. Kimper and written by librettist Wende Persons, the opera is based on the novel of the same name by Isabel Miller. Not only was the opera the first mainstream LGBT work, but it was the first opera to feature a lesbian love story; Sweets by Kate. Considered the second opera with lesbian lovers ever written)"}, "madsrdf:citationSource": "Salazar, F. Pride Month 2017 : a look at the LGBT operas In history, via OperaWire website, Jan. 6, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Patience and Sarah\u00a0(1998); a lesbian love story; 27\u00a0(2014); opera about Gertrude Stein; the love story between Gertrude and Alice is the glue in this opera)"}, "madsrdf:citationSource": "Raskauskas, S. Playlist : 7 American operas that put LGBTQ issues center stage, via WFMT website, Jan. 6, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(score of the first American lesbian opera) (OCoLC)944432486"}, "madsrdf:citationSource": "Kimper, Paula M. Patience & Sarah : a pioneering love story, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(sound recording of a lesbian opera) (OCoLC)815762066"}, "madsrdf:citationSource": "Work cat.: Berg, Alban. Lulu, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(1901 - Astart\u00e9 (Opera); Astart\u00e9 is thought to be the first opera in which lesbian love is represented; 1935 - Lulu (Opera); 1998 - Patience and Sarah (Opera); Patience and Sarah is the first American lesbian opera and was based on the novel Patience and Sarah by Isabel Miller)"}, "madsrdf:citationSource": "Lesbian plays and Sapphic operas, via Girl Friends of Dorothy website, Jan. 6, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(No overtly gay character shows up in opera until the lesbian Countess Geschwitz in Berg's rivetingly dramatic Lulu (1937); Based on the historical novel by Alma Routsong, Paula M. Kimper's opera Patience and Sarah (1998) gave opera its first strong lesbian relationship; It took more than 15 years for opera to present another positive, life-enhancing lesbian couple: in this case the opera was Ricky Ian Gordon's 27, an enchanting look at another real-life pair, the Paris-based American writer Gertrude Stein and her devoted companion, Alice B. Toklas)"}, "madsrdf:citationSource": "A long journey : celebrating LGBTQIA+ characters in opera, via Lyric Opera of Chicago website, Jan. 6, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(operas on gay themes have proliferated. Since 2010, the crop of gay-oriented works has included ... Ricky Ian Gordon's \"27,\" portraying the partnership of Gertrude Stein and Alice B. Toklas; In the nineteen-nineties, American Opera Projects commissioned Paula Kimper to compose \"Patience & Sarah,\" a lesbian romance; The first gay character in opera is usually said to be the Countess Geschwitz, who appears in Alban Berg's all-eclipsing masterpiece \"Lulu,\" unfinished at the time of the composer's death, in 1935. Geschwitz not only declares her love for the title character but is given the final words: \"Lulu! My angel! . . . I will stay near you! Into eternity!\")"}, "madsrdf:citationSource": "Ross, A. The decline of opera queens and the rise of gay opera, via The New Yorker website, July 27, 2017, viewed on Jan. 6, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sapphic operas"}}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sapphic operas"}}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Homosexual operas"}}, {"@id": "_:nfc9547d7dd6d4cf0bc7f2f0a5444df0db16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Homosexual operas"}}], "@id": "/authorities/genreForms/gf2023026009"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026010", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCronicas", "identifiers:lccn": "gf2023026010", "madsrdf:adminMetadata": [{"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb1"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cronicas"}, "madsrdf:elementList": {"@list": [{"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026074"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026537"}], "madsrdf:hasSource": [{"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb5"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb6"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb7"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb8"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb9"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb10"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb11"}], "madsrdf:historyNote": "[Established July 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short prose pieces usually first published in a serial, always referring to some current event, and usually including fictional or other literary elements."}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/mh"}, "ri:recordStatus": "new"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T14:52:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cronicas"}}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "tomo 1, page 398 (cr\u00f3nica, second definition, journalistic articles on a current theme)"}, "madsrdf:citationSource": "Diccionario de la lengua espa\u00f1ola (Real Academia Espa\u00f1ola). Diccionario de la lengua espa\u00f1ola, 1984. 20a ed:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "volume 48 (Once considered a minor craft akin to gossip columns and other lesser forms of journalism, the cr\u00f4nica is now regarded as a truly Brazilian literary genre. Proof of the recognition accorded are recent editions of collected cr\u00f4nicas by eminent authors. Although a cr\u00f4nica is easily recognizable, the definition of its precise characteristics is not easy. Some cr\u00f4nicas, for example, constitute such perfect narrations that they become virtually indistinguishable from short stories.Other authors have such a defined approach and focused point of view that their cr\u00f4nicas could be regarded as disquisitions in politics, history, or sociology. Notwithstanding the genre's several manifestations, the essense of any good cr\u00f4nica remains its ability to capture a moment in all its complexity and to convey it in language that is simultaneously literary and colloquial.)"}, "madsrdf:citationSource": "Handbook of Latin American studies, viewed online January 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 155 (Cr\u00f3nicas are identified on the journalistic side by a temporal dimension, and on the literary side, they bring resources such as fictionalization, analogy and symbolism.) page 203 (Modern cr\u00f3nicas are directly related to the \"new journalism\" and nonfiction literature.)"}, "madsrdf:citationSource": "Rotker, Susana, 1954- La invenci\u00f3n de la cr\u00f3nica, 1992:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 17, no. 1, pages 130-137 (The cr\u00f3nica, in Latin American, or cr\u00f4nica, in Brazil, is a genre popular in Latin America. The term refers to the hybrid writing form born in the 19th century newspaper that mixes journalism with different genres and literary techniques. The medium of the newspaper required artists to reflect on everyday concerns.The lines between fact and fiction are intentionally blurred. A chief characteristic of the genre is contemporaneity. Although it is a crossroads of different techniques and styles, it looks for meaning in the fragments rather than attempting to construct a whole. This genre is not the same as the English chronicles.)"}, "madsrdf:citationSource": "Lucero (Berkeley, Calif.) Lucero, 2006, viewed online January 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "page 214 (Cr\u00f4nicas is always based on some aspect of the present, which can be an event of general interest, or some private event. This means that the past, a prerequisite of the older \"chronicle,\" is by definition not a modern cr\u00f4nica. Cr\u00f4nicas may include some personal memories, but the reminiscences are triggered by a current event.)"}, "madsrdf:citationSource": "Cr\u00f4nicas brasileiras, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a collection of texts on the Covid-19 pandemic from the year that it began) (OCoLC)1235574303"}, "madsrdf:citationSource": "Work cat: Rup\u00e9rez, Javier. Las cr\u00f3nicas de la pandemia, 2020:", "madsrdf:citationStatus": "found"}, {"@id": "_:n7e7f5295e43849f4b7202c16e39b492fb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "edi\u00e7\u00e3o 05 - 1 semestre (a study on the etymology of cronicas; although before the 1800s the genre was equivalent to chronicles in that they were a chronological listing of details, by the 19th century Brazilian cronicas were a new genre consisting of articles with a narrative sort of aesthetic.)"}, "madsrdf:citationSource": "Revista PJ:Br jornalismo brasileiro, 2005, viewed online January 10, 2023", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2023026010"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026011", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDrag television programs", "identifiers:lccn": "gf2023026011", "madsrdf:adminMetadata": [{"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b1"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Drag television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasSource": [{"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b5"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b6"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b7"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b8"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b9"}], "madsrdf:hasVariant": [{"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b10"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b13"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b16"}], "madsrdf:historyNote": "[Established July 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs featuring drag performers and drag performances."}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2024-02-22T14:17:35"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drag television programs"}}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(RuPaul's Drag Race is an American reality competition television series; documents RuPaul in the search for \"America's next drag superstar\"; inspired the spin-off shows RuPaul's Drag U, RuPaul's Drag Race All Stars, and RuPaul's Secret Celebrity Drag Race; the companion series RuPaul's Drag Race: Untucked; and numerous international franchises including British and Australian and New Zealand versions hosted by RuPaul as well as Chilean, Thai, Canadian, Dutch, Spanish, Italian, French, and Philippine editions, upcoming Belgian, Swedish, Mexican, German, and Brazilian installments, and international vs. the World competitions hosted in The United Kingdom and Canada)"}, "madsrdf:citationSource": "Wikipedia, Jan. 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(reality drag competition show) (OCoLC)958088551"}, "madsrdf:citationSource": "Work cat.: RuPaul's drag race. Season 8, 2016.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Drag Den premiered on 8 December; distinguishes itself as the first drag competition conceptualized and produced by Filipinos; the first Filipino-produced drag series; takes major inspiration from the pioneering drag television series RuPaul's Drag Race)"}, "madsrdf:citationSource": "Manipon, Roel Hoang. Drag television, Pinoy style, via Daily tribune (Philippines) website, posted Dec. 26, 2022, viewed on Jan. 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Drag queen TV shows have never been more popular than they are right now. These shows allow viewers to experience the love and laughter that drag queens bring to the\u00a0LGBTQ+ community; Drag shows like\u00a0RuPaul's Drag Race, Dragula, and Hey Qween have become a staple on mainstream media; popularity of these shows has led to a plethora of new TV series featuring drag queens in lead roles; HBO's docuseries We're Here, which\u00a0celebrates queerness while thriving in the face of adversity; follows Shangela, Eureka O'Hara, and Bob the Drag Queen as they traverse small towns across America to tell LGBTQ+ stories in conservative spaces; talk show Hey Qween, hosted by Johnny McGovern and sidekick Lady Red Couture, delves into the lives of celebrity guests and stars of the LGBTQ+ community; Queen of the Universe, drag-based singing competition series)"}, "madsrdf:citationSource": "7 drag TV shows you must watch in 2022, via Homoculture website, published Jan. 4, 2022, viewed on Jan. 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(lists 77 TV shows as result of keyword search on \"drag queen\", including: RuPaul's Drag Race; AJ and the Queen: While traveling across the country in a run-down RV, drag queen Ruby Red discovers an unlikely sidekick in AJ, a tough-talking 10-year-old stowaway; Painted with Raven: make-up competition show; Queen: After a decades-long absence, a renowned Parisian tailor and drag queen returns to his hometown in Poland to make amends with his daughter; Super Drags: In this adult animated series, three gay co-workers lead double lives as drag queen superheroes, saving the LGBTQ community from evil nemeses; Queen of the Universe: Eurovision-like singing competition featuring drag queens from around the world; The X Change Rate: drag queen Mon\u00e9t X Change hosts a weekly variety talk show; Sketchy Queens: sketch comedy series created by two-time RuPaul's Drag Race winner Jinkx Monsoon and her comedy partner Liam Krug; Served! With Jade Thirlwall: features the singer competing with celebrity drag queens to cook a themed dinner from a package of mystery ingredients; Jenifer Lewis and Shangela: a scripted series, follows the comic adventures of Ms. Lewis and D.J. Pierce (aka Shangela) as the show biz mega-diva mentors the up-and-coming drag performer, who lives in the basement apartment of her Hollywood mansion)"}, "madsrdf:citationSource": "TMDB website, Jan. 10, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Drag queen television programs"}}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drag queen television programs"}}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Drag performer television programs"}}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drag performer television programs"}}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Drag shows (Television programs)"}}, {"@id": "_:n2683f52ed70046c79e4d0c3f80c44d78b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drag shows (Television programs)"}}], "@id": "/authorities/genreForms/gf2023026011"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026013", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSurvival fiction", "identifiers:lccn": "gf2023026013", "madsrdf:adminMetadata": [{"@id": "_:n57827555490545ae96234e20f25a0cfab1"}, {"@id": "_:n57827555490545ae96234e20f25a0cfab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Survival fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n57827555490545ae96234e20f25a0cfab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026226"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026514"}], "madsrdf:hasSource": [{"@id": "_:n57827555490545ae96234e20f25a0cfab5"}, {"@id": "_:n57827555490545ae96234e20f25a0cfab6"}], "madsrdf:historyNote": "[Established August 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features individuals or groups struggling for their lives in a harsh setting."}, {"@id": "_:n57827555490545ae96234e20f25a0cfab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n57827555490545ae96234e20f25a0cfab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-08-11T12:18:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n57827555490545ae96234e20f25a0cfab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Survival fiction"}}, {"@id": "_:n57827555490545ae96234e20f25a0cfab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Books in the survival fiction genre are made up of stories where the main character or characters are trying to survive with little or nothing, often when society collapses, crumples, or fails them. Some stories in this genre are about people who have gotten lost or hurt in a natural environment and have to survive on their own until rescued. The main theme in the survival genre is the knowledge and how-to to make do with what one has in a limited environment and keep themselves and/or others alive. Some examples of this genre are: Hatchet by Gary Paulsen; Patriots by James Wesley Rawles; Island of the Blue Dolphins by Scott O'Dell; Life As We Knew It by Susan Beth Pfeffer; The Sign of the Beaver by Elizabeth George Speare; The Swiss Family Robinson by Johann David Wyss; Going Home by A. American; etc.)"}, "madsrdf:citationSource": [{"@id": "https://book-genres.com/survival-fiction-genre/"}, "The book genre dictionary website, viewed Jan. 13, 2023"], "madsrdf:citationStatus": "found"}, {"@id": "_:n57827555490545ae96234e20f25a0cfab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "CIP data view (A story of survival in the wilds of Alaska) (DLC)2023000964"}, "madsrdf:citationSource": "Work cat: The beautiful and the wild, 2023:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2023026013"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2023026014", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWord puzzles and games", "identifiers:lccn": "gf2023026014", "madsrdf:adminMetadata": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb1"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Word puzzles and games"}, "madsrdf:elementList": {"@list": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026158"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026040"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026043"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026075"}], "madsrdf:hasSource": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb5"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb6"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb7"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb8"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb9"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb10"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb11"}], "madsrdf:hasVariant": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb12"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb15"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb18"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb21"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb24"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb27"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb30"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb33"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb36"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb39"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb42"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb45"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb48"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb51"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb54"}], "madsrdf:historyNote": "[Established July 2023.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-01-18T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-07-07T14:52:26"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Word puzzles and games"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles include: Fun word games; 101 word games for students of English as a second or foreign language; Spanish word games for dummies; Wacky word games to play with your friends; Classic word puzzles; Mensa word puzzles; Word puzzlers; 101 word puzzlers ; Phonics word building puzzles; The everything travel word search book; Challenging word search puzzles for kids; The complete idiot's guide to word search puzzles; The everything kids' more word searches puzzle and activity book; Word searches for dummies; Vocabulary puzzles; Chambers words for crosswords and wordgames; Hopi crossword, word search, and word scramble puzzles; Learn Belarusian with word scramble puzzles; Super dog word puzzles and word scrambles; 1300+ word scrambles; Rainy day baseball : crossword puzzles, word scrambles, trivia quizzes and more to challenge every fan, come rain or shine )"}, "madsrdf:citationSource": "OCLC, Jan. 18, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(word games. SN Games where words have to be formed with letters. They are played for entertainment, can also be used for educational purposes. Some word games are simply played with pen and paper, others with adapted game material, and some popular television programs consist of word games.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Jan. 18, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Contains 40 word search puzzles, 40 word scramble puzzles, 40 multiple choice vocabulary quizzes, hints and solutions, and a glossary) (OCoLC)967711150"}, "madsrdf:citationSource": "Work cat.: Zidowecki, Erik. Spanish pocket puzzles. The basics, Volume 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(word game: (American English) any game or contest involving skill in using, forming, guessing, or changing words or expressions, such as anagrams or Scrabble; (British English) or wordgame: any game involving the formation, discovery, or alteration of a word or words)"}, "madsrdf:citationSource": "Collins English dictionary online, Jan. 18, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Word games. UF Word puzzles. BT Games; Literary recreations. RT Crossword puzzles. SN Here are entered works on games in which players compete in forming, thinking of, or guessing words according to a set of rules. Works on the act or instance of playing upon words or speech sounds, especially to achieve a humorous or rhetorical effect, are entered under Plays on words.)"}, "madsrdf:citationSource": "LCSH, Jan. 18, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Word game (Word games (also called word game puzzles or word search games) are spoken, board, or video games often designed to test ability with language or to explore its properties; Categories of word game: Letter arrangement games: goal is to form words out of given letters; for example: Scrabble, Upwords, Bananagrams; Paper and pencil games: players write their own words, often under specific constraint; for example: crossword, hangman, categories, Boggle, and word searches; Semantic games: focus on the semantics of words, utilising their meanings and the shared knowledge of players as a mechanic; for example: Mad Libs, Blankety Blank, and Codenames)"}, "madsrdf:citationSource": "Wikipedia, Jan. 18, 2023:", "madsrdf:citationStatus": "found"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(word game: a game in which players compete in forming, thinking of, or guessing words according to a set of rules)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Jan. 18, 2023", "madsrdf:citationStatus": "found"}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scramble puzzles, Word"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scramble puzzles, Word"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Word puzzlers"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Word puzzlers"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scrambles, Word"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scrambles, Word"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Word puzzles"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Word puzzles"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Puzzlers, Word"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puzzlers, Word"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Word scramble puzzles"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Word scramble puzzles"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Word building puzzles"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Word building puzzles"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Word games"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Word games"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Vocabulary puzzles"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vocabulary puzzles"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Word search puzzles"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Word search puzzles"}}, {"@id": "_:nde7a812b4bd24ae6995f1a669456eacbb42", "@type": ["madsrdf:GenreForm", "madsr