{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026538", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRock concert films", "identifiers:lccn": "gf2011026538", "madsrdf:adminMetadata": [{"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b1"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Rock concert films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026161"}, "madsrdf:hasSource": [{"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b5"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b6"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b7"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b8"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b9"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b10"}], "madsrdf:hasVariant": [{"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b11"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b14"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b17"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b20"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007006486"}}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:08:38"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock concert films"}}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A documentary film of the Rolling Stones on tour in 1969, focusing on the concert at the Altamont Speedway in California)"}, "madsrdf:citationSource": "Gimme shelter [VR] 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Woodstock [VR] c1997.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "concert film (A film that records a live musical performance before a public audience. In commercial cinema, the form has largely been relegated to such rock documentaries as Michael Wadleigh's Woodstock (1970) ... and Jonathan Demme's Stop Making Sense (1984), a purer record of a concert by the Talking Heads; rock documentary: A type of concert film that presents a performance of rock music, frequently employing filmic technique to create for the audience the experience of attending such a performance while also seeming to make some kind of social statement about the music and the culture which produces it)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dict., 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "subgenre listed under Musical Rock Concert Films (Concert Film, Rock-Concert Documentary, Rock Doc. They fall under the category of documentaries and are a permanent record of the actual performance or happening in which folk or rock music is played to its audience, either in the open air or in enclosed locales. See also Rock Film)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The Band, one of rock's superstar groups, decided to call it quits after sixteen grueling years on the road. The group held this farewell concert on Thanksgiving Day, 1976, at San Francisco's Winterland, the site of their first performance.)"}, "madsrdf:citationSource": "The last waltz [VR] 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(film of the Talking Heads in concert)"}, "madsrdf:citationSource": "Work cat.: Talking Heads (Musical group). Stop making sense [VR] 1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock documentary films"}}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock documentary films"}}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock documentaries"}}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock documentaries"}}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock concert documentaries"}}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock concert documentaries"}}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock docs (Motion pictures)"}}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock docs (Motion pictures)"}}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rock concert documentary films"}}, {"@id": "_:nf159d71c5ac3435e842a0fc7b4477779b24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rock concert documentary films"}}], "@id": "/authorities/genreForms/gf2011026538"}
