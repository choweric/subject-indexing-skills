ordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stand-up comedy routines"}}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed stand-up comedy routines"}}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed stand-up comedy routines"}}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised stand-up comedy routines"}}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised stand-up comedy routines"}}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "back cover (\"The book opens a long-neglected area of American folklore, presenting dozens of fondly-remembered routines like 'Who's On First' and 'Niagara Falls (Slowly I Turned),' as well as long-forgotten classics in print for the first time.\")"}, "madsrdf:citationSource": "Baggy pants comedy, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Stand-up comedy is a comedic style. Usually, a comedian performs in front of a live audience, speaking directly to them. The performer is commonly known as a comic, stand-up comic, stand-up comedian or simply a stand-up. In stand-up comedy the comedian usually recites a fast-paced succession of humorous stories, short jokes called \"bits\", and one-liners, which constitute what is typically called a monologue, routine or act. Some stand-up comedians use props, music or magic tricks to enhance their acts. Stand-up comedy is often performed in comedy clubs, bars, neo-burlesques, colleges and theaters. Outside of live performance, stand-up is often distributed commercially via television, DVD, and the internet.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 17, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Filmed stand-up comedy routines; Televised stand-up comedy routines)"}, "madsrdf:citationSource": "LCGFT", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Stand-up comedy. BT Comedy; Joking)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed stand-up comedy routines"}}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed stand-up comedy routines"}}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Televised stand-up comedy routines"}}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Televised stand-up comedy routines"}}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comedy routines, Stand-up"}}, {"@id": "_:nf8bf85ee7a0f466cba5acc55f1d3fc83b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedy routines, Stand-up"}}], "@id": "/authorities/genreForms/gf2014026180"}
