"@value": "2015-12-23T16:21:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film noir"}}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Film noir; BT: Crime films and programs)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials : genre terms, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 59 (combines crime and suspense)"}, "madsrdf:citationSource": "Armour, R.A. Film, 1980:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dark suspenseful thriller; blackness of physique, depiction of corruption and crime)"}, "madsrdf:citationSource": "Oxford companion to film, 1976", "madsrdf:citationStatus": "found"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 74 (Cin\u00e9ma- (or Film-) Noir)"}, "madsrdf:citationSource": "Geduld, H.M. An ill. glossary of film terms, c1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(film noir. Dark crime movie, most typically made in the 1940s and 1950s. Often shot in black in white, film noir typically used nighttime and shadowy cinematography, sleazy locations and mean, distrustful characters; film noirs)"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dict., c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 1 (not a genre ... defined by tone and mood)"}, "madsrdf:citationSource": "Selby, S. Dark city, 1984:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(film noir. 1. A movie characterized by low-key lighting, a bleak urban setting, and corrupt, cynical characters. 2. The genre or style of such movies)"}, "madsrdf:citationSource": "American heritage dict. of the Eng. lang., via WWW, Mar. 18, 2001", "madsrdf:citationStatus": "found"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(film noir; noir films)"}, "madsrdf:citationSource": "Film noir, 1979", "madsrdf:citationStatus": "found"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3;Random House", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(deal almost exclusively with violence and crime)"}, "madsrdf:citationSource": "Oakey, V. Dict. of films & TV terms, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Film noir; related terms: Caper, Crime, Gangster, Mystery, Police, and Thriller)"}, "madsrdf:citationSource": "Moving image genre-form guide online, February 11, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cin\u00e9ma noir"}}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cin\u00e9ma noir"}}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dark crime films"}}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dark crime films"}}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Films noirs"}}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Films noirs"}}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Noir films"}}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Noir films"}}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Film noirs"}}, {"@id": "_:nd544f11779f4466aa6a81af5e1d93e31b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Film noirs"}}], "@id": "/authorities/genreForms/gf2011026257"}
