{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2010025067", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGravity anomaly maps", "identifiers:lccn": "gf2010025067", "madsrdf:adminMetadata": [{"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b1"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gravity anomaly maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b5"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b6"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b7"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b8"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b9"}], "madsrdf:hasVariant": {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-10-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-03-29T08:31:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gravity anomaly maps"}}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(gravity maps are useful in revealing the geology of the sea floor)"}, "madsrdf:citationSource": "Smith, W.H.F. Global seafloor topography from satellite altimetry, via NOAA National Geophysical Data Center website, July 16, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "GRACE gravity map image gallery, via WWW, July 16, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Thompson, G.A. Aeromagnetic and Bouguer gravity map of Twin Sisters dunite, northwestern Washington, 1973.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (a gravity map is made using numerous gravity measurements across the area of interest ... gravity measurements are often processed to a complete-Bouguer or isostatic gravity anomaly. These data are then gridded, so that the randomly spaced data are converted to a representation of the gravity field at equally spaced locations)"}, "madsrdf:citationSource": "Introduction to potential fields: gravity, 1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gravity anomaly maps depict the difference between theoretical computed gravity values and observed gravity values for a region of the earth's crust)"}, "madsrdf:citationSource": "Gravity anomaly maps, via Wisconsin State Cartographer's Office website, July 16, 2010", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gravity maps"}}, {"@id": "_:n5ff0d2bf386f4c269ccc297859605a53b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gravity maps"}}], "@id": "/authorities/genreForms/gf2010025067"}
