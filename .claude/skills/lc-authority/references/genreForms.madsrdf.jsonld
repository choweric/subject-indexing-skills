{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026217", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDystopian films", "identifiers:lccn": "gf2011026217", "madsrdf:adminMetadata": [{"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b1"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dystopian films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b3"}]}, "madsrdf:exampleNote": "Note under [Apocalyptic films]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026556"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b5"}, "madsrdf:hasSource": [{"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b8"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b9"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b10"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b11"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b12"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b13"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b14"}], "madsrdf:hasVariant": [{"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b15"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b18"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b21"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b24"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films set in an uncertain future, in a society ruled by an ineffectual, corrupt, or oppressive regime or by aliens, robots, etc. For films set in a world or civilization after a catastrophic event (e.g., nuclear war, an alien invasion), sometimes also including the period immediately preceding the event see [Apocalyptic films.]", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026447"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025519"}]}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T09:46:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopian films"}}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Planet of the Apes films"}}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Planet of the Apes films"}}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dystopian films)"}, "madsrdf:citationSource": "Noblejas, J.J.G. Personal identity and dystopian film worlds, 2004, via WWW, Apr. 16, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 269 (under Science fiction film: Dystopian films. Future perfect societies (utopias) are highly improbable, and there are only a few examples of filmed utopias. It is more common among writers and filmmakers to portray the reverse of a utopia, a future world gone wrong, that is, a dystopia. These future societies are nightmare worlds where the inhabitants have been deprived of their freedom, individuality and even their self-esteem.)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dystopian films. A typical dystopian film is one which is set, usually in the future, in a society where the government is corrupt or ineffectual, but by no means all such films are dystopias. The world within the film often has nightmare-like qualities, though it also usually includes elements of contemporary society. Often, dystopian films function as a warning against some element of modern society.)"}, "madsrdf:citationSource": "Wikipedia, Apr. 16, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 118 (Dystopianism; the majority of dystopian films are set in an uncertain future, under a repressive regime presented in nightmarish images; films set in a dystopian society fall into categories: rule by an authoritarian elitist government; human societies ruled by aliens from another planet; societies ruled by a special group of powerful people--arch-villains, financiers and so on; post-apocalyptic societies trying to survive after, e.g., a nuclear war; or society controlled by machines, robots, etc.)"}, "madsrdf:citationSource": "Bergan, R. Film isms--, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Apocalyptic and post-apocalyptic fiction (There is a considerable degree of blurring between this form of science fiction and that which deals with false utopias or dystopic societies.)"}, "madsrdf:citationSource": "Wikipedia, Dec. 2, 2010:", "madsrdf:citationStatus": "found"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dystopian films; dystopian movies; dystopian science fiction films; dystopian science fiction movies; dystopic films; dystopic science fiction movies)"}, "madsrdf:citationSource": "Google search, June 13, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dystopian films)"}, "madsrdf:citationSource": "Apocalypse how? Reel pop's guide to the top ten dystopia films, via WWW, Apr. 16, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dystopia films"}}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopia films"}}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Dystopic films"}}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dystopic films"}}, {"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n174e87f1c1974d14ad64eae9e66d6304b22"}]}, "madsrdf:variantLabel": {"@language": "