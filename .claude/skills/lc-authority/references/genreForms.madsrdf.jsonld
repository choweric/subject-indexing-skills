2023-03-08T09:05:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb22a0990ed6b497587ff0cad9c7d4c3cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Title abbreviations"}}, {"@id": "_:nb22a0990ed6b497587ff0cad9c7d4c3cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)68225081"}, "madsrdf:citationSource": "Work cat.: Leistner, Otto. ITA : internationale Titelabk\u00fcrzungen von Zeitschriften, Zeitungen, wichtigen Handb\u00fcchern, W\u00f6rterb\u00fcchern, Gesetzen, Institutionen usw. = international title abbreviations of periodicals, newspapers, important handbooks, dictionaries, laws, institutions, etc., 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:nb22a0990ed6b497587ff0cad9c7d4c3cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(free-floating form subdivison --Abbreviations of title. Use as a form subdivision under types of periodicals for works containing lists of abbreviations of titles of those periodicals; free-floating form subdivision --Periodicals--Abbreviations of titles. Use this subdivision combination as a form subdivision under subjects for works containing lists of abbreviations of titles of periodicals on those subjects)"}, "madsrdf:citationSource": "LCSH, Oct. 13, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:nb22a0990ed6b497587ff0cad9c7d4c3cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (International glossary of abbreviations for theology and related subjects) p. xiv (This glossary of abbreviations is intended as a contribution towards the standardization of title abbreviations. It contains suggestions for standard abbreviations of periodicals, serials, dictionaries and source works for approximately 18,300 titles)"}, "madsrdf:citationSource": "Schwertner, Siegfried M. IATG\u0