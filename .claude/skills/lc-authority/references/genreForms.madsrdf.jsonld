ations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:16:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Teen television programs"}}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "DeGrassi television programs"}}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "DeGrassi television programs"}}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 97 (Teen films and programs: use for fictional genre films and programs produced primarily for a teenaged audience)"}, "madsrdf:citationSource": "Yee, Martha M. Moving image materials : genre terms, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Teen drama: a television drama series that centers on teenage characters. The genre is relatively new, first appearing in the late 1980s. The shows are usually serial, starting when the characters are well into their teenage years (usually between 14 to 18 years of age) and if they have a long run, end when the characters are in their twenties. They typically deal with teen issues such as relationships, coming out, teenage pregnancy, teenage suicide, abortion, bereavement, child abuse, homelessness, male rape/date rape, alcohol addiction and drug abuse)"}, "madsrdf:citationSource": "Wikipedia website, Aug. 9, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Youth: Fictional work portraying aspects of the trajectory through adolescence, including high school years, peer pressure, first love, beach parties, and initial attempts at adulthood, along with strains in the relationship with family. Teenage years are usually emphasized, although younger characters may also be included in a mix of ages, or the work may cover the transition from pre-teen to teenager, depicting a coming-of-age. A frequent emphasis is on a school setting including these ages. Used for: Coming-of-age)"}, "madsrdf:citationSource": "Moving image genre/form guide via WWW, Oct. 10, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Teen drama (Television programs)"}}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Teen drama (Television programs)"}}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Teenage television programs"}}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Teenage television programs"}}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "DeGrassi television programs"}}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "DeGrassi television programs"}}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Youth television programs"}}, {"@id": "_:n3c5a72cbd65f4c869199ed2135a6cbc5b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Youth television programs"}}], "@id": "/authorities/genreForms/gf2011026633"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026634", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTelescoped radio airchecks", "identifiers:lccn": "gf2011026634", "madsrdf:adminMetadata": [{"@id": "_:nca13f88cec374aa8815464ed495f2886b1"}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Telescoped radio airchecks"}, "madsrdf:elementList": {"@list": [{"@id": "_:nca13f88cec374aa8815464ed495f2886b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026485"}, "madsrdf:hasSource": [{"@id": "_:nca13f88cec374aa8815464ed495f2886b5"}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b6"}], "madsrdf:hasVariant": [{"@id": "_:nca13f88cec374aa8815464ed495f2886b7"}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025606"}}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T14:32:33"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telescoped radio airchecks"}}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In the radio industry, an aircheck is generally a demonstration recording, often intended to show off the talent of an announcer or radio programmer to a prospective future employer. A scoped (telescoped) aircheck usually contains only segments where the announcer is actually talking. In an unscoped aircheck, all programming is left intact and unedited, including music, commercials, newscasts, jingles and other on-air events)"}, "madsrdf:citationSource": "Wikipedia, via WWW, Nov. 29, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Telescoped airchecks: SN Radio broadcasts in which most of the music and/or commercials are eliminated leaving the announcer's segments intact. Primarily used by announcers who are sending tapes to prospective employers.)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Nov. 29, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nca13f88cec374aa8815464ed495f2886b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Telescoped airchecks (Radio programs)"}}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Telescoped airchecks (Radio programs)"}}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nca13f88cec374aa8815464ed495f2886b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Scoped radio airchecks"}}, {"@id": "_:nca13f88cec374aa8815464ed495f2886b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Scoped radio airchecks"}}], "@id": "/authorities/genreForms/gf2011026634"}
