alue": "2011-05-05T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne6b61c870c45452ca58ffcfec7cba00ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Children's sound recordings"}}, {"@id": "_:ne6b61c870c45452ca58ffcfec7cba00ab5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Poulenc, F. Babar [SR], 2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6b61c870c45452ca58ffcfec7cba00ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container insert (\"Features some of the folk songs and stories that have given pleasure to so many generations of American children. Unlike most folk music records for children, these selections are not re-creations by urban performers; instead, some of our most skilled traditional musicians have been asked to perform their favorite childhood songs and stories.\")"}, "madsrdf:citationSource": "The land of Yahoe [SR] : children's entertainments from the days before television, p1996:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6b61c870c45452ca58ffcfec7cba00ab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Music for kids. CD 5, Music for dancing [SR], 2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:ne6b61c870c45452ca58ffcfec7cba00ab8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne6b61c870c45452ca58ffcfec7cba00ab9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Juvenile sound recordings"}}, {"@id": "_:ne6b61c870c45452ca58ffcfec7cba00ab9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Juvenile sound recordings"}}, {"@id": "_:ne6b61c870c45452ca58ffcfec7cba00ab11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne6b61c870c45452ca58ffcfec7cba00ab12"}]}, "madsrdf:variantLabel