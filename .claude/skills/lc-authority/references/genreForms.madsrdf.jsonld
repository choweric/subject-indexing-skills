"madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thematic catalogs (Music)"}}, {"@id": "_:n5ea5a2a71f674c69807000ed1beefdb1b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(list of thematic indexes currently being used in the creation of authorized and variant access points in the Library of Congress/NACO Authority File; thematic catalogues)"}, "madsrdf:citationSource": "Thematic indexes used in the Library of Congress/NACO authority file, via WWW, Jan. 13, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ea5a2a71f674c69807000ed1beefdb1b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Thematic catalogue; an index to a group of musical compositions that incorporates citations of their opening notes (incipits), or principal melodic features (themes), or both)"}, "madsrdf:citationSource": "Grove music online, viewed April 2, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n5ea5a2a71f674c69807000ed1beefdb1b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ea5a2a71f674c69807000ed1beefdb1b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Thematic indexes (Music)"}}, {"@id": "_:n5ea5a2a71f674c69807000ed1beefdb1b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thematic indexes (Music)"}}, {"@id": "_:n5ea5a2a71f674c69807000ed1beefdb1b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5ea5a2a71f674c69807000ed1beefdb1b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Musical themes dictionaries"}}, {"@id": "_:n5ea5a2a71f674c69807000ed1beefdb1b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Musical themes dictionaries"}}], "@id": "/authorities/genreForms/gf2014027136"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027137", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aThird stream (Music)", "identifiers:lccn": "gf2014027137", "madsrdf:adminMetadata": [{"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b1"}, {"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Third stream (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026879"}], "madsrdf:hasSource": [{"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b5"}, {"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b6"}, {"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b7"}, {"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Third stream (Music)"}}, {"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Third stream journal, fall/winter 1994/95.", "madsrdf:citationStatus": "found"}, {"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Third stream: term coined in 1950s by Gunther Schuller to describe mus. in which styles of both jazz and concert works are combined)"}, "madsrdf:citationSource": "Oxf. dict. of music, 1994", "madsrdf:citationStatus": "found"}, {"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "notfound"}, {"@id": "_:ndac069aacb0b4d209233c240a1e5e3c6b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Third stream: ...a type of music which, through improvisation or written composition or both, synthesizes the essential characteristics and techniques of contemporary Western art music and other musical traditions...The term was originally applied to a style in which attempts were made to fuse basic elements of jazz and Western art music--the two mainstreams joining to form a 'third stream'...Since the late 1950s the application of the term has broadened, notably through the work of pianist Ran Blake, to encompass fusions of classical music with elements drawn not only from African-American sources but also from other vernacular traditions, including Turkish, Greek Hindustani, Russian and Cuban music among others)"}, "madsrdf:citationSource": "Grove music online, Sept. 9, 2005", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014027137"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027138", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aThrash metal (Music)", "identifiers:lccn": "gf2014027138", "madsrdf:adminMetadata": [{"@id": "_:n45e73d5911c14856b14074969f7b8b97b1"}, {"@id": "_:n45e73d5911c14856b14074969f7b8b97b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Thrash metal (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n45e73d5911c14856b14074969f7b8b97b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026854"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026097"}, "madsrdf:hasSource": [{"@id": "_:n45e73d5911c14856b14074969f7b8b97b5"}, {"@id": "_:n45e73d5911c14856b14074969f7b8b97b6"}, {"@id": "_:n45e73d5911c14856b14074969f7b8b97b7"}], "madsrdf:hasVariant": {"@id": "_:n45e73d5911c14856b14074969f7b8b97b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n45e73d5911c14856b14074969f7b8b97b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:07:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n45e73d5911c14856b14074969f7b8b97b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n45e73d5911c14856b14074969f7b8b97b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thrash metal (Music)"}}, {"@id": "_:n45e73d5911c14856b14074969f7b8b97b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 378 (the thrash metal style, with its increased speed, growled vocals, heavy distortion, complex song structures and precise ensemble performances, originated in the San Francisco Bay Area early in the decade with groups such as Metallica, Slayer, Testament, Exodus, Megadeath and Possessed)"}, "madsrdf:citationSource": "Cambridge history of Am. Music, 1998:", "madsrdf:citationStatus": "found"}, {"@id": "_:n45e73d5911c14856b14074969f7b8b97b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(thrash metal, speed metal; an influential subgenre of heavy metal, sometimes referred to as speed metal and overlapping with hardcore largely a U.S. phenomenon, thrash developed out of hardcore and punk and became a journalistic convenience for guitar-based, non-mainstream metal, usually played faster and louder)"}, "madsrdf:citationSource": "Shuker, Roy. Pop. mus.: the key concepts, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n45e73d5911c14856b14074969f7b8b97b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Sharpe-Young, Garry. Thrash metal, 2007.", "madsrdf:citationStatus": "found"}, {"@id": "_:n45e73d5911c14856b14074969f7b8b97b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n45e73d5911c14856b14074969f7b8b97b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Speed metal (Music)"}}, {"@id": "_:n45e73d5911c14856b14074969f7b8b97b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Speed metal (Music)"}}], "@id": "/authorities/genreForms/gf2014027138"}
