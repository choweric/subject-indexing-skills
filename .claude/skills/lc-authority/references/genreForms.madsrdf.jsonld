@value": "Book of Mormon plays"}}, {"@id": "_:n46df969370704660bf22ca77e2beac53b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lowman, P. Book of Mormon monologues, c1987.", "madsrdf:citationStatus": "found"}, {"@id": "_:n46df969370704660bf22ca77e2beac53b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Stewart, D. A day, a night & a day : a Book of Mormon drama, c1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:n46df969370704660bf22ca77e2beac53b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n46df969370704660bf22ca77e2beac53b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Book of Mormon drama"}}, {"@id": "_:n46df969370704660bf22ca77e2beac53b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Book of Mormon drama"}}], "@id": "/authorities/genreForms/gf2014026251"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026252", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBook of Mormon stories", "identifiers:lccn": "gf2014026252", "madsrdf:adminMetadata": [{"@id": "_:n4f24b30e991145078c0cbbf699ef1078b1"}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Book of Mormon stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4f24b30e991145078c0cbbf699ef1078b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026415"}, "madsrdf:hasSource": [{"@id": "_:n4f24b30e991145078c0cbbf699ef1078b5"}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b6"}], "madsrdf:hasVariant": [{"@id": "_:n4f24b30e991145078c0cbbf699ef1078b7"}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Paraphrases of Book of Mormon texts in story form."}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T12:52:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Book of Mormon stories"}}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: An illustrated retelling of the stories from the Book of Mormon.)"}, "madsrdf:citationSource": "Newell, K.H. Illustrated Book of Mormon stories, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Book of Mormon stories)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4f24b30e991145078c0cbbf699ef1078b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mormon stories, Book of"}}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mormon stories, Book of"}}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4f24b30e991145078c0cbbf699ef1078b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Stories, Book of Mormon"}}, {"@id": "_:n4f24b30e991145078c0cbbf699ef1078b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Stories, Book of Mormon"}}], "@id": "/authorities/genreForms/gf2014026252"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026253", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBop (Poetry)", "identifiers:lccn": "gf2014026253", "madsrdf:adminMetadata": [{"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb1"}, {"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bop (Poetry)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": {"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb5"}, "madsrdf:hasVariant": {"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems in three stanzas that present, describe, and solve a problem."}, {"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T12:52:58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bop (Poetry)"}}, {"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetic Form: The Bop---A recent invention, the Bop was created by Afaa Michael Weaver during a summer retreat of the African American poetry organization, Cave Canem. Not unlike the Shakespearean sonnet in trajectory, the Bop is a form of poetic argument consisting of three stanzas, each stanza followed by a repeated line, or refrain, and each undertaking a different purpose in the overall argument of the poem. The first stanza (six lines long) states the problem, and the second stanza (eight lines long) explores or expands upon the problem. If there is a resolution to the problem, the third stanza (six lines long) finds it. If a substantive resolution cannot be made, then this final stanza documents the attempt and failure to succeed)"}, "madsrdf:citationSource": "Poets.org, viewed Dec. 26, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "The bop (Poetry)"}}, {"@id": "_:n138aa0513f5f4308bb17bfb833a82bbeb7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "The bop (Poetry)"}}], "@id": "/authorities/genreForms/gf2014026253"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026254", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBurlesques (Literature)", "identifiers:lccn": "gf2014026254", "madsrdf:adminMetadata": [{"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb1"}, {"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Burlesques (Literature)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026470"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026526"}, "madsrdf:hasSource": [{"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb5"}, {"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb6"}, {"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb7"}, {"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Parodies that ridicule serious literary or musical works by either treating their solemn subjects in an undignified style or applying their elevated style to a trivial subject."}, {"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T12:53:18"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Burlesques (Literature)"}}, {"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Burlesques. Use for literary or dramatic travesties characterized by ludicrously extravagant incongruity between a subject and its treatment. BT Humorous works (Gathering term; do not assign))"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Nov. 5, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(burlesque. A type of literature or drama designed to mock a serious work or an entire genre. As a form of parody, burlesque is usually distinguished from satire by its broad comic effects and its willingness to depart from serious criticism of its subject in favor of simple entertainment)"}, "madsrdf:citationSource": "Quinn, E. A dictionary of literary and thematic terms, c1999", "madsrdf:citationStatus": "found"}, {"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(burlesque: In literature, comic imitation of a serious literary or artistic form that relies on an extravagant incongruity between a subject and its treatment. Burlesque is closely related to parody, although burlesque is generally broader and coarser)"}, "madsrdf:citationSource": "Merriam-Webster's encyclopedia of literature, c1995", "madsrdf:citationStatus": "found"}, {"@id": "_:nebabff1d30f640559341a5f7f4ab7acfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(burlesque. A kind of parody that ridicules some serious literary work either by treating its solemn subject in an undignified style (see Travesty), or by applying its elevated style to a trivial subject, as in Pope's mock-epic poem The Rape of the Lock (1712-14))"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026254"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026255", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCalaveras", "identifiers:lccn": "gf2014026255", "madsrdf:adminMetadata": [{"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b1"}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Calaveras"}, "madsrdf:elementList": {"@list": [{"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026460"}], "madsrdf:hasSource": [{"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b5"}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b6"}], "madsrdf:hasVariant": [{"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b7"}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-05-13T18:11:21"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Calaveras"}}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Calavera poems describe a person's death in a funny way. Literally, the term Calaveras refers to the skull of a skeleton but it also a literary form of satirical verse and a graphic art form of caricature. Funny drawings of skeletons were made popular by engraver and illustrator Jose Guadalupe Posada (1852-1913). His most famous drawing was a satirical engraving of La Catrina, a female skeleton dressed in fancy clothes poking fun at the upper class.)"}, "madsrdf:citationSource": "Day of the Dead Portable Children's Program, via Brooklyn Children's Museum website, Dec. 14, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Calaveras. Use for satirical broadside poems, usually in the form of mock epitaphs, illustrated with skeleton caricatures and issued around the Day of the Dead. UF Day of the Dead broadside poems. BT Broadside poems; Satires)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, Aug. 12, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Calavera poetry"}}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Calavera poetry"}}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Day of the Dead broadside poems"}}, {"@id": "_:nae0f48e4b78b480b8e5171fa83a2b449b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Day of the Dead broadside poems"}}], "@id": "/authorities/genreForms/gf2014026255"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026256", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCell phone novels", "identifiers:lccn": "gf2014026256", "madsrdf:adminMetadata": [{"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b1"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cell phone novels"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026020"}, "madsrdf:hasSource": [{"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b5"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b6"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b7"}], "madsrdf:hasVariant": [{"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b8"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b11"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b14"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b17"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Novels meant to be read via text message on mobile phones."}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T12:53:32"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cell phone novels"}}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(cell phone novels: novel containing 200 and 500 pages, with each page containing about 500 Japanese characters; predominantly dialogue; employ clipped one-liners, emoticons, spaces (to show that a character is thinking), all of which can be read easily on a mobile phone interface; scene and character development are lacking; often deal with themes of interest to high school girls and are set in everyday locations.)"}, "madsrdf:citationSource": "Clark, R.C. Cell phone novels, in Young adult library services, winter 2009", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 81 (Cell phone novel: a new genre of literature; cell phones now a source of entertainment, providing novels for readers through the screen variously termed cell phone novel, mobile phone novel, text messaging novel, m-novel, m-lit, cell literature, phone novel, and even as SMS novel; originated in Japan as \"Keitai shousetsu\"; it is a kind of serialized fiction written or uploaded on a cell phone by the author for its readers, generally teenagers; genre began in 2000 by a Japanese writer from Tokyo who posted the short chapters of his novel \"Deep Love\" under the pseudonym \"Yoshi\"; genre now popular in other countries including China, Switzerland, South Korea, Taiwan, USA, South Africa and India)"}, "madsrdf:citationSource": "Language in India, Mar. 2012, via WWW, Dec. 21, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cell phone novels. UF Cellphone novels; Cellular telephone novels)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cellphone novels"}}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cellphone novels"}}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mobile phone novels"}}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mobile phone novels"}}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cellular telephone novels"}}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cellular telephone novels"}}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Text messaging novels"}}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Text messaging novels"}}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "SMS novels"}}, {"@id": "_:ne5f5c4dc0649400e9696b633d97e2047b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "SMS novels"}}], "@id": "/authorities/genreForms/gf2014026256"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026257", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCentos", "identifiers:lccn": "gf2014026257", "madsrdf:adminMetadata": [{"@id": "_:n3dfe60e666d344ad839957c0ebde121fb1"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Centos"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3dfe60e666d344ad839957c0ebde121fb3"}]}, "madsrdf:exampleNote": "Note under [Found poetry]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026049"}], "madsrdf:hasSource": [{"@id": "_:n3dfe60e666d344ad839957c0ebde121fb5"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb6"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb7"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb8"}], "madsrdf:hasVariant": [{"@id": "_:n3dfe60e666d344ad839957c0ebde121fb9"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb12"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb15"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems consisting of passages from poems by one or more other authors. For poems consisting of words or text taken from various sources and reframed as poetry see [Found poetry.]"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-10-04T14:39:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Centos"}}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A patchwork poem is just what its name says it is--something patched together. It is also called a cento, from the Latin for patchwork, and by some, a mosaic poem. It is a verse composed entirely of lines or phrases from the work of other authors. A patchwork poem can be rhymed or unrhymed; it can be assembled with emphasis on lines, or the lines might be chosen because they contain a focused concordance of a specific word)"}, "madsrdf:citationSource": "Delamar, W.T. Werd trix : about patchwork poems & shaped poetics, via WWW, July 15, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(cento poetry)"}, "madsrdf:citationSource": "Kautzer, K. How to write a cento poem : patchwork poetry, c2008, via WWW, Oct. 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cento: A poem made up of passages from poems by one or more authors; a patchwork of quotations; a literary collage; a pastiche (in the sense of being a mixture of poetic excerpts))"}, "madsrdf:citationSource": "Drury, J. The poetry dictionary, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cento: A verse composition made up of lines selected from the work or works of some great poet(s) of the past. Homer largely served the purpose in Gr. lit., ranging from the adaptations by Trygaeus of various lines in the Iliad and Odyssey reported by Aristophanes (Peace 1090-94) to the Homerokentrones of the Byzantine period. Similarly, Virgil was the most popular source for centos in the later Roman times)"}, "madsrdf:citationSource": "The new Princeton encyclopedia of poetry and poetics, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3dfe60e666d344ad839957c0ebde121fb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Collage poetry"}}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Collage poetry"}}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3dfe60e666d344ad839957c0ebde121fb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mosaic poetry"}}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mosaic poetry"}}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3dfe60e666d344ad839957c0ebde121fb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Patchwork poetry"}}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Patchwork poetry"}}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n3dfe60e666d344ad839957c0ebde121fb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cento poetry"}}, {"@id": "_:n3dfe60e666d344ad839957c0ebde121fb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cento poetry"}}], "@id": "/authorities/genreForms/gf2014026257"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026258", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChansons de geste", "identifiers:lccn": "gf2014026258", "madsrdf:adminMetadata": [{"@id": "_:n6717957b05594bd0a555b399c40e8daab1"}, {"@id": "_:n6717957b05594bd0a555b399c40e8daab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Chansons de geste"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6717957b05594bd0a555b399c40e8daab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026310"}, "madsrdf:hasSource": [{"@id": "_:n6717957b05594bd0a555b399c40e8daab5"}, {"@id": "_:n6717957b05594bd0a555b399c40e8daab6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Old French poems that describe the exploits of historical or legendary heroes, most often Charlemagne and his knights."}, {"@id": "_:n6717957b05594bd0a555b399c40e8daab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n6717957b05594bd0a555b399c40e8daab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T12:53:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6717957b05594bd0a555b399c40e8daab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Chansons de geste"}}, {"@id": "_:n6717957b05594bd0a555b399c40e8daab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Chanson de geste: A kind of epic verse that describes the deeds of real and legendary heroes and includes chivalry and love as themes.)"}, "madsrdf:citationSource": "Ruse, C. The Cassell dictionary of literary and language terms, 1992", "madsrdf:citationStatus": "found"}, {"@id": "_:n6717957b05594bd0a555b399c40e8daab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Chanson de geste: French: \"song of deeds.\" An Old French epic form which flourished between the eleventh and fourteenth centuries, describing the deeds of a historical or legendary hero. Many of the stories were concerned with Charlemagne and his knights. Some of the chansons dealt with the battles against the Saracens, while others told of rebellion and disloyalty among Charlemagne's nobles. Later, such romantic elements as giants, fairies, and love affairs between Christian knights and Saracen maidens were introduced. There are about eight examples of the chanson des geste, of which, the best known is La chanson de Roland.)"}, "madsrdf:citationSource": "Beckson, K. Literary terms, 1989", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026258"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026259", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aChoose-your-own stories", "identifiers:lccn": "gf2014026259", "madsrdf:adminMetadata": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b1"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Choose-your-own stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b5"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b6"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b7"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b8"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b9"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b10"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b11"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b12"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b13"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b14"}], "madsrdf:hasVariant": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b15"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b18"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b21"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b24"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b27"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b30"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b33"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b36"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b39"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction in which the reader chooses from a number of possible options for developing the story."}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2020-01-21T12:37:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/nz"}, "ri:recordStatus": "revised"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Choose-your-own stories"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Pick-a-path (Choose your own adventure) stories)"}, "madsrdf:citationSource": "LwDT Support--Secondary website, Oct. 11. 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (Plot-your-own horror stories)"}, "madsrdf:citationSource": "Milton, Space age terrors, 1983:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(List of Genre Headings term: Choose your own stories)"}, "madsrdf:citationSource": "SCIS subject headings, via Google books, Feb. 1, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a gamebook is interactive fiction where the reader makes choices which affect the course of the narrative. Gamebooks first appeared in print form in the late 1970's and remained popular throughout the next decade. The oldest and simplest kind of gamebook is the branching plot novel. This type of book requires the reader to make choices at critical points in the story. The reader's choices affect how the story ends. The best known example was Choose Your Own Adventure; this was one of the first forms of interactive fiction ever published, and for many people this is what they think of when interactive writing is mentioned.)"}, "madsrdf:citationSource": "Combat disk, Ltd. The rise and fall of gamebooks, via WWW, Feb. 1, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(term: Choose your own stories)"}, "madsrdf:citationSource": "ScOT (Schools Online Thesaurus), via WWW, Feb. 1, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Plot-your-own stories. UF Choose-your-own story plots; Making-choices stories; Multiple plot stories)"}, "madsrdf:citationSource": "LCSH, Oct. 22, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 51 (Choose Your Own Adventure books, written for children in the 1970s and 1980s begin with a recitation of setting, conflict, and the reader's role in resolving the conflict) p. 52 (the Choose Your Own Adventure books as a whole are characterized by second-person narration, present-tense address, and multilinear narratives among which a reader chooses a path)"}, "madsrdf:citationSource": "Sloane, S. Digital fictions, 2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "FAQ (Story Willow is a growing repository of choose-your-own-story stories. Most stories here are written in the very rare second-person perspective, present tense (i.e. 'You are holding the gun'). Break that convention carefully.)"}, "madsrdf:citationSource": "Story Willow, via WWW, Feb. 1, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Gamebook; variants: choose your own adventure books; CYOA; branching-plot novels; branching path books; branching path novels)"}, "madsrdf:citationSource": "Wikipedia, Feb. 1, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(How to write a Pick-a-Path story: the basic concept of each book remains the same. The writer creates a setting, usually writes in the second person naming the reader as the main character, creates a problem involving the reader, provides exciting adventures along the way, gives the reader preselected choices (picks) to solve the problem, and guarantees multiple endings )"}, "madsrdf:citationSource": "Hobby Lark website, Oct. 11, 2019", "madsrdf:citationStatus": "found"}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Choose-your-own fiction"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Choose-your-own fiction"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Branching-path books"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Branching-path books"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gamebooks (Choose-your-own stories)"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gamebooks (Choose-your-own stories)"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Choose-your-own adventure books"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Choose-your-own adventure books"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Pick-a-path stories"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Pick-a-path stories"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Interactive fiction (Choose-your-own stories)"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Interactive fiction (Choose-your-own stories)"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Plot-your-own stories"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Plot-your-own stories"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Making-choices stories"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Making-choices stories"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5865b8aab1134f37bef9508e78807195b40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Multiple plot stories"}}, {"@id": "_:n5865b8aab1134f37bef9508e78807195b40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Multiple plot stories"}}], "@id": "/authorities/genreForms/gf2014026259"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026260", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCinquains", "identifiers:lccn": "gf2014026260", "madsrdf:adminMetadata": [{"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb1"}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Cinquains"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026481"}, "madsrdf:hasSource": [{"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb5"}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb6"}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb7"}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb8"}], "madsrdf:hasVariant": [{"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb9"}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Poems composed in five lines that often have a fixed number of syllables per line."}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T14:59:11"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cinquains"}}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cinquain: A five-line stanza with a variable meter and rhyme scheme. It may be of medieval origin. The American poet Adelaide Crapsey worked out a particular kind of cinquain consisting of five lines with a fixed number of syllables: two, four, six, eight and two respectively.)"}, "madsrdf:citationSource": "Cuddon, J.A. A dictionary of literary terms and literary theory, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Cinquain: In general, any five-line stanza. A cinquain is also a single-line stanza poem invented by the American poet Adelaide Crapsey while she was translating Japanese poetry. Similar to the Japanese tanka, her cinquain consists of five unrhymed lines with, in order, two, four, six, eight, and two syllables.)"}, "madsrdf:citationSource": "Morner, K. NTC's dictionary of literary terms, 1991", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A cinquain is a five line poem)"}, "madsrdf:citationSource": "Cinquain poetry, via Los Angeles County Office of Education TEAMS educational resources website, Oct. 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The cinquain, also known as a quintain or quintet, is a poem or stanza composed of five lines. Examples of cinquains can be found in many European languages, and the origin of the form dates back to medieval French poetry.)"}, "madsrdf:citationSource": "Poets.org WWW site, March 6, 2015:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quintets (Poetry)"}}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quintets (Poetry)"}}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Quintains (Poetry)"}}, {"@id": "_:n4d2d47b48a43495991b98aa8accd27ccb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Quintains (Poetry)"}}], "@id": "/authorities/genreForms/gf2014026260"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026261", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aClerihews", "identifiers:lccn": "gf2014026261", "madsrdf:adminMetadata": [{"@id": "_:n9436b479275b48a98fc1a6bdaf5c6be5b1"}, {"@id": "_:n9436b479275b48a98fc1a6bdaf5c6be5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Clerihews"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9436b479275b48a98fc1a6bdaf5c6be5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026379"}, "madsrdf:hasSource": [{"@id": "_:n9436b479275b48a98fc1a6bdaf5c6be5b5"}, {"@id": "_:n9436b479275b48a98fc1a6bdaf5c6be5b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Humorous poems that usually consist of two unmatched rhyming couplets about a person, whose name generally serves as one of the rhymes."}, {"@id": "_:n9436b479275b48a98fc1a6bdaf5c6be5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T14:59:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9436b479275b48a98fc1a6bdaf5c6be5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n9436b479275b48a98fc1a6bdaf5c6be5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Clerihews"}}, {"@id": "_:n9436b479275b48a98fc1a6bdaf5c6be5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Clerihew: A light verse form, rhymed aabb; its first line is the name of a famous person and its second line forms a comic predicate; lines three and four comment further, comically, on some biographical fact or absurd fancy related to that person. The meter in a clerihew tends to be intentionally rough and irregular, shortening or lengthening according to the author's whim. Edmund Clerihew Bentley (1875-1956) invented the form when he was a student at St. Paul's Boys' School in London)"}, "madsrdf:citationSource": "Drury, J. The poetry dictionary, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:n9436b479275b48a98fc1a6bdaf5c6be5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Clerihew: The invention of Edmund Clerihew Bentley (1875-1956), a clerihew contains two couplets which humorously characterize a person whose name is one of the rhymes)"}, "madsrdf:citationSource": "Beckson, K. Literary terms : a dictionary, 1989", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026261"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026262", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aComedies of humours", "identifiers:lccn": "gf2014026262", "madsrdf:adminMetadata": [{"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b1"}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Comedies of humours"}, "madsrdf:elementList": {"@list": [{"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, "madsrdf:hasSource": [{"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b5"}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b6"}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b7"}], "madsrdf:hasVariant": [{"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b8"}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b11"}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b14"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "English comedies of the 16th and 17th century featuring characters whose conduct is controlled by one overriding trait."}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-05-15T09:06:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedies of humours"}}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Comedy of humours. The distinctive style of English comedy of humours was popularized by the enormous success of Jonson's Every Man in His Humour (1598). Jonson peopled the play with characters, each of whom was dominated by a single attitude or 'humour'. It was a comic technique familiar from Aristophanes)"}, "madsrdf:citationSource": "The Cambridge guide to world theatre, 1988", "madsrdf:citationStatus": "found"}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Comedy of Humors. Kind of comedy built upon dominant traits in most of the characters. One trait--jealousy, greed, braggadocio--usually predominates in each character and is often employed to make him appear ridiculous. The form is based upon the Middle Ages and Renaissance psychology of humors.)"}, "madsrdf:citationSource": "McGraw-Hill encyc. of world drama, c1972", "madsrdf:citationStatus": "found"}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comedy of humours, a dramatic genre most closely associated with the English playwright Ben Jonson from the late 16th century. The term derives from the Latin humor (more properly umor), meaning \"liquid,\" and its use in the medieval and Renaissance medical theory that the human body held a balance of four liquids, or humours: blood, phlegm, yellow bile (choler), and black bile (melancholy). When properly balanced, these humours were thought to give the individual a healthy mind in a healthy body. Jonson's characters usually represent one humour and, thus unbalanced, are basically caricatures)"}, "madsrdf:citationSource": "Britannica online, Nov. 24, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Humours, Comedies of"}}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Humours, Comedies of"}}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comedies of humors"}}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedies of humors"}}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Humors, Comedies of"}}, {"@id": "_:n543cea4dcd8540d290bdbae1fdc348a2b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Humors, Comedies of"}}], "@id": "/authorities/genreForms/gf2014026262"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026263", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aComedies of manners", "identifiers:lccn": "gf2014026263", "madsrdf:adminMetadata": [{"@id": "_:nb588772c4c964b679649c95f9b2f7e11b1"}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Comedies of manners"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb588772c4c964b679649c95f9b2f7e11b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, "madsrdf:hasSource": [{"@id": "_:nb588772c4c964b679649c95f9b2f7e11b5"}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b6"}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b7"}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b8"}], "madsrdf:hasVariant": [{"@id": "_:nb588772c4c964b679649c95f9b2f7e11b9"}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Comedies set among the sophisticated upper classes, in which the characters' machinations are veiled by their elegant manners and repartee."}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T12:55:05"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedies of manners"}}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comedy of manners. A form of sophisticated comedy, usually set among the fashionable upper classes, in which the characters' machinations are veiled by their elegant manners and elaborate repartee. The genre can be traced back to the Greek New Comedy but in its modern form was essentially created by Moli\u00e8re in such plays as Les Pr\u00e9cieuses ridicules (1658) and Le M\u00e9decin malgr\u00e9 lui (1666))"}, "madsrdf:citationSource": "DictionaryCentral.com, Nov. 14, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comedy of manners, witty, cerebral form of dramatic comedy that depicts and often satirizes the manners and affectations of a contemporary society. A comedy of manners is concerned with social usage and the question of whether or not characters meet certain social standards. Often the governing social standard is morally trivial but exacting. The plot of such a comedy, usually concerned with an illicit love affair or similarly scandalous matter, is subordinate to the play's brittle atmosphere, witty dialogue, and pungent commentary on human foibles.)"}, "madsrdf:citationSource": "Britannica online, Nov. 14, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "comedy (The Restoration period in England saw the development of the comedy of manners, a form that feeds on dazzling wit and the creation of an artificial world) Restoration comedy (A type of English comedy associated with the last decades of the 17th and the first decade of the 18th centuries. Indebted to some extent to the French comedies of Moli\u00e8re, Restoration comedies were witty, sophisticated, elegant exercises, designed to reflect and occasionally satirize the manners, mores, and taste of its elite audience)"}, "madsrdf:citationSource": "Quinn, E. A dict. of literary and thematic terms, c1999:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comedy of manners. A kind of comedy representing the complex and sophisticated code of behavior current in fashionable circles of society, where appearances count for more than true moral character. Its plot usually revolves around intrigues of lust and greed, the self-interested cynicism of the characters being masked by decorous pretence. Unlike satire, the comedy of manners tends to reward its cleverly unscrupulous characters rather than punish their immorality. Its humour relies chiefly upon elegant verbal wit and repartee.)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb588772c4c964b679649c95f9b2f7e11b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Manners, Comedies of"}}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Manners, Comedies of"}}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb588772c4c964b679649c95f9b2f7e11b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Restoration comedies"}}, {"@id": "_:nb588772c4c964b679649c95f9b2f7e11b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Restoration comedies"}}], "@id": "/authorities/genreForms/gf2014026263"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aComedy plays", "identifiers:lccn": "gf2014026264", "madsrdf:adminMetadata": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b1"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Comedy plays"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026110"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026237"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026262"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026263"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026265"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026267"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026335"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026398"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026437"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026535"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2016026026"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026060"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2023026106"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026076"}], "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026577"}, "madsrdf:hasSource": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b5"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b6"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b7"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b8"}], "madsrdf:hasVariant": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b9"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b12"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b15"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b18"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b21"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b24"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b27"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b30"}], "madsrdf:historyNote": "[Heading changed from Satirical drama to Comedy plays in May 2020.]", "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026133"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-10-24T16:31:01"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedy plays"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comedy: a dramatic work that is light and often humorous or satirical in tone and that usually contains a happy resolution of the thematic conflict)"}, "madsrdf:citationSource": "The American heritage dictionary of the English language, c2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Comic drama in the Low Countries, c.1450-1560 : a critical anthology, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "glossary (Comedy: Category of drama that is generally light in tone; it is concerned with issues that are not serious, has a happy ending, and is designed to amuse and provoke laughter. (See also Old Comedy, New Comedy, Comedy of humours, Comedy of manners, Farce, Satire, Slapstick.))"}, "madsrdf:citationSource": "Wilson, E. The theater experience, c2004, via McGraw-Hill Higher Education online learning center, Nov. 14, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(comedy. A play (or other literary composition) written chiefly to amuse its audience by appealing to a sense of superiority over the characters depicted. A comedy will normally be closer to the representation of everyday life than a tragedy, and will explore common human failings rather than tragedy's disastrous crimes. Its ending will usually be happy for the leading characters. As a dramatic form, comedy in Europe dates back to the Greek playwright Aristophanes in the 5th century BCE. There are several kinds of comedy, including sentimental comedy, romantic comedy, satire, sophisticated verbal wit of the comedy of manners, and the more topical 'comedy of ideas' in the plays of Bernard Shaw. Among its less sophisticated forms are burlesque, pantomime, and farce. The adjective comedic means 'characteristic of comedy' and is sometimes preferred as more neutral than 'comic' or 'comical' in that it avoids suggesting that the referent is funny)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dict. of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Humorous drama"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Humorous drama"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comedy drama"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedy drama"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comic plays"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comic plays"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comedic drama"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedic drama"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comedic plays"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedic plays"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comic drama"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comic drama"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comedies (Drama)"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedies (Drama)"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1ead0776f37641dc977928fa6691ba24b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Humorous plays"}}, {"@id": "_:n1ead0776f37641dc977928fa6691ba24b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Humorous plays"}}], "@id": "/authorities/genreForms/gf2014026264"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026265", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aComedy sketches", "identifiers:lccn": "gf2014026265", "madsrdf:adminMetadata": [{"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb1"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Comedy sketches"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026264"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb5"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026581"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026300"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026059"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026100"}], "madsrdf:hasSource": [{"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb8"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb9"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb10"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb11"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb12"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb13"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb14"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb15"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb16"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb17"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb18"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb19"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb20"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb21"}], "madsrdf:hasVariant": [{"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb22"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb25"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb28"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb31"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb34"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb37"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb40"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb43"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb46"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb49"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb52"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb55"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short comedic scenes or vignettes.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026760"}}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-04-14T13:44:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Comedy sketches"}}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Filmed comedy sketches"}}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed comedy sketches"}}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Comedy sketches. UF Sketch comedy)"}, "madsrdf:citationSource": "LCSH, Oct. 21, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)22724567"}, "madsrdf:citationSource": "Gelman, Rita Golden. Comits : a book of comic skits, \u00a91975.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 39 (Sketch comedy, which is a broad situation in one scene (probably originated, as much comedy has, from burlesque) is used today mostly in variety shows and revues)"}, "madsrdf:citationSource": "Saks, S. Funny business : the craft of comedy writing, c1991:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A sketch comedy consists of a series of short comedy scenes or vignettes, called \"sketches\", commonly between one and ten minutes long. Such sketches are performed by a group of comic actors or comedians, either on stage or through an audio and/or visual medium such as broadcasting. Often sketches are first improvised by the actors and written down based on the outcome of these improv sessions; however, improvisation is not necessarily involved in all sketch comedy.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 9, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)1013423029"}, "madsrdf:citationSource": "Coyne, J. Stirling. That affair at Finchley : a comic sketch in one act, 1967.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(skit: 1. a short literary piece of a humorous or satirical character. 2. a short theatrical sketch or act, usually comical. 3. a gibe or taunt. 4. British Dialect. a joke or prank)"}, "madsrdf:citationSource": "Dictionary.com, Nov. 21, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sketch. A sketch is a short scene that presents a situation, generally a comic one, played by a small number of actors with no profound characterization or plot development, emphasizing funny and subversive moments. The term refers particularly to variety entertainment in which a character or scene is played using a humourous and satirical text, in music hall, cabaret, on television or in caf\u00e9 theatre. It is driven mainly by a satire of contemporary life, sometimes literary (as in a parody of a well-known text or famous person), sometimes grotesque and burlesque (as on television or in the movies))"}, "madsrdf:citationSource": "Pavis, Patrice. Dictionary of the theatre, \u00a91998", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(skit 1: a jeering or satirical remark : taunt. 2 a: a satirical or humorous story or sketch. 2 b (1): a brief burlesque or comic sketch included in a dramatic performance (such as a revue). 2 b (2): a short serious dramatic piece, especially : one done by amateurs)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Nov. 21, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)7307959"}, "madsrdf:citationSource": "Redhead, Wilfred. Three comic sketches, 1978.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)19925835"}, "madsrdf:citationSource": "Melville, Richard L. Oh Romeo! : a ten minute comic skit for 2 men and 2 women ..., \u00a91948.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)49871547"}, "madsrdf:citationSource": "McFarland, Daron Scott. Duos and trios : ten two- and three-character comedy skits, \u00a91999.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (At head of title: Skits and blackouts) (OCoLC)336070"}, "madsrdf:citationSource": "Taggart, Tom. For women only, 1947:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(OCoLC)22911240"}, "madsrdf:citationSource": "Joucla, Peter. Absurd, black and comic sketches : ten duologues and five monologues for drama students, \u00a91991.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb21", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "half title (Very low budget comedy play sketches suitable for stage plays or television show special events) (OCoLC)48760315"}, "madsrdf:citationSource": "Russell, James. An evening of comedy skits, \u00a91997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0ea3dbdd7bac4c83a39d5959e850a2cfb23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Comic skits"}}, {"@id": "_:n0ea3dbdd7b