ecordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-15T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sukkot music"}}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab5", "@type": "madsrdf:Source", "madsrdf:citationSource": "My favorite Succos & Simchas Torah piano book, 2003?", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sukkot. UF Feast of Tabernacles; Succos; Succoth; Sukkoth; Sukos; Sukot)"}, "madsrdf:citationSource": "LCSH, Dec. 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Krawitz, M.J. Songs for Succoth, c1957.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Fromm, H. Sukkot madrigal, c1979.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sukkot, Succot or Sukkos (Feast of Booths, Feast of Tabernacles) is a biblical Jewish holiday celebrated on the 15th day of the month of Tishrei (varies from late September to late October). It is one of the Three Pilgrimage Festivals (shalosh regalim) on which the Israelites would make a pilgrimage to the Temple in Jerusalem)"}, "madsrdf:citationSource": "Wikipedia, Dec. 14, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Songs for Succoth and Simhat Torah, 195-.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Sukkot and Simchat Torah songster = Shiron le-Sukot ule-\u015aim\u1e25at Torah, 1946.", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Succoth music"}}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Succoth music"}}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Feast of Booths music"}}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Feast of Booths music"}}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sukkoth music"}}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sukkoth music"}}, {"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5cb3380bf5a7404b91100b2a3cc382eab22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Succos music"}}, {"@id": "_:n5cb3380bf5a7404b9110