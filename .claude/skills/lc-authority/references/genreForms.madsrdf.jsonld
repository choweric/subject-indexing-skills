02-17T09:40:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc530cbf215514f40ae4670179592571cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Public service announcements (Motion pictures)"}}, {"@id": "_:nc530cbf215514f40ae4670179592571cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A public service announcement (PSA) or community service announcement (CSA) is a non-commercial advertisement typically on radio or television, ostensibly broadcast for the public good. The main concept is to modify public attitudes by raising awareness about specific issues)"}, "madsrdf:citationSource": "Wikipedia, December 5, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nc530cbf215514f40ae4670179592571cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Public service announcement: work which promotes certain charitable causes or types of behavior, such as promoting contributions to the American Cancer Society, encouraging girls to join the Girl Scouts, urging people on the behalf of The U.S. Treasury Department to purchase savings bonds, or encouraging people on behalf of the American Dairy Association to drink milk)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 5, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nc530cbf215514f40ae4670179592571cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 81 (Public service: use for a short film or videorecording presented by, or on behalf of, a nonprofit organization which attempts to persuade the audience to take some specific action or adopt a favorable view toward some service, institution or cause)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc530cbf215514f40ae4670179592571cb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc530cbf215514f40ae4670179592571cb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "CSAs (Motion pictures)"}}, {"@id": "_:nc530cbf215514f40ae4670179592571cb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "CSAs (Motion pictures)"}}, {"@id": "_:nc530cbf215514f40ae4670179592571cb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc530cbf215514f40ae4670179592571cb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "PSAs (Motion pictures)"}}, {"@id": "_:nc530cbf215514f40ae4670179592571cb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "PSAs (Motion pictures)"}}, {"@id": "_:nc530cbf215514f40ae4670179592571cb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc530cbf215514f40ae4670179592571cb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Community service announcements (Motion pictures)"}}, {"@id": "_:nc530cbf215514f40ae4670179592571cb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Community service announcements (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2011026477"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026478", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPublic service radio programs", "identifiers:lccn": "gf2011026478", "madsrdf:adminMetadata": [{"@id": "_:na12ad1d0f2824070844523564d4864c0b1"}, {"@id": "_:na12ad1d0f2824070844523564d4864c0b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Public service radio programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:na12ad1d0f2824070844523564d4864c0b3"}]}, "madsrdf:exampleNote": "Notes under [Public affairs radio programs; Radio public service announcements]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026424"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": {"@id": "_:na12ad1d0f2824070844523564d4864c0b5"}, "madsrdf:hasVariant": {"@id": "_:na12ad1d0f2824070844523564d4864c0b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Radio programs aired by or on behalf of nonprofit or governmental organizations to promote the common well-being or general welfare of society. For radio programs about public policy or politics see [Public affairs radio programs.] For radio announcements aired by or on behalf of nonprofit or governmental organizations to persuade the audience to take some specific action or adopt a favorable view toward a service, institution, or cause see [Radio public service announcements.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025547"}}, {"@id": "_:na12ad1d0f2824070844523564d4864c0b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:na12ad1d0f2824070844523564d4864c0b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T09:39:20"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na12ad1d0f2824070844523564d4864c0b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Public service radio programs"}}, {"@id": "_:na12ad1d0f2824070844523564d4864c0b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Public service: Programs intended to be presented over the air by or on behalf of nonprofit or governmental organizations that attempt to persuade the audience to take some specific action or adopt a favorable view towards some service, institution, or cause. Examples: Mobilization for human needs; Your health; The greater New York fund program; Catholic charities)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Nov. 7, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:na12ad1d0f2824070844523564d4864c0b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:na12ad1d0f2824070844523564d4864c0b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Public interest radio programs"}}, {"@id": "_:na12ad1d0f2824070844523564d4864c0b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Public interest radio programs"}}], "@id": "/authorities/genreForms/gf2011026478"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026479", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPublic service television programs", "identifiers:lccn": "gf2011026479", "madsrdf:adminMetadata": [{"@id": "_:n170697d31c1e4e7c8156c373b7834032b1"}, {"@id": "_:n170697d31c1e4e7c8156c373b7834032b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Public service television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n170697d31c1e4e7c8156c373b7834032b3"}]}, "madsrdf:exampleNote": "Notes under [Public affairs television programs; Television public service announcements]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026425"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": {"@id": "_:n170697d31c1e4e7c8156c373b7834032b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs aired by or on behalf of nonprofit or governmental organizations to promote the common well-being or general welfare of society. For television programs about public policy or politics see [Public affairs television programs.] For television announcements aired by or on behalf of nonprofit or governmental organizations to persuade the audience to take some specific action or adopt a favorable view toward a service, institution, or cause see [Television public service announcements.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025681"}}, {"@id": "_:n170697d31c1e4e7c8156c373b7834032b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T09:39:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n170697d31c1e4e7c8156c373b7834032b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n170697d31c1e4e7c8156c373b7834032b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Public service television programs"}}, {"@id": "_:n170697d31c1e4e7c8156c373b7834032b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Moving image materials, 1988;Moving image genre-form guide online, Oct. 29, 2008", "madsrdf:citationStatus": "notfound"}], "@id": "/authorities/genreForms/gf2011026479"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026480", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPuppet films", "identifiers:lccn": "gf2011026480", "madsrdf:adminMetadata": [{"@id": "_:n9055fbc9229643d2944012e412e52853b1"}, {"@id": "_:n9055fbc9229643d2944012e412e52853b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Puppet films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n9055fbc9229643d2944012e412e52853b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasSource": [{"@id": "_:n9055fbc9229643d2944012e412e52853b5"}, {"@id": "_:n9055fbc9229643d2944012e412e52853b6"}], "madsrdf:hasVariant": {"@id": "_:n9055fbc9229643d2944012e412e52853b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025349"}}, {"@id": "_:n9055fbc9229643d2944012e412e52853b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n9055fbc9229643d2944012e412e52853b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T17:06:31"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n9055fbc9229643d2944012e412e52853b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Puppet films"}}, {"@id": "_:n9055fbc9229643d2944012e412e52853b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Puppet: Work that photographs puppets in a manner sometimes related to, but distinct from, animation, since it uses a three-dimensional rather than two-dimensional perspective. Puppet work may be presented in an abstract or realistic manner, with the puppets controlled by hand and photographed through stop-motion, or photographed in live-action, with strings or electronic mechanisms to operate their limbs and expressions. Used for Marionette)"}, "madsrdf:citationSource": "Moving image genre-form guide online, July 30, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9055fbc9229643d2944012e412e52853b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Puppet works: use for films or video used to record a live action puppet performance; Uf Marionette works; Puppet films)"}, "madsrdf:citationSource": "Moving image materials : genre terms, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n9055fbc9229643d2944012e412e52853b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n9055fbc9229643d2944012e412e52853b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Marionette films"}}, {"@id": "_:n9055fbc9229643d2944012e412e52853b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Marionette films"}}], "@id": "/authorities/genreForms/gf2011026480"}
