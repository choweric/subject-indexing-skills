new"}, {"@id": "_:n543027f20da14510bc709da07c7b435db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:33:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n543027f20da14510bc709da07c7b435db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monster television programs"}}, {"@id": "_:n543027f20da14510bc709da07c7b435db5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n543027f20da14510bc709da07c7b435db6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mummy television programs"}}, {"@id": "_:n543027f20da14510bc709da07c7b435db6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mummy television programs"}}, {"@id": "_:n543027f20da14510bc709da07c7b435db8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Monsters. Small blessing, 1990.", "madsrdf:citationStatus": "found"}, {"@id": "_:n543027f20da14510bc709da07c7b435db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 65 (Monster films and programs: use for fictional genre films and programs which focus on an animate being, part human or nonhuman, with supernatural or prodigious powers, which threatens human life. Monsters include atomic mutants, monstrous throwbacks, monsters made and/or controlled by mad scientists, animal-man combinations, scientists who transform themselves into monsters, the various species of resurrected dead, and creatures from outer space, including alien parasites)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n543027f20da14510bc709da07c7b435db10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n543027f20da14510bc709da07c7b435db11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Mummy television programs"}}, {"@id": "_:n543027f20da14510bc709da07c7b435db11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mummy television programs"}}], "@id": "/authorities/genreForms/gf2011026403"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026404", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMood films", "identifiers:lccn": "gf2011026404", "madsrdf:adminMetadata": [{"@id": "_:ncc387a458c6a4f7ebaea7e5e7da758f4b1"}, {"@id": "_:ncc387a458c6a4f7ebaea7e5e7da758f4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mood films"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncc387a458c6a4f7ebaea7e5e7da758f4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026250"}, "madsrdf:hasSource": [{"@id": "_:ncc387a458c6a4f7ebaea7e5e7da758f4b5"}, {"@id": "_:ncc387a458c6a4f7ebaea7e5e7da758f4b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that emphasize a mood or atmosphere rather than a plot.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2008025676"}}, {"@id": "_:ncc387a458c6a4f7ebaea7e5e7da758f4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-07T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ncc387a458c6a4f7ebaea7e5e7da758f4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T14:01:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncc387a458c6a4f7ebaea7e5e7da758f4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mood films"}}, {"@id": "_:ncc387a458c6a4f7ebaea7e5e7da758f4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 44 (interest in emotional overtones of a situation reveals the origins of the mood film, a most important Japanese genre ... projecting an overall mood or atmosphere ... [seeking] to capture the components of ... the greatest forces in the world: love within a family and comradeship between men ... examine[d] not in the uncommon moments of high emotion, as in a plotted film, but rather during those characteristic moments of an enduring period of hardship)"}, "madsrdf:citationSource": "Anderson, J. & Donald RichieThe Japanese film, 1960:", "madsrdf:citationStatus": "found"}, {"@id": "_:ncc387a458c6a4f7ebaea7e5e7da758f4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 65 (Mood films: use for fictional genre Japanese films in which the emphasis is on projecting an overall mood or atmosphere rather than in directly telling a story)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026404"}
