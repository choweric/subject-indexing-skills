{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027016", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProgressive metal (Music)", "identifiers:lccn": "gf2014027016", "madsrdf:adminMetadata": [{"@id": "_:n6308981af240434a8acc47b6b1fd71e8b1"}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Progressive metal (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6308981af240434a8acc47b6b1fd71e8b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026854"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027018"}], "madsrdf:hasSource": [{"@id": "_:n6308981af240434a8acc47b6b1fd71e8b5"}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b6"}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b7"}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b8"}], "madsrdf:hasVariant": {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:57"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Progressive metal (Music)"}}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (Queensryche)"}, "madsrdf:citationSource": "Work cat.: Queensryche (Musical group). Operation mindcrime [SR] 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Progressive metal; subgenre of both progressive rock and heavy metal)"}, "madsrdf:citationSource": "Wikipedia, August 13, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Progressive Metal blends the attack, volume, and aggression of metal with the grandiose, pseudo-classical ambitions of prog-rock. Progressive metal first surfaced in the late '80s, led by such bands as the Pink Floydian Queensryche. Even though it never became a huge seller in the '90s, progressive metal always had a dedicated following, and bands like Queensryche and Dream Theater stayed on major labels throughout the decade)"}, "madsrdf:citationSource": "All music guide WWW site, Jan. 24, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Progressive metal-a progressive rock sub-genre; sound defined by a blend of heavy, guitar-oriented metal music enriched with compositional innovation and complex arrangements, usually expressed through diverse instrumentation and often (but not always) with odd-time signatures. Common, but not essential to define the movement, are the frequent use of keyboards, high-pitched vocals, concept lyrical themes and tracks of longer duration.)"}, "madsrdf:citationSource": "Prog Archive WWW site, August 13, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6308981af240434a8acc47b6b1fd71e8b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Prog metal (Music)"}}, {"@id": "_:n6308981af240434a8acc47b6b1fd71e8b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Prog metal (Music)"}}], "@id": "/authorities/genreForms/gf2014027016"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014027017", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProgram music", "identifiers:lccn": "gf2014027017", "madsrdf:adminMetadata": [{"@id": "_:n8e259c7d1b404cb98014b6d835932f97b1"}, {"@id": "_:n8e259c7d1b404cb98014b6d835932f97b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Program music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8e259c7d1b404cb98014b6d835932f97b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027120"}, "madsrdf:hasSource": [{"@id": "_:n8e259c7d1b404cb98014b6d835932f97b5"}, {"@id": "_:n8e259c7d1b404cb98014b6d835932f97b6"}], "madsrdf:hasVariant": {"@id": "_:n8e259c7d1b404cb98014b6d835932f97b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions that employ a suggestive title, a text, program, or other extra-musical device to convey their meaning."}, {"@id": "_:n8e259c7d1b404cb98014b6d835932f97b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8e259c7d1b404cb98014b6d835932f97b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:54:39"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8e259c7d1b404cb98014b6d835932f97b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Program music"}}, {"@id": "_:n8e259c7d1b404cb98014b6d835932f97b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Music that is inspired by, or that suggests or characterizes something other than a musical idea or thing: descriptive music. (Reference to Absolute music). 2. instrumental music that follows the moods of a program)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e259c7d1b404cb98014b6d835932f97b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Music that attempts to express or depict one or more non-musical ideas, images, or events.)"}, "madsrdf:citationSource": "New Harvard dict. of music", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e259c7d1b404cb98014b6d835932f97b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n8e259c7d1b404cb98014b6d835932f97b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Programmatic music"}}, {"@id": "_:n8e259c7d1b404cb98014b6d835932f97b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Programmatic music"}}], "@id": "/authorities/genreForms/gf2014027017"}
