{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026155", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aProgrammed instructional materials", "identifiers:lccn": "gf2014026155", "madsrdf:adminMetadata": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b1"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Programmed instructional materials"}, "madsrdf:elementList": {"@list": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026050"}, "madsrdf:hasSource": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b5"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b6"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b7"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b8"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b9"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b10"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b11"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b12"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b13"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b14"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b15"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b16"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b17"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b18"}], "madsrdf:hasVariant": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b19"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b22"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b25"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b28"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b31"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b34"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b37"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b40"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b43"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Self-instructional works that use a step-by-step teaching method that employs small units of information or learning material and frequent testing and allows students to control the pacing of the learning process."}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2022-11-30T15:24:40"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Programmed instructional materials"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mallinson, G.G. Programmed learning materials for the blind, 1967.", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wakeford, R.E. Details of programmed learning materials available in psychology, 1970.", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Teply, L.L. Programmed materials on legal research and citation, 1986.", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ploor, M.L. An investigation of the expectations adult learners hold regarding effort expenditure, time investment, and learning achievement for four types of prepackaged, self-paced instructional materials, 1985.", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(programmed instructional materials: An individualized educational method consisting of a planned sequential presentation of material. Each separate presentation of a small basic unit of material requires a response from the student, who is then given immediate feedback about the correctness of the answer; programmed text: A book format of programmed instructional materials)"}, "madsrdf:citationSource": "The ALA glossary of library and information science, 1983", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "Ambrose, S.C. The development and trial of programmed materials for teaching selected clarinet performance skills in college woodwind techniques courses, 1988.", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Programmed Instruction as Topic. Instruction in which learners progress at their own rate using workbooks, textbooks, or electromechanical devices that provide information in discrete steps, test learning at each step, and provide immediate feedback about achievement. UF Self-Instruction Programs; Program, Self-Instruction; Programs, Self-Instruction; Self Instruction Programs; Self-Instruction Program; Textbooks, Programmed; Programmed Textbook; Programmed Textbooks; Textbook, Programmed; Programmed Learning; Learning, Programmed)"}, "madsrdf:citationSource": "MeSH", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Barcus, D. Development of programed learning materials for use with televised Spanish instruction, 1961.", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Programmed Instruction, instead use: Teaching Methods. Instruction in which learners progress at their own rate using workbooks, textbooks, or electromechanical devices that provide information in discrete steps, test learning at each step, and provide immediate feedback about achievement; Programmed Instructional Materials, Scope Note: Materials prepared specifically to employ programmed instruction techniques, UF Programed Instructional Materials; Programed Materials; Programed Texts; Self Instruction Materials, BT Instructional Materials)"}, "madsrdf:citationSource": "ERIC thesaurus, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "Beckham, J.W. An experimental comparison of self-paced instructional materials versus the traditional method in teaching woodshop safety, 1969.", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Programmed instruction. See also subdivision Programmed instruction under subjects, e.g. English language--Programmed instruction. UF Programed instruction; Programmed learning; Programmed textbooks)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b16", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(programmed textbooks. Books that include instructional material and also directions on how to assimilate information. Material in the textbooks is divided into units of information to be assimilated, combined with instructions on student fulfillment of assignments, additional explanations, and sections for self-testing for retention. UF programmed text-books; programmed texts)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(programmed text: An instructional book presented as a sequence of self-paced units that require the student to demonstrate an understanding of the content by responding appropriately at various steps along the way. If the correct answer is given, the lesson continues; if the student answers incorrectly, additional instruction and practice are provided until the unit is mastered. Programmed instruction is suitable only for material that can be learned in a step-by-step process.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 6, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Programmed learning materials. Scope Note: Materials prepared specifically to employ programmed learning techniques. UF Programmed instructional materials; Programmed materials; Programmed texts; Self teaching materials. BT Curriculum materials)"}, "madsrdf:citationSource": "Australian thesaurus of education descriptors, via WWW, Sept. 4, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b19", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b20"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Programed instructional materials"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b20", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Programed instructional materials"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b22", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b23"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Programmed texts (Instructional materials)"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b23", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Programmed texts (Instructional materials)"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b25", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b26"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Programmed textbooks"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b26", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Programmed textbooks"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b28", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b29"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Self-teaching materials (Programmed instructional materials)"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b29", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Self-teaching materials (Programmed instructional materials)"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b31", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b32"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Programmed learning materials"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b32", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Programmed learning materials"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b34", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b35"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Self-instructional materials (Programmed instructional materials)"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b35", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Self-instructional materials (Programmed instructional materials)"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b37", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b38"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Programmed materials"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b38", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Programmed materials"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b40", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b41"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Self-paced instructional materials (Programmed instructional materials)"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b41", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Self-paced instructional materials (Programmed instructional materials)"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b43", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:neb947bd6823446ef91b7630db373ae46b44"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Textbooks, Programmed"}}, {"@id": "_:neb947bd6823446ef91b7630db373ae46b44", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Textbooks, Programmed"}}], "@id": "/authorities/genreForms/gf2014026155"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026156", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aPrograms (Publications)", "identifiers:lccn": "gf2014026156", "madsrdf:adminMetadata": [{"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb1"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Programs (Publications)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026093"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026065"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026078"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026102"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026126"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026135"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026193"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2024026052"}], "madsrdf:hasSource": [{"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb5"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb6"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb7"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb8"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb9"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb10"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb11"}], "madsrdf:hasVariant": [{"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb12"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb15"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb18"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb21"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb24"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb27"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb30"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb33"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb36"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb39"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:47"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Programs (Publications)"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Programme (booklet). A programme or program is a booklet available for patrons attending a live event such as theatre performances, f\u00eates, sports events, etc. It is a printed leaflet outlining the parts of the event scheduled to take place, principal performers and background information. In the case of theatrical performances, the term playbill is also used.)"}, "madsrdf:citationSource": "Wikipedia, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(titles: Goodwill Games program book; Santa Fe Opera program book; Glimmerglass Opera program book; Temple University Music Festival : official program book, 11th season, July 6 to August 31, 1978; A program book from the North Carolina Symphony; Metropolitan Opera program; 2010 Cultural Olympiad program guide; Little Rock Film Festival 2009 : May 13-17, 2009, Little Rock, Arkansas, festival program guide; Philadelphia International Gay & Lesbian Film Festival 2002 program guide)"}, "madsrdf:citationSource": "OCLC, Aug. 7, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(program: A list, usually printed, indicating the order in which the features and participants in a public ceremony, performance, entertainment, or other event are presented to the audience, sometimes with notes on the various items appended in a separate section, intended for distribution to individual members of the audience as they arrive. Programs for established venues and well-known performers often include graphics. Copies autographed by one or more of the performers may be collectible; playbill: A printed poster or circular advertising the performance of a play, usually indicating the names of the actors and actresses cast in the leading roles. Also, a program for a play or other theatrical entertainment, printed on a single sheet)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, via WWW, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Programs. BT Ephemera. Brief, usually printed outlines of the order to be followed, of feature(s) to be presented, and of person(s) participating in a public exercise, performance, or entertainment)"}, "madsrdf:citationSource": "Thesaurus for graphic materials, via WWW, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(programs (documents). UF briefs (programs); programmes (documents); souvenir programs. Programs produced and distributed to mark special events, usually more lavishly designed and printed, and with more detailed contents than regular programs.)"}, "madsrdf:citationSource": "Art & architecture thesaurus, via WWW, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Programs. BT Ephemera. Use for lists of the events, pieces, performers, speakers, etc., of an entertainment, ceremony, or the like.)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, June 26, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Programs. BT Printed ephemera. Here are entered works on printed lists providing the order of events and other pertinent information for public presentations)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Program booklets"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Program booklets"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Performance programs"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Performance programs"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Programmes (Publications)"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Programmes (Publications)"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Event programmes"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Event programmes"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Program guides"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Program guides"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Event programs"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Event programs"}}, {"@id": "_:n0bc4d61e43fa4bbf8672b337491ff92cb30", "@type": ["madsrdf:GenreForm", "m