Status": "found"}, {"@id": "_:n43f079a624074b008e6930b1723920d1b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n43f079a624074b008e6930b1723920d1b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Grunge rock music"}}, {"@id": "_:n43f079a624074b008e6930b1723920d1b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Grunge rock music"}}], "@id": "/authorities/genreForms/gf2014026844"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026845", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGuaguanc\u00f3s (Music)", "identifiers:lccn": "gf2014026845", "madsrdf:adminMetadata": [{"@id": "_:nedc4745627ec40bc9526f6737d6867feb1"}, {"@id": "_:nedc4745627ec40bc9526f6737d6867feb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Guaguanc\u00f3s (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nedc4745627ec40bc9526f6737d6867feb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026809"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027059"}], "madsrdf:hasSource": {"@id": "_:nedc4745627ec40bc9526f6737d6867feb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nedc4745627ec40bc9526f6737d6867feb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-03-11T09:58:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nedc4745627ec40bc9526f6737d6867feb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nedc4745627ec40bc9526f6737d6867feb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Guaguanc\u00f3s (Music)"}}, {"@id": "_:nedc4745627ec40bc9526f6737d6867feb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under USA, II, 3: Traditional music: Hispanic American (The guaguanc\u00f3 stresses improvised patterns on the quinto drum in contrast to the patterns of the tumbadora (larger conga drum) and the palitos (sticks)... The vocal parts of the guaguanc\u00f3 consist of a largely improvised solo part, answered by a set, harmonized choral part. This call-and-response practice is built on four- or eight-bar patterns equally divided between the soloist and the chorus. Both vocal and percussion soloists fluctuate in their improvisatory freedom. The other performers' parts provide referential bases for the tension and release of the soloists' improvisations. This effective contrast is one of the most distinctive qualities of the folk rumba.)"}, "madsrdf:citationSource": "Grove music online, viewed August 10, 2014 :", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026845"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026846", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGuarachas (Music)", "identifiers:lccn": "gf2014026846", "madsrdf:adminMetadata": [{"@id": "_:na69ec352d8a54b62afe86d88e4697449b1"}, {"@id": "_:na69ec352d8a54b62afe86d88e4697449b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Guarachas (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:na69ec352d8a54b62afe86d88e4697449b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": [{"@id": "_:na69ec352d8a54b62afe86d88e4697449b5"}, {"@id": "_:na69ec352d8a54b62afe86d88e4697449b6"}, {"@id": "_:na69ec352d8a54b62afe86d88e4697449b7"}, {"@id": "_:na69ec352d8a54b62afe86d88e4697449b8"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:na69ec352d8a54b62afe86d88e4697449b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:na69ec352d8a54b62afe86d88e4697449b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:na69ec352d8a54b62afe86d88e4697449b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Guarachas (Music)"}}, {"@id": "_:na69ec352d8a54b62afe86d88e4697449b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(guaracha; a lively and highly danceable music style with lyrics, originating in Spain. Characterized mostly by its rhythm, it is generally played with a bolero section in 2/4 time and a clave section in either 6/8 or 3/4 time, although the order of these sections is sometimes reversed; came to Puerto Rico from Cuba in the mid-19th century, and developed into the j\u00edbaro style that most closely approaches contemporary Latin dance rhythms)"}, "madsrdf:citationSource": "Music of Puerto Rico WWW site, Nov. 15, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:na69ec352d8a54b62afe86d88e4697449b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(guaracha; a genuine Cuban style of song and dance whose origins are found in the confluence of African and Spanish musical elements. Originally an element of typically Cuban nineteenth-century comic theatre, it later moved to dance halls)"}, "madsrdf:citationSource": "Orovio, H. Cuban music from A to Z, 2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:na69ec352d8a54b62afe86d88e4697449b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(guaracha; An Afro-Cuban canci\u00f3n form with binary structure based on the habanera rhythm that evolved as a substitute for the Spanish tonadilla esc\u00e9nica in 19th-century urban popular theatre. Its often picturesque and satiric coplas are delivered by a solo voice with a chorus repeating a single estribillo text and melody. Instrumental accompaniment shows the strong rhythmic influence of the habanera and features the guitar, tres, and g\u00fciro)"}, "madsrdf:citationSource": "Grove music online WWW site, Nov. 15, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:na69ec352d8a54b62afe86d88e4697449b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "label (guaracha)"}, "madsrdf:citationSource": "Work cat.: Lugo, J. La pir\u00e1mide [SR] 195-:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026846"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026847", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGumb\u00e9 (Music)", "identifiers:lccn": "gf2014026847", "madsrdf:adminMetadata": [{"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b1"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Gumb\u00e9 (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b5"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b6"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b7"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b8"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b9"}], "madsrdf:hasVariant": {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b10"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "The Kriol dance genre of Guinea-Bissau that combines Cabo Verdean and zouk sounds with indigenous traditions."}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:27:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gumb\u00e9 (Music)"}}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Ramiro Naka Ramiro (Guinea-Bissau's indigenous goumbe style typified by performers such as Super Mama Djombo and Ramiro Naka)"}, "madsrdf:citationSource": "Beadle, J. Likembe WWW site, Oct. 9, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Although gumbe is sometimes used as catch-all term for the musics of Guinea-Bissau in general, it is more correctly used to refer to a particular genre which is a primarily vocal and percussive song tradition (using slit drums and calabashes) developing from a fusion of many of the country's traditional folk musics. It is generally regarded as beginning around 1973, shortly before Guinea-Bissau gained independence from Portugal)"}, "madsrdf:citationSource": "Rate Your Music WWW site, Oct. 9, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Guinness encyc. of popular music;New Grove dict. of music.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 154 (Guinea-Bissau's special music is gumbe. It combines a contemporary sound with the musical traditions that survive in the area. Some compare it to the samba, though it's much more polyrhythmic. The lyrics of gumbe are in Kriolu, a creole synthesis of African languages and the colonial Portuguese)"}, "madsrdf:citationSource": "The Rough guide to world music. Africa & Middle East, 2006:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "under Guinea-Bissau. 2, Main music cultures. i, Creole (Kriol) (Guinea-Bissau has its own distinctive creole dance music version that fuses some of sounds associated with Cape Verde and zouk from the French Caribbean with indigenous traditions into a national style called gumb\u00e9)"}, "madsrdf:citationSource": "Grove music online, viewed November 20, 2014:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Goumbe (Music)"}}, {"@id": "_:nfb8843473bc34b42a4e7466abdd8b188b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Goumbe (Music)"}}], "@id": "/authorities/genreForms/gf2014026847"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026848", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHabaneras (Music)", "identifiers:lccn": "gf2014026848", "madsrdf:adminMetadata": [{"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b1"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Habaneras (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b5"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b6"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b7"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b8"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b9"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b10"}], "madsrdf:hasVariant": {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b11"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:54"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Habaneras (Music)"}}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dance of Cuban origin; music for this dance)"}, "madsrdf:citationSource": "Random House", "madsrdf:citationStatus": "found"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Habanera)"}, "madsrdf:citationSource": "Web. 3.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(song and dance form originating in Cuba having a moderate duple meter and exact rhythm similar to that of a tango; during the 2nd half of the 19th cent. a dance genre, later became mainly a vocal genre; popular in Spain, other parts of Europe, and Latin America)"}, "madsrdf:citationSource": "Orovio, H. Dicc. de la m\u00fasica cubana", "madsrdf:citationStatus": "found"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(19th c. song and dance form of Cuban origin)"}, "madsrdf:citationSource": "New Harvard dict. of music", "madsrdf:citationStatus": "found"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 95217393: P\u00e9rez Diz, C. L'Havanera, 1995.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Habanera)"}, "madsrdf:citationSource": "New Grove", "madsrdf:citationStatus": "found"}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Havaneres (Music)"}}, {"@id": "_:n1377be2fa4a5493c8cecd003e09c3c16b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Havaneres (Music)"}}], "@id": "/authorities/genreForms/gf2014026848"}
