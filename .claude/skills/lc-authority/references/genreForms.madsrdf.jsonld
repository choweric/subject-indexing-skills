0-18T07:01:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Clippings"}}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Clippings. Scope Note: Use for partial, full, or multiple pages of text or illustrations that have been removed from their original source; Used For: Newspaper clippings; Broader Term: Ephemera; Related Term: Periodicals)"}, "madsrdf:citationSource": "RBMS Controlled vocabularies: Genre terms, June 18, 2024 Thesaurus for graphic materials, June 10, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(cataloger's note: The item is a map clipped from the New York Times, dated Thursday, April 10, 1947)"}, "madsrdf:citationSource": "Work cat: Big 4 tackle some boundaries issues, 1947", "madsrdf:citationStatus": "found"}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(clippings (information artifacts). Note: Illustrations, pages, articles, or columns of text removed from books, newspapers, journals, or other printed sources and kept for their informational content) (newspaper clippings (clippings (information artifacts). Note: Pieces of text cut out of newspapers)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, June 17, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Clippings (Books, newspapers, etc.) UF: Cuttings, Newspaper clippings, Press clippings; BT: Library materials, Newspapers)"}, "madsrdf:citationSource": "LCSH, June 18, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(clipping. a piece that has been cut off something; an article cut from a newspaper)"}, "madsrdf:citationSource": "Cambridge English Dictionary website, June 18, 2024", "madsrdf:citationStatus": "found"}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n07cd8477489d47338d3f4109ac350236b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Press clippings"}}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Press clippings"}}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n07cd8477489d47338d3f4109ac350236b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cuttings (Publications)"}}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cuttings (Publications)"}}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n07cd8477489d47338d3f4109ac350236b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Newspaper clippings"}}, {"@id": "_:n07cd8477489d47338d3f4109ac350236b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Newspaper clippings"}}], "@id": "/authorities/genreForms/gf2024026055"}
