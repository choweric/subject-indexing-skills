 "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Singing game. A singing game is an activity based around a particular verse or rhyme, usually associated with a set of actions and movements.)"}, "madsrdf:citationSource": "Wikipedia, viewed August 9, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n417c17e9e39847c5aee5abf8be9548e8b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n417c17e9e39847c5aee5abf8be9548e8b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Action songs"}}, {"@id": "_:n417c17e9e39847c5aee5abf8be9548e8b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Action songs"}}], "@id": "/authorities/genreForms/gf2014027094"}
