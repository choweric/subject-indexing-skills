e": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ndf9bd4c30d914bfd830e6bee899e1443b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Filmed performances"}}, {"@id": "_:ndf9bd4c30d914bfd830e6bee899e1443b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Performance: nonfiction work documenting a performance, event, or concert of dance, music, opera, operetta, theatrical stage productions, magic, circus, stand-up comedy, burlesque, or other vaudeville or variety stage acts. Although the work being performed may be fictional, as with a stage play, the intent of the work in hand is documentation of that performance rather than a fictional narrative about it. Note: If applicable, use the form Performance in conjunction with the appropriate genre(s) and other form(s), such as Television special)"}, "madsrdf:citationSource": "Moving image genre-form guide online, Jan. 7, 2008:", "madsrdf:citationStatus": "found"}, {"@id": "_:ndf9bd4c30d914bfd830e6bee899e1443b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf9bd4c30d914bfd830e6bee899e1443b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Performances, Filmed"}}, {"@id": "_:ndf9bd4c30d914bfd830e6bee899e1443b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Performances, Filmed"}}, {"@id": "_:ndf9bd4c30d914bfd830e6bee899e1443b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ndf9bd4c30d914bfd830e6bee899e1443b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Performance films"}}, {"@id": "_:ndf9bd4c30d914bfd830e6bee899e1443b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Performance films"}}], "@id": "/authorities/genreForms/gf2011026276"}
