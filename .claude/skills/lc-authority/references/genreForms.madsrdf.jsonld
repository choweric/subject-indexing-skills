lists"}}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b42", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Essential medicines lists"}}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b44", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb8ad7e52a3734883855ada85fa990d72b45"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Drug formularies"}}, {"@id": "_:nb8ad7e52a3734883855ada85fa990d72b45", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Drug formularies"}}], "@id": "/authorities/genreForms/gf2017026068"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026070", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGeorgics", "identifiers:lccn": "gf2017026070", "madsrdf:adminMetadata": [{"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b1"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Georgics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026289"}, "madsrdf:hasSource": [{"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b5"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b6"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b7"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b8"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b9"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b10"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b11"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b12"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b13"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b14"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-07-13T14:02:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Georgics"}}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Georgic. A type of poetry that takes its name from Virgil's Georgics; didactic; distinctive genre established during the 18th century; georgic verse maintained a foothold in 19th- and early 20th-century America; in practice the pastoral and georgic genres overlapped; the attention of georgic falls on the necessity of skill and effort to counteract the wayward tendencies of nature and civilization alike)"}, "madsrdf:citationSource": "The Princeton encyclopedia of poetry and poetics, c2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(georgic: A poem or book dealing with agriculture or rural topics)"}, "madsrdf:citationSource": "Oxford English dictionaries website, Apr. 21, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Boyd, C. A georgic of modern husbandry, 1809.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(georgic: a poem dealing with agriculture)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Apr. 21, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(georgic: A didactic poem giving instruction on farming, husbandry, or some comparable pursuit, often involving praise of rural life; georgic is distinguished from the pastoral in that it regards nature in terms of necessary labour, not of harmonious idleness)"}, "madsrdf:citationSource": "Baldick, C. The Oxford dictionary of literary terms, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Georgic: A poem or book dealing with agriculture or rural topics, which commonly glorifies outdoor labor and simple country life. Often takes the form of a didactic or instructive poem intended to give instructions related to a skill or art. The Roman poet Virgil famously wrote a collection of poems entitled Georgics, which has influenced poets since)"}, "madsrdf:citationSource": "Poetry Foundation glossary, via WWW, Apr. 21, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Georgic: poetry in which the rural life is praised. The Georgics of Virgil discuss animal husbandry, weather forecasting, and other skills, so that the term has come to connote a didactic poetry concerning agrarian ways; the didactic element in the georgic form distinguishes it from the pastoral poem, which is not necessarily instructional)"}, "madsrdf:citationSource": "Myers, J. Dictionary of poetic terms, c2003", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Georgic: A poem ostensibly about farming and the practical aspects of rustic life; so called from Virgil's Georgics)"}, "madsrdf:citationSource": "Harmon, W. A handbook to literature, c2009", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b13", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Lanier, P. Appalachian georgics, \u00a91983.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b14", "@type": "madsrdf:Source", "madsrdf:citationSource": "49003107: Coffin, R.P.T. One-horse farm : Down-East georgics, 1949.", "madsrdf:citationStatus": "found"}, {"@id": "_:n8e93fe260cd24547a86cdc8e75f5dba4b15", "@type": "madsrdf:Source", "madsrdf:citationSource": "Virgil. Georgica. English (Fallon). Georgics, 2006.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026070"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026071", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aCarol texts", "identifiers:lccn": "gf2017026071", "madsrdf:adminMetadata": [{"@id": "_:n4df35136ee06448887e5961240b7933cb1"}, {"@id": "_:n4df35136ee06448887e5961240b7933cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Carol texts"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4df35136ee06448887e5961240b7933cb3"}]}, "madsrdf:exampleNote": "Note under [Carols]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026005"}, "madsrdf:hasSource": [{"@id": "_:n4df35136ee06448887e5961240b7933cb5"}, {"@id": "_:n4df35136ee06448887e5961240b7933cb6"}, {"@id": "_:n4df35136ee06448887e5961240b7933cb7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n4df35136ee06448887e5961240b7933cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-07-13T14:02:29"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n4df35136ee06448887e5961240b7933cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-04-28T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n4df35136ee06448887e5961240b7933cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Carol texts"}}, {"@id": "_:n4df35136ee06448887e5961240b7933cb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Christmas in poetry : carols and poems. First series, 1922.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4df35136ee06448887e5961240b7933cb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Christmas in poetry : carols and poems. Second series, 1923.", "madsrdf:citationStatus": "found"}, {"@id": "_:n4df35136ee06448887e5961240b7933cb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "The animals' Christmas : poems, carols, and stories, \u00a91944.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2017026071"}
