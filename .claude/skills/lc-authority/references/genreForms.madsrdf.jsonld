": "_:nf032d84d4f4c49d98d442e266632b672b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nf032d84d4f4c49d98d442e266632b672b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Thrillers (Radio programs)"}}, {"@id": "_:nf032d84d4f4c49d98d442e266632b672b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Suspense radio programs; UF Thrillers)"}, "madsrdf:citationSource": "GSAFD via WWW, May 23, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nf032d84d4f4c49d98d442e266632b672b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Thrillers: use Crime or mystery programs: Programs which focus on the commission and investigation of crime, or revolve around the solution of a mystery; UF Detective programs, Gangster programs, Murder mysteries, Police programs, Prison programs, Spy programs, Suspense programs, Thrillers, True crime programs. Examples: Alias Jimmy Valentine, Adventures of Ellery Queen, Mr. District Attorney, Big town)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, May 23, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nf032d84d4f4c49d98d442e266632b672b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf032d84d4f4c49d98d442e266632b672b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Suspense thrillers (Radio programs)"}}, {"@id": "_:nf032d84d4f4c49d98d442e266632b672b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Suspense thrillers (Radio programs)"}}, {"@id": "_:nf032d84d4f4c49d98d442e266632b672b10", "@type": ["madsrdf:GenreForm", "madsrdf:Vari