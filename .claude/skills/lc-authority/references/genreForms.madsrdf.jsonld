: "_:nbcf963ef2e6c4fbf83d13018a3618262b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Textured books"}}, {"@id": "_:nbcf963ef2e6c4fbf83d13018a3618262b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(under Interactive children's book: Touch and Feel books. Many interactive books are made specifically for children. Touch-and-feel books, or texturized books, fall in this area. The prime age for touch and feel books is from toddler-preschool. One of the key advantages to teaching senses and vocabulary through the use of touch and feel books is the connection a child can gain by instantly being rewarded with the texture which the word describes. In recent years, touch-and-feel books have gone to a new level with the creation of fun new ways for younger children to interact with books such as musical \"bath books\" and \"finger puppet books\". Most, but not all, of these books are also \"board books\" which are made entirely out of hard pages.)"}, "madsrdf:citationSource": "Wikipedia, Aug. 8, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nbcf963ef2e6c4fbf83d13018a3618262b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Textured books. UF Feel-and-touch books; Texture books; Texturized books; Touch-and-feel books. BT Toy and movable books)"}, "madsrdf:citationSource": "LCSH", "madsrdf:citationStatus": "found"}, {"@id": "_:nbcf963ef2e6c4fbf83d13018a3618262b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbcf963ef2e6c4fbf83d13018a3618262b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Texturized books"}}, {"@id": "_:nbcf963ef2e6c4fbf83d13018a3618262b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Texturized books"}}, {"@id": "_:nbcf963ef2e6c4fbf83d13018a3618262b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:element