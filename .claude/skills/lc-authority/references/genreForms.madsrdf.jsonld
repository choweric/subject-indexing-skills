{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026940", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMinuets (Music)", "identifiers:lccn": "gf2014026940", "madsrdf:adminMetadata": [{"@id": "_:n553a2c82c74f4182975f1b9a80fa281fb1"}, {"@id": "_:n553a2c82c74f4182975f1b9a80fa281fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Minuets (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n553a2c82c74f4182975f1b9a80fa281fb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, "madsrdf:hasSource": {"@id": "_:n553a2c82c74f4182975f1b9a80fa281fb5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n553a2c82c74f4182975f1b9a80fa281fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n553a2c82c74f4182975f1b9a80fa281fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n553a2c82c74f4182975f1b9a80fa281fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Minuets (Music)"}}, {"@id": "_:n553a2c82c74f4182975f1b9a80fa281fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Minuet. An elegant dance movement in triple meter (usually 3 /4) of enormous popularity ca. 1650-1800. It is usually in binary form, with very regular phrases constructed of four-measure units, beginning without upbeat and cadencing on the strong beat.)"}, "madsrdf:citationSource": "Harvard dictionary of music, 4th ed.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026940"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026941", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMissals (Service books)", "identifiers:lccn": "gf2014026941", "madsrdf:adminMetadata": [{"@id": "_:n8993178ebca84685a5c8b3290008f0b9b1"}, {"@id": "_:n8993178ebca84685a5c8b3290008f0b9b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Missals (Service books)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n8993178ebca84685a5c8b3290008f0b9b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027085"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026926"}, "madsrdf:hasSource": {"@id": "_:n8993178ebca84685a5c8b3290008f0b9b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n8993178ebca84685a5c8b3290008f0b9b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n8993178ebca84685a5c8b3290008f0b9b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8993178ebca84685a5c8b3290008f0b9b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Missals (Service books)"}}, {"@id": "_:n8993178ebca84685a5c8b3290008f0b9b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A liturgical book of the Western Church containing all the material necessary for the celebration of Mass....In the 11th and 12th centuries complete missals with neumatic notation proliferated: about 50 from the 11th century and about 40 from the 12th are known, almost all of west European origin. In the 13th century missals with neumes decreased in favour of missals with music on lines, which flourished until the end of the 14th century. ... In 15th-century missals very little music was noted: the liturgical recitatives belonging to the celebrant (Preface, Pater noster) and the intonations of the Ordinary (Gloria in excelsis Deo, Credo in unum Deum); and sometimes also the Ite missa est, sung by the deacon. These pieces were reproduced from 1476 onwards in the first printed missals with music...)"}, "madsrdf:citationSource": "Grove music online, viewed August 28, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026941"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026942", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMission music", "identifiers:lccn": "gf2014026942", "madsrdf:adminMetadata": [{"@id": "_:n92e763edfdcb4ebe9b467007c38099d2b1"}, {"@id": "_:n92e763edfdcb4ebe9b467007c38099d2b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Mission music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n92e763edfdcb4ebe9b467007c38099d2b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026821"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027062"}], "madsrdf:hasSource": {"@id": "_:n92e763edfdcb4ebe9b467007c38099d2b5"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n92e763edfdcb4ebe9b467007c38099d2b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n92e763edfdcb4ebe9b467007c38099d2b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:56"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n92e763edfdcb4ebe9b467007c38099d2b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Mission music"}}, {"@id": "_:n92e763edfdcb4ebe9b467007c38099d2b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "New Grove dict. of mus. online, Jan. 31, 2003: California mission music; under Jesuits (The musical tradition that developed in a large number of mission countries was, in fact, so successful that it is now possible to identify \"mission music\" as a genre distinct from the cathedral music that existed in those countries.)", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026942"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026943", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aModern dance music", "identifiers:lccn": "gf2014026943", "madsrdf:adminMetadata": [{"@id": "_:n5365b9e43f924d858bafa36b12177837b1"}, {"@id": "_:n5365b9e43f924d858bafa36b12177837b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Modern dance music"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5365b9e43f924d858bafa36b12177837b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026775"}], "madsrdf:hasSource": [{"@id": "_:n5365b9e43f924d858bafa36b12177837b5"}, {"@id": "_:n5365b9e43f924d858bafa36b12177837b6"}, {"@id": "_:n5365b9e43f924d858bafa36b12177837b7"}], "madsrdf:hasVariant": {"@id": "_:n5365b9e43f924d858bafa36b12177837b8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Musical compositions composed for theatrical dances that display the characteristics of modern dance."}, {"@id": "_:n5365b9e43f924d858bafa36b12177837b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-14T10:34:37"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5365b9e43f924d858bafa36b12177837b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5365b9e43f924d858bafa36b12177837b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Modern dance music"}}, {"@id": "_:n5365b9e43f924d858bafa36b12177837b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a form of contemporary, theatrical and concert dance employing a special technique for developing the use of the entire body in movements expressive of abstract ideas)"}, "madsrdf:citationSource": "Random House", "madsrdf:citationStatus": "found"}, {"@id": "_:n5365b9e43f924d858bafa36b12177837b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Modern dance (a style of theatrical dance that rejects the limitations of classical ballet and favors music deriving from the expression of inner feeling)"}, "madsrdf:citationSource": "Amer. Herit.:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5365b9e43f924d858bafa36b12177837b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Modern dance (a free, unrestricted style of theatrical dancing that developed in the early 20th century as a reaction against the conventions of ballet)"}, "madsrdf:citationSource": "Encarta:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5365b9e43f924d858bafa36b12177837b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5365b9e43f924d858bafa36b12177837b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Music for modern dance"}}, {"@id": "_:n5365b9e43f924d858bafa36b12177837b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Music for modern dance"}}], "@id": "/authorities/genreForms/gf2014026943"}
