zations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nc70670f2f1e740f58a43c9da7852816cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Road maps"}}, {"@id": "_:nc70670f2f1e740f58a43c9da7852816cb5", "@type": "madsrdf:Source", "madsrdf:citationSource": "G.M. Johnson & Associates Ltd. City street map, Billings, Bozeman, south central Montana, c2008.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc70670f2f1e740f58a43c9da7852816cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(road map: 1. a map showing roads especially for automobile travel)"}, "madsrdf:citationSource": "Merriam-Webster online dictionary, Jan. 9, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc70670f2f1e740f58a43c9da7852816cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(roadmap:  see road map)"}, "madsrdf:citationSource": "Dictionary.com WWW site, Jan. 9, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc70670f2f1e740f58a43c9da7852816cb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "road map (a map, usually at medium or small scale, showing the roads in a region)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc70670f2f1e740f58a43c9da7852816cb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(road map: a medium-or small-scale special-purpose map, generally showing only planimetric detail, with emphasis upon the road network and related data.  Its main purpose is to furnish pertinent road information for tactical and administrative troop movement)"}, "madsrdf:citationSource": "Glossary of mapping, charting, and geodetic terms, 1973:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc70670f2f1e740f58a43c9da7852816cb10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc7