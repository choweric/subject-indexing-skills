: "new"}, {"@id": "_:n1383473c86c8462d8a9332d0dc1156dcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poetry readings (Sound recordings)"}}, {"@id": "_:n1383473c86c8462d8a9332d0dc1156dcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 1 (Summary: Myth of the motherland is a new documentary film and spoken word poetry initiative which follows young writers/poets as they embark on a creative writing journey through diverse African countries to meet with African scholars, writers, artists and others to address myths and biases about the Mother Continent. This is a spoken word compilation made to support the film)"}, "madsrdf:citationSource": "Work cat.: Myth of the motherland [SR] c2007- :", "madsrdf:citationStatus": "found"}, {"@id": "_:n1383473c86c8462d8a9332d0dc1156dcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(read in the restored historical pronunciation of Classical Latin by Stephen G. Daitz)"}, "madsrdf:citationSource": "A recital of classical Latin oratory and poetry, 2009?", "madsrdf:citationStatus": "found"}, {"@id": "_:n1383473c86c8462d8a9332d0dc1156dcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Poetry recital held at the Texas Union, University of Texas at Austin, April 29, 1980)"}, "madsrdf:citationSource": "Ra\u00falrsalinas. Ra\u00fal Salinas poetry recital, 1980", "madsrdf:citationStatus": "found"}, {"@id": "_:n1383473c86c8462d8a9332d0dc1156dcb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(read in English translation and then in the restored historical pronunciation of ancient Greek by Stephen G. Daitz)"}, "madsrdf:citationSource": "A recital of ancient Greek poetry : selections from the Iliad, the Odyssey, lyric poetry, and drama, 2009?", "madsrdf:citationStatus": "found"}, {"@id": "_:n1383473c86c8462d8a9332d0dc1156dcb9", "@type": ["madsrdf: