: "new"}, {"@id": "_:n6fac7d53e12e4dc6b8c0648c8bcf3198b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "School songs"}}, {"@id": "_:n6fac7d53e12e4dc6b8c0648c8bcf3198b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat: 21st century Colgate song book, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:n6fac7d53e12e4dc6b8c0648c8bcf3198b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(School songs; the patronal song of a school; a traditional particularly strong in England's public schools and grammar schools)"}, "madsrdf:citationSource": "Wikipedia, September 12, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:n6fac7d53e12e4dc6b8c0648c8bcf3198b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "rear cover (Fight songs, alma maters and other school songs)"}, "madsrdf:citationSource": "O'Brien, R.F. School songs of America's colleges and universities, 1991:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6fac7d53e12e4dc6b8c0648c8bcf3198b8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6fac7d53e12e4dc6b8c0648c8bcf3198b9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "College songs"}}, {"@id": "_:n6fac7d53e12e4dc6b8c0648c8bcf3198b9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "College songs"}}], "@id": "/authorities/genreForms/gf2017026105"}
