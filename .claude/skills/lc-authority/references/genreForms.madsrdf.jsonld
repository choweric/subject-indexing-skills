58"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc0d2d4bb609e48d89392764d02cc2d11b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rhythm and blues music"}}, {"@id": "_:nc0d2d4bb609e48d89392764d02cc2d11b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(R&B: Evolving out of jump blues in the late 40's, R&B laid the groundwork for rock & roll)"}, "madsrdf:citationSource": "All music guide website, Oct. 13, 2000", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0d2d4bb609e48d89392764d02cc2d11b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(style of popular music performed principally by Blacks from the late 1940s to the early 1960s; grew out of the blues and blues-related styles, particularly those of the Mississippi delta; unlike traditional blues, which is generally performed by soloists, rhythm-and-blues is performed by an ensemble)"}, "madsrdf:citationSource": "New Grove dict. of Am. mus.:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc0d2d4bb609e48d89392764d02cc2d11b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc0d2d4bb609e48d89392764d02cc2d11b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "R&B (Music)"}}, {"@id": "_:nc0d2d4bb609e48d89392764d02cc2d11b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "R&B (Music)"}}, {"@id": "_:nc0d2d4bb609e48d89392764d02cc2d11b10", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc0d2d4bb609e48d89392764d02cc2d11b11"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "R & B (Music)"}}, {"@id": "_:nc0d2d4bb609e48d89392764d02cc2d11b11", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "R & B (Music)"}}, {"@id": "_:nc0