": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-01-24T10:11:17"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sound recordings"}}, {"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Interviews (Sound recordings)"}}, {"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Interviews (Sound recordings)"}}, {"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Sound recordings)"}, "madsrdf:citationSource": "LCSH, Dec. 31, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Recordings, Sound"}}, {"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Recordings, Sound"}}, {"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Interviews (Sound recordings)"}}, {"@id": "_:nceda9a15871f46f9a486d7f798b22d4eb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Interviews (Sound recordings)"}}], "@id": "/authorities/genreForms/gf2011026594"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026595", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpaghetti Westerns", "identifiers:lccn": "gf2011026595", "madsrdf:adminMetadata": [{"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb1"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Spaghetti Westerns"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026735"}, "madsrdf:hasSource": [{"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb5"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb6"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb7"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb8"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb9"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb10"}], "madsrdf:hasVariant": [{"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb11"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb14"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb17"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb20"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb23"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Western films usually produced or co-produced by Italian companies and filmed in Europe.", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025267"}}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-02T15:09:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spaghetti Westerns"}}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the majority of Italian Westerns are coproductions filmed in Spain with one or more countries as copartners in the production ... coproducing countries are mainly Spain, Germany and France)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(spaghetti Western: A Western produced primarily in Italy, though sometimes also filmed in Yugoslavia or Spain, and often starring American performers. This type of film received great impetus from the works directed by Sergio Leone, especially his films starring Clint Eastwood ...)"}, "madsrdf:citationSource": "Konigsberg, I. The complete film dict., 1997", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(between 1960 and 1975 European film production companies made nearly 600 westerns; most financed by Italian film companies; now term Spaghetti Western is applied to any Western made and financed by continental filmmakers)"}, "madsrdf:citationSource": "Nudge, J. Spaghetti westerns, 1998 via WWW, Aug. 30, 2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(spaghetti Western: Nickname for a Western film; it is typically set in the southwestern part of North America during the late 1880s, but it actually is produced and filmed in Italy or its nearby countries (e.g., Spain or Yugoslavia))"}, "madsrdf:citationSource": "Singleton, R.S. Filmmaker's dict., c2000", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "v. 9, p. 173 (Italian \"spaghetti Westerns\") p. 177 (\"demystifying strain injected into the [Western] genre during the sixties by the Italian 'spaghetti Westerns'\")"}, "madsrdf:citationSource": "History of the American cinema, c1990 :", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Spaghetti Western, also known as Italo-Western, is a nickname for a broad sub-genre of Western films that emerged in the mid-1960s in the wake of Sergio Leone's unique and much copied film-making style and international box-office success, so named by American critics because most were produced and directed by Italians. The term for these films in Italy is western all'italiana (Italian-Style Western); British critics tended to use the label Continental Western to describe these films, and the phrase 'Spaghetti Western' according to actor Aldo Sambrell was originally created by Italian journalist Alfonso Sancha as a derogatory name for this group of films, but has over time become accepted by fans of the films. The language in which the movies were originally released was Italian as well, but as most of the films featured multilingual casts and sound was invariably post-synched, most Westerns all'Italiana do not have an official dominant language. As many of these films were shot in Spain they were also called paella westerns.)"}, "madsrdf:citationSource": "Wikipedia, May 11, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Continental Westerns"}}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Continental Westerns"}}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Italo-Westerns"}}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Italo-Westerns"}}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Eurowesterns"}}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Eurowesterns"}}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Paella Westerns"}}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Paella Westerns"}}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spaghetti Western films"}}, {"@id": "_:n0a605c72bb3348e4ad6278fe7e1ee8ffb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spaghetti Western films"}}], "@id": "/authorities/genreForms/gf2011026595"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026596", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpecial events radio coverage", "identifiers:lccn": "gf2011026596", "madsrdf:adminMetadata": [{"@id": "_:n08a625a4b98547cf935058ef18236a53b1"}, {"@id": "_:n08a625a4b98547cf935058ef18236a53b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Special events radio coverage"}, "madsrdf:elementList": {"@list": [{"@id": "_:n08a625a4b98547cf935058ef18236a53b3"}]}, "madsrdf:exampleNote": "Notes under [Radio news programs; Radio field reports]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026424"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": {"@id": "_:n08a625a4b98547cf935058ef18236a53b5"}, "madsrdf:hasVariant": {"@id": "_:n08a625a4b98547cf935058ef18236a53b6"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Radio reports of noteworthy events, often featuring several commentators and combining studio reports with on-the-scene coverage. For radio programs that feature commentators in the studio reporting on current events and noteworthy issues see [Radio news programs.] For radio reportorial pieces recorded on location see [Radio field reports.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025573"}}, {"@id": "_:n08a625a4b98547cf935058ef18236a53b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:26:59"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n08a625a4b98547cf935058ef18236a53b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n08a625a4b98547cf935058ef18236a53b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Special events radio coverage"}}, {"@id": "_:n08a625a4b98547cf935058ef18236a53b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Special events coverage: Nonfictional reports of noteworthy events; often feature several commentators; usually combine studio reports with on-the-scene coverage; often combine field reports, actualities, news and commentary. RT Field reports, News. Examples: Goldwater statement; Presidential election coverage; Gemini coverage; Pope's visit)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Nov. 14, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n08a625a4b98547cf935058ef18236a53b6", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n08a625a4b98547cf935058ef18236a53b7"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Radio coverage, Special events"}}, {"@id": "_:n08a625a4b98547cf935058ef18236a53b7", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Radio coverage, Special events"}}], "@id": "/authorities/genreForms/gf2011026596"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026597", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSpecial events television coverage", "identifiers:lccn": "gf2011026597", "madsrdf:adminMetadata": [{"@id": "_:n24a73a605e624d7ea4454cda48496ac7b1"}, {"@id": "_:n24a73a605e624d7ea4454cda48496ac7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Special events television coverage"}, "madsrdf:elementList": {"@list": [{"@id": "_:n24a73a605e624d7ea4454cda48496ac7b3"}]}, "madsrdf:exampleNote": "Note under [Television news programs]", "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026425"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026089"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026113"}], "madsrdf:hasSource": [{"@id": "_:n24a73a605e624d7ea4454cda48496ac7b5"}, {"@id": "_:n24a73a605e624d7ea4454cda48496ac7b6"}], "madsrdf:hasVariant": {"@id": "_:n24a73a605e624d7ea4454cda48496ac7b7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Television programs that record live, on-the-scene coverage of special events. For television programs that report and comment on recent events see [Television news programs.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025657"}}, {"@id": "_:n24a73a605e624d7ea4454cda48496ac7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n24a73a605e624d7ea4454cda48496ac7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2016-02-17T10:28:10"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n24a73a605e624d7ea4454cda48496ac7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Special events television coverage"}}, {"@id": "_:n24a73a605e624d7ea4454cda48496ac7b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Decision '80--The Democratic National Convention, 1980-08-11, 1980.", "madsrdf:citationStatus": "found"}, {"@id": "_:n24a73a605e624d7ea4454cda48496ac7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 91 (Special event coverage and commentary: use for nonfiction film or video used to record liv, on-the-scene coverage of special events outside the confines of a regualr news film or programs. Examples would be extensive coverage of political conventions, moonshots, assassinations, etc.)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n24a73a605e624d7ea4454cda48496ac7b7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n24a73a605e624d7ea4454cda48496ac7b8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Special events (Television programs)"}}, {"@id": "_:n24a73a605e624d7ea4454cda48496ac7b8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Special events (Television programs)"}}], "@id": "/authorities/genreForms/gf2011026597"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026598", "@type": ["madsrdf:DeprecatedAuthority", "madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:adminMetadata": [{"@id": "_:n4097936753c74faab7df6987e3650c68b1"}, {"@id": "_:n4097936753c74faab7df6987e3650c68b2"}], "madsrdf:deletionNote": {"@language": "en", "@value": "This authority record has been deleted because the term is covered by the genre/form term Superhero films {(gf2011026621).}"}, "madsrdf:elementList": {"@list": [{"@id": "_:n4097936753c74faab7df6987e3650c68b3"}]}, "madsrdf:useInstead": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026621"}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spider-Man films"}}, {"@id": "_:n4097936753c74faab7df6987e3650c68b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n4097936753c74faab7df6987e3650c68b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2012-03-12T12:34:44"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "deprecated"}, {"@id": "_:n4097936753c74faab7df6987e3650c68b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spider-Man films"}}], "@id": "/authorities/genreForms/gf2011026598"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026599", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSponsored films", "identifiers:lccn": "gf2011026599", "madsrdf:adminMetadata": [{"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db1"}, {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Sponsored films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db3"}]}, "madsrdf:exampleNote": "Note under [Promotional films]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasReciprocalAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026470"}, "madsrdf:hasSource": [{"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db5"}, {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db6"}, {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db7"}], "madsrdf:hasVariant": {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db8"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films produced, subsidized, financed, or otherwise significantly supported by a business, government body, organization, etc. For films that promote or advertise a product, industry, service, organization, etc. see [Promotional films.]", "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025061"}}, {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-01T10:09:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sponsored films"}}, {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Sponsored. Nonfiction or fiction work, typically ten minutes or longer in length, produced by, financed, or otherwise significantly supported by a business, government body, professional organization, or nonprofit association, with the intent to promote the sponsoring entity. Sponsored work may be educational, industrial, propagandistic, or, less commonly, instructional in nature. Although largely distributed by video today, sponsored work covering a wide variety of subjects and presenting differing levels of self-promotion or propaganda have historically been shown theatrically and at expositions, rented to schools and community organizations, and broadcast as economical \"filler\" programming for network and cable television. Note: Not necessary to also use Documentary, since that is implied by the term Sponsored. Use Company promotion for commercial-length sponsored work that promote the sponsoring entity or industry.)"}, "madsrdf:citationSource": "Taves, B. The moving image genre-form guide, via WWW, Mar. 27, 2002", "madsrdf:citationStatus": "found"}, {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 99-101 (Under main category Factual Film: Advertising Film (Sales Film). Advertising films, publicity films, promotional films, commercials (including television commercials), public relations films, and, to a certain extent, sponsoring films, all seek to predispose the viewer towards the firm, sponsoring body, or product the films are promoting; Sponsored Film. A sponsored film may be any type of film--advertising film, travelogue, documentary. Sponsored means only that the film in question has been subsidized, budgeted or financed by some industry (e.g., Shell International), professional organization, local charity, or government. They are sometimes seen commercially.)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Yee, M.M. Moving image materials : genre terms, 1988", "madsrdf:citationStatus": "notfound"}, {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sponsoring films"}}, {"@id": "_:nf0ada0c90aec4601960d9e71bb4c5a1db9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sponsoring films"}}], "@id": "/authorities/genreForms/gf2011026599"}
