rdStatus": "new"}, {"@id": "_:na8c34399739446aaacc870a12f93bb62b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Snuff films"}}, {"@id": "_:na8c34399739446aaacc870a12f93bb62b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(snuff: designating or of a kind of pornographic film that shows someone being murdered as the climax of sexual activity)"}, "madsrdf:citationSource": "Web. 3", "madsrdf:citationStatus": "found"}, {"@id": "_:na8c34399739446aaacc870a12f93bb62b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Moving image materials: genre terms, 1988", "madsrdf:citationStatus": "notfound"}, {"@id": "_:na8c34399739446aaacc870a12f93bb62b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(snuff film: a pornographic film that shows an actual murder of one of the performers, as at the end of a sadistic act)"}, "madsrdf:citationSource": "Random House", "madsrdf:citationStatus": "found"}, {"@id": "_:na8c34399739446aaacc870a12f93bb62b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Gods of death : around the world, behind closed doors, operates an ultra-secret business of sex and death : one man hunts the truth about snuff films, c1997.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026585"}
