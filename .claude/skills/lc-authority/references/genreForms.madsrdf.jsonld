ral"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Works whose main purpose is to record and convey factual information."}, {"@id": "_:n8762c569c6f84a3eb743e4675fdef383b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n8762c569c6f84a3eb743e4675fdef383b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-07T16:26:50"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n8762c569c6f84a3eb743e4675fdef383b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Informational works"}}, {"@id": "_:n8762c569c6f84a3eb743e4675fdef383b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(information. Data, ideas, and imaginative works that have been communicated, recorded, published and/or distributed formally or informally in any format.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, Aug. 5, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n8762c569c6f84a3eb743e4675fdef383b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 49 (information: item of news; account; (law) formal written statement)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n8762c569c6f84a3eb743e4675fdef383b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(information: Data presented in readily comprehensible form to which meaning has been attributed within the context of its use. In a more dynamic sense, the message conveyed by the use of a medium of communication or expression. Whether a specific message is informative or not depends in part on the subjective perception of the person receiving it. More concretely, all the facts, conclusions, ideas, and creative works of the human intellect and imagination that have been communicated, formally or informally, in any form.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, Aug. 5, 2014", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026113"}
