ntSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Latin trap (Music)"}}, {"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(album contains Latin trap music)"}, "madsrdf:citationSource": "Work cat.: Trap capos. Season 1, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (Latin trap [a Latin trap song])"}, "madsrdf:citationSource": "Jon Z. Jontrapvolta, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trapeton Festival; mixture of trap and reggaeton; musicians include Daddy Yankee and Karol G)"}, "madsrdf:citationSource": "Samsung Hall website, viewed August 30, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Latin trap; originated in Puerto Rico; mixture of trap and reggaeton)"}, "madsrdf:citationSource": "Inside Latin trap, the viral sound too hot for American radio, via Rolling Stone website, Nov. 7, 2017, viewed Aug. 30, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Latin trap; Spanish trap; influenced by Southern hip-hop; \"trap\" relates to places where drug deals take place; like original trap, Latin trap is mostly about \"la calle\" (the streets))"}, "madsrdf:citationSource": "Latin trap brings new music to Miami, via Miami new times website, August 23, 2017, viewed Aug. 30, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Trapeton; official page of Latin trap)"}, "madsrdf:citationSource": "Trapeton website, viewed August 30, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trapeton (Music)"}}, {"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trapeton (Music)"}}, {"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spanish trap (Music)"}}, {"@id": "_:nb2ee51b0bd504fcfa1b80d80bb23f184b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spanish trap (Music)"}}], "@id": "/authorities/genreForms/gf2018026121"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026122", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aReggaeton", "identifiers:lccn": "gf2018026122", "madsrdf:adminMetadata": [{"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b1"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Reggaeton"}, "madsrdf:elementList": {"@list": [{"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026754"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027037"}], "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026121"}, "madsrdf:hasSource": [{"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b5"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b6"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b7"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b8"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b9"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b10"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b11"}], "madsrdf:hasVariant": [{"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b12"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-09-19T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/mel"}, "ri:recordStatus": "new"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:23:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reggaeton"}}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. x (reggaet\u00f3n is in Spanish) p. xi (reguet\u00f3n) p. 1 (Draws on reggae, hip-hop, and a number of Spanish Caribbean styles; often accompanied by sexually explicit lyrics and a provocative dancing style known as perreo (doggy style); emerged from Puerto Rico in the late 1990s) p. 3 (spelling of reggaeton takes a number of forms: reggaeton, reggaet\u00f3n, reguet\u00f3n, regeton; seems most appropriate to spell it without the accent) p. 5 (was born in a hip-hop environment, with a little bit of Jamaican dancehall and Puerto Rico's own tropical flavor and ritmo) p. 6 (hip-hop is most easily distinguished from reggaeton in its embrace of the downbeat and the backbeat, emphasizing duple divisions of the meter rather than the 3:2 cross-rhythms that mark reggaeton and other Caribbean genres) p. 7 (dancehall's prevailing rhythmic pattern from the late '80s and early '90s has served as reggaeton's backbone--the boom-ch-boom-chick that now resounds from cars and clubs worldwide; reggaeton is neither hip-hop nor dancehall nor Latin nor tropical in the traditional sense, yet it draws from all of these) p. 4 of cover (A hybrid of reggae and rap, reggaeton is a music with Spanish-language lyrics and Caribbean aesthetics)"}, "madsrdf:citationSource": "2008048053: Reggaeton, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Reggaeton: Although some dispute the national character of the genre, reggaeton is most frequently represented as a Puerto Rican and, increasingly, pan-Latino fusion of hip-hop and dancehall reggae. Featuring lyrics in Spanish and propelled by a modified reggae rhythm referred to as the \"dembow,\" the genre also travels in the form of a suggestive, sexualized dance called \"perreo\")"}, "madsrdf:citationSource": "Grove music online, Sept. 19, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "2007590044: Reggaet\u00f3n mega hits, \u21172005.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(reggaeton: A form of dance music of Puerto Rican origin, characterized by a fusion of Latin rhythms, dancehall, and hip-hop or rap)"}, "madsrdf:citationSource": "Oxford English dictionaries website, Sept. 19, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Reggaet\u00f3n. UF Reguet\u00f3n. BT Rap (Music)--Puerto Rico; Reggae music--Puerto Rico)"}, "madsrdf:citationSource": "LCSH, Sept. 19, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (reggaet\u00f3n) p. 14 (a Spanish-language hybrid of dancehall reggae and U.S. rap, with roots in Panama and Jamaica but produced primarily in Puerto Rico) p. 8 (By reggaeton we refer to a relatively new genre strongly marked both by a particular approach to musical style (e.g., dancehall's boom-ch-boom-chick as reshaped by urban Puerto Rican sensibilities and informed by a fusion with hip-hop) and a relation to the market (i.e., explicitly commercial, courting a wide audience))"}, "madsrdf:citationSource": "2010041681: Baker, G. Buena Vista in the club, 2011:", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b11", "@type": "madsrdf:Source", "madsrdf:citationSource": "2011618816: Reggaeton super hits, \u21172004.", "madsrdf:citationStatus": "found"}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Reguet\u00f3n"}}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Reguet\u00f3n"}}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Regeton"}}, {"@id": "_:nbb20a5125ade40ce8e5eaee6dc7f0ca7b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Regeton"}}], "@id": "/authorities/genreForms/gf2018026122"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026126", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aLinked stories", "identifiers:lccn": "gf2018026126", "madsrdf:adminMetadata": [{"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb1"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Linked stories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026542"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2015026020"}], "madsrdf:hasSource": [{"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb5"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb6"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb7"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb8"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb9"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb10"}], "madsrdf:hasVariant": [{"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb11"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb14"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb17"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb20"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb23"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb26"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb29"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Collections of stand-alone short stories that interrelate and create a larger whole."}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:23:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-09-21T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Linked stories"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(the form we refer to as \"linked\" stories; sometimes called \"story cycles\")"}, "madsrdf:citationSource": "Chung, S. The long and the short of it : linked story collections bridging the divide, via The millions website, posted Jan. 19, 2011, viewed on Sept. 21, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A novel-in-stories is a book-length collection of short stories that are interconnected. (One of the very first examples of this genre is The Canterbury Tales; a more recent example is The Girl's Guide to Hunting and Fishing, by Melissa Bank.) A novel-in-stories overcomes two key challenges for writers: the challenge of writing a novel-length work, and the challenge of publishing a book-length work of unrelated short stories; novels-in-stories)"}, "madsrdf:citationSource": "Scott, F. What is a novel-in-stories?, via Writer's digest website, posted Nov. 11, 2008, viewed on Sept. 21, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 4 of cover (Nance Van Winckel is the author of three collections of linked stories)"}, "madsrdf:citationSource": "Work cat.: Van Winckel, Nance. Boneland : linked stories, 2013:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(The collection of linked stories goes by many names, including the short story cycle, short story sequence, composite novel, and novel-in-stories. These collections include stories that are complete in that they can each story can stand alone, but when put together they interrelate and create a larger whole; Collections of linked stories don't necessarily always announce themselves in their titles or on their covers. In fact, sometimes they are clearly labeled as novels or the more vague term \"a fiction\")"}, "madsrdf:citationSource": "What is a collection of linked stories? Is this a relatively new genre?, via Gotham Writers Workshop website, Sept. 21, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Short story cycle (A short story cycle (sometimes referred to as a story sequence or composite novel) is a collection of short stories in which the narratives are specifically composed and arranged with the goal of creating an enhanced or different experience when reading the group as a whole as opposed to its individual parts. Short story cycles are different from novels because the parts that would make up the chapters can all stand alone as a short story, each individually containing a beginning, middle and conclusion.)"}, "madsrdf:citationSource": "Wikipedia, Sept. 21, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(story cycles or collections of linked stories or novels-in-stories; comprised of individual stand-alone short stories, with all the intensity that the form entails, but featuring recurring characters and settings and themes in such a way that the book achieves a kind of aggregate, novelistic force, a collection, in other words, that adds up to something even more potent than the power of its component parts)"}, "madsrdf:citationSource": "Knight, M. The 10 best interlinked short story collections, via Publishers weekly website, posted Mar 03, 2017, viewed on Sept. 21, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Composite novels"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Composite novels"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Short story sequences"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Short story sequences"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Short story cycles"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Short story cycles"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Story cycles"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Story cycles"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb23", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb24"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Novels-in-stories"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb24", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Novels-in-stories"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb26", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb27"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Story sequences"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb27", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Story sequences"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb29", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb30"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Cycles, Short story"}}, {"@id": "_:n1bcedf7d8f194457927c2e9b4b9453bcb30", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Cycles, Short story"}}], "@id": "/authorities/genreForms/gf2018026126"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026127", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMonster fiction", "identifiers:lccn": "gf2018026127", "madsrdf:adminMetadata": [{"@id": "_:n0fcae12669474ee380c09d48147322c5b1"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Monster fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n0fcae12669474ee380c09d48147322c5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2017026143"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026019"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026020"}], "madsrdf:hasSource": [{"@id": "_:n0fcae12669474ee380c09d48147322c5b5"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b6"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b7"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b8"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b9"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b10"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-09-25T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:23:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monster fiction"}}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "front flap (the Nian Monster; with jaws as wide as caverns and teeth sharper than swords, he's intent on devouring all of Shanghai)"}, "madsrdf:citationSource": "Work cat.: Wang, Andrea. The Nian monster, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anthology of stories of monsters from the monster's point of view)"}, "madsrdf:citationSource": "The monster's corner : stories through inhuman eyes, 2011", "madsrdf:citationStatus": "found"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Szanter, Ashley Elizabeth Adele. High Victorian monster fiction and its subversions of taxonomies of deformity, disease, and crime, 2015.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Lanzara, Joseph. Classic monster novels condensed, \u00a92012.", "madsrdf:citationStatus": "found"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a classic monster novel)"}, "madsrdf:citationSource": "Shelley, Mary Wollstonecraft. Frankenstein, or, The modern Prometheus, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n0fcae12669474ee380c09d48147322c5b10", "@type": "madsrdf:Source", "madsrdf:citationSource": "West, David. Ten of the best monster stories, 2015.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026127"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026128", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMonster drama", "identifiers:lccn": "gf2018026128", "madsrdf:adminMetadata": [{"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb1"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Monster drama"}, "madsrdf:elementList": {"@list": [{"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026297"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026058"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026059"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026129"}], "madsrdf:hasSource": [{"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb5"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb6"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb7"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb8"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb9"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb10"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb11"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-09-25T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:23:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monster drama"}}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"A shorter, re-worked version of The house of Frankenstein! in which the Baron tries to counsel and cure a motley crew of monsters he's invited to his castle, immediately regretting his action when the Baroness hits the bottle, his guests reveal their true colours and all hell is let loose!\")"}, "madsrdf:citationSource": "Downing, Martin. Frankenstein's guests : a comedy, \u00a91998", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subj. hdg.: Sea monsters--Drama)"}, "madsrdf:citationSource": "Crafts, William. The sea serpent, or, Gloucester hoax, 1817", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (adapted by Bryony Lavery and adapted by Lisa Evans)"}, "madsrdf:citationSource": "Work cat.: Lavery, Bryony. Bram Stoker's Dracula and Mary Shelley's Frankenstein : two horror plays, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (by Victor Gialanella; adapted from the novel by Mary Shelley)"}, "madsrdf:citationSource": "Gialanella, Victor. Frankenstein, a play in two acts, \u00a91982:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 406 (monster dramas; Buffy the Vampire Slayer was ... clever take on the monster and high-school genres)"}, "madsrdf:citationSource": "Bianculli, David. The platinum age of television, 2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "t.p. (dramatized by Tim Kelly ; from the classic by Mary Shelley)"}, "madsrdf:citationSource": "Kelly, Tim J. Frankenstein: a play in two acts, 1974:", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "O'Neal, Christopher. Frankenstein : the monster play : a full-length drama : based on the novel by Mary Shelley, \u00a91980.", "madsrdf:citationStatus": "found"}, {"@id": "_:n3cc9167faa4f47f6b71d0c3d48e2f0cbb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 152 (monster drama; the monster play is still a popular vehicle in theatre; monster plays by Edward Fitzball and other writers of Blood-and-Thunder horrors; Fitzball's The Black Vulture quickly became a prototype for the monster drama)"}, "madsrdf:citationSource": "Clifton, Larry Stephen. The terrible Fitzball, \u00a91993:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026128"}
