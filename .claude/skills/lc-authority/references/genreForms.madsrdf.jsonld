languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n4f13cc3e60b74e7a8c8e5d95111153c4b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Legal television programs"}}, {"@id": "_:n4f13cc3e60b74e7a8c8e5d95111153c4b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Legal: fictional work in which the capacity of the legal system to find the guilty and acquit the innocent is measured through the interaction of lawyers, prosecutors, clients, witnesses, and judges, largely in a courtroom setting. Used for Courtroom)"}, "madsrdf:citationSource": "Moving image genre-form guide online, December 17, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f13cc3e60b74e7a8c8e5d95111153c4b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 60 (Legal films and programs: use for fictional genre films and programs which focus on the solution of a crime by a lawyer, usually the defense lawyer of the person accused of the crime. UF Courtroom drama, Lawyer drama)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f13cc3e60b74e7a8c8e5d95111153c4b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Law television series)"}, "madsrdf:citationSource": "Google search, December 17, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n4f13cc3e60b74e7a8c8e5d95111153c4b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 169 (Lawyer film (Courtroom drama, Courtroom picture, Legal drama, Trial melodrama): The lawyer...at time leaves his office to carry out investigations and detective work in order to solve a case