{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026812", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aForr\u00f3 (Music)", "identifiers:lccn": "gf2014026812", "madsrdf:adminMetadata": [{"@id": "_:n5cbda6125330458d99a2b26125b2ac68b1"}, {"@id": "_:n5cbda6125330458d99a2b26125b2ac68b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Forr\u00f3 (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5cbda6125330458d99a2b26125b2ac68b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026753"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027009"}], "madsrdf:hasSource": [{"@id": "_:n5cbda6125330458d99a2b26125b2ac68b5"}, {"@id": "_:n5cbda6125330458d99a2b26125b2ac68b6"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n5cbda6125330458d99a2b26125b2ac68b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-10T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/castsmf"}, "ri:recordStatus": "new"}, {"@id": "_:n5cbda6125330458d99a2b26125b2ac68b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-02-13T13:06:53"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5cbda6125330458d99a2b26125b2ac68b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Forr\u00f3 (Music)"}}, {"@id": "_:n5cbda6125330458d99a2b26125b2ac68b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "notes (\"The group Raiz do Sana, formed in 1998, plays forr\u00f3, the most popular of the genres from Brazil's Nordeste, lively and with syncopated rhythms. The music is always centred on the accordion. Traditional forr\u00f3 is played by a trio: accordion, triangle, and drum (zabumba). Its texts are about everyday life, and the joys and sorrows, hopes and misfortunes of the people of Nordeste. In its most modern formula the traditional instruments are joined by the bass, the drum kit, guitars and extra percussion instruments; the texts have a wider diversity of themes, but they are often about love. Forr\u00f3 is the result of a mixture of European, Indian and African elements. The dance of the same name is very athletic. Ten years or so ago forr\u00f3 was adopted by students from the universities of Rio and S\u00e3o Paolo and then it gradually spread throughout the country. Now forr\u00f3 is known and appreciated all over Brazil.\")"}, "madsrdf:citationSource": "Work cat.: Raiz do Sana (Musical group). Forr\u00f3 do Nordeste [SR] p2007:", "madsrdf:citationStatus": "found"}, {"@id": "_:n5cbda6125330458d99a2b26125b2ac68b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Brazil, Popular music, Dance music of the north and north-east (\"Out of the bai\u00e3o developed the forr\u00f3 (originally a variation of the bai\u00e3o) which became the generic north-eastern style of dance music, a sort of lively and faster bai\u00e3o.\")"}, "madsrdf:citationSource": "Grove music online WWW site, May 6, 2008:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026812"}
