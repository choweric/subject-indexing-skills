{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026085", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDiaries", "identifiers:lccn": "gf2014026085", "madsrdf:adminMetadata": [{"@id": "_:n6616eea4ff87443ea895845d027ccc3eb1"}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Diaries"}, "madsrdf:elementList": {"@list": [{"@id": "_:n6616eea4ff87443ea895845d027ccc3eb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026074"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026163"}], "madsrdf:hasSource": [{"@id": "_:n6616eea4ff87443ea895845d027ccc3eb5"}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb6"}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb7"}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb8"}], "madsrdf:hasVariant": [{"@id": "_:n6616eea4ff87443ea895845d027ccc3eb9"}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb12"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Diaries"}}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(diary: A private written record of day-to-day thoughts, feelings, and experiences kept by a person who does not expect them to be published. Also refers to the blankbook or notebook in which such experiences are recorded. Diaries are sometimes published posthumously, and some have become famous literary and historical works. Compare with journal and memoirs. Also refers to a small notebook in which the consecutive dates of the year are listed, with blank space for scheduling appointments, meetings, important deadlines, etc.; journal: Also refers to a record of events, experiences, thoughts, and observations kept on a regular basis by an individual for personal use. Writers often keep a daily journal to record ideas and material that may subsequently be incorporated into their works; memoirs: A narrative of events or reminiscences based on the author's own observations or personal knowledge of the world in which he (or she) lived, including events witnessed, people known or observed, places visited, etc. The life need not have been historically significant but one that placed the writer in a position to observe firsthand significant events as they unfolded. Unlike a private diary or journal, memoirs are usually written for publication long after the occurrence of the events described and do not necessarily provide a day-to-day account.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(diaries. Refers to books containing the daily, personal accounts of the writer's own experiences, attitudes, and observations. Use \"journals (accounts)\" when referring to an individual's or an organization's account of occurrences or transactions.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 39 (diary 1 daily record of events, 2 book, calendar with daily memoranda)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Diaries. UF Journals (Personal narratives). BT Record-keeping works. RT Maritime journals; Overland journals; Autobiographies; Commonplace books)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6616eea4ff87443ea895845d027ccc3eb10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Journals (Diaries)"}}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Journals (Diaries)"}}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n6616eea4ff87443ea895845d027ccc3eb13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Personal journals"}}, {"@id": "_:n6616eea4ff87443ea895845d027ccc3eb13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Personal journals"}}], "@id": "/authorities/genreForms/gf2014026085"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026086", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDictionaries", "identifiers:lccn": "gf2014026086", "madsrdf:adminMetadata": [{"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b1"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Dictionaries"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026146"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026167"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026195"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026117"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026048"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026098"}], "madsrdf:hasSource": [{"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b5"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b6"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b7"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b8"}], "madsrdf:hasVariant": [{"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b9"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b12"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Dictionaries"}}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(form subdivisions --Glossaries, vocabularies, etc.; --Terminology; --Terms and phrases)"}, "madsrdf:citationSource": "LCSH, Nov. 18, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(dictionary: A single-volume or multivolume reference work containing brief explanatory entries for terms and topics related to a specific subject or field of inquiry, usually arranged alphabetically. Some dictionaries also include synonyms, antonyms, and brief biographical and gazetteer information. In an unabridged dictionary, an attempt is made to be comprehensive in the number of terms included. An abridged dictionary provides a more limited selection of words and usually less information in each entry. In a visual dictionary, each term is illustrated. See also: desk dictionary and pocket dictionary; glossary: An alphabetically arranged list of the specialized vocabulary of a given subject or field of study, with brief definitions, often appearing at the end of a book or at the beginning of a long entry in a technical reference work. Long glossaries may be separately published.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Dictionaries. BT Wordbooks. NT Etymological dictionaries; Reverse dictionaries)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 28 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 39 (dictionary 1 book explaining vocabulary, 2 reference book arranged alphabetically)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Glossaries"}}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Glossaries"}}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Terminologies"}}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Terminologies"}}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Terms and phrases"}}, {"@id": "_:nc82534b4ef4a41af82bf8aedfe5cfe16b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Terms and phrases"}}], "@id": "/authorities/genreForms/gf2014026086"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026087", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDirectories", "identifiers:lccn": "gf2014026087", "madsrdf:adminMetadata": [{"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b1"}, {"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Directories"}, "madsrdf:elementList": {"@list": [{"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026165"}, "madsrdf:hasNarrowerAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026063"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026189"}], "madsrdf:hasSource": [{"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b5"}, {"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b6"}, {"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Directories"}}, {"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Directories. BT Reference works. NT City directories)"}, "madsrdf:citationSource": "Genre terms : a thesaurus for use in rare book and special collections cataloging, via WWW, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(directory: A list of people, companies, institutions, organizations, etc., in alphabetical or classified order, providing contact information (names, addresses, phone/fax numbers, etc.) and other pertinent details (affiliations, conferences, publications, membership, etc.) in brief format, often published serially.)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 28, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n051bf4c465654ae3bc6916b85e85ab01b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 39 (directory 1a book of rules, an ordinal, 1b book with alphabetical list of people, 1c computer file)"}, "madsrdf:citationSource": "G\u00f6rlach, M. An alphabetical list of English text types, in Text types and the history of English, c2004:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026087"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026088", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aDiscographies", "identifiers:lccn": "gf2014026088", "madsrdf:adminMetadata": [{"@id": "_:n1dad91109fff45268018345a43594edbb1"}, {"@id": "_:n1dad91109fff45268018345a43594edbb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Discographies"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1dad91109fff45268018345a43594edbb3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026057"}, "madsrdf:hasSource": [{"@id": "_:n1dad91109fff45268018345a43594edbb5"}, {"@id": "_:n1dad91109fff45268018345a43594edbb6"}, {"@id": "_:n1dad91109fff45268018345a43594edbb7"}], "madsrdf:hasVariant": [{"@id": "_:n1dad91109fff45268018345a43594edbb8"}, {"@id": "_:n1dad91109fff45268018345a43594edbb11"}, {"@id": "_:n1dad91109fff45268018345a43594edbb14"}, {"@id": "_:n1dad91109fff45268018345a43594edbb17"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n1dad91109fff45268018345a43594edbb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2014-12-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ilchalcs"}, "ri:recordStatus": "new"}, {"@id": "_:n1dad91109fff45268018345a43594edbb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-01-28T10:23:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1dad91109fff45268018345a43594edbb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Discographies"}}, {"@id": "_:n1dad91109fff45268018345a43594edbb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(discography: A list or catalog of audiorecordings, usually of works by a specific composer or performer, in a certain style or genre, or of a specific time period. Each entry in a discography provides some or all of the following descriptive elements: title of work, name of composer and performer(s), date of recording, name of manufacturer, manufacturer's catalog number, and release date)"}, "madsrdf:citationSource": "Reitz, J.M. ODLIS : online dictionary for library and information science, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dad91109fff45268018345a43594edbb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(discographies. Selective or complete lists of sound recordings, which can be compiled by composer, performer, or group of performers, or of a particular genre or recording label.)"}, "madsrdf:citationSource": "Art & architecture thesaurus online, July 29, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dad91109fff45268018345a43594edbb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Discographies. Use Reference Materials)"}, "madsrdf:citationSource": "ERIC thesaurus, Nov. 17, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n1dad91109fff45268018345a43594edbb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1dad91109fff45268018345a43594edbb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Sound recording lists"}}, {"@id": "_:n1dad91109fff45268018345a43594edbb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Sound recording lists"}}, {"@id": "_:n1dad91109fff45268018345a43594edbb11", "