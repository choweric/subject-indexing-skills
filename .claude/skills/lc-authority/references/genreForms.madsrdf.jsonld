: {"@language": "en", "@value": "(Lounge zone series)"}, "madsrdf:citationSource": "Work cat.: Donny & the Royales. Shaken not stirred [SR] p2000:", "madsrdf:citationStatus": "found"}, {"@id": "_:n69ebeaecb56e4a2d9ded330b3e89014cb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "container (\"Taking lounge music to its illogical conclusion\")"}, "madsrdf:citationSource": "Lounge-a-palooza [SR] p1997:", "madsrdf:citationStatus": "found"}, {"@id": "_:n69ebeaecb56e4a2d9ded330b3e89014cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Lounge refers to a strain of easy listening music from the '50s and '60s that was based on the lush styles of latter-day swing and big band music)"}, "madsrdf:citationSource": "Online, Nov. 23, 2001 All Music Guide:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2014026911"}
