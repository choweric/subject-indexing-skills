tSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n479516c46cf841d781a36e9513816d3bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Detective and mystery radio programs"}}, {"@id": "_:n479516c46cf841d781a36e9513816d3bb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg: Detective and mystery radio programs)"}, "madsrdf:citationSource": "LCSH, May 19, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n479516c46cf841d781a36e9513816d3bb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Crime or mystery programs: Programs which focus on the commission and investigation of crime, or revolve around the solution of a mystery; UF Detective programs, Gangster programs, Murder mysteries, Police programs, Prison programs, Spy programs, Suspense programs, Thrillers, True crime programs. Examples: Alias Jimmy Valentine, Adventures of Ellery Queen, Mr. District Attorney, Big town)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, May 19, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n479516c46cf841d781a36e9513816d3bb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Mystery radio programs; UF Detective and mystery radio programs, Murder mysteries, Private eye stories, Thrillers, Whodunits)"}, "madsrdf:citationSource": "GSAFD via WWW, May 23, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n479516c46cf841d781a36e9513816d3bb8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 286 (Private eyes; character and genre type; examples include The adventures of Sam Spade, I love a mystery, Private eye, etc.)"}, "madsrdf:citationSource": "Cox, J. Radio crime fighters, c2002:", "madsrdf:citationStatus": "found"}, {"@id": "_:n479516c46cf841d781a36e9513816d3bb9", "@type": ["madsrdf:GenreForm", "madsrdf:Varian