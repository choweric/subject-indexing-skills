611bb39"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026044"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026310"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026421"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026457"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025211"}]}, {"@id": "_:nb0894cb711b14811860643e796c7611bb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb0894cb711b14811860643e796c7611bb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2017-05-15T09:36:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nb0894cb711b14811860643e796c7611bb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horror films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0894cb711b14811860643e796c7611bb6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poltergeist films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poltergeist films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb8", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0894cb711b14811860643e796c7611bb9"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hellraiser films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb9", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hellraiser films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb11", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0894cb711b14811860643e796c7611bb12"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nightmare on Elm Street films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb12", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nightmare on Elm Street films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0894cb711b14811860643e796c7611bb15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Amityville films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Amityville films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(horror film: a film that is intended to frighten people, especially one about murders, frightening creatures, or evil people)"}, "madsrdf:citationSource": "Macmillan dictionary online, Feb. 9, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0894cb711b14811860643e796c7611bb18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Horror film, motion picture calculated to cause intense repugnance, fear, or dread. Horror films may incorporate incidents of physical violence and psychological terror; they may be studies of deformed, disturbed, psychotic, or evil characters; stories of terrifying monsters or malevolent animals; or mystery thrillers that use atmosphere to build suspense. The genre often overlaps science-fiction films and film noir)"}, "madsrdf:citationSource": "Britannica online, Feb. 9, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0894cb711b14811860643e796c7611bb19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(horror film: a film in which very frightening or unnatural things happen, for example dead people coming to life and people being murdered)"}, "madsrdf:citationSource": "Cambridge dictionary online, Feb. 9, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0894cb711b14811860643e796c7611bb20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(horror: Fictional work portraying the dark side of life, the unknown, the forbidden, and the supernatural, with the primary aim of frightening the viewer in an entertaining, cathartic manner)"}, "madsrdf:citationSource": "Moving image genre-form guide online, Sept. 14, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0894cb711b14811860643e796c7611bb21", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(horror movie especially American English, horror film British English: a film in which strange and frightening things happen)"}, "madsrdf:citationSource": "Longman dictionary of contemporary English online, Feb. 9, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0894cb711b14811860643e796c7611bb22", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Horror Film (Gorefest, Monster Movie, Terror Film); the genre is very diversified, having multiple subgenres; horror movies are better classified thematically, by content, or by the nature of the monster appearing in them; horror mixes well with science fiction and sometimes it is difficult to decide to which genre a film belongs; at times, a horror movie is referred to as a \"chiller,\" a \"chiller-diller,\" or a \"spinechiller,\" terms which are also used to describe a thriller. \"Shocker\" is applied to that which causes a sensational effect, that is, to what is horrifying, offensive, or repulsive. As such it applies to a horror film as well as to a sex film. See also Gore Film, Haunted House Film, Kaiju Eiga, Psychopathic Thriller, Sex and Violence Film, Vampire Film, Witch Film, Zombie Movie)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0894cb711b14811860643e796c7611bb23", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(horror film: a film with a frightening storyline and atmosphere)"}, "madsrdf:citationSource": "Collins English dictionary online, Feb. 9, 2017", "madsrdf:citationStatus": "found"}, {"@id": "_:nb0894cb711b14811860643e796c7611bb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0894cb711b14811860643e796c7611bb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Terror films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Terror films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0894cb711b14811860643e796c7611bb28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Amityville films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Amityville films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0894cb711b14811860643e796c7611bb31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Hellraiser films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Hellraiser films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0894cb711b14811860643e796c7611bb34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Nightmare on Elm Street films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Nightmare on Elm Street films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0894cb711b14811860643e796c7611bb37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poltergeist films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poltergeist films"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb39", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb0894cb711b14811860643e796c7611bb40"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Spookfests (Motion pictures)"}}, {"@id": "_:nb0894cb711b14811860643e796c7611bb40", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Spookfests (Motion pictures)"}}], "@id": "/authorities/genreForms/gf2011026321"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026322", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHorror radio programs", "identifiers:lccn": "gf2011026322", "madsrdf:adminMetadata": [{"@id": "_:n5786e71692734c1584b12f357bf34a2db1"}, {"@id": "_:n5786e71692734c1584b12f357bf34a2db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Horror radio programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n5786e71692734c1584b12f357bf34a2db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026251"}, "madsrdf:hasSource": [{"@id": "_:n5786e71692734c1584b12f357bf34a2db5"}, {"@id": "_:n5786e71692734c1584b12f357bf34a2db6"}], "madsrdf:hasVariant": {"@id": "_:n5786e71692734c1584b12f357bf34a2db7"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025535"}}, {"@id": "_:n5786e71692734c1584b12f357bf34a2db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n5786e71692734c1584b12f357bf34a2db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T12:38:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n5786e71692734c1584b12f357bf34a2db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horror radio programs"}}, {"@id": "_:n5786e71692734c1584b12f357bf34a2db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg: Horror radio programs)"}, "madsrdf:citationSource": "LCSH, Oct. 25, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n5786e71692734c1584b12f357bf34a2db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Horror: fictional programs in which the primary intention is to frighten; often feature monsters)"}, "madsrdf:citationSource": "Radio form/genre terms guide, via WWW, Oct. 25, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n5786e71692734c1584b12f357bf34a2db7", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n5786e71692734c1584b12f357bf34a2db8"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Monster radio programs"}}, {"@id": "_:n5786e71692734c1584b12f357bf34a2db8", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Monster radio programs"}}], "@id": "/authorities/genreForms/gf2011026322"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026323", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aHorror television programs", "identifiers:lccn": "gf2011026323", "madsrdf:adminMetadata": [{"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b1"}, {"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Horror television programs"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026673"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2020026053"}, "madsrdf:hasReciprocalAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026308"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026403"}], "madsrdf:hasSource": [{"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b5"}, {"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b6"}, {"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025332"}}, {"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:19:43"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Horror television programs"}}, {"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Tales from the crypt. House of horror, 1993.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Horror: fictional work portraying the dark side of life, the unknown, the forbidden, and the supernatural, with the primary aim of frightening the viewer in an entertaining, cathartic manner. Frequently, haunted houses, ghosts, werewolves, zombies, vampires, or the diabolical are depicted. The menace may also come through the horrific impact of nature or science gone wrong, such as a monster deliberately or accidentally created by advanced technology, or from Earth under attack by extraterrestrial beings)"}, "madsrdf:citationSource": "Moving image genre-form guide online, June 26, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n1ada73a3c30b444aafb089f99d8bea74b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 56 (Horror films and programs: fictional genre films and programs made with the primary intent of frightening the audience)"}, "madsrdf:citationSource": "Yee, M.M. Moving image materials, 1988:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2011026323"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026324", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIndependent films", "identifiers:lccn": "gf2011026324", "madsrdf:adminMetadata": [{"@id": "_:n1d65bfa4ac19429bbf0a504330861444b1"}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Independent films"}, "madsrdf:elementList": {"@list": [{"@id": "_:n1d65bfa4ac19429bbf0a504330861444b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026406"}, "madsrdf:hasNarrowerAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2017026033"}, "madsrdf:hasSource": [{"@id": "_:n1d65bfa4ac19429bbf0a504330861444b5"}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b6"}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b7"}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b8"}], "madsrdf:hasVariant": {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2007025333"}}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2015-12-28T09:20:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Independent films"}}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(independent production (alternative cinema, art film, concrete film, independent film, indie, oppositional film, radical film): Films which are not produced or financially backed by an established film production company are referred to as indies or independent productions; quasi-synonymous with that of avant-garrde and underground film, both older appellations for experimental films or films of personal artistic expression made outside the mainstream of commercially produced films [avant-garde and underground have their own entries])"}, "madsrdf:citationSource": "Films by genre, 1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Independent films)"}, "madsrdf:citationSource": "LCSH, July 18, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Reeltime Independent Film and Video Forum collection catalog, 2005.", "madsrdf:citationStatus": "found"}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(an independent film (or indie film) is a film initially produced without financing or distribution from a major movie studio.)"}, "madsrdf:citationSource": "Wikipedia, Nov. 16, 2005", "madsrdf:citationStatus": "found"}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n1d65bfa4ac19429bbf0a504330861444b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Indie films"}}, {"@id": "_:n1d65bfa4ac19429bbf0a504330861444b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Indie films"}}], "@id": "/authorities/genreForms/gf2011026324"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026325", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIndex maps", "identifiers:lccn": "gf2011026325", "madsrdf:adminMetadata": [{"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab1"}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Index maps"}, "madsrdf:elementList": {"@list": [{"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026387"}, "madsrdf:hasSource": [{"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab5"}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab6"}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab7"}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab8"}], "madsrdf:hasVariant": {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab9"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:useFor": {"@id": "http://id.loc.gov/authorities/subjects/sh2009025068"}}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-18T12:48:22"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Index maps"}}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(hdg.: Index maps)"}, "madsrdf:citationSource": "LCSH, Dec. 1, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "index map (a map showing where to find collections of related data such as other rmaps, aerial photographs, statistical data, or descriptions of terrain.  Also called a key map.  Index maps may be used to show references ot the origin, place of deposit, or filing or other identifying characteristics of such data)"}, "madsrdf:citationSource": "Glossary of the mapping sciences, 1994:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Glossary of mapping, charting, and geodetic terms, 1973.", "madsrdf:citationStatus": "notfound"}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(index map: a type of finding aid that allow users find a set of maps covering their regions of interest along with the name or number of the relevant map sheet. An index maps provides geospatial representation on either a sheet of paper or a computer screen)"}, "madsrdf:citationSource": "Wikipedia, Dec. 1, 2009:", "madsrdf:citationStatus": "found"}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Key maps"}}, {"@id": "_:ne059eef6c9d542dbaf2af7d5e6bafd3ab10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Key maps"}}], "@id": "/authorities/genreForms/gf2011026325"}
