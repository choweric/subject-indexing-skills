{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026582", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aSlapstick comedy films", "identifiers:lccn": "gf2011026582", "madsrdf:adminMetadata": [{"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b1"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Slapstick comedy films"}, "madsrdf:elementList": {"@list": [{"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2011026147"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b5"}, "madsrdf:hasSource": [{"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b8"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b9"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b10"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b11"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b12"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b13"}], "madsrdf:hasVariant": [{"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b14"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b17"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b20"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Films that derive humor from physical comedy.", "madsrdf:useFor": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2011026691"}, {"@id": "http://id.loc.gov/authorities/subjects/sh2007025356"}]}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-07-12T12:03:06"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Slapstick comedy films"}}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Three Stooges films"}}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Three Stooges films"}}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(compilation of silent films originally produced between 1909 and 1929, with new music soundtracks)"}, "madsrdf:citationSource": "Slapstick encyclopedia, \u00a92012", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(slapstick comedy: Fictional work in which the humor is derived from physical comedy, such as falls, chases, and physical gags)"}, "madsrdf:citationSource": "Moving image genre-form guide online, April 27, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Slapstick (Classical Comedy, Clown Comedy, Custard-Pie Comedy, Knockabout Comedy, Low Comedy, Slapstick Comedy, Slapstick Farce). Film comedy began as low comedy or slapstick, as silent comedy is generally called; Slapstick is physical comedy with plenty of movement, made up mainly of falls, gags, pies generally landing on faces, and chases. Most silent slapstick comedies ended with a riotous chase in which all sorts of people and vehicles participated; pie-throwing was such a standard part of slapstick that custard-pie comedy has also been used as a synonym for slapstick comedy)"}, "madsrdf:citationSource": "L\u00f3pez, D. Films by genre, \u00a91993", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(slapstick comedy films: 38,200 hits; custard-pie comedy films: 3 hits; knockabout comedy films: 9 hits; low comedy films: 1,490 hits; slapstick farces: 2,150 hits; slapstick films: 49,600 hits)"}, "madsrdf:citationSource": "Google, May 9, 2019:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Knockabout comedy (Farcical rough and tumble in which laughter is provoked by the infliction of physical misfortune. Custard pies, banana skins, black eyes, misplaced buckets of water and lumps on the cranium are standard ingredients) Slapstick (Originally the wand used by Harlequin in pantomime to beat his enemies. The term now means knockabout comedy)"}, "madsrdf:citationSource": "Hodgson, T. The drama dictionary, \u00a91988:", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(compilation of motion pictures originally released between 1914 and 1929)"}, "madsrdf:citationSource": "American slapstick, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b14", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b15"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Slapstick films"}}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b15", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Slapstick films"}}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b17", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b18"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Low comedy films"}}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b18", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Low comedy films"}}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b20", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b21"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Three Stooges films"}}, {"@id": "_:nb9d7ad1e3b2f4a778173366e62973a75b21", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Three Stooges films"}}], "@id": "/authorities/genreForms/gf2011026582"}
