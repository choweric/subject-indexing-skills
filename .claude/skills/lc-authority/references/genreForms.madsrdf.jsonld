lue": "t.p. (being a series of volumes picturing and describing the Indians of the United States and Alaska)"}, "madsrdf:citationSource": "Work cat.: Curtis, E.S. The North American Indian, 2014-2016:", "madsrdf:citationStatus": "found"}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b9", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b10"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ethnographical works"}}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b10", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnographical works"}}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ethnologic works"}}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnologic works"}}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ethnological works"}}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnological works"}}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ethnographic works"}}, {"@id": "_:nfb02791bebdf4cedb94e574a6925feb8b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ethnographic works"}}], "@id": "/authorities/genreForms/gf2018026013"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026018", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFantasias (Music)", "identifiers:lccn": "gf2018026018", "madsrdf:adminMetadata": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b1"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fantasias (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b5"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b6"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b7"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b8"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b9"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b10"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b11"}], "madsrdf:hasVariant": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b12"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b15"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b18"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b21"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b24"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b27"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b30"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b33"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b36"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-01-25T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-04-16T09:47:34"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantasias (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fantasia: a piece of classical music that does not have a fixed form; a piece of classical music based on other well-known tunes)"}, "madsrdf:citationSource": "Macmillan dictionary online, Jan. 25, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fantasia: A musical composition with a free form and often an improvisatory style)"}, "madsrdf:citationSource": "Oxford dictionaries website, Jan. 25, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Rodrigo, Joaqu\u00edn. Fantas\u00eda para un gentilhombre, 1991.", "madsrdf:citationStatus": "found"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasia (It., Sp., Ger., Eng.; Eng., Fr., Ger. Fantasie; Fr., Ger. Phantasie; Fr. fantaisie, fantasye, phantaisie; Eng., Ger. Phantasia; Ger. Fantasey; Eng. Fancie, fancy, fansye, fantasy, fantazia, fantazie, fantazy, phansie, phantasy, phantazia). A term adopted in the Renaissance for an instrumental composition whose form and invention spring 'solely from the fantasy and skill of the author who created it' (Luis de Mil\u00e1n, 1535--6). From the 16th century to the 19th the fantasia tended to retain this subjective licence, and its formal and stylistic characteristics may consequently vary widely from free, improvisatory types to strictly contrapuntal and more or less standard sectional forms; the fantasias of Beethoven both maintain and break with tradition; the four fantasias of Schubert; the 19th-century fantasia grew in size and scope to become as musically substantial as large-scale, multi-movement works; the term 'fantasia' was also applied to virtuoso pieces based on a given theme or group of themes of a popular source--usually an opera. Most 19th-century virtuoso pianists wrote operatic fantasias; many who had also composed a successful opera wrote a fantasia on its most popular tunes; in the early 20th century the fantasia became something of a retrospective form, flourishing particularly in organ music based on chorales, themes by Bach or the motif B-A-C-H; the outstanding example of the 20th-century fantasia on original themes is Schoenberg's Phantasy for violin with piano accompaniment op.47; British composers took up the fantasia on given themes as an orchestral form, including Vaughan Williams (Fantasia on Greensleeves and Fantasia on a Theme by Thomas Tallis) and Tippett (Fantasia concertante on a Theme of Corelli))"}, "madsrdf:citationSource": "Grove music online, Jan. 25, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fantasia. UF Fancy (Music); Fantasy (Music); Phantasy (Music). BT Musical form)"}, "madsrdf:citationSource": "LCSH, Jan. 25, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(fantasia 1 : a free usually instrumental composition not in strict form. 2 a : a work (such as a poem or play) in which the author's fancy roves unrestricted. b : something possessing grotesque, bizarre, or unreal qualities)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Jan. 25, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Phantasy. An old English spelling of Fantasia, adopted in competitions established in 1905 by Walter Willson Cobbett and the Worshipful Company of Musicians as the name for a new type of chamber music piece. Cobbett saw phantasies as a 'modern analogue' to the viol fantasias of Tudor and Stuart times: his aim was to elicit works for specified ensembles, of modest length, and without breaks between the contrasting sections, in which the composer's imagination would be given free play; phantasies)"}, "madsrdf:citationSource": "Grove music online, Jan. 25, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fantasies (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantasies (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fantazies (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantazies (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Phansies (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Phansies (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Phantazias (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Phantazias (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Phantasies (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Phantasies (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fansyes (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fansyes (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b30", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b31"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Phantasias (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b31", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Phantasias (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b33", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b34"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fantazias (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b34", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fantazias (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b36", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b37"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Fancies (Music)"}}, {"@id": "_:nc781a10e53f94d79b721ad4579ded6b3b37", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fancies (Music)"}}], "@id": "/authorities/genreForms/gf2018026018"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026019", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aZombie fiction", "identifiers:lccn": "gf2018026019", "madsrdf:adminMetadata": [{"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb1"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Zombie fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026469"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026127"}], "madsrdf:hasSource": [{"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb5"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb6"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb7"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb8"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb9"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb10"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb11"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb12"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb13"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb14"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb15"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:25:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Zombie fiction"}}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: As a mysterious plague falls upon the village of Meryton and zombies start rising from the dead, Elizabeth Bennet is determined to destroy the evil menace, but becomes distracted by the arrival of the dashing and arrogant Mr. Darcy)"}, "madsrdf:citationSource": "Work cat.: Grahame-Smith, S. Pride and prejudice and zombies : the classic regency romance--now with ultraviolent zombie mayhem, \u00a92009", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Dunwoody, D. Empire : a zombie novel, 2010.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(zombie, or less commonly zombi: 1 a : a will-less and speechless human (as in voodoo belief and in fictional stories) held to have died and been supernaturally reanimated. b : the supernatural power that according to voodoo belief may enter into and reanimate a dead body)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Feb. 1, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Maberry, J. Dead of night : a zombie novel, 2011.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Wellington, D. The Monster Island trilogy : three zombie novels, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 135 (zombie fiction)"}, "madsrdf:citationSource": "Latin American science fiction, 2012:", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a collection of short stories)"}, "madsrdf:citationSource": "Dead north : Canadian zombie fiction, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(A zombie (Haitian French: zombi, Haitian Creole: zonbi) is a fictional undead being created through the reanimation of a human corpse. Zombies are most commonly found in horror and fantasy genre works. The term comes from Haitian folklore, where a zombie is a dead body reanimated through various methods, most commonly magic. Modern depictions of the reanimation of the dead do not necessarily involve magic but often invoke science fictional methods such as carriers, radiation, mental diseases, vectors, viruses, scientific accidents, etc.; zombie fiction)"}, "madsrdf:citationSource": "Wikipedia, Feb. 1, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(zombie 1. A corpse said to be revived by witchcraft, especially in certain African and Caribbean religions. 1.1 (in popular fiction) a person or reanimated corpse that has been turned into a creature capable of movement but not of rational thought, which feeds on human flesh)"}, "madsrdf:citationSource": "Oxford dictionaries online, Feb. 1, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: When a funeral at the local parish goes strangely and horribly awry and corpses suddenly spring from the soft earth, only one person can stop them. As the bodies pile up, Elizabeth Bennet evolves from a naive young teenager into a savage slayer of the undead in this prequel to \"Pride and Prejudice and Zombies\")"}, "madsrdf:citationSource": "Hockensmith, S. Pride and prejudice and zombies, \u00a92010", "madsrdf:citationStatus": "found"}, {"@id": "_:n2f74d3002af24c51a27aa4602b8d3f8cb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. xviii (The zombie can either be the enslaved alive or the reanimated dead, and he or she or it may or may not be a cannibal. While these qualities are associated with the zombie, the most essential characteristic of the creature is its lack of free will. The zombie either has its will subordinated by a master, as in the case with zombies created by Voodoo, or its will is effaced by the unquenchable need to consume human flesh (or brains), or even by a crippling rage that drives the creature to tear apart all uninfected humans) p. 5 (while the zombie apocalypse is not a component of all zombie fiction, it is ubiquitous in contemporary zombie fiction to the point that it is often mistakenly thought to be one of the genre's central tropes) pp. 224-225 (Reanimation after death is virtually synonymous with zombie fiction. A preponderance of zombies are the reanimated dead who, in their revived state, lack reason and are either subordinate to the person who put them in this condition or in thrall to the single-minded drive to consume flesh or tear apart humans; The earliest examples of the creature are reanimated through magical means by a bokur or Voodoo priest who uses black magic; Magical or supernatural means of reanimation persist in contemporary zombie fiction, though this magic is not always related to Voodoo; However, many works of zombie fiction show the dead return to life via scientific means. Notable among these are Richard Matheson's novella I Am Legend (1954), where the dead begin reanimating due to a bacteriological mutation that occurred after a global nuclear exchange permanently changed the environment)"}, "madsrdf:citationSource": "Encyclopedia of the zombie, 2014:", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026019"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026020", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aWerewolf fiction", "identifiers:lccn": "gf2018026020", "madsrdf:adminMetadata": [{"@id": "_:nad1b35e888fa4d198894444167afb91fb1"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Werewolf fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nad1b35e888fa4d198894444167afb91fb3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026469"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2018026127"}], "madsrdf:hasSource": [{"@id": "_:nad1b35e888fa4d198894444167afb91fb5"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb6"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb7"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb8"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb9"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb10"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb11"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb12"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb13"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb14"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb15"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb16"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb17"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb18"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb19"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb20"}], "madsrdf:hasVariant": [{"@id": "_:nad1b35e888fa4d198894444167afb91fb21"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb24"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-12-11T13:25:27"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-01T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Werewolf fiction"}}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Werewolves. UF Lycanthropes; Were-wolves; Werwolves. BT Animals, Mythical; Wolves--Folklore. RT Shapeshifting)"}, "madsrdf:citationSource": "LCSH, Feb. 1, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a novel)"}, "madsrdf:citationSource": "Housman, C. The were-wolf, 1896", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb7", "@type": "madsrdf:Source", "madsrdf:citationSource": "Carl, W.D. Bestial : a werewolf novel, 2012.", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Terrifying transformations : an anthology of Victorian werewolf fiction, 1838-1896, 2013.", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(werewolf: a person transformed into a wolf or capable of assuming a wolf's form)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Feb. 1, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Werewolf (A werewolf or occasionally lycanthrope is a mythological or folkloric human with the ability to shapeshift into a wolf (or, especially in modern film, a therianthropic hybrid wolflike creature), either purposely or after being placed under a curse or affliction (often a bite or scratch from another werewolf); werewolf fiction as a genre has pre-modern precedents in medieval romances (e.g. Bisclavret and Guillaume de Palerme) and developed in the 18th century out of the \"semi-fictional\" chap book tradition) Werewolf fiction (Werewolf fiction denotes the portrayal of werewolves and other shapeshifting man/woman-beasts, in the media of literature, drama, film, games, and music; werewolf fiction is an exceptionally diverse genre with ancient folkloric roots and manifold modern re-interpretations; the twentieth century saw an explosion of werewolf short stories and novels published in both England and America; the most renowned werewolf novel of the twentieth century was The Werewolf of Paris (1933) by American author Guy Endore. This has been accorded classic status and is considered by some to be the Dracula of werewolf literature)"}, "madsrdf:citationSource": "Wikipedia, Feb. 1, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Carter, M.L. Shadow of the beast : a werewolf novel, \u00a91998.", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb12", "@type": "madsrdf:Source", "madsrdf:citationSource": "Silver bullets : classic werewolf stories, 2017.", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb13", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(werewolf: (in folklore) a person who changes for periods of time into a wolf, typically when there is a full moon; lycanthrope: A werewolf)"}, "madsrdf:citationSource": "Oxford dictionaries online, Feb. 1, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb14", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a werewolf novel)"}, "madsrdf:citationSource": "Work cat.: Damask, J. Wolf at the door, 2016", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb15", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a novel)"}, "madsrdf:citationSource": "Grew, D. The werwolf of Edmonton, 1934", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb16", "@type": "madsrdf:Source", "madsrdf:citationSource": "Vampire and werewolf stories, \u00a91998.", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb17", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "pp. 47-48 (vampires and werewolves; the lycanthrope; the werewolf is the alter ego of the suave, sophisticated vampire; the werewolf represents our most essential desires--for food, sex, comfort, even violence--in their most bestial form)"}, "madsrdf:citationSource": "Fonseca, A.J. Hooked on horror : a guide to reading interests in horror fiction, 2003:", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb18", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 85 (The werewolf pack has only recently begun to appear in lycanthropic fiction)"}, "madsrdf:citationSource": "A dark California, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb19", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 65 (werewolf fiction; \"In contrast to the feminized figure of the vampire, the werewolves of horror fiction often serve as an image of unambiguous hypermasculinity. However, the hypermasculine werewolves of contemporary horror fiction ... belie the complex history of the werewolf in horror literature. In Victorian fiction, female werewolves were as common as their male counterparts; e.g. in Clemence Housman's The Were-wolf)"}, "madsrdf:citationSource": "Horror literature through history, 2017:", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb20", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 152 (lycanthropic fiction)"}, "madsrdf:citationSource": "Copper, B. The werewolf : in legend, fact & art, \u00a91977:", "madsrdf:citationStatus": "found"}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nad1b35e888fa4d198894444167afb91fb22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Werwolf fiction"}}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Werwolf fiction"}}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nad1b35e888fa4d198894444167afb91fb25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Lycanthropic fiction"}}, {"@id": "_:nad1b35e888fa4d198894444167afb91fb25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Lycanthropic fiction"}}], "@id": "/authorities/genreForms/gf2018026020"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026021", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aVampire comics", "identifiers:lccn": "gf2018026021", "madsrdf:adminMetadata": [{"@id": "_:n195d9548e161456289e315abefd74a78b1"}, {"@id": "_:n195d9548e161456289e315abefd74a78b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Vampire comics"}, "madsrdf:elementList": {"@list": [{"@id": "_:n195d9548e161456289e315abefd74a78b3"}]}, "madsrdf:hasBroaderAuthority": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2014026468"}, {"@id": "http://id.loc.gov/authorities/genreForms/gf2019026104"}], "madsrdf:hasSource": [{"@id": "_:n195d9548e161456289e315abefd74a78b5"}, {"@id": "_:n195d9548e161456289e315abefd74a78b6"}, {"@id": "_:n195d9548e161456289e315abefd74a78b7"}, {"@id": "_:n195d9548e161456289e315abefd74a78b8"}, {"@id": "_:n195d9548e161456289e315abefd74a78b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n195d9548e161456289e315abefd74a78b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2019-10-04T13:41:09"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "revised"}, {"@id": "_:n195d9548e161456289e315abefd74a78b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n195d9548e161456289e315abefd74a78b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Vampire comics"}}, {"@id": "_:n195d9548e161456289e315abefd74a78b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Dark Horse comics today released a very funny little infographic about its cache of vampiric comics\")"}, "madsrdf:citationSource": "The angry spark blog, May 29, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n195d9548e161456289e315abefd74a78b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Vampire wage-slave Dave works for an old-world vampire as a night manager, has an unrequited crush on a goth girl and wants to be a vegetarian. Life for him seems pretty bleak until he realizes maybe he's not as powerless as he thinks; awards: Cybils Finalist Graphic Novel, 2008)"}, "madsrdf:citationSource": "Work cat.: Abel, J. Life sucks, 2008", "madsrdf:citationStatus": "found"}, {"@id": "_:n195d9548e161456289e315abefd74a78b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: Runaway vampire princess Lissa and her guardian-in-training Rose are found and returned to St. Vladimir's Academy, where one focuses on mastering magic, the other on physical training, while both try to avoid the perils of gossip, cliques, gruesome pranks, and sinister plots)"}, "madsrdf:citationSource": "Dragoon, L. Vampire Academy : a graphic novel, \u00a92011", "madsrdf:citationStatus": "found"}, {"@id": "_:n195d9548e161456289e315abefd74a78b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(vampire comics)"}, "madsrdf:citationSource": "Saunders, C.B. 19 vampire comics and graphic novels to sink your teeth into, via Syfy website, posted Oct 15, 2016, viewed on Feb. 9, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n195d9548e161456289e315abefd74a78b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Beginning with the legendary E.C. Comics horror titles from the 1940s and '50s, vampires, zombies, demons, and all other types of creepy creatures have made a major impact on the storytelling medium; 9. Morbius, the Living Vampire)"}, "madsrdf:citationSource": "Serafino, J. The 15 scariest monsters in comic books, via Complex website, Oct. 31, 2012, viewed on July 8, 2019", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026021"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026022", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aBagatelles (Music)", "identifiers:lccn": "gf2018026022", "madsrdf:adminMetadata": [{"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b1"}, {"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Bagatelles (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026639"}, "madsrdf:hasSource": [{"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b5"}, {"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b6"}, {"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b7"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Short, light pieces of instrumental music that are generally created and published in sets."}, {"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-03T13:39:41"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Bagatelles (Music)"}}, {"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(bagatelle 1 : trifle. 2 : any of various games involving the rolling of balls into scoring areas. 3 : a short literary or musical piece in light style)"}, "madsrdf:citationSource": "Merriam-Webster dictionary online, Feb. 12, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(includes: Five bagatelles / William Walton)"}, "madsrdf:citationSource": "Work cat.: Devine, G.A. British guitar music, 2006", "madsrdf:citationStatus": "found"}, {"@id": "_:ncd2d5887aac44770ae2d93d1ff7a0050b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Bagatelle. A trifle, a short piece of music in light vein. The title implies no specific form; The bagatelle since Beethoven has usually been given a descriptive title, and more often than not composers have published them in sets)"}, "madsrdf:citationSource": "Grove music online, Feb. 14, 2018", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026022"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026023", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aRailroad fiction", "identifiers:lccn": "gf2018026023", "madsrdf:adminMetadata": [{"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab1"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Railroad fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026217"}, "madsrdf:hasSource": [{"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab5"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab6"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab7"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab8"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab9"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab10"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab11"}], "madsrdf:hasVariant": [{"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab12"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab15"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab18"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that is set on and around a railroad and that generally focuses on railroaders who overcome natural or man-made challenges."}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-08-03T13:39:42"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-23T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Railroad fiction"}}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. x (railroad fiction; the railroad genre) p. xi (Packard's railroad fiction)"}, "madsrdf:citationSource": "Work cat.: Packard, F.L. The wire devils, 2013, via Project Muse, viewed on Feb. 23, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "Frank L. Packard (Packard's earliest short fiction consists of railway adventures)"}, "madsrdf:citationSource": "The Canadian encyclopedia, via WWW, Feb. 23, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 2 (railroad fiction) pp. 5-6 (fiction focusing directly on the railroad; stories featuring heroic engineers, brave firemen, young women in distress on runaway trains, and earnest young men determined to carve out careers in rail service; many stories in the genre are laden with jargon peculiar to the profession) p. 13 (rail fiction commonly presents its central figure, the railroader--most often the engineer, but also the fireman, the conductor, the brakeman, the switchman, and other personnel--as a man who rises to the occasion to overcome the challenges of the moment, whether natural or man-made) p. 164 (railroading fiction)"}, "madsrdf:citationSource": "Burns, G. The railroad in American fiction, \u00a92005:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 80 (Railroading fiction; English and American railroad fiction)"}, "madsrdf:citationSource": "The Railway and Locomotive Historical Society bulletin, May, 1936, via JSTOR, viewed on Feb. 23, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Mysterious railway stories, 1986.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Railroad stories. UF Railroads--Fiction; Railroads--Juvenile fiction. BT Fiction)"}, "madsrdf:citationSource": "LCSH, Feb. 23, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab11", "@type": "madsrdf:Source", "madsrdf:citationSource": "Warman, C. The last spike, and other railroad stories, 1906.", "madsrdf:citationStatus": "found"}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Railroading fiction"}}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Railroading fiction"}}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Railway fiction"}}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Railway fiction"}}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Rail fiction"}}, {"@id": "_:nf268e799712f4cc0a133d70bd4146d6ab19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Rail fiction"}}], "@id": "/authorities/genreForms/gf2018026023"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026024", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aIn nomines (Music)", "identifiers:lccn": "gf2018026024", "madsrdf:adminMetadata": [{"@id": "_:n584b299152594f4ca706ce16aedb102ab1"}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "In nomines (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n584b299152594f4ca706ce16aedb102ab3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026704"}, "madsrdf:hasEarlierEstablishedForm": {"@id": "_:n584b299152594f4ca706ce16aedb102ab5"}, "madsrdf:hasSource": [{"@id": "_:n584b299152594f4ca706ce16aedb102ab8"}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab9"}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab10"}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab11"}], "madsrdf:hasVariant": {"@id": "_:n584b299152594f4ca706ce16aedb102ab12"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Chamber music based on the Sarum antiphon Gloria tibi Trinitas."}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-02-26T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-07-13T13:04:08"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "In nomines (Music)"}}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n584b299152594f4ca706ce16aedb102ab6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "In nomine (Music)"}}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "In nomine (Music)"}}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab8", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: 2016563827: Loeb, D. Asian In Nomines for four to seven viols, 2006.", "madsrdf:citationStatus": "found"}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In Nomine: Title given to a number of exclusively English instrumental compositions of the 16th and 17th centuries that use the Sarum antiphon Gloria tibi Trinitasas their cantus firmus. The In Nomine was the most conspicuous single form in the early development of English consort music, over 150 examples surviving by some 58 composers from Taverner to Purcell....In Nomines have attracted the attention of 20th century composers)"}, "madsrdf:citationSource": "Grove Music Online, February 26, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(In nomine (Music))"}, "madsrdf:citationSource": "LCSH, February 26, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "innomine (an English polyphonic composition of the 16th and 17th centuries written for an instrumental ensemble (as for viols and keyboard) and using as a cantus firmus a fragment of plainsong from the antiphon for Trinity Sunday; pl. -s)"}, "madsrdf:citationSource": "Merriam-Webster online, May 19, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n584b299152594f4ca706ce16aedb102ab13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "In nomine (Music)"}}, {"@id": "_:n584b299152594f4ca706ce16aedb102ab13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "In nomine (Music)"}}], "@id": "/authorities/genreForms/gf2018026024"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026025", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aFishing fiction", "identifiers:lccn": "gf2018026025", "madsrdf:adminMetadata": [{"@id": "_:n551af06cc1e84bd991b9073da4ebae3db1"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Fishing fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n551af06cc1e84bd991b9073da4ebae3db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n551af06cc1e84bd991b9073da4ebae3db5"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db6"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db7"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db8"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db9"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db10"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db11"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db12"}], "madsrdf:hasVariant": {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db13"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features fishing and fishers."}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-15T14:49:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-03-09T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Fishing fiction"}}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db5", "@type": "madsrdf:Source", "madsrdf:citationSource": "91046263: Foote, J.T. A wedding gift, and other angling stories, \u00a91992.", "madsrdf:citationStatus": "found"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(short stories) p. 4 of cover (\"moody, psychological stories ... an angling theme\"; \"These stories are what fly-fishing is all about--the lyrical play between the water and the angler, the successful days and the days with no fish, and the recognition that it isn't just about the fish after all.\")"}, "madsrdf:citationSource": "2007046774: Ducker, B. Home pool : stories of fly fishing and lesser passions, \u00a92008", "madsrdf:citationStatus": "found"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Fishing stories. UF Fishing--Fiction; Fishing--Juvenile fiction. BT Sports stories)"}, "madsrdf:citationSource": "LCSH, Mar. 9, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anthology that consists of Hemingway's fishing stories, both fiction and nonfiction)"}, "madsrdf:citationSource": "2013443252: Hemingway, E. Hemingway on fishing, 2012", "madsrdf:citationStatus": "found"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(anthology of fishing stories, both fiction and nonfiction)"}, "madsrdf:citationSource": "2012039939: Fishing stories, 2013", "madsrdf:citationStatus": "found"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"In Iceland, a hundred years ago, fishermen prepare to go back to the sea in search for cod, their main source of sustenance and income. Their lives are difficult, bleak. They are poor, the weather is unfriendly, the dangerous sea is both friend and foe and the only certainty is the hardship that awaits them. Still, on they go and still, they dream and they hope. ... the book is divided in two parts. The first half, the fishing trip, the one that follows the day Bar\u00f0ur dies -- the moments just before it, the moments just after it -- are quite evocative and taut with nearly unbearable tension. In that first part, when following the lives of those men, when witnessing their struggles and hearing their dreams, it is easy to be engulfed and transported to that moment in time and to understand and even appreciate the aforementioned themes of the novel.\")"}, "madsrdf:citationSource": "Book review: Heaven and Hell by J\u00f3n Kalman Stef\u00e1nsson, via The book smugglers website, viewed Mar. 9, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(short stories) p. 2 (fishing stories)"}, "madsrdf:citationSource": "Sabatini, R. A fair head of angling stories, \u00a91989", "madsrdf:citationStatus": "found"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(a novel; summary from LC bib. record: In a remote part of Iceland, a boy and his friend Barethur join a boat to fish for cod. A winter storm surprises them out at sea and Barethur, who has forgotten his waterproof as he was too absorbed in \"Paradise Lost,\" succumbs to the ferocious cold and dies. Appalled by the death and by the fishermen's callous ability to set about gutting the fatal catch, the boy leaves the village, intending to return the book to its owner.)"}, "madsrdf:citationSource": "Work cat.: 2013913388: J\u00f3n Kalman Stef\u00e1nsson. Heaven and Hell, 2014", "madsrdf:citationStatus": "found"}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n551af06cc1e84bd991b9073da4ebae3db14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Angling fiction"}}, {"@id": "_:n551af06cc1e84bd991b9073da4ebae3db14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Angling fiction"}}], "@id": "/authorities/genreForms/gf2018026025"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026026", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aMilitary fiction", "identifiers:lccn": "gf2018026026", "madsrdf:adminMetadata": [{"@id": "_:n62964b4736784ef69326c047a02770b3b1"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Military fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n62964b4736784ef69326c047a02770b3b3"}]}, "madsrdf:exampleNote": "Note under [War fiction]", "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014026339"}, "madsrdf:hasSource": [{"@id": "_:n62964b4736784ef69326c047a02770b3b5"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b6"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b7"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b8"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b9"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction that features the military lifestyle and loyalty to the armed forces and its codes and is generally set during peacetime. For fiction that features military conflicts see [War fiction.]"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-15T14:49:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-03-12T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Military fiction"}}, {"@id": "_:n62964b4736784ef69326c047a02770b3b5", "@type": "madsrdf:Source", "madsrdf:citationSource": "Rubinstein, K.T. Israeli military fiction, 2004.", "madsrdf:citationStatus": "found"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(summary: This story portrays how four angry cadets deal with the boredom and stifling confinement of a military academy.)"}, "madsrdf:citationSource": "Work cat.: Vargas Llosa, M. The time of the hero, 1986", "madsrdf:citationStatus": "found"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b7", "@type": "madsrdf:Source", "madsrdf:citationSource": "2013203839: The Blue falcon review : a journal of military fiction, vol. 1 (2013).", "madsrdf:citationStatus": "found"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "home page (\"This first edited collection of twelve short stories features works by established and first time authors, each exploring a different facet of military life through fiction.\"_"}, "madsrdf:citationSource": "The blue falcon review, vol. 1 website, viewed Mar. 12, 2018:", "madsrdf:citationStatus": "found"}, {"@id": "_:n62964b4736784ef69326c047a02770b3b9", "@type": "madsrdf:Source", "madsrdf:citationSource": "Vernon, M. Warriors, deviants and gentlemen-eccentric : diverse perceptions of the professional officer in post-Second World War military fiction, 1990.", "madsrdf:citationStatus": "found"}], "@id": "/authorities/genreForms/gf2018026026"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026027", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aTransgender fiction", "identifiers:lccn": "gf2018026027", "madsrdf:adminMetadata": [{"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b1"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Transgender fiction"}, "madsrdf:elementList": {"@list": [{"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2022026063"}, "madsrdf:hasSource": [{"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b5"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b6"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b7"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b8"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b9"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b10"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b11"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b12"}], "madsrdf:hasVariant": {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b13"}, "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}, "madsrdf:note": "Fiction featuring transgender characters or addressing transgender themes."}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-03-13T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2023-11-09T14:22:46"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/ic"}, "ri:recordStatus": "revised"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Transgender fiction"}}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 133 (lesbian/gay/bisexual/transgender fiction for teens; young adult fiction with gay, lesbian, bisexual and/or transgender content)"}, "madsrdf:citationSource": "Collection building, v. 23, issue 3 (2004):", "madsrdf:citationStatus": "found"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b6", "@type": "madsrdf:Source", "madsrdf:citationSource": "Work cat.: Boys like her : transfictions, 1998.", "madsrdf:citationStatus": "found"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(2016 is shaping up to be the year trans teen fiction achieves breakout visibility; only now are fictional trans stories reaching critical mass; teen trans fiction; search for acceptance and love search is a common theme in these novels; teenage trans characters deal with parental discord and divorce (usually the moms are loving and the dads are distant and disapproving), bullying, suicide attempts and \"passing\" (often the characters are in a new high school and must decide whether to reveal they are trans). And they navigate hot-button issues like taking hormones and using school or public bathrooms; transgender fiction)"}, "madsrdf:citationSource": "McClurg, J. Transgender themes enter teen fiction, via USA today online, Aug. 7, 2016, viewed on Mar. 13, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(\"Seattle Public Library carries an assortment of transgender-themed fiction books. This list is a sample of some of the more recent titles for adults.\")"}, "madsrdf:citationSource": "Transgender fiction - Seattle Public Library, via Seattle Public Library website, Mar. 13, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(subj. hdgs.: Erotic stories, American; Transgender people--Fiction)"}, "madsrdf:citationSource": "Christian, M. Transgender erotica : trans figures, \u00a92006", "madsrdf:citationStatus": "found"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trans fiction)"}, "madsrdf:citationSource": "Popular trans fiction books, via Goodreads website, Mar. 13, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(transgender fiction)"}, "madsrdf:citationSource": "Popular transgender fiction books, via Goodreads website, Mar. 13, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(trans lit; trans main characters)"}, "madsrdf:citationSource": "Adler, D. 10 great YA novels with transgender/nonbinary main characters, via BNTeenblog, July 28, 2017, viewed on Mar. 13, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Trans fiction"}}, {"@id": "_:n17aac0db79954fff8a6ee1affe44a6c5b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Trans fiction"}}], "@id": "/authorities/genreForms/gf2018026027"}
{"@context": "http://id.loc.gov/authorities/genreForms/context.json", "@graph": [{"@id": "http://id.loc.gov/authorities/genreForms/gf2018026029", "@type": ["madsrdf:Authority", "madsrdf:GenreForm"], "bflc:marcKey": "155  $aGlam rock (Music)", "identifiers:lccn": "gf2018026029", "madsrdf:adminMetadata": [{"@id": "_:n30140e979eaf48a39bc1171619df574db1"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db2"}], "madsrdf:authoritativeLabel": {"@language": "en", "@value": "Glam rock (Music)"}, "madsrdf:elementList": {"@list": [{"@id": "_:n30140e979eaf48a39bc1171619df574db3"}]}, "madsrdf:hasBroaderAuthority": {"@id": "http://id.loc.gov/authorities/genreForms/gf2014027054"}, "madsrdf:hasSource": [{"@id": "_:n30140e979eaf48a39bc1171619df574db5"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db6"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db7"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db8"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db9"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db10"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db11"}], "madsrdf:hasVariant": [{"@id": "_:n30140e979eaf48a39bc1171619df574db12"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db15"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db18"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db21"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db24"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db27"}], "madsrdf:isMemberOfMADSCollection": {"@id": "http://id.loc.gov/authorities/genreForms/collection_LCGFT_General"}, "madsrdf:isMemberOfMADSScheme": {"@id": "http://id.loc.gov/authorities/genreForms"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db1", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-06-15T14:49:30"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "revised"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db2", "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2018-03-14T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/wau"}, "ri:recordStatus": "new"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Glam rock (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db5", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(glam rock music)"}, "madsrdf:citationSource": "Work cat.: The rise and fall of Ziggy Stardust and the Spiders from Mars, 2015", "madsrdf:citationStatus": "found"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db6", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glam rock; highly theatrical mode of presentation found in 1970s rock and pop; emphasis on short, well-constructed, hook-based songs in opposition to the lengthy meanderings of progressive rock; The irony of the genre's inauthenticity became particularly apparent in the UK glitter rock bands of the early 1970s, particularly Slade, Sweet and Gary Glitter. These shared pared-down guitar textures and teen-orientated promotion, often becoming indistinguishable from mainstream teenage pop by the mid-1970s)"}, "madsrdf:citationSource": "Grove music online, via Oxford music online, Mar. 14, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db7", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glam rock music. UF Gay rock music; Glitter rock music; Shock rock music; Theater rock music (Glam rock). BT Rock music)"}, "madsrdf:citationSource": "LCSH, Mar. 14, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Often confused with '80s hair metal; almost entirely British phenomenon that became wildly popular during the first half of the '70s. Glam rock was fairly simple, crunchy guitar rock put across with outrageous theatricality. Most of the music was unabashedly catchy, with melodies drawn from teenage bubblegum pop and hip-shaking rhythms from early rock & roll. But those innocent-sounding influences were belied by the delivery, which was all campy, glitzy showmanship and sexuality; In general, glam rock fell into two schools. The most prevalent one was the intentionally disposable trashiness of T. Rex; d music that was all sexy, silly fun, or, to put it another way, music where the surface was the substance; glam had a surprisingly arty side too, epitomized by David Bowie and Roxy Music. This school was more grandly dramatic and ambitious, both sonically and lyrically; glam was an opportunity for these artists to manipulate their personas at will, making their senses of style part of the overall artistic statement, and exploring the darkness lurking under the music's stylish, glitzy surface)"}, "madsrdf:citationSource": "Glam rock music genre overview, via AllMusic website, Mar. 14, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glam rock, also known as glitter rock, musical movement that began in Britain in the early 1970s and celebrated the spectacle of the rock star and concert. Often dappled with glitter, male musicians took the stage in women's makeup and clothing, adopted theatrical personas, and mounted glamorous musical productions frequently characterized by space-age futurism; At glam's core musically was a heavy guitar sound shaped by hard-rock and pop styles, though the movement also had heavy metal, art rock, and punk incarnations; By the 1980s glam had devolved into the heavy metal excesses of such American groups as Bon Jovi, M\u00f6tley Cr\u00fce, and Poison)"}, "madsrdf:citationSource": "Britannica online, Mar. 14, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(glam rock; also known as theatre rock, glitter rock, shock rock, gay rock)"}, "madsrdf:citationSource": "Lenig, S. The twisted tale of glam rock, \u00a92010", "madsrdf:citationStatus": "found"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Glam rock, in its very first, classic incarnation in the UK from approximately 1972-1974, arose from: a move away from what was perceived as the crushing seriousness of the metal, prog and hard rock bands that would make up what would later be termed \"classic rock,\" a related love for retro Fifties three-chord rock and roll, the rise of bubblegum music aimed at teens in the late Sixties, and a general androgyny unleashed by the culture wars of that same time period; typical UK glam rock song was loud, stomping, simple, and flamboyant, with big guitar riffs and repeated chants that would encourage crowds to sing along; typical glam song of time also featured heavy, tribal beats and a lead vocal that blurred at least some gender distinctions; Also Known As: Glam, Glitter Rock)"}, "madsrdf:citationSource": "Fontenot, R. What is glam rock?, via ThoughtCo. website, Mar. 14, 2018", "madsrdf:citationStatus": "found"}, {"@id": "_:n30140e979eaf48a39bc1171619df574db12", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n30140e979eaf48a39bc1171619df574db13"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Glitter rock (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db13", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Glitter rock (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db15", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n30140e979eaf48a39bc1171619df574db16"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Gay rock (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db16", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Gay rock (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db18", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n30140e979eaf48a39bc1171619df574db19"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Glam (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db19", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Glam (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db21", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n30140e979eaf48a39bc1171619df574db22"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Theater rock (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db22", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theater rock (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db24", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n30140e979eaf48a39bc1171619df574db25"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Theatre rock (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db25", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Theatre rock (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db27", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n30140e979eaf48a39bc1171619df574db28"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Shock rock (Music)"}}, {"@id": "_:n30140e979eaf48a39bc1171619df574db28", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Shock rock (Music)"}}], "@id": "/authorities/genreForms/gf2018026029"}
