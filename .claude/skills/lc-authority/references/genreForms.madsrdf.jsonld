, "@type": "ri:RecordInfo", "ri:languageOfCataloging": {"@id": "http://id.loc.gov/vocabulary/iso639-2/eng"}, "ri:recordChangeDate": {"@type": "xsd:dateTime", "@value": "2011-05-06T00:00:00"}, "ri:recordContentSource": {"@id": "http://id.loc.gov/vocabulary/organizations/dlc"}, "ri:recordStatus": "new"}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b3", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghost films"}}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b5", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44540a27bada429c87a7d6c0f6027989b6"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poltergeist films"}}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b6", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poltergeist films"}}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b8", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "p. 52, changes to Moving image materials, 1988 (Ghost stories UF Haunted house films and programs)"}, "madsrdf:citationSource": "Cataloging service bulletin no. 49 (summer 1990):", "madsrdf:citationStatus": "found"}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b9", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(entry for horror films: Frequently [in horror films], haunted houses, ghosts, werewolves, zombies, vampires, or the diabolical are depicted)"}, "madsrdf:citationSource": "Moving image genre/form guide via WWW, Oct. 26, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b10", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Ghost films; Ghost movies)"}, "madsrdf:citationSource": "Wikipedia website, July 23, 2007", "madsrdf:citationStatus": "found"}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b11", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(Category:Paranormal films. Films about the paranormal, purported phenomena described in popular culture, folk, and other non-scientific bodies of knowledge, whose existence within these contexts is described as beyond normal experience or scientific explanation; paranormal phenomena include extrasensory perception (ESP), telekinesis, ghosts, poltergeists, life after death, reincarnation, faith healing, human auras, and so forth)"}, "madsrdf:citationSource": "Wikipedia, Aug. 11, 2022", "madsrdf:citationStatus": "found"}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b12", "@type": "madsrdf:Source", "madsrdf:citationNote": {"@language": "en", "@value": "(ghost film: Apparitions (spirits, ghosts, poltergeists, wraiths, revenants) take many configurations and manifest themselves in a variety of different ways; may be friendly or unfriendly, horrible or cute; may inspire laughter or fear; see also Haunted house film and Fantasy film: ghost comedies)"}, "madsrdf:citationSource": "Lopez, D. Films by genre, c1993", "madsrdf:citationStatus": "found"}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b13", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44540a27bada429c87a7d6c0f6027989b14"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Ghost movies"}}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b14", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Ghost movies"}}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b16", "@type": ["madsrdf:GenreForm", "madsrdf:Variant"], "madsrdf:elementList": {"@list": [{"@id": "_:n44540a27bada429c87a7d6c0f6027989b17"}]}, "madsrdf:variantLabel": {"@language": "en", "@value": "Poltergeist films"}}, {"@id": "_:n44540a27bada429c87a7d6c0f6027989b17", "@type": "madsrdf:GenreFormElement", "madsrdf:elementValue": {"@language": "en", "@value": "Poltergeist films"}}], "@id": "/authorities/genreForms/gf2011026298"}
